  "stt_segments": [
    {
      "id": 0,
      "start": 10500.0,
      "end": 10502.0,
      "formatted_start": "02:55:00.000",
      "formatted_end": "02:55:02.000",
      "text": "سلام. سلام. سلام."
    },
    {
      "id": 1,
      "start": 10502.0,
      "end": 10504.0,
      "formatted_start": "02:55:02.000",
      "formatted_end": "02:55:04.000",
      "text": "سلام عزیزم."
    },
    {
      "id": 2,
      "start": 10504.0,
      "end": 10506.0,
      "formatted_start": "02:55:04.000",
      "formatted_end": "02:55:06.000",
      "text": "خوبه. خوبه."
    },
    {
      "id": 3,
      "start": 10508.0,
      "end": 10510.0,
      "formatted_start": "02:55:08.000",
      "formatted_end": "02:55:10.000",
      "text": "چی شده بچه اون؟"
    },
    {
      "id": 4,
      "start": 10510.0,
      "end": 10512.0,
      "formatted_start": "02:55:10.000",
      "formatted_end": "02:55:12.000",
      "text": "چند روزی یه درخورم تنگه."
    },
    {
      "id": 5,
      "start": 10512.0,
      "end": 10514.0,
      "formatted_start": "02:55:12.000",
      "formatted_end": "02:55:14.000",
      "text": "آه؟ لرزش هم داری؟"
    },
    {
      "id": 6,
      "start": 10514.0,
      "end": 10516.0,
      "formatted_start": "02:55:14.000",
      "formatted_end": "02:55:16.000",
      "text": "یا؟ لرزش هم درخورم تنگه."
    },
    {
      "id": 7,
      "start": 10516.0,
      "end": 10518.0,
      "formatted_start": "02:55:16.000",
      "formatted_end": "02:55:18.000",
      "text": "لرزش هم درخورم تنگه."
    },
    {
      "id": 8,
      "start": 10518.0,
      "end": 10520.0,
      "formatted_start": "02:55:18.000",
      "formatted_end": "02:55:20.000",
      "text": "آه؟ دیگه اشتهاد چطوره؟"
    },
    {
      "id": 9,
      "start": 10520.0,
      "end": 10522.0,
      "formatted_start": "02:55:20.000",
      "formatted_end": "02:55:22.000",
      "text": "اشتهاد چطوره؟ شما موشی نداری؟"
    },
    {
      "id": 10,
      "start": 10522.0,
      "end": 10524.0,
      "formatted_start": "02:55:22.000",
      "formatted_end": "02:55:24.000",
      "text": "شما موشی نداری؟"
    },
    {
      "id": 11,
      "start": 10524.0,
      "end": 10526.0,
      "formatted_start": "02:55:24.000",
      "formatted_end": "02:55:26.000",
      "text": "بچه ها خونه."
    },
    {
      "id": 12,
      "start": 10526.0,
      "end": 10528.0,
      "formatted_start": "02:55:26.000",
      "formatted_end": "02:55:28.000",
      "text": "هم کار هم خانه ها داری."
    },
    {
      "id": 13,
      "start": 10528.0,
      "end": 10531.0,
      "formatted_start": "02:55:28.000",
      "formatted_end": "02:55:31.000",
      "text": "خاله خانه بیت دختره با که برگاره"
    },
    {
      "id": 14,
      "start": 10531.0,
      "end": 10534.0,
      "formatted_start": "02:55:31.000",
      "formatted_end": "02:55:34.000",
      "text": "شبتی میخواهم باشن اینکه مشکل ندارم"
    },
    {
      "id": 15,
      "start": 10534.0,
      "end": 10537.0,
      "formatted_start": "02:55:34.000",
      "formatted_end": "02:55:37.000",
      "text": "در درده فالیت رو بزرگیره احساس میدونم که"
    },
    {
      "id": 16,
      "start": 10537.0,
      "end": 10539.0,
      "formatted_start": "02:55:37.000",
      "formatted_end": "02:55:39.000",
      "text": "یه ذره خوهان تنگه"
    },
    {
      "id": 17,
      "start": 10539.0,
      "end": 10541.0,
      "formatted_start": "02:55:39.000",
      "formatted_end": "02:55:41.000",
      "text": "خاله بیت یه دختره"
    },
    {
      "id": 18,
      "start": 10541.0,
      "end": 10545.0,
      "formatted_start": "02:55:41.000",
      "formatted_end": "02:55:45.000",
      "text": "خاله بیت نه دختره هم بزرگ میشن"
    },
    {
      "id": 19,
      "start": 10545.0,
      "end": 10547.0,
      "formatted_start": "02:55:45.000",
      "formatted_end": "02:55:47.000",
      "text": "مثل زن برگار میتونن دیگه"
    },
    {
      "id": 20,
      "start": 10547.0,
      "end": 10549.0,
      "formatted_start": "02:55:47.000",
      "formatted_end": "02:55:49.000",
      "text": "شده"
    },
    {
      "id": 21,
      "start": 10549.0,
      "end": 10551.0,
      "formatted_start": "02:55:49.000",
      "formatted_end": "02:55:51.000",
      "text": "سرکار همینو میشن"
    },
    {
      "id": 22,
      "start": 10551.0,
      "end": 10553.0,
      "formatted_start": "02:55:51.000",
      "formatted_end": "02:55:53.000",
      "text": "جدید همینو شده"
    },
    {
      "id": 23,
      "start": 10553.0,
      "end": 10555.0,
      "formatted_start": "02:55:53.000",
      "formatted_end": "02:55:55.000",
      "text": "سرکار که کسی در پیده"
    },
    {
      "id": 24,
      "start": 10555.0,
      "end": 10560.0,
      "formatted_start": "02:55:55.000",
      "formatted_end": "02:56:00.000",
      "text": "چه رو دیگه بانید هستی که چه رو باز دادیم"
    },
    {
      "id": 25,
      "start": 10560.0,
      "end": 10563.0,
      "formatted_start": "02:56:00.000",
      "formatted_end": "02:56:03.000",
      "text": "چه رو باز دادیم"
    },
    {
      "id": 26,
      "start": 10563.0,
      "end": 10565.0,
      "formatted_start": "02:56:03.000",
      "formatted_end": "02:56:05.000",
      "text": "چه رو باز دادیم"
    },
    {
      "id": 27,
      "start": 10565.0,
      "end": 10569.0,
      "formatted_start": "02:56:05.000",
      "formatted_end": "02:56:09.000",
      "text": "بلی بلاخره این عادی که چند سال همین هست"
    },
    {
      "id": 28,
      "start": 10569.0,
      "end": 10575.0,
      "formatted_start": "02:56:09.000",
      "formatted_end": "02:56:15.000",
      "text": "این اداره و این خانه با خانه معایدتش داره بلی بلاخره"
    },
    {
      "id": 29,
      "start": 10575.0,
      "end": 10577.0,
      "formatted_start": "02:56:15.000",
      "formatted_end": "02:56:17.000",
      "text": "بلی این جدیده اینجور شده"
    },
    {
      "id": 30,
      "start": 10577.0,
      "end": 10581.0,
      "formatted_start": "02:56:17.000",
      "formatted_end": "02:56:21.000",
      "text": "یعنی شب که ما خوابم باشم این عادیه"
    },
    {
      "id": 31,
      "start": 10581.0,
      "end": 10586.0,
      "formatted_start": "02:56:21.000",
      "formatted_end": "02:56:26.000",
      "text": "در تیر روز مخوابم بگم آقا عادی ها ولی نیست با من ایست"
    },
    {
      "id": 32,
      "start": 10586.0,
      "end": 10588.0,
      "formatted_start": "02:56:26.000",
      "formatted_end": "02:56:28.000",
      "text": "تو قلبی فرق میشه بود؟"
    },
    {
      "id": 33,
      "start": 10588.0,
      "end": 10590.0,
      "formatted_start": "02:56:28.000",
      "formatted_end": "02:56:30.000",
      "text": "نه ببین فقط خورده"
    },
    {
      "id": 34,
      "start": 10590.0,
      "end": 10593.0,
      "formatted_start": "02:56:30.000",
      "formatted_end": "02:56:33.000",
      "text": "خورده هم تنگه باید اینجوری آخ بگیشم"
    },
    {
      "id": 35,
      "start": 10593.0,
      "end": 10596.0,
      "formatted_start": "02:56:33.000",
      "formatted_end": "02:56:36.000",
      "text": "نفس بگیشم ولی احساسم بگویم که اوکی نشد"
    },
    {
      "id": 36,
      "start": 10596.0,
      "end": 10598.0,
      "formatted_start": "02:56:36.000",
      "formatted_end": "02:56:38.000",
      "text": "یعنی منظور فرقه هست"
    },
    {
      "id": 37,
      "start": 10598.0,
      "end": 10602.0,
      "formatted_start": "02:56:38.000",
      "formatted_end": "02:56:42.000",
      "text": "بلکه کار مجبوری آخ بگیشم که نفس تازه بشه"
    },
    {
      "id": 38,
      "start": 10602.0,
      "end": 10604.0,
      "formatted_start": "02:56:42.000",
      "formatted_end": "02:56:44.000",
      "text": "بعد اشتهاد چی کنی؟"
    },
    {
      "id": 39,
      "start": 10604.0,
      "end": 10606.0,
      "formatted_start": "02:56:44.000",
      "formatted_end": "02:56:46.000",
      "text": "مشکل ندارم پیر خورده"
    },
    {
      "id": 40,
      "start": 10606.0,
      "end": 10608.0,
      "formatted_start": "02:56:46.000",
      "formatted_end": "02:56:48.000",
      "text": "بازم و خواهد دارم"
    },
    {
      "id": 41,
      "start": 10608.0,
      "end": 10609.0,
      "formatted_start": "02:56:48.000",
      "formatted_end": "02:56:49.000",
      "text": "درخوش نیست"
    },
    {
      "id": 42,
      "start": 10609.0,
      "end": 10610.0,
      "formatted_start": "02:56:49.000",
      "formatted_end": "02:56:50.000",
      "text": "درخوش نیستم بهتر"
    },
    {
      "id": 43,
      "start": 10610.0,
      "end": 10612.0,
      "formatted_start": "02:56:50.000",
      "formatted_end": "02:56:52.000",
      "text": "این نفسه یعنی اونو بیشتر ببینیم"
    },
    {
      "id": 44,
      "start": 10612.0,
      "end": 10613.0,
      "formatted_start": "02:56:52.000",
      "formatted_end": "02:56:53.000",
      "text": "اما فشارمه"
    },
    {
      "id": 45,
      "start": 10613.0,
      "end": 10614.0,
      "formatted_start": "02:56:53.000",
      "formatted_end": "02:56:54.000",
      "text": "مسافرهت کردید که؟"
    },
    {
      "id": 46,
      "start": 10614.0,
      "end": 10616.0,
      "formatted_start": "02:56:54.000",
      "formatted_end": "02:56:56.000",
      "text": "مسافرهت"
    },
    {
      "id": 47,
      "start": 10616.0,
      "end": 10618.0,
      "formatted_start": "02:56:56.000",
      "formatted_end": "02:56:58.000",
      "text": "دخترم کنکور داره"
    },
    {
      "id": 48,
      "start": 10618.0,
      "end": 10620.0,
      "formatted_start": "02:56:58.000",
      "formatted_end": "02:57:00.000",
      "text": "خیلی وقت تطیل ایم کرد"
    },
    {
      "id": 49,
      "start": 10620.0,
      "end": 10622.0,
      "formatted_start": "02:57:00.000",
      "formatted_end": "02:57:02.000",
      "text": "تطیل دیگه تاون داره"
    },
    {
      "id": 50,
      "start": 10622.0,
      "end": 10624.0,
      "formatted_start": "02:57:02.000",
      "formatted_end": "02:57:04.000",
      "text": "سیان گرگ زشتیم که بره میداره"
    },
    {
      "id": 51,
      "start": 10624.0,
      "end": 10626.0,
      "formatted_start": "02:57:04.000",
      "formatted_end": "02:57:06.000",
      "text": "واقعا خیلی وقت نرسیدیم"
    },
    {
      "id": 52,
      "start": 10626.0,
      "end": 10628.0,
      "formatted_start": "02:57:06.000",
      "formatted_end": "02:57:08.000",
      "text": "مسافرهت تصیب میزاره؟"
    },
    {
      "id": 53,
      "start": 10628.0,
      "end": 10630.0,
      "formatted_start": "02:57:08.000",
      "formatted_end": "02:57:10.000",
      "text": "از اینجا میخوام بزنم بیرون"
    },
    {
      "id": 54,
      "start": 10630.0,
      "end": 10632.0,
      "formatted_start": "02:57:10.000",
      "formatted_end": "02:57:12.000",
      "text": "از بیماریا خیلی عزیزم دور"
    },
    {
      "id": 55,
      "start": 10632.0,
      "end": 10634.0,
      "formatted_start": "02:57:12.000",
      "formatted_end": "02:57:14.000",
      "text": "یکیش خودم دارم اینه ها"
    },
    {
      "id": 56,
      "start": 10634.0,
      "end": 10639.0,
      "formatted_start": "02:57:14.000",
      "formatted_end": "02:57:19.000",
      "text": "تنش داریم دوز خیلی داریم"
    },
    {
      "id": 57,
      "start": 10639.0,
      "end": 10644.0,
      "formatted_start": "02:57:19.000",
      "formatted_end": "02:57:24.000",
      "text": "آینه، کار زیاده، هر روزی که برنامه سردم"
    },
    {
      "id": 58,
      "start": 10644.0,
      "end": 10647.0,
      "formatted_start": "02:57:24.000",
      "formatted_end": "02:57:27.000",
      "text": "من اینجا هم نبودم، من بیدار خیلی ممکن بودم"
    },
    {
      "id": 59,
      "start": 10647.0,
      "end": 10649.0,
      "formatted_start": "02:57:27.000",
      "formatted_end": "02:57:29.000",
      "text": "روزای جمعه افغانستان رو بیادم"
    },
    {
      "id": 60,
      "start": 10649.0,
      "end": 10651.0,
      "formatted_start": "02:57:29.000",
      "formatted_end": "02:57:31.000",
      "text": "می آمدم دست مریض هر انجام بزنم برنامه سردم"
    },
    {
      "id": 61,
      "start": 10651.0,
      "end": 10652.0,
      "formatted_start": "02:57:31.000",
      "formatted_end": "02:57:32.000",
      "text": "خودم اینه ها"
    },
    {
      "id": 62,
      "start": 10652.0,
      "end": 10655.0,
      "formatted_start": "02:57:32.000",
      "formatted_end": "02:57:35.000",
      "text": "چون ما به خودتون مسئولی هستیم توی موضوع"
    },
    {
      "id": 63,
      "start": 10655.0,
      "end": 10657.0,
      "formatted_start": "02:57:35.000",
      "formatted_end": "02:57:37.000",
      "text": "الان دیگه نه نیروی این کارن"
    },
    {
      "id": 64,
      "start": 10657.0,
      "end": 10659.0,
      "formatted_start": "02:57:37.000",
      "formatted_end": "02:57:39.000",
      "text": "نیروی بارای هم همیشه عورت بدن"
    },
    {
      "id": 65,
      "start": 10659.0,
      "end": 10669.0,
      "formatted_start": "02:57:39.000",
      "formatted_end": "02:57:49.000",
      "text": "یعنی همونطور که اینجا داریم، یک تو بسط دادی، از یک بزرگ خراب بخوایی بل بل بل شوسته بخوایی دروخ طبیل بلایی آدید."
    },
    {
      "id": 66,
      "start": 10669.0,
      "end": 10670.0,
      "formatted_start": "02:57:49.000",
      "formatted_end": "02:57:50.000",
      "text": "یک ذاره..."
    },
    {
      "id": 67,
      "start": 10670.0,
      "end": 10671.0,
      "formatted_start": "02:57:50.000",
      "formatted_end": "02:57:51.000",
      "text": "آمار بیشتر."
    },
    {
      "id": 68,
      "start": 10671.0,
      "end": 10675.0,
      "formatted_start": "02:57:51.000",
      "formatted_end": "02:57:55.000",
      "text": "آره دکتر، خیلی دوست دارم آمار. من اینجا دیگه دارم از یه نجان."
    },
    {
      "id": 69,
      "start": 10675.0,
      "end": 10677.0,
      "formatted_start": "02:57:55.000",
      "formatted_end": "02:57:57.000",
      "text": "چه باقی دیگه بیشتر دوست داری؟"
    },
    {
      "id": 70,
      "start": 10677.0,
      "end": 10682.0,
      "formatted_start": "02:57:57.000",
      "formatted_end": "02:58:02.000",
      "text": "بیماری ها خیلی دوست دارم. با باقی دیگه زیاد کنار نمی بینن."
    },
    {
      "id": 71,
      "start": 10682.0,
      "end": 10683.0,
      "formatted_start": "02:58:02.000",
      "formatted_end": "02:58:03.000",
      "text": "با خوشم دی، خوبی؟"
    },
    {
      "id": 72,
      "start": 10689.0,
      "end": 10691.0,
      "formatted_start": "02:58:09.000",
      "formatted_end": "02:58:11.000",
      "text": "مابنده شبکه"
    },
    {
      "id": 73,
      "start": 10691.0,
      "end": 10693.0,
      "formatted_start": "02:58:11.000",
      "formatted_end": "02:58:13.000",
      "text": "نه دارم"
    },
    {
      "id": 74,
      "start": 10693.0,
      "end": 10695.0,
      "formatted_start": "02:58:13.000",
      "formatted_end": "02:58:15.000",
      "text": "سرشوگو میشه"
    },
    {
      "id": 75,
      "start": 10695.0,
      "end": 10697.0,
      "formatted_start": "02:58:15.000",
      "formatted_end": "02:58:17.000",
      "text": "اون فضا الان که اینی هستم"
    },
    {
      "id": 76,
      "start": 10697.0,
      "end": 10699.0,
      "formatted_start": "02:58:17.000",
      "formatted_end": "02:58:19.000",
      "text": "اون بیماری ها هرچی که کردم"
    },
    {
      "id": 77,
      "start": 10699.0,
      "end": 10701.0,
      "formatted_start": "02:58:19.000",
      "formatted_end": "02:58:21.000",
      "text": "الان داشتم"
    },
    {
      "id": 78,
      "start": 10701.0,
      "end": 10703.0,
      "formatted_start": "02:58:21.000",
      "formatted_end": "02:58:23.000",
      "text": "از این واقعا آره را چی کردم"
    },
    {
      "id": 79,
      "start": 10703.0,
      "end": 10705.0,
      "formatted_start": "02:58:23.000",
      "formatted_end": "02:58:25.000",
      "text": "خانواده هم درگیش زیاد"
    },
    {
      "id": 80,
      "start": 10705.0,
      "end": 10707.0,
      "formatted_start": "02:58:25.000",
      "formatted_end": "02:58:27.000",
      "text": "این حسابشون خرابه"
    },
    {
      "id": 81,
      "start": 10707.0,
      "end": 10709.0,
      "formatted_start": "02:58:27.000",
      "formatted_end": "02:58:29.000",
      "text": "چون اون چرا این ها یاد گرفتن"
    },
    {
      "id": 82,
      "start": 10709.0,
      "end": 10711.0,
      "formatted_start": "02:58:29.000",
      "formatted_end": "02:58:31.000",
      "text": "این که بچه کم پره"
    },
    {
      "id": 83,
      "start": 10711.0,
      "end": 10713.0,
      "formatted_start": "02:58:31.000",
      "formatted_end": "02:58:33.000",
      "text": "الان میگه بچه زیاد پره"
    },
    {
      "id": 84,
      "start": 10713.0,
      "end": 10715.0,
      "formatted_start": "02:58:33.000",
      "formatted_end": "02:58:35.000",
      "text": "بعد درگی هست"
    },
    {
      "id": 85,
      "start": 10715.0,
      "end": 10717.0,
      "formatted_start": "02:58:35.000",
      "formatted_end": "02:58:37.000",
      "text": "بچه خانواده میره اونا میجونه"
    },
    {
      "id": 86,
      "start": 10717.0,
      "end": 10724.24,
      "formatted_start": "02:58:37.000",
      "formatted_end": "02:58:44.240",
      "text": "بسر بود از بیمارستان برن ایجاد بیمارستان ایجاد امور اداری مدیر داخلی دو کتاب بعدی هم مدیر مست"
    },
    {
      "id": 87,
      "start": 10724.24,
      "end": 10727.36,
      "formatted_start": "02:58:44.240",
      "formatted_end": "02:58:47.360",
      "text": "میگید اونجا اوضاع خرابتر از بیداشتن"
    },
    {
      "id": 88,
      "start": 10727.36,
      "end": 10732.94,
      "formatted_start": "02:58:47.360",
      "formatted_end": "02:58:52.940",
      "text": "پرها اسم صدامی که پرهاد رامیانی"
    },
    {
      "id": 89,
      "start": 10732.94,
      "end": 10738.16,
      "formatted_start": "02:58:52.940",
      "formatted_end": "02:58:58.160",
      "text": "پرهاد شبکه شبکه شبکه"
    },
    {
      "id": 90,
      "start": 10738.16,
      "end": 10741.14,
      "formatted_start": "02:58:58.160",
      "formatted_end": "02:59:01.140",
      "text": "یک سالی بیشتره"
    },
    {
      "id": 91,
      "start": 10741.14,
      "end": 10743.0,
      "formatted_start": "02:59:01.140",
      "formatted_end": "02:59:03.000",
      "text": "سعیده حسن چی کنید؟"
    },
    {
      "id": 92,
      "start": 10743.0,
      "end": 10744.62,
      "formatted_start": "02:59:03.000",
      "formatted_end": "02:59:04.620",
      "text": "بازی شست رو دو کتاب"
    },
    {
      "id": 93,
      "start": 10744.62,
      "end": 10746.62,
      "formatted_start": "02:59:04.620",
      "formatted_end": "02:59:06.620",
      "text": "بازشست شد"
    },
    {
      "id": 94,
      "start": 10746.62,
      "end": 10748.62,
      "formatted_start": "02:59:06.620",
      "formatted_end": "02:59:08.620",
      "text": "بازشست شد و در این وقت خودش کلینیک زنده"
    },
    {
      "id": 95,
      "start": 10748.62,
      "end": 10750.62,
      "formatted_start": "02:59:08.620",
      "formatted_end": "02:59:10.620",
      "text": "خوارخوار میشن و میرن کشه من"
    },
    {
      "id": 96,
      "start": 10750.62,
      "end": 10754.62,
      "formatted_start": "02:59:10.620",
      "formatted_end": "02:59:14.620",
      "text": "خانواده شان کلیم ورزم"
    },
    {
      "id": 97,
      "start": 10754.62,
      "end": 10756.62,
      "formatted_start": "02:59:14.620",
      "formatted_end": "02:59:16.620",
      "text": "همدر بیامرزو داده شدن ورزم بود"
    },
    {
      "id": 98,
      "start": 10756.62,
      "end": 10758.62,
      "formatted_start": "02:59:16.620",
      "formatted_end": "02:59:18.620",
      "text": "همه شان میومدن"
    },
    {
      "id": 99,
      "start": 10758.62,
      "end": 10760.62,
      "formatted_start": "02:59:18.620",
      "formatted_end": "02:59:20.620",
      "text": "پچه اینا حسن بازشست شد"
    },
    {
      "id": 100,
      "start": 10760.62,
      "end": 10762.62,
      "formatted_start": "02:59:20.620",
      "formatted_end": "02:59:22.620",
      "text": "سی و پنی سال بازشست شد"
    },
    {
      "id": 101,
      "start": 10762.62,
      "end": 10766.62,
      "formatted_start": "02:59:22.620",
      "formatted_end": "02:59:26.620",
      "text": "دکتر سیگی نزدیک هشت سال پیش ما آمد"
    },
    {
      "id": 102,
      "start": 10766.62,
      "end": 10768.62,
      "formatted_start": "02:59:26.620",
      "formatted_end": "02:59:28.620",
      "text": "از آموزش برورش"
    },
    {
      "id": 103,
      "start": 10768.62,
      "end": 10770.62,
      "formatted_start": "02:59:28.620",
      "formatted_end": "02:59:30.620",
      "text": "چون آموزش برورش داشت؟"
    },
    {
      "id": 104,
      "start": 10770.62,
      "end": 10772.62,
      "formatted_start": "02:59:30.620",
      "formatted_end": "02:59:32.620",
      "text": "نمیگم توش"
    },
    {
      "id": 105,
      "start": 10772.62,
      "end": 10775.62,
      "formatted_start": "02:59:32.620",
      "formatted_end": "02:59:35.620",
      "text": "اینو که معلومه بده در سن خواهیم برم جا بشن"
    },
    {
      "id": 106,
      "start": 10775.62,
      "end": 10777.62,
      "formatted_start": "02:59:35.620",
      "formatted_end": "02:59:37.620",
      "text": "من الان معلومه هایی که"
    },
    {
      "id": 107,
      "start": 10777.62,
      "end": 10781.62,
      "formatted_start": "02:59:37.620",
      "formatted_end": "02:59:41.620",
      "text": "معلومه بودم میرم مشاور سرالی هم بازشست بودن ساله سایه"
    },
    {
      "id": 108,
      "start": 10781.62,
      "end": 10783.62,
      "formatted_start": "02:59:41.620",
      "formatted_end": "02:59:43.620",
      "text": "مثلا شما ساله ها 19 سالی گیر میرین تو ترابیل مارد؟"
    },
    {
      "id": 109,
      "start": 10783.62,
      "end": 10786.62,
      "formatted_start": "02:59:43.620",
      "formatted_end": "02:59:46.620",
      "text": "اوه این میره رب هنوز 30 سال گذشته"
    },
    {
      "id": 110,
      "start": 10786.62,
      "end": 10788.62,
      "formatted_start": "02:59:46.620",
      "formatted_end": "02:59:48.620",
      "text": "رهبت"
    },
    {
      "id": 111,
      "start": 10788.62,
      "end": 10791.62,
      "formatted_start": "02:59:48.620",
      "formatted_end": "02:59:51.620",
      "text": "آره اون روز با اصابه در مدد خوب شد"
    },
    {
      "id": 112,
      "start": 10791.62,
      "end": 10793.62,
      "formatted_start": "02:59:51.620",
      "formatted_end": "02:59:53.620",
      "text": "پس اون روز هنگزه هم کفتی که اصار هم داخته بکنه"
    },
    {
      "id": 113,
      "start": 10793.62,
      "end": 10796.62,
      "formatted_start": "02:59:53.620",
      "formatted_end": "02:59:56.620",
      "text": "می کنم حالا خوب بگم برم برخص دیگه"
    }
  ],
  "status": "completed"
}