  "stt_segments": [
    {
      "id": 0,
      "start": 5100.0,
      "end": 5107.0,
      "formatted_start": "01:25:00.000",
      "formatted_end": "01:25:07.000",
      "text": "در اینجا، داخلی هم خیلی خوبی هستند، در اینجا خیلی عرام داریم."
    },
    {
      "id": 1,
      "start": 5107.0,
      "end": 5111.0,
      "formatted_start": "01:25:07.000",
      "formatted_end": "01:25:11.000",
      "text": "در اینجا، داخلی هم خیلی خوبی هستند، در اینجا خیلی عرام داریم."
    },
    {
      "id": 2,
      "start": 5111.0,
      "end": 5115.0,
      "formatted_start": "01:25:11.000",
      "formatted_end": "01:25:15.000",
      "text": "در اینجا، داخلی هم خیلی خوبی هستند، در اینجا خیلی عرام داریم."
    },
    {
      "id": 3,
      "start": 5115.0,
      "end": 5121.0,
      "formatted_start": "01:25:15.000",
      "formatted_end": "01:25:21.000",
      "text": "دیابیتی ها مشکلی نداریم، همه جور از تلیوگ، اینو، اینو، اینو"
    },
    {
      "id": 4,
      "start": 5121.0,
      "end": 5123.0,
      "formatted_start": "01:25:21.000",
      "formatted_end": "01:25:23.000",
      "text": "من از این کام هم جلکسه ایمپلاسی کنم"
    },
    {
      "id": 5,
      "start": 5123.0,
      "end": 5125.0,
      "formatted_start": "01:25:23.000",
      "formatted_end": "01:25:25.000",
      "text": "سینوریکا، سینوریکا معادلش چیه؟"
    },
    {
      "id": 6,
      "start": 5125.0,
      "end": 5127.0,
      "formatted_start": "01:25:25.000",
      "formatted_end": "01:25:27.000",
      "text": "امپلاسی هست"
    },
    {
      "id": 7,
      "start": 5127.0,
      "end": 5133.0,
      "formatted_start": "01:25:27.000",
      "formatted_end": "01:25:33.000",
      "text": "من اینو خود جدایی از این شیطان درک کردم، خودش همه پیزشکاشو دارم"
    },
    {
      "id": 8,
      "start": 5133.0,
      "end": 5143.0,
      "formatted_start": "01:25:33.000",
      "formatted_end": "01:25:43.000",
      "text": "ما پیزشکاش همه در آقایی کار می کنم، پیزشکاش هایی که در آقای هم در آقای خوراکی ها رو کار می کنن"
    },
    {
      "id": 9,
      "start": 5143.0,
      "end": 5151.0,
      "formatted_start": "01:25:43.000",
      "formatted_end": "01:25:51.000",
      "text": "از خوش چهار درصد بود و تنظیم هم سه درصد هست که داره با پیزشگاه همشون کار بکنه"
    },
    {
      "id": 10,
      "start": 5151.0,
      "end": 5156.0,
      "formatted_start": "01:25:51.000",
      "formatted_end": "01:25:56.000",
      "text": "اصلا الان میگم این دریگر به خاطر اینجا شده و این هم برقیه دارد کار بکنه"
    },
    {
      "id": 11,
      "start": 5156.0,
      "end": 5158.0,
      "formatted_start": "01:25:56.000",
      "formatted_end": "01:25:58.000",
      "text": "نویدیش این کار رو ندارد؟"
    },
    {
      "id": 12,
      "start": 5158.0,
      "end": 5159.0,
      "formatted_start": "01:25:58.000",
      "formatted_end": "01:25:59.000",
      "text": "نه"
    },
    {
      "id": 13,
      "start": 5159.0,
      "end": 5161.0,
      "formatted_start": "01:25:59.000",
      "formatted_end": "01:26:01.000",
      "text": "من با من نداشتیم"
    },
    {
      "id": 14,
      "start": 5161.0,
      "end": 5166.0,
      "formatted_start": "01:26:01.000",
      "formatted_end": "01:26:06.000",
      "text": "هستم، از اینکه فرازی هست، از اینکه گوگل هستم، دوبی هم رفتر کنم"
    },
    {
      "id": 15,
      "start": 5166.0,
      "end": 5167.0,
      "formatted_start": "01:26:06.000",
      "formatted_end": "01:26:07.000",
      "text": "مقارب بوده"
    },
    {
      "id": 16,
      "start": 5167.0,
      "end": 5169.0,
      "formatted_start": "01:26:07.000",
      "formatted_end": "01:26:09.000",
      "text": "پروش بالایی داشته بوده"
    },
    {
      "id": 17,
      "start": 5169.0,
      "end": 5176.0,
      "formatted_start": "01:26:09.000",
      "formatted_end": "01:26:16.000",
      "text": "به خاطر همین حالا آیا دوستان مردم ازن که هر چیزی که بودید جیتون اوکی باشه تا دوست داشته شده؟"
    },
    {
      "id": 18,
      "start": 5176.0,
      "end": 5179.0,
      "formatted_start": "01:26:16.000",
      "formatted_end": "01:26:19.000",
      "text": "باشه باشه"
    },
    {
      "id": 19,
      "start": 5179.0,
      "end": 5181.0,
      "formatted_start": "01:26:19.000",
      "formatted_end": "01:26:21.000",
      "text": "چشم داشته به چشم؟"
    },
    {
      "id": 20,
      "start": 5181.0,
      "end": 5186.0,
      "formatted_start": "01:26:21.000",
      "formatted_end": "01:26:26.000",
      "text": "من اصلا برای خودم مردم اصلا نباشم من اینقدر میگم که یک اتراف خیلی دارن"
    },
    {
      "id": 21,
      "start": 5186.0,
      "end": 5188.0,
      "formatted_start": "01:26:26.000",
      "formatted_end": "01:26:28.000",
      "text": "از این یکی دارن کار می کنن"
    },
    {
      "id": 22,
      "start": 5188.0,
      "end": 5190.0,
      "formatted_start": "01:26:28.000",
      "formatted_end": "01:26:30.000",
      "text": "اوپر برخیره"
    },
    {
      "id": 23,
      "start": 5190.0,
      "end": 5193.0,
      "formatted_start": "01:26:30.000",
      "formatted_end": "01:26:33.000",
      "text": "اوپر چیزی رو داره می بره ما بهشون آفران رو میزیم"
    },
    {
      "id": 24,
      "start": 5193.0,
      "end": 5195.0,
      "formatted_start": "01:26:33.000",
      "formatted_end": "01:26:35.000",
      "text": "چرا بی که زشن اون چشم رو نداشته باشه؟"
    },
    {
      "id": 25,
      "start": 5195.0,
      "end": 5199.0,
      "formatted_start": "01:26:35.000",
      "formatted_end": "01:26:39.000",
      "text": "درسته اینکه چشم داشته باشه، همکنه ندارم، ولی چشم ناشته باشه"
    },
    {
      "id": 26,
      "start": 5199.0,
      "end": 5200.0,
      "formatted_start": "01:26:39.000",
      "formatted_end": "01:26:40.000",
      "text": "درسته"
    },
    {
      "id": 27,
      "start": 5200.0,
      "end": 5205.0,
      "formatted_start": "01:26:40.000",
      "formatted_end": "01:26:45.000",
      "text": "دیده اینکه چشم داشته باشه منحلق میشه، بعد اینکه اکترول هر چیزی که تویید کرده مجبوره اونجور بگیرم"
    },
    {
      "id": 28,
      "start": 5205.0,
      "end": 5211.0,
      "formatted_start": "01:26:45.000",
      "formatted_end": "01:26:51.000",
      "text": "بگم چشم داشت، پیزش نباید چشم داشته باشه، پیزش باید چشم زیر باشه، هر جور که"
    },
    {
      "id": 29,
      "start": 5211.0,
      "end": 5212.0,
      "formatted_start": "01:26:51.000",
      "formatted_end": "01:26:52.000",
      "text": "سرده رو"
    },
    {
      "id": 30,
      "start": 5212.0,
      "end": 5214.0,
      "formatted_start": "01:26:52.000",
      "formatted_end": "01:26:54.000",
      "text": "آه منفعت بیماره عمل می کنه"
    },
    {
      "id": 31,
      "start": 5214.0,
      "end": 5215.0,
      "formatted_start": "01:26:54.000",
      "formatted_end": "01:26:55.000",
      "text": "بله، به نصف بیماره"
    },
    {
      "id": 32,
      "start": 5215.0,
      "end": 5216.0,
      "formatted_start": "01:26:55.000",
      "formatted_end": "01:26:56.000",
      "text": "اول بیماره"
    },
    {
      "id": 33,
      "start": 5216.0,
      "end": 5224.56,
      "formatted_start": "01:26:56.000",
      "formatted_end": "01:27:04.560",
      "text": "و فقط خب پرال تشکیلی هم داشته باشم بگم، حالاتو از طریق شرکت ما مثلا این کمک کار کردیم، ما همین اشکالی هستیم"
    },
    {
      "id": 34,
      "start": 5224.56,
      "end": 5233.36,
      "formatted_start": "01:27:04.560",
      "formatted_end": "01:27:13.360",
      "text": "ولی اگه که ازش تو تا دیگه نه، این شرکت بیشتر میه، اون شرکت این است، این شرکت در نساتی، اینجوری کاسپ کارانه درست نیستن"
    },
    {
      "id": 35,
      "start": 5233.36,
      "end": 5238.24,
      "formatted_start": "01:27:13.360",
      "formatted_end": "01:27:18.240",
      "text": "بله، خیلی ممنون من این خیلی نمیدونیم"
    },
    {
      "id": 36,
      "start": 5238.24,
      "end": 5240.24,
      "formatted_start": "01:27:18.240",
      "formatted_end": "01:27:20.240",
      "text": "آره، این اینا هست که این رو ببینید."
    },
    {
      "id": 37,
      "start": 5240.24,
      "end": 5242.24,
      "formatted_start": "01:27:20.240",
      "formatted_end": "01:27:22.240",
      "text": "آره، این اینا هست که این رو ببینید."
    },
    {
      "id": 38,
      "start": 5242.24,
      "end": 5244.24,
      "formatted_start": "01:27:22.240",
      "formatted_end": "01:27:24.240",
      "text": "شما با این صحبت دارید چیز دارید؟"
    },
    {
      "id": 39,
      "start": 5244.24,
      "end": 5246.24,
      "formatted_start": "01:27:24.240",
      "formatted_end": "01:27:26.240",
      "text": "من براتونم یک تور هر اطلاعات داشته باشه."
    },
    {
      "id": 40,
      "start": 5246.24,
      "end": 5248.24,
      "formatted_start": "01:27:26.240",
      "formatted_end": "01:27:28.240",
      "text": "من براتونم یک تور هر اطلاعات داشته باشه."
    },
    {
      "id": 41,
      "start": 5248.24,
      "end": 5250.24,
      "formatted_start": "01:27:28.240",
      "formatted_end": "01:27:30.240",
      "text": "من براتونم یک تور هر اطلاعات داشته باشه."
    },
    {
      "id": 42,
      "start": 5250.24,
      "end": 5252.24,
      "formatted_start": "01:27:30.240",
      "formatted_end": "01:27:32.240",
      "text": "تو ایس ای ویس بگید که اونجا چیز تو داشته باشه."
    },
    {
      "id": 43,
      "start": 5252.24,
      "end": 5254.24,
      "formatted_start": "01:27:32.240",
      "formatted_end": "01:27:34.240",
      "text": "تو ایس ای ویس بگید که اونجا چیز تو داشته باشه."
    },
    {
      "id": 44,
      "start": 5254.24,
      "end": 5256.24,
      "formatted_start": "01:27:34.240",
      "formatted_end": "01:27:36.240",
      "text": "از اینکه جیب باشه همه نیستفاده کرده"
    },
    {
      "id": 45,
      "start": 5256.24,
      "end": 5258.24,
      "formatted_start": "01:27:36.240",
      "formatted_end": "01:27:38.240",
      "text": "بوداربایی تاپاسپاره بازمش همه خوده"
    },
    {
      "id": 46,
      "start": 5258.24,
      "end": 5260.24,
      "formatted_start": "01:27:38.240",
      "formatted_end": "01:27:40.240",
      "text": "خودم"
    },
    {
      "id": 47,
      "start": 5270.24,
      "end": 5272.24,
      "formatted_start": "01:27:50.240",
      "formatted_end": "01:27:52.240",
      "text": "سلام"
    },
    {
      "id": 48,
      "start": 5272.24,
      "end": 5274.24,
      "formatted_start": "01:27:52.240",
      "formatted_end": "01:27:54.240",
      "text": "سلام"
    },
    {
      "id": 49,
      "start": 5274.24,
      "end": 5276.24,
      "formatted_start": "01:27:54.240",
      "formatted_end": "01:27:56.240",
      "text": "بفرمونی"
    },
    {
      "id": 50,
      "start": 5276.24,
      "end": 5278.24,
      "formatted_start": "01:27:56.240",
      "formatted_end": "01:27:58.240",
      "text": "بفرمونی"
    },
    {
      "id": 51,
      "start": 5278.24,
      "end": 5280.24,
      "formatted_start": "01:27:58.240",
      "formatted_end": "01:28:00.240",
      "text": "مرسی"
    },
    {
      "id": 52,
      "start": 5280.24,
      "end": 5282.24,
      "formatted_start": "01:28:00.240",
      "formatted_end": "01:28:02.240",
      "text": "مرسی"
    },
    {
      "id": 53,
      "start": 5282.24,
      "end": 5285.24,
      "formatted_start": "01:28:02.240",
      "formatted_end": "01:28:05.240",
      "text": "اولا که گردان را کفر می کنیم"
    },
    {
      "id": 54,
      "start": 5285.24,
      "end": 5288.24,
      "formatted_start": "01:28:05.240",
      "formatted_end": "01:28:08.240",
      "text": "اینجا دوباره مصبه قبلی را ببینیم"
    },
    {
      "id": 55,
      "start": 5288.24,
      "end": 5291.24,
      "formatted_start": "01:28:08.240",
      "formatted_end": "01:28:11.240",
      "text": "مصبه قبلی را نگه می کنیم"
    },
    {
      "id": 56,
      "start": 5291.24,
      "end": 5294.24,
      "formatted_start": "01:28:11.240",
      "formatted_end": "01:28:14.240",
      "text": "اگر گردان را بشن کنیم، درگانی از بردار بشن"
    },
    {
      "id": 57,
      "start": 5294.24,
      "end": 5296.24,
      "formatted_start": "01:28:14.240",
      "formatted_end": "01:28:16.240",
      "text": "اینجا بشن"
    },
    {
      "id": 58,
      "start": 5296.24,
      "end": 5298.24,
      "formatted_start": "01:28:16.240",
      "formatted_end": "01:28:18.240",
      "text": "چند وقت درست کنیم؟"
    },
    {
      "id": 59,
      "start": 5298.24,
      "end": 5300.24,
      "formatted_start": "01:28:18.240",
      "formatted_end": "01:28:20.240",
      "text": "بردار"
    },
    {
      "id": 60,
      "start": 5300.24,
      "end": 5302.24,
      "formatted_start": "01:28:20.240",
      "formatted_end": "01:28:22.240",
      "text": "اینجا بردار بشن"
    },
    {
      "id": 61,
      "start": 5302.24,
      "end": 5304.24,
      "formatted_start": "01:28:22.240",
      "formatted_end": "01:28:24.240",
      "text": "اینجا بردار بشن"
    },
    {
      "id": 62,
      "start": 5304.24,
      "end": 5306.24,
      "formatted_start": "01:28:24.240",
      "formatted_end": "01:28:26.240",
      "text": "اینجا بردار بشن"
    },
    {
      "id": 63,
      "start": 5306.24,
      "end": 5308.24,
      "formatted_start": "01:28:26.240",
      "formatted_end": "01:28:28.240",
      "text": "چند وقت درست کنیم؟"
    },
    {
      "id": 64,
      "start": 5308.24,
      "end": 5310.24,
      "formatted_start": "01:28:28.240",
      "formatted_end": "01:28:30.240",
      "text": "14-15 درست کنیم"
    },
    {
      "id": 65,
      "start": 5310.24,
      "end": 5332.24,
      "formatted_start": "01:28:30.240",
      "formatted_end": "01:28:52.240",
      "text": "موسیقی"
    },
    {
      "id": 66,
      "start": 5332.24,
      "end": 5334.24,
      "formatted_start": "01:28:52.240",
      "formatted_end": "01:28:54.240",
      "text": "همون رو هم زدیم یا نزدیتون؟"
    },
    {
      "id": 67,
      "start": 5334.24,
      "end": 5336.24,
      "formatted_start": "01:28:54.240",
      "formatted_end": "01:28:56.240",
      "text": "نه نزدیم"
    },
    {
      "id": 68,
      "start": 5336.24,
      "end": 5338.24,
      "formatted_start": "01:28:56.240",
      "formatted_end": "01:28:58.240",
      "text": "یه جلی خیلی بری هست آدمویه"
    },
    {
      "id": 69,
      "start": 5338.24,
      "end": 5340.24,
      "formatted_start": "01:28:58.240",
      "formatted_end": "01:29:00.240",
      "text": "بیتنینگ"
    },
    {
      "id": 70,
      "start": 5344.24,
      "end": 5346.24,
      "formatted_start": "01:29:04.240",
      "formatted_end": "01:29:06.240",
      "text": "آقا دوستان من هم فرق نکردم"
    },
    {
      "id": 71,
      "start": 5346.24,
      "end": 5348.24,
      "formatted_start": "01:29:06.240",
      "formatted_end": "01:29:08.240",
      "text": "جدی اکس نگرفتیم؟"
    },
    {
      "id": 72,
      "start": 5348.24,
      "end": 5350.24,
      "formatted_start": "01:29:08.240",
      "formatted_end": "01:29:10.240",
      "text": "نه نه"
    },
    {
      "id": 73,
      "start": 5350.24,
      "end": 5352.24,
      "formatted_start": "01:29:10.240",
      "formatted_end": "01:29:12.240",
      "text": "هیچ فرق نکرده بندازید"
    },
    {
      "id": 74,
      "start": 5352.24,
      "end": 5354.24,
      "formatted_start": "01:29:12.240",
      "formatted_end": "01:29:14.240",
      "text": "کسی که اکس نگیره"
    },
    {
      "id": 75,
      "start": 5354.24,
      "end": 5356.24,
      "formatted_start": "01:29:14.240",
      "formatted_end": "01:29:16.240",
      "text": "هیچ فرق دقیقه بجایی نداره"
    },
    {
      "id": 76,
      "start": 5356.24,
      "end": 5358.24,
      "formatted_start": "01:29:16.240",
      "formatted_end": "01:29:18.240",
      "text": "اما باید یک اکس شوید نه"
    },
    {
      "id": 77,
      "start": 5358.24,
      "end": 5360.24,
      "formatted_start": "01:29:18.240",
      "formatted_end": "01:29:20.240",
      "text": "نه دخترم هیچ فرق نکردم"
    },
    {
      "id": 78,
      "start": 5360.24,
      "end": 5366.24,
      "formatted_start": "01:29:20.240",
      "formatted_end": "01:29:26.240",
      "text": "بیشتر شده تمام. اصلا تمام اصلا هیچی بیشتر شده. دکترشم بند از این دور داروهاشم بند از این دور."
    },
    {
      "id": 79,
      "start": 5366.24,
      "end": 5373.24,
      "formatted_start": "01:29:26.240",
      "formatted_end": "01:29:33.240",
      "text": "عکس نگرفته باشی فردن همشون. گفتم که عکس نگیری آه. اصلا میگی بدتر هم شده."
    },
    {
      "id": 80,
      "start": 5373.24,
      "end": 5384.24,
      "formatted_start": "01:29:33.240",
      "formatted_end": "01:29:44.240",
      "text": "حتما بیمار پستی به یک وسیله درمان میشه. عکس. داروش برد باشه. دکترش برد باشه. نزنه. بزنه. بیشتر."
    },
    {
      "id": 81,
      "start": 5384.24,
      "end": 5386.24,
      "formatted_start": "01:29:44.240",
      "formatted_end": "01:29:46.240",
      "text": "اصل اکس"
    },
    {
      "id": 82,
      "start": 5386.24,
      "end": 5388.24,
      "formatted_start": "01:29:46.240",
      "formatted_end": "01:29:48.240",
      "text": "اکس که میگیم من الان میدونم این بهتر شد"
    },
    {
      "id": 83,
      "start": 5388.24,
      "end": 5390.24,
      "formatted_start": "01:29:48.240",
      "formatted_end": "01:29:50.240",
      "text": "شما که نمیتونید بفهم داشتون"
    },
    {
      "id": 84,
      "start": 5390.24,
      "end": 5392.24,
      "formatted_start": "01:29:50.240",
      "formatted_end": "01:29:52.240",
      "text": "هر روز میبینیدشون"
    },
    {
      "id": 85,
      "start": 5392.24,
      "end": 5394.24,
      "formatted_start": "01:29:52.240",
      "formatted_end": "01:29:54.240",
      "text": "اگر اکس میگرفتیم"
    },
    {
      "id": 86,
      "start": 5394.24,
      "end": 5396.24,
      "formatted_start": "01:29:54.240",
      "formatted_end": "01:29:56.240",
      "text": "دخترم شما"
    },
    {
      "id": 87,
      "start": 5396.24,
      "end": 5398.24,
      "formatted_start": "01:29:56.240",
      "formatted_end": "01:29:58.240",
      "text": "بله"
    }
  ],
  "status": "completed"
}