    },
    {
      "id": 85,
      "start": 11681.74,
      "end": 11683.76,
      "formatted_start": "03:14:41.740",
      "formatted_end": "03:14:43.760",
      "text": "دردی"
    },
    {
      "id": 86,
      "start": 11683.76,
      "end": 11685.76,
      "formatted_start": "03:14:43.760",
      "formatted_end": "03:14:45.760",
