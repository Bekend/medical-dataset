    },
    {
      "id": 73,
      "start": 11658.94,
      "end": 11660.94,
      "formatted_start": "03:14:18.940",
      "formatted_end": "03:14:20.940",
      "text": "باید برداری کنید"
    },
    {
      "id": 74,
      "start": 11660.94,
      "end": 11662.94,
      "formatted_start": "03:14:20.940",
      "formatted_end": "03:14:22.940",
      "text": "باید برداری کنید"
    },
    {
      "id": 75,
      "start": 11662.94,
      "end": 11665.7,
      "formatted_start": "03:14:22.940",
      "formatted_end": "03:14:25.700",
      "text": "ببین خدا پدر ایدیسون رو بیان بوسته"
    },
    {
      "id": 76,
      "start": 11665.7,
      "end": 11666.62,
      "formatted_start": "03:14:25.700",
      "formatted_end": "03:14:26.620",
      "text": "چی رو روز کرده"
    },
    {
      "id": 77,
      "start": 11666.62,
      "end": 11669.36,
      "formatted_start": "03:14:26.620",
      "formatted_end": "03:14:29.360",
      "text": "خب ایدیسون بزرگی رو خواهاش کرد"
    },
    {
      "id": 78,
      "start": 11669.36,
      "end": 11670.26,
      "formatted_start": "03:14:29.360",
      "formatted_end": "03:14:30.260",
      "text": "ایدیسون پرچیکه"
    },
    {
      "id": 79,
      "start": 11670.26,
      "end": 11672.06,
      "formatted_start": "03:14:30.260",
      "formatted_end": "03:14:32.060",
