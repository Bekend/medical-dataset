  ],
  "stt_segments": [
    {
      "id": 0,
      "start": 11400.0,
      "end": 11406.0,
      "formatted_start": "03:10:00.000",
      "formatted_end": "03:10:06.000",
      "text": "اینجا در جلسه داشتیم، جلسه یک شایدی بیمار داشتیم، مثلا شما سه روز امیش چه کار نیکی انجام بدید؟ بگو."
    },
    {
      "id": 1,
      "start": 11406.0,
      "end": 11411.0,
      "formatted_start": "03:10:06.000",
      "formatted_end": "03:10:11.000",
      "text": "و هر روز دوباره یک کار نیک میگشتید که اون کار نیکی ما رو چون ما هستیم تقریبا."
    },
    {
      "id": 2,
      "start": 11411.0,
      "end": 11417.0,
      "formatted_start": "03:10:11.000",
      "formatted_end": "03:10:17.000",
      "text": "این برای این برنامه نهادیده ایم چون کار نیک رو یه روز انجام بدید فردان جایی، یه روز انجام."
    },
    {
      "id": 3,
      "start": 11417.0,
      "end": 11423.0,
      "formatted_start": "03:10:17.000",
      "formatted_end": "03:10:23.000",
      "text": "کار نیک، اسمش بود کار نیک، رفتار نیک، ادار نیک."
    },
    {
      "id": 4,
      "start": 11423.0,
      "end": 11428.0,
      "formatted_start": "03:10:23.000",
      "formatted_end": "03:10:28.000",
      "text": "این کرداری نیک رو باید انجام بدید تا برای ما ملکه بشیم"
    },
    {
      "id": 5,
      "start": 11428.0,
      "end": 11435.0,
      "formatted_start": "03:10:28.000",
      "formatted_end": "03:10:35.000",
      "text": "از کدکی وقتی ماخذه نشدید در باستی داشته داشته، تشمیقی نشدید، دنبال نیک نمیگه"
    },
    {
      "id": 6,
      "start": 11435.0,
      "end": 11437.0,
      "formatted_start": "03:10:35.000",
      "formatted_end": "03:10:37.000",
      "text": "نیکی وجود ندارده بود"
    },
    {
      "id": 7,
      "start": 11437.0,
      "end": 11443.0,
      "formatted_start": "03:10:37.000",
      "formatted_end": "03:10:43.000",
      "text": "اینکه اینکه زرنگی که به دست بیارم من به دست بیارم تو رو رو برم"
    },
    {
      "id": 8,
      "start": 11443.0,
      "end": 11451.0,
      "formatted_start": "03:10:43.000",
      "formatted_end": "03:10:51.000",
      "text": "این مسابقه ناسانه می رون رقم می زنه که افراد که مثل جنوبانی می خواهند تلاش بکنند"
    },
    {
      "id": 9,
      "start": 11451.0,
      "end": 11455.0,
      "formatted_start": "03:10:51.000",
      "formatted_end": "03:10:55.000",
      "text": "این میره که اصلا ندیده گرفته می شوند"
    },
    {
      "id": 10,
      "start": 11455.0,
      "end": 11459.0,
      "formatted_start": "03:10:55.000",
      "formatted_end": "03:10:59.000",
      "text": "این واقعا کسی که یادا تلاش میکنه قامانش رو صنیه رای بده"
    },
    {
      "id": 11,
      "start": 11459.0,
      "end": 11463.0,
      "formatted_start": "03:10:59.000",
      "formatted_end": "03:11:03.000",
      "text": "حتی به ضرر خودش نمان بشه مثل کسی که اون رو آخر میرسه"
    },
    {
      "id": 12,
      "start": 11463.0,
      "end": 11465.0,
      "formatted_start": "03:11:03.000",
      "formatted_end": "03:11:05.000",
      "text": "بابایی باید درست باشه"
    },
    {
      "id": 13,
      "start": 11465.0,
      "end": 11471.0,
      "formatted_start": "03:11:05.000",
      "formatted_end": "03:11:11.000",
      "text": "تو گروه دارم بهشون اعلام کنم کسی همه با فکر مراقبت یاد شامل زنه نداره پای من"
    },
    {
      "id": 14,
      "start": 11471.0,
      "end": 11475.0,
      "formatted_start": "03:11:11.000",
      "formatted_end": "03:11:15.000",
      "text": "ولی اون جروه که میری تصمیم اونی نیست که از این بابای زن آدم میشه"
    },
    {
      "id": 15,
      "start": 11475.0,
      "end": 11477.0,
      "formatted_start": "03:11:15.000",
      "formatted_end": "03:11:17.000",
      "text": "آدم زلزل میشه"
    },
    {
      "id": 16,
      "start": 11477.0,
      "end": 11479.0,
      "formatted_start": "03:11:17.000",
      "formatted_end": "03:11:19.000",
      "text": "میدونم شما شما"
    },
    {
      "id": 17,
      "start": 11479.0,
      "end": 11482.0,
      "formatted_start": "03:11:19.000",
      "formatted_end": "03:11:22.000",
      "text": "ببین هلا به ما پشار میارن بگی دارو کمتره"
    },
    {
      "id": 18,
      "start": 11482.0,
      "end": 11487.0,
      "formatted_start": "03:11:22.000",
      "formatted_end": "03:11:27.000",
      "text": "بیمان اون وقت یه بیماری داره مثلا بگی میره شد"
    },
    {
      "id": 19,
      "start": 11487.0,
      "end": 11491.0,
      "formatted_start": "03:11:27.000",
      "formatted_end": "03:11:31.000",
      "text": "خب سردرد هم داره پادرد هم داره دیابت هم داره"
    },
    {
      "id": 20,
      "start": 11491.0,
      "end": 11494.0,
      "formatted_start": "03:11:31.000",
      "formatted_end": "03:11:34.000",
      "text": "من باید برای کمتر نوشتم"
    },
    {
      "id": 21,
      "start": 11494.0,
      "end": 11497.0,
      "formatted_start": "03:11:34.000",
      "formatted_end": "03:11:37.000",
      "text": "درسته، پیزش داره، اضافه ننویسه"
    },
    {
      "id": 22,
      "start": 11497.0,
      "end": 11501.0,
      "formatted_start": "03:11:37.000",
      "formatted_end": "03:11:41.000",
      "text": "اما اینجا بیمار سه تا بیماری داره"
    },
    {
      "id": 23,
      "start": 11501.0,
      "end": 11504.0,
      "formatted_start": "03:11:41.000",
      "formatted_end": "03:11:44.000",
      "text": "چهار تا بیماری داره، برای هر گوش میخواد"
    },
    {
      "id": 24,
      "start": 11504.0,
      "end": 11506.0,
      "formatted_start": "03:11:44.000",
      "formatted_end": "03:11:46.000",
      "text": "من مجبور میشم چی بگم؟"
    },
    {
      "id": 25,
      "start": 11506.0,
      "end": 11510.0,
      "formatted_start": "03:11:46.000",
      "formatted_end": "03:11:50.000",
      "text": "میگم که خب، پس برو سه بار بیا"
    },
    {
      "id": 26,
      "start": 11510.0,
      "end": 11513.0,
      "formatted_start": "03:11:50.000",
      "formatted_end": "03:11:53.000",
      "text": "خب این سه بار بیا، سه تا ویزیت هم بیده"
    },
    {
      "id": 27,
      "start": 11513.0,
      "end": 11515.0,
      "formatted_start": "03:11:53.000",
      "formatted_end": "03:11:55.000",
      "text": "به نفع مرمیشه دیگه، درسته؟"
    },
    {
      "id": 28,
      "start": 11515.0,
      "end": 11517.0,
      "formatted_start": "03:11:55.000",
      "formatted_end": "03:11:57.000",
      "text": "از طرف اینکه سیستم هم میگه، بح بح بح"
    },
    {
      "id": 29,
      "start": 11517.0,
      "end": 11521.0,
      "formatted_start": "03:11:57.000",
      "formatted_end": "03:12:01.000",
      "text": "اول دکتر داروهای کم میرسه و تو هر دفعه 3 تا 3 تا نسخه میرسه"
    },
    {
      "id": 30,
      "start": 11521.0,
      "end": 11525.0,
      "formatted_start": "03:12:01.000",
      "formatted_end": "03:12:05.000",
      "text": "خب من 3 بار ویزیت میگرهم تشکیل دولتم شد"
    },
    {
      "id": 31,
      "start": 11525.0,
      "end": 11529.0,
      "formatted_start": "03:12:05.000",
      "formatted_end": "03:12:09.000",
      "text": "ولی بیام بگم نه با همین یه ویزیت هم که گرفتم 3 تا مریضی تأثیر هم کندم"
    },
    {
      "id": 32,
      "start": 11529.0,
      "end": 11533.0,
      "formatted_start": "03:12:09.000",
      "formatted_end": "03:12:13.000",
      "text": "3 تا نه تا دارو میرسم دولت من معافضه میشه"
    },
    {
      "id": 33,
      "start": 11533.0,
      "end": 11537.0,
      "formatted_start": "03:12:13.000",
      "formatted_end": "03:12:17.000",
      "text": "هم پول کم گرفتم هم معافضه شدن چون دارو زیاده باشه"
    },
    {
      "id": 34,
      "start": 11537.0,
      "end": 11541.0,
      "formatted_start": "03:12:17.000",
      "formatted_end": "03:12:21.000",
      "text": "اصلا توجه نمی کنید که این داروهای برای یه بیماری نیست که این هم زیاده"
    },
    {
      "id": 35,
      "start": 11541.0,
      "end": 11548.0,
      "formatted_start": "03:12:21.000",
      "formatted_end": "03:12:28.000",
      "text": "مردشه، سرمردشه، دیابتشه، زخمه، عاشقه، هر کدوم چهار تا دارم واسه سه تا نسخه"
    },
    {
      "id": 36,
      "start": 11548.0,
      "end": 11554.0,
      "formatted_start": "03:12:28.000",
      "formatted_end": "03:12:34.000",
      "text": "شده، چهار تا نسخه توی کاغذه شده، اون نسخه من زیاد نیست، بلکه دارومای من زیاده"
    },
    {
      "id": 37,
      "start": 11554.0,
      "end": 11557.0,
      "formatted_start": "03:12:34.000",
      "formatted_end": "03:12:37.000",
      "text": "سه تا نسخه توی کاغذه تو اینجوری بیدار"
    },
    {
      "id": 38,
      "start": 11557.0,
      "end": 11562.0,
      "formatted_start": "03:12:37.000",
      "formatted_end": "03:12:42.000",
      "text": "اینگار من از هر قبل گذشتم، ماخذه میشم دعوت میکنم برگان باید به جواب بده این چه وضع شده"
    },
    {
      "id": 39,
      "start": 11562.0,
      "end": 11567.36,
      "formatted_start": "03:12:42.000",
      "formatted_end": "03:12:47.360",
      "text": "این دارون با این دارون چرا؟ این همه دارون برای یک سطح چرا؟ این هم بفروشن چرا؟ دیدگاهش"
    },
    {
      "id": 40,
      "start": 11567.36,
      "end": 11569.36,
      "formatted_start": "03:12:47.360",
      "formatted_end": "03:12:49.360",
      "text": "دیدگاه منه که وزید کمتر بگذرم"
    },
    {
      "id": 41,
      "start": 11569.36,
      "end": 11576.24,
      "formatted_start": "03:12:49.360",
      "formatted_end": "03:12:56.240",
      "text": "به جای اینکه از این وزید کمتر گرفتن من، این ماشین من مدل دو هزار دوازده هست"
    },
    {
      "id": 42,
      "start": 11576.24,
      "end": 11580.88,
      "formatted_start": "03:12:56.240",
      "formatted_end": "03:13:00.880",
      "text": "همین دو هزار وسته، شیش تا دارم مدل دوازده هستم، چارده، ساله کار کرده همین زمان برای تعمیل با من"
    },
    {
      "id": 43,
      "start": 11580.88,
      "end": 11589.44,
      "formatted_start": "03:13:00.880",
      "formatted_end": "03:13:09.440",
      "text": "ولی این تضابط نمی کنیم. اونی که سه تا روزید می گیره، با میره بود."
    },
    {
      "id": 44,
      "start": 11589.44,
      "end": 11595.44,
      "formatted_start": "03:13:09.440",
      "formatted_end": "03:13:15.440",
      "text": "این حالا آخر سیستم."
    },
    {
      "id": 45,
      "start": 11595.44,
      "end": 11597.44,
      "formatted_start": "03:13:15.440",
      "formatted_end": "03:13:17.440",
      "text": "با نیره."
    },
    {
      "id": 46,
      "start": 11597.44,
      "end": 11599.44,
      "formatted_start": "03:13:17.440",
      "formatted_end": "03:13:19.440",
      "text": "چرا؟"
    },
    {
      "id": 47,
      "start": 11599.44,
      "end": 11602.64,
      "formatted_start": "03:13:19.440",
      "formatted_end": "03:13:22.640",
      "text": "ارایی که هیچ چیزی نداره."
    },
    {
      "id": 48,
      "start": 11602.64,
      "end": 11606.64,
      "formatted_start": "03:13:22.640",
      "formatted_end": "03:13:26.640",
      "text": "تا جایی که میره، تشبیر قبل میشه."
    },
    {
      "id": 49,
      "start": 11606.64,
      "end": 11610.58,
      "formatted_start": "03:13:26.640",
      "formatted_end": "03:13:30.580",
      "text": "بیا شویر چرا تو مصمت استقلال هم بشتر نمیشه"
    },
    {
      "id": 50,
      "start": 11610.58,
      "end": 11612.94,
      "formatted_start": "03:13:30.580",
      "formatted_end": "03:13:32.940",
      "text": "چرا بگیره"
    },
    {
      "id": 51,
      "start": 11612.94,
      "end": 11614.92,
      "formatted_start": "03:13:32.940",
      "formatted_end": "03:13:34.920",
      "text": "سیتم بگیره تشکر کنید"
    },
    {
      "id": 52,
      "start": 11614.92,
      "end": 11617.06,
      "formatted_start": "03:13:34.920",
      "formatted_end": "03:13:37.060",
      "text": "اگه میشه هر اینو بگیرم آنش بکنم"
    },
    {
      "id": 53,
      "start": 11617.06,
      "end": 11618.72,
      "formatted_start": "03:13:37.060",
      "formatted_end": "03:13:38.720",
      "text": "اون کسی که این کار رو نمی کنید"
    },
    {
      "id": 54,
      "start": 11618.72,
      "end": 11624.2,
      "formatted_start": "03:13:38.720",
      "formatted_end": "03:13:44.200",
      "text": "توبه هم بشه"
    },
    {
      "id": 55,
      "start": 11624.2,
      "end": 11626.56,
      "formatted_start": "03:13:44.200",
      "formatted_end": "03:13:46.560",
      "text": "این کار رو نمی کنید"
    },
    {
      "id": 56,
      "start": 11626.56,
      "end": 11628.28,
      "formatted_start": "03:13:46.560",
      "formatted_end": "03:13:48.280",
      "text": "خدا رو در نظر می کنید"
    },
    {
      "id": 57,
      "start": 11628.28,
      "end": 11629.5,
      "formatted_start": "03:13:48.280",
      "formatted_end": "03:13:49.500",
      "text": "خدا رو در نظر می کنید"
    },
    {
      "id": 58,
      "start": 11629.5,
      "end": 11631.68,
      "formatted_start": "03:13:49.500",
      "formatted_end": "03:13:51.680",
      "text": "چرا که تو می فسد میدین"
    },
    {
      "id": 59,
      "start": 11631.68,
      "end": 11633.78,
      "formatted_start": "03:13:51.680",
      "formatted_end": "03:13:53.780",
      "text": "و بردگار و خدا هیچه هیچه ها رو نداره"
    },
    {
      "id": 60,
      "start": 11633.78,
      "end": 11634.94,
      "formatted_start": "03:13:53.780",
      "formatted_end": "03:13:54.940",
      "text": "بفرستی"
    },
    {
      "id": 61,
      "start": 11634.94,
      "end": 11636.94,
      "formatted_start": "03:13:54.940",
      "formatted_end": "03:13:56.940",
      "text": "باید برداری کنید"
    },
    {
      "id": 62,
      "start": 11636.94,
      "end": 11638.94,
      "formatted_start": "03:13:56.940",
      "formatted_end": "03:13:58.940",
      "text": "باید برداری کنید"
    },
    {
      "id": 63,
      "start": 11638.94,
      "end": 11640.94,
      "formatted_start": "03:13:58.940",
      "formatted_end": "03:14:00.940",
      "text": "باید برداری کنید"
    },
    {
      "id": 64,
      "start": 11640.94,
      "end": 11642.94,
      "formatted_start": "03:14:00.940",
      "formatted_end": "03:14:02.940",
