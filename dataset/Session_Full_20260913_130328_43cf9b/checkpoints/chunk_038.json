    },
    {
      "id": 80,
      "start": 11672.06,
      "end": 11673.54,
      "formatted_start": "03:14:32.060",
      "formatted_end": "03:14:33.540",
      "text": "بفرما چی شده"
    },
    {
      "id": 81,
      "start": 11673.54,
      "end": 11675.08,
      "formatted_start": "03:14:33.540",
      "formatted_end": "03:14:35.080",
