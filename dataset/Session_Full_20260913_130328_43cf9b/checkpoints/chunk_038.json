      "end": 11648.94,
      "formatted_start": "03:14:06.940",
      "formatted_end": "03:14:08.940",
      "text": "باید برداری کنید"
    },
    {
      "id": 68,
      "start": 11648.94,
      "end": 11650.94,
      "formatted_start": "03:14:08.940",
      "formatted_end": "03:14:10.940",
      "text": "باید برداری کنید"
    },
    {
      "id": 69,
      "start": 11650.94,
      "end": 11652.94,
      "formatted_start": "03:14:10.940",
      "formatted_end": "03:14:12.940",
      "text": "باید برداری کنید"
    },
    {
      "id": 70,
