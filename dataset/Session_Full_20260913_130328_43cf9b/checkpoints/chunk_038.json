    },
    {
      "id": 87,
      "start": 11685.76,
      "end": 11687.76,
      "formatted_start": "03:14:45.760",
      "formatted_end": "03:14:47.760",
      "text": "دردی"
    },
    {
      "id": 88,
      "start": 11687.76,
      "end": 11689.76,
      "formatted_start": "03:14:47.760",
      "formatted_end": "03:14:49.760",
      "text": "دردی"
    },
    {
      "id": 89,
      "start": 11690.32,
      "end": 11691.76,
      "formatted_start": "03:14:50.320",
      "formatted_end": "03:14:51.760",
      "text": "دردی"
    },
    {
      "id": 90,
      "start": 11692.94,
      "end": 11696.6,
      "formatted_start": "03:14:52.940",
      "formatted_end": "03:14:56.600",
      "text": "اینکه ها داغ اینجا سرده، باز اینکه هاش داغ پایین برن"
    },
    {
      "id": 91,
      "start": 11696.6,
      "end": 11698.94,
      "formatted_start": "03:14:56.600",
      "formatted_end": "03:14:58.940",
      "text": "ببینم اون ریخته بیرون رو ببینم از چه نوعیه"
    }
