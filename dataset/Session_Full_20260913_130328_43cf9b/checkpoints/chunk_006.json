  "stt_segments": [
    {
      "id": 0,
      "start": 1800.0,
      "end": 1808.0,
      "formatted_start": "00:30:00.000",
      "formatted_end": "00:30:08.000",
      "text": "اونو برنه خدا آمد ۵۶ تا، چه سریع سر جوانه بودنه، قبلی گرفتا برنه خدا خودشم خیلی ازیز شدیم."
    },
    {
      "id": 1,
      "start": 1808.0,
      "end": 1812.0,
      "formatted_start": "00:30:08.000",
      "formatted_end": "00:30:12.000",
      "text": "این تمیشنمای واقعیتش اینه چند برون بستره شده؟"
    },
    {
      "id": 2,
      "start": 1812.0,
      "end": 1813.0,
      "formatted_start": "00:30:12.000",
      "formatted_end": "00:30:13.000",
      "text": "راحت گرفت."
    },
    {
      "id": 3,
      "start": 1813.0,
      "end": 1814.0,
      "formatted_start": "00:30:13.000",
      "formatted_end": "00:30:14.000",
      "text": "آره."
    },
    {
      "id": 4,
      "start": 1814.0,
      "end": 1817.0,
      "formatted_start": "00:30:14.000",
      "formatted_end": "00:30:17.000",
      "text": "ما اونجا آنجوکن میزنیم، اتفاقا سوزن و کلوفت هم میزنن."
    },
    {
      "id": 5,
      "start": 1817.0,
      "end": 1818.0,
      "formatted_start": "00:30:17.000",
      "formatted_end": "00:30:18.000",
      "text": "آره باهم."
    },
    {
      "id": 6,
      "start": 1818.0,
      "end": 1820.0,
      "formatted_start": "00:30:18.000",
      "formatted_end": "00:30:20.000",
      "text": "ولی دائمی میمانه، سه روز میمانه."
    },
    {
      "id": 7,
      "start": 1820.0,
      "end": 1822.0,
      "formatted_start": "00:30:20.000",
      "formatted_end": "00:30:22.000",
      "text": "آره، نه باهم."
    },
    {
      "id": 8,
      "start": 1822.0,
      "end": 1829.0,
      "formatted_start": "00:30:22.000",
      "formatted_end": "00:30:29.000",
      "text": "شما قسمت این، باید ببینید تنیشت مایی، مثلا اگه این فکران را راحت بگیرند،"
    },
    {
      "id": 9,
      "start": 1829.0,
      "end": 1838.0,
      "formatted_start": "00:30:29.000",
      "formatted_end": "00:30:38.000",
      "text": "بعد آنجیوکت بسیار بکنند، بعد با نظر خودتون برد مرخص بکنید، آنجیوکت را نکشند."
    },
    {
      "id": 10,
      "start": 1838.0,
      "end": 1843.0,
      "formatted_start": "00:30:38.000",
      "formatted_end": "00:30:43.000",
      "text": "باشند، باشند، باشند، تا سه روز می‌کنید سه روز و درواری که ما می‌نویسیم بشد بودند."
    },
    {
      "id": 11,
      "start": 1843.0,
      "end": 1844.0,
      "formatted_start": "00:30:43.000",
      "formatted_end": "00:30:44.000",
      "text": "مشکلی باشند؟"
    },
    {
      "id": 12,
      "start": 1844.0,
      "end": 1850.0,
      "formatted_start": "00:30:44.000",
      "formatted_end": "00:30:50.000",
      "text": "نه، تو او جانسش از دروار از بیرون قبول نمی‌کنند، خودشون از مجانی هم بیزرند،"
    },
    {
      "id": 13,
      "start": 1850.0,
      "end": 1853.0,
      "formatted_start": "00:30:50.000",
      "formatted_end": "00:30:53.000",
      "text": "ولی این تو قسمتی داره برای هم تزریقات"
    },
    {
      "id": 14,
      "start": 1853.0,
      "end": 1862.0,
      "formatted_start": "00:30:53.000",
      "formatted_end": "00:31:02.000",
      "text": "یه واحدی داره برای تزریقات تو اونجا میتونن امپولوت یک کسی دیگر هم مثلا نشان بدید وزن کنن"
    },
    {
      "id": 15,
      "start": 1862.0,
      "end": 1865.0,
      "formatted_start": "00:31:02.000",
      "formatted_end": "00:31:05.000",
      "text": "بله تنویز اشتراکی هم هستیم بیلی به تنویز اشتراکی"
    },
    {
      "id": 16,
      "start": 1865.0,
      "end": 1869.0,
      "formatted_start": "00:31:05.000",
      "formatted_end": "00:31:09.000",
      "text": "میدونم کدومیدیشو بگیم من بگم سرخوشتو تحقیقی بگیم"
    },
    {
      "id": 17,
      "start": 1869.0,
      "end": 1871.0,
      "formatted_start": "00:31:09.000",
      "formatted_end": "00:31:11.000",
      "text": "مرضی بوارشی و میده جدید اومده"
    },
    {
      "id": 18,
      "start": 1871.0,
      "end": 1873.0,
      "formatted_start": "00:31:11.000",
      "formatted_end": "00:31:13.000",
      "text": "آره آره استفراغ هم داره؟"
    },
    {
      "id": 19,
      "start": 1873.0,
      "end": 1875.0,
      "formatted_start": "00:31:13.000",
      "formatted_end": "00:31:15.000",
      "text": "نه دکتر استفراغ نداره"
    },
    {
      "id": 20,
      "start": 1875.0,
      "end": 1881.0,
      "formatted_start": "00:31:15.000",
      "formatted_end": "00:31:21.000",
      "text": "از اینجا برده بودیم کپسول نداشتیم همراه ما هوا گرمیتون باشیم"
    },
    {
      "id": 21,
      "start": 1881.0,
      "end": 1883.0,
      "formatted_start": "00:31:21.000",
      "formatted_end": "00:31:23.000",
      "text": "اکسیجن بسکردیم"
    },
    {
      "id": 22,
      "start": 1883.0,
      "end": 1888.0,
      "formatted_start": "00:31:23.000",
      "formatted_end": "00:31:28.000",
      "text": "اونجا هم قدرش گرفت قدرش ۱۰ پایین باره"
    },
    {
      "id": 23,
      "start": 1888.0,
      "end": 1890.0,
      "formatted_start": "00:31:28.000",
      "formatted_end": "00:31:30.000",
      "text": "کمی پایین میدارست"
    },
    {
      "id": 24,
      "start": 1890.0,
      "end": 1892.0,
      "formatted_start": "00:31:30.000",
      "formatted_end": "00:31:32.000",
      "text": "۳۲"
    },
    {
      "id": 25,
      "start": 1892.0,
      "end": 1894.0,
      "formatted_start": "00:31:32.000",
      "formatted_end": "00:31:34.000",
      "text": "۲۲"
    },
    {
      "id": 26,
      "start": 1894.0,
      "end": 1896.0,
      "formatted_start": "00:31:34.000",
