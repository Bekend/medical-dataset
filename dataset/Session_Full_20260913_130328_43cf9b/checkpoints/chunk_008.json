  "stt_segments": [
    {
      "id": 0,
      "start": 2400.0,
      "end": 2410.0,
      "formatted_start": "00:40:00.000",
      "formatted_end": "00:40:10.000",
      "text": "این کار هم کار نرم افزاری برده. اصلا قوقلاد است. اصلا هستادو کتاب درخواه نمیدونه. هستادو کتاب درخواه این گیت را دیدن، میرفت، اصلا نمیدونه."
    },
    {
      "id": 1,
      "start": 2410.0,
      "end": 2427.0,
      "formatted_start": "00:40:10.000",
      "formatted_end": "00:40:27.000",
      "text": "یه مدت من و خدا بیا هست با روش گفتادیم که سیران دست بردارد، کتاب وارث این همه زحمتی پنجاب سر با وصفت همه کشیده بشون، گفت من گفتم اون به من، گفتم بینم، گفتم حرف رو گوشته میکرد."
    },
    {
      "id": 2,
      "start": 2427.0,
      "end": 2432.46,
      "formatted_start": "00:40:27.000",
      "formatted_end": "00:40:32.460",
      "text": "بعد این ناگهان برعکس شد."
    },
    {
      "id": 3,
      "start": 2432.46,
      "end": 2436.16,
      "formatted_start": "00:40:32.460",
      "formatted_end": "00:40:36.160",
      "text": "یعنی اصلا با خربار می گرده داروکران رو متوجه نمی بود."
    },
    {
      "id": 4,
      "start": 2436.16,
      "end": 2443.34,
      "formatted_start": "00:40:36.160",
      "formatted_end": "00:40:43.340",
      "text": "یه دقیقه اومد تو دستش که من باید اینجا خیلی مماثل باشم و اصلا قطعه چکانی حضیره کنم."
    },
    {
      "id": 5,
      "start": 2443.34,
      "end": 2445.34,
      "formatted_start": "00:40:43.340",
      "formatted_end": "00:40:45.340",
      "text": "چیز نکنم."
    },
    {
      "id": 6,
      "start": 2445.34,
      "end": 2446.8,
      "formatted_start": "00:40:45.340",
      "formatted_end": "00:40:46.800",
      "text": "قرارم از این بر افتاده."
    },
    {
      "id": 7,
      "start": 2446.8,
      "end": 2448.8,
      "formatted_start": "00:40:46.800",
      "formatted_end": "00:40:48.800",
      "text": "یعنی نمی خره."
    },
    {
      "id": 8,
      "start": 2448.8,
      "end": 2450.8,
      "formatted_start": "00:40:48.800",
      "formatted_end": "00:40:50.800",
      "text": "حضیره نمی کنه."
    },
    {
      "id": 9,
      "start": 2450.8,
      "end": 2452.8,
      "formatted_start": "00:40:50.800",
      "formatted_end": "00:40:52.800",
      "text": "می ترسه بمونه تاریخش بگذره."
    },
    {
      "id": 10,
      "start": 2452.8,
      "end": 2460.8,
      "formatted_start": "00:40:52.800",
      "formatted_end": "00:41:00.800",
      "text": "به جای اینکه این ترس رو داشته باشه باعثیم برنامه نیزی تاریخ ها رو داشته باشه"
    },
    {
      "id": 11,
      "start": 2460.8,
      "end": 2465.8,
      "formatted_start": "00:41:00.800",
      "formatted_end": "00:41:05.800",
      "text": "یه جدول اینجوری باید درست بکنه نسبت به تاریخ های داروها"
    },
    {
      "id": 12,
      "start": 2465.8,
      "end": 2472.8,
      "formatted_start": "00:41:05.800",
      "formatted_end": "00:41:12.800",
      "text": "اونا ببینه که مثلا داروهایی که شیش ماه مونده رو رلیف بکنه"
    },
    {
      "id": 13,
      "start": 2472.8,
      "end": 2475.8,
      "formatted_start": "00:41:12.800",
      "formatted_end": "00:41:15.800",
      "text": "بعد چانه زنی کنه با پیزشگاهی که هی طرف هست"
    },
    {
      "id": 14,
      "start": 2475.8,
      "end": 2478.8,
      "formatted_start": "00:41:15.800",
      "formatted_end": "00:41:18.800",
      "text": "اولویت بده دادن داروها شما"
    },
    {
      "id": 15,
      "start": 2478.8,
      "end": 2484.8,
      "formatted_start": "00:41:18.800",
      "formatted_end": "00:41:24.800",
      "text": "داربهایی که سه ماه مادر رو در اولمیت های شریف بزاره اولمیت پندی رو باید به توی نیست بکنن"
    },
    {
      "id": 16,
      "start": 2484.8,
      "end": 2491.8,
      "formatted_start": "00:41:24.800",
      "formatted_end": "00:41:31.800",
      "text": "داربهایی که سه سال تاریخ دارن، دو سال تاریخ دارن، بسایی برسیش نکردن"
    },
    {
      "id": 17,
      "start": 2491.8,
      "end": 2497.8,
      "formatted_start": "00:41:31.800",
      "formatted_end": "00:41:37.800",
      "text": "توی نسخه آمد بدهده، ولی نسبت به اونهایی که اتحادشون اونجایی نزدیکه"
    },
    {
      "id": 18,
      "start": 2497.8,
      "end": 2502.8,
      "formatted_start": "00:41:37.800",
      "formatted_end": "00:41:42.800",
      "text": "و تغییر قیمتها رو باید سی داشته باشه، تغییر قیمت بدهد"
    },
    {
      "id": 19,
      "start": 2502.8,
      "end": 2517.36,
      "formatted_start": "00:41:42.800",
      "formatted_end": "00:41:57.360",
      "text": "و یک نظام انبارگرداری یه علمیه توی اختصار انبارگرداری که بتونه همیشه از یک مسیری بذاره توی این فریزر از یک مسیر دیگه برداره"
    },
    {
      "id": 20,
      "start": 2517.36,
      "end": 2526.24,
      "formatted_start": "00:41:57.360",
      "formatted_end": "00:42:06.240",
      "text": "اونو که امروز دیروز رو داشته امروز برنده اونو که شیش ماه پیش گذاشته رو امروز برداره که این ترانو به صورت نگهرداری"
    },
    {
      "id": 21,
      "start": 2526.24,
      "end": 2536.24,
      "formatted_start": "00:42:06.240",
      "formatted_end": "00:42:16.240",
      "text": "هموز به این رزلت نشده، دو سه تا گرفتاری داره خانمش به شدت، پدر خانمش سرطان خون گرفت، درمان آن شده"
    },
    {
      "id": 22,
      "start": 2536.24,
      "end": 2546.24,
      "formatted_start": "00:42:16.240",
      "formatted_end": "00:42:26.240",
      "text": "چند دوره مشرف به خود شد، خانمش بابو شاهده این مسائل و زایمانش و جمعه نفاسی و اینا بیماری روانی گرفت به شدت"
    },
    {
      "id": 23,
      "start": 2546.24,
      "end": 2550.24,
      "formatted_start": "00:42:26.240",
      "formatted_end": "00:42:30.240",
      "text": "مشکول اون شد. الان خانمش خوب شده تقریبا."
    },
    {
      "id": 24,
      "start": 2550.24,
      "end": 2560.24,
      "formatted_start": "00:42:30.240",
      "formatted_end": "00:42:40.240",
      "text": "یه متابه داره. گرفتاری های اینچنینی نمیذاره که من درش یک تحقیم ایجاد بکنم."
    },
    {
      "id": 25,
      "start": 2560.24,
      "end": 2567.24,
      "formatted_start": "00:42:40.240",
      "formatted_end": "00:42:47.240",
      "text": "من یک کار باید کشم. مسائل باید میتونم حسن بذارم و فکرش رو عوض بکنم."
    },
    {
      "id": 26,
      "start": 2567.24,
      "end": 2572.24,
      "formatted_start": "00:42:47.240",
      "formatted_end": "00:42:52.240",
      "text": "ولی خب نیازمه چند جلسه کار. قبل خونه ما میشه از."
    },
    {
      "id": 27,
      "start": 2572.24,
      "end": 2580.7,
      "formatted_start": "00:42:52.240",
      "formatted_end": "00:43:00.700",
      "text": "این موضوعش میشه. الان دو ساله که جدا شده رفتن رو می خریده خودش رو میدی."
    },
    {
      "id": 28,
      "start": 2580.7,
      "end": 2586.84,
      "formatted_start": "00:43:00.700",
      "formatted_end": "00:43:06.840",
      "text": "مطمئن کمکش کرده. ولی با همه این حرف ها از من هم شرعبی دارم شده."
    },
    {
      "id": 29,
      "start": 2586.84,
      "end": 2592.6,
      "formatted_start": "00:43:06.840",
      "formatted_end": "00:43:12.600",
      "text": "ولی اعتقاد یه چیز دیگه. وقتی در وجود یک کسی اعتقاد ایجاد میشه"
    },
    {
      "id": 30,
      "start": 2592.6,
      "end": 2596.8,
      "formatted_start": "00:43:12.600",
      "formatted_end": "00:43:16.800",
      "text": "دیگه بعد نیاز به گفتار نداره. او دیگه به اون مذهب گره میده."
    },
    {
      "id": 31,
      "start": 2596.8,
      "end": 2599.44,
      "formatted_start": "00:43:16.800",
      "formatted_end": "00:43:19.440",
      "text": "دیگه او دیگه ادامه میده. او خودش میده."
    },
    {
      "id": 32,
      "start": 2599.44,
      "end": 2602.44,
      "formatted_start": "00:43:19.440",
      "formatted_end": "00:43:22.440",
      "text": "بعد حتی میره از من چلوتر میفته در اون کار"
    },
    {
      "id": 33,
      "start": 2602.44,
      "end": 2605.44,
      "formatted_start": "00:43:22.440",
      "formatted_end": "00:43:25.440",
      "text": "منم بگم نکن میگنن اعتقادشون"
    },
    {
      "id": 34,
      "start": 2605.44,
      "end": 2610.44,
      "formatted_start": "00:43:25.440",
      "formatted_end": "00:43:30.440",
      "text": "اعتقاد صحیح برای کارهای صحیح خوبه"
    },
    {
      "id": 35,
      "start": 2610.44,
      "end": 2614.44,
      "formatted_start": "00:43:30.440",
      "formatted_end": "00:43:34.440",
      "text": "بعد دید و مسیر را ادامه"
    },
    {
      "id": 36,
      "start": 2614.44,
      "end": 2618.44,
      "formatted_start": "00:43:34.440",
      "formatted_end": "00:43:38.440",
      "text": "چیمشون؟"
    },
    {
      "id": 37,
      "start": 2618.44,
      "end": 2621.44,
      "formatted_start": "00:43:38.440",
      "formatted_end": "00:43:41.440",
      "text": "یکی بزنشته"
    },
    {
      "id": 38,
      "start": 2621.44,
      "end": 2622.44,
      "formatted_start": "00:43:41.440",
      "formatted_end": "00:43:42.440",
      "text": "که؟"
    },
    {
      "id": 39,
      "start": 2622.44,
      "end": 2623.44,
      "formatted_start": "00:43:42.440",
      "formatted_end": "00:43:43.440",
      "text": "همه چیز"
    },
    {
      "id": 40,
      "start": 2623.44,
      "end": 2625.44,
      "formatted_start": "00:43:43.440",
      "formatted_end": "00:43:45.440",
      "text": "همه رو؟"
    },
    {
      "id": 41,
      "start": 2625.44,
      "end": 2627.44,
      "formatted_start": "00:43:45.440",
      "formatted_end": "00:43:47.440",
      "text": "همه چیز"
    },
    {
      "id": 42,
      "start": 2627.44,
      "end": 2648.44,
      "formatted_start": "00:43:47.440",
      "formatted_end": "00:44:08.440",
      "text": "این اعتقاد ایجاد بشه که امبارگردانی چی هست، خرید دارو چی هست، مثلا چجوری باید دارو دپو بکنیم، چجوری باید بفروشیم،"
    },
    {
      "id": 43,
      "start": 2648.44,
      "end": 2652.2,
      "formatted_start": "00:44:08.440",
      "formatted_end": "00:44:12.200",
      "text": "حتی بعضی جایی نفر موشیم به نفر ماست"
    },
    {
      "id": 44,
      "start": 2652.2,
      "end": 2661.2,
      "formatted_start": "00:44:12.200",
      "formatted_end": "00:44:21.200",
      "text": "خب اینها رو باعث به شکل یک اعتقاد بپذیره تا این کارها تصحیم میشه"
    },
    {
      "id": 45,
      "start": 2661.2,
      "end": 2662.96,
      "formatted_start": "00:44:21.200",
      "formatted_end": "00:44:22.960",
      "text": "و صحبت شما رو تصحیم برداد"
    },
    {
      "id": 46,
      "start": 2662.96,
      "end": 2664.2,
      "formatted_start": "00:44:22.960",
      "formatted_end": "00:44:24.200",
      "text": "آره انشالله"
    },
    {
      "id": 47,
      "start": 2664.2,
      "end": 2668.44,
      "formatted_start": "00:44:24.200",
      "formatted_end": "00:44:28.440",
      "text": "انشالله که الان الحمدلله از اون خانمش که خیلی شده"
    },
    {
      "id": 48,
      "start": 2668.44,
      "end": 2672.44,
      "formatted_start": "00:44:28.440",
      "formatted_end": "00:44:32.440",
      "text": "به روح باشم بد نیست الان اون فضیعتی"
    },
    {
      "id": 49,
      "start": 2672.44,
      "end": 2676.44,
      "formatted_start": "00:44:32.440",
      "formatted_end": "00:44:36.440",
      "text": "برنامه بیان مختار یادم از این مرد رو"
    },
    {
      "id": 50,
      "start": 2676.44,
      "end": 2684.76,
      "formatted_start": "00:44:36.440",
      "formatted_end": "00:44:44.760",
      "text": "من رو یادم میره که اینجا دو روزه که برای یه چیز دیگه"
    },
    {
      "id": 51,
