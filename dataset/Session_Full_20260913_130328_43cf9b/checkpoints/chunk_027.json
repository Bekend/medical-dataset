  "stt_segments": [
    {
      "id": 0,
      "start": 8100.0,
      "end": 8105.0,
      "formatted_start": "02:15:00.000",
      "formatted_end": "02:15:05.000",
      "text": "دو تا محلوم داره، هفته یه باره، شوینده ها هر روزه."
    },
    {
      "id": 1,
      "start": 8105.0,
      "end": 8106.0,
      "formatted_start": "02:15:05.000",
      "formatted_end": "02:15:06.000",
      "text": "حالا گرفتی؟"
    },
    {
      "id": 2,
      "start": 8106.0,
      "end": 8108.0,
      "formatted_start": "02:15:06.000",
      "formatted_end": "02:15:08.000",
      "text": "آره، دیده قبلنم رفت در دوباره."
    },
    {
      "id": 3,
      "start": 8108.0,
      "end": 8111.0,
      "formatted_start": "02:15:08.000",
      "formatted_end": "02:15:11.000",
      "text": "بله، دیدم، بله، همه فایده نداشت."
    },
    {
      "id": 4,
      "start": 8111.0,
      "end": 8113.0,
      "formatted_start": "02:15:11.000",
      "formatted_end": "02:15:13.000",
      "text": "بعد، هر این قضایی چی نداره؟"
    },
    {
      "id": 5,
      "start": 8113.0,
      "end": 8116.0,
      "formatted_start": "02:15:13.000",
      "formatted_end": "02:15:16.000",
      "text": "فلفل، عدوی داروگر، ترشی، سرک."
    },
    {
      "id": 6,
      "start": 8116.0,
      "end": 8120.0,
      "formatted_start": "02:15:16.000",
      "formatted_end": "02:15:20.000",
      "text": "من هر چی بخورم، درم خواهش بدم، هر چی بمونده."
    },
    {
      "id": 7,
      "start": 8120.0,
      "end": 8126.0,
      "formatted_start": "02:15:20.000",
      "formatted_end": "02:15:26.000",
      "text": "داروها شو گرفتی، بیار من آموزش بدم، باز دوباره هفته یه برن، امیوز بدم."
    },
    {
      "id": 8,
      "start": 8126.0,
      "end": 8129.0,
      "formatted_start": "02:15:26.000",
      "formatted_end": "02:15:29.000",
      "text": "یک شمب از هفته و دو شمب بیانیم"
    },
    {
      "id": 9,
      "start": 8129.0,
      "end": 8131.0,
      "formatted_start": "02:15:29.000",
      "formatted_end": "02:15:31.000",
      "text": "بساله"
    },
    {
      "id": 10,
      "start": 8131.0,
      "end": 8134.0,
      "formatted_start": "02:15:31.000",
      "formatted_end": "02:15:34.000",
      "text": "خدا ببخش مادر خیلی خوش آمده"
    },
    {
      "id": 11,
      "start": 8134.0,
      "end": 8138.0,
      "formatted_start": "02:15:34.000",
      "formatted_end": "02:15:38.000",
      "text": "هلا رو موازد باشین که الان بیانیم سفت خودم"
    },
    {
      "id": 12,
      "start": 8148.0,
      "end": 8150.0,
      "formatted_start": "02:15:48.000",
      "formatted_end": "02:15:50.000",
      "text": "سلام"
    },
    {
      "id": 13,
      "start": 8150.0,
      "end": 8152.0,
      "formatted_start": "02:15:50.000",
      "formatted_end": "02:15:52.000",
      "text": "بیا خوش آمده"
    },
    {
      "id": 14,
      "start": 8152.0,
      "end": 8154.0,
      "formatted_start": "02:15:52.000",
      "formatted_end": "02:15:54.000",
      "text": "سلام"
    },
    {
      "id": 15,
      "start": 8154.0,
      "end": 8157.0,
      "formatted_start": "02:15:54.000",
      "formatted_end": "02:15:57.000",
      "text": "این بار شما رو درست کنید"
    },
    {
      "id": 16,
      "start": 8161.0,
      "end": 8165.0,
      "formatted_start": "02:16:01.000",
      "formatted_end": "02:16:05.000",
      "text": "حرکت شما هست دوازدره ششصد و نیفته"
    },
    {
      "id": 17,
      "start": 8171.0,
      "end": 8177.0,
      "formatted_start": "02:16:11.000",
      "formatted_end": "02:16:17.000",
      "text": "کیسه سفرا داخلش لجن هست"
    },
    {
      "id": 18,
      "start": 8177.0,
      "end": 8186.0,
      "formatted_start": "02:16:17.000",
      "formatted_end": "02:16:26.000",
      "text": "اگر این لجنش صفر بشه اینجا سنگ می کند و سنگ باید دربانش جرده ای است."
    },
    {
      "id": 19,
      "start": 8186.0,
      "end": 8188.0,
      "formatted_start": "02:16:26.000",
      "formatted_end": "02:16:28.000",
      "text": "سنگ را تو برد کنید."
    },
    {
      "id": 20,
      "start": 8188.0,
      "end": 8193.0,
      "formatted_start": "02:16:28.000",
      "formatted_end": "02:16:33.000",
      "text": "برای جلو گیری از این، کپسو بی هست به اسم برس و خلو باید بخوانید."
    },
    {
      "id": 21,
      "start": 8193.0,
      "end": 8198.0,
      "formatted_start": "02:16:33.000",
      "formatted_end": "02:16:38.000",
      "text": "و یکی مسانت هم دیواره اش یک مشکلی دارد."
    },
    {
      "id": 22,
      "start": 8198.0,
      "end": 8203.0,
      "formatted_start": "02:16:38.000",
      "formatted_end": "02:16:43.000",
      "text": "سبت پرینه در این وارد دارد و سبت پرینه ها می شوند."
    },
    {
      "id": 23,
      "start": 8203.0,
      "end": 8205.0,
      "formatted_start": "02:16:43.000",
      "formatted_end": "02:16:45.000",
      "text": "ادرال میرسه واسه و؟"
    },
    {
      "id": 24,
      "start": 8205.0,
      "end": 8206.0,
      "formatted_start": "02:16:45.000",
      "formatted_end": "02:16:46.000",
      "text": "نه"
    },
    {
      "id": 25,
      "start": 8206.0,
      "end": 8208.0,
      "formatted_start": "02:16:46.000",
      "formatted_end": "02:16:48.000",
      "text": "مثلا نمیتونی خوب نگه داری؟"
    },
    {
      "id": 26,
      "start": 8208.0,
      "end": 8209.0,
      "formatted_start": "02:16:48.000",
      "formatted_end": "02:16:49.000",
      "text": "آمید"
    },
    {
      "id": 27,
      "start": 8209.0,
      "end": 8211.0,
      "formatted_start": "02:16:49.000",
      "formatted_end": "02:16:51.000",
      "text": "نمیرسه به بسیاری"
    },
    {
      "id": 28,
      "start": 8211.0,
      "end": 8216.0,
      "formatted_start": "02:16:51.000",
      "formatted_end": "02:16:56.000",
      "text": "یعنی خوب نمیتونی تخریش کنی یا خوب نمیتونی نگه داری؟"
    },
    {
      "id": 29,
      "start": 8216.0,
      "end": 8219.0,
      "formatted_start": "02:16:56.000",
      "formatted_end": "02:16:59.000",
      "text": "نه، بعضی مورد هم از ما یک عکس و ایدرا و کداشت"
    },
    {
      "id": 30,
      "start": 8219.0,
      "end": 8220.0,
      "formatted_start": "02:16:59.000",
      "formatted_end": "02:17:00.000",
      "text": "میرسه؟"
    },
    {
      "id": 31,
      "start": 8220.0,
      "end": 8221.0,
      "formatted_start": "02:17:00.000",
      "formatted_end": "02:17:01.000",
      "text": "آمید"
    },
    {
      "id": 32,
      "start": 8221.0,
      "end": 8225.0,
      "formatted_start": "02:17:01.000",
      "formatted_end": "02:17:05.000",
      "text": "یعنی خوب نمیتونی تخریش کنی یا خوب نمیتونی نگه داری؟"
    },
    {
      "id": 33,
      "start": 8225.0,
      "end": 8228.0,
      "formatted_start": "02:17:05.000",
      "formatted_end": "02:17:08.000",
      "text": "نه، بعضی مورد هم از ما یک عکس و ایدرا و کداشت"
    },
    {
      "id": 34,
      "start": 8228.0,
      "end": 8229.0,
      "formatted_start": "02:17:08.000",
      "formatted_end": "02:17:09.000",
      "text": "میرسه؟"
    },
    {
      "id": 35,
      "start": 8229.0,
      "end": 8230.0,
      "formatted_start": "02:17:09.000",
      "formatted_end": "02:17:10.000",
      "text": "آمید"
    },
    {
      "id": 36,
      "start": 8230.0,
      "end": 8234.48,
      "formatted_start": "02:17:10.000",
      "formatted_end": "02:17:14.480",
      "text": "خیلی درد دارم"
    },
    {
      "id": 37,
      "start": 8234.48,
      "end": 8237.44,
      "formatted_start": "02:17:14.480",
      "formatted_end": "02:17:17.440",
      "text": "تو مساهم"
    },
    {
      "id": 38,
      "start": 8237.44,
      "end": 8240.36,
      "formatted_start": "02:17:17.440",
      "formatted_end": "02:17:20.360",
      "text": "نمیشه درد دارم"
    },
    {
      "id": 39,
      "start": 8240.36,
      "end": 8241.48,
      "formatted_start": "02:17:20.360",
      "formatted_end": "02:17:21.480",
      "text": "جا"
    },
    {
      "id": 40,
      "start": 8241.48,
      "end": 8242.92,
      "formatted_start": "02:17:21.480",
      "formatted_end": "02:17:22.920",
      "text": "درد دارم"
    },
    {
      "id": 41,
      "start": 8242.92,
      "end": 8244.82,
      "formatted_start": "02:17:22.920",
      "formatted_end": "02:17:24.820",
      "text": "اینه درد دارم"
    },
    {
      "id": 42,
      "start": 8244.82,
      "end": 8264.82,
      "formatted_start": "02:17:24.820",
      "formatted_end": "02:17:44.820",
      "text": "موسیقی"
    },
    {
      "id": 43,
      "start": 8264.82,
      "end": 8266.82,
      "formatted_start": "02:17:44.820",
      "formatted_end": "02:17:46.820",
      "text": "اونا با دوستای دیروز بگو میشه"
    },
    {
      "id": 44,
      "start": 8266.82,
      "end": 8268.82,
      "formatted_start": "02:17:46.820",
      "formatted_end": "02:17:48.820",
      "text": "ولی اینی که هرگان دارم بیدم"
    },
    {
      "id": 45,
      "start": 8268.82,
      "end": 8272.82,
      "formatted_start": "02:17:48.820",
      "formatted_end": "02:17:52.820",
      "text": "برای ببخش جای بچه دان و مسامه و اینا برم"
    },
    {
      "id": 46,
      "start": 8272.82,
      "end": 8274.82,
      "formatted_start": "02:17:52.820",
      "formatted_end": "02:17:54.820",
      "text": "کبده"
    },
    {
      "id": 47,
      "start": 8274.82,
      "end": 8277.82,
      "formatted_start": "02:17:54.820",
      "formatted_end": "02:17:57.820",
      "text": "بعد ترشون هم چیزی داری؟"
    },
    {
      "id": 48,
      "start": 8277.82,
      "end": 8279.82,
      "formatted_start": "02:17:57.820",
      "formatted_end": "02:17:59.820",
      "text": "بعضی میکنه برای برگون"
    },
    {
      "id": 49,
      "start": 8279.82,
      "end": 8281.82,
      "formatted_start": "02:17:59.820",
      "formatted_end": "02:18:01.820",
      "text": "برگون میشه یا بلون؟"
    },
    {
      "id": 50,
      "start": 8281.82,
      "end": 8283.82,
      "formatted_start": "02:18:01.820",
      "formatted_end": "02:18:03.820",
      "text": "نه برگون نیست"
    },
    {
      "id": 51,
      "start": 8283.82,
      "end": 8284.82,
      "formatted_start": "02:18:03.820",
      "formatted_end": "02:18:04.820",
      "text": "نیست؟"
    },
    {
      "id": 52,
      "start": 8284.82,
      "end": 8285.82,
      "formatted_start": "02:18:04.820",
      "formatted_end": "02:18:05.820",
      "text": "نه"
    },
    {
      "id": 53,
      "start": 8285.82,
      "end": 8287.82,
      "formatted_start": "02:18:05.820",
      "formatted_end": "02:18:07.820",
      "text": "برگون نیست بسیار ببین کنم"
    },
    {
      "id": 54,
      "start": 8287.82,
      "end": 8289.82,
      "formatted_start": "02:18:07.820",
      "formatted_end": "02:18:09.820",
      "text": "برسو بردو"
    },
    {
      "id": 55,
      "start": 8289.82,
      "end": 8291.82,
      "formatted_start": "02:18:09.820",
      "formatted_end": "02:18:11.820",
      "text": "تورتور بی"
    },
    {
      "id": 56,
      "start": 8291.82,
      "end": 8293.82,
      "formatted_start": "02:18:11.820",
      "formatted_end": "02:18:13.820",
      "text": "دکسی که بسیر"
    },
    {
      "id": 57,
      "start": 8293.82,
      "end": 8295.82,
      "formatted_start": "02:18:13.820",
      "formatted_end": "02:18:15.820",
      "text": "برسو بردو"
    },
    {
      "id": 58,
      "start": 8295.82,
      "end": 8297.82,
      "formatted_start": "02:18:15.820",
      "formatted_end": "02:18:17.820",
      "text": "چیزی داری؟ برسو بردو؟"
    },
    {
      "id": 59,
      "start": 8297.82,
      "end": 8299.82,
      "formatted_start": "02:18:17.820",
      "formatted_end": "02:18:19.820",
      "text": "اوشان گلست ساره ای بود"
    },
    {
      "id": 60,
      "start": 8299.82,
      "end": 8301.82,
      "formatted_start": "02:18:19.820",
      "formatted_end": "02:18:21.820",
      "text": "آهان یه آزادی زندگی کار"
    },
    {
      "id": 61,
      "start": 8301.82,
      "end": 8303.82,
      "formatted_start": "02:18:21.820",
      "formatted_end": "02:18:23.820",
      "text": "یه"
    },
    {
      "id": 62,
      "start": 8303.82,
      "end": 8305.82,
      "formatted_start": "02:18:23.820",
      "formatted_end": "02:18:25.820",
      "text": "یه"
    },
    {
      "id": 63,
      "start": 8305.82,
      "end": 8307.82,
      "formatted_start": "02:18:25.820",
      "formatted_end": "02:18:27.820",
      "text": "بردو"
    },
    {
      "id": 64,
      "start": 8307.82,
      "end": 8309.82,
      "formatted_start": "02:18:27.820",
      "formatted_end": "02:18:29.820",
      "text": "بردو"
    },
    {
      "id": 65,
      "start": 8317.82,
      "end": 8321.82,
      "formatted_start": "02:18:37.820",
      "formatted_end": "02:18:41.820",
      "text": "شکم صرف کار میکنی؟"
    },
    {
      "id": 66,
      "start": 8321.82,
      "end": 8322.82,
      "formatted_start": "02:18:41.820",
      "formatted_end": "02:18:42.820",
      "text": "آره"
    },
    {
      "id": 67,
      "start": 8322.82,
      "end": 8323.82,
      "formatted_start": "02:18:42.820",
      "formatted_end": "02:18:43.820",
      "text": "خیلی؟"
    },
    {
      "id": 68,
      "start": 8323.82,
      "end": 8327.82,
      "formatted_start": "02:18:43.820",
      "formatted_end": "02:18:47.820",
      "text": "خیلی، ولی موقع اصلاً دلیل به یک بلدپختی"
    },
    {
      "id": 69,
      "start": 8327.82,
      "end": 8330.82,
      "formatted_start": "02:18:47.820",
      "formatted_end": "02:18:50.820",
      "text": "چی بگم یه جوری دیگه هم خدالت میکنی"
    },
    {
      "id": 70,
      "start": 8330.82,
      "end": 8333.82,
      "formatted_start": "02:18:50.820",
      "formatted_end": "02:18:53.820",
      "text": "سنگی، دردیگه چرا؟ این کار رو بکنی؟"
    },
    {
      "id": 71,
      "start": 8333.82,
      "end": 8335.82,
      "formatted_start": "02:18:53.820",
      "formatted_end": "02:18:55.820",
      "text": "دردوشن"
    },
    {
      "id": 72,
      "start": 8335.82,
      "end": 8343.82,
      "formatted_start": "02:18:55.820",
      "formatted_end": "02:19:03.820",
      "text": "این داخلیات با این خوب میشه، دردهای سرما خودگیدی و برنامه دیگه هم با اون فردید"
    },
    {
      "id": 73,
      "start": 8343.82,
      "end": 8345.82,
      "formatted_start": "02:19:03.820",
      "formatted_end": "02:19:05.820",
      "text": "باز که بیا؟"
    },
    {
      "id": 74,
      "start": 8345.82,
      "end": 8357.82,
      "formatted_start": "02:19:05.820",
      "formatted_end": "02:19:17.820",
      "text": "این رو استفاده کن، امروز یک شنبه، این شنبه که میاد نه، بخشید، چاشنبه یه هفته بعد میشین"
    },
    {
      "id": 75,
      "start": 8357.82,
      "end": 8359.82,
      "formatted_start": "02:19:17.820",
      "formatted_end": "02:19:19.820",
      "text": "چاشنبه یه هفته بعد میاد؟"
    },
    {
      "id": 76,
      "start": 8359.82,
      "end": 8362.82,
      "formatted_start": "02:19:19.820",
      "formatted_end": "02:19:22.820",
      "text": "چاشنبه که میاد سه روز دیگه نه، هفته بعد"
    },
    {
      "id": 77,
      "start": 8362.82,
      "end": 8364.82,
      "formatted_start": "02:19:22.820",
      "formatted_end": "02:19:24.820",
      "text": "درستانو هم بیارن؟"
    },
    {
      "id": 78,
      "start": 8364.82,
      "end": 8367.82,
      "formatted_start": "02:19:24.820",
      "formatted_end": "02:19:27.820",
      "text": "همه رو بیارن، دادن بیارن، نه استفاده باشین"
    },
    {
      "id": 79,
      "start": 8367.82,
      "end": 8368.82,
      "formatted_start": "02:19:27.820",
      "formatted_end": "02:19:28.820",
      "text": "اینجا میبینید؟"
    },
    {
      "id": 80,
      "start": 8368.82,
      "end": 8369.82,
      "formatted_start": "02:19:28.820",
      "formatted_end": "02:19:29.820",
      "text": "اینجا میبینید"
    },
    {
      "id": 81,
      "start": 8369.82,
      "end": 8371.82,
      "formatted_start": "02:19:29.820",
      "formatted_end": "02:19:31.820",
      "text": "تشور سروری براجی نمی بسنید؟"
    },
    {
      "id": 82,
      "start": 8371.82,
      "end": 8374.82,
      "formatted_start": "02:19:31.820",
      "formatted_end": "02:19:34.820",
      "text": "نمی بسنید، خدا کنید، درش مادر نمی بسنید"
    },
    {
      "id": 83,
      "start": 8374.82,
      "end": 8376.9,
      "formatted_start": "02:19:34.820",
      "formatted_end": "02:19:36.900",
      "text": "بسیار هر دو تا دسته رو بیارون"
    },
    {
      "id": 84,
      "start": 8376.9,
      "end": 8377.66,
      "formatted_start": "02:19:36.900",
      "formatted_end": "02:19:37.660",
      "text": "باش"
    },
    {
      "id": 85,
      "start": 8377.66,
      "end": 8379.88,
      "formatted_start": "02:19:37.660",
      "formatted_end": "02:19:39.880",
      "text": "چارشن بیار دیگه"
    },
    {
      "id": 86,
      "start": 8379.88,
      "end": 8398.6,
      "formatted_start": "02:19:39.880",
      "formatted_end": "02:19:58.600",
      "text": "بسیار هستن"
    }
  ],
  "status": "completed"
}