  "stt_segments": [
    {
      "id": 0,
      "start": 4500.0,
      "end": 4506.0,
      "formatted_start": "01:15:00.000",
      "formatted_end": "01:15:06.000",
      "text": "بیمار دیابت برای درمان دیابت به خواهد می آورد؟"
    },
    {
      "id": 1,
      "start": 4506.0,
      "end": 4510.0,
      "formatted_start": "01:15:06.000",
      "formatted_end": "01:15:10.000",
      "text": "نیست، بیمار دیابت برای قادرتش می آورد، دیابت هم دارد."
    },
    {
      "id": 2,
      "start": 4510.0,
      "end": 4515.0,
      "formatted_start": "01:15:10.000",
      "formatted_end": "01:15:15.000",
      "text": "بیمار دیابتی، ترموانی بیمار دیابتی باید یک سوال باشه."
    },
    {
      "id": 3,
      "start": 4515.0,
      "end": 4521.0,
      "formatted_start": "01:15:15.000",
      "formatted_end": "01:15:21.000",
      "text": "ترموانی بیمار دیابتی، ما در روز مثلاً 5 کماره ما بیمار دیابتی داریم."
    },
    {
      "id": 4,
      "start": 4521.0,
      "end": 4529.0,
      "formatted_start": "01:15:21.000",
      "formatted_end": "01:15:29.000",
      "text": "اما برای درمان دیابت نیم، این بیماره که قبلاً دیابت داشته تحت درمان هست، من یا دیگر."
    },
    {
      "id": 5,
      "start": 4529.0,
      "end": 4538.5,
      "formatted_start": "01:15:29.000",
      "formatted_end": "01:15:38.500",
      "text": "پستش، آره. ما سر ما پنج تا از پریزه ها منو به طور متوسط دیاویتی هم پستن. اگه داراشون تموم شده باشه براشون پشتش بکنیم."
    },
    {
      "id": 6,
      "start": 4538.5,
      "end": 4546.0,
      "formatted_start": "01:15:38.500",
      "formatted_end": "01:15:46.000",
      "text": "اگه نشونه باشه، مثلا میگه دارم که نمیتونیم بشین بدیم. پنج تایی که مثلا میگم پستش داریم."
    },
    {
      "id": 7,
      "start": 4546.0,
      "end": 4555.0,
      "formatted_start": "01:15:46.000",
      "formatted_end": "01:15:55.000",
      "text": "اونایی که بخوان به طرف بد کنترل شدن، مثلا داره میتکرمین تنها می کنه یا روزیه داره میتکرمین کنه،"
    },
    {
      "id": 8,
      "start": 4555.0,
      "end": 4563.24,
      "formatted_start": "01:15:55.000",
      "formatted_end": "01:16:03.240",
      "text": "این رو می‌گویم اصلاح می‌کنیم مثلا به خیلی از میت فرمین یه گره‌کابل هم در کنار مصنف کن"
    },
    {
      "id": 9,
      "start": 4563.24,
      "end": 4569.16,
      "formatted_start": "01:16:03.240",
      "formatted_end": "01:16:09.160",
      "text": "تا مثلا دفعه ایترالی هم داشته باشه از سر ایل آغند و بهتر بشه"
    },
    {
      "id": 10,
      "start": 4569.16,
      "end": 4574.64,
      "formatted_start": "01:16:09.160",
      "formatted_end": "01:16:14.640",
      "text": "بعد ایوانسی‌شون می‌آمدن یه قایه می‌گیریم یه بردیر می‌گیریم این کار رو"
    },
    {
      "id": 11,
      "start": 4574.64,
      "end": 4581.24,
      "formatted_start": "01:16:14.640",
      "formatted_end": "01:16:21.240",
      "text": "ولی بیمار به عنوان دهنمون دیابتش صرفا بر اول بخوادی جمع جمعیت کنه"
    },
    {
      "id": 12,
      "start": 4581.24,
      "end": 4584.3,
      "formatted_start": "01:16:21.240",
      "formatted_end": "01:16:24.300",
      "text": "کم رفته یه دونه پیش می آورد"
    },
    {
      "id": 13,
      "start": 4584.3,
      "end": 4586.7,
      "formatted_start": "01:16:24.300",
      "formatted_end": "01:16:26.700",
      "text": "در کنارش یعنی آیا ببینید امکانش این هست؟"
    },
    {
      "id": 14,
      "start": 4586.7,
      "end": 4588.76,
      "formatted_start": "01:16:26.700",
      "formatted_end": "01:16:28.760",
      "text": "این نشن رفته شده می گرد"
    },
    {
      "id": 15,
      "start": 4588.76,
      "end": 4589.26,
      "formatted_start": "01:16:28.760",
      "formatted_end": "01:16:29.260",
      "text": "آره"
    },
    {
      "id": 16,
      "start": 4589.26,
      "end": 4591.66,
      "formatted_start": "01:16:29.260",
      "formatted_end": "01:16:31.660",
      "text": "اون امکان هست، دواره این می آن"
    },
    {
      "id": 17,
      "start": 4591.66,
      "end": 4593.96,
      "formatted_start": "01:16:31.660",
      "formatted_end": "01:16:33.960",
      "text": "آنها می خواهد دوباره براشون تجدید بگوید"
    },
    {
      "id": 18,
      "start": 4593.96,
      "end": 4597.26,
      "formatted_start": "01:16:33.960",
      "formatted_end": "01:16:37.260",
      "text": "ببینید برانقایی برانقا"
    },
    {
      "id": 19,
      "start": 4597.26,
      "end": 4600.88,
      "formatted_start": "01:16:37.260",
      "formatted_end": "01:16:40.880",
      "text": "انارزه کیفیت برانقا ببینید"
    },
    {
      "id": 20,
      "start": 4600.88,
      "end": 4603.88,
      "formatted_start": "01:16:40.880",
      "formatted_end": "01:16:43.880",
      "text": "کیفیتشون پرد امکانش محصول دارید"
    },
    {
      "id": 21,
      "start": 4603.88,
      "end": 4607.76,
      "formatted_start": "01:16:43.880",
      "formatted_end": "01:16:47.760",
      "text": "یعنی شیطان بودویتون جهان بیرون آلمان هست"
    },
    {
      "id": 22,
      "start": 4607.76,
      "end": 4615.76,
      "formatted_start": "01:16:47.760",
      "formatted_end": "01:16:55.760",
      "text": "محصولات رو براد با کفیت هست. امکانش هست که بخوایید توی تجدید از محصولات ما رو براد براد براد؟"
    },
    {
      "id": 23,
      "start": 4615.76,
      "end": 4624.76,
      "formatted_start": "01:16:55.760",
      "formatted_end": "01:17:04.760",
      "text": "صد پرصد، صد پرصد. ما البته نیمیتونیم به دارو کنه، تحمیل بکنیم که پویدی ند اینو بده."
    },
    {
      "id": 24,
      "start": 4624.76,
      "end": 4625.76,
      "formatted_start": "01:17:04.760",
      "formatted_end": "01:17:05.760",
      "text": "درسته."
    },
    {
      "id": 25,
      "start": 4625.76,
      "end": 4635.76,
      "formatted_start": "01:17:05.760",
      "formatted_end": "01:17:15.760",
      "text": "این شرکتی که به هر حال تونسته با نام داخلی اقدام بکنه با کفیت بسیار بالا"
    },
    {
      "id": 26,
      "start": 4635.76,
      "end": 4639.76,
      "formatted_start": "01:17:15.760",
      "formatted_end": "01:17:19.760",
      "text": "اومده یه لائن دیابت برای ریزیتوراش رو داشته"
    },
    {
      "id": 27,
      "start": 4639.76,
      "end": 4644.76,
      "formatted_start": "01:17:19.760",
      "formatted_end": "01:17:24.760",
      "text": "مثلا اومده لائن فشار و خون، لائن بیده، لائن نمبال عبیدی کرده"
    },
    {
      "id": 28,
      "start": 4644.76,
      "end": 4646.76,
      "formatted_start": "01:17:24.760",
      "formatted_end": "01:17:26.760",
      "text": "بعد این یاد گره"
    },
    {
      "id": 29,
      "start": 4646.76,
      "end": 4649.76,
      "formatted_start": "01:17:26.760",
      "formatted_end": "01:17:29.760",
      "text": "بعد حضینه می کنه"
    },
    {
      "id": 30,
      "start": 4649.76,
      "end": 4652.76,
      "formatted_start": "01:17:29.760",
      "formatted_end": "01:17:32.760",
      "text": "دوت می کنه پدشکان رو برایشون باز آموزی درست می کنه"
    },
    {
      "id": 31,
      "start": 4652.76,
      "end": 4658.36,
      "formatted_start": "01:17:32.760",
      "formatted_end": "01:17:38.360",
      "text": "امتیاز باز آموزی میگیره و ما تزشگاه دوتا چیز میخوان"
    },
    {
      "id": 32,
      "start": 4658.36,
      "end": 4660.36,
      "formatted_start": "01:17:38.360",
      "formatted_end": "01:17:40.360",
      "text": "یکی پول میخوان یکی باز آموزی"
    },
    {
      "id": 33,
      "start": 4660.36,
      "end": 4669.36,
      "formatted_start": "01:17:40.360",
      "formatted_end": "01:17:49.360",
      "text": "این هر دو رو براشون مثلا شاموناهار میده خواب و اینکه اتفاق فلان گرگانه میگیره"
    },
    {
      "id": 34,
      "start": 4669.36,
      "end": 4677.36,
      "formatted_start": "01:17:49.360",
      "formatted_end": "01:17:57.360",
      "text": "و اساتیت رو از تهران میاره اینجا درس میدن دیابت یا فشار و خون یا فلان"
    },
    {
      "id": 35,
      "start": 4677.36,
      "end": 4682.36,
      "formatted_start": "01:17:57.360",
      "formatted_end": "01:18:02.360",
      "text": "بعد این وقتشون هدر نداره دیگه جومهشون رو مثلا بیزاره روز جومه"
    },
    {
      "id": 36,
      "start": 4682.36,
      "end": 4686.36,
      "formatted_start": "01:18:02.360",
      "formatted_end": "01:18:06.360",
      "text": "شرکت های دیگه بیزارن روز پنشمه، این عقلش سیاده عبیدی"
    },
    {
      "id": 37,
      "start": 4686.36,
      "end": 4689.36,
      "formatted_start": "01:18:06.360",
      "formatted_end": "01:18:09.360",
      "text": "بیزاره روز جومه که همه دکترهای دعات هم بیاد"
    },
    {
      "id": 38,
      "start": 4689.36,
      "end": 4692.36,
      "formatted_start": "01:18:09.360",
      "formatted_end": "01:18:12.360",
      "text": "اما دکترهای گردان فقط پنشمه میتونن موردشیه کنن"
    },
    {
      "id": 39,
      "start": 4692.36,
      "end": 4698.36,
      "formatted_start": "01:18:12.360",
      "formatted_end": "01:18:18.360",
      "text": "ولی دکترهای مثلا کلاله نمیتونن پنشمه برن که عبیدی زرنگه بیزاره جومه"
    },
    {
      "id": 40,
      "start": 4698.36,
      "end": 4707.36,
      "formatted_start": "01:18:18.360",
      "formatted_end": "01:18:27.360",
      "text": "بعد هدایه هایی بهشون میده که همین که آمدی دوست داره کنه چجوری بگیره قبضه کنه"
    },
    {
      "id": 41,
      "start": 4707.36,
      "end": 4716.36,
      "formatted_start": "01:18:27.360",
      "formatted_end": "01:18:36.360",
      "text": "با این همه باز برادره کسیه که داروخانه رو داشته باشه آفرهای داروخانه و درخواستهای داروخانه رو تنمی کنه"
    },
    {
      "id": 42,
      "start": 4716.36,
      "end": 4723.36,
      "formatted_start": "01:18:36.360",
      "formatted_end": "01:18:43.360",
      "text": "یه مدت اینکه ما هرچی می نوشتیم گروه رو داروخانه اصیده ها رو میخواییم گرایب بابرم سکیم"
    },
    {
      "id": 43,
      "start": 4723.36,
      "end": 4741.36,
      "formatted_start": "01:18:43.360",
      "formatted_end": "01:19:01.360",
      "text": "من با اکتوبرم با عمیده نیستم، دارخان سیدان، و هر نشتن باز دوباره دارم عمیده میدن، یه مدت متایی شاید بگه یه ماهیم، قبلا همه ش با چیز کار میکردن، اکتوبر کار میکردن،"
    },
    {
      "id": 44,
      "start": 4741.36,
      "end": 4753.36,
      "formatted_start": "01:19:01.360",
      "formatted_end": "01:19:13.360",
      "text": "با اینکه وزیرش نسبتی هم داشت، نسبتی هم داشت با دکتر سیدان شو، بلی این همه با اکترول کار میکردن"
    },
    {
      "id": 45,
      "start": 4753.36,
      "end": 4762.36,
      "formatted_start": "01:19:13.360",
      "formatted_end": "01:19:22.360",
      "text": "ما مثلا گلورنتا میدوشتیم، ما گلورنتا میدوشیم، ما گلورنتا میدوشیم، هر چی از این گروه مادرشون دیدن دیگر جایی کنه"
    },
    {
      "id": 46,
      "start": 4762.36,
      "end": 4769.36,
      "formatted_start": "01:19:22.360",
      "formatted_end": "01:19:29.360",
      "text": "بلی ما نمیتونیم این حساسیت رو به خرج بدیم، با که حتما این باشه و حتما اون باشه"
    },
    {
      "id": 47,
      "start": 4769.36,
      "end": 4775.36,
      "formatted_start": "01:19:29.360",
      "formatted_end": "01:19:35.360",
      "text": "من دیدم مثلا خانم عویستایی گنبد میگوش که حتما سکه باید پاوهه"
    },
    {
      "id": 48,
      "start": 4775.36,
      "end": 4779.36,
      "formatted_start": "01:19:35.360",
      "formatted_end": "01:19:39.360",
      "text": "باید گلرانو تا میداد دارو خانه حقیقت رو گنبد"
    },
    {
      "id": 49,
      "start": 4779.36,
      "end": 4781.36,
      "formatted_start": "01:19:39.360",
      "formatted_end": "01:19:41.360",
      "text": "آره خانم عویستایی"
    },
    {
      "id": 50,
      "start": 4781.36,
      "end": 4789.36,
      "formatted_start": "01:19:41.360",
      "formatted_end": "01:19:49.360",
      "text": "من این خودش به این حکمت های خیلی چیز داره، ارادت داره"
    },
    {
      "id": 51,
      "start": 4789.36,
      "end": 4792.36,
      "formatted_start": "01:19:49.360",
      "formatted_end": "01:19:52.360",
      "text": "ولی میتونه بگه اینو ندید"
    },
    {
      "id": 52,
      "start": 4792.36,
      "end": 4795.36,
      "formatted_start": "01:19:52.360",
      "formatted_end": "01:19:55.360",
      "text": "میگه چه اراده در این دیدی؟"
    },
    {
      "id": 53,
      "start": 4795.36,
      "end": 4797.36,
      "formatted_start": "01:19:55.360",
      "formatted_end": "01:19:57.360",
      "text": "دسترسی مریضه بود"
    },
    {
      "id": 54,
      "start": 4797.36,
      "end": 4799.36,
      "formatted_start": "01:19:57.360",
      "formatted_end": "01:19:59.360",
      "text": "در این وقت، شما درست دارید."
    }
  ],
  "status": "completed"
}