  "stt_segments": [
    {
      "id": 0,
      "start": 13500.0,
      "end": 13530.0,
      "formatted_start": "03:45:00.000",
      "formatted_end": "03:45:30.000",
      "text": "از اینجا بیشتر بیشتر بیشتر بیشتر بیشتر بیشتر بیشتر بیشتر بیشتر بیشتر بیشتر بیشتر بیشتر بیشتر بیشتر بیشتر بیشتر بیشتر بیشتر بیشتر بیشتر بیشتر بیشتر بیشتر بیشتر بیشتر بیشتر بیشتر بیشتر بیشتر بیشتر بیشتر بیشتر بیشتر بیشتر بیشتر بیشتر بیشتر بیشتر بیشتر بیشتر بیشتر بیشتر بی"
    },
    {
      "id": 1,
      "start": 13530.0,
      "end": 13532.0,
      "formatted_start": "03:45:30.000",
      "formatted_end": "03:45:32.000",
      "text": "اینجا این اصولاتش باید بسته شده"
    },
    {
      "id": 2,
      "start": 13532.0,
      "end": 13534.0,
      "formatted_start": "03:45:32.000",
      "formatted_end": "03:45:34.000",
      "text": "نه نیست، بیایی کن یه های شش باز کن"
    },
    {
      "id": 3,
      "start": 13534.0,
      "end": 13536.0,
      "formatted_start": "03:45:34.000",
      "formatted_end": "03:45:36.000",
      "text": "دو جور پرسه داری بهتره"
    },
    {
      "id": 4,
      "start": 13536.0,
      "end": 13538.0,
      "formatted_start": "03:45:36.000",
      "formatted_end": "03:45:38.000",
      "text": "یکی چشمی، یکی گوشی"
    },
    {
      "id": 5,
      "start": 13538.0,
      "end": 13540.0,
      "formatted_start": "03:45:38.000",
      "formatted_end": "03:45:40.000",
      "text": "بعد باد کردن چی؟"
    },
    {
      "id": 6,
      "start": 13540.0,
      "end": 13542.0,
      "formatted_start": "03:45:40.000",
      "formatted_end": "03:45:42.000",
      "text": "باد کردم"
    },
    {
      "id": 7,
      "start": 13542.0,
      "end": 13544.0,
      "formatted_start": "03:45:42.000",
      "formatted_end": "03:45:44.000",
      "text": "امتحان نکردن؟"
    },
    {
      "id": 8,
      "start": 13544.0,
      "end": 13546.0,
      "formatted_start": "03:45:44.000",
      "formatted_end": "03:45:46.000",
      "text": "ایجابیت گفتم امتحان کردیم"
    },
    {
      "id": 9,
      "start": 13546.0,
      "end": 13548.0,
      "formatted_start": "03:45:46.000",
      "formatted_end": "03:45:48.000",
      "text": "امتحان کن"
    },
    {
      "id": 10,
      "start": 13548.0,
      "end": 13550.0,
      "formatted_start": "03:45:48.000",
      "formatted_end": "03:45:50.000",
      "text": "باد کن، مورد نده"
    },
    {
      "id": 11,
      "start": 13550.0,
      "end": 13552.0,
      "formatted_start": "03:45:50.000",
      "formatted_end": "03:45:52.000",
      "text": "افکار بیاد دو گوشی"
    },
    {
      "id": 12,
      "start": 13552.0,
      "end": 13554.0,
      "formatted_start": "03:45:52.000",
      "formatted_end": "03:45:54.000",
      "text": "مرد"
    },
    {
      "id": 13,
      "start": 13554.0,
      "end": 13556.0,
      "formatted_start": "03:45:54.000",
      "formatted_end": "03:45:56.000",
      "text": "مرد بردن"
    },
    {
      "id": 14,
      "start": 13556.0,
      "end": 13558.0,
      "formatted_start": "03:45:56.000",
      "formatted_end": "03:45:58.000",
      "text": "اصولت باز شد"
    },
    {
      "id": 15,
      "start": 13558.0,
      "end": 13562.0,
      "formatted_start": "03:45:58.000",
      "formatted_end": "03:46:02.000",
      "text": "ببینیم چطوریه، الان درد چیزی داره که باشه؟"
    },
    {
      "id": 16,
      "start": 13562.0,
      "end": 13568.0,
      "formatted_start": "03:46:02.000",
      "formatted_end": "03:46:08.000",
      "text": "خیلی کم، بعضی وقتا، باید چیزی باشه که درد بگیره، تیر بکشه"
    },
    {
      "id": 17,
      "start": 13568.0,
      "end": 13598.0,
      "formatted_start": "03:46:08.000",
      "formatted_end": "03:46:38.000",
      "text": "اینجا باید بردارید که اینجا باید بردارید که اینجا باید بردارید که اینجا باید بردارید که اینجا باید بردارید که اینجا باید بردارید که اینجا باید بردارید که اینجا باید بردارید که اینجا باید بردارید که اینجا باید بردارید که اینجا باید بردارید که اینجا باید بردارید که اینجا باید بردارید که اینجا باید بردارید ک"
    },
    {
      "id": 18,
      "start": 13598.0,
      "end": 13603.0,
      "formatted_start": "03:46:38.000",
      "formatted_end": "03:46:43.000",
      "text": "اوه، 11 روش، 12 روش، ترمه فارغ"
    },
    {
      "id": 19,
      "start": 13603.0,
      "end": 13612.0,
      "formatted_start": "03:46:43.000",
      "formatted_end": "03:46:52.000",
      "text": "10 تا بیریم، 4 سپر، 5 سپر، 4 سپر، 5 سپر، 6 سپر، 7 سپر"
    },
    {
      "id": 20,
      "start": 13612.0,
      "end": 13619.0,
      "formatted_start": "03:46:52.000",
      "formatted_end": "03:46:59.000",
      "text": "اسپریر وینی هم بزن هنوز، یکم مانده دیگه، درسته؟"
    },
    {
      "id": 21,
      "start": 13619.0,
      "end": 13624.0,
      "formatted_start": "03:46:59.000",
      "formatted_end": "03:47:04.000",
      "text": "آه، اینکه یک تونه هم با اون هکسی، 4 سپر، 7 سپر"
    },
    {
      "id": 22,
      "start": 13624.0,
      "end": 13626.0,
      "formatted_start": "03:47:04.000",
      "formatted_end": "03:47:06.000",
      "text": "درود خیلی کم شد"
    },
    {
      "id": 23,
      "start": 13626.0,
      "end": 13629.0,
      "formatted_start": "03:47:06.000",
      "formatted_end": "03:47:09.000",
      "text": "بعد پنج روز دیگه"
    },
    {
      "id": 24,
      "start": 13629.0,
      "end": 13631.0,
      "formatted_start": "03:47:09.000",
      "formatted_end": "03:47:11.000",
      "text": "باید قطع درمان کنید"
    },
    {
      "id": 25,
      "start": 13631.0,
      "end": 13634.0,
      "formatted_start": "03:47:11.000",
      "formatted_end": "03:47:14.000",
      "text": "پنج روز استفاده میکنید"
    },
    {
      "id": 26,
      "start": 13634.0,
      "end": 13637.0,
      "formatted_start": "03:47:14.000",
      "formatted_end": "03:47:17.000",
      "text": "روز ششان دوارو قطع میکنید"
    },
    {
      "id": 27,
      "start": 13637.0,
      "end": 13640.0,
      "formatted_start": "03:47:17.000",
      "formatted_end": "03:47:20.000",
      "text": "پنج روز دیگه استفاده میکنید"
    },
    {
      "id": 28,
      "start": 13640.0,
      "end": 13643.0,
      "formatted_start": "03:47:20.000",
      "formatted_end": "03:47:23.000",
      "text": "روز ششان باید قطع درمان کنید"
    },
    {
      "id": 29,
      "start": 13643.0,
      "end": 13646.0,
      "formatted_start": "03:47:23.000",
      "formatted_end": "03:47:26.000",
      "text": "روز ششانی درمان روز دارو رو رکت کنید"
    },
    {
      "id": 30,
      "start": 13646.0,
      "end": 13647.0,
      "formatted_start": "03:47:26.000",
      "formatted_end": "03:47:27.000",
      "text": "تا چهار روز"
    },
    {
      "id": 31,
      "start": 13647.0,
      "end": 13649.0,
      "formatted_start": "03:47:27.000",
      "formatted_end": "03:47:29.000",
      "text": "اگه تا چهار روز دیدید قطع کم"
    },
    {
      "id": 32,
      "start": 13649.0,
      "end": 13651.0,
      "formatted_start": "03:47:29.000",
      "formatted_end": "03:47:31.000",
      "text": "کم روز اول بیاد"
    },
    {
      "id": 33,
      "start": 13651.0,
      "end": 13653.0,
      "formatted_start": "03:47:31.000",
      "formatted_end": "03:47:33.000",
      "text": "دیگه با دوباره گرفت"
    },
    {
      "id": 34,
      "start": 13653.0,
      "end": 13660.0,
      "formatted_start": "03:47:33.000",
      "formatted_end": "03:47:40.000",
      "text": "اگر دیگر نگرفت باید برداشت کنید."
    },
    {
      "id": 35,
      "start": 13660.0,
      "end": 13665.0,
      "formatted_start": "03:47:40.000",
      "formatted_end": "03:47:45.000",
      "text": "درسته؟ تا چهار روز سه رو بکنید بعد از دوار."
    },
    {
      "id": 36,
      "start": 13665.0,
      "end": 13673.0,
      "formatted_start": "03:47:45.000",
      "formatted_end": "03:47:53.000",
      "text": "چهار روز هم سه رو بکنید. همینجور منتظر میبینید. اگر گرفت باید برداشت کنید."
    },
    {
      "id": 37,
      "start": 13673.0,
      "end": 13675.0,
      "formatted_start": "03:47:53.000",
      "formatted_end": "03:47:55.000",
      "text": "چهار روز گذشت دیگر نمیگیره."
    },
    {
      "id": 38,
      "start": 13675.0,
      "end": 13679.0,
      "formatted_start": "03:47:55.000",
      "formatted_end": "03:47:59.000",
      "text": "اینجا باید برداریم که اینکه اینکه مصرفی برای مواطنسی برای مواطنسی نیست."
    },
    {
      "id": 39,
      "start": 13679.0,
      "end": 13687.0,
      "formatted_start": "03:47:59.000",
      "formatted_end": "03:48:07.000",
      "text": "بعد از اینش چهار روزش که ده روز بشه دیگر رو چهار روزش میگاه میکنه اگه این بود کرد میاد باید برده کرد دیگر برده کرد"
    },
    {
      "id": 40,
      "start": 13687.0,
      "end": 13693.0,
      "formatted_start": "03:48:07.000",
      "formatted_end": "03:48:13.000",
      "text": "باید برده کرد این آیار بدن ورزی دستر بیری که اینکه با والوالوی برده کرد"
    },
    {
      "id": 41,
      "start": 13693.0,
      "end": 13697.0,
      "formatted_start": "03:48:13.000",
      "formatted_end": "03:48:17.000",
      "text": "از این هم هست که برده کرد فس بای بای خداحبست"
    },
    {
      "id": 42,
      "start": 13697.0,
      "end": 13699.0,
      "formatted_start": "03:48:17.000",
      "formatted_end": "03:48:19.000",
      "text": "حالا بیان سطح می کنم همش"
    },
    {
      "id": 43,
      "start": 13699.0,
      "end": 13703.0,
      "formatted_start": "03:48:19.000",
      "formatted_end": "03:48:23.000",
      "text": "او که مصروفی برای روماتیسی بسیاری نیست که شیر"
    },
    {
      "id": 44,
      "start": 13703.0,
      "end": 13704.0,
      "formatted_start": "03:48:23.000",
      "formatted_end": "03:48:24.000",
      "text": "این اسمش چیه؟"
    },
    {
      "id": 45,
      "start": 13704.0,
      "end": 13705.0,
      "formatted_start": "03:48:24.000",
      "formatted_end": "03:48:25.000",
      "text": "متو تورکسید نخوره"
    },
    {
      "id": 46,
      "start": 13705.0,
      "end": 13706.0,
      "formatted_start": "03:48:25.000",
      "formatted_end": "03:48:26.000",
      "text": "نه نه"
    },
    {
      "id": 47,
      "start": 13706.0,
      "end": 13708.0,
      "formatted_start": "03:48:26.000",
      "formatted_end": "03:48:28.000",
      "text": "چون میگه من رفتم روماتیس میرم"
    },
    {
      "id": 48,
      "start": 13708.0,
      "end": 13710.0,
      "formatted_start": "03:48:28.000",
      "formatted_end": "03:48:30.000",
      "text": "دکتر روماتیس محفظ سریه"
    },
    {
      "id": 49,
      "start": 13710.0,
      "end": 13711.0,
      "formatted_start": "03:48:30.000",
      "formatted_end": "03:48:31.000",
      "text": "همه محفظ سریه یکی"
    },
    {
      "id": 50,
      "start": 13711.0,
      "end": 13712.0,
      "formatted_start": "03:48:31.000",
      "formatted_end": "03:48:32.000",
      "text": "همه نه"
    },
    {
      "id": 51,
      "start": 13712.0,
      "end": 13714.0,
      "formatted_start": "03:48:32.000",
      "formatted_end": "03:48:34.000",
      "text": "نه از که درم بشینم فرد میکنم"
    },
    {
      "id": 52,
      "start": 13714.0,
      "end": 13716.0,
      "formatted_start": "03:48:34.000",
      "formatted_end": "03:48:36.000",
      "text": "همه آقای دکتر روماتیس"
    },
    {
      "id": 53,
      "start": 13716.0,
      "end": 13718.0,
      "formatted_start": "03:48:36.000",
      "formatted_end": "03:48:38.000",
      "text": "نه همون دانگابون یه دکتر داره"
    },
    {
      "id": 54,
      "start": 13718.0,
      "end": 13720.0,
      "formatted_start": "03:48:38.000",
      "formatted_end": "03:48:40.000",
      "text": "میگه به من غرص داده"
    },
    {
      "id": 55,
      "start": 13720.0,
      "end": 13721.0,
      "formatted_start": "03:48:40.000",
      "formatted_end": "03:48:41.000",
      "text": "هفته که بخوره"
    },
    {
      "id": 56,
      "start": 13721.0,
      "end": 13723.0,
      "formatted_start": "03:48:41.000",
      "formatted_end": "03:48:43.000",
      "text": "ولی میگه اسمش چیه که من بگم"
    },
    {
      "id": 57,
      "start": 13723.0,
      "end": 13725.0,
      "formatted_start": "03:48:43.000",
      "formatted_end": "03:48:45.000",
      "text": "متو تورکسید پرکیز برم"
    },
    {
      "id": 58,
      "start": 13725.0,
      "end": 13726.0,
      "formatted_start": "03:48:45.000",
      "formatted_end": "03:48:46.000",
      "text": "نه"
    },
    {
      "id": 59,
      "start": 13726.0,
      "end": 13735.0,
      "formatted_start": "03:48:46.000",
      "formatted_end": "03:48:55.000",
      "text": "از اون پرسس میشه. تو اگر بهش کسی بیاد بدی، میره میخره و میگه غرص خوبی کنه. فرق و پریش از فروختان میگه مایون کرده."
    },
    {
      "id": 60,
      "start": 13735.0,
      "end": 13737.0,
      "formatted_start": "03:48:55.000",
      "formatted_end": "03:48:57.000",
      "text": "پس میگم از درگاه، پره میزارون میخورده؟"
    },
    {
      "id": 61,
      "start": 13737.0,
      "end": 13742.0,
      "formatted_start": "03:48:57.000",
      "formatted_end": "03:49:02.000",
      "text": "برنامه دوسته ما هستن، همین. ما همراه دوسته ما هستن. تا زمانی که مفید باشه."
    },
    {
      "id": 62,
      "start": 13742.0,
      "end": 13747.0,
      "formatted_start": "03:49:02.000",
      "formatted_end": "03:49:07.000",
      "text": "یه جاییه دکتر گفت، بعد همینو خوردی که اینجور شده، چه باید؟"
    },
    {
      "id": 63,
      "start": 13747.0,
      "end": 13749.0,
      "formatted_start": "03:49:07.000",
      "formatted_end": "03:49:09.000",
      "text": "چون گفت، من پره میزارون میخورم."
    },
    {
      "id": 64,
      "start": 13749.0,
      "end": 13752.0,
      "formatted_start": "03:49:09.000",
      "formatted_end": "03:49:12.000",
      "text": "حتی دکتور کنیم که برادرش افتاده شده که"
    },
    {
      "id": 65,
      "start": 13752.0,
      "end": 13755.0,
      "formatted_start": "03:49:12.000",
      "formatted_end": "03:49:15.000",
      "text": "پس یه بروشم بگو ما فرمی برویم از این پاسیو"
    },
    {
      "id": 66,
      "start": 13755.0,
      "end": 13785.0,
      "formatted_start": "03:49:15.000",
      "formatted_end": "03:49:45.000",
      "text": "نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، ن"
    },
    {
      "id": 67,
      "start": 13785.0,
      "end": 13787.0,
      "formatted_start": "03:49:45.000",
      "formatted_end": "03:49:47.000",
      "text": "مرسی"
    },
    {
      "id": 68,
      "start": 13787.0,
      "end": 13789.0,
      "formatted_start": "03:49:47.000",
      "formatted_end": "03:49:49.000",
      "text": "چی شده اید از اینکه؟"
    },
    {
      "id": 69,
      "start": 13789.0,
      "end": 13793.0,
      "formatted_start": "03:49:49.000",
      "formatted_end": "03:49:53.000",
      "text": "حقیقتش من دیگه روز نفت"
    },
    {
      "id": 70,
      "start": 13793.0,
      "end": 13795.0,
      "formatted_start": "03:49:53.000",
      "formatted_end": "03:49:55.000",
      "text": "هر این روز متوجه شما"
    },
    {
      "id": 71,
      "start": 13795.0,
      "end": 13799.0,
      "formatted_start": "03:49:55.000",
      "formatted_end": "03:49:59.000",
      "text": "یا محدد اون بینگاری جوش دارده"
    }
  ],
  "status": "completed"
