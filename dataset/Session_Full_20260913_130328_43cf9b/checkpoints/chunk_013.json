  "stt_segments": [
    {
      "id": 0,
      "start": 3900.0,
      "end": 3902.0,
      "formatted_start": "01:05:00.000",
      "formatted_end": "01:05:02.000",
      "text": "از اینجا همینجا هستی؟"
    },
    {
      "id": 1,
      "start": 3902.0,
      "end": 3904.0,
      "formatted_start": "01:05:02.000",
      "formatted_end": "01:05:04.000",
      "text": "آره، همینجا هست."
    },
    {
      "id": 2,
      "start": 3904.0,
      "end": 3906.0,
      "formatted_start": "01:05:04.000",
      "formatted_end": "01:05:06.000",
      "text": "همیشه همینجا هستی؟"
    },
    {
      "id": 3,
      "start": 3906.0,
      "end": 3908.0,
      "formatted_start": "01:05:06.000",
      "formatted_end": "01:05:08.000",
      "text": "آره، همینجا هستی."
    },
    {
      "id": 4,
      "start": 3908.0,
      "end": 3916.0,
      "formatted_start": "01:05:08.000",
      "formatted_end": "01:05:16.000",
      "text": "اما یک هرکه می کنه، یک هرکه اون رو هنگی آنجا برم، جور جور در برم، جور در برم، می پاس بیرون سرشون"
    },
    {
      "id": 5,
      "start": 3916.0,
      "end": 3918.0,
      "formatted_start": "01:05:16.000",
      "formatted_end": "01:05:18.000",
      "text": "اینجا درشون نمی کنه، درگردون می کشه"
    },
    {
      "id": 6,
      "start": 3918.0,
      "end": 3922.0,
      "formatted_start": "01:05:18.000",
      "formatted_end": "01:05:22.000",
      "text": "عصبش، عصب به انصاره چامسته"
    },
    {
      "id": 7,
      "start": 3922.0,
      "end": 3924.0,
      "formatted_start": "01:05:22.000",
      "formatted_end": "01:05:24.000",
      "text": "دکتور اینا نرفته آیا اینجا؟"
    },
    {
      "id": 8,
      "start": 3924.0,
      "end": 3925.0,
      "formatted_start": "01:05:24.000",
      "formatted_end": "01:05:25.000",
      "text": "نه"
    },
    {
      "id": 9,
      "start": 3925.0,
      "end": 3927.0,
      "formatted_start": "01:05:25.000",
      "formatted_end": "01:05:27.000",
      "text": "شامله که زود خوب میشه"
    },
    {
      "id": 10,
      "start": 3927.0,
      "end": 3929.0,
      "formatted_start": "01:05:27.000",
      "formatted_end": "01:05:29.000",
      "text": "لکس چی های دکتور؟"
    },
    {
      "id": 11,
      "start": 3929.0,
      "end": 3935.0,
      "formatted_start": "01:05:29.000",
      "formatted_end": "01:05:35.000",
      "text": "گرفتگی عصب از کمره، عصب این از کمر می آمد، بنات زیاد بالا پا باید سادن"
    },
    {
      "id": 12,
      "start": 3935.0,
      "end": 3939.0,
      "formatted_start": "01:05:35.000",
      "formatted_end": "01:05:39.000",
      "text": "باید باد سردم تشکیلش میکنه"
    },
    {
      "id": 13,
      "start": 3939.0,
      "end": 3941.0,
      "formatted_start": "01:05:39.000",
      "formatted_end": "01:05:41.000",
      "text": "باید بگوشونم"
    },
    {
      "id": 14,
      "start": 3941.0,
      "end": 3945.0,
      "formatted_start": "01:05:41.000",
      "formatted_end": "01:05:45.000",
      "text": "از کمر تا اینجای رگه مسته بجنیم"
    },
    {
      "id": 15,
      "start": 3945.0,
      "end": 3947.0,
      "formatted_start": "01:05:45.000",
      "formatted_end": "01:05:47.000",
      "text": "تو کارچه چون یک کمی سرده هست"
    },
    {
      "id": 16,
      "start": 3947.0,
      "end": 3949.0,
      "formatted_start": "01:05:47.000",
      "formatted_end": "01:05:49.000",
      "text": "آره است دست نمایی بخورم باید بگوشونم"
    },
    {
      "id": 17,
      "start": 3949.0,
      "end": 3951.0,
      "formatted_start": "01:05:49.000",
      "formatted_end": "01:05:51.000",
      "text": "میدت هم نارده یا نه؟"
    },
    {
      "id": 18,
      "start": 3951.0,
      "end": 3953.0,
      "formatted_start": "01:05:51.000",
      "formatted_end": "01:05:53.000",
      "text": "باید برگه برگه"
    },
    {
      "id": 19,
      "start": 3953.0,
      "end": 3955.0,
      "formatted_start": "01:05:53.000",
      "formatted_end": "01:05:55.000",
      "text": "چشم"
    },
    {
      "id": 20,
      "start": 3955.0,
      "end": 3957.0,
      "formatted_start": "01:05:55.000",
      "formatted_end": "01:05:57.000",
      "text": "چشم"
    },
    {
      "id": 21,
      "start": 3957.0,
      "end": 3959.0,
      "formatted_start": "01:05:57.000",
      "formatted_end": "01:05:59.000",
      "text": "چشم"
    },
    {
      "id": 22,
      "start": 3959.0,
      "end": 3961.0,
      "formatted_start": "01:05:59.000",
      "formatted_end": "01:06:01.000",
      "text": "چشم"
    },
    {
      "id": 23,
      "start": 3961.0,
      "end": 3963.0,
      "formatted_start": "01:06:01.000",
      "formatted_end": "01:06:03.000",
      "text": "چشم"
    },
    {
      "id": 24,
      "start": 3963.0,
      "end": 3965.0,
      "formatted_start": "01:06:03.000",
      "formatted_end": "01:06:05.000",
      "text": "این کفتر ها توی شکوان که این کفتر رو باشه"
    },
    {
      "id": 25,
      "start": 3965.0,
      "end": 3967.0,
      "formatted_start": "01:06:05.000",
      "formatted_end": "01:06:07.000",
      "text": "آرش کنه"
    },
    {
      "id": 26,
      "start": 3967.0,
      "end": 3969.0,
      "formatted_start": "01:06:07.000",
      "formatted_end": "01:06:09.000",
      "text": "اثرات آره؟"
    },
    {
      "id": 27,
      "start": 3969.0,
      "end": 3971.0,
      "formatted_start": "01:06:09.000",
      "formatted_end": "01:06:11.000",
      "text": "آره، اثرات آره"
    },
    {
      "id": 28,
      "start": 3971.0,
      "end": 3973.0,
      "formatted_start": "01:06:11.000",
      "formatted_end": "01:06:13.000",
      "text": "آرش کنه، آرش کنه، آرش کنه"
    },
    {
      "id": 29,
      "start": 3973.0,
      "end": 3975.0,
      "formatted_start": "01:06:13.000",
      "formatted_end": "01:06:15.000",
      "text": "کفتر شکوان"
    },
    {
      "id": 30,
      "start": 3975.0,
      "end": 3977.0,
      "formatted_start": "01:06:15.000",
      "formatted_end": "01:06:17.000",
      "text": "کفتر شکوان"
    },
    {
      "id": 31,
      "start": 3977.0,
      "end": 3979.0,
      "formatted_start": "01:06:17.000",
      "formatted_end": "01:06:19.000",
      "text": "کفتر شکوان"
    },
    {
      "id": 32,
      "start": 3979.0,
      "end": 3981.0,
      "formatted_start": "01:06:19.000",
      "formatted_end": "01:06:21.000",
      "text": "کفتر شکوان"
    },
    {
      "id": 33,
      "start": 3981.0,
      "end": 3983.0,
      "formatted_start": "01:06:21.000",
      "formatted_end": "01:06:23.000",
      "text": "کفتر شکوان"
    },
    {
      "id": 34,
      "start": 3983.0,
      "end": 3985.0,
      "formatted_start": "01:06:23.000",
      "formatted_end": "01:06:25.000",
      "text": "کفتر شکوان"
    },
    {
      "id": 35,
      "start": 3985.0,
      "end": 3987.0,
      "formatted_start": "01:06:25.000",
      "formatted_end": "01:06:27.000",
      "text": "دو تا کفتر ماردیم"
    },
    {
      "id": 36,
      "start": 3987.0,
      "end": 3989.0,
      "formatted_start": "01:06:27.000",
      "formatted_end": "01:06:29.000",
      "text": "دو تا رو با هم می بینیم"
    },
    {
      "id": 37,
      "start": 3989.0,
      "end": 3991.0,
      "formatted_start": "01:06:29.000",
      "formatted_end": "01:06:31.000",
      "text": "کفتر مارد شباه"
    },
    {
      "id": 38,
      "start": 3991.0,
      "end": 3993.0,
      "formatted_start": "01:06:31.000",
      "formatted_end": "01:06:33.000",
      "text": "این ها جمعه"
    },
    {
      "id": 39,
      "start": 3993.0,
      "end": 3995.0,
      "formatted_start": "01:06:33.000",
      "formatted_end": "01:06:35.000",
      "text": "دیدی نوبر وارد بکنه"
    },
    {
      "id": 40,
      "start": 3995.0,
      "end": 3997.0,
      "formatted_start": "01:06:35.000",
      "formatted_end": "01:06:37.000",
      "text": "آقا رایان بیا ببینم"
    },
    {
      "id": 41,
      "start": 3997.0,
      "end": 4001.0,
      "formatted_start": "01:06:37.000",
      "formatted_end": "01:06:41.000",
      "text": "بیا سیسم چی شده سم؟"
    },
    {
      "id": 42,
      "start": 4001.0,
      "end": 4003.0,
      "formatted_start": "01:06:41.000",
      "formatted_end": "01:06:43.000",
      "text": "باید باید شده کنم"
    },
    {
      "id": 43,
      "start": 4003.0,
      "end": 4005.0,
      "formatted_start": "01:06:43.000",
      "formatted_end": "01:06:45.000",
      "text": "ببینم که چی شده کنی؟"
    },
    {
      "id": 44,
      "start": 4005.0,
      "end": 4007.0,
      "formatted_start": "01:06:45.000",
      "formatted_end": "01:06:47.000",
      "text": "باید باید شده کنیم"
    },
    {
      "id": 45,
      "start": 4007.0,
      "end": 4009.0,
      "formatted_start": "01:06:47.000",
      "formatted_end": "01:06:49.000",
      "text": "در اینجا"
    },
    {
      "id": 46,
      "start": 4009.0,
      "end": 4011.0,
      "formatted_start": "01:06:49.000",
      "formatted_end": "01:06:51.000",
      "text": "سرکر سرکر"
    },
    {
      "id": 47,
      "start": 4011.0,
      "end": 4015.0,
      "formatted_start": "01:06:51.000",
      "formatted_end": "01:06:55.000",
      "text": "این تاون چند تا زد از اینا؟"
    },
    {
      "id": 48,
      "start": 4015.0,
      "end": 4017.0,
      "formatted_start": "01:06:55.000",
      "formatted_end": "01:06:57.000",
      "text": "تو بدن سیاده"
    },
    {
      "id": 49,
      "start": 4017.0,
      "end": 4019.0,
      "formatted_start": "01:06:57.000",
      "formatted_end": "01:06:59.000",
      "text": "آره اون قسمت باید بیاد بیاد"
    },
    {
      "id": 50,
      "start": 4019.0,
      "end": 4021.0,
      "formatted_start": "01:06:59.000",
      "formatted_end": "01:07:01.000",
      "text": "شما خالش این؟"
    },
    {
      "id": 51,
      "start": 4021.0,
      "end": 4023.0,
      "formatted_start": "01:07:01.000",
      "formatted_end": "01:07:03.000",
      "text": "من آره خالشم"
    },
    {
      "id": 52,
      "start": 4023.0,
      "end": 4025.0,
      "formatted_start": "01:07:03.000",
      "formatted_end": "01:07:05.000",
      "text": "بالا مثل بامانه فرمانتون"
    },
    {
      "id": 53,
      "start": 4025.0,
      "end": 4027.0,
      "formatted_start": "01:07:05.000",
      "formatted_end": "01:07:07.000",
      "text": "بزرگ بگیر"
    },
    {
      "id": 54,
      "start": 4027.0,
      "end": 4029.0,
      "formatted_start": "01:07:07.000",
      "formatted_end": "01:07:09.000",
      "text": "اها خودجاست"
    },
    {
      "id": 55,
      "start": 4029.0,
      "end": 4031.0,
      "formatted_start": "01:07:09.000",
      "formatted_end": "01:07:11.000",
      "text": "بله آیوپرو خیلی بحشت هست"
    },
    {
      "id": 56,
      "start": 4031.0,
      "end": 4033.0,
      "formatted_start": "01:07:11.000",
      "formatted_end": "01:07:13.000",
      "text": "ما باب کرده و همش گهه و درد میده"
    },
    {
      "id": 57,
      "start": 4033.0,
      "end": 4035.0,
      "formatted_start": "01:07:13.000",
      "formatted_end": "01:07:15.000",
      "text": "چند تا داره از اینا همین دوتاه؟"
    },
    {
      "id": 58,
      "start": 4035.0,
      "end": 4037.0,
      "formatted_start": "01:07:15.000",
      "formatted_end": "01:07:17.000",
      "text": "این گذش هشره است"
    },
    {
      "id": 59,
      "start": 4037.0,
      "end": 4039.0,
      "formatted_start": "01:07:17.000",
      "formatted_end": "01:07:19.000",
      "text": "گذش هشره؟"
    },
    {
      "id": 60,
      "start": 4039.0,
      "end": 4041.0,
      "formatted_start": "01:07:19.000",
      "formatted_end": "01:07:21.000",
      "text": "بله بله"
    },
    {
      "id": 61,
      "start": 4041.0,
      "end": 4043.0,
      "formatted_start": "01:07:21.000",
      "formatted_end": "01:07:23.000",
      "text": "اینجا آرزده بود"
    },
    {
      "id": 62,
      "start": 4043.0,
      "end": 4045.0,
      "formatted_start": "01:07:23.000",
      "formatted_end": "01:07:25.000",
      "text": "آخه بله بله"
    },
    {
      "id": 63,
      "start": 4045.0,
      "end": 4047.0,
      "formatted_start": "01:07:25.000",
      "formatted_end": "01:07:27.000",
      "text": "فهماندنش کار سختیه"
    },
    {
      "id": 64,
      "start": 4047.0,
      "end": 4077.0,
      "formatted_start": "01:07:27.000",
      "formatted_end": "01:07:57.000",
      "text": "برای اینکه از اینجا برای اینجا برای اینجا برای اینجا برای اینجا برای اینجا برای اینجا برای اینجا برای اینجا برای اینجا برای اینجا برای اینجا برای اینجا برای اینجا برای اینجا برای اینجا برای اینجا برای اینجا برای اینجا برای اینجا برای اینجا برای اینجا برای اینجا برای اینجا برای اینجا برای اینجا برای اینجا برای اینجا برای اینجا برای اینجا برای اینجا"
    },
    {
      "id": 65,
      "start": 4077.0,
      "end": 4081.0,
      "formatted_start": "01:07:57.000",
      "formatted_end": "01:08:01.000",
      "text": "درسته؟ دست دادیم یکیش پاره شده یکیش هست"
    },
    {
      "id": 66,
      "start": 4081.0,
      "end": 4084.0,
      "formatted_start": "01:08:01.000",
      "formatted_end": "01:08:04.000",
      "text": "نمیشه واقعانش تاوری در گزشش شده"
    },
    {
      "id": 67,
      "start": 4084.0,
      "end": 4086.0,
      "formatted_start": "01:08:04.000",
      "formatted_end": "01:08:06.000",
      "text": "هشه نیست داری هشه دیگه ای"
    },
    {
      "id": 68,
      "start": 4086.0,
      "end": 4089.0,
      "formatted_start": "01:08:06.000",
      "formatted_end": "01:08:09.000",
      "text": "بس آقای دکتر برای حق تون رو تیمیرن"
    },
    {
      "id": 69,
      "start": 4089.0,
      "end": 4093.0,
      "formatted_start": "01:08:09.000",
      "formatted_end": "01:08:13.000",
      "text": "اینکه تاور زده بود این داروهای گیایی معمول رو خیلی برد"
    },
    {
      "id": 70,
      "start": 4093.0,
      "end": 4095.0,
      "formatted_start": "01:08:13.000",
      "formatted_end": "01:08:15.000",
      "text": "برد گلاف چسب برد"
    },
    {
      "id": 71,
      "start": 4095.0,
      "end": 4099.0,
      "formatted_start": "01:08:15.000",
      "formatted_end": "01:08:19.000",
      "text": "برد این چسبی که ورد کنید بس هزار داره تاور زده"
    },
    {
      "id": 72,
      "start": 4099.0,
      "end": 4101.0,
      "formatted_start": "01:08:19.000",
      "formatted_end": "01:08:21.000",
      "text": "آقای بزرگاه"
    },
    {
      "id": 73,
      "start": 4101.0,
      "end": 4105.0,
      "formatted_start": "01:08:21.000",
      "formatted_end": "01:08:25.000",
      "text": "اینجوریه میگه تلکیه به کلی"
    },
    {
      "id": 74,
      "start": 4105.0,
      "end": 4107.0,
      "formatted_start": "01:08:25.000",
      "formatted_end": "01:08:27.000",
      "text": "خیلی خوب"
    },
    {
      "id": 75,
      "start": 4107.0,
      "end": 4109.0,
      "formatted_start": "01:08:27.000",
      "formatted_end": "01:08:29.000",
      "text": "یک اسکرایی داره بیزنه"
    },
    {
      "id": 76,
      "start": 4109.0,
      "end": 4111.0,
      "formatted_start": "01:08:29.000",
      "formatted_end": "01:08:31.000",
      "text": "این ترخواه در پسیدی مانده"
    },
    {
      "id": 77,
      "start": 4111.0,
      "end": 4113.0,
      "formatted_start": "01:08:31.000",
      "formatted_end": "01:08:33.000",
      "text": "و تا باشه"
    },
    {
      "id": 78,
      "start": 4113.0,
      "end": 4115.0,
      "formatted_start": "01:08:33.000",
      "formatted_end": "01:08:35.000",
      "text": "این آزمایش و اینجور چیزی"
    },
    {
      "id": 79,
      "start": 4115.0,
      "end": 4117.0,
      "formatted_start": "01:08:35.000",
      "formatted_end": "01:08:37.000",
      "text": "نه دیگه نشان نمیدونه"
    },
    {
      "id": 80,
      "start": 4117.0,
      "end": 4119.0,
      "formatted_start": "01:08:37.000",
      "formatted_end": "01:08:39.000",
      "text": "مامانش میمونه که این مریضیه"
    },
    {
      "id": 81,
      "start": 4119.0,
      "end": 4121.0,
      "formatted_start": "01:08:39.000",
      "formatted_end": "01:08:41.000",
      "text": "حالا که شما این عکس رو دیدین"
    },
    {
      "id": 82,
      "start": 4121.0,
      "end": 4123.0,
      "formatted_start": "01:08:41.000",
      "formatted_end": "01:08:43.000",
      "text": "نمیشه در تشهرها مطمئن شده که من درست بود"
    },
    {
      "id": 83,
      "start": 4123.0,
      "end": 4125.0,
      "formatted_start": "01:08:43.000",
      "formatted_end": "01:08:45.000",
      "text": "تا نشان ندارم بود"
    },
    {
      "id": 84,
      "start": 4125.0,
      "end": 4127.0,
      "formatted_start": "01:08:45.000",
      "formatted_end": "01:08:47.000",
      "text": "شاید در تا اشتباه میکنم"
    },
    {
      "id": 85,
      "start": 4127.0,
      "end": 4129.0,
      "formatted_start": "01:08:47.000",
      "formatted_end": "01:08:49.000",
      "text": "این عکس بسه همین تا کردم ایبانشتن"
    },
    {
      "id": 86,
      "start": 4129.0,
      "end": 4131.5,
      "formatted_start": "01:08:49.000",
      "formatted_end": "01:08:51.500",
      "text": "خاله ها نشان بیدم در موامره بطور میشه"
    },
    {
      "id": 87,
      "start": 4131.5,
      "end": 4135.0,
      "formatted_start": "01:08:51.500",
      "formatted_end": "01:08:55.000",
      "text": "چون میگه که خب مارم پشت میزنه چرا اینجوری نمیشه"
    },
    {
      "id": 88,
      "start": 4135.0,
      "end": 4138.0,
      "formatted_start": "01:08:55.000",
      "formatted_end": "01:08:58.000",
      "text": "پس گزش نیست مریضیه"
    },
    {
      "id": 89,
      "start": 4138.0,
      "end": 4140.0,
      "formatted_start": "01:08:58.000",
      "formatted_end": "01:09:00.000",
      "text": "خدا نکنه مریضی باشه"
    },
    {
      "id": 90,
      "start": 4140.0,
      "end": 4142.0,
      "formatted_start": "01:09:00.000",
      "formatted_end": "01:09:02.000",
      "text": "بسر بومشی میادی داره"
    },
    {
      "id": 91,
      "start": 4142.0,
      "end": 4145.0,
      "formatted_start": "01:09:02.000",
      "formatted_end": "01:09:05.000",
      "text": "ولی اولاک شیمیای شدن"
    },
    {
      "id": 92,
      "start": 4145.0,
      "end": 4146.0,
      "formatted_start": "01:09:05.000",
      "formatted_end": "01:09:06.000",
      "text": "شیمیای شدن کجا؟"
    },
    {
      "id": 93,
      "start": 4146.0,
      "end": 4148.0,
      "formatted_start": "01:09:06.000",
      "formatted_end": "01:09:08.000",
      "text": "بدنشون بفرخونه میزن"
    },
    {
      "id": 94,
      "start": 4148.0,
      "end": 4150.0,
      "formatted_start": "01:09:08.000",
      "formatted_end": "01:09:10.000",
      "text": "خیلی خطر را برخور بشنده"
    },
    {
      "id": 95,
      "start": 4150.0,
      "end": 4155.0,
      "formatted_start": "01:09:10.000",
      "formatted_end": "01:09:15.000",
      "text": "ولی این هشه را تا دیگه عکسشی میشن داره که خیالتون رایت بشه"
    },
    {
      "id": 96,
      "start": 4155.0,
      "end": 4160.46,
      "formatted_start": "01:09:15.000",
      "formatted_end": "01:09:20.460",
      "text": "خیلی ایمان ایجاد میکنه دکترهای دیگه میگن مریض باور نمیکنه خب من نشان میدم باورم"
    },
    {
      "id": 97,
      "start": 4162.46,
      "end": 4167.24,
      "formatted_start": "01:09:22.460",
      "formatted_end": "01:09:27.240",
      "text": "خب سه تا پومات یه دونه اسپریه سه تا پوماته"
    },
    {
      "id": 98,
      "start": 4167.24,
      "end": 4172.24,
      "formatted_start": "01:09:27.240",
      "formatted_end": "01:09:32.240",
      "text": "بسیار سه تا پوماتشو باطی کنم یه پومات بشه که دیگه اینو چون زیاد خواهند زد"
    },
    {
      "id": 99,
      "start": 4175.24,
      "end": 4177.24,
      "formatted_start": "01:09:35.240",
      "formatted_end": "01:09:37.240",
      "text": "اسپریه این سه تا"
    },
    {
      "id": 100,
      "start": 4179.24,
      "end": 4181.24,
      "formatted_start": "01:09:39.240",
      "formatted_end": "01:09:41.240",
      "text": "یه دونه پومات درست میکنه"
    },
    {
      "id": 101,
      "start": 4181.24,
      "end": 4187.24,
      "formatted_start": "01:09:41.240",
      "formatted_end": "01:09:47.240",
      "text": "هر جایی که تا آخر تا وستان هر جایی که میشه بزنه باد کنه فراموش کنه هزگی میزنه"
    },
    {
      "id": 102,
      "start": 4187.24,
