  "stt_segments": [
    {
      "id": 0,
      "start": 9300.0,
      "end": 9330.0,
      "formatted_start": "02:35:00.000",
      "formatted_end": "02:35:30.000",
      "text": "از اینجا باید بردارید که اینجا باید بردارید که اینجا باید بردارید که اینجا باید بردارید که اینجا باید بردارید که اینجا بردارید که اینجا بردارید که اینجا بردارید که اینجا بردارید که اینجا بردارید که اینجا بردارید که اینجا بردارید که اینجا بردارید که اینجا بردارید که اینجا بردارید که اینجا بردارید که اینجا برداری"
    },
    {
      "id": 1,
      "start": 9330.0,
      "end": 9332.0,
      "formatted_start": "02:35:30.000",
      "formatted_end": "02:35:32.000",
      "text": "چرا؟ خیلی، این همه ش داره گریه امکانی"
    },
    {
      "id": 2,
      "start": 9332.0,
      "end": 9335.0,
      "formatted_start": "02:35:32.000",
      "formatted_end": "02:35:35.000",
      "text": "بخشو بگیر، من خواهیم به گاروز خودی شم"
    },
    {
      "id": 3,
      "start": 9335.0,
      "end": 9338.0,
      "formatted_start": "02:35:35.000",
      "formatted_end": "02:35:38.000",
      "text": "من هیدار همه ش هم که دارم بشیم، دان چی کنم؟"
    },
    {
      "id": 4,
      "start": 9342.0,
      "end": 9345.0,
      "formatted_start": "02:35:42.000",
      "formatted_end": "02:35:45.000",
      "text": "یه قطره براش بده نیستم، قطره یه پدیل هست"
    },
    {
      "id": 5,
      "start": 9347.0,
      "end": 9349.0,
      "formatted_start": "02:35:47.000",
      "formatted_end": "02:35:49.000",
      "text": "روزی ده قطره براش بده"
    },
    {
      "id": 6,
      "start": 9351.0,
      "end": 9353.0,
      "formatted_start": "02:35:51.000",
      "formatted_end": "02:35:53.000",
      "text": "یه دینا شربت هم براش براش برسیم"
    },
    {
      "id": 7,
      "start": 9354.0,
      "end": 9355.0,
      "formatted_start": "02:35:54.000",
      "formatted_end": "02:35:55.000",
      "text": "فاموکیدی؟"
    },
    {
      "id": 8,
      "start": 9356.0,
      "end": 9359.0,
      "formatted_start": "02:35:56.000",
      "formatted_end": "02:35:59.000",
      "text": "ها، دوست دفت ساعت، این ها ده قطره شد"
    },
    {
      "id": 9,
      "start": 9360.0,
      "end": 9362.0,
      "formatted_start": "02:36:00.000",
      "formatted_end": "02:36:02.000",
      "text": "خوب"
    },
    {
      "id": 10,
      "start": 9362.0,
      "end": 9364.0,
      "formatted_start": "02:36:02.000",
      "formatted_end": "02:36:04.000",
      "text": "بعد شیر خشک هم برای"
    },
    {
      "id": 11,
      "start": 9364.0,
      "end": 9366.0,
      "formatted_start": "02:36:04.000",
      "formatted_end": "02:36:06.000",
      "text": "مامان"
    },
    {
      "id": 12,
      "start": 9366.0,
      "end": 9368.0,
      "formatted_start": "02:36:06.000",
      "formatted_end": "02:36:08.000",
      "text": "برای بیگز"
    },
    {
      "id": 13,
      "start": 9368.0,
      "end": 9370.0,
      "formatted_start": "02:36:08.000",
      "formatted_end": "02:36:10.000",
      "text": "یکمان"
    },
    {
      "id": 14,
      "start": 9372.0,
      "end": 9374.0,
      "formatted_start": "02:36:12.000",
      "formatted_end": "02:36:14.000",
      "text": "اگه تونست سپرامیل پیدا کنی"
    },
    {
      "id": 15,
      "start": 9374.0,
      "end": 9376.0,
      "formatted_start": "02:36:14.000",
      "formatted_end": "02:36:16.000",
      "text": "که سپرامیل"
    },
    {
      "id": 16,
      "start": 9376.0,
      "end": 9378.0,
      "formatted_start": "02:36:16.000",
      "formatted_end": "02:36:18.000",
      "text": "سپرامیل یک"
    },
    {
      "id": 17,
      "start": 9378.0,
      "end": 9380.0,
      "formatted_start": "02:36:18.000",
      "formatted_end": "02:36:20.000",
      "text": "خوب"
    },
    {
      "id": 18,
      "start": 9380.0,
      "end": 9382.0,
      "formatted_start": "02:36:20.000",
      "formatted_end": "02:36:22.000",
      "text": "سپرامیل رو داروخونه"
    },
    {
      "id": 19,
      "start": 9382.0,
      "end": 9384.0,
      "formatted_start": "02:36:22.000",
      "formatted_end": "02:36:24.000",
      "text": "توی خیابون حافظ"
    },
    {
      "id": 20,
      "start": 9384.0,
      "end": 9386.0,
      "formatted_start": "02:36:24.000",
      "formatted_end": "02:36:26.000",
      "text": "یه داروخونه هست"
    },
    {
      "id": 21,
      "start": 9386.0,
      "end": 9388.0,
      "formatted_start": "02:36:26.000",
      "formatted_end": "02:36:28.000",
      "text": "داروخونه رضای شیرازی"
    },
    {
      "id": 22,
      "start": 9388.0,
      "end": 9391.42,
      "formatted_start": "02:36:28.000",
      "formatted_end": "02:36:31.420",
      "text": "آره آبونی آره دقیقا چون آبونی آره"
    },
    {
      "id": 23,
      "start": 9391.42,
      "end": 9393.42,
      "formatted_start": "02:36:31.420",
      "formatted_end": "02:36:33.420",
      "text": "آبونی تو که شیردی نه؟"
    },
    {
      "id": 24,
      "start": 9393.42,
      "end": 9394.42,
      "formatted_start": "02:36:33.420",
      "formatted_end": "02:36:34.420",
      "text": "این افرادی"
    },
    {
      "id": 25,
      "start": 9394.42,
      "end": 9395.42,
      "formatted_start": "02:36:34.420",
      "formatted_end": "02:36:35.420",
      "text": "افرادی آفرادی"
    },
    {
      "id": 26,
      "start": 9395.42,
      "end": 9396.42,
      "formatted_start": "02:36:35.420",
      "formatted_end": "02:36:36.420",
      "text": "بله افرادی"
    },
    {
      "id": 27,
      "start": 9396.42,
      "end": 9399.42,
      "formatted_start": "02:36:36.420",
      "formatted_end": "02:36:39.420",
      "text": "کلن تا آبونشو برو از اینجا"
    },
    {
      "id": 28,
      "start": 9399.42,
      "end": 9402.42,
      "formatted_start": "02:36:39.420",
      "formatted_end": "02:36:42.420",
      "text": "خلا مثلا میام به شیردم همون افراد"
    },
    {
      "id": 29,
      "start": 9402.42,
      "end": 9404.42,
      "formatted_start": "02:36:42.420",
      "formatted_end": "02:36:44.420",
      "text": "پیت دهنشو مونه درمی آمید"
    },
    {
      "id": 30,
      "start": 9404.42,
      "end": 9406.42,
      "formatted_start": "02:36:44.420",
      "formatted_end": "02:36:46.420",
      "text": "پیت دهنشو مونه درمی نمیبونم چرا اینجا"
    },
    {
      "id": 31,
      "start": 9406.42,
      "end": 9408.42,
      "formatted_start": "02:36:46.420",
      "formatted_end": "02:36:48.420",
      "text": "بنام جاستم را به بزرگ"
    },
    {
      "id": 32,
      "start": 9408.42,
      "end": 9411.42,
      "formatted_start": "02:36:48.420",
      "formatted_end": "02:36:51.420",
      "text": "باشه میدرس دق نداری یا"
    },
    {
      "id": 33,
      "start": 9411.42,
      "end": 9414.42,
      "formatted_start": "02:36:51.420",
      "formatted_end": "02:36:54.420",
      "text": "خلا با روزی اینجا با روزی"
    },
    {
      "id": 34,
      "start": 9414.42,
      "end": 9420.42,
      "formatted_start": "02:36:54.420",
      "formatted_end": "02:37:00.420",
      "text": "این سرمندشان رو ببینید"
    },
    {
      "id": 35,
      "start": 9420.42,
      "end": 9423.42,
      "formatted_start": "02:37:00.420",
      "formatted_end": "02:37:03.420",
      "text": "یه دونه ستاره به همکنم"
    },
    {
      "id": 36,
      "start": 9423.42,
      "end": 9431.42,
      "formatted_start": "02:37:03.420",
      "formatted_end": "02:37:11.420",
      "text": "با یه دونه کتاب دستان"
    },
    {
      "id": 37,
      "start": 9431.42,
      "end": 9434.42,
      "formatted_start": "02:37:11.420",
      "formatted_end": "02:37:14.420",
      "text": "خب اینم جایی بود"
    },
    {
      "id": 38,
      "start": 9434.42,
      "end": 9436.42,
      "formatted_start": "02:37:14.420",
      "formatted_end": "02:37:16.420",
      "text": "درست دارم"
    },
    {
      "id": 39,
      "start": 9436.42,
      "end": 9466.42,
      "formatted_start": "02:37:16.420",
      "formatted_end": "02:37:46.420",
      "text": "از این وقت باید بردارید که از این وقت باید بردارید که از این وقت بردارید که از این وقت بردارید که از این وقت بردارید که از این وقت بردارید که از این وقت بردارید که از این وقت بردارید که از این وقت بردارید که از این وقت بردارید که از این وقت بردارید که از این وقت بردارید که از این وقت بردارید که از این وقت بردارید که از این وقت بردارید که از این و"
    },
    {
      "id": 40,
      "start": 9466.42,
      "end": 9468.42,
      "formatted_start": "02:37:46.420",
      "formatted_end": "02:37:48.420",
      "text": "بیایید بیدار"
    },
    {
      "id": 41,
      "start": 9479.22,
      "end": 9479.82,
      "formatted_start": "02:37:59.220",
      "formatted_end": "02:37:59.820",
      "text": "کلک"
    },
    {
      "id": 42,
      "start": 9479.82,
      "end": 9481.82,
      "formatted_start": "02:37:59.820",
      "formatted_end": "02:38:01.820",
      "text": "اسپری آبیشو که داری"
    },
    {
      "id": 43,
      "start": 9481.82,
      "end": 9482.82,
      "formatted_start": "02:38:01.820",
      "formatted_end": "02:38:02.820",
      "text": "اونو روزی چهار بار بزن"
    },
    {
      "id": 44,
      "start": 9482.82,
      "end": 9484.82,
      "formatted_start": "02:38:02.820",
      "formatted_end": "02:38:04.820",
      "text": "اینو روزی دو بار بزن"
    },
    {
      "id": 45,
      "start": 9484.82,
      "end": 9487.82,
      "formatted_start": "02:38:04.820",
      "formatted_end": "02:38:07.820",
      "text": "آزیز رو مالکین روز اول به چهار سی سی بزن"
    },
    {
      "id": 46,
      "start": 9487.82,
      "end": 9489.82,
      "formatted_start": "02:38:07.820",
      "formatted_end": "02:38:09.820",
      "text": "روزهای بعد دو سی سی اینو باید نشونید"
    },
    {
      "id": 47,
      "start": 9489.82,
      "end": 9491.82,
      "formatted_start": "02:38:09.820",
      "formatted_end": "02:38:11.820",
      "text": "چندتایی هستی بزن؟"
    },
    {
      "id": 48,
      "start": 9491.82,
      "end": 9493.82,
      "formatted_start": "02:38:11.820",
      "formatted_end": "02:38:13.820",
      "text": "پنج روز"
    },
    {
      "id": 49,
      "start": 9493.82,
      "end": 9495.82,
      "formatted_start": "02:38:13.820",
      "formatted_end": "02:38:15.820",
      "text": "اینو روزی یه دونه بزن"
    },
    {
      "id": 50,
      "start": 9495.82,
      "end": 9496.82,
      "formatted_start": "02:38:15.820",
      "formatted_end": "02:38:16.820",
      "text": "آه، خود رو همه"
    },
    {
      "id": 51,
      "start": 9496.82,
      "end": 9498.32,
      "formatted_start": "02:38:16.820",
      "formatted_end": "02:38:18.320",
      "text": "آه، خود رو همه، می‌دونی که اش بشین"
    },
    {
      "id": 52,
      "start": 9498.32,
      "end": 9500.32,
      "formatted_start": "02:38:18.320",
      "formatted_end": "02:38:20.320",
      "text": "در روی سانی شب یه روز بدن؟"
    },
    {
      "id": 53,
      "start": 9500.32,
      "end": 9501.32,
      "formatted_start": "02:38:20.320",
      "formatted_end": "02:38:21.320",
      "text": "جا؟"
    },
    {
      "id": 54,
      "start": 9501.32,
      "end": 9503.32,
      "formatted_start": "02:38:21.320",
      "formatted_end": "02:38:23.320",
      "text": "در روی سانی شب یه روز بهش بدن؟"
    },
    {
      "id": 55,
      "start": 9503.32,
      "end": 9504.32,
      "formatted_start": "02:38:23.320",
      "formatted_end": "02:38:24.320",
      "text": "نه"
    },
    {
      "id": 56,
      "start": 9504.32,
      "end": 9507.32,
      "formatted_start": "02:38:24.320",
      "formatted_end": "02:38:27.320",
      "text": "آه، این هم کل هم براش اینو می‌خواستن بگیرن"
    },
    {
      "id": 57,
      "start": 9507.32,
      "end": 9509.32,
      "formatted_start": "02:38:27.320",
      "formatted_end": "02:38:29.320",
      "text": "این هم براش چند کلو بود؟"
    },
    {
      "id": 58,
      "start": 9509.32,
      "end": 9511.32,
      "formatted_start": "02:38:29.320",
      "formatted_end": "02:38:31.320",
      "text": "آه، این هم ها سی ست خود بود"
    },
    {
      "id": 59,
      "start": 9511.32,
      "end": 9513.32,
      "formatted_start": "02:38:31.320",
      "formatted_end": "02:38:33.320",
      "text": "نه، ها سی ست نفت می‌شوند"
    },
    {
      "id": 60,
      "start": 9513.32,
      "end": 9514.32,
      "formatted_start": "02:38:33.320",
      "formatted_end": "02:38:34.320",
      "text": "باش"
    },
    {
      "id": 61,
      "start": 9514.32,
      "end": 9515.32,
      "formatted_start": "02:38:34.320",
      "formatted_end": "02:38:35.320",
      "text": "نه، خیلی معمول"
    },
    {
      "id": 62,
      "start": 9515.32,
      "end": 9517.32,
      "formatted_start": "02:38:35.320",
      "formatted_end": "02:38:37.320",
      "text": "خوش آمدی از این کار هست"
    },
    {
      "id": 63,
      "start": 9517.32,
      "end": 9521.32,
      "formatted_start": "02:38:37.320",
      "formatted_end": "02:38:41.320",
      "text": "بازم اگه تب استیاز شد اون شیاخو بذارم اشکال ندارم"
    },
    {
      "id": 64,
      "start": 9521.32,
      "end": 9523.32,
      "formatted_start": "02:38:41.320",
      "formatted_end": "02:38:43.320",
      "text": "نه بسیار خیلی چشم ندارم"
    },
    {
      "id": 65,
      "start": 9523.32,
      "end": 9525.32,
      "formatted_start": "02:38:43.320",
      "formatted_end": "02:38:45.320",
      "text": "باشه گفتن زرگ ندارم"
    },
    {
      "id": 66,
      "start": 9525.32,
      "end": 9527.32,
      "formatted_start": "02:38:45.320",
      "formatted_end": "02:38:47.320",
      "text": "نه اون شیاخ زرگ ندارم"
    },
    {
      "id": 67,
      "start": 9527.32,
      "end": 9529.32,
      "formatted_start": "02:38:47.320",
      "formatted_end": "02:38:49.320",
      "text": "بارگونه شما خودم"
    },
    {
      "id": 68,
      "start": 9533.32,
      "end": 9535.32,
      "formatted_start": "02:38:53.320",
      "formatted_end": "02:38:55.320",
      "text": "مردم مردم مردم"
    },
    {
      "id": 69,
      "start": 9535.32,
      "end": 9537.32,
      "formatted_start": "02:38:55.320",
      "formatted_end": "02:38:57.320",
      "text": "مردم شما خوبی؟"
    },
    {
      "id": 70,
      "start": 9537.32,
      "end": 9539.32,
      "formatted_start": "02:38:57.320",
      "formatted_end": "02:38:59.320",
      "text": "تبایی هلما باید تنگرم کنی؟"
    },
    {
      "id": 71,
      "start": 9539.32,
      "end": 9541.32,
      "formatted_start": "02:38:59.320",
      "formatted_end": "02:39:01.320",
      "text": "باید باید اینو نیکرد"
    },
    {
      "id": 72,
      "start": 9541.32,
      "end": 9543.32,
      "formatted_start": "02:39:01.320",
      "formatted_end": "02:39:03.320",
      "text": "خب هلما خوبی؟"
    },
    {
      "id": 73,
      "start": 9543.32,
      "end": 9545.32,
      "formatted_start": "02:39:03.320",
      "formatted_end": "02:39:05.320",
      "text": "چه خب ببا؟"
    },
    {
      "id": 74,
      "start": 9545.32,
      "end": 9547.32,
      "formatted_start": "02:39:05.320",
      "formatted_end": "02:39:07.320",
      "text": "چرا بچه اخی؟"
    },
    {
      "id": 75,
      "start": 9547.32,
      "end": 9550.32,
      "formatted_start": "02:39:07.320",
      "formatted_end": "02:39:10.320",
      "text": "دو شهر پیش یه تحلیل شاید"
    },
    {
      "id": 76,
      "start": 9550.32,
      "end": 9553.32,
      "formatted_start": "02:39:10.320",
      "formatted_end": "02:39:13.320",
      "text": "یه لفظی تب کردن جفتشون با هم"
    },
    {
      "id": 77,
      "start": 9553.32,
      "end": 9556.32,
      "formatted_start": "02:39:13.320",
      "formatted_end": "02:39:16.320",
      "text": "بعد هلمو تا دیروز بعد از او اینا"
    },
    {
      "id": 78,
      "start": 9556.32,
      "end": 9558.32,
      "formatted_start": "02:39:16.320",
      "formatted_end": "02:39:18.320",
      "text": "بدندرد و اینا داشت"
    },
    {
      "id": 79,
      "start": 9558.32,
      "end": 9561.32,
      "formatted_start": "02:39:18.320",
      "formatted_end": "02:39:21.320",
      "text": "بعد گروب دیگه گلاب به رو تون والا آورد"
    },
    {
      "id": 80,
      "start": 9561.32,
      "end": 9562.32,
      "formatted_start": "02:39:21.320",
      "formatted_end": "02:39:22.320",
      "text": "آها"
    },
    {
      "id": 81,
      "start": 9562.32,
      "end": 9564.32,
      "formatted_start": "02:39:22.320",
      "formatted_end": "02:39:24.320",
      "text": "بعد دیگه بردیمش در مونگاه"
    },
    {
      "id": 82,
      "start": 9564.32,
      "end": 9566.32,
      "formatted_start": "02:39:24.320",
      "formatted_end": "02:39:26.320",
      "text": "بهش سرون داد و اینا"
    },
    {
      "id": 83,
      "start": 9566.32,
      "end": 9568.32,
      "formatted_start": "02:39:26.320",
      "formatted_end": "02:39:28.320",
      "text": "گرسه ضد تحب و اینا داد"
    },
    {
      "id": 84,
      "start": 9568.32,
      "end": 9571.32,
      "formatted_start": "02:39:28.320",
      "formatted_end": "02:39:31.320",
      "text": "بعد برسان ولی فقط تب داشت"
    },
    {
      "id": 85,
      "start": 9571.32,
      "end": 9574.32,
      "formatted_start": "02:39:31.320",
      "formatted_end": "02:39:34.320",
      "text": "بعد اینکه امروز مدفوعشون میدیدم"
    },
    {
      "id": 86,
      "start": 9574.32,
      "end": 9578.62,
      "formatted_start": "02:39:34.320",
      "formatted_end": "02:39:38.620",
      "text": "اما امسالم ببخشت اکس هم گرفتم که ببخش نشون بدم رنگشو"
    },
    {
      "id": 87,
      "start": 9578.62,
      "end": 9582.02,
      "formatted_start": "02:39:38.620",
      "formatted_end": "02:39:42.020",
      "text": "یه ذره حس کردم طبیعی نیست رنگش"
    },
    {
      "id": 88,
      "start": 9582.02,
      "end": 9586.02,
      "formatted_start": "02:39:42.020",
      "formatted_end": "02:39:46.020",
      "text": "بعد گفتم بیارم بهتون نشون بدم ببخشید"
    },
    {
      "id": 89,
      "start": 9586.02,
