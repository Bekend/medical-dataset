  "stt_segments": [
    {
      "id": 0,
      "start": 10200.0,
      "end": 10202.0,
      "formatted_start": "02:50:00.000",
      "formatted_end": "02:50:02.000",
      "text": "احسان"
    },
    {
      "id": 1,
      "start": 10202.0,
      "end": 10204.0,
      "formatted_start": "02:50:02.000",
      "formatted_end": "02:50:04.000",
      "text": "بله"
    },
    {
      "id": 2,
      "start": 10208.8,
      "end": 10209.8,
      "formatted_start": "02:50:08.800",
      "formatted_end": "02:50:09.800",
      "text": "آقا..."
    },
    {
      "id": 3,
      "start": 10209.8,
      "end": 10212.8,
      "formatted_start": "02:50:09.800",
      "formatted_end": "02:50:12.800",
      "text": "برای این امواله ایست برای نسان ورای ازش"
    },
    {
      "id": 4,
      "start": 10212.8,
      "end": 10213.8,
      "formatted_start": "02:50:12.800",
      "formatted_end": "02:50:13.800",
      "text": "بله بله"
    },
    {
      "id": 5,
      "start": 10213.8,
      "end": 10221.8,
      "formatted_start": "02:50:13.800",
      "formatted_end": "02:50:21.800",
      "text": "خانم دکتر همسرم خانواده فیلند دارم برای پیشگیری از این چی کار کنم؟ این امتماع داره از بچه ای همه دینا؟"
    },
    {
      "id": 6,
      "start": 10221.8,
      "end": 10224.8,
      "formatted_start": "02:50:21.800",
      "formatted_end": "02:50:24.800",
      "text": "کن خانواده دارن از مادرشون درفته هستن"
    },
    {
      "id": 7,
      "start": 10224.8,
      "end": 10225.8,
      "formatted_start": "02:50:24.800",
      "formatted_end": "02:50:25.800",
      "text": "برای این برای از بچه ای همه دینا؟ این کاری از بچه ای همه دینا؟"
    },
    {
      "id": 8,
      "start": 10225.8,
      "end": 10228.8,
      "formatted_start": "02:50:25.800",
      "formatted_end": "02:50:28.800",
      "text": "این کار رو بخوایی ازش پیش گیری کنی نداری؟"
    },
    {
      "id": 9,
      "start": 10228.8,
      "end": 10230.8,
      "formatted_start": "02:50:28.800",
      "formatted_end": "02:50:30.800",
      "text": "این کار از مادر میدید؟"
    },
    {
      "id": 10,
      "start": 10230.8,
      "end": 10232.8,
      "formatted_start": "02:50:30.800",
      "formatted_end": "02:50:32.800",
      "text": "باید باید تواصل کنید، فرد نمی کنید"
    },
    {
      "id": 11,
      "start": 10232.8,
      "end": 10233.8,
      "formatted_start": "02:50:32.800",
      "formatted_end": "02:50:33.800",
      "text": "فرد نمی کنید؟"
    },
    {
      "id": 12,
      "start": 10233.8,
      "end": 10239.8,
      "formatted_start": "02:50:33.800",
      "formatted_end": "02:50:39.800",
      "text": "باید قهوه چیز بکنید، یه مدن هم از سی سالگی به بعد مدن"
    },
    {
      "id": 13,
      "start": 10239.8,
      "end": 10241.8,
      "formatted_start": "02:50:39.800",
      "formatted_end": "02:50:41.800",
      "text": "همسر من دارم چه سالگی؟ یه سالگی داری؟"
    },
    {
      "id": 14,
      "start": 10241.8,
      "end": 10246.8,
      "formatted_start": "02:50:41.800",
      "formatted_end": "02:50:46.800",
      "text": "فرد نمی کنید، دیابل بچه ها با دیابل مدن هم فرد نمی کنید"
    },
    {
      "id": 15,
      "start": 10246.8,
      "end": 10251.1,
      "formatted_start": "02:50:46.800",
      "formatted_end": "02:50:51.100",
      "text": "کن خونه ماده دارم من دیگرم شم گرم نکن بچه های من نیست"
    },
    {
      "id": 16,
      "start": 10251.1,
      "end": 10254.38,
      "formatted_start": "02:50:51.100",
      "formatted_end": "02:50:54.380",
      "text": "احتمال داره ولی قطعی نیست"
    },
    {
      "id": 17,
      "start": 10274.38,
      "end": 10275.3,
      "formatted_start": "02:51:14.380",
      "formatted_end": "02:51:15.300",
      "text": "مردم"
    },
    {
      "id": 18,
      "start": 10275.3,
      "end": 10275.86,
      "formatted_start": "02:51:15.300",
      "formatted_end": "02:51:15.860",
      "text": "مردم"
    },
    {
      "id": 19,
      "start": 10275.86,
      "end": 10282.86,
      "formatted_start": "02:51:15.860",
      "formatted_end": "02:51:22.860",
      "text": "خوشگل دختر خوشگل بیایید شوش"
    },
    {
      "id": 20,
      "start": 10282.86,
      "end": 10289.86,
      "formatted_start": "02:51:22.860",
      "formatted_end": "02:51:29.860",
      "text": "بیایید شوش بشون روی خندریه"
    },
    {
      "id": 21,
      "start": 10289.86,
      "end": 10293.86,
      "formatted_start": "02:51:29.860",
      "formatted_end": "02:51:33.860",
      "text": "اینم برای آقا احسان"
    },
    {
      "id": 22,
      "start": 10293.86,
      "end": 10298.86,
      "formatted_start": "02:51:33.860",
      "formatted_end": "02:51:38.860",
      "text": "1697 احسان"
    },
    {
      "id": 23,
      "start": 10298.86,
      "end": 10301.86,
      "formatted_start": "02:51:38.860",
      "formatted_end": "02:51:41.860",
      "text": "اینم آیهانه"
    },
    {
      "id": 24,
      "start": 10301.86,
      "end": 10303.86,
      "formatted_start": "02:51:41.860",
      "formatted_end": "02:51:43.860",
      "text": "۷۷۷۷"
    },
    {
      "id": 25,
      "start": 10305.86,
      "end": 10307.86,
      "formatted_start": "02:51:45.860",
      "formatted_end": "02:51:47.860",
      "text": "قربونه شما خوبیه شما؟"
    },
    {
      "id": 26,
      "start": 10307.86,
      "end": 10309.86,
      "formatted_start": "02:51:47.860",
      "formatted_end": "02:51:49.860",
      "text": "سلامت بسیاریم"
    },
    {
      "id": 27,
      "start": 10309.86,
      "end": 10311.86,
      "formatted_start": "02:51:49.860",
      "formatted_end": "02:51:51.860",
      "text": "سفرانیتا خوبی؟ افراد چی بود؟"
    },
    {
      "id": 28,
      "start": 10311.86,
      "end": 10313.86,
      "formatted_start": "02:51:51.860",
      "formatted_end": "02:51:53.860",
      "text": "آبینا خانی"
    },
    {
      "id": 29,
      "start": 10313.86,
      "end": 10315.86,
      "formatted_start": "02:51:53.860",
      "formatted_end": "02:51:55.860",
      "text": "چشم اصلا غلی؟"
    },
    {
      "id": 30,
      "start": 10315.86,
      "end": 10317.86,
      "formatted_start": "02:51:55.860",
      "formatted_end": "02:51:57.860",
      "text": "این آبینا همان دو سه روزه"
    },
    {
      "id": 31,
      "start": 10317.86,
      "end": 10319.86,
      "formatted_start": "02:51:57.860",
      "formatted_end": "02:51:59.860",
      "text": "مثلا"
    },
    {
      "id": 32,
      "start": 10319.86,
      "end": 10321.86,
      "formatted_start": "02:51:59.860",
      "formatted_end": "02:52:01.860",
      "text": "در طول روز میگه که"
    },
    {
      "id": 33,
      "start": 10321.86,
      "end": 10323.86,
      "formatted_start": "02:52:01.860",
      "formatted_end": "02:52:03.860",
      "text": "سر هم گیش بیره"
    },
    {
      "id": 34,
      "start": 10323.86,
      "end": 10325.86,
      "formatted_start": "02:52:03.860",
      "formatted_end": "02:52:05.860",
      "text": "آره"
    },
    {
      "id": 35,
      "start": 10325.86,
      "end": 10327.86,
      "formatted_start": "02:52:05.860",
      "formatted_end": "02:52:07.860",
      "text": "و حالا مثلا تایش"
    },
    {
      "id": 36,
      "start": 10327.86,
      "end": 10329.86,
      "formatted_start": "02:52:07.860",
      "formatted_end": "02:52:09.860",
      "text": "کتا دو سه سال میگه"
    },
    {
      "id": 37,
      "start": 10329.86,
      "end": 10335.86,
      "formatted_start": "02:52:09.860",
      "formatted_end": "02:52:15.860",
      "text": "خب ببین سرگیجه اینجوریه که فکر میکنی همه چی داره میچرخه"
    },
    {
      "id": 38,
      "start": 10335.86,
      "end": 10341.86,
      "formatted_start": "02:52:15.860",
      "formatted_end": "02:52:21.860",
      "text": "یا اینکه نه یه ذره انگاه سیاه میشه وفلا تعادلت بند"
    },
    {
      "id": 39,
      "start": 10341.86,
      "end": 10343.86,
      "formatted_start": "02:52:21.860",
      "formatted_end": "02:52:23.860",
      "text": "اون تعادل همه برمی کنه"
    },
    {
      "id": 40,
      "start": 10343.86,
      "end": 10345.86,
      "formatted_start": "02:52:23.860",
      "formatted_end": "02:52:25.860",
      "text": "آه اونجوری چرخشی نیست ببین"
    },
    {
      "id": 41,
      "start": 10345.86,
      "end": 10347.86,
      "formatted_start": "02:52:25.860",
      "formatted_end": "02:52:27.860",
      "text": "نه"
    },
    {
      "id": 42,
      "start": 10347.86,
      "end": 10349.86,
      "formatted_start": "02:52:27.860",
      "formatted_end": "02:52:29.860",
      "text": "بعد اینجوریه شب وسط خواب"
    },
    {
      "id": 43,
      "start": 10349.86,
      "end": 10351.86,
      "formatted_start": "02:52:29.860",
      "formatted_end": "02:52:31.860",
      "text": "میخواستیم بخوابیم نصف شب"
    },
    {
      "id": 44,
      "start": 10351.86,
      "end": 10353.86,
      "formatted_start": "02:52:31.860",
      "formatted_end": "02:52:33.860",
      "text": "یه رفته بگو نه انوز نخوابی بیرون"
    },
    {
      "id": 45,
      "start": 10353.86,
      "end": 10355.86,
      "formatted_start": "02:52:33.860",
      "formatted_end": "02:52:35.860",
      "text": "گفت گو ماما اون خونه داره میچرخه"
    },
    {
      "id": 46,
      "start": 10355.86,
      "end": 10357.86,
      "formatted_start": "02:52:35.860",
      "formatted_end": "02:52:37.860",
      "text": "از اونه اینکه انگاه مایه بود"
    },
    {
      "id": 47,
      "start": 10357.86,
      "end": 10360.86,
      "formatted_start": "02:52:37.860",
      "formatted_end": "02:52:40.860",
      "text": "این تجربه ای بود چون من خودم این تجربه رو داشتم"
    },
    {
      "id": 48,
      "start": 10360.86,
      "end": 10362.86,
      "formatted_start": "02:52:40.860",
      "formatted_end": "02:52:42.860",
      "text": "خیلی ترسید"
    },
    {
      "id": 49,
      "start": 10362.86,
      "end": 10366.86,
      "formatted_start": "02:52:42.860",
      "formatted_end": "02:52:46.860",
      "text": "دیگه بعد از اون اتفاق من اینا تا یکی دو هفته که الان تازه شروع میده"
    },
    {
      "id": 50,
      "start": 10368.86,
      "end": 10372.86,
      "formatted_start": "02:52:48.860",
      "formatted_end": "02:52:52.860",
      "text": "بعد تلویزیونم خیلی از فاصله نزدیک نگاه میکنه خانده بود"
    },
    {
      "id": 51,
      "start": 10373.86,
      "end": 10375.86,
      "formatted_start": "02:52:53.860",
      "formatted_end": "02:52:55.860",
      "text": "زیاده تنشون میکنه"
    },
    {
      "id": 52,
      "start": 10375.86,
      "end": 10378.86,
      "formatted_start": "02:52:55.860",
      "formatted_end": "02:52:58.860",
      "text": "بله اصلا چهار پنج ست میشه نگاه میکنه"
    },
    {
      "id": 53,
      "start": 10378.86,
      "end": 10382.86,
      "formatted_start": "02:52:58.860",
      "formatted_end": "02:53:02.860",
      "text": "بعد تلویزیون 65 اینم اینجا هستن هم برای آخر میشه"
    },
    {
      "id": 54,
      "start": 10382.86,
      "end": 10384.86,
      "formatted_start": "02:53:02.860",
      "formatted_end": "02:53:04.860",
      "text": "همین جلو ها خیلی نزدیک"
    },
    {
      "id": 55,
      "start": 10384.86,
      "end": 10386.86,
      "formatted_start": "02:53:04.860",
      "formatted_end": "02:53:06.860",
      "text": "دورتر بری نمیبینی؟"
    },
    {
      "id": 56,
      "start": 10386.86,
      "end": 10388.86,
      "formatted_start": "02:53:06.860",
      "formatted_end": "02:53:08.860",
      "text": "چرا؟"
    },
    {
      "id": 57,
      "start": 10388.86,
      "end": 10392.86,
      "formatted_start": "02:53:08.860",
      "formatted_end": "02:53:12.860",
      "text": "تو میخواد بازی کنه با اون چیزش، پاشو میزنه ببین"
    },
    {
      "id": 58,
      "start": 10392.86,
      "end": 10396.86,
      "formatted_start": "02:53:12.860",
      "formatted_end": "02:53:16.860",
      "text": "چرا؟ از شعری تلویزیون که شده ازید میکنم"
    },
    {
      "id": 59,
      "start": 10396.86,
      "end": 10400.86,
      "formatted_start": "02:53:16.860",
      "formatted_end": "02:53:20.860",
      "text": "ببین، بلند شده اونجا بازید"
    },
    {
      "id": 60,
      "start": 10406.86,
      "end": 10410.86,
      "formatted_start": "02:53:26.860",
      "formatted_end": "02:53:30.860",
      "text": "ببین، پایی رو نگاه نکن، من رو نگاه خوب کنم"
    },
    {
      "id": 61,
      "start": 10410.86,
      "end": 10412.86,
      "formatted_start": "02:53:30.860",
      "formatted_end": "02:53:32.860",
      "text": "بعد این شدید"
    },
    {
      "id": 62,
      "start": 10412.86,
      "end": 10415.86,
      "formatted_start": "02:53:32.860",
      "formatted_end": "02:53:35.860",
      "text": "این رو بیرون جلوی این پاس"
    },
    {
      "id": 63,
      "start": 10415.86,
      "end": 10416.86,
      "formatted_start": "02:53:35.860",
      "formatted_end": "02:53:36.860",
      "text": "اینجوری"
    },
    {
      "id": 64,
      "start": 10416.86,
      "end": 10417.86,
      "formatted_start": "02:53:36.860",
      "formatted_end": "02:53:37.860",
      "text": "آفرین"
    },
    {
      "id": 65,
      "start": 10417.86,
      "end": 10418.86,
      "formatted_start": "02:53:37.860",
      "formatted_end": "02:53:38.860",
      "text": "آفرین"
    },
    {
      "id": 66,
      "start": 10418.86,
      "end": 10420.86,
      "formatted_start": "02:53:38.860",
      "formatted_end": "02:53:40.860",
      "text": "کندر"
    },
    {
      "id": 67,
      "start": 10420.86,
      "end": 10421.86,
      "formatted_start": "02:53:40.860",
      "formatted_end": "02:53:41.860",
      "text": "باشون"
    },
    {
      "id": 68,
      "start": 10422.86,
      "end": 10425.86,
      "formatted_start": "02:53:42.860",
      "formatted_end": "02:53:45.860",
      "text": "باشین محتت صالمه صالمه"
    },
    {
      "id": 69,
      "start": 10426.86,
      "end": 10430.86,
      "formatted_start": "02:53:46.860",
      "formatted_end": "02:53:50.860",
      "text": "خب ببین دست انگاشتو بزن ببینید بزن به انگاشت من"
    },
    {
      "id": 70,
      "start": 10430.86,
      "end": 10432.86,
      "formatted_start": "02:53:50.860",
      "formatted_end": "02:53:52.860",
      "text": "تون تون اینجوری"
    },
    {
      "id": 71,
      "start": 10432.86,
      "end": 10436.86,
      "formatted_start": "02:53:52.860",
      "formatted_end": "02:53:56.860",
      "text": "من انگاشتم رو تکن میدم شما بزن ببینید بزن به انگاشت من"
    },
    {
      "id": 72,
      "start": 10437.86,
      "end": 10438.86,
      "formatted_start": "02:53:57.860",
      "formatted_end": "02:53:58.860",
      "text": "بزن"
    },
    {
      "id": 73,
      "start": 10438.86,
      "end": 10440.86,
      "formatted_start": "02:53:58.860",
      "formatted_end": "02:54:00.860",
      "text": "دستو دراست نمیدونید؟ آفرین"
    },
    {
      "id": 74,
      "start": 10441.86,
      "end": 10443.86,
      "formatted_start": "02:54:01.860",
      "formatted_end": "02:54:03.860",
      "text": "بزن ببینید"
    },
    {
      "id": 75,
      "start": 10445.86,
      "end": 10449.86,
      "formatted_start": "02:54:05.860",
      "formatted_end": "02:54:09.860",
      "text": "خب تصمیم وقتش نشدی خوبه"
    },
    {
      "id": 76,
      "start": 10449.86,
      "end": 10457.86,
      "formatted_start": "02:54:09.860",
      "formatted_end": "02:54:17.860",
      "text": "خب در نتیجه اون سرگیجه پاب اونی که اینجوری چرخش داره اون بخاطر گوشه ها"
    },
    {
      "id": 77,
      "start": 10457.86,
      "end": 10459.86,
      "formatted_start": "02:54:17.860",
      "formatted_end": "02:54:19.860",
      "text": "یه هایی سرشو بازاشده یه هایی تکون داده"
    },
    {
      "id": 78,
      "start": 10459.86,
      "end": 10460.86,
      "formatted_start": "02:54:19.860",
      "formatted_end": "02:54:20.860",
      "text": "یه هایی تکون داده"
    },
    {
      "id": 79,
      "start": 10460.86,
      "end": 10461.86,
      "formatted_start": "02:54:20.860",
      "formatted_end": "02:54:21.860",
      "text": "مایه گوشش"
    },
    {
      "id": 80,
      "start": 10461.86,
      "end": 10462.86,
      "formatted_start": "02:54:21.860",
      "formatted_end": "02:54:22.860",
      "text": "اون قبل هم"
    },
    {
      "id": 81,
      "start": 10462.86,
      "end": 10464.86,
      "formatted_start": "02:54:22.860",
      "formatted_end": "02:54:24.860",
      "text": "آره تکون خورده اون تما شد"
    },
    {
      "id": 82,
      "start": 10464.86,
      "end": 10465.86,
      "formatted_start": "02:54:24.860",
      "formatted_end": "02:54:25.860",
      "text": "تما شد"
    },
    {
      "id": 83,
      "start": 10465.86,
      "end": 10470.86,
      "formatted_start": "02:54:25.860",
      "formatted_end": "02:54:30.860",
      "text": "ولی اینی که میگه گاه های سرم ریچ میره میتونه بخاطر ضعیف بودن چشماش باشه"
    },
    {
      "id": 84,
      "start": 10470.86,
      "end": 10473.86,
      "formatted_start": "02:54:30.860",
      "formatted_end": "02:54:33.860",
      "text": "میتونه بخاطر کمکونی باشه"
    },
    {
      "id": 85,
      "start": 10473.86,
      "end": 10476.58,
      "formatted_start": "02:54:33.860",
      "formatted_end": "02:54:36.580",
      "text": "یه آزمایش براش انجام بده"
    },
    {
      "id": 86,
      "start": 10476.58,
      "end": 10479.18,
      "formatted_start": "02:54:36.580",
      "formatted_end": "02:54:39.180",
      "text": "ببین"
    },
    {
      "id": 87,
      "start": 10479.18,
      "end": 10481.36,
      "formatted_start": "02:54:39.180",
      "formatted_end": "02:54:41.360",
      "text": "آبین ها چند ساله ایده"
    },
    {
      "id": 88,
      "start": 10481.36,
      "end": 10482.28,
      "formatted_start": "02:54:41.360",
      "formatted_end": "02:54:42.280",
      "text": "ده سال"
    },
    {
      "id": 89,
      "start": 10482.28,
      "end": 10484.98,
      "formatted_start": "02:54:42.280",
      "formatted_end": "02:54:44.980",
      "text": "آخرین باری که آزمایش انجام دادی کهی بود"
    },
    {
      "id": 90,
      "start": 10484.98,
      "end": 10486.0,
      "formatted_start": "02:54:44.980",
      "formatted_end": "02:54:46.000",
      "text": "دو ساله پیش"
    },
    {
      "id": 91,
      "start": 10486.0,
      "end": 10487.96,
      "formatted_start": "02:54:46.000",
      "formatted_end": "02:54:47.960",
      "text": "نه یک ساله پیش"
    },
    {
      "id": 92,
      "start": 10487.96,
      "end": 10490.38,
      "formatted_start": "02:54:47.960",
      "formatted_end": "02:54:50.380",
      "text": "پارسال انجام دادی مشکل نداشت"
    },
    {
      "id": 93,
      "start": 10490.38,
      "end": 10492.96,
      "formatted_start": "02:54:50.380",
      "formatted_end": "02:54:52.960",
      "text": "پارسال پیش خودتون بردن"
    },
    {
      "id": 94,
      "start": 10492.96,
      "end": 10494.12,
      "formatted_start": "02:54:52.960",
      "formatted_end": "02:54:54.120",
      "text": "اوکی بود"
    },
    {
      "id": 95,
      "start": 10494.12,
      "end": 10496.86,
      "formatted_start": "02:54:54.120",
      "formatted_end": "02:54:56.860",
      "text": "برای الان احساس بکنم که زیرا چشمش"
    },
    {
      "id": 96,
      "start": 10496.86,
      "end": 10498.52,
      "formatted_start": "02:54:56.860",
      "formatted_end": "02:54:58.520",
      "text": "از این بره کبوده میره"
    },
    {
      "id": 97,
      "start": 10498.52,
      "end": 10499.54,
      "formatted_start": "02:54:58.520",
      "formatted_end": "02:54:59.540",
      "text": "شناخ هم دوز"
    }
  ],
  "status": "completed"
}