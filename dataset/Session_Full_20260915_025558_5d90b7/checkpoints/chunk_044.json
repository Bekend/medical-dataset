    },
    {
      "id": 98,
      "start": 13446.66,
      "end": 13448.66,
      "formatted_start": "03:44:06.660",
      "formatted_end": "03:44:08.660",
      "text": "مرسی"
    },
    {
      "id": 99,
      "start": 13448.66,
      "end": 13450.66,
      "formatted_start": "03:44:08.660",
      "formatted_end": "03:44:10.660",
      "text": "مرسی"
    },
    {
      "id": 100,
      "start": 13450.66,
      "end": 13452.66,
      "formatted_start": "03:44:10.660",
      "formatted_end": "03:44:12.660",
      "text": "مرسی"
    },
    {
      "id": 101,
      "start": 13452.66,
      "end": 13454.66,
      "formatted_start": "03:44:12.660",
      "formatted_end": "03:44:14.660",
      "text": "مرسی"
    },
    {
      "id": 102,
      "start": 13454.66,
      "end": 13458.66,
      "formatted_start": "03:44:14.660",
      "formatted_end": "03:44:18.660",
      "text": "از اینکه برخون در صورت تقبیلش رو میدن"
    },
    {
      "id": 103,
      "start": 13458.66,
      "end": 13462.66,
      "formatted_start": "03:44:18.660",
      "formatted_end": "03:44:22.660",
      "text": "ولی پری ها الان صرفا ازافه شده"
    },
    {
      "id": 104,
      "start": 13462.66,
      "end": 13464.66,
      "formatted_start": "03:44:22.660",
      "formatted_end": "03:44:24.660",
      "text": "صرفاش عذیبش میکنه"
    },
    {
      "id": 105,
      "start": 13464.66,
      "end": 13466.66,
      "formatted_start": "03:44:24.660",
      "formatted_end": "03:44:26.660",
      "text": "یه اسمی به من یک بار گفتی"
    },
    {
      "id": 106,
      "start": 13466.66,
      "end": 13468.66,
      "formatted_start": "03:44:26.660",
      "formatted_end": "03:44:28.660",
      "text": "اونو دارم تو کنه"
    },
    {
      "id": 107,
      "start": 13468.66,
      "end": 13470.66,
      "formatted_start": "03:44:28.660",
      "formatted_end": "03:44:30.660",
      "text": "چون این عادت کرده"
    },
    {
      "id": 108,
      "start": 13470.66,
      "end": 13472.66,
      "formatted_start": "03:44:30.660",
      "formatted_end": "03:44:32.660",
      "text": "مثلا مادر شما رو میده که میزن و دیدن"
    },
    {
      "id": 109,
      "start": 13472.66,
      "end": 13474.66,
      "formatted_start": "03:44:32.660",
      "formatted_end": "03:44:34.660",
      "text": "و میمون بدم و بزنن"
    },
    {
      "id": 110,
      "start": 13474.66,
      "end": 13476.66,
      "formatted_start": "03:44:34.660",
      "formatted_end": "03:44:36.660",
      "text": "برای این رو قایم کردن"
    },
    {
      "id": 111,
      "start": 13476.66,
      "end": 13479.66,
      "formatted_start": "03:44:36.660",
      "formatted_end": "03:44:39.660",
      "text": "گفتم نمونه تو سرش دست نداری"
    },
    {
      "id": 112,
      "start": 13479.66,
      "end": 13481.66,
      "formatted_start": "03:44:39.660",
      "formatted_end": "03:44:41.660",
      "text": "خلاصه اینکه خب بگیر دارم"
    },
    {
      "id": 113,
      "start": 13481.66,
      "end": 13483.66,
      "formatted_start": "03:44:41.660",
      "formatted_end": "03:44:43.660",
      "text": "خورسه های پری ها خیلی زیاده"
    },
    {
      "id": 114,
      "start": 13483.66,
      "end": 13485.66,
      "formatted_start": "03:44:43.660",
      "formatted_end": "03:44:45.660",
      "text": "روزا بیشتری یا شبان؟"
    },
    {
      "id": 115,
      "start": 13485.66,
      "end": 13488.66,
      "formatted_start": "03:44:45.660",
      "formatted_end": "03:44:48.660",
      "text": "خاندکتر شبان صرفه میپنه رو"
    },
    {
      "id": 116,
      "start": 13488.66,
      "end": 13491.66,
      "formatted_start": "03:44:48.660",
      "formatted_end": "03:44:51.660",
      "text": "مخصوصا که دراز میکشه یا میره و هیجه"
    },
    {
      "id": 117,
      "start": 13491.66,
      "end": 13493.66,
      "formatted_start": "03:44:51.660",
      "formatted_end": "03:44:53.660",
      "text": "نبابه خیلی زیاد میشه"
    },
    {
      "id": 118,
      "start": 13493.66,
      "end": 13495.66,
      "formatted_start": "03:44:53.660",
      "formatted_end": "03:44:55.660",
      "text": "نفس بکن"
    },
    {
      "id": 119,
      "start": 13495.66,
      "end": 13496.66,
      "formatted_start": "03:44:55.660",
      "formatted_end": "03:44:56.660",
      "text": "جوپا"
    },
    {
      "id": 120,
      "start": 13496.66,
      "end": 13499.66,
      "formatted_start": "03:44:56.660",
      "formatted_end": "03:44:59.660",
      "text": "بابا صدا شو بشن کامیتر"
    }
