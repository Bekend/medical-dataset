      "id": 4,
      "start": 12036.0,
      "end": 12038.0,
      "formatted_start": "03:20:36.000",
      "formatted_end": "03:20:38.000",
      "text": "بیا بیا"
    },
    {
      "id": 5,
      "start": 12038.0,
      "end": 12040.0,
      "formatted_start": "03:20:38.000",
      "formatted_end": "03:20:40.000",
      "text": "اصیله خودتی دیگه اصنو خودتی"
    },
    {
      "id": 6,
      "start": 12040.0,
      "end": 12042.0,
      "formatted_start": "03:20:40.000",
      "formatted_end": "03:20:42.000",
      "text": "آره آره اصنو"
    },
    {
      "id": 7,
      "start": 12042.0,
      "end": 12044.0,
      "formatted_start": "03:20:42.000",
      "formatted_end": "03:20:44.000",
      "text": "خیلی دستاش داره بگیر"
    },
    {
      "id": 8,
      "start": 12044.0,
      "end": 12046.0,
      "formatted_start": "03:20:44.000",
      "formatted_end": "03:20:46.000",
      "text": "ایجاد"
    },
    {
      "id": 9,
      "start": 12046.0,
      "end": 12048.0,
      "formatted_start": "03:20:46.000",
      "formatted_end": "03:20:48.000",
      "text": "اصیله"
    },
    {
      "id": 10,
      "start": 12048.0,
      "end": 12050.0,
      "formatted_start": "03:20:48.000",
      "formatted_end": "03:20:50.000",
      "text": "هم"
    },
    {
      "id": 11,
      "start": 12050.0,
      "end": 12052.0,
      "formatted_start": "03:20:50.000",
      "formatted_end": "03:20:52.000",
      "text": "خوبه؟ آره"
    },
    {
      "id": 12,
      "start": 12052.0,
      "end": 12054.0,
      "formatted_start": "03:20:52.000",
      "formatted_end": "03:20:54.000",
      "text": "ببین اینه"
    },
    {
      "id": 13,
      "start": 12054.0,
      "end": 12056.0,
      "formatted_start": "03:20:54.000",
      "formatted_end": "03:20:56.000",
      "text": "گلوش خیلی مرهبه خب"
    },
    {
      "id": 14,
      "start": 12056.0,
      "end": 12058.0,
      "formatted_start": "03:20:56.000",
      "formatted_end": "03:20:58.000",
      "text": "گلو ده هست داره پیر براره"
    },
    {
      "id": 15,
      "start": 12058.0,
      "end": 12061.5,
      "formatted_start": "03:20:58.000",
      "formatted_end": "03:21:01.500",
      "text": "اینجا برنامه همش هر ساعت نیست، همه بیدا میشه"
    },
    {
      "id": 16,
      "start": 12061.5,
      "end": 12065.62,
      "formatted_start": "03:21:01.500",
      "formatted_end": "03:21:05.620",
      "text": "چیزی که باعث بیقرارش میشه، معمولا بچه هایی که معرض میشن، یکی او فرنند به گوشه"
    },
    {
      "id": 17,
      "start": 12065.62,
      "end": 12069.4,
      "formatted_start": "03:21:05.620",
      "formatted_end": "03:21:09.400",
      "text": "یکی گلو درده که باعث بیقرارش میشه، یکی هم گرفته که یکی نیست که میشن"
    },
    {
      "id": 18,
      "start": 12069.4,
      "end": 12071.4,
      "formatted_start": "03:21:09.400",
      "formatted_end": "03:21:11.400",
      "text": "آره نیست، نه میتونست نخواست شده که شده"
    },
    {
      "id": 19,
      "start": 12071.4,
      "end": 12074.0,
      "formatted_start": "03:21:11.400",
      "formatted_end": "03:21:14.000",
      "text": "این هم دیگه کلافه میکنه برای چند روز که خواب"
    },
    {
      "id": 20,
      "start": 12074.0,
      "end": 12077.84,
      "formatted_start": "03:21:14.000",
      "formatted_end": "03:21:17.840",
      "text": "خودمونم برز میشم شبهر برز دیدی میسوزرسم تایی"
    },
    {
      "id": 21,
      "start": 12077.84,
      "end": 12079.84,
      "formatted_start": "03:21:17.840",
      "formatted_end": "03:21:19.840",
      "text": "خودتو توابشم خیلی"
    },
    {
      "id": 22,
      "start": 12079.84,
      "end": 12081.84,
      "formatted_start": "03:21:19.840",
      "formatted_end": "03:21:21.840",
      "text": "من میزنش دابر کنیم"
    },
    {
      "id": 23,
      "start": 12081.84,
      "end": 12083.84,
      "formatted_start": "03:21:21.840",
      "formatted_end": "03:21:23.840",
      "text": "میمتونم خیلی درمانیه نه"
    },
    {
      "id": 24,
      "start": 12083.84,
      "end": 12085.84,
      "formatted_start": "03:21:23.840",
      "formatted_end": "03:21:25.840",
      "text": "ایرانیه"
    },
    {
      "id": 25,
      "start": 12088.64,
      "end": 12091.44,
      "formatted_start": "03:21:28.640",
      "formatted_end": "03:21:31.440",
      "text": "خب برزنش هم برز بکنیم"
    },
    {
      "id": 26,
      "start": 12098.0,
      "end": 12100.0,
      "formatted_start": "03:21:38.000",
      "formatted_end": "03:21:40.000",
      "text": "چیه اونه این خواره از ایران؟"
    },
    {
      "id": 27,
      "start": 12101.68,
      "end": 12102.68,
      "formatted_start": "03:21:41.680",
      "formatted_end": "03:21:42.680",
      "text": "بالا نه این بالا"
    },
    {
      "id": 28,
      "start": 12102.68,
      "end": 12103.68,
      "formatted_start": "03:21:42.680",
      "formatted_end": "03:21:43.680",
      "text": "نه بالا که نه"
    },
    {
      "id": 29,
      "start": 12103.68,
      "end": 12105.08,
      "formatted_start": "03:21:43.680",
      "formatted_end": "03:21:45.080",
      "text": "بر اصحاب نشانه؟"
    },
    {
      "id": 30,
      "start": 12105.08,
      "end": 12105.58,
      "formatted_start": "03:21:45.080",
      "formatted_end": "03:21:45.580",
      "text": "نه"
    },
    {
      "id": 31,
      "start": 12106.58,
      "end": 12107.78,
      "formatted_start": "03:21:46.580",
      "formatted_end": "03:21:47.780",
      "text": "شکرمش هم دوتا"
    },
    {
      "id": 32,
      "start": 12107.78,
      "end": 12109.58,
      "formatted_start": "03:21:47.780",
      "formatted_end": "03:21:49.580",
      "text": "اون سری قبل اومدن"
    },
    {
      "id": 33,
      "start": 12109.58,
      "end": 12111.18,
      "formatted_start": "03:21:49.580",
      "formatted_end": "03:21:51.180",
      "text": "ایدرولاکس داره بودن"
    },
    {
      "id": 34,
      "start": 12111.18,
      "end": 12111.78,
      "formatted_start": "03:21:51.180",
      "formatted_end": "03:21:51.780",
      "text": "آه"
    },
    {
      "id": 35,
      "start": 12112.08,
      "end": 12113.58,
      "formatted_start": "03:21:52.080",
      "formatted_end": "03:21:53.580",
      "text": "بر اونو بهش بیرن"
    },
    {
      "id": 36,
      "start": 12113.58,
      "end": 12114.18,
      "formatted_start": "03:21:53.580",
      "formatted_end": "03:21:54.180",
      "text": "خوب بشه"
    },
    {
      "id": 37,
      "start": 12114.18,
      "end": 12115.18,
      "formatted_start": "03:21:54.180",
      "formatted_end": "03:21:55.180",
      "text": "بشه خوب بخورن"
    },
    {
      "id": 38,
      "start": 12115.18,
      "end": 12116.58,
      "formatted_start": "03:21:55.180",
      "formatted_end": "03:21:56.580",
      "text": "ولی اونو نخور شیگه"
    },
    {
      "id": 39,
      "start": 12117.08,
      "end": 12117.78,
      "formatted_start": "03:21:57.080",
      "formatted_end": "03:21:57.780",
      "text": "اصلا"
    },
    {
      "id": 40,
      "start": 12118.68,
      "end": 12120.08,
      "formatted_start": "03:21:58.680",
      "formatted_end": "03:22:00.080",
      "text": "یه خواهی بشه"
    },
    {
      "id": 41,
      "start": 12120.08,
      "end": 12121.28,
      "formatted_start": "03:22:00.080",
      "formatted_end": "03:22:01.280",
      "text": "ده کلو"
    },
    {
      "id": 42,
      "start": 12123.48,
      "end": 12124.08,
      "formatted_start": "03:22:03.480",
      "formatted_end": "03:22:04.080",
      "text": "خب"
    },
    {
      "id": 43,
      "start": 12124.68,
      "end": 12125.48,
      "formatted_start": "03:22:04.680",
      "formatted_end": "03:22:05.480",
      "text": "شیشه بخوره؟"
    },
    {
      "id": 44,
      "start": 12125.48,
      "end": 12126.98,
      "formatted_start": "03:22:05.480",
      "formatted_end": "03:22:06.980",
      "text": "بر اینکه از توف کرده بخور"
    },
    {
      "id": 45,
      "start": 12126.98,
      "end": 12127.88,
      "formatted_start": "03:22:06.980",
      "formatted_end": "03:22:07.880",
      "text": "الان خوب برن"
    },
    {
      "id": 46,
      "start": 12127.88,
      "end": 12129.08,
      "formatted_start": "03:22:07.880",
      "formatted_end": "03:22:09.080",
      "text": "ده خوب سری قبل اومدن"
    },
    {
      "id": 47,
      "start": 12129.08,
      "end": 12130.08,
      "formatted_start": "03:22:09.080",
      "formatted_end": "03:22:10.080",
      "text": "آه ده خوب بشه"
    },
    {
      "id": 48,
      "start": 12130.08,
      "end": 12131.08,
      "formatted_start": "03:22:10.080",
      "formatted_end": "03:22:11.080",
      "text": "ده خوب بشه"
    },
    {
      "id": 49,
      "start": 12131.08,
      "end": 12132.38,
      "formatted_start": "03:22:11.080",
      "formatted_end": "03:22:12.380",
      "text": "چند سال، چند ماه شکر کنی؟"
    },
    {
      "id": 50,
      "start": 12132.38,
      "end": 12135.88,
      "formatted_start": "03:22:12.380",
      "formatted_end": "03:22:15.880",
      "text": "15 ماه شد. چند کیلوز به دنیا آمد؟"
    },
    {
      "id": 51,
      "start": 12135.88,
      "end": 12137.62,
      "formatted_start": "03:22:15.880",
      "formatted_end": "03:22:17.620",
      "text": "3 کیلو"
    },
    {
      "id": 52,
      "start": 12137.62,
      "end": 12138.88,
      "formatted_start": "03:22:17.620",
      "formatted_end": "03:22:18.880",
      "text": "3 کیلو؟"
    },
    {
      "id": 53,
      "start": 12138.88,
      "end": 12140.88,
      "formatted_start": "03:22:18.880",
      "formatted_end": "03:22:20.880",
      "text": "اصلا شدی خیلی خوبه"
    },
    {
      "id": 54,
      "start": 12140.88,
      "end": 12141.38,
      "formatted_start": "03:22:20.880",
      "formatted_end": "03:22:21.380",
      "text": "خوبه؟"
    },
    {
      "id": 55,
      "start": 12141.38,
      "end": 12142.38,
      "formatted_start": "03:22:21.380",
      "formatted_end": "03:22:22.380",
      "text": "خیلی خوبه"
    },
    {
      "id": 56,
      "start": 12142.38,
      "end": 12147.88,
      "formatted_start": "03:22:22.380",
      "formatted_end": "03:22:27.880",
      "text": "اون 4 ماه، 5 ماه، یکی همش می گفتن که اضافه وزن دارد و اینا می ترسوندن"
    },
    {
      "id": 57,
      "start": 12147.88,
      "end": 12150.88,
      "formatted_start": "03:22:27.880",
      "formatted_end": "03:22:30.880",
      "text": "ولی نبی دادم یه اون چی شد؟ استوب کردن"
    },
    {
      "id": 58,
      "start": 12150.88,
      "end": 12156.38,
      "formatted_start": "03:22:30.880",
      "formatted_end": "03:22:36.380",
      "text": "اصلا ببین بچه هایی که از این اضافه وزن دارند، یه دفعه ای استوب میکنند"
    },
    {
      "id": 59,
      "start": 12156.38,
      "end": 12158.38,
      "formatted_start": "03:22:36.380",
      "formatted_end": "03:22:38.380",
      "text": "استوب کردن، اصلا هیچ چی وزن نکرد"
    },
    {
      "id": 60,
      "start": 12158.38,
      "end": 12160.38,
      "formatted_start": "03:22:38.380",
      "formatted_end": "03:22:40.380",
      "text": "پس اینکه بیرون زنده نمیتونه"
    },
    {
      "id": 61,
      "start": 12160.38,
      "end": 12162.38,
      "formatted_start": "03:22:40.380",
      "formatted_end": "03:22:42.380",
      "text": "پس اینکه فقط شیر میخورند"
    },
    {
      "id": 62,
      "start": 12162.38,
      "end": 12164.38,
      "formatted_start": "03:22:42.380",
      "formatted_end": "03:22:44.380",
      "text": "خیلی خیلی خیلی خیلی خیلی"
    },
    {
      "id": 63,
      "start": 12164.38,
      "end": 12166.38,
      "formatted_start": "03:22:44.380",
      "formatted_end": "03:22:46.380",
      "text": "وقتی قبض شروع میشه تحریکشون"
    },
    {
      "id": 64,
      "start": 12166.38,
      "end": 12168.38,
      "formatted_start": "03:22:46.380",
      "formatted_end": "03:22:48.380",
      "text": "شروع میشه دیگه"
    },
    {
      "id": 65,
      "start": 12168.38,
      "end": 12170.38,
      "formatted_start": "03:22:48.380",
      "formatted_end": "03:22:50.380",
      "text": "اسکت میخورند"
    },
    {
      "id": 66,
      "start": 12170.38,
      "end": 12172.38,
      "formatted_start": "03:22:50.380",
      "formatted_end": "03:22:52.380",
      "text": "خب"
    },
    {
      "id": 67,
      "start": 12178.38,
      "end": 12180.38,
      "formatted_start": "03:22:58.380",
      "formatted_end": "03:23:00.380",
      "text": "خب باید بیدید"
    },
    {
      "id": 68,
      "start": 12180.38,
      "end": 12182.38,
      "formatted_start": "03:23:00.380",
      "formatted_end": "03:23:02.380",
      "text": "داروهایی که من دراش میمیدیدم"
    },
    {
      "id": 69,
      "start": 12184.38,
      "end": 12186.38,
      "formatted_start": "03:23:04.380",
      "formatted_end": "03:23:06.380",
      "text": "یه زمین شربته نیوتادینه"
    },
    {
      "id": 70,
      "start": 12186.38,
      "end": 12190.6,
      "formatted_start": "03:23:06.380",
      "formatted_end": "03:23:10.600",
      "text": "هر 12 ساعت 2.5 سیزی بشه"
    },
    {
      "id": 71,
      "start": 12190.6,
      "end": 12193.62,
      "formatted_start": "03:23:10.600",
      "formatted_end": "03:23:13.620",
      "text": "یه دونه قطره پلاریه"
    },
    {
      "id": 72,
      "start": 12193.62,
      "end": 12197.52,
      "formatted_start": "03:23:13.620",
      "formatted_end": "03:23:17.520",
      "text": "هر 8 ساعت 1 سیزی بشه"
    },
    {
      "id": 73,
      "start": 12197.52,
      "end": 12200.14,
      "formatted_start": "03:23:17.520",
      "formatted_end": "03:23:20.140",
      "text": "و یه قطره بینی"
    },
    {
      "id": 74,
      "start": 12200.14,
      "end": 12202.98,
      "formatted_start": "03:23:20.140",
      "formatted_end": "03:23:22.980",
      "text": "روزی"
    },
    {
      "id": 75,
      "start": 12202.98,
      "end": 12206.7,
      "formatted_start": "03:23:22.980",
      "formatted_end": "03:23:26.700",
      "text": "دو بار یه قطره داخل بیدی شوید"
    },
    {
      "id": 76,
      "start": 12206.7,
      "end": 12212.68,
      "formatted_start": "03:23:26.700",
      "formatted_end": "03:23:32.680",
      "text": "اگر تب کرد بهش آراموز میده"
    },
    {
      "id": 77,
      "start": 12212.68,
      "end": 12216.18,
      "formatted_start": "03:23:32.680",
      "formatted_end": "03:23:36.180",
      "text": "هر هزار ساعت 5 سی سی"
    },
    {
      "id": 78,
      "start": 12216.18,
      "end": 12217.68,
      "formatted_start": "03:23:36.180",
      "formatted_end": "03:23:37.680",
      "text": "اگه ترک"
    },
    {
      "id": 79,
      "start": 12217.68,
      "end": 12219.68,
      "formatted_start": "03:23:37.680",
      "formatted_end": "03:23:39.680",
      "text": "اگه نکردم نه"
    },
    {
      "id": 80,
      "start": 12219.68,
      "end": 12221.68,
      "formatted_start": "03:23:39.680",
      "formatted_end": "03:23:41.680",
      "text": "بچه ایش"
    },
    {
      "id": 81,
      "start": 12221.68,
      "end": 12225.68,
      "formatted_start": "03:23:41.680",
      "formatted_end": "03:23:45.680",
      "text": "بخوامده طور این شبستویی که نوشتیم"
    },
    {
      "id": 82,
      "start": 12225.68,
      "end": 12227.68,
      "formatted_start": "03:23:45.680",
      "formatted_end": "03:23:47.680",
      "text": "تو کی میتونم استفاده کنم؟"
    },
    {
      "id": 83,
      "start": 12227.68,
      "end": 12229.68,
      "formatted_start": "03:23:47.680",
      "formatted_end": "03:23:49.680",
      "text": "این ها رو با شما میدونی"
    },
    {
      "id": 84,
      "start": 12229.68,
      "end": 12232.68,
      "formatted_start": "03:23:49.680",
      "formatted_end": "03:23:52.680",
      "text": "سه ماه، یکی دو روز استفاده کنم خوبه خوب میشه"
    },
    {
      "id": 85,
      "start": 12232.68,
      "end": 12235.68,
      "formatted_start": "03:23:52.680",
      "formatted_end": "03:23:55.680",
      "text": "بابا شبیه خیلی بیاده خیلی بیاده"
    },
    {
      "id": 86,
      "start": 12235.68,
      "end": 12237.68,
      "formatted_start": "03:23:55.680",
      "formatted_end": "03:23:57.680",
      "text": "سه ماه"
    },
    {
      "id": 87,
      "start": 12237.68,
      "end": 12240.68,
      "formatted_start": "03:23:57.680",
      "formatted_end": "03:24:00.680",
      "text": "بخوامده طور این پیدرولاک سه"
    },
    {
      "id": 88,
      "start": 12240.68,
      "end": 12256.68,
      "formatted_start": "03:24:00.680",
      "formatted_end": "03:24:16.680",
      "text": "این قبضان ها که تیعیه میکردن اصلا مزه نداشت این تازه گیه که داری فانو آوردن مزه داره این تح مزهی داره یه بوی فیلی خفیفی داره اصلا این رو یه تراز بکنی میگه قبلا مزه نداشت بو نداشت الان میریدی خوره"
    },
    {
      "id": 89,
      "start": 12256.68,
      "end": 12258.68,
      "formatted_start": "03:24:16.680",
      "formatted_end": "03:24:18.680",
      "text": "آخه این رسیبیه نه"
    },
    {
      "id": 90,
      "start": 12258.68,
      "end": 12263.68,
      "formatted_start": "03:24:18.680",
      "formatted_end": "03:24:23.680",
      "text": "این کارتونه به کارتونه فرق داره نه تا از همون کارتونه قبضیه میگی میگی"
    },
    {
      "id": 91,
      "start": 12263.68,
      "end": 12268.68,
      "formatted_start": "03:24:23.680",
      "formatted_end": "03:24:28.680",
      "text": "نه نه برنامه نمیکرد اصلا آره همون قبضیه بود"
    },
    {
      "id": 92,
      "start": 12268.68,
      "end": 12274.68,
      "formatted_start": "03:24:28.680",
      "formatted_end": "03:24:34.680",
      "text": "اینجور دیگه من سنن بسته بردی و اینش که من بنابراین"
    },
    {
      "id": 93,
      "start": 12274.68,
      "end": 12276.68,
      "formatted_start": "03:24:34.680",
      "formatted_end": "03:24:36.680",
      "text": "این هم خود رو نداره"
    },
    {
      "id": 94,
      "start": 12276.68,
      "end": 12280.68,
      "formatted_start": "03:24:36.680",
      "formatted_end": "03:24:40.680",
      "text": "همینشون یه تهبزه یه روغنی طولی داره"
    },
    {
      "id": 95,
      "start": 12280.68,
      "end": 12281.68,
      "formatted_start": "03:24:40.680",
      "formatted_end": "03:24:41.680",
      "text": "خب؟"
    },
    {
      "id": 96,
      "start": 12281.68,
      "end": 12283.68,
      "formatted_start": "03:24:41.680",
      "formatted_end": "03:24:43.680",
      "text": "حالا مثلا قبل اما شاید توی چیز دیگه بیرخیری"
    },
    {
      "id": 97,
      "start": 12283.68,
      "end": 12285.68,
      "formatted_start": "03:24:43.680",
      "formatted_end": "03:24:45.680",
      "text": "ملوث رو نداره بگیره"
    },
    {
      "id": 98,
      "start": 12285.68,
      "end": 12288.68,
      "formatted_start": "03:24:45.680",
      "formatted_end": "03:24:48.680",
      "text": "الان چایی کمتری ملوث داره"
    },
    {
      "id": 99,
      "start": 12288.68,
      "end": 12289.68,
      "formatted_start": "03:24:48.680",
      "formatted_end": "03:24:49.680",
      "text": "خب؟"
    },
    {
      "id": 100,
      "start": 12289.68,
      "end": 12290.68,
      "formatted_start": "03:24:49.680",
      "formatted_end": "03:24:50.680",
      "text": "چایی؟"
    },
    {
      "id": 101,
      "start": 12290.68,
      "end": 12292.68,
      "formatted_start": "03:24:50.680",
      "formatted_end": "03:24:52.680",
      "text": "بس چایی هم میشه چایی سر"
    },
    {
      "id": 102,
      "start": 12292.68,
      "end": 12293.68,
      "formatted_start": "03:24:52.680",
      "formatted_end": "03:24:53.680",
      "text": "چایی دا؟"
    },
    {
      "id": 103,
      "start": 12293.68,
      "end": 12294.68,
      "formatted_start": "03:24:53.680",
      "formatted_end": "03:24:54.680",
      "text": "تو؟"
    },
    {
      "id": 104,
      "start": 12294.68,
      "end": 12296.68,
      "formatted_start": "03:24:54.680",
      "formatted_end": "03:24:56.680",
      "text": "باشه شما اصلا فیدرولاک چیزی دیگه"
    },
    {
      "id": 105,
      "start": 12296.68,
      "end": 12298.68,
      "formatted_start": "03:24:56.680",
      "formatted_end": "03:24:58.680",
      "text": "سر فرق نداره"
    }
  ],
  "status": "completed"
}