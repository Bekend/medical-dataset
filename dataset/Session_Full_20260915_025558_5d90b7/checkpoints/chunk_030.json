  "stt_segments": [
    {
      "id": 0,
      "start": 9000.0,
      "end": 9003.0,
      "formatted_start": "02:30:00.000",
      "formatted_end": "02:30:03.000",
      "text": "این هستن دوسته باید اینجور شده، مشکل نداشتی."
    },
    {
      "id": 1,
      "start": 9003.0,
      "end": 9006.0,
      "formatted_start": "02:30:03.000",
      "formatted_end": "02:30:06.000",
      "text": "آسما دیگه، این از سنده بلو ببند خیلی برده باشه."
    },
    {
      "id": 2,
      "start": 9006.0,
      "end": 9007.0,
      "formatted_start": "02:30:06.000",
      "formatted_end": "02:30:07.000",
      "text": "بله، میشه."
    },
    {
      "id": 3,
      "start": 9007.0,
      "end": 9009.0,
      "formatted_start": "02:30:07.000",
      "formatted_end": "02:30:09.000",
      "text": "آره، ولی این چیزهایی که گفتم، باید ببانم."
    },
    {
      "id": 4,
      "start": 9009.0,
      "end": 9016.0,
      "formatted_start": "02:30:09.000",
      "formatted_end": "02:30:16.000",
      "text": "گرد و خواست، بود، عضوات و نون، دود، خب، اینها اصلا نباسته با خوشبه."
    },
    {
      "id": 5,
      "start": 9016.0,
      "end": 9020.0,
      "formatted_start": "02:30:16.000",
      "formatted_end": "02:30:20.000",
      "text": "باشه؟ تفضل بلا؟ آفرین. خدا باشه."
    },
    {
      "id": 6,
      "start": 9020.0,
      "end": 9021.0,
      "formatted_start": "02:30:20.000",
      "formatted_end": "02:30:21.000",
      "text": "خوشبه."
    },
    {
      "id": 7,
      "start": 9025.0,
      "end": 9027.0,
      "formatted_start": "02:30:25.000",
      "formatted_end": "02:30:27.000",
      "text": "سلام."
    },
    {
      "id": 8,
      "start": 9027.0,
      "end": 9028.0,
      "formatted_start": "02:30:27.000",
      "formatted_end": "02:30:28.000",
      "text": "سلام."
    },
    {
      "id": 9,
      "start": 9028.0,
      "end": 9030.0,
      "formatted_start": "02:30:28.000",
      "formatted_end": "02:30:30.000",
      "text": "خوبه از دوست داری؟"
    },
    {
      "id": 10,
      "start": 9030.0,
      "end": 9032.0,
      "formatted_start": "02:30:30.000",
      "formatted_end": "02:30:32.000",
      "text": "ممنون شما خوبی؟"
    },
    {
      "id": 11,
      "start": 9032.0,
      "end": 9034.0,
      "formatted_start": "02:30:32.000",
      "formatted_end": "02:30:34.000",
      "text": "ممنون برکه"
    },
    {
      "id": 12,
      "start": 9034.0,
      "end": 9036.0,
      "formatted_start": "02:30:34.000",
      "formatted_end": "02:30:36.000",
      "text": "به تلاقات شوید"
    },
    {
      "id": 13,
      "start": 9036.0,
      "end": 9038.0,
      "formatted_start": "02:30:36.000",
      "formatted_end": "02:30:38.000",
      "text": "خانم اونکه بالا دکتر میشه"
    },
    {
      "id": 14,
      "start": 9038.0,
      "end": 9040.0,
      "formatted_start": "02:30:38.000",
      "formatted_end": "02:30:40.000",
      "text": "هر روز یه بچه گفتم"
    },
    {
      "id": 15,
      "start": 9040.0,
      "end": 9042.0,
      "formatted_start": "02:30:40.000",
      "formatted_end": "02:30:42.000",
      "text": "همونطور که من نمیشناسم"
    },
    {
      "id": 16,
      "start": 9042.0,
      "end": 9044.0,
      "formatted_start": "02:30:42.000",
      "formatted_end": "02:30:44.000",
      "text": "اگه میشن نشناسم"
    },
    {
      "id": 17,
      "start": 9044.0,
      "end": 9046.0,
      "formatted_start": "02:30:44.000",
      "formatted_end": "02:30:46.000",
      "text": "آره"
    },
    {
      "id": 18,
      "start": 9046.0,
      "end": 9048.0,
      "formatted_start": "02:30:46.000",
      "formatted_end": "02:30:48.000",
      "text": "خب مبارکتو باشید"
    },
    {
      "id": 19,
      "start": 9048.0,
      "end": 9050.0,
      "formatted_start": "02:30:48.000",
      "formatted_end": "02:30:50.000",
      "text": "خب شما چطوری؟"
    },
    {
      "id": 20,
      "start": 9050.0,
      "end": 9052.0,
      "formatted_start": "02:30:50.000",
      "formatted_end": "02:30:52.000",
      "text": "خوبی؟"
    },
    {
      "id": 21,
      "start": 9052.0,
      "end": 9054.0,
      "formatted_start": "02:30:52.000",
      "formatted_end": "02:30:54.000",
      "text": "اسم چی بود؟"
    },
    {
      "id": 22,
      "start": 9054.0,
      "end": 9056.0,
      "formatted_start": "02:30:54.000",
      "formatted_end": "02:30:56.000",
      "text": "نورا خانم"
    },
    {
      "id": 23,
      "start": 9056.0,
      "end": 9058.0,
      "formatted_start": "02:30:56.000",
      "formatted_end": "02:30:58.000",
      "text": "ایتون چیه داداشه؟"
    },
    {
      "id": 24,
      "start": 9058.0,
      "end": 9060.0,
      "formatted_start": "02:30:58.000",
      "formatted_end": "02:31:00.000",
      "text": "داداشی اومده خوب"
    },
    {
      "id": 25,
      "start": 9062.0,
      "end": 9064.0,
      "formatted_start": "02:31:02.000",
      "formatted_end": "02:31:04.000",
      "text": "چند وقت شد؟"
    },
    {
      "id": 26,
      "start": 9064.0,
      "end": 9066.0,
      "formatted_start": "02:31:04.000",
      "formatted_end": "02:31:06.000",
      "text": "های عرقسنی"
    },
    {
      "id": 27,
      "start": 9066.0,
      "end": 9068.0,
      "formatted_start": "02:31:06.000",
      "formatted_end": "02:31:08.000",
      "text": "بخیر میخوره همه ش گرگار میکنه"
    },
    {
      "id": 28,
      "start": 9068.0,
      "end": 9070.0,
      "formatted_start": "02:31:08.000",
      "formatted_end": "02:31:10.000",
      "text": "یعنی میکنه"
    },
    {
      "id": 29,
      "start": 9070.0,
      "end": 9072.0,
      "formatted_start": "02:31:10.000",
      "formatted_end": "02:31:12.000",
      "text": "بیتاش برم داداش هم کم شده"
    },
    {
      "id": 30,
      "start": 9072.0,
      "end": 9074.0,
      "formatted_start": "02:31:12.000",
      "formatted_end": "02:31:14.000",
      "text": "شیر مادرم کنه"
    },
    {
      "id": 31,
      "start": 9074.0,
      "end": 9076.0,
      "formatted_start": "02:31:14.000",
      "formatted_end": "02:31:16.000",
      "text": "بعد همه ش هم این گرگش"
    },
    {
      "id": 32,
      "start": 9076.0,
      "end": 9078.0,
      "formatted_start": "02:31:16.000",
      "formatted_end": "02:31:18.000",
      "text": "خورد خورد میگه صدا میکنه"
    },
    {
      "id": 33,
      "start": 9078.0,
      "end": 9080.0,
      "formatted_start": "02:31:18.000",
      "formatted_end": "02:31:20.000",
      "text": "های اینجا آشقاری هست"
    },
    {
      "id": 34,
      "start": 9080.0,
      "end": 9082.0,
      "formatted_start": "02:31:20.000",
      "formatted_end": "02:31:22.000",
      "text": "های اینجا آشقاری هست"
    },
    {
      "id": 35,
      "start": 9082.0,
      "end": 9084.0,
      "formatted_start": "02:31:22.000",
      "formatted_end": "02:31:24.000",
      "text": "های اینجا آشقاری هست"
    },
    {
      "id": 36,
      "start": 9084.0,
      "end": 9094.0,
      "formatted_start": "02:31:24.000",
      "formatted_end": "02:31:34.000",
      "text": "اینجا آشقا دیدم"
    },
    {
      "id": 37,
      "start": 9094.0,
      "end": 9100.0,
      "formatted_start": "02:31:34.000",
      "formatted_end": "02:31:40.000",
      "text": "شاپردوزم مدتوش نمیمونه به تازه"
    },
    {
      "id": 38,
      "start": 9100.0,
      "end": 9104.0,
      "formatted_start": "02:31:40.000",
      "formatted_end": "02:31:44.000",
      "text": "آیا شکنش کنیم که من دیروز تحلیل کنم شکنش کنیم"
    },
    {
      "id": 39,
      "start": 9104.0,
      "end": 9106.0,
      "formatted_start": "02:31:44.000",
      "formatted_end": "02:31:46.000",
      "text": "روز اول کار کردیده"
    },
    {
      "id": 40,
      "start": 9106.0,
      "end": 9108.0,
      "formatted_start": "02:31:46.000",
      "formatted_end": "02:31:48.000",
      "text": "روز اول هم دیگر کار کرده"
    },
    {
      "id": 41,
      "start": 9108.0,
      "end": 9138.0,
      "formatted_start": "02:31:48.000",
      "formatted_end": "02:32:18.000",
      "text": "از اینجا باید برداریم که از اینجا باید برداریم که از اینجا برداریم که از اینجا برداریم که از اینجا برداریم که از اینجا برداریم که از اینجا برداریم که از اینجا برداریم که از اینجا برداریم که از اینجا برداریم که از اینجا برداریم که از اینجا برداریم که از اینجا برداریم که از اینجا برداریم که از اینجا برداریم که از اینج"
    },
    {
      "id": 42,
      "start": 9138.0,
      "end": 9140.0,
      "formatted_start": "02:32:18.000",
      "formatted_end": "02:32:20.000",
      "text": "کم شیر خورده یا جاش گرم"
    },
    {
      "id": 43,
      "start": 9140.0,
      "end": 9142.0,
      "formatted_start": "02:32:20.000",
      "formatted_end": "02:32:22.000",
      "text": "آب"
    },
    {
      "id": 44,
      "start": 9142.0,
      "end": 9144.0,
      "formatted_start": "02:32:22.000",
      "formatted_end": "02:32:24.000",
      "text": "لباس هایی کم میشه"
    },
    {
      "id": 45,
      "start": 9144.0,
      "end": 9146.0,
      "formatted_start": "02:32:24.000",
      "formatted_end": "02:32:26.000",
      "text": "شیردهی رو بیشتر میکنه"
    },
    {
      "id": 46,
      "start": 9146.0,
      "end": 9148.0,
      "formatted_start": "02:32:26.000",
      "formatted_end": "02:32:28.000",
      "text": "از افرادش"
    },
    {
      "id": 47,
      "start": 9148.0,
      "end": 9150.0,
      "formatted_start": "02:32:28.000",
      "formatted_end": "02:32:30.000",
      "text": "برنگه ناروزه"
    },
    {
      "id": 48,
      "start": 9150.0,
      "end": 9152.0,
      "formatted_start": "02:32:30.000",
      "formatted_end": "02:32:32.000",
      "text": "این لکه رسول اون هست"
    },
    {
      "id": 49,
      "start": 9152.0,
      "end": 9154.0,
      "formatted_start": "02:32:32.000",
      "formatted_end": "02:32:34.000",
      "text": "با توی افراد این نشان دهیم"
    },
    {
      "id": 50,
      "start": 9154.0,
      "end": 9156.0,
      "formatted_start": "02:32:34.000",
      "formatted_end": "02:32:36.000",
      "text": "که بدن رفتش کم آبه"
    },
    {
      "id": 51,
      "start": 9158.0,
      "end": 9160.0,
      "formatted_start": "02:32:38.000",
      "formatted_end": "02:32:40.000",
      "text": "پس خوب شیر نمیخوره"
    },
    {
      "id": 52,
      "start": 9160.0,
      "end": 9162.0,
      "formatted_start": "02:32:40.000",
      "formatted_end": "02:32:42.000",
      "text": "یعنی میخوره"
    },
    {
      "id": 53,
      "start": 9162.0,
      "end": 9164.0,
      "formatted_start": "02:32:42.000",
      "formatted_end": "02:32:44.000",
      "text": "همش با قربان"
    },
    {
      "id": 54,
      "start": 9164.0,
      "end": 9166.0,
      "formatted_start": "02:32:44.000",
      "formatted_end": "02:32:46.000",
      "text": "همش گیره رو خوره"
    },
    {
      "id": 55,
      "start": 9166.0,
      "end": 9168.0,
      "formatted_start": "02:32:46.000",
      "formatted_end": "02:32:48.000",
      "text": "نه"
    },
    {
      "id": 56,
      "start": 9168.0,
      "end": 9172.0,
      "formatted_start": "02:32:48.000",
      "formatted_end": "02:32:52.000",
      "text": "چه حدیق به دنیا آمد؟"
    },
    {
      "id": 57,
      "start": 9172.0,
      "end": 9175.0,
      "formatted_start": "02:32:52.000",
      "formatted_end": "02:32:55.000",
      "text": "اینجا مارسان با 3 با 1 بیست آمده"
    },
    {
      "id": 58,
      "start": 9175.0,
      "end": 9178.0,
      "formatted_start": "02:32:55.000",
      "formatted_end": "02:32:58.000",
      "text": "من بردمش ریده شد و این 9 سنه"
    },
    {
      "id": 59,
      "start": 9178.0,
      "end": 9180.0,
      "formatted_start": "02:32:58.000",
      "formatted_end": "02:33:00.000",
      "text": "آره، اون با 3 کیلو"
    },
    {
      "id": 60,
      "start": 9180.0,
      "end": 9183.0,
      "formatted_start": "02:33:00.000",
      "formatted_end": "02:33:03.000",
      "text": "بالا واسه دیگه باشه 2 با 2 سنه بیست"
    },
    {
      "id": 61,
      "start": 9183.0,
      "end": 9186.0,
      "formatted_start": "02:33:03.000",
      "formatted_end": "02:33:06.000",
      "text": "آره، دیگه وقت اضافه کنار کرده"
    },
    {
      "id": 62,
      "start": 9186.0,
      "end": 9189.0,
      "formatted_start": "02:33:06.000",
      "formatted_end": "02:33:09.000",
      "text": "چی کنم خوابیمشون درده؟ کم شیر بزن"
    },
    {
      "id": 63,
      "start": 9189.0,
      "end": 9192.0,
      "formatted_start": "02:33:09.000",
      "formatted_end": "02:33:12.000",
      "text": "ایتفاقا شیر زیاد میخواه"
    },
    {
      "id": 64,
      "start": 9192.0,
      "end": 9196.0,
      "formatted_start": "02:33:12.000",
      "formatted_end": "02:33:16.000",
      "text": "وقتی که امیر میخوابه، میخوابه دیگه سه چهار ساعت"
    },
    {
      "id": 65,
      "start": 9196.0,
      "end": 9199.0,
      "formatted_start": "02:33:16.000",
      "formatted_end": "02:33:19.000",
      "text": "او ندارم، ببینی دست چزش مهم نیست"
    },
    {
      "id": 66,
      "start": 9199.0,
      "end": 9202.0,
      "formatted_start": "02:33:19.000",
      "formatted_end": "02:33:22.000",
      "text": "همین موقع که شیر میکاره، واسه خشک یه رو بیست دقیقه میکاره"
    },
    {
      "id": 67,
      "start": 9203.0,
      "end": 9205.0,
      "formatted_start": "02:33:23.000",
      "formatted_end": "02:33:25.000",
      "text": "بیشتر هم میخوره، بیشتر هم میخوره"
    },
    {
      "id": 68,
      "start": 9205.0,
      "end": 9208.0,
      "formatted_start": "02:33:25.000",
      "formatted_end": "02:33:28.000",
      "text": "و اینها غور غور دیگه، من میدونم، بلکه خواه میزنه"
    },
    {
      "id": 69,
      "start": 9208.0,
      "end": 9210.0,
      "formatted_start": "02:33:28.000",
      "formatted_end": "02:33:30.000",
      "text": "بیشتر من دادی مستی ندارم"
    },
    {
      "id": 70,
      "start": 9212.0,
      "end": 9214.0,
      "formatted_start": "02:33:32.000",
      "formatted_end": "02:33:34.000",
      "text": "نورا، چه خبر ها؟"
    },
    {
      "id": 71,
      "start": 9214.0,
      "end": 9217.0,
      "formatted_start": "02:33:34.000",
      "formatted_end": "02:33:37.000",
      "text": "میخوام به جایزه بدم، داداشی اومده"
    },
    {
      "id": 72,
      "start": 9217.0,
      "end": 9218.0,
      "formatted_start": "02:33:37.000",
      "formatted_end": "02:33:38.000",
      "text": "میخواب؟"
    },
    {
      "id": 73,
      "start": 9218.0,
      "end": 9219.0,
      "formatted_start": "02:33:38.000",
      "formatted_end": "02:33:39.000",
      "text": "میدونی؟"
    },
    {
      "id": 74,
      "start": 9219.0,
      "end": 9221.0,
      "formatted_start": "02:33:39.000",
      "formatted_end": "02:33:41.000",
      "text": "آره"
    },
    {
      "id": 75,
      "start": 9221.0,
      "end": 9222.0,
      "formatted_start": "02:33:41.000",
      "formatted_end": "02:33:42.000",
      "text": "چی بگم؟"
    },
    {
      "id": 76,
      "start": 9222.0,
      "end": 9224.0,
      "formatted_start": "02:33:42.000",
      "formatted_end": "02:33:44.000",
      "text": "جایزه چی؟"
    },
    {
      "id": 77,
      "start": 9224.0,
      "end": 9226.0,
      "formatted_start": "02:33:44.000",
      "formatted_end": "02:33:46.000",
      "text": "جایزه چی؟"
    },
    {
      "id": 78,
      "start": 9226.0,
      "end": 9229.0,
      "formatted_start": "02:33:46.000",
      "formatted_end": "02:33:49.000",
      "text": "جایزه چی؟ الان به جایزه نمیتونیم"
    },
    {
      "id": 79,
      "start": 9229.0,
      "end": 9233.0,
      "formatted_start": "02:33:49.000",
      "formatted_end": "02:33:53.000",
      "text": "خب، بعد ببینیم، یه سینه رو کامل میدی تا ته"
    },
    {
      "id": 80,
      "start": 9233.0,
      "end": 9236.0,
      "formatted_start": "02:33:53.000",
      "formatted_end": "02:33:56.000",
      "text": "بعد اون یکی سینه هم میده یا یکی سینه هم میده"
    },
    {
      "id": 81,
      "start": 9236.0,
      "end": 9238.0,
      "formatted_start": "02:33:56.000",
      "formatted_end": "02:33:58.000",
      "text": "آره، یک در فردی میده"
    },
    {
      "id": 82,
      "start": 9238.0,
      "end": 9240.0,
      "formatted_start": "02:33:58.000",
      "formatted_end": "02:34:00.000",
      "text": "بعد سریعت گیروم هموزورت رو میده"
    },
    {
      "id": 83,
      "start": 9240.0,
      "end": 9242.0,
      "formatted_start": "02:34:00.000",
      "formatted_end": "02:34:02.000",
      "text": "یک درمی کامل میخوریم"
    },
    {
      "id": 84,
      "start": 9242.0,
      "end": 9244.0,
      "formatted_start": "02:34:02.000",
      "formatted_end": "02:34:04.000",
      "text": "ببین باید یه سینه کامل میشه"
    },
    {
      "id": 85,
      "start": 9244.0,
      "end": 9248.0,
      "formatted_start": "02:34:04.000",
      "formatted_end": "02:34:08.000",
      "text": "ته سینه چرمی داره که باعث استرسیب شده"
    },
    {
      "id": 86,
      "start": 9248.0,
      "end": 9250.0,
      "formatted_start": "02:34:08.000",
      "formatted_end": "02:34:10.000",
      "text": "از اینجا باید برداشت بشیم"
    },
    {
      "id": 87,
