    },
    {
      "id": 24,
      "start": 8208.0,
      "end": 8209.0,
      "formatted_start": "02:16:48.000",
      "formatted_end": "02:16:49.000",
      "text": "بسه شما بیرو"
    },
    {
      "id": 25,
      "start": 8209.0,
      "end": 8210.0,
      "formatted_start": "02:16:49.000",
      "formatted_end": "02:16:50.000",
      "text": "باید شما برم"
    },
    {
      "id": 26,
      "start": 8210.0,
      "end": 8240.0,
      "formatted_start": "02:16:50.000",
      "formatted_end": "02:17:20.000",
      "text": "بیا بیا بیا بیا بیا بیا بیا بیا بیا بیا بیا بیا بیا بیا بیا بیا بیا بیا بیا بیا بیا بیا بیا بیا بیا بیا بیا بیا بیا بیا بیا بیا بیا بیا بیا بیا بیا بیا بیا بیا بیا بیا بیا بیا بیا بیا بیا بیا بیا بیا بیا بیا بیا بیا بیا بیا بیا بیا بیا بیا بیا بیا بیا بیا بیا بیا بیا بیا بیا بیا بیا بیا بیا بیا بیا بیا بیا بیا بیا بیا بیا بیا بیا بیا بیا بیا بیا بیا بیا بیا بیا بیا بیا بیا بیا بیا بیا بیا بیا بیا بیا بیا بیا بیا بیا بیا بیا بیا بیا بیا بیا ب"
    },
    {
      "id": 27,
      "start": 8240.0,
      "end": 8243.0,
      "formatted_start": "02:17:20.000",
      "formatted_end": "02:17:23.000",
      "text": "درسته باید دست آخورد و رو باید تبلیغ کنند"
    },
    {
      "id": 28,
      "start": 8243.0,
      "end": 8244.0,
      "formatted_start": "02:17:23.000",
      "formatted_end": "02:17:24.000",
      "text": "خوب؟"
    },
    {
      "id": 29,
      "start": 8244.0,
      "end": 8246.0,
      "formatted_start": "02:17:24.000",
      "formatted_end": "02:17:26.000",
      "text": "پنج شانده برگردش"
    },
    {
      "id": 30,
      "start": 8258.0,
      "end": 8260.0,
      "formatted_start": "02:17:38.000",
      "formatted_end": "02:17:40.000",
      "text": "خودم هم خوستش هست هست"
    },
    {
      "id": 31,
      "start": 8260.0,
      "end": 8262.0,
      "formatted_start": "02:17:40.000",
      "formatted_end": "02:17:42.000",
      "text": "میبینید اینجا شما بیوید باید خودتر برگردشون بگیرد"
    },
    {
      "id": 32,
      "start": 8262.0,
      "end": 8264.0,
      "formatted_start": "02:17:42.000",
      "formatted_end": "02:17:44.000",
      "text": "خوسته هست باید برگردشون"
    },
    {
      "id": 33,
      "start": 8265.0,
      "end": 8267.0,
      "formatted_start": "02:17:45.000",
      "formatted_end": "02:17:47.000",
      "text": "اینجا آشنا هستید که بیوی شده"
    },
    {
      "id": 34,
      "start": 8267.0,
      "end": 8269.0,
      "formatted_start": "02:17:47.000",
      "formatted_end": "02:17:49.000",
      "text": "این همه سروزی که تقنی کردیشی کشور داره"
    },
    {
      "id": 35,
      "start": 8271.0,
      "end": 8273.0,
      "formatted_start": "02:17:51.000",
      "formatted_end": "02:17:53.000",
      "text": "از دردونش 20 تفصیل داره"
    },
    {
      "id": 36,
      "start": 8273.0,
      "end": 8275.0,
      "formatted_start": "02:17:53.000",
      "formatted_end": "02:17:55.000",
      "text": "دردونش رو رنگ نورت برنگه نشون"
    },
    {
      "id": 37,
      "start": 8275.0,
      "end": 8277.0,
      "formatted_start": "02:17:55.000",
      "formatted_end": "02:17:57.000",
      "text": "این موتور هم که دردون درنگه"
    },
    {
      "id": 38,
      "start": 8277.0,
      "end": 8279.0,
      "formatted_start": "02:17:57.000",
      "formatted_end": "02:17:59.000",
      "text": "تقنی کنه"
    },
    {
      "id": 39,
      "start": 8279.0,
      "end": 8281.0,
      "formatted_start": "02:17:59.000",
      "formatted_end": "02:18:01.000",
      "text": "از این بچه ها"
    },
    {
      "id": 40,
      "start": 8281.0,
      "end": 8283.0,
      "formatted_start": "02:18:01.000",
      "formatted_end": "02:18:03.000",
      "text": "تو دوست دردون های ترنگه"
    },
    {
      "id": 41,
      "start": 8283.0,
      "end": 8285.0,
      "formatted_start": "02:18:03.000",
      "formatted_end": "02:18:05.000",
      "text": "20 درنگه درنگه"
    },
    {
      "id": 42,
      "start": 8285.0,
      "end": 8287.0,
      "formatted_start": "02:18:05.000",
      "formatted_end": "02:18:07.000",
      "text": "خب؟ یک"
    },
    {
      "id": 43,
      "start": 8287.0,
      "end": 8289.0,
      "formatted_start": "02:18:07.000",
      "formatted_end": "02:18:09.000",
      "text": "افراد هم بردن باشه"
    },
    {
      "id": 44,
      "start": 8289.0,
      "end": 8291.0,
      "formatted_start": "02:18:09.000",
      "formatted_end": "02:18:11.000",
      "text": "برنگ نورت"
    },
    {
      "id": 45,
      "start": 8291.0,
      "end": 8293.0,
      "formatted_start": "02:18:11.000",
      "formatted_end": "02:18:13.000",
      "text": "مرتبه ها چون همیشه"
    },
    {
      "id": 46,
      "start": 8293.0,
      "end": 8295.0,
      "formatted_start": "02:18:13.000",
      "formatted_end": "02:18:15.000",
      "text": "تقنی کنن یه ویروس میگیرن"
    },
    {
      "id": 47,
      "start": 8295.0,
      "end": 8300.0,
      "formatted_start": "02:18:15.000",
      "formatted_end": "02:18:20.000",
      "text": "حالا هم فرمانشی در طول هم دارن درم بیارن، مردم قبلن ها به این رفت بردن."
    },
    {
      "id": 48,
      "start": 8300.0,
      "end": 8302.0,
      "formatted_start": "02:18:20.000",
      "formatted_end": "02:18:22.000",
      "text": "بلی واقعا رفت ندارن."
    },
    {
      "id": 49,
      "start": 8302.0,
      "end": 8304.0,
      "formatted_start": "02:18:22.000",
      "formatted_end": "02:18:24.000",
      "text": "چون ویروس میگیره ترک کنن."
    },
    {
      "id": 50,
      "start": 8304.0,
      "end": 8305.0,
      "formatted_start": "02:18:24.000",
      "formatted_end": "02:18:25.000",
      "text": "خب؟"
    },
    {
      "id": 51,
      "start": 8305.0,
      "end": 8307.0,
      "formatted_start": "02:18:25.000",
      "formatted_end": "02:18:27.000",
      "text": "یا ویروسش چیه؟"
    },
    {
      "id": 52,
      "start": 8309.0,
      "end": 8314.0,
      "formatted_start": "02:18:29.000",
      "formatted_end": "02:18:34.000",
      "text": "یه ویروس دیگه که بهش میگم ویروس هرمانجی."
    },
    {
      "id": 53,
      "start": 8314.0,
      "end": 8323.0,
      "formatted_start": "02:18:34.000",
      "formatted_end": "02:18:43.000",
      "text": "یعنی میره تو گلو دنبال میزنه، در مثل دهندشون یا حتی در زود گردنشون محکمه دهندشون."
    },
    {
      "id": 54,
      "start": 8323.0,
      "end": 8335.0,
      "formatted_start": "02:18:43.000",
      "formatted_end": "02:18:55.000",
      "text": "این بخواهد همونه تر میکنند، گندر دارند، بخواهد همونه بیقرارند و بعد شما دیدید که دارو بهشون دارید که خوب شنند."
    },
    {
      "id": 55,
      "start": 8335.0,
      "end": 8340.0,
      "formatted_start": "02:18:55.000",
      "formatted_end": "02:19:00.000",
      "text": "سه با سو بی کشه معمولند. خب ببینید دارو ها چون من توضیح شده هستم. ببینید همونه."
    },
    {
      "id": 56,
      "start": 8340.0,
      "end": 8349.0,
      "formatted_start": "02:19:00.000",
      "formatted_end": "02:19:09.000",
      "text": "اولا که این رو به دارو خونه نشون بدهید که با این فرمول، فرمال دستازش را واسط درست کنند."
    },
    {
      "id": 57,
      "start": 8349.0,
      "end": 8351.0,
      "formatted_start": "02:19:09.000",
      "formatted_end": "02:19:11.000",
      "text": "آره که از این سیگرم"
    },
    {
      "id": 58,
      "start": 8351.0,
      "end": 8355.0,
      "formatted_start": "02:19:11.000",
      "formatted_end": "02:19:15.000",
      "text": "این را که از این سیگرم"
    },
    {
      "id": 59,
      "start": 8355.0,
      "end": 8357.0,
      "formatted_start": "02:19:15.000",
      "formatted_end": "02:19:17.000",
      "text": "این را از این سیگرم"
    },
    {
      "id": 60,
      "start": 8357.0,
      "end": 8361.0,
      "formatted_start": "02:19:17.000",
      "formatted_end": "02:19:21.000",
      "text": "یک کلوسیم را که از این سیگرم"
    },
    {
      "id": 61,
      "start": 8361.0,
      "end": 8363.0,
      "formatted_start": "02:19:21.000",
      "formatted_end": "02:19:23.000",
      "text": "خوب"
    },
    {
      "id": 62,
      "start": 8363.0,
      "end": 8365.0,
      "formatted_start": "02:19:23.000",
      "formatted_end": "02:19:25.000",
      "text": "خوب"
    },
    {
      "id": 63,
      "start": 8365.0,
      "end": 8367.0,
      "formatted_start": "02:19:25.000",
      "formatted_end": "02:19:27.000",
      "text": "از این سیگرم پیمون سنجور"
    },
    {
      "id": 64,
      "start": 8367.0,
      "end": 8369.0,
      "formatted_start": "02:19:27.000",
      "formatted_end": "02:19:29.000",
      "text": "پیمون سنجور"
    },
    {
      "id": 65,
      "start": 8369.0,
      "end": 8371.0,
      "formatted_start": "02:19:29.000",
      "formatted_end": "02:19:31.000",
      "text": "خوب"
    },
    {
      "id": 66,
      "start": 8371.0,
      "end": 8373.0,
      "formatted_start": "02:19:31.000",
      "formatted_end": "02:19:33.000",
      "text": "پس"
    },
    {
      "id": 67,
      "start": 8373.0,
      "end": 8375.0,
      "formatted_start": "02:19:33.000",
      "formatted_end": "02:19:35.000",
      "text": "کماده"
    },
    {
      "id": 68,
      "start": 8375.0,
      "end": 8377.0,
      "formatted_start": "02:19:35.000",
      "formatted_end": "02:19:37.000",
      "text": "زین اقصاد"
    },
    {
      "id": 69,
      "start": 8377.0,
      "end": 8380.0,
      "formatted_start": "02:19:37.000",
      "formatted_end": "02:19:40.000",
      "text": "و کماد دست ساره"
    },
    {
      "id": 70,
      "start": 8380.0,
      "end": 8383.0,
      "formatted_start": "02:19:40.000",
      "formatted_end": "02:19:43.000",
      "text": "هر دفعه یه بار داشتون کاری باید برده"
    },
    {
      "id": 71,
      "start": 8383.0,
      "end": 8384.0,
      "formatted_start": "02:19:43.000",
      "formatted_end": "02:19:44.000",
      "text": "یه بار داشتون کاری؟"
    },
    {
      "id": 72,
      "start": 8384.0,
      "end": 8385.0,
      "formatted_start": "02:19:44.000",
      "formatted_end": "02:19:45.000",
      "text": "یه بار داشتون کاری"
    },
    {
      "id": 73,
      "start": 8385.0,
      "end": 8386.0,
      "formatted_start": "02:19:45.000",
      "formatted_end": "02:19:46.000",
      "text": "آفراد، این هست"
    },
    {
      "id": 74,
      "start": 8386.0,
      "end": 8389.0,
      "formatted_start": "02:19:46.000",
      "formatted_end": "02:19:49.000",
      "text": "بعد بیدیم سراغ داروش"
    },
    {
      "id": 75,
      "start": 8389.0,
      "end": 8391.0,
      "formatted_start": "02:19:49.000",
      "formatted_end": "02:19:51.000",
      "text": "یه دارو براش نشنشن، نیوتادی"
    },
    {
      "id": 76,
      "start": 8391.0,
      "end": 8393.0,
      "formatted_start": "02:19:51.000",
      "formatted_end": "02:19:53.000",
      "text": "هر دوست دست ساره"
    },
    {
      "id": 77,
      "start": 8393.0,
      "end": 8395.0,
      "formatted_start": "02:19:53.000",
      "formatted_end": "02:19:55.000",
      "text": "دونی سی سی"
    },
    {
      "id": 78,
      "start": 8395.0,
      "end": 8397.0,
      "formatted_start": "02:19:55.000",
      "formatted_end": "02:19:57.000",
      "text": "یه دنار شربت فرامون"
    },
    {
      "id": 79,
      "start": 8397.0,
      "end": 8399.0,
      "formatted_start": "02:19:57.000",
      "formatted_end": "02:19:59.000",
      "text": "هر دوست دست ساره"
    },
    {
