      "end": 8165.0,
      "formatted_start": "02:16:03.000",
      "formatted_end": "02:16:05.000",
      "text": "چی اونو بگو؟"
    },
    {
      "id": 18,
      "start": 8165.0,
      "end": 8167.0,
      "formatted_start": "02:16:05.000",
      "formatted_end": "02:16:07.000",
      "text": "چی اونو بگو؟"
    },
    {
      "id": 19,
      "start": 8167.0,
      "end": 8169.0,
      "formatted_start": "02:16:07.000",
      "formatted_end": "02:16:09.000",
      "text": "چی اونو بگو؟"
    },
    {
      "id": 20,
      "start": 8169.0,
      "end": 8171.0,
      "formatted_start": "02:16:09.000",
      "formatted_end": "02:16:11.000",
      "text": "چی اونو بگو؟"
    },
    {
      "id": 21,
      "start": 8171.0,
      "end": 8181.0,
      "formatted_start": "02:16:11.000",
      "formatted_end": "02:16:21.000",
      "text": "موسیقی"
    },
    {
      "id": 22,
      "start": 8201.0,
      "end": 8205.0,
      "formatted_start": "02:16:41.000",
      "formatted_end": "02:16:45.000",
      "text": "باید شما ببرش بیرو من با مامانشون رو صحبت بکنم بعده بعد"
    },
    {
      "id": 23,
      "start": 8207.0,
      "end": 8208.0,
      "formatted_start": "02:16:47.000",
      "formatted_end": "02:16:48.000",
