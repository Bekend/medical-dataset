      "id": 1,
      "start": 8103.0,
      "end": 8133.0,
      "formatted_start": "02:15:03.000",
      "formatted_end": "02:15:33.000",
      "text": "بیا بیا بیا بیا بیا بیا بیا بیا بیا بیا بیا بیا بیا بیا بیا بیا بیا بیا بیا بیا بیا بیا بیا بیا بیا بیا بیا بیا بیا بیا بیا بیا بیا بیا بیا بیا بیا بیا بیا بیا بیا بیا بیا بیا بیا بیا بیا بیا بیا بیا بیا بیا بیا بیا بیا بیا بیا بیا بیا بیا بیا بیا بیا بیا بیا بیا بیا بیا بیا بیا بیا بیا بیا بیا بیا بیا بیا بیا بیا بیا بیا بیا بیا بیا بیا بیا بیا بیا بیا بیا بیا بیا بیا بیا بیا بیا بیا بیا بیا بیا بیا بیا بیا بیا بیا بیا بیا بیا بیا بیا بیا ب"
    },
    {
      "id": 2,
      "start": 8133.0,
      "end": 8135.0,
      "formatted_start": "02:15:33.000",
      "formatted_end": "02:15:35.000",
      "text": "از این وقت، این کار را بگیرم."
    },
    {
      "id": 3,
      "start": 8135.0,
      "end": 8137.0,
      "formatted_start": "02:15:35.000",
      "formatted_end": "02:15:37.000",
      "text": "این کار را بگیرم."
    },
    {
      "id": 4,
      "start": 8137.0,
      "end": 8139.0,
      "formatted_start": "02:15:37.000",
      "formatted_end": "02:15:39.000",
      "text": "این کار را بگیرم."
    },
    {
      "id": 5,
      "start": 8139.0,
      "end": 8141.0,
      "formatted_start": "02:15:39.000",
      "formatted_end": "02:15:41.000",
      "text": "یک لحظه بابایی. یک لحظه. یک لحظه."
    },
    {
      "id": 6,
      "start": 8141.0,
      "end": 8143.0,
      "formatted_start": "02:15:41.000",
      "formatted_end": "02:15:43.000",
      "text": "چون این بابایی."
    },
    {
      "id": 7,
      "start": 8143.0,
      "end": 8145.0,
      "formatted_start": "02:15:43.000",
      "formatted_end": "02:15:45.000",
      "text": "مردم در اینجا باید بردارید."
    },
