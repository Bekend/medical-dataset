  "stt_segments": [
    {
      "id": 0,
      "start": 6900.0,
      "end": 6909.0,
      "formatted_start": "01:55:00.000",
      "formatted_end": "01:55:09.000",
      "text": "اما من نهارش رو هم کرده بدم، یا مثلا صبح و یام، و شامل توره سبزی جاد باشه یا نه؟"
    },
    {
      "id": 1,
      "start": 6909.0,
      "end": 6920.0,
      "formatted_start": "01:55:09.000",
      "formatted_end": "01:55:20.000",
      "text": "من میگم مثلا صبحو نشو بهش فرمی هردوی بادون، طبقه با نهارش رو بشو، نهارش رو بشو صبحو بشو، شامل شامل شو بهش مثلا توره بدم."
    },
    {
      "id": 2,
      "start": 6950.0,
      "end": 6952.0,
      "formatted_start": "01:55:50.000",
      "formatted_end": "01:55:52.000",
      "text": "این دو ها رو داخل شیر خشکش باید کنید؟"
    },
    {
      "id": 3,
      "start": 6952.0,
      "end": 6954.0,
      "formatted_start": "01:55:52.000",
      "formatted_end": "01:55:54.000",
      "text": "نه عزیزم، خود رو باید کنید"
    },
    {
      "id": 4,
      "start": 6954.0,
      "end": 6956.0,
      "formatted_start": "01:55:54.000",
      "formatted_end": "01:55:56.000",
      "text": "با یک کلو"
    },
    {
      "id": 5,
      "start": 6956.0,
      "end": 6958.0,
      "formatted_start": "01:55:56.000",
      "formatted_end": "01:55:58.000",
      "text": "با یک کلو، میرزید تو شیر خشکش بشونید"
    },
    {
      "id": 6,
      "start": 6958.0,
      "end": 6960.0,
      "formatted_start": "01:55:58.000",
      "formatted_end": "01:56:00.000",
      "text": "تو غذا شب میتونید برزید"
    },
    {
      "id": 7,
      "start": 6960.0,
      "end": 6962.0,
      "formatted_start": "01:56:00.000",
      "formatted_end": "01:56:02.000",
      "text": "تو یک مثلا فقط تو چیز دام نرستید"
    },
    {
      "id": 8,
      "start": 6962.0,
      "end": 6964.0,
      "formatted_start": "01:56:02.000",
      "formatted_end": "01:56:04.000",
      "text": "تو ماست میتونید برزید"
    },
    {
      "id": 9,
      "start": 6964.0,
      "end": 6966.0,
      "formatted_start": "01:56:04.000",
      "formatted_end": "01:56:06.000",
      "text": "ماست بشونید برزید"
    },
    {
      "id": 10,
      "start": 6966.0,
      "end": 6968.0,
      "formatted_start": "01:56:06.000",
      "formatted_end": "01:56:08.000",
      "text": "چون آلرژی داره، یکم بیرونتر بشونید"
    },
    {
      "id": 11,
      "start": 6968.0,
      "end": 6970.0,
      "formatted_start": "01:56:08.000",
      "formatted_end": "01:56:10.000",
      "text": "زیدگیش هم پیروزید"
    },
    {
      "id": 12,
      "start": 6970.0,
      "end": 6972.0,
      "formatted_start": "01:56:10.000",
      "formatted_end": "01:56:12.000",
      "text": "ماست بشونید برزید"
    },
    {
      "id": 13,
      "start": 6972.0,
      "end": 6975.0,
      "formatted_start": "01:56:12.000",
      "formatted_end": "01:56:15.000",
      "text": "فقط تو چیزا دام نداری. تو ماست میتونی بریزی. ماست بشونی."
    },
    {
      "id": 14,
      "start": 6975.0,
      "end": 6976.0,
      "formatted_start": "01:56:15.000",
      "formatted_end": "01:56:16.000",
      "text": "نه."
    },
    {
      "id": 15,
      "start": 6976.0,
      "end": 6978.0,
      "formatted_start": "01:56:16.000",
      "formatted_end": "01:56:18.000",
      "text": "چون آلرژی داره یکم گیر سر بشونه."
    },
    {
      "id": 16,
      "start": 6978.0,
      "end": 6981.0,
      "formatted_start": "01:56:18.000",
      "formatted_end": "01:56:21.000",
      "text": "زنگشان که روزی ماستی بشونه بخونه دو ماست بشونه."
    },
    {
      "id": 17,
      "start": 6981.0,
      "end": 6983.0,
      "formatted_start": "01:56:21.000",
      "formatted_end": "01:56:23.000",
      "text": "بله زنگشان یعنی همجور انامه برن؟"
    },
    {
      "id": 18,
      "start": 6983.0,
      "end": 6985.0,
      "formatted_start": "01:56:23.000",
      "formatted_end": "01:56:25.000",
      "text": "انامه برن تا شیشهش خواهد بشه."
    },
    {
      "id": 19,
      "start": 6985.0,
      "end": 6986.0,
      "formatted_start": "01:56:25.000",
      "formatted_end": "01:56:26.000",
      "text": "ما چکره؟"
    },
    {
      "id": 20,
      "start": 6986.0,
      "end": 6988.0,
      "formatted_start": "01:56:26.000",
      "formatted_end": "01:56:28.000",
      "text": "ارمان شما خواهد برن."
    },
    {
      "id": 21,
      "start": 6990.0,
      "end": 6991.0,
      "formatted_start": "01:56:30.000",
      "formatted_end": "01:56:31.000",
      "text": "سلام."
    },
    {
      "id": 22,
      "start": 6991.0,
      "end": 6993.0,
      "formatted_start": "01:56:31.000",
      "formatted_end": "01:56:33.000",
      "text": "بله شما خوبستی؟ بفرمایید."
    },
    {
      "id": 23,
      "start": 6994.0,
      "end": 6995.0,
      "formatted_start": "01:56:34.000",
      "formatted_end": "01:56:35.000",
      "text": "سلام."
    },
    {
      "id": 24,
      "start": 6995.0,
      "end": 6996.0,
      "formatted_start": "01:56:35.000",
      "formatted_end": "01:56:36.000",
      "text": "ما سورپه اینجور شده."
    },
    {
      "id": 25,
      "start": 6996.0,
      "end": 6997.0,
      "formatted_start": "01:56:36.000",
      "formatted_end": "01:56:37.000",
      "text": "بله."
    },
    {
      "id": 26,
      "start": 6997.0,
      "end": 6999.0,
      "formatted_start": "01:56:37.000",
      "formatted_end": "01:56:39.000",
      "text": "خوب، چیز صرفی هست"
    },
    {
      "id": 27,
      "start": 6999.0,
      "end": 7001.0,
      "formatted_start": "01:56:39.000",
      "formatted_end": "01:56:41.000",
      "text": "صبح رو سریع خبر می کنی"
    },
    {
      "id": 28,
      "start": 7001.0,
      "end": 7003.0,
      "formatted_start": "01:56:41.000",
      "formatted_end": "01:56:43.000",
      "text": "باسته که می کنه، انا رو بگهاش گرگیر می شه"
    },
    {
      "id": 29,
      "start": 7003.0,
      "end": 7005.0,
      "formatted_start": "01:56:43.000",
      "formatted_end": "01:56:45.000",
      "text": "آره"
    },
    {
      "id": 30,
      "start": 7005.0,
      "end": 7007.0,
      "formatted_start": "01:56:45.000",
      "formatted_end": "01:56:47.000",
      "text": "خوب، یه چه بیچه بگیرم"
    },
    {
