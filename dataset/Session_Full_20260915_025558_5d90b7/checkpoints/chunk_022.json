      "start": 6853.76,
      "end": 6855.12,
      "formatted_start": "01:54:13.760",
      "formatted_end": "01:54:15.120",
      "text": "جان"
    },
    {
      "id": 74,
      "start": 6855.12,
      "end": 6855.76,
      "formatted_start": "01:54:15.120",
      "formatted_end": "01:54:15.760",
      "text": "اوه"
    },
    {
      "id": 75,
      "start": 6855.76,
      "end": 6857.4,
      "formatted_start": "01:54:15.760",
      "formatted_end": "01:54:17.400",
      "text": "زبونش قربی بود"
    },
    {
      "id": 76,
      "start": 6857.4,
      "end": 6857.9,
      "formatted_start": "01:54:17.400",
      "formatted_end": "01:54:17.900",
      "text": "خب؟"
    },
    {
      "id": 77,
      "start": 6857.9,
      "end": 6858.4,
      "formatted_start": "01:54:17.900",
      "formatted_end": "01:54:18.400",
      "text": "اوه"
    },
    {
      "id": 78,
      "start": 6858.4,
      "end": 6859.4,
      "formatted_start": "01:54:18.400",
      "formatted_end": "01:54:19.400",
      "text": "یه مدت احساسی بود"
    },
    {
      "id": 79,
      "start": 6859.4,
      "end": 6860.0,
      "formatted_start": "01:54:19.400",
      "formatted_end": "01:54:20.000",
      "text": "میبینید"
    },
    {
      "id": 80,
      "start": 6860.0,
      "end": 6860.56,
      "formatted_start": "01:54:20.000",
      "formatted_end": "01:54:20.560",
      "text": "الان"
    },
    {
      "id": 81,
      "start": 6860.56,
      "end": 6861.76,
      "formatted_start": "01:54:20.560",
      "formatted_end": "01:54:21.760",
      "text": "بهتر دیگه کنید"
    },
    {
      "id": 82,
      "start": 6861.76,
      "end": 6862.26,
      "formatted_start": "01:54:21.760",
      "formatted_end": "01:54:22.260",
      "text": "کنید"
    },
    {
      "id": 83,
      "start": 6862.26,
      "end": 6862.76,
      "formatted_start": "01:54:22.260",
      "formatted_end": "01:54:22.760",
      "text": "کنید"
    },
    {
      "id": 84,
      "start": 6862.76,
      "end": 6863.26,
      "formatted_start": "01:54:22.760",
      "formatted_end": "01:54:23.260",
