  "stt_segments": [
    {
      "id": 0,
      "start": 6600.0,
      "end": 6605.0,
      "formatted_start": "01:50:00.000",
      "formatted_end": "01:50:05.000",
      "text": "از این حاله، یک چند صدام سی سی بهش پنیسیلین زیر جرمی میزدن."
    },
    {
      "id": 1,
      "start": 6605.0,
      "end": 6609.0,
      "formatted_start": "01:50:05.000",
      "formatted_end": "01:50:09.000",
      "text": "هی میزدن، میزدن، میزدن، میزدن تا بچه از اون سهرش ازدهرده."
    },
    {
      "id": 2,
      "start": 6609.0,
      "end": 6614.0,
      "formatted_start": "01:50:09.000",
      "formatted_end": "01:50:14.000",
      "text": "بس برای غذا، شکل مهمه نیست؟"
    },
    {
      "id": 3,
      "start": 6614.0,
      "end": 6619.0,
      "formatted_start": "01:50:14.000",
      "formatted_end": "01:50:19.000",
      "text": "غذایی داری که اینها رو اضافه کنم، اینها، تا سی سهرش و اینها."
    },
    {
      "id": 4,
      "start": 6619.0,
      "end": 6624.0,
      "formatted_start": "01:50:19.000",
      "formatted_end": "01:50:24.000",
      "text": "بعد از اون دیگه من به این چیز اضافه نیست، همین گوجه ندادم و دیگه این مالات رو غذا میزنیم."
    },
    {
      "id": 5,
      "start": 6624.0,
      "end": 6625.0,
      "formatted_start": "01:50:24.000",
      "formatted_end": "01:50:25.000",
      "text": "حش ماهش ها دیگه؟"
    },
    {
      "id": 6,
      "start": 6625.0,
      "end": 6627.0,
      "formatted_start": "01:50:25.000",
      "formatted_end": "01:50:27.000",
      "text": "من دیگر لیری تر شروع کردم"
    },
    {
      "id": 7,
      "start": 6627.0,
      "end": 6630.0,
      "formatted_start": "01:50:27.000",
      "formatted_end": "01:50:30.000",
      "text": "خب ببین الان که هشت ماهشه طب مار کنی"
    },
    {
      "id": 8,
      "start": 6630.0,
      "end": 6632.0,
      "formatted_start": "01:50:30.000",
      "formatted_end": "01:50:32.000",
      "text": "اینو ها صبحونه بشنیم میرم خاندتو"
    },
    {
      "id": 9,
      "start": 6632.0,
      "end": 6635.0,
      "formatted_start": "01:50:32.000",
      "formatted_end": "01:50:35.000",
      "text": "این صبحونه شیر خوش کشو میشنیم"
    },
    {
      "id": 10,
      "start": 6635.0,
      "end": 6641.0,
      "formatted_start": "01:50:35.000",
      "formatted_end": "01:50:41.000",
      "text": "چون شیر خوش دیگر بیدارش شیر خوش کشو بشنیم"
    },
    {
      "id": 11,
      "start": 6641.0,
      "end": 6644.0,
      "formatted_start": "01:50:41.000",
      "formatted_end": "01:50:44.000",
      "text": "دیگر زور بهش غذا شو میدم"
    },
    {
      "id": 12,
      "start": 6644.0,
      "end": 6647.0,
      "formatted_start": "01:50:44.000",
      "formatted_end": "01:50:47.000",
      "text": "طب مار یه طب نیشنیم"
    },
    {
      "id": 13,
      "start": 6647.0,
      "end": 6649.0,
      "formatted_start": "01:50:47.000",
      "formatted_end": "01:50:49.000",
      "text": "بلد از ورده شوید کامل میدن؟"
    },
    {
      "id": 14,
      "start": 6649.0,
      "end": 6651.0,
      "formatted_start": "01:50:49.000",
      "formatted_end": "01:50:51.000",
      "text": "نه کامل"
    },
    {
      "id": 15,
      "start": 6651.0,
      "end": 6653.0,
      "formatted_start": "01:50:51.000",
      "formatted_end": "01:50:53.000",
      "text": "اینکه قبل اونو بسیار از ورده"
    },
    {
      "id": 16,
      "start": 6653.0,
      "end": 6654.0,
      "formatted_start": "01:50:53.000",
      "formatted_end": "01:50:54.000",
      "text": "الان میگم کامل"
    },
    {
      "id": 17,
      "start": 6654.0,
      "end": 6659.0,
      "formatted_start": "01:50:54.000",
      "formatted_end": "01:50:59.000",
      "text": "اینو بهش بده و بعد دیگه چیزی که میتونی روز بسایی سرلاک بهش بده"
    },
    {
      "id": 18,
      "start": 6659.0,
      "end": 6661.0,
      "formatted_start": "01:50:59.000",
      "formatted_end": "01:51:01.000",
      "text": "سمونه به جایی که شیر بده"
    },
    {
      "id": 19,
      "start": 6661.0,
      "end": 6662.0,
      "formatted_start": "01:51:01.000",
      "formatted_end": "01:51:02.000",
      "text": "سرلاک؟ نیرونی؟"
    },
    {
      "id": 20,
      "start": 6662.0,
      "end": 6665.0,
      "formatted_start": "01:51:02.000",
      "formatted_end": "01:51:05.000",
      "text": "سرلاک، آره سرلاک گندوم خورماش"
    },
    {
      "id": 21,
      "start": 6665.0,
      "end": 6667.0,
      "formatted_start": "01:51:05.000",
      "formatted_end": "01:51:07.000",
      "text": "یا گندوم..."
    },
    {
      "id": 22,
      "start": 6667.0,
      "end": 6669.0,
      "formatted_start": "01:51:07.000",
      "formatted_end": "01:51:09.000",
      "text": "هم ماجانا داره؟"
    },
    {
      "id": 23,
      "start": 6669.0,
      "end": 6672.0,
      "formatted_start": "01:51:09.000",
      "formatted_end": "01:51:12.000",
      "text": "نه نه، سرلاک هایی که قدره و جزر"
    },
    {
      "id": 24,
      "start": 6672.0,
      "end": 6674.0,
      "formatted_start": "01:51:12.000",
      "formatted_end": "01:51:14.000",
      "text": "مارک سرلاک، مارک شرکت نسلت"
    },
    {
      "id": 25,
      "start": 6674.0,
      "end": 6676.0,
      "formatted_start": "01:51:14.000",
      "formatted_end": "01:51:16.000",
      "text": "یعنی مارک شرکت شیر خوشک"
    },
    {
      "id": 26,
      "start": 6676.0,
      "end": 6677.0,
      "formatted_start": "01:51:16.000",
      "formatted_end": "01:51:17.000",
      "text": "بوتیو"
    },
    {
      "id": 27,
      "start": 6677.0,
      "end": 6678.0,
      "formatted_start": "01:51:17.000",
      "formatted_end": "01:51:18.000",
      "text": "آره بوتیو"
    },
    {
      "id": 28,
      "start": 6678.0,
      "end": 6680.0,
      "formatted_start": "01:51:18.000",
      "formatted_end": "01:51:20.000",
      "text": "سرلاک رو بهش بده"
    },
    {
      "id": 29,
      "start": 6680.0,
      "end": 6684.2,
      "formatted_start": "01:51:20.000",
      "formatted_end": "01:51:24.200",
      "text": "و میگم گند و کورماش خوشمزد و گندامش هم خوشمزد"
    },
    {
      "id": 30,
      "start": 6684.2,
      "end": 6687.2,
      "formatted_start": "01:51:24.200",
      "formatted_end": "01:51:27.200",
      "text": "باید گندام خالی گندام سیب هم میتونی بهش بدید"
    },
    {
      "id": 31,
      "start": 6687.2,
      "end": 6689.2,
      "formatted_start": "01:51:27.200",
      "formatted_end": "01:51:29.200",
      "text": "و دیگه میتونی کته بهش بدید"
    },
    {
      "id": 32,
      "start": 6689.2,
      "end": 6691.2,
      "formatted_start": "01:51:29.200",
      "formatted_end": "01:51:31.200",
      "text": "خب کته هایی خیلی خوبه"
    },
    {
      "id": 33,
      "start": 6691.2,
      "end": 6694.7,
      "formatted_start": "01:51:31.200",
      "formatted_end": "01:51:34.700",
      "text": "کته یه بار مثلا با شبیت بدید"
    },
    {
      "id": 34,
      "start": 6694.7,
      "end": 6696.7,
      "formatted_start": "01:51:34.700",
      "formatted_end": "01:51:36.700",
      "text": "یه روز کته رو با عدس بدید"
    },
    {
      "id": 35,
      "start": 6696.7,
      "end": 6698.7,
      "formatted_start": "01:51:36.700",
      "formatted_end": "01:51:38.700",
      "text": "یه روز کته رو با گویجه بدید"
    },
    {
      "id": 36,
      "start": 6698.7,
      "end": 6702.7,
      "formatted_start": "01:51:38.700",
      "formatted_end": "01:51:42.700",
      "text": "اینجا باید یکم از جهنش رو با نیمونه کنیم"
    },
    {
      "id": 37,
      "start": 6702.7,
      "end": 6732.7,
      "formatted_start": "01:51:42.700",
      "formatted_end": "01:52:12.700",
      "text": "بگیر بگیر بگیر بگیر بگیر بگیر بگیر بگیر بگیر بگیر بگیر بگیر بگیر بگیر بگیر بگیر بگیر بگیر بگیر بگیر بگیر بگیر بگیر بگیر بگیر بگیر بگیر بگیر بگیر بگیر بگیر بگیر بگیر بگیر بگیر بگیر بگیر بگیر بگیر بگیر بگیر بگیر بگیر بگیر بگیر بگیر بگیر بگیر بگیر بگیر بگیر بگیر بگیر بگیر بگیر بگی"
    },
    {
      "id": 38,
      "start": 6732.7,
      "end": 6735.2,
      "formatted_start": "01:52:12.700",
      "formatted_end": "01:52:15.200",
      "text": "خب دیگه از این به بعد میتونیم کار بکنیم"
    },
    {
      "id": 39,
      "start": 6735.2,
      "end": 6738.0,
      "formatted_start": "01:52:15.200",
      "formatted_end": "01:52:18.000",
      "text": "یا مثلا قطعه های انگشتی"
    },
    {
      "id": 40,
      "start": 6738.0,
      "end": 6739.2,
      "formatted_start": "01:52:18.000",
      "formatted_end": "01:52:19.200",
      "text": "مثل چی؟"
    },
    {
      "id": 41,
      "start": 6739.2,
      "end": 6740.7,
      "formatted_start": "01:52:19.200",
      "formatted_end": "01:52:20.700",
      "text": "مثلا سیبزمیل میشه"
    },
    {
      "id": 42,
      "start": 6740.7,
      "end": 6741.7,
      "formatted_start": "01:52:20.700",
      "formatted_end": "01:52:21.700",
      "text": "یه نیزه"
    },
    {
      "id": 43,
      "start": 6741.7,
      "end": 6744.2,
      "formatted_start": "01:52:21.700",
      "formatted_end": "01:52:24.200",
      "text": "آره، مثلا یکم فوره سیبزمیل رو سختر درست کن"
    },
    {
      "id": 44,
      "start": 6744.2,
      "end": 6745.7,
      "formatted_start": "01:52:24.200",
      "formatted_end": "01:52:25.700",
      "text": "گله گله پای جاشاش بچین"
    },
    {
      "id": 45,
      "start": 6745.7,
      "end": 6746.7,
      "formatted_start": "01:52:25.700",
      "formatted_end": "01:52:26.700",
      "text": "خب"
    },
    {
      "id": 46,
      "start": 6746.7,
      "end": 6751.7,
      "formatted_start": "01:52:26.700",
      "formatted_end": "01:52:31.700",
      "text": "میتونی مثلا با گوشت چرف کرده واسه قلقه ای درست کن"
    },
    {
      "id": 47,
      "start": 6751.7,
      "end": 6753.7,
      "formatted_start": "01:52:31.700",
      "formatted_end": "01:52:33.700",
      "text": "آره بعد من حالا به سوغانیان رو دارم"
    },
    {
      "id": 48,
      "start": 6753.7,
      "end": 6755.7,
      "formatted_start": "01:52:33.700",
      "formatted_end": "01:52:35.700",
      "text": "سوغ کردین که همون رو کنیم"
    },
    {
      "id": 49,
      "start": 6755.7,
      "end": 6757.7,
      "formatted_start": "01:52:35.700",
      "formatted_end": "01:52:37.700",
      "text": "نه، بیره احترام"
    },
    {
      "id": 50,
      "start": 6757.7,
      "end": 6762.7,
      "formatted_start": "01:52:37.700",
      "formatted_end": "01:52:42.700",
      "text": "اما مثلا میتونه سید لمبه رو یک بر سلوک کنی با لمبه مثلا جلوش بزاری دیدم"
    },
    {
      "id": 51,
      "start": 6762.7,
      "end": 6767.7,
      "formatted_start": "01:52:42.700",
      "formatted_end": "01:52:47.700",
      "text": "چیزایی نرمش میکنه اینها رو دیگه میتونه بخورن خب"
    },
    {
      "id": 52,
      "start": 6767.7,
      "end": 6772.7,
      "formatted_start": "01:52:47.700",
      "formatted_end": "01:52:52.700",
      "text": "بعد دیگه چی میخواستم بهت بگم میوه ها هم دیگه میتونم"
    },
    {
      "id": 53,
      "start": 6772.7,
      "end": 6776.7,
      "formatted_start": "01:52:52.700",
      "formatted_end": "01:52:56.700",
      "text": "من میبار کخترش میگنم چیزی خودمیدی"
    },
    {
      "id": 54,
      "start": 6776.7,
      "end": 6778.7,
      "formatted_start": "01:52:56.700",
      "formatted_end": "01:52:58.700",
      "text": "خب الان میگه خان بدن"
    },
    {
      "id": 55,
      "start": 6778.7,
      "end": 6779.7,
      "formatted_start": "01:52:58.700",
      "formatted_end": "01:52:59.700",
      "text": "خان بدن؟"
    },
    {
      "id": 56,
      "start": 6779.7,
      "end": 6782.7,
      "formatted_start": "01:52:59.700",
      "formatted_end": "01:53:02.700",
      "text": "الان میوه مثلا چیز خوبه؟"
    },
    {
      "id": 57,
      "start": 6782.7,
      "end": 6784.7,
      "formatted_start": "01:53:02.700",
      "formatted_end": "01:53:04.700",
      "text": "آبوکادو خوبه"
    },
    {
      "id": 58,
      "start": 6784.7,
      "end": 6800.7,
      "formatted_start": "01:53:04.700",
      "formatted_end": "01:53:20.700",
      "text": "اوکادو، شلیل، هلو، هندونه"
    },
    {
      "id": 59,
      "start": 6800.7,
      "end": 6830.7,
      "formatted_start": "01:53:20.700",
      "formatted_end": "01:53:50.700",
      "text": "این از این از این از این از این از این از این از این از این از این از این از این از این از این از این از این از این از این از این از این از این از این از این از این از این از این از این از این از این از این از این از این از این از این از این از این از این از این از این از این از این از این از این از این از این از این از این از این از این از این از این از این از این از این از این از این ا"
    },
    {
      "id": 60,
      "start": 6830.7,
      "end": 6834.08,
      "formatted_start": "01:53:50.700",
      "formatted_end": "01:53:54.080",
      "text": "برایش بریم این پود رو تو شیر خشکش بردی کن و بهش بده"
    },
    {
      "id": 61,
      "start": 6834.08,
      "end": 6835.32,
      "formatted_start": "01:53:54.080",
      "formatted_end": "01:53:55.320",
      "text": "خب روزی دوباره"
    },
    {
      "id": 62,
      "start": 6835.32,
      "end": 6836.98,
      "formatted_start": "01:53:55.320",
      "formatted_end": "01:53:56.980",
      "text": "الان که اصحاله"
    },
    {
      "id": 63,
      "start": 6836.98,
      "end": 6838.24,
      "formatted_start": "01:53:56.980",
      "formatted_end": "01:53:58.240",
      "text": "آره الان که اصحاله بگیر"
    },
    {
      "id": 64,
      "start": 6838.24,
      "end": 6841.48,
      "formatted_start": "01:53:58.240",
      "formatted_end": "01:54:01.480",
      "text": "اگر با این اصحالش خوب نشدیدید"
    },
    {
      "id": 65,
      "start": 6841.48,
      "end": 6843.4,
      "formatted_start": "01:54:01.480",
      "formatted_end": "01:54:03.400",
      "text": "همینجور مخاتش داره زیاد میشه"
    },
    {
      "id": 66,
      "start": 6843.4,
      "end": 6846.46,
      "formatted_start": "01:54:03.400",
      "formatted_end": "01:54:06.460",
      "text": "شیر خشکشو باید مخصوص بچه های اصحالی بدید"
    },
    {
      "id": 67,
      "start": 6846.46,
      "end": 6847.78,
      "formatted_start": "01:54:06.460",
      "formatted_end": "01:54:07.780",
      "text": "چون مخات همی جان شده"
    },
    {
      "id": 68,
      "start": 6847.78,
      "end": 6849.32,
      "formatted_start": "01:54:07.780",
      "formatted_end": "01:54:09.320",
      "text": "چیه الان بشه بدید؟"
    },
    {
      "id": 69,
      "start": 6849.32,
      "end": 6850.32,
      "formatted_start": "01:54:09.320",
      "formatted_end": "01:54:10.320",
      "text": "نامه اصحاله"
    },
    {
      "id": 70,
      "start": 6850.32,
      "end": 6850.84,
      "formatted_start": "01:54:10.320",
      "formatted_end": "01:54:10.840",
      "text": "نامه اصحاله"
    },
    {
      "id": 71,
      "start": 6850.84,
      "end": 6851.7,
      "formatted_start": "01:54:10.840",
      "formatted_end": "01:54:11.700",
      "text": "نامه اصحاله"
    },
    {
      "id": 72,
      "start": 6851.7,
      "end": 6853.76,
      "formatted_start": "01:54:11.700",
      "formatted_end": "01:54:13.760",
      "text": "نامه اصحاله"
    },
    {
