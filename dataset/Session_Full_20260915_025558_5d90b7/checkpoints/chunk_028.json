  "stt_segments": [
    {
      "id": 0,
      "start": 8400.0,
      "end": 8404.0,
      "formatted_start": "02:20:00.000",
      "formatted_end": "02:20:04.000",
      "text": "براش، کمی بود؟ پشت گویی بود. پشت گویی بود، چهار سیزی پشت گویی بود."
    },
    {
      "id": 1,
      "start": 8404.0,
      "end": 8413.0,
      "formatted_start": "02:20:04.000",
      "formatted_end": "02:20:13.000",
      "text": "با یه دونه براش قطره نباشتم، کروته، روزه ده قطره از این بشتم."
    },
    {
      "id": 2,
      "start": 8413.0,
      "end": 8420.0,
      "formatted_start": "02:20:13.000",
      "formatted_end": "02:20:20.000",
      "text": "همینطور پستسته اینجور به هر چی بشیدیم برامیره."
    },
    {
      "id": 3,
      "start": 8420.0,
      "end": 8426.0,
      "formatted_start": "02:20:20.000",
      "formatted_end": "02:20:26.000",
      "text": "این به خاطر اینکه خوشش نبیده و اوگو میزنه برامیره؟"
    },
    {
      "id": 4,
      "start": 8426.0,
      "end": 8427.0,
      "formatted_start": "02:20:26.000",
      "formatted_end": "02:20:27.000",
      "text": "آره."
    },
    {
      "id": 5,
      "start": 8427.0,
      "end": 8429.0,
      "formatted_start": "02:20:27.000",
      "formatted_end": "02:20:29.000",
      "text": "شیر خشکی یا شیر مرد؟"
    },
    {
      "id": 6,
      "start": 8429.0,
      "end": 8442.0,
      "formatted_start": "02:20:29.000",
      "formatted_end": "02:20:42.000",
      "text": "ببین این قطره رو برید داخل مثلا آق میده"
    },
    {
      "id": 7,
      "start": 8442.0,
      "end": 8444.0,
      "formatted_start": "02:20:42.000",
      "formatted_end": "02:20:44.000",
      "text": "آق بشه بره آق"
    },
    {
      "id": 8,
      "start": 8444.0,
      "end": 8445.0,
      "formatted_start": "02:20:44.000",
      "formatted_end": "02:20:45.000",
      "text": "آق نفران چی بشه بشه؟"
    },
    {
      "id": 9,
      "start": 8445.0,
      "end": 8446.0,
      "formatted_start": "02:20:45.000",
      "formatted_end": "02:20:46.000",
      "text": "آق میده نمیخوره"
    },
    {
      "id": 10,
      "start": 8446.0,
      "end": 8447.0,
      "formatted_start": "02:20:46.000",
      "formatted_end": "02:20:47.000",
      "text": "نمیخوره؟"
    },
    {
      "id": 11,
      "start": 8447.0,
      "end": 8448.0,
      "formatted_start": "02:20:47.000",
      "formatted_end": "02:20:48.000",
      "text": "نه خیلی برقبول"
    },
    {
      "id": 12,
      "start": 8448.0,
      "end": 8449.0,
      "formatted_start": "02:20:48.000",
      "formatted_end": "02:20:49.000",
      "text": "ماست میخوره؟"
    },
    {
      "id": 13,
      "start": 8449.0,
      "end": 8450.0,
      "formatted_start": "02:20:49.000",
      "formatted_end": "02:20:50.000",
      "text": "ماست؟"
    },
    {
      "id": 14,
      "start": 8450.0,
      "end": 8451.0,
      "formatted_start": "02:20:50.000",
      "formatted_end": "02:20:51.000",
      "text": "همینستش نرم"
    },
    {
      "id": 15,
      "start": 8451.0,
      "end": 8455.0,
      "formatted_start": "02:20:51.000",
      "formatted_end": "02:20:55.000",
      "text": "ببین توی ماست یا آق میده خیلی آق"
    },
    {
      "id": 16,
      "start": 8455.0,
      "end": 8456.0,
      "formatted_start": "02:20:55.000",
      "formatted_end": "02:20:56.000",
      "text": "خب؟"
    },
    {
      "id": 17,
      "start": 8456.0,
      "end": 8463.2,
      "formatted_start": "02:20:56.000",
      "formatted_end": "02:21:03.200",
      "text": "بعد نه او تازی نه هر دوست دستر دو و نیم سی سی این همی چون تو آمیبه آمیبه من منخواد"
    },
    {
      "id": 18,
      "start": 8463.2,
      "end": 8464.2,
      "formatted_start": "02:21:03.200",
      "formatted_end": "02:21:04.200",
      "text": "تو براش باید میخواد"
    },
    {
      "id": 19,
      "start": 8464.2,
      "end": 8468.2,
      "formatted_start": "02:21:04.200",
      "formatted_end": "02:21:08.200",
      "text": "خیلی برخواست میگم من شبه از من آمیبه"
    },
    {
      "id": 20,
      "start": 8468.2,
      "end": 8472.2,
      "formatted_start": "02:21:08.200",
      "formatted_end": "02:21:12.200",
      "text": "قطعه آهنگ رو بیتون میتونه میشه که اصلا نمیخونه"
    },
    {
      "id": 21,
      "start": 8472.2,
      "end": 8474.2,
      "formatted_start": "02:21:12.200",
      "formatted_end": "02:21:14.200",
      "text": "ای گواست"
    },
    {
      "id": 22,
      "start": 8474.2,
      "end": 8476.2,
      "formatted_start": "02:21:14.200",
      "formatted_end": "02:21:16.200",
      "text": "اصلا نمیخونه"
    },
    {
      "id": 23,
      "start": 8476.2,
      "end": 8478.2,
      "formatted_start": "02:21:16.200",
      "formatted_end": "02:21:18.200",
      "text": "تو میدم که"
    },
    {
      "id": 24,
      "start": 8478.2,
      "end": 8480.2,
      "formatted_start": "02:21:18.200",
      "formatted_end": "02:21:20.200",
      "text": "یک دیگه منی کشه"
    },
    {
      "id": 25,
      "start": 8480.2,
      "end": 8482.2,
      "formatted_start": "02:21:20.200",
      "formatted_end": "02:21:22.200",
      "text": "نمیخواد دلش نمیخواد"
    },
    {
      "id": 26,
      "start": 8482.2,
      "end": 8484.2,
      "formatted_start": "02:21:22.200",
      "formatted_end": "02:21:24.200",
      "text": "بله"
    },
    {
      "id": 27,
      "start": 8484.2,
      "end": 8489.2,
      "formatted_start": "02:21:24.200",
      "formatted_end": "02:21:29.200",
      "text": "خب، نه، یه قطعه آمینامی نیست، همین خوش مردم"
    },
    {
      "id": 28,
      "start": 8489.2,
      "end": 8490.2,
      "formatted_start": "02:21:29.200",
      "formatted_end": "02:21:30.200",
      "text": "با آخرین این آخرین"
    },
    {
      "id": 29,
      "start": 8490.2,
      "end": 8492.2,
      "formatted_start": "02:21:30.200",
      "formatted_end": "02:21:32.200",
      "text": "تا بعد پورتوالی نماشه؟"
    },
    {
      "id": 30,
      "start": 8492.2,
      "end": 8494.2,
      "formatted_start": "02:21:32.200",
      "formatted_end": "02:21:34.200",
      "text": "نه، پورتوالی نیست"
    },
    {
      "id": 31,
      "start": 8494.2,
      "end": 8496.2,
      "formatted_start": "02:21:34.200",
      "formatted_end": "02:21:36.200",
      "text": "با آنها مخالفه؟"
    },
    {
      "id": 32,
      "start": 8496.2,
      "end": 8500.2,
      "formatted_start": "02:21:36.200",
      "formatted_end": "02:21:40.200",
      "text": "این وطرش، آخرانی نیست"
    },
    {
      "id": 33,
      "start": 8503.2,
      "end": 8506.2,
      "formatted_start": "02:21:43.200",
      "formatted_end": "02:21:46.200",
      "text": "به خاطر این تبشبش بسیار نفرم دادن؟"
    },
    {
      "id": 34,
      "start": 8506.2,
      "end": 8507.2,
      "formatted_start": "02:21:46.200",
      "formatted_end": "02:21:47.200",
      "text": "امم"
    },
    {
      "id": 35,
      "start": 8507.2,
      "end": 8509.2,
      "formatted_start": "02:21:47.200",
      "formatted_end": "02:21:49.200",
      "text": "بعد یکستانیه نکشید، هر چه بود؟"
    },
    {
      "id": 36,
      "start": 8509.2,
      "end": 8511.2,
      "formatted_start": "02:21:49.200",
      "formatted_end": "02:21:51.200",
      "text": "شیاخ بذار نماشه"
    },
    {
      "id": 37,
      "start": 8511.2,
      "end": 8513.2,
      "formatted_start": "02:21:51.200",
      "formatted_end": "02:21:53.200",
      "text": "شیاخ بذار نماشه؟"
    },
    {
      "id": 38,
      "start": 8513.2,
      "end": 8518.2,
      "formatted_start": "02:21:53.200",
      "formatted_end": "02:21:58.200",
      "text": "اگر این رسان رو بخوره و بالا میاره، خوشیاب باید بزارید."
    },
    {
      "id": 39,
      "start": 8518.2,
      "end": 8520.2,
      "formatted_start": "02:21:58.200",
      "formatted_end": "02:22:00.200",
      "text": "کارش داریم."
    },
    {
      "id": 40,
      "start": 8521.2,
      "end": 8525.2,
      "formatted_start": "02:22:01.200",
      "formatted_end": "02:22:05.200",
      "text": "تا بعد یه بار اونجور شد. دوباره دیگه رو رشت دادم. بالا نیست."
    },
    {
      "id": 41,
      "start": 8525.2,
      "end": 8527.2,
      "formatted_start": "02:22:05.200",
      "formatted_end": "02:22:07.200",
      "text": "بالا نیست. بالا نیست."
    },
    {
      "id": 42,
      "start": 8532.2,
      "end": 8534.2,
      "formatted_start": "02:22:12.200",
      "formatted_end": "02:22:14.200",
      "text": "ببینم همه چیز رو شنه باشتم."
    },
    {
      "id": 43,
      "start": 8536.2,
      "end": 8539.2,
      "formatted_start": "02:22:16.200",
      "formatted_end": "02:22:19.200",
      "text": "در روشت یه رو ببینم کنم."
    },
    {
      "id": 44,
      "start": 8539.2,
      "end": 8541.2,
      "formatted_start": "02:22:19.200",
      "formatted_end": "02:22:21.200",
      "text": "اینجا باید برداری کنید."
    },
    {
      "id": 45,
      "start": 8541.2,
      "end": 8543.2,
      "formatted_start": "02:22:21.200",
      "formatted_end": "02:22:23.200",
      "text": "اینجا باید برداری کنید."
    },
    {
      "id": 46,
      "start": 8543.2,
      "end": 8545.2,
      "formatted_start": "02:22:23.200",
      "formatted_end": "02:22:25.200",
      "text": "اینجا باید برداری کنید."
    },
    {
      "id": 47,
      "start": 8545.2,
      "end": 8547.2,
      "formatted_start": "02:22:25.200",
      "formatted_end": "02:22:27.200",
      "text": "اینجا باید برداری کنید."
    },
    {
      "id": 48,
      "start": 8547.2,
      "end": 8549.2,
      "formatted_start": "02:22:27.200",
      "formatted_end": "02:22:29.200",
      "text": "اینجا باید برداری کنید."
    },
    {
      "id": 49,
      "start": 8549.2,
      "end": 8551.2,
      "formatted_start": "02:22:29.200",
      "formatted_end": "02:22:31.200",
      "text": "اینجا باید برداری کنید."
    },
    {
      "id": 50,
      "start": 8551.2,
      "end": 8553.2,
      "formatted_start": "02:22:31.200",
      "formatted_end": "02:22:33.200",
      "text": "اینجا باید برداری کنید."
    },
    {
      "id": 51,
      "start": 8553.2,
      "end": 8555.2,
      "formatted_start": "02:22:33.200",
      "formatted_end": "02:22:35.200",
      "text": "اینجا باید برداری کنید."
    },
    {
      "id": 52,
      "start": 8555.2,
      "end": 8557.2,
      "formatted_start": "02:22:35.200",
      "formatted_end": "02:22:37.200",
      "text": "اینجا باید برداری کنید."
    },
    {
      "id": 53,
      "start": 8557.2,
      "end": 8559.2,
      "formatted_start": "02:22:37.200",
      "formatted_end": "02:22:39.200",
      "text": "اینجا باید برداری کنید."
    },
    {
      "id": 54,
      "start": 8559.2,
      "end": 8561.2,
      "formatted_start": "02:22:39.200",
      "formatted_end": "02:22:41.200",
      "text": "اینجا باید برداری کنید."
    },
    {
      "id": 55,
      "start": 8561.2,
      "end": 8591.2,
      "formatted_start": "02:22:41.200",
      "formatted_end": "02:23:11.200",
      "text": "برنامه اینجا برنامه اینجا برنامه اینجا برنامه اینجا برنامه اینجا برنامه اینجا برنامه اینجا برنامه اینجا برنامه اینجا برنامه اینجا برنامه اینجا برنامه اینجا برنامه اینجا برنامه اینجا برنامه اینجا برنامه اینجا برنامه اینجا برنامه اینجا برنامه اینجا برنامه اینجا برنامه اینجا برنامه اینجا برنامه اینجا برنامه اینجا برنامه این"
    },
    {
      "id": 56,
      "start": 8591.2,
      "end": 8593.2,
      "formatted_start": "02:23:11.200",
      "formatted_end": "02:23:13.200",
      "text": "بنداری کنید؟ نه"
    },
    {
      "id": 57,
      "start": 8593.2,
      "end": 8595.2,
      "formatted_start": "02:23:13.200",
      "formatted_end": "02:23:15.200",
      "text": "خب بزرگ روش رو بیان میشون بکنید"
    },
    {
      "id": 58,
      "start": 8625.2,
      "end": 8630.38,
      "formatted_start": "02:23:45.200",
      "formatted_end": "02:23:50.380",
      "text": "ببین از دلیل آبی رو الان که رفت میخونه خب؟"
    },
    {
      "id": 59,
      "start": 8630.38,
      "end": 8633.62,
      "formatted_start": "02:23:50.380",
      "formatted_end": "02:23:53.620",
      "text": "یعنی الان هست همین الان هر نیم ساعت"
    },
    {
      "id": 60,
      "start": 8633.62,
      "end": 8636.12,
      "formatted_start": "02:23:53.620",
      "formatted_end": "02:23:56.120",
      "text": "سه پاک براش بزن"
    },
    {
      "id": 61,
      "start": 8636.12,
      "end": 8638.0,
      "formatted_start": "02:23:56.120",
      "formatted_end": "02:23:58.000",
      "text": "تا چهار بار"
    },
    {
      "id": 62,
      "start": 8638.0,
      "end": 8640.68,
      "formatted_start": "02:23:58.000",
      "formatted_end": "02:24:00.680",
      "text": "مثلا یک"
    },
    {
      "id": 63,
      "start": 8640.68,
      "end": 8642.22,
      "formatted_start": "02:24:00.680",
      "formatted_end": "02:24:02.220",
      "text": "یک و نیم"
    },
    {
      "id": 64,
      "start": 8642.22,
      "end": 8643.26,
      "formatted_start": "02:24:02.220",
      "formatted_end": "02:24:03.260",
      "text": "دو"
    },
    {
      "id": 65,
      "start": 8643.26,
      "end": 8644.3,
      "formatted_start": "02:24:03.260",
      "formatted_end": "02:24:04.300",
      "text": "دو نیم"
    },
    {
      "id": 66,
      "start": 8644.3,
      "end": 8645.48,
      "formatted_start": "02:24:04.300",
      "formatted_end": "02:24:05.480",
      "text": "خب چهار بار"
    },
    {
      "id": 67,
      "start": 8645.48,
      "end": 8648.04,
      "formatted_start": "02:24:05.480",
      "formatted_end": "02:24:08.040",
      "text": "بعدش بکن هر چهار ساعت"
    },
    {
      "id": 68,
      "start": 8648.04,
      "end": 8649.56,
      "formatted_start": "02:24:08.040",
      "formatted_end": "02:24:09.560",
      "text": "تا آخر شم"
    },
    {
      "id": 69,
      "start": 8649.56,
      "end": 8654.5,
      "formatted_start": "02:24:09.560",
      "formatted_end": "02:24:14.500",
      "text": "از فرد و دیگه صبح و از روشم"
    },
    {
      "id": 70,
      "start": 8654.5,
      "end": 8660.5,
      "formatted_start": "02:24:14.500",
      "formatted_end": "02:24:20.500",
      "text": "خب، اسپریه اینه تا رنجی براش نباشده هست."
    },
    {
      "id": 71,
      "start": 8660.5,
      "end": 8670.5,
      "formatted_start": "02:24:20.500",
      "formatted_end": "02:24:30.500",
      "text": "هر ۱۲ ساعت دوپاف، اسپریه سبز، این هم نگه داره خب، تا یک ساعت میتونی نگه دارید."
    },
    {
      "id": 72,
      "start": 8670.5,
      "end": 8676.5,
      "formatted_start": "02:24:30.500",
      "formatted_end": "02:24:36.500",
      "text": "این هم صبح رو، زبون رو، عصر رو، شب دوپاف."
    },
    {
      "id": 73,
      "start": 8676.5,
      "end": 8681.84,
      "formatted_start": "02:24:36.500",
      "formatted_end": "02:24:41.840",
      "text": "این گرسشا ملوکاسشا اصرها بخونه"
    },
    {
      "id": 74,
      "start": 8681.84,
      "end": 8685.5,
      "formatted_start": "02:24:41.840",
      "formatted_end": "02:24:45.500",
      "text": "این شربهشا شربه بخونه"
    },
    {
      "id": 75,
      "start": 8686.42,
      "end": 8691.5,
      "formatted_start": "02:24:46.420",
      "formatted_end": "02:24:51.500",
      "text": "این گرسشا"
    },
    {
      "id": 76,
      "start": 8692.06,
      "end": 8696.5,
      "formatted_start": "02:24:52.060",
      "formatted_end": "02:24:56.500",
      "text": "یکیه"
    },
    {
      "id": 77,
      "start": 8696.5,
      "end": 8697.92,
      "formatted_start": "02:24:56.500",
      "formatted_end": "02:24:57.920",
      "text": "تن کیلو بودی؟"
    },
    {
      "id": 78,
      "start": 8697.92,
      "end": 8698.58,
      "formatted_start": "02:24:57.920",
      "formatted_end": "02:24:58.580",
      "text": "بیست و پنجه"
    },
    {
      "id": 79,
      "start": 8698.58,
      "end": 8699.26,
      "formatted_start": "02:24:58.580",
      "formatted_end": "02:24:59.260",
      "text": "بیست و پنجه"
    }
