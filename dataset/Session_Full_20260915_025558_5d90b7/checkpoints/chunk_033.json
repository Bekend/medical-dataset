      "text": "از اینکه باید برگرده باشید."
    },
    {
      "id": 4,
      "start": 9908.0,
      "end": 9910.0,
      "formatted_start": "02:45:08.000",
      "formatted_end": "02:45:10.000",
      "text": "از اینکه باید برگرده باشید."
    },
    {
      "id": 5,
      "start": 9910.0,
      "end": 9912.0,
      "formatted_start": "02:45:10.000",
      "formatted_end": "02:45:12.000",
      "text": "از اینکه باید برگرده باشید."
    },
    {
      "id": 6,
      "start": 9912.0,
      "end": 9914.0,
      "formatted_start": "02:45:12.000",
      "formatted_end": "02:45:14.000",
      "text": "از اینکه باید برگرده باشید."
    },
    {
      "id": 7,
      "start": 9914.0,
      "end": 9916.0,
      "formatted_start": "02:45:14.000",
      "formatted_end": "02:45:16.000",
      "text": "از اینکه باید برگرده باشید."
    },
    {
      "id": 8,
      "start": 9916.0,
      "end": 9918.0,
      "formatted_start": "02:45:16.000",
      "formatted_end": "02:45:18.000",
      "text": "از اینکه باید برگرده باشید."
    },
    {
      "id": 9,
      "start": 9918.0,
      "end": 9922.5,
      "formatted_start": "02:45:18.000",
      "formatted_end": "02:45:22.500",
      "text": "خب بعد یکی برگرش رو رضا کنیم"
    },
    {
      "id": 10,
      "start": 9922.5,
      "end": 9925.0,
      "formatted_start": "02:45:22.500",
      "formatted_end": "02:45:25.000",
      "text": "اینا که همه عالی"
    },
    {
      "id": 11,
      "start": 9925.0,
      "end": 9930.0,
      "formatted_start": "02:45:25.000",
      "formatted_end": "02:45:30.000",
      "text": "کبتشو و گندشو و کلیهشو همه عالی"
    },
    {
      "id": 12,
      "start": 9930.0,
      "end": 9936.0,
      "formatted_start": "02:45:30.000",
      "formatted_end": "02:45:36.000",
      "text": "موسیقی"
    },
    {
      "id": 13,
      "start": 9936.0,
      "end": 9938.0,
      "formatted_start": "02:45:36.000",
      "formatted_end": "02:45:38.000",
      "text": "ویتامیدیشم خوبه"
    },
    {
      "id": 14,
      "start": 9938.0,
      "end": 9939.0,
      "formatted_start": "02:45:38.000",
      "formatted_end": "02:45:39.000",
      "text": "خوبه ویتامیدش؟"
    },
    {
      "id": 15,
      "start": 9939.0,
      "end": 9942.0,
      "formatted_start": "02:45:39.000",
      "formatted_end": "02:45:42.000",
      "text": "آره من تو بکنم باید مایل رو جدا بباشیم"
    },
    {
      "id": 16,
      "start": 9942.0,
      "end": 9946.0,
      "formatted_start": "02:45:42.000",
      "formatted_end": "02:45:46.000",
      "text": "من همیشه از دنیا اومد اولا کلی کلی کلی"
    },
    {
      "id": 17,
      "start": 9946.0,
      "end": 9948.0,
      "formatted_start": "02:45:46.000",
      "formatted_end": "02:45:48.000",
      "text": "اینجا هم دیمونکس شد"
    },
    {
      "id": 18,
      "start": 9948.0,
      "end": 9952.0,
      "formatted_start": "02:45:48.000",
      "formatted_end": "02:45:52.000",
      "text": "تابستانه افتاده می ساد و فت کردن تابستانه"
    },
    {
      "id": 19,
      "start": 9952.0,
      "end": 9954.0,
      "formatted_start": "02:45:52.000",
      "formatted_end": "02:45:54.000",
      "text": "آمنش خیلی کمی هست، کمپونش خیلی زیاده"
    },
    {
      "id": 20,
      "start": 9954.0,
      "end": 9956.0,
      "formatted_start": "02:45:54.000",
      "formatted_end": "02:45:56.000",
      "text": "خیلی زیاد نه ولی خب داره بگیر"
    },
    {
      "id": 21,
      "start": 9956.0,
      "end": 9962.0,
      "formatted_start": "02:45:56.000",
      "formatted_end": "02:46:02.000",
      "text": "ما کمپونه خیلی شدید داریم، متوسط داریم، خفیده مالی متوسط داریم"
    },
    {
      "id": 22,
      "start": 9962.0,
      "end": 9966.0,
      "formatted_start": "02:46:02.000",
      "formatted_end": "02:46:06.000",
      "text": "خب از این بی حالی و بدقلی ها که زیر ممکنه یا خواهی میکنه"
    },
    {
      "id": 23,
      "start": 9966.0,
      "end": 9968.0,
      "formatted_start": "02:46:06.000",
      "formatted_end": "02:46:08.000",
      "text": "آره آره، ممکنه با خاطر این باشه"
    },
    {
      "id": 24,
      "start": 9968.0,
      "end": 9970.0,
      "formatted_start": "02:46:08.000",
      "formatted_end": "02:46:10.000",
      "text": "یه شرفت براش بینیم بسن"
    },
    {
      "id": 25,
      "start": 9970.0,
      "end": 9972.0,
      "formatted_start": "02:46:10.000",
      "formatted_end": "02:46:12.000",
      "text": "فر و گروبین پلاس"
    },
    {
      "id": 26,
      "start": 9972.0,
      "end": 9974.0,
      "formatted_start": "02:46:12.000",
      "formatted_end": "02:46:14.000",
      "text": "بله"
    },
    {
      "id": 27,
      "start": 9974.0,
      "end": 9976.0,
      "formatted_start": "02:46:14.000",
      "formatted_end": "02:46:16.000",
      "text": "روزی ده سی سی بهش بده"
    },
    {
      "id": 28,
      "start": 9976.0,
      "end": 9978.0,
      "formatted_start": "02:46:16.000",
      "formatted_end": "02:46:18.000",
      "text": "چه موقعی بدن کنه؟"
    },
    {
      "id": 29,
      "start": 9978.0,
      "end": 9980.0,
      "formatted_start": "02:46:18.000",
      "formatted_end": "02:46:20.000",
      "text": "ببین اینا چه زهر"
    },
    {
      "id": 30,
      "start": 9980.0,
      "end": 9982.0,
      "formatted_start": "02:46:20.000",
      "formatted_end": "02:46:22.000",
      "text": "بهترین موقع مثلا قبل خواب"
    },
    {
      "id": 31,
      "start": 9982.0,
      "end": 9984.0,
      "formatted_start": "02:46:22.000",
      "formatted_end": "02:46:24.000",
      "text": "قبل خواب"
    },
    {
      "id": 32,
      "start": 9984.0,
      "end": 9986.0,
      "formatted_start": "02:46:24.000",
      "formatted_end": "02:46:26.000",
      "text": "اصلا بعدشان بکنی یه ساعت بعدشان"
    },
    {
      "id": 33,
      "start": 9986.0,
      "end": 9988.0,
      "formatted_start": "02:46:26.000",
      "formatted_end": "02:46:28.000",
      "text": "آره بشه"
    },
    {
      "id": 34,
      "start": 9988.0,
      "end": 9990.0,
      "formatted_start": "02:46:28.000",
      "formatted_end": "02:46:30.000",
      "text": "بعد یه دونه هم"
    },
    {
      "id": 35,
      "start": 9994.0,
      "end": 9996.0,
      "formatted_start": "02:46:34.000",
      "formatted_end": "02:46:36.000",
      "text": "بطره"
    },
    {
      "id": 36,
      "start": 9996.0,
      "end": 9998.0,
      "formatted_start": "02:46:36.000",
      "formatted_end": "02:46:38.000",
      "text": "دی ایچ ای"
    },
    {
      "id": 37,
      "start": 9998.0,
      "end": 10007.0,
      "formatted_start": "02:46:38.000",
      "formatted_end": "02:46:47.000",
      "text": "این درهای شده خیلی خوبه هم تمرکزش رو خوب میکنه هم اصابش رو راحت میکنه"
    },
    {
      "id": 38,
      "start": 10007.0,
      "end": 10011.0,
      "formatted_start": "02:46:47.000",
      "formatted_end": "02:46:51.000",
      "text": "در خامدادتر برای پسر بزرگ همه خوبه این چیزی خیلی میگی؟"
    },
    {
      "id": 39,
      "start": 10011.0,
      "end": 10012.0,
      "formatted_start": "02:46:51.000",
      "formatted_end": "02:46:52.000",
      "text": "آره آره"
    },
    {
      "id": 40,
      "start": 10012.0,
      "end": 10013.0,
      "formatted_start": "02:46:52.000",
      "formatted_end": "02:46:53.000",
      "text": "برای اون هم مثلا بگیرین هم؟"
    },
    {
      "id": 41,
      "start": 10013.0,
      "end": 10015.0,
      "formatted_start": "02:46:53.000",
      "formatted_end": "02:46:55.000",
      "text": "روزی رو سی سی رو بگیرم"
    },
    {
      "id": 42,
      "start": 10015.0,
      "end": 10016.0,
      "formatted_start": "02:46:55.000",
      "formatted_end": "02:46:56.000",
      "text": "ده سی سی ما تونی؟"
    },
    {
      "id": 43,
      "start": 10016.0,
      "end": 10019.0,
      "formatted_start": "02:46:56.000",
      "formatted_end": "02:46:59.000",
      "text": "آه اینو میگی پراهولو بینو میگی"
    },
    {
      "id": 44,
      "start": 10019.0,
      "end": 10022.0,
      "formatted_start": "02:46:59.000",
      "formatted_end": "02:47:02.000",
      "text": "آه فقط پایینی رو بیدم برای پسر بزرگم؟"
    },
    {
      "id": 45,
      "start": 10022.0,
      "end": 10025.0,
      "formatted_start": "02:47:02.000",
      "formatted_end": "02:47:05.000",
      "text": "آه پسر بزرگش مشتونیم چند تا بشم؟"
    },
    {
      "id": 46,
      "start": 10025.0,
      "end": 10028.0,
      "formatted_start": "02:47:05.000",
      "formatted_end": "02:47:08.000",
      "text": "اون اول رفتهش تو نه سال دیده میده کلاسه واقع"
    },
    {
      "id": 47,
      "start": 10028.0,
      "end": 10029.0,
      "formatted_start": "02:47:08.000",
      "formatted_end": "02:47:09.000",
      "text": "نه سال؟"
    },
    {
      "id": 48,
      "start": 10029.0,
      "end": 10030.0,
      "formatted_start": "02:47:09.000",
      "formatted_end": "02:47:10.000",
      "text": "آره"
    },
    {
      "id": 49,
      "start": 10030.0,
      "end": 10032.0,
      "formatted_start": "02:47:10.000",
      "formatted_end": "02:47:12.000",
      "text": "اون رو فکر کنید ایمونه استرادی بهترن"
    },
    {
      "id": 50,
      "start": 10032.0,
      "end": 10034.0,
      "formatted_start": "02:47:12.000",
      "formatted_end": "02:47:14.000",
      "text": "کافیه سرحال هم خدا شد"
    },
    {
      "id": 51,
      "start": 10034.0,
      "end": 10037.0,
      "formatted_start": "02:47:14.000",
      "formatted_end": "02:47:17.000",
      "text": "اون دو همین که نوشتین چی بشه بدم؟"
    },
    {
      "id": 52,
      "start": 10037.0,
      "end": 10038.0,
      "formatted_start": "02:47:17.000",
      "formatted_end": "02:47:18.000",
      "text": "اینو بشه بشه"
    },
    {
      "id": 53,
      "start": 10038.0,
      "end": 10047.0,
      "formatted_start": "02:47:18.000",
      "formatted_end": "02:47:27.000",
      "text": "این برای بچه که مدرسه میرن و برای خوش و حافظه و نمیدونم آرامش و ایناشون تمرکز و اینا خیلی خوبه"
    },
    {
      "id": 54,
      "start": 10047.0,
      "end": 10051.0,
      "formatted_start": "02:47:27.000",
      "formatted_end": "02:47:31.000",
      "text": "خب سیده میشه اینو برام بینیسیون میخوام دوتا بدیدم"
    },
    {
      "id": 55,
      "start": 10051.0,
      "end": 10053.0,
      "formatted_start": "02:47:31.000",
      "formatted_end": "02:47:33.000",
      "text": "باید باید بزنیم که این شکل را بزنیم"
    },
    {
      "id": 56,
      "start": 10053.0,
      "end": 10055.0,
      "formatted_start": "02:47:33.000",
      "formatted_end": "02:47:35.000",
      "text": "از این شکل را بزنیم"
    },
    {
      "id": 57,
      "start": 10055.0,
      "end": 10057.0,
      "formatted_start": "02:47:35.000",
      "formatted_end": "02:47:37.000",
      "text": "از این شکل را بزنیم"
    },
    {
      "id": 58,
      "start": 10057.0,
      "end": 10059.0,
      "formatted_start": "02:47:37.000",
      "formatted_end": "02:47:39.000",
      "text": "از این شکل را بزنیم"
    },
    {
      "id": 59,
      "start": 10059.0,
      "end": 10061.0,
      "formatted_start": "02:47:39.000",
      "formatted_end": "02:47:41.000",
      "text": "از این شکل را بزنیم"
    },
    {
      "id": 60,
      "start": 10061.0,
      "end": 10063.0,
      "formatted_start": "02:47:41.000",
      "formatted_end": "02:47:43.000",
      "text": "از این شکل را بزنیم"
    },
    {
      "id": 61,
      "start": 10063.0,
      "end": 10065.0,
      "formatted_start": "02:47:43.000",
      "formatted_end": "02:47:45.000",
      "text": "از این شکل را بزنیم"
    },
    {
      "id": 62,
      "start": 10065.0,
      "end": 10067.0,
      "formatted_start": "02:47:45.000",
      "formatted_end": "02:47:47.000",
      "text": "از این شکل را بزنیم"
    },
    {
      "id": 63,
      "start": 10067.0,
      "end": 10069.0,
      "formatted_start": "02:47:47.000",
      "formatted_end": "02:47:49.000",
      "text": "از این شکل را بزنیم"
    },
    {
      "id": 64,
      "start": 10069.0,
      "end": 10071.0,
      "formatted_start": "02:47:49.000",
      "formatted_end": "02:47:51.000",
      "text": "از این شکل را بزنیم"
    },
    {
      "id": 65,
      "start": 10071.0,
      "end": 10073.0,
      "formatted_start": "02:47:51.000",
      "formatted_end": "02:47:53.000",
      "text": "از این شکل را بزنیم"
    },
    {
      "id": 66,
      "start": 10073.0,
      "end": 10075.0,
      "formatted_start": "02:47:53.000",
      "formatted_end": "02:47:55.000",
      "text": "از این شکل را بزنیم"
    },
    {
      "id": 67,
      "start": 10075.0,
      "end": 10077.0,
      "formatted_start": "02:47:55.000",
      "formatted_end": "02:47:57.000",
      "text": "از این شکل را بزنیم"
    },
    {
      "id": 68,
      "start": 10077.0,
      "end": 10079.0,
      "formatted_start": "02:47:57.000",
      "formatted_end": "02:47:59.000",
      "text": "همین هیچ مشکلی نداره"
    },
    {
      "id": 69,
      "start": 10079.0,
      "end": 10081.0,
      "formatted_start": "02:47:59.000",
      "formatted_end": "02:48:01.000",
      "text": "بیمی خوبی نداره"
    },
    {
      "id": 70,
      "start": 10081.0,
      "end": 10083.0,
      "formatted_start": "02:48:01.000",
      "formatted_end": "02:48:03.000",
      "text": "بیمی کوسر خیلی خوبه"
    },
    {
      "id": 71,
      "start": 10083.0,
      "end": 10085.0,
      "formatted_start": "02:48:03.000",
      "formatted_end": "02:48:05.000",
      "text": "بابا متخصص به نسخه دیگه"
    },
    {
      "id": 72,
      "start": 10085.0,
      "end": 10089.0,
      "formatted_start": "02:48:05.000",
      "formatted_end": "02:48:09.000",
      "text": "من باید نسخه دوتا رو تا حالا اینجوری نگرفت"
    },
    {
      "id": 73,
      "start": 10089.0,
      "end": 10091.0,
      "formatted_start": "02:48:09.000",
      "formatted_end": "02:48:11.000",
      "text": "دوتا نسخه نگرفتم"
    },
    {
      "id": 74,
      "start": 10091.0,
      "end": 10093.0,
      "formatted_start": "02:48:11.000",
      "formatted_end": "02:48:13.000",
      "text": "حالا اون تصورتن بوده؟"
    },
    {
      "id": 75,
      "start": 10093.0,
      "end": 10095.0,
      "formatted_start": "02:48:13.000",
      "formatted_end": "02:48:15.000",
      "text": "خود رجملی شد"
    },
    {
      "id": 76,
      "start": 10095.0,
      "end": 10097.0,
      "formatted_start": "02:48:15.000",
      "formatted_end": "02:48:17.000",
      "text": "تا حالا این مدلی نگرفتن"
    },
    {
      "id": 77,
      "start": 10097.0,
      "end": 10099.0,
      "formatted_start": "02:48:17.000",
      "formatted_end": "02:48:19.000",
      "text": "این درصد باید نسخه دوتا داره"
    },
    {
      "id": 78,
      "start": 10099.0,
      "end": 10101.0,
      "formatted_start": "02:48:19.000",
      "formatted_end": "02:48:21.000",
      "text": "فهم دادم هر آه هی بوده این مدل سندا"
    },
    {
      "id": 79,
      "start": 10101.0,
      "end": 10103.0,
      "formatted_start": "02:48:21.000",
      "formatted_end": "02:48:23.000",
      "text": "اینو میدونم"
    },
    {
      "id": 80,
      "start": 10103.0,
      "end": 10105.0,
      "formatted_start": "02:48:23.000",
      "formatted_end": "02:48:25.000",
      "text": "برای اونم بیده است"
    },
    {
      "id": 81,
      "start": 10105.0,
      "end": 10115.72,
      "formatted_start": "02:48:25.000",
      "formatted_end": "02:48:35.720",
      "text": "بخوام دکتر اینو تامون کرد دوباره ببرم دکتر از اگه اینجا بودن بیمیرم ششون هایی رفتم شهرمون"
    },
    {
      "id": 82,
      "start": 10115.72,
      "end": 10116.34,
      "formatted_start": "02:48:35.720",
      "formatted_end": "02:48:36.340",
      "text": "نه"
    },
    {
      "id": 83,
      "start": 10116.34,
      "end": 10118.32,
      "formatted_start": "02:48:36.340",
      "formatted_end": "02:48:38.320",
      "text": "اون دو ماه"
    },
    {
      "id": 84,
      "start": 10118.32,
      "end": 10119.44,
      "formatted_start": "02:48:38.320",
      "formatted_end": "02:48:39.440",
      "text": "ده ماه بده دوباره بگیر"
    },
    {
      "id": 85,
      "start": 10119.44,
      "end": 10123.56,
      "formatted_start": "02:48:39.440",
      "formatted_end": "02:48:43.560",
      "text": "این برای آهنه پسر هم میگم"
    },
    {
      "id": 86,
      "start": 10123.56,
      "end": 10126.28,
      "formatted_start": "02:48:43.560",
      "formatted_end": "02:48:46.280",
      "text": "میگم ده سه ماه برای ببین"
    },
    {
      "id": 87,
      "start": 10126.28,
      "end": 10126.98,
      "formatted_start": "02:48:46.280",
      "formatted_end": "02:48:46.980",
      "text": "خب"
    },
    {
      "id": 88,
      "start": 10126.98,
      "end": 10128.88,
      "formatted_start": "02:48:46.980",
      "formatted_end": "02:48:48.880",
      "text": "خب سه ماه تموم شد آزماش بگیرم"
    },
    {
      "id": 89,
      "start": 10128.88,
      "end": 10133.96,
      "formatted_start": "02:48:48.880",
      "formatted_end": "02:48:53.960",
      "text": "سه ماه تموم شد آزمایش آره این آزماش بگیرم"
    },
    {
      "id": 90,
      "start": 10133.96,
      "end": 10135.96,
      "formatted_start": "02:48:53.960",
      "formatted_end": "02:48:55.960",
      "text": "اگر نیاز بود دوباره بگیرم"
    },
    {
      "id": 91,
      "start": 10135.96,
      "end": 10137.96,
      "formatted_start": "02:48:55.960",
      "formatted_end": "02:48:57.960",
      "text": "آره"
    },
    {
      "id": 92,
      "start": 10143.96,
      "end": 10145.96,
      "formatted_start": "02:49:03.960",
      "formatted_end": "02:49:05.960",
      "text": "ده سی سی بفتید این دو گومی که بفتید خیلی خوبه"
    },
    {
      "id": 93,
      "start": 10145.96,
      "end": 10147.96,
      "formatted_start": "02:49:05.960",
      "formatted_end": "02:49:07.960",
      "text": "یک سی سی"
    },
    {
      "id": 94,
      "start": 10147.96,
      "end": 10149.96,
      "formatted_start": "02:49:07.960",
      "formatted_end": "02:49:09.960",
      "text": "یک سی سی برای جفتشون؟"
    },
    {
      "id": 95,
      "start": 10149.96,
      "end": 10151.96,
      "formatted_start": "02:49:09.960",
      "formatted_end": "02:49:11.960",
      "text": "یک سی سی"
    },
    {
      "id": 96,
      "start": 10151.96,
      "end": 10153.96,
      "formatted_start": "02:49:11.960",
      "formatted_end": "02:49:13.960",
      "text": "یک سی سی یک قطره میشه"
    },
    {
      "id": 97,
      "start": 10153.96,
      "end": 10155.96,
      "formatted_start": "02:49:13.960",
      "formatted_end": "02:49:15.960",
      "text": "یک قطره ها ببین قطره ها"
    },
    {
      "id": 98,
      "start": 10155.96,
      "end": 10157.96,
      "formatted_start": "02:49:15.960",
      "formatted_end": "02:49:17.960",
      "text": "یک سی سی یک قطره جفتون فرمشه"
    },
    {
      "id": 99,
      "start": 10157.96,
      "end": 10159.96,
      "formatted_start": "02:49:17.960",
      "formatted_end": "02:49:19.960",
      "text": "آره"
    },
    {
      "id": 100,
      "start": 10159.96,
      "end": 10161.96,
      "formatted_start": "02:49:19.960",
      "formatted_end": "02:49:21.960",
      "text": "ببین قطره ها معمولا قدیفتر از شهرتون دهید"
    },
    {
      "id": 101,
      "start": 10161.96,
      "end": 10169.96,
      "formatted_start": "02:49:21.960",
      "formatted_end": "02:49:29.960",
      "text": "از این از این"
    },
    {
      "id": 102,
      "start": 10169.96,
      "end": 10171.96,
      "formatted_start": "02:49:29.960",
      "formatted_end": "02:49:31.960",
      "text": "وقتی این آیهان"
    },
    {
      "id": 103,
      "start": 10171.96,
      "end": 10173.96,
      "formatted_start": "02:49:31.960",
      "formatted_end": "02:49:33.960",
      "text": "آهنو دادن دیده ایمونست نداره"
    },
    {
      "id": 104,
      "start": 10173.96,
      "end": 10175.96,
      "formatted_start": "02:49:33.960",
      "formatted_end": "02:49:35.960",
      "text": "مثلا از این ایمونستو شروع کن"
    },
    {
      "id": 105,
      "start": 10175.96,
      "end": 10177.96,
      "formatted_start": "02:49:35.960",
      "formatted_end": "02:49:37.960",
      "text": "ایمونست نداره درسته تداخل داره"
    },
    {
      "id": 106,
      "start": 10177.96,
      "end": 10179.96,
      "formatted_start": "02:49:37.960",
      "formatted_end": "02:49:39.960",
      "text": "نه تداخل نداره"
    },
    {
      "id": 107,
      "start": 10179.96,
      "end": 10181.96,
      "formatted_start": "02:49:39.960",
      "formatted_end": "02:49:41.960",
      "text": "اونو مثلا یه روز درمیون دو روز درمیون باشه"
    },
    {
      "id": 108,
      "start": 10181.96,
      "end": 10183.96,
      "formatted_start": "02:49:41.960",
      "formatted_end": "02:49:43.960",
      "text": "هر روز دیگه نداره"
    },
    {
      "id": 109,
      "start": 10183.96,
      "end": 10185.96,
      "formatted_start": "02:49:43.960",
      "formatted_end": "02:49:45.960",
      "text": "باید تو بگو میتونی تداخل داره؟"
    },
    {
      "id": 110,
      "start": 10185.96,
      "end": 10187.96,
      "formatted_start": "02:49:45.960",
      "formatted_end": "02:49:47.960",
      "text": "نه با همه تداخل داره"
    },
    {
      "id": 111,
      "start": 10187.96,
      "end": 10189.96,
      "formatted_start": "02:49:47.960",
      "formatted_end": "02:49:49.960",
      "text": "پس ایمونستو بگیرم میتونم هر دو روز ایمونستو بشونم"
    },
    {
      "id": 112,
      "start": 10189.96,
      "end": 10191.96,
      "formatted_start": "02:49:49.960",
      "formatted_end": "02:49:51.960",
      "text": "کنید که باید بردارید"
    },
    {
      "id": 113,
      "start": 10191.96,
      "end": 10193.96,
      "formatted_start": "02:49:51.960",
      "formatted_end": "02:49:53.960",
      "text": "دویست و دو"
    },
    {
      "id": 114,
      "start": 10193.96,
      "end": 10195.96,
      "formatted_start": "02:49:53.960",
      "formatted_end": "02:49:55.960",
      "text": "دویست و سیزه"
    },
    {
      "id": 115,
      "start": 10195.96,
      "end": 10197.96,
      "formatted_start": "02:49:55.960",
      "formatted_end": "02:49:57.960",
      "text": "شهست و سه نوارده اید"
    }
  ],
  "status": "completed"
}