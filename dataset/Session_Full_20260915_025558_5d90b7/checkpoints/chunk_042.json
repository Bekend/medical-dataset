  "stt_segments": [
    {
      "id": 0,
      "start": 12600.0,
      "end": 12630.0,
      "formatted_start": "03:30:00.000",
      "formatted_end": "03:30:30.000",
      "text": "از این از از از از از از از از از از از از از از از از از از از از از از از از از از از از از از از از از از از از از از از از از از از از از از از از از از از از از از از از از از از از از از از از از از از از از از از از از از از از از از از از از از از از از از از از از از از از از از از از از از از از از از از از از از از از از ا"
    },
    {
      "id": 1,
      "start": 12630.0,
      "end": 12633.0,
      "formatted_start": "03:30:30.000",
      "formatted_end": "03:30:33.000",
      "text": "چیزای شانسی هم هست دیگه"
    },
    {
      "id": 2,
      "start": 12633.0,
      "end": 12636.0,
      "formatted_start": "03:30:33.000",
      "formatted_end": "03:30:36.000",
      "text": "خب من الان مثلا توصیه کلا من به کسی توصیه نمی کنم"
    },
    {
      "id": 3,
      "start": 12636.0,
      "end": 12641.0,
      "formatted_start": "03:30:36.000",
      "formatted_end": "03:30:41.000",
      "text": "مثلا آقایی که خوهر خود منه وقتی بره سزالی هم نمیگم برو کجا"
    },
    {
      "id": 4,
      "start": 12641.0,
      "end": 12644.0,
      "formatted_start": "03:30:41.000",
      "formatted_end": "03:30:44.000",
      "text": "بلاخره یه سری چیزای ممکنه عوارضی باشه"
    },
    {
      "id": 5,
      "start": 12644.0,
      "end": 12647.0,
      "formatted_start": "03:30:44.000",
      "formatted_end": "03:30:47.000",
      "text": "ولی من اگه بچه خونم بود هم کنم"
    },
    {
      "id": 6,
      "start": 12647.0,
      "end": 12649.0,
      "formatted_start": "03:30:47.000",
      "formatted_end": "03:30:49.000",
      "text": "همین گنبه من جا ندارم"
    },
    {
      "id": 7,
      "start": 12649.0,
      "end": 12651.0,
      "formatted_start": "03:30:49.000",
      "formatted_end": "03:30:51.000",
      "text": "آه"
    },
    {
      "id": 8,
      "start": 12656.0,
      "end": 12660.0,
      "formatted_start": "03:30:56.000",
      "formatted_end": "03:31:00.000",
      "text": "از پیچه می کنم من همجور بودم شاید یه راقار دیگه هم باشه"
    },
    {
      "id": 9,
      "start": 12660.0,
      "end": 12662.0,
      "formatted_start": "03:31:00.000",
      "formatted_end": "03:31:02.000",
      "text": "ولی دیدم دیگه چطور توسط کوسیه"
    },
    {
      "id": 10,
      "start": 12662.0,
      "end": 12663.0,
      "formatted_start": "03:31:02.000",
      "formatted_end": "03:31:03.000",
      "text": "نه، خواهی نداره"
    },
    {
      "id": 11,
      "start": 12663.0,
      "end": 12665.0,
      "formatted_start": "03:31:03.000",
      "formatted_end": "03:31:05.000",
      "text": "همینوشه، ازا می سویم فسیب ببنش"
    },
    {
      "id": 12,
      "start": 12665.0,
      "end": 12667.0,
      "formatted_start": "03:31:05.000",
      "formatted_end": "03:31:07.000",
      "text": "انا یه چیز اجازه معاینه نمی دهید"
    },
    {
      "id": 13,
      "start": 12667.0,
      "end": 12669.72,
      "formatted_start": "03:31:07.000",
      "formatted_end": "03:31:09.720",
      "text": "چه برسان خواهد کار را درموش کنیم که روش انجام بشم"
    },
    {
      "id": 14,
      "start": 12669.72,
      "end": 12671.72,
      "formatted_start": "03:31:09.720",
      "formatted_end": "03:31:11.720",
      "text": "آره، آره دیگه"
    },
    {
      "id": 15,
      "start": 12671.72,
      "end": 12674.72,
      "formatted_start": "03:31:11.720",
      "formatted_end": "03:31:14.720",
      "text": "تا از دیگه گفتم، پایینش هم داره پستیدگی ایجاد میشه"
    },
    {
      "id": 16,
      "start": 12674.72,
      "end": 12676.72,
      "formatted_start": "03:31:14.720",
      "formatted_end": "03:31:16.720",
      "text": "در اینجا پایینش"
    },
    {
      "id": 17,
      "start": 12676.72,
      "end": 12678.72,
      "formatted_start": "03:31:16.720",
      "formatted_end": "03:31:18.720",
      "text": "بیا برای هم"
    },
    {
      "id": 18,
      "start": 12678.72,
      "end": 12708.72,
      "formatted_start": "03:31:18.720",
      "formatted_end": "03:31:48.720",
      "text": "از اینجا باید برداشت برداشت برداشت برداشت برداشت برداشت برداشت برداشت برداشت برداشت برداشت برداشت برداشت برداشت برداشت برداشت برداشت برداشت برداشت برداشت برداشت برداشت برداشت برداشت برداشت برداشت برداشت برداشت برداشت برداشت برداشت برداشت برداشت برداشت برداشت برداشت برداشت برداشت برداشت برداشت برداشت برداشت برد"
    },
    {
      "id": 19,
