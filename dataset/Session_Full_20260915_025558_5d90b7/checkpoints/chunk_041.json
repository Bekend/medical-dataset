  "stt_segments": [
    {
      "id": 0,
      "start": 12300.0,
      "end": 12304.8,
      "formatted_start": "03:25:00.000",
      "formatted_end": "03:25:04.800",
      "text": "برای اصلا یه قاشونگ قضاخوی داریم، داریم جنبه و چایکوی."
    },
    {
      "id": 1,
      "start": 12304.8,
      "end": 12306.8,
      "formatted_start": "03:25:04.800",
      "formatted_end": "03:25:06.800",
      "text": "این روزان یه گرگوستی گه نه؟"
    },
    {
      "id": 2,
      "start": 12306.8,
      "end": 12307.3,
      "formatted_start": "03:25:06.800",
      "formatted_end": "03:25:07.300",
      "text": "بله."
    },
    {
      "id": 3,
      "start": 12307.3,
      "end": 12311.3,
      "formatted_start": "03:25:07.300",
      "formatted_end": "03:25:11.300",
      "text": "و اینجا نمیشته بودین تا سه ماه، سه ماه بعدشو چی کنی؟"
    },
    {
      "id": 4,
      "start": 12311.3,
      "end": 12312.3,
      "formatted_start": "03:25:11.300",
      "formatted_end": "03:25:12.300",
      "text": "خب سه ماه بعد کنیم."
    },
    {
      "id": 5,
      "start": 12312.3,
      "end": 12314.3,
      "formatted_start": "03:25:12.300",
      "formatted_end": "03:25:14.300",
      "text": "این مواقع لازم همیشه است."
    },
    {
      "id": 6,
      "start": 12314.3,
      "end": 12318.3,
      "formatted_start": "03:25:14.300",
      "formatted_end": "03:25:18.300",
      "text": "باید نه، تا سه ماه میدین و بعد کم کم همشون کنیش. خب؟"
    },
    {
      "id": 7,
      "start": 12318.3,
      "end": 12322.3,
      "formatted_start": "03:25:18.300",
      "formatted_end": "03:25:22.300",
      "text": "مثلا یه قاشونگ قضاخوی، یه عصی دارون می کنی، یه قاشونگ مرگون می کنی،"
    },
    {
      "id": 8,
      "start": 12322.3,
      "end": 12352.3,
      "formatted_start": "03:25:22.300",
      "formatted_end": "03:25:52.300",
      "text": "باید برداری کنید، برداری کنید، برداری کنید، برداری کنید، برداری کنید، برداری کنید، برداری کنید، برداری کنید، برداری کنید، برداری کنید، برداری کنید، برداری کنید، برداری کنید، برداری کنید، برداری کنید، برداری کنید، برداری کنید، برداری کنید، برداری کنید، برداری کنید، برداری کنید، برداری کنید"
    },
    {
      "id": 9,
      "start": 12352.3,
      "end": 12382.3,
      "formatted_start": "03:25:52.300",
      "formatted_end": "03:26:22.300",
      "text": "نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، ن"
    },
    {
      "id": 10,
      "start": 12382.3,
      "end": 12386.3,
      "formatted_start": "03:26:22.300",
      "formatted_end": "03:26:26.300",
      "text": "باشه میریم کنم"
    },
    {
      "id": 11,
      "start": 12386.3,
      "end": 12390.3,
      "formatted_start": "03:26:26.300",
      "formatted_end": "03:26:30.300",
      "text": "خوبی؟"
    },
    {
      "id": 12,
      "start": 12390.3,
      "end": 12394.3,
      "formatted_start": "03:26:30.300",
      "formatted_end": "03:26:34.300",
      "text": "خوبی؟"
    },
    {
      "id": 13,
      "start": 12394.3,
      "end": 12398.3,
      "formatted_start": "03:26:34.300",
      "formatted_end": "03:26:38.300",
      "text": "تو دردش همینجا نکرده"
    },
    {
      "id": 14,
      "start": 12398.3,
      "end": 12400.3,
      "formatted_start": "03:26:38.300",
      "formatted_end": "03:26:40.300",
      "text": "نمیخواد بیا من دیگه"
    },
    {
      "id": 15,
      "start": 12400.3,
      "end": 12402.3,
      "formatted_start": "03:26:40.300",
      "formatted_end": "03:26:42.300",
      "text": "نه دیگه"
    },
    {
      "id": 16,
      "start": 12402.3,
      "end": 12404.3,
      "formatted_start": "03:26:42.300",
      "formatted_end": "03:26:44.300",
      "text": "بگیرم برورشم"
    },
    {
      "id": 17,
      "start": 12404.3,
      "end": 12406.3,
      "formatted_start": "03:26:44.300",
      "formatted_end": "03:26:46.300",
      "text": "بخوادم بخوادم"
    },
    {
      "id": 18,
      "start": 12406.3,
      "end": 12410.3,
      "formatted_start": "03:26:46.300",
      "formatted_end": "03:26:50.300",
      "text": "میخواد ده الان ببن؟"
    },
    {
      "id": 19,
      "start": 12410.3,
      "end": 12411.3,
      "formatted_start": "03:26:50.300",
      "formatted_end": "03:26:51.300",
      "text": "برو جا"
    },
    {
      "id": 20,
      "start": 12411.3,
      "end": 12413.3,
      "formatted_start": "03:26:51.300",
      "formatted_end": "03:26:53.300",
      "text": "بگم انا من دیگه ها پره میخنم"
    },
    {
      "id": 21,
      "start": 12413.3,
      "end": 12415.3,
      "formatted_start": "03:26:53.300",
      "formatted_end": "03:26:55.300",
      "text": "بگش کن دیگه ها پره"
    },
    {
      "id": 22,
      "start": 12415.3,
      "end": 12416.3,
      "formatted_start": "03:26:55.300",
      "formatted_end": "03:26:56.300",
      "text": "برو جا"
    },
    {
      "id": 23,
      "start": 12416.3,
      "end": 12417.3,
      "formatted_start": "03:26:56.300",
      "formatted_end": "03:26:57.300",
      "text": "بفرمایی"
    },
    {
      "id": 24,
      "start": 12417.3,
      "end": 12418.3,
      "formatted_start": "03:26:57.300",
      "formatted_end": "03:26:58.300",
      "text": "سلام خدا"
    },
    {
      "id": 25,
      "start": 12418.3,
      "end": 12420.3,
      "formatted_start": "03:26:58.300",
      "formatted_end": "03:27:00.300",
      "text": "سلام اخوان شما مرسی"
    },
    {
      "id": 26,
      "start": 12420.3,
      "end": 12422.3,
      "formatted_start": "03:27:00.300",
      "formatted_end": "03:27:02.300",
      "text": "سلام اخوان شما بفرمایی"
    },
    {
      "id": 27,
      "start": 12422.3,
      "end": 12424.3,
      "formatted_start": "03:27:02.300",
      "formatted_end": "03:27:04.300",
      "text": "چطوری گل پسر؟"
    },
    {
      "id": 28,
      "start": 12424.3,
      "end": 12428.3,
      "formatted_start": "03:27:04.300",
      "formatted_end": "03:27:08.300",
      "text": "اردن ها من این زمون رو زنداری اینجا نه"
    },
    {
      "id": 29,
      "start": 12428.3,
      "end": 12430.3,
      "formatted_start": "03:27:08.300",
      "formatted_end": "03:27:10.300",
      "text": "تغییر گل داره"
    },
    {
      "id": 30,
      "start": 12430.3,
      "end": 12433.3,
      "formatted_start": "03:27:10.300",
      "formatted_end": "03:27:13.300",
      "text": "ما بردیم پیش خسینی"
    },
    {
      "id": 31,
      "start": 12433.3,
      "end": 12435.3,
      "formatted_start": "03:27:13.300",
      "formatted_end": "03:27:15.300",
      "text": "نه مرمت گرفتیم"
    },
    {
      "id": 32,
      "start": 12435.3,
      "end": 12436.3,
      "formatted_start": "03:27:15.300",
      "formatted_end": "03:27:16.300",
      "text": "خواب"
    },
    {
      "id": 33,
      "start": 12436.3,
      "end": 12438.3,
      "formatted_start": "03:27:16.300",
      "formatted_end": "03:27:18.300",
      "text": "و ای بی آر گرفتیم"
    },
    {
      "id": 34,
      "start": 12438.3,
      "end": 12446.3,
      "formatted_start": "03:27:18.300",
      "formatted_end": "03:27:26.300",
      "text": "همداده بخواد یک ماه به پروند دارو خوردن مکمل سیتولین و اومگا سولین"
    },
    {
      "id": 35,
      "start": 12446.3,
      "end": 12450.3,
      "formatted_start": "03:27:26.300",
      "formatted_end": "03:27:30.300",
      "text": "و تا در یه ماه شما شده دکتر حسینی گفت یک کلیم ماه دیگه بیا"
    },
    {
      "id": 36,
      "start": 12450.3,
      "end": 12454.3,
      "formatted_start": "03:27:30.300",
      "formatted_end": "03:27:34.300",
      "text": "و یه مشکل دیگه پیدا کرده دندون جراش ریخته پوستیدگی پیدا کرده"
    },
    {
      "id": 37,
      "start": 12454.3,
      "end": 12457.3,
      "formatted_start": "03:27:34.300",
      "formatted_end": "03:27:37.300",
      "text": "قبل از این یه بار گفتم پیش خانم آدلی"
    },
    {
      "id": 38,
      "start": 12457.3,
      "end": 12462.3,
      "formatted_start": "03:27:37.300",
      "formatted_end": "03:27:42.300",
      "text": "پیشون به من گفت این پوستیدگی هست باید فلورایت تراپی کنی شاید خوبشی شاید نشد"
    },
    {
      "id": 39,
      "start": 12462.3,
      "end": 12465.3,
      "formatted_start": "03:27:42.300",
      "formatted_end": "03:27:45.300",
      "text": "از اینجا برای چند ماه خوب نشوند و خسته اش بیدا کرد."
    },
    {
      "id": 40,
      "start": 12465.3,
      "end": 12471.3,
      "formatted_start": "03:27:45.300",
      "formatted_end": "03:27:51.300",
      "text": "بعد من یک بار بردم که خانم آدلی مشابه داد و گفتم برای بیخوشی بشه بره اتاق عمل داری."
    },
    {
      "id": 41,
      "start": 12471.3,
      "end": 12475.3,
      "formatted_start": "03:27:51.300",
      "formatted_end": "03:27:55.300",
      "text": "بردم بردم و گفتم گربانم اونجا همچنین که فقط خانم آدلی هست."
    },
    {
      "id": 42,
      "start": 12475.3,
      "end": 12478.3,
      "formatted_start": "03:27:55.300",
      "formatted_end": "03:27:58.300",
      "text": "اونجا مشابه داد و اونجا به من همین توصیل کرد."
    },
    {
      "id": 43,
      "start": 12478.3,
      "end": 12481.3,
      "formatted_start": "03:27:58.300",
      "formatted_end": "03:28:01.300",
      "text": "از اینجا بردم که نظر شما بگیرم که من چی کار کنم."
    },
    {
      "id": 44,
      "start": 12481.3,
      "end": 12485.3,
      "formatted_start": "03:28:01.300",
      "formatted_end": "03:28:05.300",
      "text": "23 ماهشه، دو سالش نشده ولی خب رنگونوش..."
    },
    {
      "id": 45,
      "start": 12485.3,
      "end": 12492.3,
      "formatted_start": "03:28:05.300",
      "formatted_end": "03:28:12.300",
      "text": "اردلان چطوری؟ خب اردل صحبت کردنش بهتر شده؟"
    },
    {
      "id": 46,
      "start": 12492.3,
      "end": 12502.3,
      "formatted_start": "03:28:12.300",
      "formatted_end": "03:28:22.300",
      "text": "نه، یکم آبانی که داشت از اول، ولی دستور پذیریش بهتر شده، و بعد که یک ماه، هفته، سه روزم میبنم کاردرمانی"
    },
    {
      "id": 47,
      "start": 12502.3,
      "end": 12504.3,
      "formatted_start": "03:28:22.300",
      "formatted_end": "03:28:24.300",
      "text": "کاردرمانی، ذهنی میبنی و گفتردرمانی هم میبینی"
    },
    {
      "id": 48,
      "start": 12504.3,
      "end": 12506.3,
      "formatted_start": "03:28:24.300",
      "formatted_end": "03:28:26.300",
      "text": "گفتردرمانی چندی چی رو نکردم؟"
    },
    {
      "id": 49,
      "start": 12506.3,
      "end": 12510.3,
      "formatted_start": "03:28:26.300",
      "formatted_end": "03:28:30.300",
      "text": "نه، ولی بهتر شده، بهتر شده"
    },
    {
      "id": 50,
      "start": 12510.3,
      "end": 12513.3,
      "formatted_start": "03:28:30.300",
      "formatted_end": "03:28:33.300",
      "text": "چیه؟ اردلان؟"
    },
    {
      "id": 51,
      "start": 12513.3,
      "end": 12515.3,
      "formatted_start": "03:28:33.300",
      "formatted_end": "03:28:35.300",
      "text": "این وقتی دکتور زیر رو بردن میشه چرا بردی؟"
    },
    {
      "id": 52,
      "start": 12515.3,
      "end": 12517.3,
      "formatted_start": "03:28:35.300",
      "formatted_end": "03:28:37.300",
      "text": "آره بچه حق داره"
    },
    {
      "id": 53,
      "start": 12517.3,
      "end": 12519.3,
      "formatted_start": "03:28:37.300",
      "formatted_end": "03:28:39.300",
      "text": "اولا اینو میبینی؟"
    },
    {
      "id": 54,
      "start": 12519.3,
      "end": 12521.3,
      "formatted_start": "03:28:39.300",
      "formatted_end": "03:28:41.300",
      "text": "این"
    },
    {
      "id": 55,
      "start": 12521.3,
      "end": 12523.3,
      "formatted_start": "03:28:41.300",
      "formatted_end": "03:28:43.300",
      "text": "چی؟ بیا"
    },
    {
      "id": 56,
      "start": 12523.3,
      "end": 12525.3,
      "formatted_start": "03:28:43.300",
      "formatted_end": "03:28:45.300",
      "text": "بگیر"
    },
    {
      "id": 57,
      "start": 12525.3,
      "end": 12527.3,
      "formatted_start": "03:28:45.300",
      "formatted_end": "03:28:47.300",
      "text": "مامانی خودت بگیر"
    },
    {
      "id": 58,
      "start": 12529.3,
      "end": 12531.3,
      "formatted_start": "03:28:49.300",
      "formatted_end": "03:28:51.300",
      "text": "این به خاطر"
    },
    {
      "id": 59,
      "start": 12531.3,
      "end": 12533.3,
      "formatted_start": "03:28:51.300",
      "formatted_end": "03:28:53.300",
      "text": "شیر شبه ها"
    },
    {
      "id": 60,
      "start": 12533.3,
      "end": 12535.3,
      "formatted_start": "03:28:53.300",
      "formatted_end": "03:28:55.300",
      "text": "شیر شبه من از همون"
    },
    {
      "id": 61,
      "start": 12535.3,
      "end": 12537.3,
      "formatted_start": "03:28:55.300",
      "formatted_end": "03:28:57.300",
      "text": "خودتون داریم؟"
    },
    {
      "id": 62,
      "start": 12537.3,
      "end": 12539.3,
      "formatted_start": "03:28:57.300",
      "formatted_end": "03:28:59.300",
      "text": "من قصد کردم"
    },
    {
      "id": 63,
      "start": 12539.3,
      "end": 12541.3,
      "formatted_start": "03:28:59.300",
      "formatted_end": "03:29:01.300",
      "text": "از قبل این قصد کردم"
    },
    {
      "id": 64,
      "start": 12541.3,
      "end": 12571.3,
      "formatted_start": "03:29:01.300",
      "formatted_end": "03:29:31.300",
      "text": "از اینجا باید بردارید که از اینجا باید بردارید که از اینجا بردارید که از اینجا بردارید که از اینجا بردارید که از اینجا بردارید که از اینجا بردارید که از اینجا بردارید که از اینجا بردارید که از اینجا بردارید که از اینجا بردارید که از اینجا بردارید که از اینجا بردارید که از اینجا بردارید که از اینجا بردارید که از اینج"
    },
    {
      "id": 65,
      "start": 12571.3,
      "end": 12573.3,
      "formatted_start": "03:29:31.300",
      "formatted_end": "03:29:33.300",
      "text": "اینجا باید برنامه باشه"
    },
    {
      "id": 66,
      "start": 12573.3,
      "end": 12575.3,
      "formatted_start": "03:29:33.300",
      "formatted_end": "03:29:35.300",
      "text": "باید برنامه باشه"
    },
    {
      "id": 67,
      "start": 12575.3,
      "end": 12577.3,
      "formatted_start": "03:29:35.300",
      "formatted_end": "03:29:37.300",
      "text": "باید برنامه باشه"
    },
    {
      "id": 68,
      "start": 12577.3,
      "end": 12579.3,
      "formatted_start": "03:29:37.300",
      "formatted_end": "03:29:39.300",
      "text": "باید برنامه باشه"
    },
    {
      "id": 69,
      "start": 12579.3,
      "end": 12581.3,
      "formatted_start": "03:29:39.300",
      "formatted_end": "03:29:41.300",
      "text": "باید برنامه باشه"
    },
    {
      "id": 70,
      "start": 12581.3,
      "end": 12583.3,
      "formatted_start": "03:29:41.300",
      "formatted_end": "03:29:43.300",
      "text": "باید برنامه باشه"
    },
    {
      "id": 71,
      "start": 12583.3,
      "end": 12585.3,
      "formatted_start": "03:29:43.300",
      "formatted_end": "03:29:45.300",
      "text": "باید برنامه باشه"
    },
    {
      "id": 72,
      "start": 12585.3,
      "end": 12587.3,
      "formatted_start": "03:29:45.300",
      "formatted_end": "03:29:47.300",
      "text": "باید برنامه باشه"
    },
    {
      "id": 73,
