  "stt_segments": [
    {
      "id": 0,
      "start": 7200.0,
      "end": 7202.0,
      "formatted_start": "02:00:00.000",
      "formatted_end": "02:00:02.000",
      "text": "باید خودت هم یاد میزنید."
    },
    {
      "id": 1,
      "start": 7212.0,
      "end": 7214.0,
      "formatted_start": "02:00:12.000",
      "formatted_end": "02:00:14.000",
      "text": "این استفاده کن در این مورد شبه داره."
    },
    {
      "id": 2,
      "start": 7214.0,
      "end": 7215.0,
      "formatted_start": "02:00:14.000",
      "formatted_end": "02:00:15.000",
      "text": "شبه داره، بله."
    },
    {
      "id": 3,
      "start": 7215.0,
      "end": 7217.0,
      "formatted_start": "02:00:15.000",
      "formatted_end": "02:00:17.000",
      "text": "بعضی که ما جواب میده، بعضی ما جواب نمیده."
    },
    {
      "id": 4,
      "start": 7217.0,
      "end": 7220.0,
      "formatted_start": "02:00:17.000",
      "formatted_end": "02:00:20.000",
      "text": "نمیدونیم بخاطر آب سیارت میبوره یا نمیدونیم در..."
    },
    {
      "id": 5,
      "start": 7220.0,
      "end": 7222.0,
      "formatted_start": "02:00:20.000",
      "formatted_end": "02:00:22.000",
      "text": "شاید درست نمیزنه موقعی جواب."
    },
    {
      "id": 6,
      "start": 7222.0,
      "end": 7224.0,
      "formatted_start": "02:00:22.000",
      "formatted_end": "02:00:24.000",
      "text": "چون مال بینیه دیگه."
    },
    {
      "id": 7,
      "start": 7224.0,
      "end": 7225.0,
      "formatted_start": "02:00:24.000",
      "formatted_end": "02:00:25.000",
      "text": "این هم مشکلی."
    },
    {
      "id": 8,
      "start": 7225.0,
      "end": 7229.0,
      "formatted_start": "02:00:25.000",
      "formatted_end": "02:00:29.000",
      "text": "اینو اینجوری بکش بالا، اینو نگه داره، بکش بالا."
    },
    {
      "id": 9,
      "start": 7229.0,
      "end": 7236.0,
      "formatted_start": "02:00:29.000",
      "formatted_end": "02:00:36.000",
      "text": "اگر خوب جز نشه، بینیش گرفته باشه، در بینیش آشغال باشه، خوب جز نمیشه. قبلش باید بینیش رو تخلیه کنه."
    },
    {
      "id": 10,
      "start": 7236.0,
      "end": 7238.0,
      "formatted_start": "02:00:36.000",
      "formatted_end": "02:00:38.000",
      "text": "یک مشکل زایی بدن حیث کنی؟"
    },
    {
      "id": 11,
      "start": 7238.0,
      "end": 7243.0,
      "formatted_start": "02:00:38.000",
      "formatted_end": "02:00:43.000",
      "text": "نه، نه، اصلا یه مدت استفاده کنی، تقریبا میشه دو سه سال لازم باشه استفاده کنی."
    },
    {
      "id": 12,
      "start": 7243.0,
      "end": 7249.0,
      "formatted_start": "02:00:43.000",
      "formatted_end": "02:00:49.000",
      "text": "فقط اینکه گروه، مثلا از 6 و 7 گروه به بعد زیاد مایات نخوره،"
    },
    {
      "id": 13,
      "start": 7249.0,
      "end": 7255.0,
      "formatted_start": "02:00:49.000",
      "formatted_end": "02:00:55.000",
      "text": "و قبل خوابیدن حتما دستش روی بره، ادراش رو تخلیه میکنه و بعد بره."
    },
    {
      "id": 14,
      "start": 7255.0,
      "end": 7258.0,
      "formatted_start": "02:00:55.000",
      "formatted_end": "02:00:58.000",
      "text": "اگر جواب نمیده، باید هون را بگیریم."
    },
    {
      "id": 15,
      "start": 7262.0,
      "end": 7264.0,
      "formatted_start": "02:01:02.000",
      "formatted_end": "02:01:04.000",
      "text": "سنو از مسانه یا؟"
    },
    {
      "id": 16,
      "start": 7264.0,
      "end": 7266.0,
      "formatted_start": "02:01:04.000",
      "formatted_end": "02:01:06.000",
      "text": "این مسانه."
    },
    {
      "id": 17,
      "start": 7269.0,
      "end": 7271.0,
      "formatted_start": "02:01:09.000",
      "formatted_end": "02:01:11.000",
      "text": "هیچ سنو از هم برمیز بده باشی؟"
    },
    {
      "id": 18,
      "start": 7271.0,
      "end": 7272.0,
      "formatted_start": "02:01:11.000",
      "formatted_end": "02:01:12.000",
      "text": "باشی."
    },
    {
      "id": 19,
      "start": 7272.0,
      "end": 7274.0,
      "formatted_start": "02:01:12.000",
      "formatted_end": "02:01:14.000",
      "text": "من که که رو بیرونم"
    },
    {
      "id": 20,
      "start": 7279.0,
      "end": 7281.0,
      "formatted_start": "02:01:19.000",
      "formatted_end": "02:01:21.000",
      "text": "اینو بعد هم بیارن میشه"
    },
    {
      "id": 21,
      "start": 7281.0,
      "end": 7283.0,
      "formatted_start": "02:01:21.000",
      "formatted_end": "02:01:23.000",
      "text": "من سری نباشم چون مسیرم چیزه"
    },
    {
      "id": 22,
      "start": 7283.0,
      "end": 7285.0,
      "formatted_start": "02:01:23.000",
      "formatted_end": "02:01:25.000",
      "text": "یه ویزیت دیگه بکنیم"
    },
    {
      "id": 23,
      "start": 7285.0,
      "end": 7287.0,
      "formatted_start": "02:01:25.000",
      "formatted_end": "02:01:27.000",
      "text": "چه بکنیم؟"
    },
    {
      "id": 24,
      "start": 7287.0,
      "end": 7289.0,
      "formatted_start": "02:01:27.000",
      "formatted_end": "02:01:29.000",
      "text": "آزما نگرد بکنیم"
    },
    {
      "id": 25,
      "start": 7289.0,
      "end": 7291.0,
      "formatted_start": "02:01:29.000",
      "formatted_end": "02:01:31.000",
      "text": "نه نه رو بکنیم"
    },
    {
      "id": 26,
      "start": 7291.0,
      "end": 7293.0,
      "formatted_start": "02:01:31.000",
      "formatted_end": "02:01:33.000",
      "text": "آزما شما گفتن من دور مسیرم بکنم"
    },
    {
      "id": 27,
      "start": 7293.0,
      "end": 7295.0,
      "formatted_start": "02:01:33.000",
      "formatted_end": "02:01:35.000",
      "text": "دو سر روز دیرتر شد"
    },
    {
      "id": 28,
      "start": 7295.0,
      "end": 7297.0,
      "formatted_start": "02:01:35.000",
      "formatted_end": "02:01:37.000",
      "text": "نه نه"
    },
    {
      "id": 29,
      "start": 7297.0,
      "end": 7299.0,
      "formatted_start": "02:01:37.000",
      "formatted_end": "02:01:39.000",
      "text": "بچه اومدی پیشم"
    },
    {
      "id": 30,
      "start": 7299.0,
      "end": 7301.0,
      "formatted_start": "02:01:39.000",
      "formatted_end": "02:01:41.000",
      "text": "من بگم پس بگم"
    },
    {
      "id": 31,
      "start": 7301.0,
      "end": 7303.0,
      "formatted_start": "02:01:41.000",
      "formatted_end": "02:01:43.000",
      "text": "نه، نگران نباشی"
    },
    {
      "id": 32,
      "start": 7322.5,
      "end": 7323.5,
      "formatted_start": "02:02:02.500",
      "formatted_end": "02:02:03.500",
      "text": "ازش شگو؟"
    },
    {
      "id": 33,
      "start": 7323.5,
      "end": 7325.5,
      "formatted_start": "02:02:03.500",
      "formatted_end": "02:02:05.500",
      "text": "افترالی، دلیل چیز"
    },
    {
      "id": 34,
      "start": 7325.5,
      "end": 7327.5,
      "formatted_start": "02:02:05.500",
      "formatted_end": "02:02:07.500",
      "text": "بخشید"
    },
    {
      "id": 35,
      "start": 7327.5,
      "end": 7329.5,
      "formatted_start": "02:02:07.500",
      "formatted_end": "02:02:09.500",
      "text": "بخشید"
    },
    {
      "id": 36,
      "start": 7329.5,
      "end": 7331.5,
      "formatted_start": "02:02:09.500",
      "formatted_end": "02:02:11.500",
      "text": "بخشید"
    },
