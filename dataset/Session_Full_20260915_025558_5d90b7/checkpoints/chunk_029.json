  "stt_segments": [
    {
      "id": 0,
      "start": 8700.0,
      "end": 8708.0,
      "formatted_start": "02:25:00.000",
      "formatted_end": "02:25:08.000",
      "text": "بعد نهار، دوتا، بعد شامبور، آر، ولی میده خالی نباشن."
    },
    {
      "id": 1,
      "start": 8708.0,
      "end": 8710.0,
      "formatted_start": "02:25:08.000",
      "formatted_end": "02:25:10.000",
      "text": "میده شو برداشت."
    },
    {
      "id": 2,
      "start": 8710.0,
      "end": 8718.0,
      "formatted_start": "02:25:10.000",
      "formatted_end": "02:25:18.000",
      "text": "با اینکه با اینها بهتر نشد، بعد اون موقع آن پول شد."
    },
    {
      "id": 3,
      "start": 8724.0,
      "end": 8727.0,
      "formatted_start": "02:25:24.000",
      "formatted_end": "02:25:27.000",
      "text": "اصلا بابرتون نمیشه جاید بهتر شدن."
    },
    {
      "id": 4,
      "start": 8727.0,
      "end": 8730.0,
      "formatted_start": "02:25:27.000",
      "formatted_end": "02:25:30.000",
      "text": "خودت احساس می کنی مردت باشه"
    },
    {
      "id": 5,
      "start": 8752.0,
      "end": 8754.0,
      "formatted_start": "02:25:52.000",
      "formatted_end": "02:25:54.000",
      "text": "دستت میرز عزیزم"
    },
    {
      "id": 6,
      "start": 8754.0,
      "end": 8761.0,
      "formatted_start": "02:25:54.000",
      "formatted_end": "02:26:01.000",
      "text": "دیدی چقدر زود خوب شدی؟"
    },
    {
      "id": 7,
      "start": 8761.0,
      "end": 8763.0,
      "formatted_start": "02:26:01.000",
      "formatted_end": "02:26:03.000",
      "text": "الان زود ها زود خوب شد"
    },
    {
      "id": 8,
      "start": 8763.0,
      "end": 8765.0,
      "formatted_start": "02:26:03.000",
      "formatted_end": "02:26:05.000",
      "text": "اکسیژن همه انا رفته بالا"
    },
    {
      "id": 9,
      "start": 8765.0,
      "end": 8768.0,
      "formatted_start": "02:26:05.000",
      "formatted_end": "02:26:08.000",
      "text": "اون دفعه 82 بود"
    },
    {
      "id": 10,
      "start": 8768.0,
      "end": 8770.0,
      "formatted_start": "02:26:08.000",
      "formatted_end": "02:26:10.000",
      "text": "حالا ببینیم چند شده"
    },
    {
      "id": 11,
      "start": 8770.0,
      "end": 8772.0,
      "formatted_start": "02:26:10.000",
      "formatted_end": "02:26:12.000",
      "text": "حالا که اینجا نشستی"
    },
    {
      "id": 12,
      "start": 8772.0,
      "end": 8774.0,
      "formatted_start": "02:26:12.000",
      "formatted_end": "02:26:14.000",
      "text": "دیدی؟"
    },
    {
      "id": 13,
      "start": 8774.0,
      "end": 8776.0,
      "formatted_start": "02:26:14.000",
      "formatted_end": "02:26:16.000",
      "text": "دیدی چقدر رفت بالا؟"
    },
    {
      "id": 14,
      "start": 8776.0,
      "end": 8778.0,
      "formatted_start": "02:26:16.000",
      "formatted_end": "02:26:18.000",
      "text": "11 تا اکسیژنت رفت بالا"
    },
    {
      "id": 15,
      "start": 8778.0,
      "end": 8783.0,
      "formatted_start": "02:26:18.000",
      "formatted_end": "02:26:23.000",
      "text": "حالا که اینجا نشستی من براش بزنم"
    },
    {
      "id": 16,
      "start": 8783.0,
      "end": 8786.1,
      "formatted_start": "02:26:23.000",
      "formatted_end": "02:26:26.100",
      "text": "اولیش رو براش بزنن"
    },
    {
      "id": 17,
      "start": 8786.1,
      "end": 8796.82,
      "formatted_start": "02:26:26.100",
      "formatted_end": "02:26:36.820",
      "text": "هر نیم ساعت براش بزنی"
    },
    {
      "id": 18,
      "start": 8796.82,
      "end": 8796.84,
      "formatted_start": "02:26:36.820",
