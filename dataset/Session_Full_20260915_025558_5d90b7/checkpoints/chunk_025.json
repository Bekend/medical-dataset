    },
    {
      "id": 4,
      "start": 7614.0,
      "end": 7616.0,
      "formatted_start": "02:06:54.000",
      "formatted_end": "02:06:56.000",
      "text": "بفرماییم"
    },
    {
      "id": 5,
      "start": 7616.0,
      "end": 7618.0,
      "formatted_start": "02:06:56.000",
      "formatted_end": "02:06:58.000",
      "text": "سلام"
    },
    {
      "id": 6,
      "start": 7618.0,
      "end": 7620.0,
      "formatted_start": "02:06:58.000",
      "formatted_end": "02:07:00.000",
      "text": "سلام"
    },
    {
      "id": 7,
      "start": 7620.0,
      "end": 7622.0,
      "formatted_start": "02:07:00.000",
      "formatted_end": "02:07:02.000",
      "text": "بفرماییم"
    },
    {
      "id": 8,
      "start": 7622.0,
      "end": 7624.0,
      "formatted_start": "02:07:02.000",
      "formatted_end": "02:07:04.000",
      "text": "این هنوز تب میکنه؟"
    },
    {
      "id": 9,
      "start": 7624.0,
      "end": 7626.0,
      "formatted_start": "02:07:04.000",
      "formatted_end": "02:07:06.000",
      "text": "چند روز شد تبشی؟"
    },
    {
      "id": 10,
      "start": 7626.0,
      "end": 7628.0,
      "formatted_start": "02:07:06.000",
      "formatted_end": "02:07:08.000",
      "text": "تبیر روز آمده بودیم"
    },
    {
      "id": 11,
      "start": 7628.0,
      "end": 7630.0,
      "formatted_start": "02:07:08.000",
      "formatted_end": "02:07:10.000",
      "text": "پیش اون بچه شبش خیلی تب کرد"
    },
    {
      "id": 12,
      "start": 7630.0,
      "end": 7632.0,
      "formatted_start": "02:07:10.000",
      "formatted_end": "02:07:12.000",
      "text": "نه میدونم"
    },
    {
      "id": 13,
      "start": 7632.0,
      "end": 7634.0,
      "formatted_start": "02:07:12.000",
      "formatted_end": "02:07:14.000",
      "text": "تبش الان چند روز شده؟"
    },
    {
      "id": 14,
      "start": 7634.0,
      "end": 7636.0,
      "formatted_start": "02:07:14.000",
      "formatted_end": "02:07:16.000",
      "text": "سه روز؟"
    },
    {
      "id": 15,
      "start": 7636.0,
      "end": 7638.0,
      "formatted_start": "02:07:16.000",
      "formatted_end": "02:07:18.000",
      "text": "آره دو سه روز شده"
    },
    {
      "id": 16,
      "start": 7638.0,
      "end": 7640.0,
      "formatted_start": "02:07:18.000",
      "formatted_end": "02:07:20.000",
      "text": "او که اونکه اینجا برون همه شده"
    },
    {
      "id": 17,
      "start": 7640.0,
      "end": 7642.0,
      "formatted_start": "02:07:20.000",
      "formatted_end": "02:07:22.000",
      "text": "او که اونکه اونکه اونکه"
    },
    {
      "id": 18,
      "start": 7642.0,
      "end": 7644.0,
      "formatted_start": "02:07:22.000",
      "formatted_end": "02:07:24.000",
      "text": "اینو بیشتر بیشتر اصلا میسوده"
    },
    {
      "id": 19,
      "start": 7644.0,
      "end": 7645.0,
      "formatted_start": "02:07:24.000",
      "formatted_end": "02:07:25.000",
      "text": "صرفه میکنه؟"
    },
    {
      "id": 20,
      "start": 7645.0,
      "end": 7646.0,
      "formatted_start": "02:07:25.000",
      "formatted_end": "02:07:26.000",
      "text": "آره"
    },
    {
      "id": 21,
      "start": 7648.0,
      "end": 7652.0,
      "formatted_start": "02:07:28.000",
      "formatted_end": "02:07:32.000",
      "text": "بیشتر باید شب اینقدر استفراف کرد"
    },
    {
      "id": 22,
      "start": 7652.0,
      "end": 7654.0,
      "formatted_start": "02:07:32.000",
      "formatted_end": "02:07:34.000",
      "text": "اینو شلنگ اومد از رنگش"
    },
    {
      "id": 23,
      "start": 7654.0,
      "end": 7656.0,
      "formatted_start": "02:07:34.000",
      "formatted_end": "02:07:36.000",
      "text": "یعنی خیلی تو من بیمونه؟"
    },
    {
      "id": 24,
      "start": 7656.0,
      "end": 7657.0,
      "formatted_start": "02:07:36.000",
      "formatted_end": "02:07:37.000",
      "text": "آره"
    },
    {
      "id": 25,
      "start": 7657.0,
      "end": 7659.0,
      "formatted_start": "02:07:37.000",
      "formatted_end": "02:07:39.000",
      "text": "پدرن دو شباش و من همه هم خیلی شده"
    },
    {
      "id": 26,
      "start": 7659.0,
      "end": 7661.0,
      "formatted_start": "02:07:39.000",
      "formatted_end": "02:07:41.000",
      "text": "اصحاب نشده؟"
    },
    {
      "id": 27,
      "start": 7661.0,
      "end": 7662.0,
      "formatted_start": "02:07:41.000",
