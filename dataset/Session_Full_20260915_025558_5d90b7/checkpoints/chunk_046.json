  "stt_segments": [
    {
      "id": 0,
      "start": 13800.0,
      "end": 13803.0,
      "formatted_start": "03:50:00.000",
      "formatted_end": "03:50:03.000",
      "text": "یعنی از این کاری کنن بابا فرد داره."
    },
    {
      "id": 1,
      "start": 13803.0,
      "end": 13804.0,
      "formatted_start": "03:50:03.000",
      "formatted_end": "03:50:04.000",
      "text": "سیترزین داری؟"
    },
    {
      "id": 2,
      "start": 13804.0,
      "end": 13807.0,
      "formatted_start": "03:50:04.000",
      "formatted_end": "03:50:07.000",
      "text": "سیترزین دارم، خاندوچو."
    },
    {
      "id": 3,
      "start": 13809.0,
      "end": 13813.0,
      "formatted_start": "03:50:09.000",
      "formatted_end": "03:50:13.000",
      "text": "تقریبا سالبو تنبال داریم. سیترزین داریم، از پلارجین رو ازشو مونترم."
    },
    {
      "id": 4,
      "start": 13813.0,
      "end": 13817.0,
      "formatted_start": "03:50:13.000",
      "formatted_end": "03:50:17.000",
      "text": "آره، خاندوچو، پلارجین رو اعلام کن بدم."
    },
    {
      "id": 5,
      "start": 13817.0,
      "end": 13818.0,
      "formatted_start": "03:50:17.000",
      "formatted_end": "03:50:18.000",
      "text": "خواهی داریم."
    },
    {
      "id": 6,
      "start": 13818.0,
      "end": 13821.0,
      "formatted_start": "03:50:18.000",
      "formatted_end": "03:50:21.000",
      "text": "از پلارجین رو چکل کن، اصلا بخیالش برشم."
    },
    {
      "id": 7,
      "start": 13821.0,
      "end": 13823.0,
      "formatted_start": "03:50:21.000",
      "formatted_end": "03:50:23.000",
      "text": "آره، بخیالش برشم."
    },
    {
      "id": 8,
      "start": 13824.0,
      "end": 13827.0,
      "formatted_start": "03:50:24.000",
      "formatted_end": "03:50:27.000",
      "text": "خاندوچو، اینا ایشاده دیگه بر سرم..."
    },
    {
      "id": 9,
      "start": 13827.0,
      "end": 13831.0,
      "formatted_start": "03:50:27.000",
      "formatted_end": "03:50:31.000",
      "text": "بله ارخواست بیشتر من کافتن دیفن مادر شوهر این سال دیفن هدران کنیم"
    },
    {
      "id": 10,
      "start": 13831.0,
      "end": 13834.0,
      "formatted_start": "03:50:31.000",
      "formatted_end": "03:50:34.000",
      "text": "چون مبقیتی همون کافتن یه ساعتی بر طرف"
    },
    {
      "id": 11,
      "start": 13834.0,
      "end": 13836.0,
      "formatted_start": "03:50:34.000",
      "formatted_end": "03:50:36.000",
      "text": "نه اونو مدتر میاد"
    },
    {
      "id": 12,
      "start": 13836.0,
      "end": 13837.0,
      "formatted_start": "03:50:36.000",
      "formatted_end": "03:50:37.000",
      "text": "من هم گفتم به مادر شوهر"
    },
    {
      "id": 13,
      "start": 13837.0,
      "end": 13840.0,
      "formatted_start": "03:50:37.000",
      "formatted_end": "03:50:40.000",
      "text": "بله دوباره باید که نشات قریبش"
    },
    {
      "id": 14,
      "start": 13840.0,
      "end": 13841.0,
      "formatted_start": "03:50:40.000",
      "formatted_end": "03:50:41.000",
      "text": "نه"
    },
    {
      "id": 15,
      "start": 13841.0,
      "end": 13842.0,
      "formatted_start": "03:50:41.000",
      "formatted_end": "03:50:42.000",
      "text": "خدا خدا رو بگیر"
    },
    {
      "id": 16,
      "start": 13842.0,
      "end": 13845.0,
      "formatted_start": "03:50:42.000",
      "formatted_end": "03:50:45.000",
      "text": "بیا کیانه بیا در سینه تا هم گوش بده"
    },
    {
      "id": 17,
      "start": 13845.0,
      "end": 13847.0,
      "formatted_start": "03:50:45.000",
      "formatted_end": "03:50:47.000",
      "text": "چون نبیرمش هم بیشتر بیا بیا بیا بیا"
    },
    {
      "id": 18,
      "start": 13848.0,
      "end": 13852.0,
      "formatted_start": "03:50:48.000",
      "formatted_end": "03:50:52.000",
      "text": "خدا ببین که خوردنشه خوردن بر طرفش این راه هست"
    },
    {
      "id": 19,
      "start": 13852.0,
      "end": 13853.0,
      "formatted_start": "03:50:52.000",
      "formatted_end": "03:50:53.000",
      "text": "ماما"
    },
    {
      "id": 20,
      "start": 13853.0,
      "end": 13855.0,
      "formatted_start": "03:50:53.000",
      "formatted_end": "03:50:55.000",
      "text": "ببینه ماما یه رست اجازه کنم"
    },
    {
      "id": 21,
      "start": 13855.0,
      "end": 13857.0,
      "formatted_start": "03:50:55.000",
      "formatted_end": "03:50:57.000",
      "text": "ببینی دومون میار چقدر مستقل پرند؟"
    },
    {
      "id": 22,
      "start": 13857.0,
      "end": 13859.0,
      "formatted_start": "03:50:57.000",
      "formatted_end": "03:50:59.000",
      "text": "باشه باشه این آرام بود"
    },
    {
      "id": 23,
      "start": 13861.0,
      "end": 13863.0,
      "formatted_start": "03:51:01.000",
      "formatted_end": "03:51:03.000",
      "text": "ما ببینیم بخواستیم وای بچه هم چقدر مظلومه"
    },
    {
      "id": 24,
      "start": 13863.0,
      "end": 13865.0,
      "formatted_start": "03:51:03.000",
      "formatted_end": "03:51:05.000",
      "text": "آرام دکتر پشه ای مانه"
    },
    {
      "id": 25,
      "start": 13865.0,
      "end": 13867.0,
      "formatted_start": "03:51:05.000",
      "formatted_end": "03:51:07.000",
      "text": "بیچاره ممکن گراماده"
    },
    {
      "id": 26,
      "start": 13871.0,
      "end": 13873.0,
      "formatted_start": "03:51:11.000",
      "formatted_end": "03:51:13.000",
      "text": "که نه گوشتو ببینم که نه"
    },
    {
      "id": 27,
      "start": 13873.0,
      "end": 13875.0,
      "formatted_start": "03:51:13.000",
      "formatted_end": "03:51:15.000",
      "text": "تموم شد"
    },
    {
      "id": 28,
      "start": 13877.0,
      "end": 13879.0,
      "formatted_start": "03:51:17.000",
      "formatted_end": "03:51:19.000",
      "text": "گوشتو ببینم که نه تموم شد"
    },
    {
      "id": 29,
      "start": 13879.0,
      "end": 13881.0,
      "formatted_start": "03:51:19.000",
      "formatted_end": "03:51:21.000",
      "text": "بخشید"
    },
    {
      "id": 30,
      "start": 13881.0,
      "end": 13883.0,
      "formatted_start": "03:51:21.000",
      "formatted_end": "03:51:23.000",
      "text": "بخشید"
    },
    {
      "id": 31,
      "start": 13883.0,
      "end": 13885.0,
      "formatted_start": "03:51:23.000",
      "formatted_end": "03:51:25.000",
      "text": "بخشید"
    },
    {
      "id": 32,
      "start": 13885.0,
      "end": 13887.0,
      "formatted_start": "03:51:25.000",
      "formatted_end": "03:51:27.000",
      "text": "بخشید"
    },
    {
      "id": 33,
      "start": 13887.0,
      "end": 13889.0,
      "formatted_start": "03:51:27.000",
      "formatted_end": "03:51:29.000",
      "text": "بخشید"
    },
    {
      "id": 34,
      "start": 13889.0,
      "end": 13891.0,
      "formatted_start": "03:51:29.000",
      "formatted_end": "03:51:31.000",
      "text": "بخشید"
    },
    {
      "id": 35,
      "start": 13891.0,
      "end": 13893.0,
      "formatted_start": "03:51:31.000",
      "formatted_end": "03:51:33.000",
      "text": "بخشید"
    },
    {
      "id": 36,
      "start": 13893.0,
      "end": 13895.0,
      "formatted_start": "03:51:33.000",
      "formatted_end": "03:51:35.000",
      "text": "بخشید"
    },
    {
      "id": 37,
      "start": 13895.0,
      "end": 13897.0,
      "formatted_start": "03:51:35.000",
      "formatted_end": "03:51:37.000",
      "text": "بخشید"
    },
    {
      "id": 38,
      "start": 13897.0,
      "end": 13899.0,
      "formatted_start": "03:51:37.000",
      "formatted_end": "03:51:39.000",
      "text": "بخشید"
    },
    {
      "id": 39,
      "start": 13899.0,
      "end": 13901.0,
      "formatted_start": "03:51:39.000",
      "formatted_end": "03:51:41.000",
      "text": "بخشید"
    },
    {
      "id": 40,
      "start": 13901.0,
      "end": 13903.0,
      "formatted_start": "03:51:41.000",
      "formatted_end": "03:51:43.000",
      "text": "بخشید"
    },
    {
      "id": 41,
      "start": 13903.0,
      "end": 13905.0,
      "formatted_start": "03:51:43.000",
      "formatted_end": "03:51:45.000",
      "text": "بخشید"
    },
    {
      "id": 42,
      "start": 13905.0,
      "end": 13907.0,
      "formatted_start": "03:51:45.000",
      "formatted_end": "03:51:47.000",
      "text": "بخشید"
    },
    {
      "id": 43,
      "start": 13907.0,
      "end": 13910.0,
      "formatted_start": "03:51:47.000",
      "formatted_end": "03:51:50.000",
      "text": "این تراشهات پشت حلقه هم دارن"
    },
    {
      "id": 44,
      "start": 13910.0,
      "end": 13913.0,
      "formatted_start": "03:51:50.000",
      "formatted_end": "03:51:53.000",
      "text": "این بیشتر آلرژی این رو سوند"
    },
    {
      "id": 45,
      "start": 13913.0,
      "end": 13915.0,
      "formatted_start": "03:51:53.000",
      "formatted_end": "03:51:55.000",
      "text": "بهش فاراموکس چار سال دهد"
    },
    {
      "id": 46,
      "start": 13915.0,
      "end": 13921.0,
      "formatted_start": "03:51:55.000",
      "formatted_end": "03:52:01.000",
      "text": "فاراموکسش هر در روز ده ساعت بهش چند کیلو هست؟"
    },
    {
      "id": 47,
      "start": 13921.0,
      "end": 13923.0,
      "formatted_start": "03:52:01.000",
      "formatted_end": "03:52:03.000",
      "text": "۱۰۸۰۰"
    },
    {
      "id": 48,
      "start": 13923.0,
      "end": 13925.0,
      "formatted_start": "03:52:03.000",
      "formatted_end": "03:52:05.000",
      "text": "۵۰۰۰"
    },
    {
      "id": 49,
      "start": 13925.0,
      "end": 13930.0,
      "formatted_start": "03:52:05.000",
      "formatted_end": "03:52:10.000",
      "text": "سترینش هم هر در روز ده ساعت ۲۰۰"
    },
    {
      "id": 50,
      "start": 13930.0,
      "end": 13934.0,
      "formatted_start": "03:52:10.000",
      "formatted_end": "03:52:14.000",
      "text": "پس این فاراموکس اضافه بکنه"
    },
    {
      "id": 51,
      "start": 13934.0,
      "end": 13936.0,
      "formatted_start": "03:52:14.000",
      "formatted_end": "03:52:16.000",
      "text": "خاندکتو باید بشه"
    },
    {
      "id": 52,
      "start": 13936.0,
      "end": 13938.0,
      "formatted_start": "03:52:16.000",
      "formatted_end": "03:52:18.000",
      "text": "خانم که ده؟"
    },
    {
      "id": 53,
      "start": 13938.0,
      "end": 13940.0,
      "formatted_start": "03:52:18.000",
      "formatted_end": "03:52:20.000",
      "text": "به مامانت خیلی سلامت"
    },
    {
      "id": 54,
      "start": 13940.0,
      "end": 13942.0,
      "formatted_start": "03:52:20.000",
      "formatted_end": "03:52:22.000",
      "text": "فضای شما بشن"
    },
    {
      "id": 55,
      "start": 13942.0,
      "end": 13944.0,
      "formatted_start": "03:52:22.000",
      "formatted_end": "03:52:24.000",
      "text": "خیلی گیر شد"
    },
    {
      "id": 56,
      "start": 13944.0,
      "end": 13946.0,
      "formatted_start": "03:52:24.000",
      "formatted_end": "03:52:26.000",
      "text": "خیلی از ناقابل و بیارزه شد"
    },
    {
      "id": 57,
      "start": 13946.0,
      "end": 13948.0,
      "formatted_start": "03:52:26.000",
      "formatted_end": "03:52:28.000",
      "text": "ماما"
    },
    {
      "id": 58,
      "start": 13948.0,
      "end": 13950.0,
      "formatted_start": "03:52:28.000",
      "formatted_end": "03:52:30.000",
      "text": "جو ماما"
    },
    {
      "id": 59,
      "start": 13950.0,
      "end": 13952.0,
      "formatted_start": "03:52:30.000",
      "formatted_end": "03:52:32.000",
      "text": "ماما جیره داره"
    },
    {
      "id": 60,
      "start": 13952.0,
      "end": 13954.0,
      "formatted_start": "03:52:32.000",
      "formatted_end": "03:52:34.000",
      "text": "میگی"
    },
    {
      "id": 61,
      "start": 13954.0,
      "end": 13956.0,
      "formatted_start": "03:52:34.000",
      "formatted_end": "03:52:36.000",
      "text": "یه بزرگ هم درست کن"
    },
    {
      "id": 62,
      "start": 13956.0,
      "end": 13958.0,
      "formatted_start": "03:52:36.000",
      "formatted_end": "03:52:38.000",
      "text": "این یه نیامه اون که باید بگو میشون بید"
    },
    {
      "id": 63,
      "start": 13958.0,
      "end": 13960.0,
      "formatted_start": "03:52:38.000",
      "formatted_end": "03:52:40.000",
      "text": "آه"
    },
    {
      "id": 64,
      "start": 13960.0,
      "end": 13962.0,
      "formatted_start": "03:52:40.000",
      "formatted_end": "03:52:42.000",
      "text": "نکن چی هم نام"
    },
    {
      "id": 65,
      "start": 13962.0,
      "end": 13966.0,
      "formatted_start": "03:52:42.000",
      "formatted_end": "03:52:46.000",
      "text": "این شیخ همیدو پس برای جثشون پلاجین آزیزو هست"
    },
    {
      "id": 66,
      "start": 13967.0,
      "end": 13971.0,
      "formatted_start": "03:52:47.000",
      "formatted_end": "03:52:51.000",
      "text": "این فاراموسی که شما بسیارید این شیخ همیدو برای آزیزو هست"
    },
    {
      "id": 67,
      "start": 13972.0,
      "end": 13974.0,
      "formatted_start": "03:52:52.000",
      "formatted_end": "03:52:54.000",
      "text": "هر یکی نیاز خورنن نداره"
    },
    {
      "id": 68,
      "start": 13974.0,
      "end": 13977.0,
      "formatted_start": "03:52:54.000",
      "formatted_end": "03:52:57.000",
      "text": "نه عزیزو بگیر این هماله حانوی کیانه"
    },
    {
      "id": 69,
      "start": 13977.0,
      "end": 14007.0,
      "formatted_start": "03:52:57.000",
      "formatted_end": "03:53:27.000",
      "text": "نه نه نه نه نه نه نه نه نه نه نه نه نه نه نه نه نه نه نه نه نه نه نه نه نه نه نه نه نه نه نه نه نه نه نه نه نه نه نه نه نه نه نه نه نه نه نه نه نه نه نه نه نه نه نه نه نه نه نه نه نه نه نه نه نه نه نه نه نه نه نه نه نه نه نه نه نه نه نه نه نه نه نه نه نه نه نه نه نه نه نه نه نه نه نه نه نه نه نه نه نه نه نه نه نه نه نه نه نه نه نه ن"
    },
    {
      "id": 70,
      "start": 14007.0,
      "end": 14009.0,
      "formatted_start": "03:53:27.000",
      "formatted_end": "03:53:29.000",
      "text": "اسپریه یا ترکون بیدید"
    },
    {
      "id": 71,
      "start": 14009.0,
      "end": 14013.0,
      "formatted_start": "03:53:29.000",
      "formatted_end": "03:53:33.000",
      "text": "خوب و اصلا می کنید در پشت رو بردارید و اصلا می کنید به دمیار"
    },
    {
      "id": 72,
      "start": 14013.0,
      "end": 14015.0,
      "formatted_start": "03:53:33.000",
      "formatted_end": "03:53:35.000",
      "text": "مثلا این"
    },
    {
      "id": 73,
      "start": 14015.0,
      "end": 14017.0,
      "formatted_start": "03:53:35.000",
      "formatted_end": "03:53:37.000",
      "text": "پریان"
    },
    {
      "id": 74,
      "start": 14017.0,
      "end": 14019.0,
      "formatted_start": "03:53:37.000",
      "formatted_end": "03:53:39.000",
      "text": "یک"
    },
    {
      "id": 75,
      "start": 14019.0,
      "end": 14021.0,
      "formatted_start": "03:53:39.000",
      "formatted_end": "03:53:41.000",
      "text": "دو بزنید"
    },
    {
      "id": 76,
      "start": 14021.0,
      "end": 14023.0,
      "formatted_start": "03:53:41.000",
      "formatted_end": "03:53:43.000",
      "text": "ده ثانیه صبر می کنید و بردارید"
    },
    {
      "id": 77,
      "start": 14023.0,
      "end": 14025.0,
      "formatted_start": "03:53:43.000",
      "formatted_end": "03:53:45.000",
      "text": "آها این اسپریه خارج نشست"
    },
    {
      "id": 78,
      "start": 14025.0,
      "end": 14027.0,
      "formatted_start": "03:53:45.000",
      "formatted_end": "03:53:47.000",
      "text": "آه خیلی آره"
    },
    {
      "id": 79,
      "start": 14027.0,
      "end": 14029.0,
      "formatted_start": "03:53:47.000",
      "formatted_end": "03:53:49.000",
      "text": "تمام"
    },
    {
      "id": 80,
      "start": 14029.0,
      "end": 14031.0,
      "formatted_start": "03:53:49.000",
      "formatted_end": "03:53:51.000",
      "text": "خوشمانده از درکار کنه شما"
    },
    {
      "id": 81,
      "start": 14031.0,
      "end": 14033.0,
      "formatted_start": "03:53:51.000",
      "formatted_end": "03:53:53.000",
      "text": "ماما از درکار کنه شما"
    },
    {
      "id": 82,
      "start": 14033.0,
      "end": 14035.0,
      "formatted_start": "03:53:53.000",
      "formatted_end": "03:53:55.000",
      "text": "بیا"
    },
    {
      "id": 83,
      "start": 14035.0,
      "end": 14037.16,
      "formatted_start": "03:53:55.000",
      "formatted_end": "03:53:57.160",
      "text": "همستون باید سپسر از من خیلی ها شما باشید"
    },
    {
      "id": 84,
      "start": 14037.16,
      "end": 14037.94,
      "formatted_start": "03:53:57.160",
      "formatted_end": "03:53:57.940",
      "text": "بیا عزیزم"
    },
    {
      "id": 85,
      "start": 14037.94,
      "end": 14039.04,
      "formatted_start": "03:53:57.940",
      "formatted_end": "03:53:59.040",
      "text": "کشکر بپرم"
    },
    {
      "id": 86,
      "start": 14039.04,
      "end": 14041.04,
      "formatted_start": "03:53:59.040",
      "formatted_end": "03:54:01.040",
      "text": "باید بپرم"
    },
    {
      "id": 87,
      "start": 14041.04,
      "end": 14043.0,
      "formatted_start": "03:54:01.040",
      "formatted_end": "03:54:03.000",
      "text": "باید بپرم"
    },
    {
