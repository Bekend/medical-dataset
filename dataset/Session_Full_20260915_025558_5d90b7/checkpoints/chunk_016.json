  "stt_segments": [
    {
      "id": 0,
      "start": 4800.0,
      "end": 4830.0,
      "formatted_start": "01:20:00.000",
      "formatted_end": "01:20:30.000",
      "text": "باید بردارید که باید بردارید که باید بردارید که باید بردارید که باید بردارید که باید بردارید که باید بردارید که باید بردارید که باید بردارید که باید بردارید که باید بردارید که باید بردارید که باید بردارید که باید بردارید که باید بردارید که باید بردارید که باید بردارید که باید بردارید که باید برد"
    },
    {
      "id": 1,
      "start": 4830.0,
      "end": 4849.06,
      "formatted_start": "01:20:30.000",
      "formatted_end": "01:20:49.060",
      "text": "از جدی زنگ داده دیگه اون روز اهرپا که بچه همون رو بودیم خوهرم"
    },
    {
      "id": 2,
      "start": 4849.06,
      "end": 4852.62,
      "formatted_start": "01:20:49.060",
      "formatted_end": "01:20:52.620",
      "text": "بعد میگه حالا تب داره به خانموشون پیام داره"
    },
    {
      "id": 3,
      "start": 4852.62,
      "end": 4855.92,
      "formatted_start": "01:20:52.620",
      "formatted_end": "01:20:55.920",
      "text": "خانموشون اون رو براتون بده که خانموشون شیاب داد"
    },
    {
      "id": 4,
      "start": 4855.92,
      "end": 4860.92,
      "formatted_start": "01:20:55.920",
      "formatted_end": "01:21:00.920",
      "text": "اما اگر با شیاب خوبه، با شیاب نیز همچنین بخوایید"
    },
    {
      "id": 5,
      "start": 4860.92,
      "end": 4863.92,
      "formatted_start": "01:21:00.920",
      "formatted_end": "01:21:03.920",
      "text": "بخوایید بس اون روی به صحبت همچنین ترداره"
    },
    {
      "id": 6,
      "start": 4863.92,
      "end": 4865.92,
      "formatted_start": "01:21:03.920",
      "formatted_end": "01:21:05.920",
      "text": "بخوایید به همچنین اوپر بخوایید"
    },
    {
      "id": 7,
      "start": 4869.92,
      "end": 4871.92,
      "formatted_start": "01:21:09.920",
      "formatted_end": "01:21:11.920",
      "text": "باید شما بخوایید بگو"
    },
    {
      "id": 8,
      "start": 4871.92,
      "end": 4872.92,
      "formatted_start": "01:21:11.920",
      "formatted_end": "01:21:12.920",
      "text": "بخوایید بخوایید"
    },
    {
      "id": 9,
      "start": 4874.92,
      "end": 4875.92,
      "formatted_start": "01:21:14.920",
      "formatted_end": "01:21:15.920",
      "text": "ای خواهی برن"
    },
    {
      "id": 10,
      "start": 4875.92,
      "end": 4876.92,
      "formatted_start": "01:21:15.920",
      "formatted_end": "01:21:16.920",
      "text": "چه؟"
    },
    {
      "id": 11,
      "start": 4876.92,
      "end": 4877.92,
      "formatted_start": "01:21:16.920",
      "formatted_end": "01:21:17.920",
      "text": "ببین"
    },
    {
      "id": 12,
      "start": 4878.92,
      "end": 4880.92,
      "formatted_start": "01:21:18.920",
      "formatted_end": "01:21:20.920",
      "text": "ببین چاییه، چایی تعم داره"
    },
    {
      "id": 13,
      "start": 4880.92,
      "end": 4886.92,
      "formatted_start": "01:21:20.920",
      "formatted_end": "01:21:26.920",
      "text": "چایی زیاه و درچین و گنچه و زنجلیه"
    },
    {
      "id": 14,
      "start": 4886.92,
      "end": 4888.92,
      "formatted_start": "01:21:26.920",
      "formatted_end": "01:21:28.920",
      "text": "یه تونم عدنه آوردم"
    },
    {
      "id": 15,
      "start": 4888.92,
      "end": 4890.92,
      "formatted_start": "01:21:28.920",
      "formatted_end": "01:21:30.920",
      "text": "مچیا"
    },
    {
      "id": 16,
      "start": 4890.92,
      "end": 4892.92,
      "formatted_start": "01:21:30.920",
      "formatted_end": "01:21:32.920",
      "text": "مچیا"
    },
    {
      "id": 17,
      "start": 4892.92,
      "end": 4894.92,
      "formatted_start": "01:21:32.920",
      "formatted_end": "01:21:34.920",
      "text": "این طرف خوبه"
    },
    {
      "id": 18,
      "start": 4894.92,
      "end": 4896.92,
      "formatted_start": "01:21:34.920",
      "formatted_end": "01:21:36.920",
      "text": "خوشیده"
    },
    {
      "id": 19,
      "start": 4896.92,
      "end": 4898.92,
      "formatted_start": "01:21:36.920",
      "formatted_end": "01:21:38.920",
      "text": "خوشیده"
    },
    {
      "id": 20,
      "start": 4898.92,
      "end": 4900.92,
      "formatted_start": "01:21:38.920",
      "formatted_end": "01:21:40.920",
      "text": "بینم براتا"
    },
    {
      "id": 21,
      "start": 4900.92,
      "end": 4902.92,
      "formatted_start": "01:21:40.920",
      "formatted_end": "01:21:42.920",
      "text": "بینم جایی بینم"
    },
    {
      "id": 22,
      "start": 4902.92,
      "end": 4904.92,
      "formatted_start": "01:21:42.920",
      "formatted_end": "01:21:44.920",
      "text": "من اونجا چایی خوش ندارم"
    },
    {
      "id": 23,
      "start": 4904.92,
      "end": 4906.92,
      "formatted_start": "01:21:44.920",
      "formatted_end": "01:21:46.920",
      "text": "براتا"
    },
    {
      "id": 24,
      "start": 4906.92,
      "end": 4908.92,
      "formatted_start": "01:21:46.920",
      "formatted_end": "01:21:48.920",
      "text": "براتا"
    },
    {
      "id": 25,
      "start": 4910.92,
      "end": 4926.92,
      "formatted_start": "01:21:50.920",
      "formatted_end": "01:22:06.920",
      "text": "موسیقی"
    },
    {
      "id": 26,
      "start": 4940.92,
      "end": 4948.72,
      "formatted_start": "01:22:20.920",
      "formatted_end": "01:22:28.720",
      "text": "خب دکتر، من برم آب رزش بینی خیلی شدید، کاما، صرفه، خسخس"
    },
    {
      "id": 27,
      "start": 4948.72,
      "end": 4949.52,
      "formatted_start": "01:22:28.720",
      "formatted_end": "01:22:29.520",
      "text": "ترچه ای؟"
    },
    {
      "id": 28,
      "start": 4949.52,
      "end": 4950.32,
      "formatted_start": "01:22:29.520",
      "formatted_end": "01:22:30.320",
      "text": "ترچه ای"
    },
    {
      "id": 29,
      "start": 4950.32,
      "end": 4951.72,
      "formatted_start": "01:22:30.320",
      "formatted_end": "01:22:31.720",
      "text": "نداره، چند ماه شد؟"
    },
    {
      "id": 30,
      "start": 4951.72,
      "end": 4954.72,
      "formatted_start": "01:22:31.720",
      "formatted_end": "01:22:34.720",
      "text": "الان ده ماه، نه ماه و نمیدونم"
    },
    {
      "id": 31,
      "start": 4955.92,
      "end": 4958.72,
      "formatted_start": "01:22:35.920",
      "formatted_end": "01:22:38.720",
      "text": "خب، ترشات بینیش همینجور آبکیه یا نمیدونم؟"
    },
    {
      "id": 32,
      "start": 4958.72,
      "end": 4962.72,
      "formatted_start": "01:22:38.720",
      "formatted_end": "01:22:42.720",
      "text": "قبلن قلیز و رنگی بود، الان فقط بیرنگ و آبکیه"
    },
    {
      "id": 33,
      "start": 4962.72,
      "end": 4963.72,
      "formatted_start": "01:22:42.720",
      "formatted_end": "01:22:43.720",
      "text": "آمین، بشین"
    },
    {
      "id": 34,
      "start": 4965.12,
      "end": 4966.32,
      "formatted_start": "01:22:45.120",
      "formatted_end": "01:22:46.320",
      "text": "آتون بزن"
    },
    {
      "id": 35,
      "start": 4970.92,
      "end": 4972.92,
      "formatted_start": "01:22:50.920",
      "formatted_end": "01:22:52.920",
      "text": "دستشو بگی؟"
    },
    {
      "id": 36,
      "start": 4974.92,
      "end": 4976.92,
      "formatted_start": "01:22:54.920",
      "formatted_end": "01:22:56.920",
      "text": "آفرین"
    },
    {
      "id": 37,
      "start": 4976.92,
      "end": 4978.92,
      "formatted_start": "01:22:56.920",
      "formatted_end": "01:22:58.920",
      "text": "آفرین"
    },
    {
      "id": 38,
      "start": 4978.92,
      "end": 4980.92,
      "formatted_start": "01:22:58.920",
      "formatted_end": "01:23:00.920",
      "text": "آره، خشکست میکنه"
    },
    {
      "id": 39,
      "start": 4980.92,
      "end": 4982.92,
      "formatted_start": "01:23:00.920",
      "formatted_end": "01:23:02.920",
      "text": "سنگرش"
    },
    {
      "id": 40,
      "start": 4982.92,
      "end": 4984.92,
      "formatted_start": "01:23:02.920",
      "formatted_end": "01:23:04.920",
      "text": "روزا بیشتره صرفش یا شبا؟"
    },
    {
      "id": 41,
      "start": 4984.92,
      "end": 4986.92,
      "formatted_start": "01:23:04.920",
      "formatted_end": "01:23:06.920",
      "text": "صرفش قبل اینکه هم بهتر بود"
    },
    {
      "id": 42,
      "start": 4986.92,
      "end": 4988.92,
      "formatted_start": "01:23:06.920",
      "formatted_end": "01:23:08.920",
      "text": "از دیروز بیشتر شد"
    },
    {
      "id": 43,
      "start": 4988.92,
      "end": 4990.92,
      "formatted_start": "01:23:08.920",
      "formatted_end": "01:23:10.920",
      "text": "شب تا صبح هم صرفه کرد؟"
    },
    {
      "id": 44,
      "start": 4990.92,
      "end": 4992.92,
      "formatted_start": "01:23:10.920",
      "formatted_end": "01:23:12.920",
      "text": "نه"
    },
    {
      "id": 45,
      "start": 4992.92,
      "end": 4994.92,
      "formatted_start": "01:23:12.920",
      "formatted_end": "01:23:14.920",
      "text": "و بیشتر وقتی که قطره شو میدن"
    },
    {
      "id": 46,
      "start": 4994.92,
      "end": 4996.92,
      "formatted_start": "01:23:14.920",
      "formatted_end": "01:23:16.920",
      "text": "قطره همه اینجا شده"
    },
    {
      "id": 47,
      "start": 4996.92,
      "end": 4998.92,
      "formatted_start": "01:23:16.920",
      "formatted_end": "01:23:18.920",
      "text": "یک چیزی بخوره"
    },
    {
      "id": 48,
      "start": 4998.92,
      "end": 5000.92,
      "formatted_start": "01:23:18.920",
      "formatted_end": "01:23:20.920",
      "text": "درمی تو باز کن"
    },
    {
      "id": 49,
      "start": 5000.92,
      "end": 5002.92,
      "formatted_start": "01:23:20.920",
      "formatted_end": "01:23:22.920",
      "text": "آه از این آه"
    },
    {
      "id": 50,
      "start": 5002.92,
      "end": 5004.92,
      "formatted_start": "01:23:22.920",
      "formatted_end": "01:23:24.920",
      "text": "آه جنان آه"
    },
    {
      "id": 51,
      "start": 5004.92,
      "end": 5008.92,
      "formatted_start": "01:23:24.920",
      "formatted_end": "01:23:28.920",
      "text": "چقدر مقابلت میکنه"
    },
    {
      "id": 52,
      "start": 5008.92,
      "end": 5010.92,
      "formatted_start": "01:23:28.920",
      "formatted_end": "01:23:30.920",
      "text": "شب خواهد گوششو ببینم دو باری گردشو بگم"
    },
    {
      "id": 53,
      "start": 5010.92,
      "end": 5012.92,
      "formatted_start": "01:23:30.920",
      "formatted_end": "01:23:32.920",
      "text": "باش باش عزیزم باش"
    },
    {
      "id": 54,
      "start": 5012.92,
      "end": 5014.92,
      "formatted_start": "01:23:32.920",
      "formatted_end": "01:23:34.920",
      "text": "بینیشو بگیر شون بینیش گردید"
    },
    {
      "id": 55,
      "start": 5014.92,
      "end": 5016.92,
      "formatted_start": "01:23:34.920",
      "formatted_end": "01:23:36.920",
      "text": "پرهه نه بتونه"
    },
    {
      "id": 56,
      "start": 5016.92,
      "end": 5018.92,
      "formatted_start": "01:23:36.920",
      "formatted_end": "01:23:38.920",
      "text": "باش"
    },
    {
      "id": 57,
      "start": 5020.92,
      "end": 5022.92,
      "formatted_start": "01:23:40.920",
      "formatted_end": "01:23:42.920",
      "text": "جانا دیدی نا"
    },
    {
      "id": 58,
      "start": 5024.92,
      "end": 5026.92,
      "formatted_start": "01:23:44.920",
      "formatted_end": "01:23:46.920",
      "text": "دیدی نا"
    },
    {
      "id": 59,
      "start": 5026.92,
      "end": 5028.92,
      "formatted_start": "01:23:46.920",
      "formatted_end": "01:23:48.920",
      "text": "اینجا بگیر"
    },
    {
      "id": 60,
      "start": 5028.92,
      "end": 5030.92,
      "formatted_start": "01:23:48.920",
      "formatted_end": "01:23:50.920",
      "text": "اینجا بگیر"
    },
    {
      "id": 61,
      "start": 5030.92,
      "end": 5032.92,
      "formatted_start": "01:23:50.920",
      "formatted_end": "01:23:52.920",
      "text": "اینجا بگیر"
    },
    {
      "id": 62,
      "start": 5032.92,
      "end": 5034.92,
      "formatted_start": "01:23:52.920",
      "formatted_end": "01:23:54.920",
      "text": "اینجا بگیر"
    },
    {
