  "stt_segments": [
    {
      "id": 0,
      "start": 14100.0,
      "end": 14129.98,
      "formatted_start": "03:55:00.000",
      "formatted_end": "03:55:29.980",
      "text": "بیمار در مطب پزشکی، معاینه بیمار در مطب پزشکی، داروها، آزمایش و نسخه."
    },
    {
      "id": 1,
      "start": 14130.0,
      "end": 14133.0,
      "formatted_start": "03:55:30.000",
      "formatted_end": "03:55:33.000",
      "text": "این کلید ساختمون هست مالا"
    },
    {
      "id": 2,
      "start": 14133.0,
      "end": 14135.0,
      "formatted_start": "03:55:33.000",
      "formatted_end": "03:55:35.000",
      "text": "اما فیلا ها کمی ساختمون"
    },
    {
      "id": 3,
      "start": 14135.0,
      "end": 14139.0,
      "formatted_start": "03:55:35.000",
      "formatted_end": "03:55:39.000",
      "text": "این کلید رو به دستشون در این صنوه نیستم"
    },
    {
      "id": 4,
      "start": 14139.0,
      "end": 14142.0,
      "formatted_start": "03:55:39.000",
      "formatted_end": "03:55:42.000",
      "text": "اگر کلید ساختمون رو از آره"
    },
    {
      "id": 5,
      "start": 14142.0,
      "end": 14144.0,
      "formatted_start": "03:55:42.000",
      "formatted_end": "03:55:44.000",
      "text": "آره من رو به روی گرفتم"
    },
    {
      "id": 6,
      "start": 14144.0,
      "end": 14148.0,
      "formatted_start": "03:55:44.000",
      "formatted_end": "03:55:48.000",
      "text": "اگر کلید اینجا هم بهشون بده"
    },
    {
      "id": 7,
      "start": 14148.0,
      "end": 14151.0,
      "formatted_start": "03:55:48.000",
      "formatted_end": "03:55:51.000",
      "text": "که مثلا مواد شوینده اینا خواستن"
    },
    {
      "id": 8,
      "start": 14151.0,
      "end": 14153.0,
      "formatted_start": "03:55:51.000",
      "formatted_end": "03:55:53.000",
      "text": "از اینجا بگیرن"
    },
    {
      "id": 9,
      "start": 14153.0,
      "end": 14156.0,
      "formatted_start": "03:55:53.000",
      "formatted_end": "03:55:56.000",
      "text": "شوینده چیزی نداریم کاملوچه پر بایتکس داریم"
    },
    {
      "id": 10,
      "start": 14156.0,
      "end": 14158.0,
      "formatted_start": "03:55:56.000",
      "formatted_end": "03:55:58.000",
      "text": "باید برخواهیم که چیزی برمیده"
    },
    {
      "id": 11,
      "start": 14158.0,
      "end": 14160.0,
      "formatted_start": "03:55:58.000",
      "formatted_end": "03:56:00.000",
      "text": "بچه زنگمون"
    },
    {
      "id": 12,
      "start": 14160.0,
      "end": 14162.0,
      "formatted_start": "03:56:00.000",
      "formatted_end": "03:56:02.000",
      "text": "اگه خواستن میگرد"
    },
    {
      "id": 13,
      "start": 14162.0,
      "end": 14164.0,
      "formatted_start": "03:56:02.000",
      "formatted_end": "03:56:04.000",
      "text": "اینم را نیست نصف زمر میشه"
    },
    {
      "id": 14,
      "start": 14164.0,
      "end": 14166.0,
      "formatted_start": "03:56:04.000",
      "formatted_end": "03:56:06.000",
      "text": "بچه زنگی بزن"
    },
    {
      "id": 15,
      "start": 14166.0,
      "end": 14168.0,
      "formatted_start": "03:56:06.000",
      "formatted_end": "03:56:08.000",
      "text": "حالا اصلا یه جایی قرار بذار که بهشون اینم بگیر"
    },
    {
      "id": 16,
      "start": 14168.0,
      "end": 14170.0,
      "formatted_start": "03:56:08.000",
      "formatted_end": "03:56:10.000",
      "text": "باش"
    },
    {
      "id": 17,
      "start": 14170.0,
      "end": 14172.0,
      "formatted_start": "03:56:10.000",
      "formatted_end": "03:56:12.000",
      "text": "شما هم میپرسی بازن"
    },
    {
      "id": 18,
      "start": 14172.0,
      "end": 14174.0,
      "formatted_start": "03:56:12.000",
      "formatted_end": "03:56:14.000",
      "text": "شاور برپرس"
    },
    {
      "id": 19,
      "start": 14174.0,
      "end": 14176.0,
      "formatted_start": "03:56:14.000",
      "formatted_end": "03:56:16.000",
      "text": "بزن بزن"
    },
    {
      "id": 20,
      "start": 14176.0,
      "end": 14178.0,
      "formatted_start": "03:56:16.000",
      "formatted_end": "03:56:18.000",
      "text": "بازونت هم بزن"
    },
    {
      "id": 21,
      "start": 14178.0,
      "end": 14180.0,
      "formatted_start": "03:56:18.000",
      "formatted_end": "03:56:20.000",
      "text": "شما هم نیست نیست"
    },
    {
      "id": 22,
      "start": 14180.0,
      "end": 14182.0,
      "formatted_start": "03:56:20.000",
      "formatted_end": "03:56:22.000",
      "text": "شما هم نیست نیست"
    },
    {
      "id": 23,
      "start": 14182.0,
