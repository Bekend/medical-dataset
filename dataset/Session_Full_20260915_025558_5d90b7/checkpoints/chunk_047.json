      "end": 14188.0,
      "formatted_start": "03:56:24.000",
      "formatted_end": "03:56:28.000",
      "text": "برخانده جان، خوشکلش خودتش"
    },
    {
      "id": 25,
      "start": 14188.0,
      "end": 14190.0,
      "formatted_start": "03:56:28.000",
      "formatted_end": "03:56:30.000",
      "text": "خودتش خودتش، خودتش خودتش"
    },
    {
      "id": 26,
      "start": 14190.0,
      "end": 14192.0,
      "formatted_start": "03:56:30.000",
      "formatted_end": "03:56:32.000",
      "text": "خودتش خودتش خودتش"
    },
    {
      "id": 27,
      "start": 14214.0,
      "end": 14243.98,
      "formatted_start": "03:56:54.000",
      "formatted_end": "03:57:23.980",
      "text": "موسیقی در موسیقی درسته"
    },
    {
