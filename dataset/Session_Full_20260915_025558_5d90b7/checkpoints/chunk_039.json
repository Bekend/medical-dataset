  "stt_segments": [
    {
      "id": 0,
      "start": 11700.0,
      "end": 11710.0,
      "formatted_start": "03:15:00.000",
      "formatted_end": "03:15:10.000",
      "text": "از این موضوع هم دست به لیوان، شیر، مان، چال، دو، صوب، آب میوه، تو هر مایهی میتونی داری."
    },
    {
      "id": 1,
      "start": 11710.0,
      "end": 11726.0,
      "formatted_start": "03:15:10.000",
      "formatted_end": "03:15:26.000",
      "text": "مثلا توی چای برسه چون چایی داب گرمه بهتر حل میشه این تشکو، بعد هیچ رنگش عرض میشه، نه مزه داره، هیچی نه شیره نه نشوره، هیچ رنگ نه مزه نداره، اصلا بچه معتبر جنبشه."
    },
    {
      "id": 2,
      "start": 11726.0,
      "end": 11732.0,
      "formatted_start": "03:15:26.000",
      "formatted_end": "03:15:32.000",
      "text": "اگر دادی که کمش کار کرد که چه بهتر"
    },
    {
      "id": 3,
      "start": 11732.0,
      "end": 11736.0,
      "formatted_start": "03:15:32.000",
      "formatted_end": "03:15:36.000",
      "text": "اگر کار نکرد فرداش رو یه شیاخ رو بشن"
    },
    {
      "id": 4,
      "start": 11736.0,
      "end": 11741.0,
      "formatted_start": "03:15:36.000",
      "formatted_end": "03:15:41.000",
      "text": "با یه پوماد"
    },
    {
      "id": 5,
      "start": 11741.0,
      "end": 11745.0,
      "formatted_start": "03:15:41.000",
      "formatted_end": "03:15:45.000",
      "text": "این شیاخ رو سرشو پوماد میزنی براش میزن"
    },
    {
      "id": 6,
      "start": 11745.0,
      "end": 11749.0,
      "formatted_start": "03:15:45.000",
      "formatted_end": "03:15:49.000",
      "text": "این باعث میشه که وقتی میخواد مقصود بکنه دردش نکرده"
    },
    {
      "id": 7,
      "start": 11749.0,
      "end": 11753.0,
      "formatted_start": "03:15:49.000",
      "formatted_end": "03:15:53.000",
      "text": "امروز هم مقعدشو با پوماده چرب بکنه"
    },
    {
      "id": 8,
      "start": 11753.0,
      "end": 11759.0,
      "formatted_start": "03:15:53.000",
      "formatted_end": "03:15:59.000",
      "text": "کل روز یک بار، پومادش رو براش بذار تا پنج روز"
    },
    {
      "id": 9,
      "start": 11759.0,
      "end": 11763.0,
      "formatted_start": "03:15:59.000",
      "formatted_end": "03:16:03.000",
      "text": "خب، پد فردا هم که اگر کار کرد کلیکر بی کنه"
    },
    {
      "id": 10,
      "start": 11763.0,
      "end": 11765.0,
      "formatted_start": "03:16:03.000",
      "formatted_end": "03:16:05.000",
      "text": "کلیکر در مقابلت میکنه؟"
    },
    {
      "id": 11,
      "start": 11765.0,
      "end": 11767.0,
      "formatted_start": "03:16:05.000",
      "formatted_end": "03:16:07.000",
      "text": "بابادو باید میدیم داخل بره یعنی با چوب بشون"
    },
    {
      "id": 12,
      "start": 11767.0,
      "end": 11770.0,
      "formatted_start": "03:16:07.000",
      "formatted_end": "03:16:10.000",
      "text": "نه نه، نه، همین بیرون همه"
    },
    {
      "id": 13,
      "start": 11770.0,
      "end": 11773.0,
      "formatted_start": "03:16:10.000",
      "formatted_end": "03:16:13.000",
      "text": "پدرشو باز کنه، آمد خب"
    },
    {
      "id": 14,
      "start": 11773.0,
      "end": 11777.0,
      "formatted_start": "03:16:13.000",
      "formatted_end": "03:16:17.000",
      "text": "خب، این پودر رو روزی یه بار میدی"
    },
    {
      "id": 15,
      "start": 11777.0,
      "end": 11780.0,
      "formatted_start": "03:16:17.000",
      "formatted_end": "03:16:20.000",
      "text": "اگه دیدی با این روزی یه بار هر روز داره کار میکنه"
    },
    {
      "id": 16,
      "start": 11780.0,
      "end": 11783.0,
      "formatted_start": "03:16:20.000",
      "formatted_end": "03:16:23.000",
      "text": "اگر کار میکنه شیاخون فقط یک باری میبرد"
    },
    {
      "id": 17,
      "start": 11783.0,
      "end": 11787.0,
      "formatted_start": "03:16:23.000",
      "formatted_end": "03:16:27.000",
      "text": "اگر دیدی با همین دیگه داره کار میکنه هر روز بهش میدی"
    },
    {
      "id": 18,
      "start": 11787.0,
      "end": 11789.0,
      "formatted_start": "03:16:27.000",
      "formatted_end": "03:16:29.000",
      "text": "تا دو هفته"
    },
    {
      "id": 19,
      "start": 11789.0,
      "end": 11793.0,
      "formatted_start": "03:16:29.000",
      "formatted_end": "03:16:33.000",
      "text": "بعد میکنی یه قاشق مربو خوری"
    },
    {
      "id": 20,
      "start": 11793.0,
      "end": 11798.0,
      "formatted_start": "03:16:33.000",
      "formatted_end": "03:16:38.000",
      "text": "بعد چند روز بعدش میکنی قاشق چای خوری"
    },
    {
      "id": 21,
      "start": 11798.0,
      "end": 11800.0,
      "formatted_start": "03:16:38.000",
      "formatted_end": "03:16:40.000",
      "text": "اگه خوب بود دیگه بعدش خوری"
    },
    {
      "id": 22,
      "start": 11800.0,
      "end": 11801.0,
      "formatted_start": "03:16:40.000",
      "formatted_end": "03:16:41.000",
      "text": "کل؟"
    },
    {
      "id": 23,
      "start": 11801.0,
      "end": 11802.0,
      "formatted_start": "03:16:41.000",
      "formatted_end": "03:16:42.000",
      "text": "اگر نه"
    },
    {
      "id": 24,
      "start": 11802.0,
      "end": 11804.0,
      "formatted_start": "03:16:42.000",
      "formatted_end": "03:16:44.000",
      "text": "بعد عکس دیدی روزی یه بار میدی"
    },
    {
      "id": 25,
      "start": 11804.0,
      "end": 11806.0,
      "formatted_start": "03:16:44.000",
      "formatted_end": "03:16:46.000",
      "text": "دیگه بازم هنوز کار نمیکنه"
    },
    {
      "id": 26,
      "start": 11806.0,
      "end": 11808.0,
      "formatted_start": "03:16:46.000",
      "formatted_end": "03:16:48.000",
      "text": "می کنی روزی دو بار"
    },
    {
      "id": 27,
      "start": 11808.0,
      "end": 11811.06,
      "formatted_start": "03:16:48.000",
      "formatted_end": "03:16:51.060",
      "text": "خب؟ کار نکرد روز نیسته با"
    },
    {
      "id": 28,
      "start": 11811.06,
      "end": 11812.56,
      "formatted_start": "03:16:51.060",
      "formatted_end": "03:16:52.560",
      "text": "این مهمان باست که..."
    },
    {
      "id": 29,
      "start": 11812.56,
      "end": 11814.06,
      "formatted_start": "03:16:52.560",
      "formatted_end": "03:16:54.060",
      "text": "بله، خب؟"
    },
    {
      "id": 30,
      "start": 11814.06,
      "end": 11816.64,
      "formatted_start": "03:16:54.060",
      "formatted_end": "03:16:56.640",
      "text": "بعد دیگه حالا از نظر شدم که"
    },
    {
      "id": 31,
      "start": 11816.64,
      "end": 11818.9,
      "formatted_start": "03:16:56.640",
      "formatted_end": "03:16:58.900",
      "text": "مثلا صحبت کردن"
    },
    {
      "id": 32,
      "start": 11818.9,
      "end": 11821.34,
      "formatted_start": "03:16:58.900",
      "formatted_end": "03:17:01.340",
      "text": "PPR باید پیز بیمون ندارن فعلا"
    },
    {
      "id": 33,
      "start": 11821.34,
      "end": 11822.84,
      "formatted_start": "03:17:01.340",
      "formatted_end": "03:17:02.840",
      "text": "از اینجا باید برداریم"
    },
    {
      "id": 34,
      "start": 11822.84,
      "end": 11825.6,
      "formatted_start": "03:17:02.840",
      "formatted_end": "03:17:05.600",
      "text": "بعد پس اگه کار نکرد فرد رو براش شیافه بیداریم"
    },
    {
      "id": 35,
      "start": 11825.6,
      "end": 11826.8,
      "formatted_start": "03:17:05.600",
      "formatted_end": "03:17:06.800",
      "text": "آره، آره"
    },
    {
      "id": 36,
      "start": 11826.8,
      "end": 11829.24,
      "formatted_start": "03:17:06.800",
      "formatted_end": "03:17:09.240",
      "text": "الان یه قشو غذا سالی بده ایشان رو تشب کن"
    },
    {
      "id": 37,
      "start": 11829.24,
      "end": 11829.56,
      "formatted_start": "03:17:09.240",
      "formatted_end": "03:17:09.560",
      "text": "همون"
    },
    {
      "id": 38,
      "start": 11829.56,
      "end": 11831.76,
      "formatted_start": "03:17:09.560",
      "formatted_end": "03:17:11.760",
      "text": "من دو پیده سوال دیگه هم مرشد شما دارم"
    },
    {
      "id": 39,
      "start": 11831.76,
      "end": 11838.52,
      "formatted_start": "03:17:11.760",
      "formatted_end": "03:17:18.520",
      "text": "دیگه روز صبح که اولواروز دو سه لحومه فقط غذا کنید، دیگه تا این ارامون فقط آب خورده"
    },
    {
      "id": 40,
      "start": 11838.52,
      "end": 11839.76,
      "formatted_start": "03:17:18.520",
      "formatted_end": "03:17:19.760",
      "text": "موقعی که تب می کنه"
    },
    {
      "id": 41,
      "start": 11839.76,
      "end": 11840.76,
      "formatted_start": "03:17:19.760",
      "formatted_end": "03:17:20.760",
      "text": "بی اشتها می شود"
    },
    {
      "id": 42,
      "start": 11840.76,
      "end": 11844.76,
      "formatted_start": "03:17:20.760",
      "formatted_end": "03:17:24.760",
      "text": "آن شربت ها رو های پراکید و امو بیروفرم ها"
    },
    {
      "id": 43,
      "start": 11844.76,
      "end": 11846.76,
      "formatted_start": "03:17:24.760",
      "formatted_end": "03:17:26.760",
      "text": "هیچ غذایی که اینو خوردید نه اشکالی نداره"
    },
    {
      "id": 44,
      "start": 11846.76,
      "end": 11848.76,
      "formatted_start": "03:17:26.760",
      "formatted_end": "03:17:28.760",
      "text": "نه نه آب فرامون ترش بدید"
    },
    {
      "id": 45,
      "start": 11848.76,
      "end": 11853.76,
      "formatted_start": "03:17:28.760",
      "formatted_end": "03:17:33.760",
      "text": "حالا از دامرافی که از اشکال نداره، ولی بروفرم اگه خواستید بدید آب داشت"
    },
    {
      "id": 46,
      "start": 11853.76,
      "end": 11859.76,
      "formatted_start": "03:17:33.760",
      "formatted_end": "03:17:39.760",
      "text": "خداف این باز هست که از این کارهایی باید برداریم"
    },
    {
      "id": 47,
      "start": 11859.76,
      "end": 11865.76,
      "formatted_start": "03:17:39.760",
      "formatted_end": "03:17:45.760",
      "text": "اما این کارهایی که از این کارهایی برداریم"
    },
    {
      "id": 48,
      "start": 11865.76,
      "end": 11871.76,
      "formatted_start": "03:17:45.760",
      "formatted_end": "03:17:51.760",
      "text": "از این کارهایی که از این کارهایی برداریم"
    },
    {
      "id": 49,
      "start": 11871.76,
      "end": 11877.76,
      "formatted_start": "03:17:51.760",
      "formatted_end": "03:17:57.760",
      "text": "از این کارهایی که از این کارهایی برداریم"
    },
    {
      "id": 50,
      "start": 11877.76,
      "end": 11879.76,
      "formatted_start": "03:17:57.760",
      "formatted_end": "03:17:59.760",
      "text": "خداحافظ"
    },
    {
      "id": 51,
      "start": 11879.76,
      "end": 11881.76,
      "formatted_start": "03:17:59.760",
      "formatted_end": "03:18:01.760",
      "text": "خداحافظ"
    },
    {
      "id": 52,
      "start": 11881.76,
      "end": 11883.76,
      "formatted_start": "03:18:01.760",
      "formatted_end": "03:18:03.760",
      "text": "ماستینو که اشتگاه نکرده"
    },
    {
      "id": 53,
      "start": 11883.76,
      "end": 11885.76,
      "formatted_start": "03:18:03.760",
      "formatted_end": "03:18:05.760",
      "text": "خداحافظ کنم"
    },
    {
      "id": 54,
      "start": 11885.76,
      "end": 11887.76,
      "formatted_start": "03:18:05.760",
      "formatted_end": "03:18:07.760",
      "text": "خیلی دختر خوبی هست"
    },
    {
      "id": 55,
      "start": 11887.76,
      "end": 11889.76,
      "formatted_start": "03:18:07.760",
      "formatted_end": "03:18:09.760",
      "text": "یک روزو غشنگرد"
    },
    {
      "id": 56,
      "start": 11889.76,
      "end": 11891.76,
      "formatted_start": "03:18:09.760",
      "formatted_end": "03:18:11.760",
      "text": "خداحافظ"
    },
    {
      "id": 57,
      "start": 11891.76,
      "end": 11893.76,
      "formatted_start": "03:18:11.760",
      "formatted_end": "03:18:13.760",
      "text": "خداحافظ"
    },
    {
      "id": 58,
      "start": 11895.76,
      "end": 11897.76,
      "formatted_start": "03:18:15.760",
      "formatted_end": "03:18:17.760",
      "text": "سلامه"
    },
    {
      "id": 59,
      "start": 11897.76,
      "end": 11899.76,
      "formatted_start": "03:18:17.760",
      "formatted_end": "03:18:19.760",
      "text": "سلامه دوزم"
    },
    {
      "id": 60,
      "start": 11899.76,
      "end": 11901.76,
      "formatted_start": "03:18:19.760",
      "formatted_end": "03:18:21.760",
      "text": "مرسی خوبه"
    },
    {
      "id": 61,
      "start": 11901.76,
      "end": 11903.76,
      "formatted_start": "03:18:21.760",
      "formatted_end": "03:18:23.760",
      "text": "مرسی"
    },
    {
      "id": 62,
      "start": 11903.76,
      "end": 11905.76,
      "formatted_start": "03:18:23.760",
      "formatted_end": "03:18:25.760",
      "text": "مرسی"
    },
    {
      "id": 63,
      "start": 11905.76,
      "end": 11909.76,
      "formatted_start": "03:18:25.760",
      "formatted_end": "03:18:29.760",
      "text": "این رجل بی قراره که از اینجا بیشتر بیشتر بیشتر آبریزش داره"
    },
    {
      "id": 64,
      "start": 11909.76,
      "end": 11912.76,
      "formatted_start": "03:18:29.760",
      "formatted_end": "03:18:32.760",
      "text": "این رجل بی قراره که از اینجا کلن بخوردید"
    },
    {
      "id": 65,
      "start": 11912.76,
      "end": 11915.76,
      "formatted_start": "03:18:32.760",
      "formatted_end": "03:18:35.760",
      "text": "اینجا از اینجا حتی صبحونه بخورم"
    },
    {
      "id": 66,
      "start": 11915.76,
      "end": 11918.76,
      "formatted_start": "03:18:35.760",
      "formatted_end": "03:18:38.760",
      "text": "کلن توبه برد گریه گریه آبریزش شدید"
    },
    {
      "id": 67,
      "start": 11918.76,
      "end": 11920.76,
      "formatted_start": "03:18:38.760",
      "formatted_end": "03:18:40.760",
      "text": "تب چی؟"
    },
    {
      "id": 68,
      "start": 11920.76,
      "end": 11923.76,
      "formatted_start": "03:18:40.760",
      "formatted_end": "03:18:43.760",
      "text": "تب زیاد نردید"
    },
    {
      "id": 69,
      "start": 11923.76,
      "end": 11925.76,
      "formatted_start": "03:18:43.760",
      "formatted_end": "03:18:45.760",
      "text": "احساس کردم یک کچولو بیاد نردید"
    },
    {
      "id": 70,
      "start": 11925.76,
      "end": 11926.76,
      "formatted_start": "03:18:45.760",
      "formatted_end": "03:18:46.760",
      "text": "صرفه؟"
    },
    {
      "id": 71,
      "start": 11926.76,
      "end": 11929.76,
      "formatted_start": "03:18:46.760",
      "formatted_end": "03:18:49.760",
      "text": "نه هیچی فقط آن آبریزش رو بی قراره شدید"
    },
    {
      "id": 72,
      "start": 11929.76,
      "end": 11930.76,
      "formatted_start": "03:18:49.760",
      "formatted_end": "03:18:50.760",
      "text": "خوبی؟"
    },
    {
      "id": 73,
      "start": 11930.76,
      "end": 11932.76,
      "formatted_start": "03:18:50.760",
      "formatted_end": "03:18:52.760",
      "text": "بله"
    },
    {
      "id": 74,
      "start": 11932.76,
      "end": 11937.76,
      "formatted_start": "03:18:52.760",
      "formatted_end": "03:18:57.760",
      "text": "اینقدر آبرزش داره زخم شد کل اون تیز هستم"
    },
    {
      "id": 75,
      "start": 11937.76,
      "end": 11939.76,
      "formatted_start": "03:18:57.760",
      "formatted_end": "03:18:59.760",
      "text": "کم وقت شده الان؟"
    },
    {
      "id": 76,
      "start": 11939.76,
      "end": 11941.76,
      "formatted_start": "03:18:59.760",
      "formatted_end": "03:19:01.760",
      "text": "پونزه ماهش رو باز کرده"
    },
    {
      "id": 77,
      "start": 11941.76,
      "end": 11943.76,
      "formatted_start": "03:19:01.760",
      "formatted_end": "03:19:03.760",
      "text": "بعد آبرزش شب رو بیرنگ داره یا نه؟"
    },
    {
      "id": 78,
      "start": 11943.76,
      "end": 11948.76,
      "formatted_start": "03:19:03.760",
      "formatted_end": "03:19:08.760",
      "text": "یه زهر رنگی هم از دیروز شروع شده با بلی رنگی هم هست نیزره"
    },
    {
      "id": 79,
      "start": 11948.76,
      "end": 11953.76,
      "formatted_start": "03:19:08.760",
      "formatted_end": "03:19:13.760",
      "text": "بلی خیلی کشی ناروز زیاده"
    },
    {
      "id": 80,
      "start": 11953.76,
      "end": 11956.76,
      "formatted_start": "03:19:13.760",
      "formatted_end": "03:19:16.760",
      "text": "دیروز خاملتو چی این یو یو برد؟"
    },
    {
      "id": 81,
      "start": 11956.76,
      "end": 11957.76,
      "formatted_start": "03:19:16.760",
      "formatted_end": "03:19:17.760",
      "text": "نه بیرون"
    },
    {
      "id": 82,
      "start": 11957.76,
      "end": 11961.76,
      "formatted_start": "03:19:17.760",
      "formatted_end": "03:19:21.760",
      "text": "من گفتم یک چیز براش بگیرم و از درخواهانه گفتم نخود درده نخود"
    },
    {
      "id": 83,
      "start": 11961.76,
      "end": 11965.76,
      "formatted_start": "03:19:21.760",
      "formatted_end": "03:19:25.760",
      "text": "حالا بزار ما آینش خونیم که دیگه قراره ببینیم که شوشش چیزی نشده باشه"
    },
    {
      "id": 84,
      "start": 11965.76,
      "end": 11969.76,
      "formatted_start": "03:19:25.760",
      "formatted_end": "03:19:29.760",
      "text": "خب ببین بستاشی بود جانی هست"
    },
    {
      "id": 85,
      "start": 11969.76,
      "end": 11971.76,
      "formatted_start": "03:19:29.760",
      "formatted_end": "03:19:31.760",
      "text": "بیا"
    },
    {
      "id": 86,
      "start": 11971.76,
      "end": 11975.76,
      "formatted_start": "03:19:31.760",
      "formatted_end": "03:19:35.760",
      "text": "از اینو داری اینو داری اینو داری بزار بگیرم باز بزار"
    },
    {
      "id": 87,
      "start": 11977.76,
      "end": 11979.76,
      "formatted_start": "03:19:37.760",
      "formatted_end": "03:19:39.760",
      "text": "میخواد اینو بده به شما"
    },
    {
      "id": 88,
      "start": 11979.76,
      "end": 11981.76,
      "formatted_start": "03:19:39.760",
      "formatted_end": "03:19:41.760",
      "text": "بیا از اینو بگیرم"
    },
    {
      "id": 89,
      "start": 11981.76,
      "end": 11983.76,
      "formatted_start": "03:19:41.760",
      "formatted_end": "03:19:43.760",
      "text": "بیا عزیزم"
    },
    {
      "id": 90,
      "start": 11983.76,
      "end": 11985.76,
      "formatted_start": "03:19:43.760",
      "formatted_end": "03:19:45.760",
      "text": "با اونو بگیر"
    },
    {
      "id": 91,
