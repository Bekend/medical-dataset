  "stt_segments": [
    {
      "id": 0,
      "start": 6000.0,
      "end": 6005.0,
      "formatted_start": "01:40:00.000",
      "formatted_end": "01:40:05.000",
      "text": "این هم کود ره گیره ایش، هشتر دو دو، سی سر و هفتر و هفتر."
    },
    {
      "id": 1,
      "start": 6005.0,
      "end": 6009.0,
      "formatted_start": "01:40:05.000",
      "formatted_end": "01:40:09.000",
      "text": "هم مال آزمایشش هم برای داروش هست این کود."
    },
    {
      "id": 2,
      "start": 6009.0,
      "end": 6010.0,
      "formatted_start": "01:40:09.000",
      "formatted_end": "01:40:10.000",
      "text": "باشه شاش."
    },
    {
      "id": 3,
      "start": 6010.0,
      "end": 6014.0,
      "formatted_start": "01:40:10.000",
      "formatted_end": "01:40:14.000",
      "text": "برگونه شما، برگونه زنو، به امن ثبات سلام برسید."
    },
    {
      "id": 4,
      "start": 6014.0,
      "end": 6018.0,
      "formatted_start": "01:40:14.000",
      "formatted_end": "01:40:18.000",
      "text": "امن ثبات هم را توی مدتر مطهر یاده."
    },
    {
      "id": 5,
      "start": 6018.0,
      "end": 6020.0,
      "formatted_start": "01:40:18.000",
      "formatted_end": "01:40:20.000",
      "text": "خب من درستم سلام برسیم."
    },
    {
      "id": 6,
      "start": 6020.0,
      "end": 6022.0,
      "formatted_start": "01:40:20.000",
      "formatted_end": "01:40:22.000",
      "text": "برگونه شما خدا درستم."
    },
    {
      "id": 7,
      "start": 6022.0,
      "end": 6023.0,
      "formatted_start": "01:40:22.000",
      "formatted_end": "01:40:23.000",
      "text": "خدا درستم."
    },
    {
      "id": 8,
      "start": 6060.0,
      "end": 6064.0,
      "formatted_start": "01:41:00.000",
      "formatted_end": "01:41:04.000",
      "text": "از دیوز، یعنی پره روز"
    },
    {
      "id": 9,
      "start": 6064.0,
      "end": 6067.0,
      "formatted_start": "01:41:04.000",
      "formatted_end": "01:41:07.000",
      "text": "می کنم اینجا سینم رو بساییم ورم کرد"
    },
    {
      "id": 10,
      "start": 6067.0,
      "end": 6070.0,
      "formatted_start": "01:41:07.000",
      "formatted_end": "01:41:10.000",
      "text": "بعد یه همون شبش دیگه کلت سینم ورم کرد"
    },
    {
      "id": 11,
      "start": 6070.0,
      "end": 6074.0,
      "formatted_start": "01:41:10.000",
      "formatted_end": "01:41:14.000",
      "text": "تو دیوز رفتم دکتر، خمورت انصافی"
    },
    {
      "id": 12,
      "start": 6074.0,
      "end": 6077.0,
      "formatted_start": "01:41:14.000",
      "formatted_end": "01:41:17.000",
      "text": "عکس فرستاد، من بفردید چیز باشه نباید بچه های شیر بدید"
    },
    {
      "id": 13,
      "start": 6077.0,
      "end": 6080.0,
      "formatted_start": "01:41:17.000",
      "formatted_end": "01:41:20.000",
      "text": "عکس فرستاد، اینو گفتم او فوند کرد"
    },
    {
      "id": 14,
      "start": 6080.0,
      "end": 6084.0,
      "formatted_start": "01:41:20.000",
      "formatted_end": "01:41:24.000",
      "text": "بعد اینو هم رو شیر دادم، یعنی دادم مطرف نکردم"
    },
    {
      "id": 15,
      "start": 6084.0,
      "end": 6088.0,
      "formatted_start": "01:41:24.000",
      "formatted_end": "01:41:28.000",
      "text": "شیر دادم بهش، اینگه این شبش خوب شدید ستریه"
    },
    {
      "id": 16,
      "start": 6088.0,
      "end": 6092.24,
      "formatted_start": "01:41:28.000",
      "formatted_end": "01:41:32.240",
      "text": "ولی شکم لیا، بگو ادباسه ی دهن لیا برد"
    },
    {
      "id": 17,
      "start": 6092.24,
      "end": 6096.0,
      "formatted_start": "01:41:32.240",
      "formatted_end": "01:41:36.000",
      "text": "ولی شکمش از ایروس خوب"
    },
    {
      "id": 18,
      "start": 6096.0,
      "end": 6101.0,
      "formatted_start": "01:41:36.000",
      "formatted_end": "01:41:41.000",
      "text": "سبزه خیلی تیره، خیلی تیره، اصلا لجنی این بلون"
    },
    {
      "id": 19,
      "start": 6101.0,
      "end": 6107.5,
      "formatted_start": "01:41:41.000",
      "formatted_end": "01:41:47.500",
      "text": "شل و خیلی هم از برون بیقراری داره این کانی، از ایروس کلا بیقراری"
    },
    {
      "id": 20,
      "start": 6107.5,
      "end": 6111.5,
      "formatted_start": "01:41:47.500",
      "formatted_end": "01:41:51.500",
      "text": "دفعاتش هم بیشتر شده، بعد شلتر هم شده"
    },
    {
      "id": 21,
      "start": 6111.5,
      "end": 6115.0,
      "formatted_start": "01:41:51.500",
      "formatted_end": "01:41:55.000",
      "text": "یه کوچوله، خیلی نه ما، تو کلا شکم شل هست"
    },
    {
      "id": 22,
      "start": 6115.0,
      "end": 6145.0,
      "formatted_start": "01:41:55.000",
      "formatted_end": "01:42:25.000",
      "text": "نه نه نه نه نه نه نه نه نه نه نه نه نه نه نه نه نه نه نه نه نه نه نه نه نه نه نه نه نه نه نه نه نه نه نه نه نه نه نه نه نه نه نه نه نه نه نه نه نه نه نه نه نه نه نه نه نه نه نه نه نه نه نه نه نه نه نه نه نه نه نه نه نه نه نه نه نه نه نه نه نه نه نه نه نه نه نه نه نه نه نه نه نه نه نه نه نه نه نه نه نه نه نه نه نه نه نه نه نه نه نه ن"
    },
    {
      "id": 23,
      "start": 6145.0,
      "end": 6147.0,
      "formatted_start": "01:42:25.000",
      "formatted_end": "01:42:27.000",
      "text": "خوبی؟"
    },
    {
      "id": 24,
      "start": 6147.0,
      "end": 6149.0,
