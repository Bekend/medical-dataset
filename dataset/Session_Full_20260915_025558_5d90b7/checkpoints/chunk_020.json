      "end": 6231.0,
      "formatted_start": "01:43:49.000",
      "formatted_end": "01:43:51.000",
      "text": "باید برداریم"
    },
    {
      "id": 44,
      "start": 6231.0,
      "end": 6233.0,
      "formatted_start": "01:43:51.000",
      "formatted_end": "01:43:53.000",
      "text": "باید برداریم"
    },
    {
      "id": 45,
      "start": 6233.0,
      "end": 6235.0,
      "formatted_start": "01:43:53.000",
      "formatted_end": "01:43:55.000",
      "text": "باید برداریم"
    },
    {
      "id": 46,
      "start": 6235.0,
      "end": 6237.0,
      "formatted_start": "01:43:55.000",
      "formatted_end": "01:43:57.000",
      "text": "باید برداریم"
    },
    {
      "id": 47,
      "start": 6237.0,
      "end": 6239.0,
      "formatted_start": "01:43:57.000",
      "formatted_end": "01:43:59.000",
      "text": "باید برداریم"
    },
    {
      "id": 48,
      "start": 6239.0,
      "end": 6241.0,
      "formatted_start": "01:43:59.000",
      "formatted_end": "01:44:01.000",
      "text": "باید برداریم"
    },
    {
      "id": 49,
      "start": 6241.0,
      "end": 6243.0,
      "formatted_start": "01:44:01.000",
      "formatted_end": "01:44:03.000",
      "text": "باید برداریم"
    },
    {
      "id": 50,
      "start": 6243.0,
      "end": 6245.0,
      "formatted_start": "01:44:03.000",
      "formatted_end": "01:44:05.000",
      "text": "باید برداریم"
    },
    {
      "id": 51,
      "start": 6245.0,
      "end": 6247.0,
      "formatted_start": "01:44:05.000",
      "formatted_end": "01:44:07.000",
      "text": "باید برداریم"
    },
    {
      "id": 52,
      "start": 6247.0,
      "end": 6249.0,
      "formatted_start": "01:44:07.000",
      "formatted_end": "01:44:09.000",
      "text": "باید برداریم"
    },
    {
      "id": 53,
      "start": 6249.0,
      "end": 6253.68,
      "formatted_start": "01:44:09.000",
      "formatted_end": "01:44:13.680",
      "text": "بچه اینجا دفعه که قضیه رو خالی میکنه."
    },
    {
      "id": 54,
      "start": 6253.68,
      "end": 6256.2,
      "formatted_start": "01:44:13.680",
      "formatted_end": "01:44:16.200",
      "text": "یازدکی نه دفعه نه اوستاده ها."
    },
    {
      "id": 55,
      "start": 6256.2,
      "end": 6258.2,
      "formatted_start": "01:44:16.200",
      "formatted_end": "01:44:18.200",
      "text": "خود و پدید از یازدکی."
    },
    {
      "id": 56,
      "start": 6258.2,
      "end": 6261.2,
      "formatted_start": "01:44:18.200",
      "formatted_end": "01:44:21.200",
      "text": "خیلی خوبه برداشتی ماشای."
    },
    {
      "id": 57,
      "start": 6261.2,
      "end": 6265.2,
      "formatted_start": "01:44:21.200",
      "formatted_end": "01:44:25.200",
      "text": "این ماه یکم کمتره یعنی وزگیشو باش که شروع شد؟"
    },
    {
      "id": 58,
      "start": 6265.2,
      "end": 6266.2,
      "formatted_start": "01:44:25.200",
      "formatted_end": "01:44:26.200",
      "text": "طبیعی دیگه."
    },
    {
      "id": 59,
      "start": 6266.2,
      "end": 6270.2,
      "formatted_start": "01:44:26.200",
      "formatted_end": "01:44:30.200",
      "text": "وقتی بچه ها تهراتشون شروع میشه راه میافتد چرا از صبح میرند."
    },
    {
      "id": 60,
      "start": 6270.2,
      "end": 6272.2,
      "formatted_start": "01:44:30.200",
      "formatted_end": "01:44:32.200",
      "text": "اینجا دیگه وزگیشو نیست قرار می کنند."
    },
    {
      "id": 61,
      "start": 6272.2,
      "end": 6277.1,
      "formatted_start": "01:44:32.200",
      "formatted_end": "01:44:37.100",
      "text": "و ماشاله بعضش تقریبا به اندازه بچه نزدیک دستان هست"
    },
    {
      "id": 62,
      "start": 6277.1,
      "end": 6279.84,
      "formatted_start": "01:44:37.100",
      "formatted_end": "01:44:39.840",
      "text": "پس از این نگرانه بعضش نماش"
    },
    {
      "id": 63,
      "start": 6279.84,
      "end": 6284.2,
      "formatted_start": "01:44:39.840",
      "formatted_end": "01:44:44.200",
      "text": "ببین ما این مشکلات رو سینه مادر با داره دو حالت داره"
    },
    {
      "id": 64,
      "start": 6284.2,
      "end": 6285.64,
      "formatted_start": "01:44:44.200",
      "formatted_end": "01:44:45.640",
      "text": "تورم سینه"
    },
    {
      "id": 65,
      "start": 6285.64,
      "end": 6287.56,
      "formatted_start": "01:44:45.640",
      "formatted_end": "01:44:47.560",
      "text": "یکی اسمش هست ماستیت"
    },
    {
      "id": 66,
      "start": 6287.56,
      "end": 6289.76,
      "formatted_start": "01:44:47.560",
      "formatted_end": "01:44:49.760",
      "text": "که اینام گفت همه از اینه"
    },
    {
      "id": 67,
      "start": 6289.76,
      "end": 6292.2,
      "formatted_start": "01:44:49.760",
      "formatted_end": "01:44:52.200",
      "text": "که التحابه افونته"
    },
    {
      "id": 68,
      "start": 6292.2,
      "end": 6295.04,
      "formatted_start": "01:44:52.200",
      "formatted_end": "01:44:55.040",
      "text": "یکی هست انگورجمنت"
    },
    {
      "id": 69,
      "start": 6295.04,
      "end": 6300.0,
      "formatted_start": "01:44:55.040",
      "formatted_end": "01:45:00.000",
      "text": "انگورجمنت افونت نیست در واقع شیر میره"
    }
