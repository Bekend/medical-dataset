    {
      "id": 13,
      "start": 11461.0,
      "end": 11463.0,
      "formatted_start": "03:11:01.000",
      "formatted_end": "03:11:03.000",
      "text": "اتفاقاً چون اونو باید بشه بشه بشه"
    },
    {
      "id": 14,
      "start": 11463.0,
      "end": 11467.0,
      "formatted_start": "03:11:03.000",
      "formatted_end": "03:11:07.000",
      "text": "اما نرم بشه و نتونیت در اینجور رو خودشون میگرده"
    },
    {
      "id": 15,
      "start": 11467.0,
      "end": 11473.0,
      "formatted_start": "03:11:07.000",
      "formatted_end": "03:11:13.000",
      "text": "به نظر من برای که یوبوستش خوب بشه تا یه مدتی ما باید فکر کردن"
    },
    {
      "id": 16,
      "start": 11473.0,
      "end": 11477.0,
      "formatted_start": "03:11:13.000",
      "formatted_end": "03:11:17.000",
      "text": "اب نداره پوشک پاشو ما خب بذار یوبوستش خوب بشه"
    },
    {
      "id": 17,
      "start": 11477.0,
      "end": 11481.0,
      "formatted_start": "03:11:17.000",
      "formatted_end": "03:11:21.000",
      "text": "بعد کم کم یه مقدار آموزش مثلا باش توضیح بده"
    },
    {
      "id": 18,
      "start": 11481.0,
      "end": 11485.0,
      "formatted_start": "03:11:21.000",
      "formatted_end": "03:11:25.000",
      "text": "همه آدم ها میرن اینجا پی پی میکنن پی پی آر رو نگاه کن"
    },
    {
      "id": 19,
      "start": 11485.0,
      "end": 11489.0,
      "formatted_start": "03:11:25.000",
      "formatted_end": "03:11:29.000",
      "text": "پی پی آر باید برن اینجا و اندازه میشن توضیح براش"
    },
    {
      "id": 20,
      "start": 11489.0,
      "end": 11496.0,
      "formatted_start": "03:11:29.000",
      "formatted_end": "03:11:36.000",
      "text": "اگر اینو بمونم تو شکر دل آدم درد میگیره خب ببین الاروز الاروز"
    },
    {
      "id": 21,
      "start": 11496.0,
      "end": 11498.0,
      "formatted_start": "03:11:36.000",
      "formatted_end": "03:11:38.000",
      "text": "از این سطح را بدم خواهد نکرده"
    },
    {
      "id": 22,
      "start": 11498.0,
      "end": 11500.0,
      "formatted_start": "03:11:38.000",
      "formatted_end": "03:11:40.000",
      "text": "ای بابا خب بقیه ماما بشی شو"
    },
    {
      "id": 23,
      "start": 11500.0,
      "end": 11502.0,
      "formatted_start": "03:11:40.000",
      "formatted_end": "03:11:42.000",
      "text": "خب این وقتا اینجوری میشه"
    },
    {
      "id": 24,
      "start": 11502.0,
      "end": 11506.0,
      "formatted_start": "03:11:42.000",
      "formatted_end": "03:11:46.000",
      "text": "و دیگه خودمون اوکیه میکنه با همون پاراکیدوی و مرافن و"
    },
    {
      "id": 25,
      "start": 11506.0,
      "end": 11508.0,
      "formatted_start": "03:11:46.000",
      "formatted_end": "03:11:48.000",
      "text": "بله نه شب دیگه چه علامتی داره؟"
    },
    {
      "id": 26,
      "start": 11508.0,
      "end": 11510.0,
      "formatted_start": "03:11:48.000",
      "formatted_end": "03:11:50.000",
      "text": "همه چی؟ بله نه فقط شب"
    },
    {
      "id": 27,
      "start": 11510.0,
      "end": 11513.0,
      "formatted_start": "03:11:50.000",
      "formatted_end": "03:11:53.000",
      "text": "خب بودن یه مخبیش همینجوری شد"
    },
    {
      "id": 28,
      "start": 11513.0,
      "end": 11515.0,
      "formatted_start": "03:11:53.000",
      "formatted_end": "03:11:55.000",
      "text": "دو سورس تب داشت هیچ علامت نبوده"
    },
    {
      "id": 29,
      "start": 11515.0,
      "end": 11517.0,
      "formatted_start": "03:11:55.000",
      "formatted_end": "03:11:57.000",
      "text": "این بارا کلینا هست"
    },
    {
      "id": 30,
      "start": 11517.0,
      "end": 11519.0,
      "formatted_start": "03:11:57.000",
      "formatted_end": "03:11:59.000",
      "text": "همه اولا بیروس هست دیگه"
    },
    {
      "id": 31,
      "start": 11519.0,
      "end": 11521.0,
      "formatted_start": "03:11:59.000",
      "formatted_end": "03:12:01.000",
      "text": "ایه یارو"
    },
    {
      "id": 32,
      "start": 11521.0,
      "end": 11523.0,
      "formatted_start": "03:12:01.000",
      "formatted_end": "03:12:03.000",
      "text": "بچه هست بنام روی این یا بدم به تو ببنید اندازه دفتر نمیخوشید"
    },
    {
      "id": 33,
      "start": 11523.0,
      "end": 11525.0,
      "formatted_start": "03:12:03.000",
      "formatted_end": "03:12:05.000",
      "text": "نه"
    },
    {
      "id": 34,
      "start": 11525.0,
      "end": 11527.0,
      "formatted_start": "03:12:05.000",
      "formatted_end": "03:12:07.000",
      "text": "من اندازم دفتر نمیخوشید"
    },
    {
      "id": 35,
      "start": 11527.0,
      "end": 11529.0,
      "formatted_start": "03:12:07.000",
      "formatted_end": "03:12:09.000",
      "text": "باشه اندازه بیرون"
    },
    {
      "id": 36,
      "start": 11529.0,
      "end": 11531.0,
      "formatted_start": "03:12:09.000",
      "formatted_end": "03:12:11.000",
      "text": "تو رو جد"
    },
    {
      "id": 37,
      "start": 11537.0,
      "end": 11539.0,
      "formatted_start": "03:12:17.000",
      "formatted_end": "03:12:19.000",
      "text": "خب صرف اینا نمیخونه"
    },
    {
      "id": 38,
      "start": 11539.0,
      "end": 11541.0,
      "formatted_start": "03:12:19.000",
      "formatted_end": "03:12:21.000",
      "text": "نه از اینو که نداشتم"
    },
    {
      "id": 39,
      "start": 11541.0,
      "end": 11543.0,
      "formatted_start": "03:12:21.000",
      "formatted_end": "03:12:23.000",
      "text": "نه اصلا نداره"
    },
    {
      "id": 40,
      "start": 11543.0,
      "end": 11545.3,
      "formatted_start": "03:12:23.000",
      "formatted_end": "03:12:25.300",
      "text": "موقع ادرار کردن گریه نمی کن"
    },
    {
      "id": 41,
      "start": 11545.3,
      "end": 11546.3,
      "formatted_start": "03:12:25.300",
      "formatted_end": "03:12:26.300",
      "text": "اصلا"
    },
    {
      "id": 42,
      "start": 11546.3,
      "end": 11547.3,
      "formatted_start": "03:12:26.300",
      "formatted_end": "03:12:27.300",
      "text": "نه نه"
    },
    {
      "id": 43,
      "start": 11547.3,
      "end": 11549.3,
      "formatted_start": "03:12:27.300",
      "formatted_end": "03:12:29.300",
      "text": "گوشت رو ببینیم الاروش جان"
    },
    {
      "id": 44,
      "start": 11551.3,
      "end": 11553.3,
      "formatted_start": "03:12:31.300",
      "formatted_end": "03:12:33.300",
      "text": "چقدر دختر خوبیه"
    },
    {
      "id": 45,
      "start": 11553.3,
      "end": 11555.3,
      "formatted_start": "03:12:33.300",
      "formatted_end": "03:12:35.300",
      "text": "چقدر خوبیه"
    },
    {
      "id": 46,
      "start": 11555.3,
      "end": 11557.3,
      "formatted_start": "03:12:35.300",
      "formatted_end": "03:12:37.300",
      "text": "چقدر بزرگ شده الارو"
    },
    {
      "id": 47,
      "start": 11557.3,
      "end": 11559.3,
      "formatted_start": "03:12:37.300",
      "formatted_end": "03:12:39.300",
      "text": "چقدر خانوم شده"
    },
    {
      "id": 48,
      "start": 11559.3,
      "end": 11561.3,
      "formatted_start": "03:12:39.300",
      "formatted_end": "03:12:41.300",
      "text": "خب الاروشان"
    },
    {
      "id": 49,
      "start": 11561.3,
      "end": 11563.3,
      "formatted_start": "03:12:41.300",
      "formatted_end": "03:12:43.300",
      "text": "چون میتونی باز کن من گلوتو ببینم"
    },
    {
      "id": 50,
      "start": 11563.3,
      "end": 11565.3,
      "formatted_start": "03:12:43.300",
      "formatted_end": "03:12:45.300",
      "text": "چون برقای نیمه"
    },
    {
      "id": 51,
      "start": 11565.3,
      "end": 11567.3,
      "formatted_start": "03:12:45.300",
      "formatted_end": "03:12:47.300",
      "text": "بچه هم قشنگ باز میکنه"
    },
    {
      "id": 52,
      "start": 11567.3,
      "end": 11569.3,
      "formatted_start": "03:12:47.300",
      "formatted_end": "03:12:49.300",
      "text": "باریکلا"
    },
    {
      "id": 53,
      "start": 11569.3,
      "end": 11571.3,
      "formatted_start": "03:12:49.300",
      "formatted_end": "03:12:51.300",
      "text": "اینجا شفونت نداره خب"
    },
    {
      "id": 54,
      "start": 11571.3,
      "end": 11576.5,
      "formatted_start": "03:12:51.300",
      "formatted_end": "03:12:56.500",
      "text": "این طبیعی ویروسی فقط تبروش بده ببین اگه علامت جدیدی پیدا کرد"
    },
    {
      "id": 55,
      "start": 11576.5,
      "end": 11578.5,
      "formatted_start": "03:12:56.500",
      "formatted_end": "03:12:58.500",
      "text": "حالا ما با درمشون کنیم"
    },
    {
      "id": 56,
      "start": 11578.5,
      "end": 11580.5,
      "formatted_start": "03:12:58.500",
      "formatted_end": "03:13:00.500",
      "text": "خب الان دو سالش پر شده"
    },
    {
      "id": 57,
      "start": 11580.5,
      "end": 11582.5,
      "formatted_start": "03:13:00.500",
      "formatted_end": "03:13:02.500",
      "text": "دو سال و پچ ماه هست"
    },
    {
      "id": 58,
      "start": 11582.5,
      "end": 11584.5,
      "formatted_start": "03:13:02.500",
      "formatted_end": "03:13:04.500",
      "text": "الاروز"
    },
    {
      "id": 59,
      "start": 11584.5,
      "end": 11586.5,
      "formatted_start": "03:13:04.500",
      "formatted_end": "03:13:06.500",
      "text": "الاروز"
    },
    {
      "id": 60,
      "start": 11586.5,
      "end": 11588.5,
      "formatted_start": "03:13:06.500",
      "formatted_end": "03:13:08.500",
      "text": "این یه لینیه"
    },
    {
      "id": 61,
      "start": 11588.5,
      "end": 11590.5,
      "formatted_start": "03:13:08.500",
      "formatted_end": "03:13:10.500",
      "text": "دوی چسو"
    },
    {
      "id": 62,
      "start": 11590.5,
      "end": 11592.5,
      "formatted_start": "03:13:10.500",
      "formatted_end": "03:13:12.500",
      "text": "میکلشه"
    },
    {
      "id": 63,
      "start": 11592.5,
      "end": 11594.5,
      "formatted_start": "03:13:12.500",
      "formatted_end": "03:13:14.500",
      "text": "اینم شیکر میشه"
    },
    {
      "id": 64,
      "start": 11594.5,
      "end": 11596.5,
      "formatted_start": "03:13:14.500",
      "formatted_end": "03:13:16.500",
      "text": "بعد وقتی غذا میخوره"
    },
    {
      "id": 65,
      "start": 11596.5,
      "end": 11598.5,
      "formatted_start": "03:13:16.500",
      "formatted_end": "03:13:18.500",
      "text": "اینجا پی پی ها میاره و اینجا جمع میشن"
    },
    {
      "id": 66,
      "start": 11598.5,
      "end": 11600.5,
      "formatted_start": "03:13:18.500",
      "formatted_end": "03:13:20.500",
      "text": "خب"
    },
    {
      "id": 67,
      "start": 11600.5,
      "end": 11605.34,
      "formatted_start": "03:13:20.500",
      "formatted_end": "03:13:25.340",
      "text": "بعد این هر وقت پی پی داشته باشه باید بره این پی پی رو بریزه بیرون"
    },
    {
      "id": 68,
      "start": 11605.34,
      "end": 11608.2,
      "formatted_start": "03:13:25.340",
      "formatted_end": "03:13:28.200",
      "text": "چون بزرگ شده مثل الارو"
    },
    {
      "id": 69,
      "start": 11608.2,
      "end": 11612.2,
      "formatted_start": "03:13:28.200",
      "formatted_end": "03:13:32.200",
      "text": "باید بره تو دست روی بشین این پی پی رو بریزه بیرون"
    },
    {
      "id": 70,
      "start": 11612.2,
      "end": 11620.82,
      "formatted_start": "03:13:32.200",
      "formatted_end": "03:13:40.820",
      "text": "باشه اینا اگر تو شکم بمونن پی پی رو نریزی بیرون"
    },
    {
      "id": 71,
      "start": 11620.82,
      "end": 11622.48,
      "formatted_start": "03:13:40.820",
      "formatted_end": "03:13:42.480",
      "text": "بعد مریض میشین"
    },
    {
      "id": 72,
      "start": 11622.48,
      "end": 11624.08,
      "formatted_start": "03:13:42.480",
      "formatted_end": "03:13:44.080",
      "text": "باشه؟"
    },
    {
      "id": 73,
      "start": 11624.08,
      "end": 11626.46,
      "formatted_start": "03:13:44.080",
      "formatted_end": "03:13:46.460",
      "text": "عزیزه دل ها"
    },
    {
      "id": 74,
      "start": 11626.46,
      "end": 11628.18,
      "formatted_start": "03:13:46.460",
      "formatted_end": "03:13:48.180",
      "text": "دختر قشنگر"
    },
    {
      "id": 75,
      "start": 11628.18,
      "end": 11632.18,
      "formatted_start": "03:13:48.180",
      "formatted_end": "03:13:52.180",
      "text": "خب یک چیز رو بدم از این شکلات ها میخواییم"
    },
    {
      "id": 76,
      "start": 11632.18,
      "end": 11634.18,
      "formatted_start": "03:13:52.180",
      "formatted_end": "03:13:54.180",
      "text": "مدینه دوست داری؟"
    },
    {
      "id": 77,
      "start": 11634.18,
      "end": 11636.18,
      "formatted_start": "03:13:54.180",
      "formatted_end": "03:13:56.180",
      "text": "مدینه دوست داری؟"
    },
    {
      "id": 78,
      "start": 11636.18,
      "end": 11638.18,
      "formatted_start": "03:13:56.180",
      "formatted_end": "03:13:58.180",
      "text": "توت فرقی"
    },
    {
      "id": 79,
      "start": 11638.18,
      "end": 11640.18,
      "formatted_start": "03:13:58.180",
      "formatted_end": "03:14:00.180",
      "text": "بخورم دوست دارم"
    },
    {
      "id": 80,
      "start": 11640.18,
      "end": 11642.18,
      "formatted_start": "03:14:00.180",
      "formatted_end": "03:14:02.180",
      "text": "افتادتو این مو باشتن"
    },
    {
      "id": 81,
      "start": 11642.18,
      "end": 11644.18,
      "formatted_start": "03:14:02.180",
      "formatted_end": "03:14:04.180",
      "text": "آره بابا"
    },
    {
      "id": 82,
      "start": 11644.18,
      "end": 11646.18,
      "formatted_start": "03:14:04.180",
      "formatted_end": "03:14:06.180",
      "text": "از اینه خودتو شد"
    },
    {
      "id": 83,
      "start": 11646.18,
      "end": 11648.18,
      "formatted_start": "03:14:06.180",
      "formatted_end": "03:14:08.180",
      "text": "بابا بخورم"
    },
    {
      "id": 84,
      "start": 11662.18,
      "end": 11668.18,
      "formatted_start": "03:14:22.180",
      "formatted_end": "03:14:28.180",
      "text": "این برای کارتراشگیر شربته نه؟"
    },
    {
      "id": 85,
      "start": 11668.18,
      "end": 11670.18,
      "formatted_start": "03:14:28.180",
      "formatted_end": "03:14:30.180",
      "text": "پودره"
    },
    {
      "id": 86,
      "start": 11670.18,
      "end": 11672.18,
      "formatted_start": "03:14:30.180",
      "formatted_end": "03:14:32.180",
      "text": "پودره"
    },
    {
      "id": 87,
      "start": 11672.18,
      "end": 11674.18,
      "formatted_start": "03:14:32.180",
      "formatted_end": "03:14:34.180",
      "text": "توی قطعاش برزینی؟"
    },
    {
      "id": 88,
      "start": 11674.18,
      "end": 11680.18,
      "formatted_start": "03:14:34.180",
      "formatted_end": "03:14:40.180",
      "text": "پرس و آر، ماست، آبو میفه، چایی، هر چیزی"
    },
    {
      "id": 89,
      "start": 11684.18,
      "end": 11688.18,
      "formatted_start": "03:14:44.180",
      "formatted_end": "03:14:48.180",
      "text": "خب ببین یک خوزنش درم برامونه"
    },
    {
      "id": 90,
      "start": 11688.18,
      "end": 11690.18,
      "formatted_start": "03:14:48.180",
      "formatted_end": "03:14:50.180",
      "text": "ببین"
    },
    {
      "id": 91,
      "start": 11690.18,
      "end": 11696.18,
      "formatted_start": "03:14:50.180",
      "formatted_end": "03:14:56.180",
      "text": "انا که رفته خونه، یک باشاق قضا خوریم"
    },
    {
      "id": 92,
      "start": 11696.18,
      "end": 11699.18,
      "formatted_start": "03:14:56.180",
      "formatted_end": "03:14:59.180",
      "text": "از این خود رو میرسی درخواه نیست"
    }
  ],
  "status": "completed"
}