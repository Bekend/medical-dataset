  "stt_segments": [
    {
      "id": 0,
      "start": 11400.0,
      "end": 11406.0,
      "formatted_start": "03:10:00.000",
      "formatted_end": "03:10:06.000",
      "text": "این همه که آب خیلی میخوره، نیوه میخوره، ترکش با غلاد زیادا نمیدونیم چرا جدید کمش اینجوری شد."
    },
    {
      "id": 1,
      "start": 11406.0,
      "end": 11418.0,
      "formatted_start": "03:10:06.000",
      "formatted_end": "03:10:18.000",
      "text": "ببین معمولا یوب و سر توی بچه ها وقتی اتفاق میفته که مثلا اینا مدفوع دارن، مونت ها دارن بازی میکنن، خودشون جلو خودشونو میگیرن."
    },
    {
      "id": 2,
      "start": 11418.0,
      "end": 11421.0,
      "formatted_start": "03:10:18.000",
      "formatted_end": "03:10:21.000",
      "text": "دیدی تو این سر اینا اختیار ودفوشون دست خودشون."
    },
    {
      "id": 3,
      "start": 11421.0,
      "end": 11423.0,
      "formatted_start": "03:10:21.000",
      "formatted_end": "03:10:23.000",
      "text": "خوشنن، خوشنن نیم."
    },
    {
      "id": 4,
      "start": 11423.0,
      "end": 11430.0,
      "formatted_start": "03:10:23.000",
      "formatted_end": "03:10:30.000",
      "text": "این مدفوع میمونه تو روده، هی آب جزم میکنه ازش، هی حجمش بیشتر میشه"
    },
    {
      "id": 5,
      "start": 11430.0,
      "end": 11438.0,
      "formatted_start": "03:10:30.000",
      "formatted_end": "03:10:38.000",
      "text": "خب، بعد مثلا دیگه این مدفوعی که مثلا این رودهش بوده، این مدفوع بوده، کم کم این مدفوعی که یه ذرا حجمتر و صفتر میشه"
    },
    {
      "id": 6,
      "start": 11438.0,
      "end": 11449.0,
      "formatted_start": "03:10:38.000",
      "formatted_end": "03:10:49.000",
      "text": "دیگه خب اینقدر نمی کنه دفع میکنه خب، خیلی زیبا بزنه، چند تا تیکه ازش ممکنه دفع بشه خب، ولی کامل تخلیه نمیشه"
    },
    {
      "id": 7,
      "start": 11449.0,
      "end": 11451.0,
      "formatted_start": "03:10:49.000",
      "formatted_end": "03:10:51.000",
      "text": "اتفاقاً چون اونو باید بشه بیشتر بشه"
    },
    {
      "id": 8,
      "start": 11451.0,
      "end": 11453.0,
      "formatted_start": "03:10:51.000",
      "formatted_end": "03:10:53.000",
      "text": "اتفاقاً چون اونو باید بشه بیشتر بشه"
    },
    {
      "id": 9,
      "start": 11453.0,
      "end": 11455.0,
      "formatted_start": "03:10:53.000",
      "formatted_end": "03:10:55.000",
      "text": "اتفاقاً چون اونو باید بشه بیشتر بشه"
    },
    {
      "id": 10,
