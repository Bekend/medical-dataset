      "formatted_start": "03:06:40.000",
      "formatted_end": "03:06:42.000",
      "text": "این همونی بیشتر شده"
    },
    {
      "id": 35,
      "start": 11202.0,
      "end": 11204.0,
      "formatted_start": "03:06:42.000",
      "formatted_end": "03:06:44.000",
      "text": "ببین"
    },
    {
      "id": 36,
      "start": 11204.0,
      "end": 11206.0,
      "formatted_start": "03:06:44.000",
      "formatted_end": "03:06:46.000",
      "text": "آزمایه ششم کرد"
    },
    {
      "id": 37,
      "start": 11206.0,
      "end": 11208.0,
      "formatted_start": "03:06:46.000",
      "formatted_end": "03:06:48.000",
      "text": "آزمایه ششم کرد"
    },
    {
      "id": 38,
      "start": 11208.0,
      "end": 11210.0,
      "formatted_start": "03:06:48.000",
      "formatted_end": "03:06:50.000",
      "text": "ببین"
    },
    {
      "id": 39,
      "start": 11210.0,
      "end": 11212.0,
      "formatted_start": "03:06:50.000",
      "formatted_end": "03:06:52.000",
      "text": "اینجا برای چیز برام؟"
    },
    {
      "id": 40,
      "start": 11212.0,
      "end": 11214.0,
      "formatted_start": "03:06:52.000",
      "formatted_end": "03:06:54.000",
      "text": "به خوشکنانم؟"
    },
    {
      "id": 41,
      "start": 11214.0,
      "end": 11216.0,
      "formatted_start": "03:06:54.000",
      "formatted_end": "03:06:56.000",
      "text": "آره آره"
    },
    {
      "id": 42,
      "start": 11216.0,
      "end": 11218.0,
      "formatted_start": "03:06:56.000",
      "formatted_end": "03:06:58.000",
      "text": "خیلی داشت خوشت حدش هم"
    },
