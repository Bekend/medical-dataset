      "end": 11397.368,
      "formatted_start": "03:09:56.879",
      "formatted_end": "03:09:57.368",
      "speaker": "SPEAKER_01"
    }
  ],
  "stt_segments": [
    {
      "id": 0,
      "start": 11100.0,
      "end": 11102.0,
      "formatted_start": "03:05:00.000",
      "formatted_end": "03:05:02.000",
      "text": "جزای مهمش مقاومت موند."
    },
    {
      "id": 1,
      "start": 11102.0,
      "end": 11107.0,
      "formatted_start": "03:05:02.000",
      "formatted_end": "03:05:07.000",
      "text": "خب، نزدیک زیزا، مهمش؟ این چی آبون؟"
    },
    {
      "id": 2,
      "start": 11107.0,
      "end": 11109.0,
      "formatted_start": "03:05:07.000",
      "formatted_end": "03:05:09.000",
      "text": "خب، بغیر مهمه."
    },
    {
      "id": 3,
      "start": 11109.0,
      "end": 11113.0,
      "formatted_start": "03:05:09.000",
      "formatted_end": "03:05:13.000",
      "text": "و قطراش هم کمون آنسوفیل رو بیش میدهم دیگه، کامل هست؟"
    },
    {
      "id": 4,
      "start": 11113.0,
      "end": 11115.0,
      "formatted_start": "03:05:13.000",
      "formatted_end": "03:05:15.000",
      "text": "و مرتبیتامین هم لازم هی هم نبیده."
    },
    {
      "id": 5,
      "start": 11115.0,
      "end": 11116.0,
      "formatted_start": "03:05:15.000",
      "formatted_end": "03:05:16.000",
      "text": "که پشت میداره؟"
    },
    {
      "id": 6,
      "start": 11116.0,
      "end": 11120.0,
      "formatted_start": "03:05:16.000",
      "formatted_end": "03:05:20.000",
      "text": "حالا آزمایش رو میدیم ببینیم اگه چیزی کم دارا، و کم هم نیشتر."
    },
    {
      "id": 7,
      "start": 11120.0,
      "end": 11121.0,
      "formatted_start": "03:05:20.000",
      "formatted_end": "03:05:21.000",
      "text": "چیزی کم داره؟"
    },
    {
      "id": 8,
      "start": 11121.0,
      "end": 11123.0,
      "formatted_start": "03:05:21.000",
      "formatted_end": "03:05:23.000",
      "text": "بس یه چکا پکنم بکنم."
    },
    {
      "id": 9,
      "start": 11123.0,
      "end": 11125.0,
      "formatted_start": "03:05:23.000",
      "formatted_end": "03:05:25.000",
      "text": "کجا ببرمش از اون روزه؟"
    },
    {
      "id": 10,
      "start": 11130.0,
      "end": 11133.0,
      "formatted_start": "03:05:30.000",
      "formatted_end": "03:05:33.000",
      "text": "از اینجا باید شنفا ببرش. خورا ادرار."
    },
    {
      "id": 11,
      "start": 11133.0,
      "end": 11135.0,
      "formatted_start": "03:05:33.000",
      "formatted_end": "03:05:35.000",
      "text": "ادرارش شده روی گرمان."
    },
    {
      "id": 12,
      "start": 11135.0,
      "end": 11137.0,
      "formatted_start": "03:05:35.000",
      "formatted_end": "03:05:37.000",
      "text": "همانطور میشینی روی زرفا؟"
    },
    {
      "id": 13,
      "start": 11137.0,
      "end": 11139.0,
      "formatted_start": "03:05:37.000",
      "formatted_end": "03:05:39.000",
      "text": "هم مستقیل بره؟"
    },
    {
      "id": 14,
      "start": 11139.0,
      "end": 11140.0,
      "formatted_start": "03:05:39.000",
      "formatted_end": "03:05:40.000",
      "text": "نه."
    },
    {
      "id": 15,
      "start": 11140.0,
      "end": 11144.0,
      "formatted_start": "03:05:40.000",
      "formatted_end": "03:05:44.000",
      "text": "چیزتر بهتو میده، چیزتر رو برسی میکنه، جدا اجرای کارش بوشنکش میکنه."
    },
    {
      "id": 16,
      "start": 11144.0,
      "end": 11146.0,
      "formatted_start": "03:05:44.000",
      "formatted_end": "03:05:46.000",
      "text": "وقتی ادرار میکنه میشه میرزه تو چیزتر."
    },
    {
      "id": 17,
      "start": 11146.0,
      "end": 11148.0,
      "formatted_start": "03:05:46.000",
      "formatted_end": "03:05:48.000",
      "text": "یه چیز هست، چسب داره."
    },
    {
      "id": 18,
      "start": 11148.0,
      "end": 11150.0,
      "formatted_start": "03:05:48.000",
      "formatted_end": "03:05:50.000",
      "text": "چسبشو میکنی؟"
    },
    {
      "id": 19,
      "start": 11150.0,
      "end": 11154.0,
      "formatted_start": "03:05:50.000",
      "formatted_end": "03:05:54.000",
      "text": "خب نه من میشینه روی زرف مثلا در دستشویهای پچیک دارم."
    },
    {
      "id": 20,
      "start": 11154.0,
      "end": 11156.0,
      "formatted_start": "03:05:54.000",
      "formatted_end": "03:05:56.000",
      "text": "اگر مستقیل بگیرم ازش"
    },
    {
      "id": 21,
      "start": 11156.0,
      "end": 11158.0,
      "formatted_start": "03:05:56.000",
      "formatted_end": "03:05:58.000",
      "text": "مستقیل نه؟"
    },
    {
      "id": 22,
      "start": 11158.0,
      "end": 11160.0,
      "formatted_start": "03:05:58.000",
      "formatted_end": "03:06:00.000",
      "text": "آره مستقیل نه"
    },
    {
      "id": 23,
      "start": 11160.0,
      "end": 11162.0,
      "formatted_start": "03:06:00.000",
      "formatted_end": "03:06:02.000",
      "text": "آره مستقیل نه"
    },
    {
      "id": 24,
      "start": 11180.0,
      "end": 11182.0,
      "formatted_start": "03:06:20.000",
      "formatted_end": "03:06:22.000",
      "text": "این هم شکلونه"
    },
    {
      "id": 25,
      "start": 11182.0,
      "end": 11184.0,
      "formatted_start": "03:06:22.000",
      "formatted_end": "03:06:24.000",
      "text": "این همه چیز رو تعلق بشه بیشتر حد داره"
    },
    {
      "id": 26,
      "start": 11184.0,
      "end": 11186.0,
      "formatted_start": "03:06:24.000",
      "formatted_end": "03:06:26.000",
      "text": "میخواد داره"
    },
    {
      "id": 27,
      "start": 11186.0,
      "end": 11188.0,
      "formatted_start": "03:06:26.000",
      "formatted_end": "03:06:28.000",
      "text": "اولش اونو میخواد داره"
    },
    {
      "id": 28,
      "start": 11188.0,
      "end": 11190.0,
      "formatted_start": "03:06:28.000",
      "formatted_end": "03:06:30.000",
      "text": "چار دستگاهی بیشتر شده"
    },
    {
      "id": 29,
      "start": 11190.0,
      "end": 11192.0,
      "formatted_start": "03:06:30.000",
      "formatted_end": "03:06:32.000",
      "text": "چار دستگاهی بیشتر شده"
    },
    {
      "id": 30,
      "start": 11192.0,
      "end": 11194.0,
      "formatted_start": "03:06:32.000",
      "formatted_end": "03:06:34.000",
      "text": "این همونی بیشتر شده"
    },
    {
      "id": 31,
      "start": 11194.0,
      "end": 11196.0,
      "formatted_start": "03:06:34.000",
      "formatted_end": "03:06:36.000",
      "text": "این همونی بیشتر شده"
    },
    {
      "id": 32,
      "start": 11196.0,
      "end": 11198.0,
      "formatted_start": "03:06:36.000",
      "formatted_end": "03:06:38.000",
      "text": "این همونی بیشتر شده"
    },
    {
      "id": 33,
      "start": 11198.0,
      "end": 11200.0,
      "formatted_start": "03:06:38.000",
      "formatted_end": "03:06:40.000",
      "text": "این همونی بیشتر شده"
    },
    {
      "id": 34,
      "start": 11200.0,
