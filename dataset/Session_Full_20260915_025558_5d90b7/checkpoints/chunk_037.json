      "start": 11218.0,
      "end": 11220.0,
      "formatted_start": "03:06:58.000",
      "formatted_end": "03:07:00.000",
      "text": "هم خوشت حدش خیلی داشت هم"
    },
    {
      "id": 44,
      "start": 11220.0,
      "end": 11222.0,
      "formatted_start": "03:07:00.000",
      "formatted_end": "03:07:02.000",
      "text": "یکی از گوشاش یه برای برمیزه"
    },
    {
      "id": 45,
      "start": 11222.0,
      "end": 11224.0,
      "formatted_start": "03:07:02.000",
      "formatted_end": "03:07:04.000",
      "text": "یه خوشکنان دید کچیک بشمیدم"
    },
    {
      "id": 46,
      "start": 11224.0,
      "end": 11226.0,
      "formatted_start": "03:07:04.000",
      "formatted_end": "03:07:06.000",
      "text": "خب که تر چیه ایشا با تر کنه؟"
    },
    {
      "id": 47,
      "start": 11226.0,
      "end": 11228.0,
      "formatted_start": "03:07:06.000",
      "formatted_end": "03:07:08.000",
      "text": "کشان را ترمیه بی کنه"
    },
    {
      "id": 48,
      "start": 11228.0,
      "end": 11230.0,
      "formatted_start": "03:07:08.000",
      "formatted_end": "03:07:10.000",
      "text": "اینجا زیفه مخیدسته"
    },
    {
      "id": 49,
      "start": 11230.0,
      "end": 11232.0,
      "formatted_start": "03:07:10.000",
      "formatted_end": "03:07:12.000",
      "text": "نه"
    },
    {
      "id": 50,
      "start": 11232.0,
      "end": 11234.0,
      "formatted_start": "03:07:12.000",
      "formatted_end": "03:07:14.000",
      "text": "اگر دیشتر ما متجاوزش شدم"
    },
    {
      "id": 51,
      "start": 11234.0,
      "end": 11236.0,
      "formatted_start": "03:07:14.000",
      "formatted_end": "03:07:16.000",
      "text": "خدا بیرمش این روز"
    },
    {
      "id": 52,
      "start": 11236.0,
      "end": 11238.0,
      "formatted_start": "03:07:16.000",
      "formatted_end": "03:07:18.000",
      "text": "باشین آن زیفه"
    },
    {
      "id": 53,
      "start": 11238.0,
      "end": 11242.0,
      "formatted_start": "03:07:18.000",
      "formatted_end": "03:07:22.000",
      "text": "این زایی فرمیه ماست مشترسی دیگه از دامرافن جاری خونه"
    },
    {
      "id": 54,
      "start": 11242.0,
      "end": 11243.0,
      "formatted_start": "03:07:22.000",
      "formatted_end": "03:07:23.000",
      "text": "نه نه باشیم"
    },
    {
      "id": 55,
      "start": 11243.0,
      "end": 11244.0,
      "formatted_start": "03:07:23.000",
      "formatted_end": "03:07:24.000",
      "text": "این از دامرافن"
    },
    {
      "id": 56,
      "start": 11248.0,
      "end": 11251.0,
      "formatted_start": "03:07:28.000",
      "formatted_end": "03:07:31.000",
      "text": "این از شروط و دیگه برای من"
    },
    {
      "id": 57,
      "start": 11251.0,
      "end": 11266.0,
      "formatted_start": "03:07:31.000",
      "formatted_end": "03:07:46.000",
      "text": "شروط نموتادین هر دومش 10 ساعت یک پودیم سازید"
    },
    {
      "id": 58,
      "start": 11266.0,
      "end": 11274.0,
      "formatted_start": "03:07:46.000",
      "formatted_end": "03:07:54.000",
      "text": "با قطره پارانتروی اگر تق کرد بهش ده قطره بزید"
    },
    {
      "id": 59,
      "start": 11274.0,
      "end": 11277.0,
      "formatted_start": "03:07:54.000",
      "formatted_end": "03:07:57.000",
      "text": "خب هر چهار ساعت"
    },
    {
      "id": 60,
      "start": 11277.0,
      "end": 11283.0,
      "formatted_start": "03:07:57.000",
      "formatted_end": "03:08:03.000",
      "text": "یه قطره بینی صبح و شب یه قطره بزید"
    },
    {
      "id": 61,
      "start": 11283.0,
      "end": 11285.0,
      "formatted_start": "03:08:03.000",
      "formatted_end": "03:08:05.000",
