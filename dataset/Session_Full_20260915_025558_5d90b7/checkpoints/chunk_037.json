      "start": 11368.0,
      "end": 11370.0,
      "formatted_start": "03:09:28.000",
      "formatted_end": "03:09:30.000",
      "text": "سلام دختر قشن"
    },
    {
      "id": 93,
      "start": 11370.0,
      "end": 11372.0,
      "formatted_start": "03:09:30.000",
      "formatted_end": "03:09:32.000",
      "text": "بیایید ببینیم"
    },
    {
      "id": 94,
      "start": 11372.0,
      "end": 11374.0,
      "formatted_start": "03:09:32.000",
      "formatted_end": "03:09:34.000",
      "text": "سلام"
    },
    {
      "id": 95,
      "start": 11374.0,
      "end": 11377.0,
      "formatted_start": "03:09:34.000",
      "formatted_end": "03:09:37.000",
      "text": "همه تره هم میدونم"
    },
    {
      "id": 96,
      "start": 11377.0,
      "end": 11380.0,
      "formatted_start": "03:09:37.000",
      "formatted_end": "03:09:40.000",
      "text": "همه تره هم میدونم ایلان روز خوش کنم"
    },
    {
      "id": 97,
      "start": 11380.0,
      "end": 11381.0,
      "formatted_start": "03:09:40.000",
      "formatted_end": "03:09:41.000",
      "text": "خوبی؟"
    },
    {
      "id": 98,
      "start": 11381.0,
      "end": 11385.0,
      "formatted_start": "03:09:41.000",
      "formatted_end": "03:09:45.000",
      "text": "خاندرتو شکرم ایلان روز خیلی خوب کار می کرد"
    },
    {
      "id": 99,
      "start": 11385.0,
      "end": 11393.0,
      "formatted_start": "03:09:45.000",
      "formatted_end": "03:09:53.000",
      "text": "اینکه از وقتی که دو روز، سه روز، چهار روز کار نمی کنه وقتی هم کار می کنه، همین روز هم نمی شوند"
    },
    {
      "id": 100,
      "start": 11393.0,
      "end": 11397.0,
      "formatted_start": "03:09:53.000",
      "formatted_end": "03:09:57.000",
      "text": "و پی پی دارن که پی نمی کنه، احساسشو داره نمی کنه"
    },
    {
      "id": 101,
      "start": 11397.0,
      "end": 11400.0,
      "formatted_start": "03:09:57.000",
      "formatted_end": "03:10:00.000",
      "text": "یا سیخ کار می کنه، بوی خیلی بدی می ده"
    }
  ],
