      "start": 7871.1,
      "end": 7873.1,
      "formatted_start": "02:11:11.100",
      "formatted_end": "02:11:13.100",
      "text": "شاید خورن یعنی خواب شد"
    },
    {
      "id": 29,
      "start": 7873.1,
      "end": 7875.1,
      "formatted_start": "02:11:13.100",
      "formatted_end": "02:11:15.100",
      "text": "این آن پولش هم براش برش برش"
    },
    {
      "id": 30,
      "start": 7875.1,
      "end": 7877.1,
      "formatted_start": "02:11:15.100",
      "formatted_end": "02:11:17.100",
      "text": "این شاید بره"
    },
    {
      "id": 31,
      "start": 7877.1,
      "end": 7879.1,
      "formatted_start": "02:11:17.100",
      "formatted_end": "02:11:19.100",
      "text": "این موت رو دانه برش برش برش"
    },
    {
      "id": 32,
      "start": 7879.1,
      "end": 7881.1,
      "formatted_start": "02:11:19.100",
      "formatted_end": "02:11:21.100",
      "text": "این موت رو دانه برش برش برش برش"
    },
    {
      "id": 33,
      "start": 7881.1,
      "end": 7883.1,
      "formatted_start": "02:11:21.100",
      "formatted_end": "02:11:23.100",
