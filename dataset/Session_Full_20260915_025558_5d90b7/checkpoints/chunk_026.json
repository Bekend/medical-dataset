    },
    {
      "id": 24,
      "start": 7863.1,
      "end": 7865.1,
      "formatted_start": "02:11:03.100",
      "formatted_end": "02:11:05.100",
      "text": "این آن پول هم براش برش برش"
    },
    {
      "id": 25,
      "start": 7865.1,
      "end": 7867.1,
      "formatted_start": "02:11:05.100",
      "formatted_end": "02:11:07.100",
