      "start": 7803.0,
      "end": 7806.0,
      "formatted_start": "02:10:03.000",
      "formatted_end": "02:10:06.000",
      "text": "این بلاش رژه."
    },
    {
      "id": 2,
      "start": 7806.0,
      "end": 7809.0,
      "formatted_start": "02:10:06.000",
      "formatted_end": "02:10:09.000",
      "text": "این ایسپری هست."
    },
    {
      "id": 3,
      "start": 7809.0,
      "end": 7812.0,
      "formatted_start": "02:10:09.000",
      "formatted_end": "02:10:12.000",
      "text": "این رو برای تو بیمار بگیری."
    },
    {
      "id": 4,
      "start": 7812.0,
      "end": 7817.0,
      "formatted_start": "02:10:12.000",
      "formatted_end": "02:10:17.000",
      "text": "این رو برده بزنید تا از دو موقع داشتید."
    },
    {
      "id": 5,
      "start": 7817.0,
      "end": 7819.0,
      "formatted_start": "02:10:17.000",
      "formatted_end": "02:10:19.000",
      "text": "پشی، برده بزنید."
    },
    {
      "id": 6,
      "start": 7819.0,
      "end": 7821.0,
      "formatted_start": "02:10:19.000",
      "formatted_end": "02:10:21.000",
      "text": "پشی، برده بزنید."
    },
    {
      "id": 7,
      "start": 7821.0,
      "end": 7824.0,
      "formatted_start": "02:10:21.000",
      "formatted_end": "02:10:24.000",
      "text": "پشی، برده بزنید."
    },
    {
      "id": 8,
      "start": 7824.0,
      "end": 7826.0,
      "formatted_start": "02:10:24.000",
      "formatted_end": "02:10:26.000",
      "text": "پشی، برده بزنید."
    },
    {
      "id": 9,
      "start": 7826.0,
      "end": 7828.0,
      "formatted_start": "02:10:26.000",
      "formatted_end": "02:10:28.000",
      "text": "پشی، برده بزنید."
    },
    {
      "id": 10,
      "start": 7828.0,
      "end": 7833.14,
      "formatted_start": "02:10:28.000",
      "formatted_end": "02:10:33.140",
      "text": "این رو بعد از دوران یه دین از این صدر کوچکن"
    },
    {
      "id": 11,
      "start": 7833.14,
      "end": 7837.3,
      "formatted_start": "02:10:33.140",
      "formatted_end": "02:10:37.300",
      "text": "باز میکنید به تو آم یا شیر بهش بده بخواید"
    },
    {
      "id": 12,
      "start": 7837.3,
      "end": 7838.14,
      "formatted_start": "02:10:37.300",
      "formatted_end": "02:10:38.140",
      "text": "یا تو مار"
    },
    {
      "id": 13,
      "start": 7838.14,
      "end": 7839.82,
      "formatted_start": "02:10:38.140",
      "formatted_end": "02:10:39.820",
      "text": "اگه بهش میدی مار"
    },
    {
      "id": 14,
      "start": 7839.82,
      "end": 7841.18,
      "formatted_start": "02:10:39.820",
      "formatted_end": "02:10:41.180",
      "text": "چی چه باز بگیدم؟"
    },
    {
      "id": 15,
      "start": 7841.18,
      "end": 7842.62,
      "formatted_start": "02:10:41.180",
      "formatted_end": "02:10:42.620",
      "text": "یه بسته شو کامل بگید"
    },
    {
      "id": 16,
      "start": 7842.62,
      "end": 7844.72,
      "formatted_start": "02:10:42.620",
      "formatted_end": "02:10:44.720",
      "text": "کوچکن برده آشکو"
    },
    {
      "id": 17,
      "start": 7844.72,
      "end": 7848.18,
      "formatted_start": "02:10:44.720",
      "formatted_end": "02:10:48.180",
      "text": "بعد همون حسابی نوشن رو یه بابایی کنم بهش میدیم"
    },
    {
      "id": 18,
      "start": 7848.18,
      "end": 7852.4,
      "formatted_start": "02:10:48.180",
      "formatted_end": "02:10:52.400",
      "text": "بعد دیگه فقط تو این داروها این رو حسیش میکنید"
    },
    {
      "id": 19,
      "start": 7852.4,
      "end": 7855.1,
      "formatted_start": "02:10:52.400",
      "formatted_end": "02:10:55.100",
      "text": "بقیه داروها رو هم بهش میدیم"
    },
    {
      "id": 20,
      "start": 7855.1,
