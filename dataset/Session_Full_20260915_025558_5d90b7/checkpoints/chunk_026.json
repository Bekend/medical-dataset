    },
    {
      "id": 53,
      "start": 7932.1,
      "end": 7933.1,
      "formatted_start": "02:12:12.100",
      "formatted_end": "02:12:13.100",
      "text": "خب چه شده؟"
    },
    {
      "id": 54,
      "start": 7933.1,
      "end": 7937.1,
      "formatted_start": "02:12:13.100",
      "formatted_end": "02:12:17.100",
      "text": "گردنش برمیت در دوش هم بابت چنگ سرزه"
    },
    {
      "id": 55,
      "start": 7937.1,
      "end": 7941.1,
      "formatted_start": "02:12:17.100",
      "formatted_end": "02:12:21.100",
      "text": "از دندانه باباش که داره درنگه ترم می کنه"
    },
    {
      "id": 56,
      "start": 7941.1,
      "end": 7945.1,
      "formatted_start": "02:12:21.100",
      "formatted_end": "02:12:25.100",
      "text": "بعد با دشویش هم می سرود"
    },
    {
      "id": 57,
      "start": 7945.1,
      "end": 7949.1,
      "formatted_start": "02:12:25.100",
      "formatted_end": "02:12:29.100",
      "text": "جوانا بیا ببین نگاه هلمه"
    },
    {
      "id": 58,
      "start": 7949.1,
      "end": 7953.1,
      "formatted_start": "02:12:29.100",
      "formatted_end": "02:12:33.100",
      "text": "دستش را راست داشته بود"
    },
    {
      "id": 59,
      "start": 7953.1,
      "end": 7957.1,
      "formatted_start": "02:12:33.100",
      "formatted_end": "02:12:37.100",
      "text": "همه شما دستش به دشوش شده هر ماه هم یکی دشوش عفونت می خواهد که سراب کرد"
    },
    {
      "id": 60,
      "start": 7957.1,
      "end": 7959.1,
      "formatted_start": "02:12:37.100",
      "formatted_end": "02:12:39.100",
      "text": "این سری یکی بوده"
    },
    {
      "id": 61,
      "start": 7959.1,
      "end": 7963.1,
      "formatted_start": "02:12:39.100",
      "formatted_end": "02:12:43.100",
      "text": "اون تومات درده بندید می زنید یک هفته یه هفته دو هفته"
    },
    {
      "id": 62,
      "start": 7963.1,
      "end": 7967.1,
      "formatted_start": "02:12:43.100",
      "formatted_end": "02:12:47.100",
      "text": "تومات را هر شب بردرش چرد ببندید"
    },
    {
      "id": 63,
      "start": 7967.1,
      "end": 7969.1,
      "formatted_start": "02:12:47.100",
      "formatted_end": "02:12:49.100",
      "text": "دو بود، فونزه هم بود بوجه دو"
    },
    {
      "id": 64,
      "start": 7969.1,
      "end": 7970.1,
      "formatted_start": "02:12:49.100",
      "formatted_end": "02:12:50.100",
      "text": "گوش سراخ کردیم"
    },
    {
      "id": 65,
      "start": 7970.1,
      "end": 7971.1,
      "formatted_start": "02:12:50.100",
      "formatted_end": "02:12:51.100",
      "text": "از این مورد بود"
    },
    {
      "id": 66,
      "start": 7971.1,
      "end": 7973.1,
      "formatted_start": "02:12:51.100",
      "formatted_end": "02:12:53.100",
      "text": "بعد یه مدت خوب بود"
    },
    {
      "id": 67,
      "start": 7973.1,
      "end": 7975.1,
      "formatted_start": "02:12:53.100",
      "formatted_end": "02:12:55.100",
      "text": "یک ماه خوبه باز دوباره"
    },
    {
      "id": 68,
      "start": 7975.1,
      "end": 7977.1,
      "formatted_start": "02:12:55.100",
      "formatted_end": "02:12:57.100",
      "text": "یکی از گوشش سراخ کرد"
    },
    {
      "id": 69,
      "start": 7977.1,
      "end": 7978.1,
      "formatted_start": "02:12:57.100",
      "formatted_end": "02:12:58.100",
      "text": "چیز میشه او خوند؟"
    },
    {
      "id": 70,
      "start": 7978.1,
      "end": 7980.1,
      "formatted_start": "02:12:58.100",
      "formatted_end": "02:13:00.100",
      "text": "بعد برد گوشش کنیم، ترما گوشش کنیم"
    },
    {
      "id": 71,
      "start": 7982.1,
      "end": 7984.1,
      "formatted_start": "02:13:02.100",
      "formatted_end": "02:13:04.100",
      "text": "گوش سراخ کردی؟"
    },
    {
      "id": 72,
      "start": 7984.1,
      "end": 7986.1,
      "formatted_start": "02:13:04.100",
      "formatted_end": "02:13:06.100",
      "text": "یا نبایی هم سراخ می کردی؟"
    },
    {
      "id": 73,
      "start": 7986.1,
      "end": 7988.1,
      "formatted_start": "02:13:06.100",
      "formatted_end": "02:13:08.100",
      "text": "یا برد ترما گوشش کنی؟"
    },
    {
      "id": 74,
      "start": 7991.1,
      "end": 7993.1,
      "formatted_start": "02:13:11.100",
      "formatted_end": "02:13:13.100",
      "text": "اجانه؟ اجانه؟"
    },
    {
      "id": 75,
      "start": 7993.1,
