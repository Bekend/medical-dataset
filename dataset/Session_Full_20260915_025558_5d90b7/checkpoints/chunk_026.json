    },
    {
      "id": 42,
      "start": 7907.1,
      "end": 7909.1,
      "formatted_start": "02:11:47.100",
      "formatted_end": "02:11:49.100",
      "text": "خدا برون"
    },
    {
      "id": 43,
      "start": 7909.1,
      "end": 7911.1,
      "formatted_start": "02:11:49.100",
      "formatted_end": "02:11:51.100",
      "text": "خدا برون"
    },
    {
      "id": 44,
      "start": 7911.1,
      "end": 7912.1,
      "formatted_start": "02:11:51.100",
      "formatted_end": "02:11:52.100",
      "text": "خانم تو؟"
    },
    {
      "id": 45,
      "start": 7912.1,
      "end": 7913.1,
      "formatted_start": "02:11:52.100",
      "formatted_end": "02:11:53.100",
