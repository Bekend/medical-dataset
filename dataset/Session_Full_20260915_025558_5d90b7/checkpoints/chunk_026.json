    },
    {
      "id": 46,
      "start": 7915.1,
      "end": 7917.1,
      "formatted_start": "02:11:55.100",
      "formatted_end": "02:11:57.100",
      "text": "خانم سنجور"
    },
    {
      "id": 47,
      "start": 7919.1,
      "end": 7921.1,
      "formatted_start": "02:11:59.100",
      "formatted_end": "02:12:01.100",
      "text": "هلمه خانم"
    },
    {
      "id": 48,
      "start": 7922.1,
      "end": 7924.1,
      "formatted_start": "02:12:02.100",
      "formatted_end": "02:12:04.100",
      "text": "تمام شد؟"
    },
    {
      "id": 49,
      "start": 7924.1,
      "end": 7926.1,
      "formatted_start": "02:12:04.100",
      "formatted_end": "02:12:06.100",
      "text": "یه هشت ماه بگیرش خانم"
    },
    {
      "id": 50,
      "start": 7926.1,
      "end": 7928.1,
      "formatted_start": "02:12:06.100",
      "formatted_end": "02:12:08.100",
      "text": "سلام هلمه"
    },
    {
      "id": 51,
      "start": 7928.1,
      "end": 7930.1,
      "formatted_start": "02:12:08.100",
      "formatted_end": "02:12:10.100",
