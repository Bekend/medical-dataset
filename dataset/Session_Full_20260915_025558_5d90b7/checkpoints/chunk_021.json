  "stt_segments": [
    {
      "id": 0,
      "start": 6300.0,
      "end": 6330.0,
      "formatted_start": "01:45:00.000",
      "formatted_end": "01:45:30.000",
      "text": "از این مطب پزشکی، در مطب پزشکی، در مطب پزشکی، در مطب پزشکی، در مطب پزشکی، در مطب پزشکی، در مطب پزشکی، در مطب پزشکی، در مطب پزشکی، در مطب پزشکی، در مطب پزشکی، در مطب پزشکی، در مطب پزشکی، در مطب پزشکی، در مطب پزشکی، در مطب پزشکی، در مطب پزشکی، در مطب پزشکی، در مطب پزشکی، در مطب پزشکی، د"
    },
    {
      "id": 1,
      "start": 6330.0,
      "end": 6332.0,
      "formatted_start": "01:45:30.000",
      "formatted_end": "01:45:32.000",
      "text": "بعد درمانش مشکل ده"
    },
    {
      "id": 2,
      "start": 6332.0,
      "end": 6334.0,
      "formatted_start": "01:45:32.000",
      "formatted_end": "01:45:34.000",
      "text": "بعد دیگه تقنیش شد خوب شد"
    },
    {
      "id": 3,
      "start": 6334.0,
      "end": 6336.0,
      "formatted_start": "01:45:34.000",
      "formatted_end": "01:45:36.000",
      "text": "معلوم که این این گرشمند شد"
    },
    {
      "id": 4,
      "start": 6336.0,
      "end": 6338.0,
      "formatted_start": "01:45:36.000",
      "formatted_end": "01:45:38.000",
      "text": "و افراد اون خونه نمانده"
    },
    {
      "id": 5,
      "start": 6338.0,
      "end": 6340.0,
      "formatted_start": "01:45:38.000",
      "formatted_end": "01:45:40.000",
      "text": "آره اولش بودم افراد همین"
    },
    {
      "id": 6,
      "start": 6340.0,
      "end": 6342.0,
      "formatted_start": "01:45:40.000",
      "formatted_end": "01:45:42.000",
      "text": "یه چیز ماساجش در شد"
    },
    {
      "id": 7,
      "start": 6342.0,
      "end": 6344.0,
      "formatted_start": "01:45:42.000",
      "formatted_end": "01:45:44.000",
      "text": "آره"
    },
    {
      "id": 8,
      "start": 6344.0,
      "end": 6346.0,
      "formatted_start": "01:45:44.000",
      "formatted_end": "01:45:46.000",
      "text": "بعد وقتی که لیا اونجا شیر داده"
    },
    {
      "id": 9,
      "start": 6346.0,
      "end": 6348.0,
      "formatted_start": "01:45:46.000",
      "formatted_end": "01:45:48.000",
      "text": "آره"
    },
    {
      "id": 10,
      "start": 6348.0,
      "end": 6350.0,
      "formatted_start": "01:45:48.000",
      "formatted_end": "01:45:50.000",
      "text": "افراد تشکیزش با هم نه"
    },
    {
      "id": 11,
      "start": 6350.0,
      "end": 6352.0,
      "formatted_start": "01:45:50.000",
      "formatted_end": "01:45:52.000",
      "text": "با تخلیه کردن شیر داری میخوردن"
    },
    {
      "id": 12,
      "start": 6352.0,
      "end": 6354.0,
      "formatted_start": "01:45:52.000",
      "formatted_end": "01:45:54.000",
      "text": "و بعد ترکش"
    },
    {
      "id": 13,
      "start": 6354.0,
      "end": 6356.0,
      "formatted_start": "01:45:54.000",
      "formatted_end": "01:45:56.000",
      "text": "خب فرد این"
    },
    {
      "id": 14,
      "start": 6356.0,
      "end": 6358.0,
      "formatted_start": "01:45:56.000",
      "formatted_end": "01:45:58.000",
      "text": "لیا مالا یکجور اصحاب شده"
    },
    {
      "id": 15,
      "start": 6358.0,
      "end": 6361.44,
      "formatted_start": "01:45:58.000",
      "formatted_end": "01:46:01.440",
      "text": "اینجا بیقراری شویم باشم به خاطر دل بیچشم"
    },
    {
      "id": 16,
      "start": 6361.44,
      "end": 6365.24,
      "formatted_start": "01:46:01.440",
      "formatted_end": "01:46:05.240",
      "text": "این انسانش میتونه تغذیهی باشه به خاطر چیزایی که باید باشه"
    },
    {
      "id": 17,
      "start": 6365.24,
      "end": 6368.44,
      "formatted_start": "01:46:05.240",
      "formatted_end": "01:46:08.440",
      "text": "یا میتونه افرادی به میروز باشه"
    },
    {
      "id": 18,
      "start": 6368.44,
      "end": 6371.76,
      "formatted_start": "01:46:08.440",
      "formatted_end": "01:46:11.760",
      "text": "که حالا مثلا رنگش هم سبز شده دل نرم گرده"
    },
    {
      "id": 19,
      "start": 6371.76,
      "end": 6374.08,
      "formatted_start": "01:46:11.760",
      "formatted_end": "01:46:14.080",
      "text": "اوز اکس در اکس درشویم"
    },
    {
      "id": 20,
      "start": 6374.08,
      "end": 6376.56,
      "formatted_start": "01:46:14.080",
      "formatted_end": "01:46:16.560",
      "text": "خب نگران نماش دارو باشیم"
    },
    {
      "id": 21,
      "start": 6376.56,
      "end": 6381.24,
      "formatted_start": "01:46:16.560",
      "formatted_end": "01:46:21.240",
      "text": "در اینجا بیقراریش به خاطر همونه یا در اینه؟"
    },
    {
      "id": 22,
      "start": 6381.24,
      "end": 6382.4,
      "formatted_start": "01:46:21.240",
      "formatted_end": "01:46:22.400",
      "text": "دل نرم شویم"
    },
    {
      "id": 23,
      "start": 6382.4,
      "end": 6383.56,
      "formatted_start": "01:46:22.400",
      "formatted_end": "01:46:23.560",
      "text": "دل نرم شویم"
    },
    {
      "id": 24,
      "start": 6383.56,
      "end": 6384.16,
      "formatted_start": "01:46:23.560",
      "formatted_end": "01:46:24.160",
      "text": "اوز"
    },
    {
      "id": 25,
      "start": 6384.16,
      "end": 6385.2,
      "formatted_start": "01:46:24.160",
      "formatted_end": "01:46:25.200",
      "text": "همه شویم"
    },
    {
      "id": 26,
      "start": 6388.0,
      "end": 6393.0,
      "formatted_start": "01:46:28.000",
      "formatted_end": "01:46:33.000",
      "text": "اگر همه شوید واسه دوست داشتون این رو کنید بخاطر درنجورش همه چونه باشه"
    },
    {
      "id": 27,
      "start": 6393.0,
      "end": 6394.0,
      "formatted_start": "01:46:33.000",
      "formatted_end": "01:46:34.000",
      "text": "برخیر همچونه چی کم"
    },
    {
      "id": 28,
      "start": 6394.0,
      "end": 6397.0,
      "formatted_start": "01:46:34.000",
      "formatted_end": "01:46:37.000",
      "text": "برخیر همچونه چی کمه ببینید همون خواه برقمی داره"
    },
    {
      "id": 29,
      "start": 6397.0,
      "end": 6399.0,
      "formatted_start": "01:46:37.000",
      "formatted_end": "01:46:39.000",
      "text": "برقمی همیشه اینجوری هست"
    },
    {
      "id": 30,
      "start": 6399.0,
      "end": 6400.0,
      "formatted_start": "01:46:39.000",
      "formatted_end": "01:46:40.000",
      "text": "برخیر اینجوری هست"
    },
    {
      "id": 31,
      "start": 6400.0,
      "end": 6402.0,
      "formatted_start": "01:46:40.000",
      "formatted_end": "01:46:42.000",
      "text": "این بخاطر یک غذایی نیخورده"
    },
    {
      "id": 32,
      "start": 6402.0,
      "end": 6404.0,
      "formatted_start": "01:46:42.000",
      "formatted_end": "01:46:44.000",
      "text": "و دیوز کلا نیشه یک دوسته بوده"
    },
    {
      "id": 33,
      "start": 6404.0,
      "end": 6406.0,
      "formatted_start": "01:46:44.000",
      "formatted_end": "01:46:46.000",
      "text": "نیخورده بود"
    },
    {
      "id": 34,
      "start": 6406.0,
      "end": 6407.0,
      "formatted_start": "01:46:46.000",
      "formatted_end": "01:46:47.000",
      "text": "از این چیز جدیدی داشتند"
    },
    {
      "id": 35,
      "start": 6407.0,
      "end": 6408.0,
      "formatted_start": "01:46:47.000",
      "formatted_end": "01:46:48.000",
      "text": "همه چی"
    },
    {
      "id": 36,
      "start": 6408.0,
      "end": 6412.0,
      "formatted_start": "01:46:48.000",
      "formatted_end": "01:46:52.000",
      "text": "باید با هم بابت برمود قضایش هم همینجا برمیدیم."
    },
    {
      "id": 37,
      "start": 6412.0,
      "end": 6414.0,
      "formatted_start": "01:46:52.000",
      "formatted_end": "01:46:54.000",
      "text": "ولی ما نبودیم."
    },
    {
      "id": 38,
      "start": 6414.0,
      "end": 6420.0,
      "formatted_start": "01:46:54.000",
      "formatted_end": "01:47:00.000",
      "text": "همونجا که بیدیم هم دیگر زنده دیگر کنیم که همینجا مردم اینجا این شکل شد."
    },
    {
      "id": 39,
      "start": 6420.0,
      "end": 6422.0,
      "formatted_start": "01:47:00.000",
      "formatted_end": "01:47:02.000",
      "text": "یعنی یه رسکل برداشت برای اینجا."
    },
    {
      "id": 40,
      "start": 6422.0,
      "end": 6423.0,
      "formatted_start": "01:47:02.000",
      "formatted_end": "01:47:03.000",
      "text": "آهان."
    },
    {
      "id": 41,
      "start": 6423.0,
      "end": 6425.0,
      "formatted_start": "01:47:03.000",
      "formatted_end": "01:47:05.000",
      "text": "اصلا آب جدید اینجا آب مکنه؟"
    },
    {
      "id": 42,
      "start": 6425.0,
      "end": 6426.0,
      "formatted_start": "01:47:05.000",
      "formatted_end": "01:47:06.000",
      "text": "آهان."
    },
    {
      "id": 43,
      "start": 6426.0,
      "end": 6427.0,
      "formatted_start": "01:47:06.000",
      "formatted_end": "01:47:07.000",
      "text": "شاید."
    },
    {
      "id": 44,
      "start": 6427.0,
      "end": 6428.0,
      "formatted_start": "01:47:07.000",
      "formatted_end": "01:47:08.000",
      "text": "ممکنه هست آب مکنه."
    },
    {
      "id": 45,
      "start": 6428.0,
      "end": 6429.0,
      "formatted_start": "01:47:08.000",
      "formatted_end": "01:47:09.000",
      "text": "نه."
    },
    {
      "id": 46,
      "start": 6429.0,
      "end": 6432.0,
      "formatted_start": "01:47:09.000",
      "formatted_end": "01:47:12.000",
      "text": "تا وقتی گمبه دیدش آب ماجن بده."
    },
    {
      "id": 47,
      "start": 6432.0,
      "end": 6441.2,
      "formatted_start": "01:47:12.000",
      "formatted_end": "01:47:21.200",
      "text": "خصوص وقتی بارنده میشه، این طرف آب اینجا بالاست، خب، آبهای مقداری خلاک آنو دیگه رو برداری کنند، خب؟"
    },
    {
      "id": 48,
      "start": 6441.2,
      "end": 6443.7,
      "formatted_start": "01:47:21.200",
      "formatted_end": "01:47:23.700",
      "text": "آب من جوشیده ی سرچو دارم"
    },
    {
      "id": 49,
      "start": 6443.7,
      "end": 6450.2,
      "formatted_start": "01:47:23.700",
      "formatted_end": "01:47:30.200",
      "text": "آره، خب باشه، بقیه، همه چی با جوشیدن نظر نیست، اصلا ترکیبات آب، اصلا اون نیفراتی که تو آب داره،"
    },
    {
      "id": 50,
      "start": 6450.2,
      "end": 6458.2,
      "formatted_start": "01:47:30.200",
      "formatted_end": "01:47:38.200",
      "text": "برای فرق سمومی که استفاده میکنن کشاوردی، او آب این مرتبه خیلی صالب نیست، خب؟"
    },
    {
      "id": 51,
      "start": 6458.2,
      "end": 6460.72,
      "formatted_start": "01:47:38.200",
      "formatted_end": "01:47:40.720",
      "text": "به خاطر همین آب ماجان بهش بده"
    },
    {
      "id": 52,
      "start": 6460.72,
      "end": 6462.72,
      "formatted_start": "01:47:40.720",
      "formatted_end": "01:47:42.720",
      "text": "میدونی کجور چیه؟"
    },
    {
      "id": 53,
      "start": 6462.72,
      "end": 6466.6,
      "formatted_start": "01:47:42.720",
      "formatted_end": "01:47:46.600",
      "text": "آب ماجان استفاده میتونه فقط این چربش بهش بده"
    },
    {
      "id": 54,
      "start": 6466.6,
      "end": 6469.0,
      "formatted_start": "01:47:46.600",
      "formatted_end": "01:47:49.000",
      "text": "بله"
    },
    {
      "id": 55,
      "start": 6469.0,
      "end": 6472.96,
      "formatted_start": "01:47:49.000",
      "formatted_end": "01:47:52.960",
      "text": "خاندی ببین یکی اینو چنگ ایندازه یعنی داره شیر میخوره"
    },
    {
      "id": 56,
      "start": 6472.96,
      "end": 6477.72,
      "formatted_start": "01:47:52.960",
      "formatted_end": "01:47:57.720",
      "text": "تموم بدن من چنگ ایندازه هرکی بقیدش میدیره اینو چنگ ایندازه"
    },
    {
      "id": 57,
      "start": 6477.72,
      "end": 6479.4,
      "formatted_start": "01:47:57.720",
      "formatted_end": "01:47:59.400",
      "text": "این طبیعه؟"
    },
    {
      "id": 58,
      "start": 6479.4,
      "end": 6480.4,
      "formatted_start": "01:47:59.400",
      "formatted_end": "01:48:00.400",
      "text": "آره؟"
    },
    {
      "id": 59,
      "start": 6480.4,
      "end": 6482.4,
      "formatted_start": "01:48:00.400",
      "formatted_end": "01:48:02.400",
      "text": "کاملا طبیعه"
    },
    {
      "id": 60,
      "start": 6482.4,
      "end": 6483.6,
      "formatted_start": "01:48:02.400",
      "formatted_end": "01:48:03.600",
      "text": "بله"
    },
    {
      "id": 61,
      "start": 6483.6,
      "end": 6484.6,
      "formatted_start": "01:48:03.600",
      "formatted_end": "01:48:04.600",
      "text": "بازی شده"
    },
    {
      "id": 62,
      "start": 6484.6,
      "end": 6486.6,
      "formatted_start": "01:48:04.600",
      "formatted_end": "01:48:06.600",
      "text": "یعنی بازی"
    },
    {
      "id": 63,
      "start": 6486.6,
      "end": 6488.6,
      "formatted_start": "01:48:06.600",
      "formatted_end": "01:48:08.600",
      "text": "باباش دست باباش داره چنگ دید"
    },
    {
      "id": 64,
      "start": 6488.6,
      "end": 6490.6,
      "formatted_start": "01:48:08.600",
      "formatted_end": "01:48:10.600",
      "text": "باباش دست باباش داره چنگ دید"
    },
    {
      "id": 65,
      "start": 6490.6,
      "end": 6492.6,
      "formatted_start": "01:48:10.600",
      "formatted_end": "01:48:12.600",
      "text": "باباش دست باباش داره چنگ دید"
    },
    {
      "id": 66,
      "start": 6492.6,
      "end": 6494.6,
      "formatted_start": "01:48:12.600",
      "formatted_end": "01:48:14.600",
      "text": "باباش دست باباش داره چنگ دید"
    },
    {
      "id": 67,
      "start": 6494.6,
      "end": 6496.6,
      "formatted_start": "01:48:14.600",
      "formatted_end": "01:48:16.600",
      "text": "باباش دست باباش داره چنگ دید"
    },
    {
      "id": 68,
      "start": 6496.6,
      "end": 6498.6,
      "formatted_start": "01:48:16.600",
      "formatted_end": "01:48:18.600",
      "text": "باباش دست باباش داره چنگ دید"
    },
    {
      "id": 69,
      "start": 6498.6,
      "end": 6500.6,
      "formatted_start": "01:48:18.600",
      "formatted_end": "01:48:20.600",
      "text": "باباش دست باباش داره چنگ دید"
    },
    {
      "id": 70,
      "start": 6500.6,
      "end": 6502.6,
      "formatted_start": "01:48:20.600",
      "formatted_end": "01:48:22.600",
      "text": "بچه ادان بزرگ شده"
    },
    {
      "id": 71,
      "start": 6502.6,
      "end": 6504.6,
      "formatted_start": "01:48:22.600",
      "formatted_end": "01:48:24.600",
      "text": "بچه ادان بزرگ شده"
    },
    {
      "id": 72,
      "start": 6504.6,
      "end": 6506.6,
      "formatted_start": "01:48:24.600",
      "formatted_end": "01:48:26.600",
      "text": "بچه ادان بزرگ شده"
    },
    {
      "id": 73,
      "start": 6506.6,
      "end": 6508.6,
      "formatted_start": "01:48:26.600",
      "formatted_end": "01:48:28.600",
      "text": "بچه ادان بزرگ شده"
    },
    {
      "id": 74,
      "start": 6508.6,
      "end": 6510.6,
      "formatted_start": "01:48:28.600",
      "formatted_end": "01:48:30.600",
      "text": "بچه ادان بزرگ شده"
    },
    {
      "id": 75,
      "start": 6510.6,
      "end": 6512.6,
      "formatted_start": "01:48:30.600",
      "formatted_end": "01:48:32.600",
      "text": "بچه ادان بزرگ شده"
    },
    {
      "id": 76,
      "start": 6512.6,
      "end": 6516.6,
      "formatted_start": "01:48:32.600",
      "formatted_end": "01:48:36.600",
      "text": "خب، این خیلی جنگ نشانه که باش درست میشن"
    },
    {
      "id": 77,
      "start": 6516.6,
      "end": 6521.6,
      "formatted_start": "01:48:36.600",
      "formatted_end": "01:48:41.600",
      "text": "بعد میدونیم، در اون درمونش رو دیدیم که چیزی نداشته"
    },
    {
      "id": 78,
      "start": 6521.6,
      "end": 6522.6,
      "formatted_start": "01:48:41.600",
      "formatted_end": "01:48:42.600",
      "text": "نه"
    },
    {
      "id": 79,
      "start": 6522.6,
      "end": 6528.6,
      "formatted_start": "01:48:42.600",
      "formatted_end": "01:48:48.600",
      "text": "این غذا شم، شما این برنامه غذایی ببندادیم"
    },
    {
      "id": 80,
      "start": 6528.6,
      "end": 6532.6,
      "formatted_start": "01:48:48.600",
      "formatted_end": "01:48:52.600",
      "text": "از اول با پوره حویج رو شده که بشه"
    },
    {
      "id": 81,
      "start": 6532.6,
      "end": 6535.6,
      "formatted_start": "01:48:52.600",
      "formatted_end": "01:48:55.600",
      "text": "با پوره حویج رو که بشه دار بر دهنش دوناهای قرمز زد"
    },
    {
      "id": 82,
      "start": 6535.6,
      "end": 6537.6,
      "formatted_start": "01:48:55.600",
      "formatted_end": "01:48:57.600",
      "text": "خب، حساسیت باش"
    },
    {
      "id": 83,
      "start": 6537.6,
      "end": 6541.6,
      "formatted_start": "01:48:57.600",
      "formatted_end": "01:49:01.600",
      "text": "و انتهایی که هم هر بار که من حویج رو میزدم دوناهای قرمز میومد"
    },
    {
      "id": 84,
      "start": 6541.6,
      "end": 6548.6,
      "formatted_start": "01:49:01.600",
      "formatted_end": "01:49:08.600",
      "text": "خب، باید باید همین موضوع وضعی بود تا بادوم رکیم."
    },
    {
      "id": 85,
      "start": 6548.6,
      "end": 6553.6,
      "formatted_start": "01:49:08.600",
      "formatted_end": "01:49:13.600",
      "text": "حیر بادوم یعنی من بادوم که بشدم دوباره دور دهنش اینجوری دونه شد."
    },
    {
      "id": 86,
      "start": 6553.6,
      "end": 6555.6,
      "formatted_start": "01:49:13.600",
      "formatted_end": "01:49:15.600",
      "text": "که دیگه من این رو هم کم کردم بادن."
    },
    {
      "id": 87,
      "start": 6555.6,
      "end": 6560.6,
      "formatted_start": "01:49:15.600",
      "formatted_end": "01:49:20.600",
      "text": "آره، ببین قطع نکن. خب، همینجور. زرد زرد از اون تو سوپش برم."
    },
    {
      "id": 88,
      "start": 6560.6,
      "end": 6561.6,
      "formatted_start": "01:49:20.600",
      "formatted_end": "01:49:21.600",
      "text": "آره ببین."
    },
    {
      "id": 89,
      "start": 6561.6,
      "end": 6565.6,
      "formatted_start": "01:49:21.600",
      "formatted_end": "01:49:25.600",
      "text": "خب، این باعث میشه که کم کم بادنش ایمیلیش نسبت بینام."
    },
    {
      "id": 90,
      "start": 6565.6,
      "end": 6566.6,
      "formatted_start": "01:49:25.600",
      "formatted_end": "01:49:26.600",
      "text": "بادونی؟"
    },
    {
      "id": 91,
      "start": 6566.6,
      "end": 6567.6,
      "formatted_start": "01:49:26.600",
      "formatted_end": "01:49:27.600",
      "text": "آره بادون."
    },
    {
      "id": 92,
      "start": 6567.6,
      "end": 6568.6,
      "formatted_start": "01:49:27.600",
      "formatted_end": "01:49:28.600",
      "text": "بادون چیه؟"
    },
    {
      "id": 93,
      "start": 6568.6,
      "end": 6580.6,
      "formatted_start": "01:49:28.600",
      "formatted_end": "01:49:40.600",
      "text": "مثلا بادم و هیل بادم درست می‌کردم، یک چند تا دو تا بادم می‌رخیم، الان کردم یه بادم باستم و یه قشن هارده برنج می‌شتم، برنجش کرده بادم و خورمیم."
    },
    {
      "id": 94,
      "start": 6580.6,
      "end": 6582.6,
      "formatted_start": "01:49:40.600",
      "formatted_end": "01:49:42.600",
      "text": "آره، آره، همین کار بکنی، الان این کار می‌کنی خوبه؟"
    },
    {
      "id": 95,
      "start": 6582.6,
      "end": 6584.6,
      "formatted_start": "01:49:42.600",
      "formatted_end": "01:49:44.600",
      "text": "آره، این کار می‌کنم."
    },
    {
      "id": 96,
      "start": 6584.6,
      "end": 6590.6,
      "formatted_start": "01:49:44.600",
      "formatted_end": "01:49:50.600",
      "text": "اصلا مثلا ببینیم حساسیت پنسیلی، سانو که حساسیت پنسیلی می‌گوید، می‌کنه که می‌خواهد حساسیت زدایی بکنن،"
    },
    {
      "id": 97,
      "start": 6590.6,
      "end": 6594.6,
      "formatted_start": "01:49:50.600",
      "formatted_end": "01:49:54.600",
      "text": "اما اگر یک ماه را برداشت کنید، از این حال تا از این را برداشت کنید."
    },
    {
      "id": 98,
      "start": 6594.6,
      "end": 6596.6,
      "formatted_start": "01:49:54.600",
      "formatted_end": "01:49:56.600",
      "text": "اما اگر از این حال تا از این را برداشت کنید، از این حال تا از این را برداشت کنید."
    },
    {
      "id": 99,
      "start": 6596.6,
      "end": 6598.78,
      "formatted_start": "01:49:56.600",
      "formatted_end": "01:49:58.780",
      "text": "مثلا به مدت یک ماه"
    },
    {
      "id": 100,
      "start": 6598.78,
      "end": 6599.98,
      "formatted_start": "01:49:58.780",
      "formatted_end": "01:49:59.980",
      "text": "و هر روز مثلا"
    }
  ],
  "status": "completed"
