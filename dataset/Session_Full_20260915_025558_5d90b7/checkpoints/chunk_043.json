      "text": "این کار خلطیه. بینی شو که اینگاه مثلا یک خلطی گیر کرده باشه یا پر باشه. ولی خوب خالیه وقتی نگاه میکنم."
    },
    {
      "id": 2,
      "start": 12940.0,
      "end": 12946.0,
      "formatted_start": "03:35:40.000",
      "formatted_end": "03:35:46.000",
      "text": "قبل من شکمش رو نگاه کردم، 38 درجه بود ولی پیشونش 36 بود."
    },
    {
      "id": 3,
      "start": 12947.0,
      "end": 12948.0,
      "formatted_start": "03:35:47.000",
      "formatted_end": "03:35:48.000",
      "text": "اصلا شکم نباید بگیری."
    },
    {
      "id": 4,
      "start": 12949.0,
      "end": 12951.0,
      "formatted_start": "03:35:49.000",
      "formatted_end": "03:35:51.000",
      "text": "خودت بیمارستان موضوعی لا تب از سر یا شکم."
    },
    {
      "id": 5,
      "start": 12952.0,
      "end": 12957.0,
      "formatted_start": "03:35:52.000",
      "formatted_end": "03:35:57.000",
      "text": "نه. اینو اصلا عدو نداریم. ببین. اصلا علامت بازش دار."
    },
    {
      "id": 6,
      "start": 12957.0,
      "end": 12960.0,
      "formatted_start": "03:35:57.000",
      "formatted_end": "03:36:00.000",
      "text": "آره دیگه همون میشونی که برده اینی"
    },
    {
      "id": 7,
      "start": 12960.0,
      "end": 12964.0,
      "formatted_start": "03:36:00.000",
      "formatted_end": "03:36:04.000",
      "text": "خب تو اگر شکم باشه باید تنظیم کنی که برای شکم رو برده"
    },
    {
      "id": 8,
      "start": 12964.0,
      "end": 12968.0,
      "formatted_start": "03:36:04.000",
      "formatted_end": "03:36:08.000",
      "text": "تو وقتی که اینجا علامت سر رو زده نبرای رو شکم برده"
    },
    {
      "id": 9,
      "start": 12968.0,
      "end": 12973.0,
      "formatted_start": "03:36:08.000",
      "formatted_end": "03:36:13.000",
      "text": "نه اینو سر نزده با سریموریو تنظیم شما نمیتونه"
    },
    {
      "id": 10,
      "start": 12973.0,
      "end": 12975.0,
      "formatted_start": "03:36:13.000",
      "formatted_end": "03:36:15.000",
      "text": "این 36 و 18 ها برده خب"
    },
    {
      "id": 11,
      "start": 12975.0,
      "end": 12978.0,
      "formatted_start": "03:36:15.000",
      "formatted_end": "03:36:18.000",
      "text": "از این با این میگیرم که این درخیفتر"
    },
    {
      "id": 12,
      "start": 12978.0,
      "end": 12980.0,
      "formatted_start": "03:36:18.000",
      "formatted_end": "03:36:20.000",
      "text": "آره از این هاون دارم"
    },
    {
      "id": 13,
      "start": 12980.0,
      "end": 12982.0,
      "formatted_start": "03:36:20.000",
      "formatted_end": "03:36:22.000",
      "text": "از این خیلی درخیفتر"
    },
    {
      "id": 14,
      "start": 12982.0,
      "end": 13012.0,
      "formatted_start": "03:36:22.000",
      "formatted_end": "03:36:52.000",
      "text": "از اینجا باید برداریم که اینجا باید برداریم که اینجا برداریم که اینجا برداریم که اینجا برداریم که اینجا برداریم که اینجا برداریم که اینجا برداریم که اینجا برداریم که اینجا برداریم که اینجا برداریم که اینجا برداریم که اینجا برداریم که اینجا برداریم که اینجا برداریم که اینجا برداریم که اینجا برداریم که اینجا برداری"
    },
    {
      "id": 15,
      "start": 13012.0,
      "end": 13014.0,
      "formatted_start": "03:36:52.000",
      "formatted_end": "03:36:54.000",
      "text": "مرد مرد"
    },
    {
      "id": 16,
      "start": 13014.0,
      "end": 13016.0,
      "formatted_start": "03:36:54.000",
      "formatted_end": "03:36:56.000",
      "text": "چه؟ زبونت سرم شده؟"
    },
    {
      "id": 17,
      "start": 13016.0,
      "end": 13018.0,
      "formatted_start": "03:36:56.000",
      "formatted_end": "03:36:58.000",
      "text": "آره"
    },
    {
      "id": 18,
      "start": 13018.0,
      "end": 13020.0,
      "formatted_start": "03:36:58.000",
      "formatted_end": "03:37:00.000",
      "text": "زورت زیاد شده؟"
    },
    {
      "id": 19,
      "start": 13020.0,
      "end": 13022.0,
      "formatted_start": "03:37:00.000",
      "formatted_end": "03:37:02.000",
      "text": "سرمون"
    },
    {
      "id": 20,
      "start": 13024.0,
      "end": 13026.0,
      "formatted_start": "03:37:04.000",
      "formatted_end": "03:37:06.000",
      "text": "تو شبه باقی نمیخوابه؟"
    },
    {
      "id": 21,
      "start": 13026.0,
      "end": 13028.0,
      "formatted_start": "03:37:06.000",
      "formatted_end": "03:37:08.000",
      "text": "همهش بیدار میشه"
    },
    {
      "id": 22,
      "start": 13028.0,
      "end": 13030.0,
      "formatted_start": "03:37:08.000",
      "formatted_end": "03:37:10.000",
      "text": "تو خواب گریه میتونه"
    },
    {
      "id": 23,
      "start": 13030.0,
      "end": 13032.0,
      "formatted_start": "03:37:10.000",
      "formatted_end": "03:37:12.000",
      "text": "اصلا خیلی بیقراری میکنه شبه باقی"
    },
    {
      "id": 24,
      "start": 13032.0,
      "end": 13034.0,
      "formatted_start": "03:37:12.000",
      "formatted_end": "03:37:14.000",
      "text": "شبه کمش"
    },
    {
      "id": 25,
      "start": 13034.0,
      "end": 13036.0,
      "formatted_start": "03:37:14.000",
      "formatted_end": "03:37:16.000",
      "text": "خواب میکنه؟"
    },
    {
      "id": 26,
      "start": 13036.0,
      "end": 13038.0,
      "formatted_start": "03:37:16.000",
      "formatted_end": "03:37:18.000",
      "text": "نه"
    },
    {
      "id": 27,
      "start": 13038.0,
      "end": 13040.0,
      "formatted_start": "03:37:18.000",
      "formatted_end": "03:37:20.000",
      "text": "اونم به زور و گریه و اینا"
    },
    {
      "id": 28,
      "start": 13040.0,
      "end": 13044.0,
      "formatted_start": "03:37:20.000",
      "formatted_end": "03:37:24.000",
      "text": "از اینجور شرق شد و خودم خوش کننده هست"
    },
    {
      "id": 29,
      "start": 13044.0,
      "end": 13046.0,
      "formatted_start": "03:37:24.000",
      "formatted_end": "03:37:26.000",
      "text": "همه رو سی و شش و هفته"
    },
    {
      "id": 30,
      "start": 13046.0,
      "end": 13048.0,
      "formatted_start": "03:37:26.000",
      "formatted_end": "03:37:28.000",
      "text": "تب ندهید"
    },
    {
      "id": 31,
      "start": 13048.0,
      "end": 13050.0,
      "formatted_start": "03:37:28.000",
      "formatted_end": "03:37:30.000",
      "text": "الان تب بر بشدید"
    },
    {
      "id": 32,
      "start": 13050.0,
      "end": 13052.0,
      "formatted_start": "03:37:30.000",
      "formatted_end": "03:37:32.000",
      "text": "نه نه هیچی بشن ندارم"
    },
    {
      "id": 33,
      "start": 13052.0,
      "end": 13054.0,
      "formatted_start": "03:37:32.000",
      "formatted_end": "03:37:34.000",
      "text": "آره اونو خاطره آده جان بسیار بشه"
    },
    {
      "id": 34,
      "start": 13054.0,
      "end": 13056.0,
      "formatted_start": "03:37:34.000",
      "formatted_end": "03:37:36.000",
      "text": "آده چون آقایی روشن بشه"
    },
    {
      "id": 35,
      "start": 13056.0,
      "end": 13058.0,
      "formatted_start": "03:37:36.000",
      "formatted_end": "03:37:38.000",
      "text": "آره بگیرم"
    },
    {
      "id": 36,
      "start": 13058.0,
      "end": 13060.0,
      "formatted_start": "03:37:38.000",
      "formatted_end": "03:37:40.000",
      "text": "آره"
    },
    {
      "id": 37,
      "start": 13060.0,
      "end": 13062.0,
      "formatted_start": "03:37:40.000",
      "formatted_end": "03:37:42.000",
      "text": "آره دبینی کم کیلو شدیتو"
    },
    {
      "id": 38,
      "start": 13062.0,
      "end": 13064.0,
      "formatted_start": "03:37:42.000",
      "formatted_end": "03:37:44.000",
      "text": "پسر خوشگه"
    },
    {
      "id": 39,
      "start": 13064.0,
      "end": 13066.0,
      "formatted_start": "03:37:44.000",
      "formatted_end": "03:37:46.000",
      "text": "پسر شدید آقاوی شدگیر"
    },
    {
      "id": 40,
      "start": 13066.0,
      "end": 13068.0,
      "formatted_start": "03:37:46.000",
      "formatted_end": "03:37:48.000",
      "text": "بزرگش اینجا آقا میشه"
    },
    {
      "id": 41,
      "start": 13070.9,
      "end": 13072.9,
      "formatted_start": "03:37:50.900",
      "formatted_end": "03:37:52.900",
      "text": "سه میگه هفت چند بود؟"
    },
    {
      "id": 42,
      "start": 13072.9,
      "end": 13073.9,
      "formatted_start": "03:37:52.900",
      "formatted_end": "03:37:53.900",
      "text": "هفت سه"
    },
    {
      "id": 43,
      "start": 13073.9,
      "end": 13074.9,
      "formatted_start": "03:37:53.900",
      "formatted_end": "03:37:54.900",
      "text": "یک شمب هست"
    },
    {
      "id": 44,
      "start": 13074.9,
      "end": 13075.9,
      "formatted_start": "03:37:54.900",
      "formatted_end": "03:37:55.900",
      "text": "هفت شاند"
    },
    {
      "id": 45,
      "start": 13075.9,
      "end": 13076.9,
      "formatted_start": "03:37:55.900",
      "formatted_end": "03:37:56.900",
      "text": "یک شمب هست"
    },
    {
      "id": 46,
      "start": 13076.9,
      "end": 13078.9,
      "formatted_start": "03:37:56.900",
      "formatted_end": "03:37:58.900",
      "text": "آره، در حیمیه بالا"
    },
    {
      "id": 47,
      "start": 13078.9,
      "end": 13079.9,
      "formatted_start": "03:37:58.900",
      "formatted_end": "03:37:59.900",
      "text": "خوب"
    },
    {
      "id": 48,
      "start": 13079.9,
      "end": 13080.9,
      "formatted_start": "03:37:59.900",
      "formatted_end": "03:38:00.900",
      "text": "خوب"
    },
    {
      "id": 49,
      "start": 13080.9,
      "end": 13081.9,
      "formatted_start": "03:38:00.900",
      "formatted_end": "03:38:01.900",
      "text": "پشت مرگی بود؟"
    },
    {
      "id": 50,
      "start": 13081.9,
      "end": 13084.9,
      "formatted_start": "03:38:01.900",
      "formatted_end": "03:38:04.900",
      "text": "آره، بر اینجا مرگ شدن اش موشخه"
    },
    {
      "id": 51,
      "start": 13084.9,
      "end": 13086.9,
      "formatted_start": "03:38:04.900",
      "formatted_end": "03:38:06.900",
      "text": "از لباسش موشخه خوداش"
    },
    {
      "id": 52,
      "start": 13086.9,
      "end": 13088.9,
      "formatted_start": "03:38:06.900",
      "formatted_end": "03:38:08.900",
      "text": "من برای دماخوردکش دارون میدم"
    },
    {
      "id": 53,
      "start": 13088.9,
      "end": 13090.9,
      "formatted_start": "03:38:08.900",
      "formatted_end": "03:38:10.900",
      "text": "دیگه اونم خوب شد"
    },
    {
      "id": 54,
      "start": 13090.9,
      "end": 13092.9,
      "formatted_start": "03:38:10.900",
      "formatted_end": "03:38:12.900",
      "text": "یک کچون دماخورده"
    },
    {
      "id": 55,
      "start": 13092.9,
      "end": 13094.9,
      "formatted_start": "03:38:12.900",
      "formatted_end": "03:38:14.900",
      "text": "آره، میگم چون بینیش موشخه سه"
    },
    {
      "id": 56,
      "start": 13094.9,
      "end": 13096.9,
      "formatted_start": "03:38:14.900",
      "formatted_end": "03:38:16.900",
      "text": "ایجادم"
    },
    {
      "id": 57,
      "start": 13096.9,
      "end": 13098.9,
      "formatted_start": "03:38:16.900",
      "formatted_end": "03:38:18.900",
      "text": "ایجادم"
    },
    {
      "id": 58,
      "start": 13098.9,
      "end": 13100.9,
      "formatted_start": "03:38:18.900",
      "formatted_end": "03:38:20.900",
      "text": "باید بگذاریم"
    },
    {
      "id": 59,
      "start": 13100.9,
      "end": 13102.9,
      "formatted_start": "03:38:20.900",
      "formatted_end": "03:38:22.900",
      "text": "بفرمایی"
    },
    {
      "id": 60,
      "start": 13102.9,
      "end": 13104.9,
      "formatted_start": "03:38:22.900",
      "formatted_end": "03:38:24.900",
      "text": "خب"
    },
    {
      "id": 61,
      "start": 13104.9,
      "end": 13106.9,
      "formatted_start": "03:38:24.900",
      "formatted_end": "03:38:26.900",
      "text": "چرا هسته؟"
    },
    {
      "id": 62,
      "start": 13106.9,
      "end": 13112.9,
      "formatted_start": "03:38:26.900",
      "formatted_end": "03:38:32.900",
      "text": "از حاله باسشم بیشتر شده نسبتا"
    },
    {
      "id": 63,
      "start": 13112.9,
      "end": 13114.9,
      "formatted_start": "03:38:32.900",
      "formatted_end": "03:38:34.900",
      "text": "آره میدونه بارون بود"
    },
    {
      "id": 64,
      "start": 13114.9,
      "end": 13116.9,
      "formatted_start": "03:38:34.900",
      "formatted_end": "03:38:36.900",
      "text": "من فکر کردم اینجام بارون هست"
    },
    {
      "id": 65,
      "start": 13116.9,
      "end": 13118.9,
      "formatted_start": "03:38:36.900",
      "formatted_end": "03:38:38.900",
      "text": "انا خیلی گرمه اینجام"
    },
    {
      "id": 66,
      "start": 13124.9,
      "end": 13126.9,
      "formatted_start": "03:38:44.900",
      "formatted_end": "03:38:46.900",
      "text": "از اینجا باید برداریم."
    },
    {
      "id": 67,
      "start": 13126.9,
      "end": 13128.9,
      "formatted_start": "03:38:46.900",
      "formatted_end": "03:38:48.900",
      "text": "از اینجا باید برداریم."
    },
    {
      "id": 68,
      "start": 13128.9,
      "end": 13130.9,
      "formatted_start": "03:38:48.900",
      "formatted_end": "03:38:50.900",
      "text": "از اینجا باید برداریم."
    },
    {
      "id": 69,
      "start": 13130.9,
      "end": 13132.9,
      "formatted_start": "03:38:50.900",
      "formatted_end": "03:38:52.900",
      "text": "از اینجا باید برداریم."
    },
    {
      "id": 70,
      "start": 13132.9,
      "end": 13134.9,
      "formatted_start": "03:38:52.900",
      "formatted_end": "03:38:54.900",
      "text": "از اینجا باید برداریم."
    },
    {
      "id": 71,
      "start": 13134.9,
      "end": 13136.9,
      "formatted_start": "03:38:54.900",
      "formatted_end": "03:38:56.900",
      "text": "از اینجا باید برداریم."
    },
    {
      "id": 72,
      "start": 13136.9,
      "end": 13138.9,
      "formatted_start": "03:38:56.900",
      "formatted_end": "03:38:58.900",
      "text": "از اینجا باید برداریم."
    },
    {
      "id": 73,
      "start": 13138.9,
      "end": 13140.9,
      "formatted_start": "03:38:58.900",
      "formatted_end": "03:39:00.900",
      "text": "از اینجا باید برداریم."
    },
    {
      "id": 74,
      "start": 13140.9,
      "end": 13142.9,
      "formatted_start": "03:39:00.900",
      "formatted_end": "03:39:02.900",
      "text": "از اینجا باید برداریم."
    },
    {
      "id": 75,
      "start": 13142.9,
      "end": 13144.9,
      "formatted_start": "03:39:02.900",
      "formatted_end": "03:39:04.900",
      "text": "از اینجا باید برداریم."
    },
    {
      "id": 76,
      "start": 13144.9,
      "end": 13146.9,
      "formatted_start": "03:39:04.900",
      "formatted_end": "03:39:06.900",
      "text": "از اینجا باید برداریم."
    },
    {
      "id": 77,
      "start": 13146.9,
      "end": 13151.9,
      "formatted_start": "03:39:06.900",
      "formatted_end": "03:39:11.900",
      "text": "اما 3-4 ساعت یک با فرش"
    },
    {
      "id": 78,
      "start": 13151.9,
      "end": 13156.9,
      "formatted_start": "03:39:11.900",
      "formatted_end": "03:39:16.900",
      "text": "یه قطره بینیر به تمت از آن براش بنویسن"
    },
    {
      "id": 79,
      "start": 13156.9,
      "end": 13160.9,
      "formatted_start": "03:39:16.900",
      "formatted_end": "03:39:20.900",
      "text": "شبایی قطره به بیش"
    },
    {
      "id": 80,
      "start": 13160.9,
      "end": 13163.9,
      "formatted_start": "03:39:20.900",
      "formatted_end": "03:39:23.900",
      "text": "و قطره پروتکتو داری؟"
    },
    {
      "id": 81,
      "start": 13163.9,
      "end": 13166.9,
      "formatted_start": "03:39:23.900",
      "formatted_end": "03:39:26.900",
      "text": "بله، گفت قطره کنیم ندم"
    },
    {
      "id": 82,
      "start": 13166.9,
      "end": 13168.9,
      "formatted_start": "03:39:26.900",
      "formatted_end": "03:39:28.900",
      "text": "چی باشه میده؟ بچه باشه"
    },
    {
      "id": 83,
      "start": 13168.9,
      "end": 13171.9,
      "formatted_start": "03:39:28.900",
      "formatted_end": "03:39:31.900",
      "text": "اگه بیتمام شده یه نگیرم هم پروکی دادم بلا تا 6 ماهی"
    },
    {
      "id": 84,
      "start": 13171.9,
      "end": 13173.9,
      "formatted_start": "03:39:31.900",
      "formatted_end": "03:39:33.900",
      "text": "آه، پروکی دو پس داریم"
