  "stt_segments": [
    {
      "id": 0,
      "start": 13500.0,
      "end": 13502.0,
      "formatted_start": "03:45:00.000",
      "formatted_end": "03:45:02.000",
      "text": "افریقی بردارید."
    },
    {
      "id": 1,
      "start": 13502.0,
      "end": 13504.0,
      "formatted_start": "03:45:02.000",
      "formatted_end": "03:45:04.000",
      "text": "افریقی بردارید."
    },
    {
      "id": 2,
      "start": 13504.0,
      "end": 13506.0,
      "formatted_start": "03:45:04.000",
      "formatted_end": "03:45:06.000",
      "text": "چهاره تا؟"
    },
    {
      "id": 3,
      "start": 13506.0,
      "end": 13508.0,
      "formatted_start": "03:45:06.000",
      "formatted_end": "03:45:08.000",
      "text": "مزید."
    },
    {
      "id": 4,
      "start": 13508.0,
      "end": 13510.0,
      "formatted_start": "03:45:08.000",
      "formatted_end": "03:45:10.000",
      "text": "خب، ببین سینه خوشم خشکه شده."
    },
    {
      "id": 5,
      "start": 13510.0,
      "end": 13512.0,
      "formatted_start": "03:45:10.000",
      "formatted_end": "03:45:12.000",
      "text": "آره، خب درست داری؟"
    },
    {
      "id": 6,
      "start": 13512.0,
      "end": 13514.0,
      "formatted_start": "03:45:12.000",
      "formatted_end": "03:45:14.000",
      "text": "دم تو باستان."
    },
    {
      "id": 7,
      "start": 13514.0,
      "end": 13516.0,
      "formatted_start": "03:45:14.000",
      "formatted_end": "03:45:16.000",
      "text": "خب، تره هم الان داره؟"
    },
    {
      "id": 8,
      "start": 13516.0,
      "end": 13518.0,
      "formatted_start": "03:45:16.000",
      "formatted_end": "03:45:18.000",
      "text": "خب، اینجا تره ندارن."
    },
    {
      "id": 9,
      "start": 13518.0,
      "end": 13520.0,
      "formatted_start": "03:45:18.000",
      "formatted_end": "03:45:20.000",
      "text": "بعد آبریزش بینی شد."
    },
    {
      "id": 10,
      "start": 13520.0,
      "end": 13522.0,
      "formatted_start": "03:45:20.000",
      "formatted_end": "03:45:22.000",
      "text": "آبریزش بینی دارن، هم روی تو."
    },
    {
      "id": 11,
      "start": 13524.0,
      "end": 13526.0,
      "formatted_start": "03:45:24.000",
      "formatted_end": "03:45:26.000",
      "text": "اینو خوب میکنم، کیانو."
    },
    {
      "id": 12,
      "start": 13526.0,
      "end": 13528.0,
      "formatted_start": "03:45:26.000",
      "formatted_end": "03:45:28.000",
      "text": "کیانو خوب میشه بابا اصلا."
    },
    {
      "id": 13,
      "start": 13528.0,
      "end": 13530.0,
      "formatted_start": "03:45:28.000",
      "formatted_end": "03:45:30.000",
      "text": "بسه در رفت"
    },
    {
      "id": 14,
      "start": 13530.0,
      "end": 13532.0,
      "formatted_start": "03:45:30.000",
      "formatted_end": "03:45:32.000",
      "text": "دو شوهرم یکی باید باشه مالو جمع کنه"
    },
    {
      "id": 15,
      "start": 13532.0,
      "end": 13534.0,
      "formatted_start": "03:45:32.000",
      "formatted_end": "03:45:34.000",
      "text": "چون بوی رنگ میده"
    },
    {
      "id": 16,
      "start": 13534.0,
      "end": 13536.0,
      "formatted_start": "03:45:34.000",
      "formatted_end": "03:45:36.000",
      "text": "بوی رنگ میده اینجا؟"
    },
    {
      "id": 17,
      "start": 13536.0,
      "end": 13538.0,
      "formatted_start": "03:45:36.000",
      "formatted_end": "03:45:38.000",
      "text": "نه این"
    },
    {
      "id": 18,
      "start": 13538.0,
      "end": 13540.0,
      "formatted_start": "03:45:38.000",
      "formatted_end": "03:45:40.000",
      "text": "کیانه رو معاینه میکنم بوی رنگ میده"
    },
    {
      "id": 19,
      "start": 13540.0,
      "end": 13544.0,
      "formatted_start": "03:45:40.000",
      "formatted_end": "03:45:44.000",
      "text": "نه شاید لباسشو بازم استرس میشورمه"
    },
    {
      "id": 20,
      "start": 13544.0,
      "end": 13546.0,
      "formatted_start": "03:45:44.000",
      "formatted_end": "03:45:46.000",
      "text": "ممکنه؟"
    },
    {
      "id": 21,
      "start": 13548.0,
      "end": 13550.0,
      "formatted_start": "03:45:48.000",
      "formatted_end": "03:45:50.000",
      "text": "نه"
    },
    {
      "id": 22,
      "start": 13550.0,
      "end": 13552.0,
      "formatted_start": "03:45:50.000",
      "formatted_end": "03:45:52.000",
      "text": "بس دیگه رنگ نره"
    },
    {
      "id": 23,
      "start": 13554.0,
      "end": 13556.0,
      "formatted_start": "03:45:54.000",
      "formatted_end": "03:45:56.000",
      "text": "شاید موحیت باید میده"
    },
    {
      "id": 24,
      "start": 13556.0,
      "end": 13558.0,
      "formatted_start": "03:45:56.000",
      "formatted_end": "03:45:58.000",
      "text": "بایده؟"
    },
    {
      "id": 25,
      "start": 13558.0,
      "end": 13560.0,
      "formatted_start": "03:45:58.000",
      "formatted_end": "03:46:00.000",
      "text": "چون لباس بچه بزرگی"
    },
    {
      "id": 26,
      "start": 13560.0,
      "end": 13562.0,
      "formatted_start": "03:46:00.000",
      "formatted_end": "03:46:02.000",
      "text": "وایتکس زدی؟"
    },
    {
      "id": 27,
      "start": 13562.0,
      "end": 13564.0,
      "formatted_start": "03:46:02.000",
      "formatted_end": "03:46:04.000",
      "text": "نه"
    },
    {
      "id": 28,
      "start": 13564.0,
      "end": 13566.0,
      "formatted_start": "03:46:04.000",
      "formatted_end": "03:46:06.000",
      "text": "او از دیرون میاد تو سالان خاموش"
    },
    {
      "id": 29,
      "start": 13566.0,
      "end": 13568.0,
      "formatted_start": "03:46:06.000",
      "formatted_end": "03:46:08.000",
      "text": "او وایتکس میاد"
    },
    {
      "id": 30,
      "start": 13568.0,
      "end": 13570.0,
      "formatted_start": "03:46:08.000",
      "formatted_end": "03:46:10.000",
      "text": "نه وایتکس نیست از تو سالانه"
    },
    {
      "id": 31,
      "start": 13570.0,
      "end": 13572.0,
      "formatted_start": "03:46:10.000",
      "formatted_end": "03:46:12.000",
      "text": "بعد یکی دیگه خاموش بود"
    },
    {
      "id": 32,
      "start": 13572.0,
      "end": 13574.0,
      "formatted_start": "03:46:12.000",
      "formatted_end": "03:46:14.000",
      "text": "نه من کنستم نکنه این بچه بوی وایتکس"
    },
    {
      "id": 33,
      "start": 13574.0,
      "end": 13576.0,
      "formatted_start": "03:46:14.000",
      "formatted_end": "03:46:16.000",
      "text": "خواده وایتکس خب صفحه رو بدتر میکنه"
    },
    {
      "id": 34,
      "start": 13576.0,
      "end": 13578.0,
      "formatted_start": "03:46:16.000",
      "formatted_end": "03:46:18.000",
      "text": "نه نه"
    },
    {
      "id": 35,
      "start": 13578.0,
      "end": 13580.0,
      "formatted_start": "03:46:18.000",
      "formatted_end": "03:46:20.000",
      "text": "لباس های من مدام سوس میشن"
    },
    {
      "id": 36,
      "start": 13580.0,
      "end": 13582.0,
      "formatted_start": "03:46:20.000",
      "formatted_end": "03:46:22.000",
      "text": "نه نه"
    },
    {
      "id": 37,
      "start": 13582.0,
      "end": 13584.0,
      "formatted_start": "03:46:22.000",
      "formatted_end": "03:46:24.000",
      "text": "خب ببین عزیزم"
    },
    {
      "id": 38,
      "start": 13584.0,
      "end": 13592.0,
      "formatted_start": "03:46:24.000",
      "formatted_end": "03:46:32.000",
      "text": "بچه ها وقتی یک ویروس میگنند سرما خورند، یک جایی میگنند که حساسیت هایی هستند"
    },
    {
      "id": 39,
      "start": 13592.0,
      "end": 13599.0,
      "formatted_start": "03:46:32.000",
      "formatted_end": "03:46:39.000",
      "text": "مثلا بوی بایدتویس، گربه غبار، بوی از سوات فلون، این ها باعث میشه که این آلرژیشون تشکیل میشه"
    },
    {
      "id": 40,
      "start": 13599.0,
      "end": 13603.0,
      "formatted_start": "03:46:39.000",
      "formatted_end": "03:46:43.000",
      "text": "ولی بیشتر این چیزی که این آلرژیشون تشکیل میکنه یک ویروس هست، یک سرما خوردگی"
    },
    {
      "id": 41,
      "start": 13603.0,
      "end": 13604.0,
      "formatted_start": "03:46:43.000",
      "formatted_end": "03:46:44.000",
      "text": "آره همین سرما خوردگی"
    },
    {
      "id": 42,
      "start": 13604.0,
      "end": 13607.2,
      "formatted_start": "03:46:44.000",
      "formatted_end": "03:46:47.200",
      "text": "سرما میخورند و سرما خودگی خوب نیست"
    },
    {
      "id": 43,
      "start": 13607.2,
      "end": 13612.0,
      "formatted_start": "03:46:47.200",
      "formatted_end": "03:46:52.000",
      "text": "و منتها این آلرژی ممکنه 4 الا 6 ادامه پیدا بکنند"
    },
    {
      "id": 44,
      "start": 13612.0,
      "end": 13616.6,
      "formatted_start": "03:46:52.000",
      "formatted_end": "03:46:56.600",
      "text": "و درمان این صرفه های آلرژی که شما خبون استفاده باشند"
    },
    {
      "id": 45,
      "start": 13616.6,
      "end": 13617.8,
      "formatted_start": "03:46:56.600",
      "formatted_end": "03:46:57.800",
      "text": "بقیه خبون استفاده باشند"
    },
    {
      "id": 46,
      "start": 13617.8,
      "end": 13618.8,
      "formatted_start": "03:46:57.800",
      "formatted_end": "03:46:58.800",
      "text": "خبون استفاده باشند"
    },
    {
      "id": 47,
      "start": 13618.8,
      "end": 13624.16,
      "formatted_start": "03:46:58.800",
      "formatted_end": "03:47:04.160",
      "text": "خانم دوشور من شربت چک خوشکنشون رو عوض نکنم"
    },
    {
      "id": 48,
      "start": 13624.16,
      "end": 13624.76,
      "formatted_start": "03:47:04.160",
      "formatted_end": "03:47:04.760",
      "text": "از اینکه"
    },
    {
      "id": 49,
      "start": 13624.76,
      "end": 13625.6,
      "formatted_start": "03:47:04.760",
      "formatted_end": "03:47:05.600",
      "text": "چک نداری"
    },
    {
      "id": 50,
      "start": 13625.6,
      "end": 13626.8,
      "formatted_start": "03:47:05.600",
      "formatted_end": "03:47:06.800",
      "text": "گلوشون رو افراد نداری"
    },
    {
      "id": 51,
      "start": 13626.8,
      "end": 13628.4,
      "formatted_start": "03:47:06.800",
      "formatted_end": "03:47:08.400",
      "text": "اصلا افراد نداری"
    },
    {
      "id": 52,
      "start": 13628.4,
      "end": 13629.52,
      "formatted_start": "03:47:08.400",
      "formatted_end": "03:47:09.520",
      "text": "از این چک خوشکن"
    },
    {
      "id": 53,
      "start": 13629.52,
      "end": 13635.6,
      "formatted_start": "03:47:09.520",
      "formatted_end": "03:47:15.600",
      "text": "آب ریزه بینیشون رو میبینن مخاطبینشون یه بردی سفید یا سبزش کنند"
    },
    {
      "id": 54,
      "start": 13635.6,
      "end": 13639.96,
      "formatted_start": "03:47:15.600",
      "formatted_end": "03:47:19.960",
      "text": "گاهی سبز باشه اشکال نده با بخته میگیم او که نرد سینوز دارن"
    },
    {
      "id": 55,
      "start": 13639.96,
      "end": 13645.96,
      "formatted_start": "03:47:19.960",
      "formatted_end": "03:47:25.960",
      "text": "که آب بینی قلیب چرکی سفز بیش از چلاهش ساعت از بینیشون"
    },
    {
      "id": 56,
      "start": 13645.96,
      "end": 13647.52,
      "formatted_start": "03:47:25.960",
      "formatted_end": "03:47:27.520",
      "text": "نه اونطوری نیست"
    },
    {
      "id": 57,
      "start": 13647.52,
      "end": 13650.52,
      "formatted_start": "03:47:27.520",
      "formatted_end": "03:47:30.520",
      "text": "میرد و مثلا هیویلونگ در این پایش میفنند"
    },
    {
      "id": 58,
      "start": 13650.52,
      "end": 13653.52,
      "formatted_start": "03:47:30.520",
      "formatted_end": "03:47:33.520",
      "text": "سفیده ولی گاهی ممکنه یه ذره سفیدش کنند"
    },
    {
      "id": 59,
      "start": 13653.52,
      "end": 13655.52,
      "formatted_start": "03:47:33.520",
      "formatted_end": "03:47:35.520",
      "text": "آره آره"
    },
    {
      "id": 60,
      "start": 13655.52,
      "end": 13656.52,
      "formatted_start": "03:47:35.520",
      "formatted_end": "03:47:36.520",
      "text": "آره"
    },
    {
      "id": 61,
      "start": 13656.52,
      "end": 13657.52,
      "formatted_start": "03:47:36.520",
      "formatted_end": "03:47:37.520",
      "text": "کمخواه"
    },
    {
      "id": 62,
      "start": 13657.52,
      "end": 13660.52,
      "formatted_start": "03:47:37.520",
      "formatted_end": "03:47:40.520",
      "text": "خب بیا بگو ستاره بده"
    },
    {
      "id": 63,
      "start": 13660.52,
      "end": 13663.52,
      "formatted_start": "03:47:40.520",
      "formatted_end": "03:47:43.520",
      "text": "وای بلیان جیسه"
    },
    {
      "id": 64,
      "start": 13667.52,
      "end": 13670.52,
      "formatted_start": "03:47:47.520",
      "formatted_end": "03:47:50.520",
      "text": "یکیش مال شما یکیشم بره خب"
    },
    {
      "id": 65,
      "start": 13671.52,
      "end": 13673.52,
      "formatted_start": "03:47:51.520",
      "formatted_end": "03:47:53.520",
      "text": "بیا همهش مال تو"
    },
    {
      "id": 66,
      "start": 13673.52,
      "end": 13674.52,
      "formatted_start": "03:47:53.520",
      "formatted_end": "03:47:54.520",
      "text": "وای ممنونه"
    },
    {
      "id": 67,
      "start": 13674.52,
      "end": 13676.52,
      "formatted_start": "03:47:54.520",
      "formatted_end": "03:47:56.520",
      "text": "بخواهم خانم"
    },
    {
      "id": 68,
      "start": 13676.52,
      "end": 13679.52,
      "formatted_start": "03:47:56.520",
      "formatted_end": "03:47:59.520",
      "text": "خانم نمیاده خیلی چیزا نزدیک بشی"
    },
    {
      "id": 69,
      "start": 13679.52,
      "end": 13680.52,
      "formatted_start": "03:47:59.520",
      "formatted_end": "03:48:00.520",
      "text": "خب بگیر"
    },
    {
      "id": 70,
      "start": 13680.52,
      "end": 13681.52,
      "formatted_start": "03:48:00.520",
      "formatted_end": "03:48:01.520",
      "text": "دوست دوست دوست"
    },
    {
      "id": 71,
      "start": 13681.52,
      "end": 13685.52,
      "formatted_start": "03:48:01.520",
      "formatted_end": "03:48:05.520",
      "text": "چیانهای من همینجوری سرماهه خب من هر دو رو مثلا دوزای داروش بخواهم کمتر بینم بیشتر"
    },
    {
      "id": 72,
      "start": 13685.52,
      "end": 13687.52,
      "formatted_start": "03:48:05.520",
      "formatted_end": "03:48:07.520",
      "text": "این هم میموندن"
    },
    {
      "id": 73,
      "start": 13687.52,
      "end": 13689.52,
      "formatted_start": "03:48:07.520",
      "formatted_end": "03:48:09.520",
      "text": "ولی پری ها مثلا دیگه صوفه"
    },
    {
      "id": 74,
      "start": 13689.52,
      "end": 13691.52,
      "formatted_start": "03:48:09.520",
      "formatted_end": "03:48:11.520",
      "text": "کیانا صوفه نمیشه ای که صوفه میخونه"
    },
    {
      "id": 75,
      "start": 13691.52,
      "end": 13693.52,
      "formatted_start": "03:48:11.520",
      "formatted_end": "03:48:13.520",
      "text": "نه اینه که چه حالا هم"
    },
    {
      "id": 76,
      "start": 13693.52,
      "end": 13695.52,
      "formatted_start": "03:48:13.520",
      "formatted_end": "03:48:15.520",
      "text": "حالا یه مایه هشتار ببین اسپری سالبوتامولی"
    },
    {
      "id": 77,
      "start": 13695.52,
      "end": 13697.52,
      "formatted_start": "03:48:15.520",
      "formatted_end": "03:48:17.520",
      "text": "یه همون آبیه هست"
    },
    {
      "id": 78,
      "start": 13697.52,
      "end": 13699.52,
      "formatted_start": "03:48:17.520",
      "formatted_end": "03:48:19.520",
      "text": "بله اون داره تو"
    },
    {
      "id": 79,
      "start": 13699.52,
      "end": 13701.52,
      "formatted_start": "03:48:19.520",
      "formatted_end": "03:48:21.520",
      "text": "خب الان که رفتی خونه هر ساعت"
    },
    {
      "id": 80,
      "start": 13701.52,
      "end": 13703.52,
      "formatted_start": "03:48:21.520",
      "formatted_end": "03:48:23.520",
      "text": "دو پاف براش بزن"
    },
    {
      "id": 81,
      "start": 13703.52,
      "end": 13705.52,
      "formatted_start": "03:48:23.520",
      "formatted_end": "03:48:25.520",
      "text": "تا آخر شب"
    },
    {
      "id": 82,
      "start": 13705.52,
      "end": 13707.52,
      "formatted_start": "03:48:25.520",
      "formatted_end": "03:48:27.520",
      "text": "از فردان دیگه فقط"
    },
    {
      "id": 83,
      "start": 13707.52,
      "end": 13709.52,
      "formatted_start": "03:48:27.520",
      "formatted_end": "03:48:29.520",
      "text": "صبح و اصفر شب"
    },
    {
      "id": 84,
      "start": 13709.52,
      "end": 13711.52,
      "formatted_start": "03:48:29.520",
      "formatted_end": "03:48:31.520",
      "text": "خب بعد"
    },
    {
      "id": 85,
      "start": 13711.52,
      "end": 13713.52,
      "formatted_start": "03:48:31.520",
      "formatted_end": "03:48:33.520",
      "text": "یه اسپری نارنجی هم براش میده"
    },
    {
      "id": 86,
      "start": 13713.52,
      "end": 13715.52,
      "formatted_start": "03:48:33.520",
      "formatted_end": "03:48:35.520",
      "text": "۱۸ ساعت دوخواب بزن"
    },
    {
      "id": 87,
      "start": 13715.52,
      "end": 13717.52,
      "formatted_start": "03:48:35.520",
      "formatted_end": "03:48:37.520",
      "text": "ستریزین که داری"
    },
    {
      "id": 88,
      "start": 13717.52,
      "end": 13719.52,
      "formatted_start": "03:48:37.520",
      "formatted_end": "03:48:39.520",
      "text": "خب دکتر میانه کلامتون"
    },
    {
      "id": 89,
      "start": 13719.52,
      "end": 13722.52,
      "formatted_start": "03:48:39.520",
      "formatted_end": "03:48:42.520",
      "text": "این آبریزش بینیشو با ستریزین بر طرف نمیشه"
    },
    {
      "id": 90,
      "start": 13722.52,
      "end": 13723.52,
      "formatted_start": "03:48:42.520",
      "formatted_end": "03:48:43.520",
      "text": "من چرا بگم؟"
    },
    {
      "id": 91,
      "start": 13723.52,
      "end": 13727.52,
      "formatted_start": "03:48:43.520",
      "formatted_end": "03:48:47.520",
      "text": "یه دیگه دارن چی بود؟ ستالین به اسمه؟"
    },
    {
      "id": 92,
      "start": 13727.52,
      "end": 13729.52,
      "formatted_start": "03:48:47.520",
      "formatted_end": "03:48:49.520",
      "text": "نه ستالین خب بیاد دادنش خوبیست"
    },
    {
      "id": 93,
      "start": 13729.52,
      "end": 13732.52,
      "formatted_start": "03:48:49.520",
      "formatted_end": "03:48:52.520",
      "text": "یه مورد برنامه تا این کار رو انجام بده"
    },
    {
      "id": 94,
      "start": 13732.52,
      "end": 13734.52,
      "formatted_start": "03:48:52.520",
      "formatted_end": "03:48:54.520",
      "text": "ستریزین شبیه ستریزینش بده"
    },
    {
      "id": 95,
      "start": 13734.52,
      "end": 13738.52,
      "formatted_start": "03:48:54.520",
      "formatted_end": "03:48:58.520",
      "text": "یه پودر منتلوکاست هم از رابش بزن"
    },
    {
      "id": 96,
      "start": 13738.52,
      "end": 13740.52,
      "formatted_start": "03:48:58.520",
      "formatted_end": "03:49:00.520",
      "text": "این آبریزشو بینیش خوب بکنه"
    },
    {
      "id": 97,
      "start": 13740.52,
      "end": 13747.04,
      "formatted_start": "03:49:00.520",
      "formatted_end": "03:49:07.040",
      "text": "کودرمانتلوکاس رو می‌کنی تو ماز بهیزی، تو آب بریزی، توی آب می‌به بریزی، بهش بگیر"
    },
    {
      "id": 98,
      "start": 13747.04,
      "end": 13748.92,
      "formatted_start": "03:49:07.040",
      "formatted_end": "03:49:08.920",
      "text": "ها، تا"
    },
    {
      "id": 99,
      "start": 13748.92,
      "end": 13752.92,
      "formatted_start": "03:49:08.920",
      "formatted_end": "03:49:12.920",
      "text": "من مثلا براش نشسته دیشت گم کردم بهش بخونم"
    },
    {
      "id": 100,
      "start": 13752.92,
      "end": 13757.92,
      "formatted_start": "03:49:12.920",
      "formatted_end": "03:49:17.920",
      "text": "اونی آلرژیه به صدواری بیشتر که تکلیج باشه، مثلا بر نشسته خریدون می‌شه"
    },
    {
      "id": 101,
      "start": 13757.92,
      "end": 13762.92,
      "formatted_start": "03:49:17.920",
      "formatted_end": "03:49:22.920",
      "text": "ولی تا اشتیاد آلرژی باشه، این برانششه که دو چاره اعتماد شده"
    },
    {
      "id": 102,
      "start": 13762.92,
      "end": 13764.92,
      "formatted_start": "03:49:22.920",
      "formatted_end": "03:49:24.920",
      "text": "ریه است، درسته"
    },
    {
      "id": 103,
      "start": 13764.92,
      "end": 13766.92,
      "formatted_start": "03:49:24.920",
      "formatted_end": "03:49:26.920",
      "text": "برانشش، ریه نیست"
    },
    {
      "id": 104,
      "start": 13766.92,
      "end": 13767.92,
      "formatted_start": "03:49:26.920",
      "formatted_end": "03:49:27.920",
      "text": "مجاری"
    },
    {
      "id": 105,
      "start": 13767.92,
      "end": 13768.92,
      "formatted_start": "03:49:27.920",
      "formatted_end": "03:49:28.920",
      "text": "مجاریه، آف بره"
    },
