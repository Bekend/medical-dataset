  "stt_segments": [
    {
      "id": 0,
      "start": 5700.0,
      "end": 5702.0,
      "formatted_start": "01:35:00.000",
      "formatted_end": "01:35:02.000",
      "text": "آره، خواستم میشه که..."
    },
    {
      "id": 1,
      "start": 5702.0,
      "end": 5703.0,
      "formatted_start": "01:35:02.000",
      "formatted_end": "01:35:03.000",
      "text": "درست داره؟"
    },
    {
      "id": 2,
      "start": 5703.0,
      "end": 5706.5,
      "formatted_start": "01:35:03.000",
      "formatted_end": "01:35:06.500",
      "text": "اوه تو یه دو هفته پیش یه اوه خب ماما قلبم درد می کنه درد می کنه"
    },
    {
      "id": 3,
      "start": 5706.5,
      "end": 5710.0,
      "formatted_start": "01:35:06.500",
      "formatted_end": "01:35:10.000",
      "text": "بعد می خواهی می دونی اون جانب راست می گه دروگ بشه می گه دهن تو کنم"
    },
    {
      "id": 4,
      "start": 5710.0,
      "end": 5710.5,
      "formatted_start": "01:35:10.000",
      "formatted_end": "01:35:10.500",
      "text": "خب؟"
    },
    {
      "id": 5,
      "start": 5710.5,
      "end": 5712.5,
      "formatted_start": "01:35:10.500",
      "formatted_end": "01:35:12.500",
      "text": "که اینجوری مثلا باش چیزی بگیر"
    },
    {
      "id": 6,
      "start": 5712.5,
      "end": 5716.0,
      "formatted_start": "01:35:12.500",
      "formatted_end": "01:35:16.000",
      "text": "بعد، هی آبور که ماما دروگ نمیگن دروگ نمیگن"
    },
    {
      "id": 7,
      "start": 5716.0,
      "end": 5718.0,
      "formatted_start": "01:35:16.000",
      "formatted_end": "01:35:18.000",
      "text": "هی می گفت از اینجا می زنه به قلبم"
    },
    {
      "id": 8,
      "start": 5718.0,
      "end": 5722.0,
      "formatted_start": "01:35:18.000",
      "formatted_end": "01:35:22.000",
      "text": "بعد یه تونی دو هفته من هر روز می پرسنم داری؟ داری؟ قلبتر داری؟"
    },
    {
      "id": 9,
      "start": 5722.0,
      "end": 5723.0,
      "formatted_start": "01:35:22.000",
      "formatted_end": "01:35:23.000",
      "text": "هی می گه نه"
    },
    {
      "id": 10,
      "start": 5723.0,
      "end": 5724.0,
      "formatted_start": "01:35:23.000",
      "formatted_end": "01:35:24.000",
      "text": "امم"
    },
    {
      "id": 11,
      "start": 5732.0,
      "end": 5736.0,
      "formatted_start": "01:35:32.000",
      "formatted_end": "01:35:36.000",
      "text": "در بیشتر اینجا میشون میده درده از عملی"
    },
    {
      "id": 12,
      "start": 5736.0,
      "end": 5738.0,
      "formatted_start": "01:35:36.000",
      "formatted_end": "01:35:38.000",
      "text": "درده اضطرابیه"
    },
    {
      "id": 13,
      "start": 5738.0,
      "end": 5740.0,
      "formatted_start": "01:35:38.000",
      "formatted_end": "01:35:40.000",
      "text": "اون رو بیاییم تا الان بشم"
    },
    {
      "id": 14,
      "start": 5740.0,
      "end": 5742.0,
      "formatted_start": "01:35:40.000",
      "formatted_end": "01:35:42.000",
      "text": "باید برداریم"
    },
    {
      "id": 15,
      "start": 5742.0,
      "end": 5744.0,
      "formatted_start": "01:35:42.000",
      "formatted_end": "01:35:44.000",
      "text": "باید برداریم"
    },
    {
