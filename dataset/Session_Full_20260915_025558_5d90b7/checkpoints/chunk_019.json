    },
    {
      "id": 117,
      "start": 5949.84,
      "end": 5974.94,
      "formatted_start": "01:39:09.840",
      "formatted_end": "01:39:34.940",
      "text": "ببینید از اینجا که از سرده هفته هشته بروک به بعد چیزایی خیلی آبکی نخورد"
    },
    {
      "id": 118,
      "start": 5974.94,
      "end": 5978.4,
      "formatted_start": "01:39:34.940",
      "formatted_end": "01:39:38.400",
      "text": "آق میتونه بخوره ولی چایی نخوره، هندوره نخوره"
    },
    {
      "id": 119,
      "start": 5978.4,
      "end": 5982.56,
      "formatted_start": "01:39:38.400",
      "formatted_end": "01:39:42.560",
      "text": "چیزا که امراضی هست، نوش آب نخوره، آبیبه نخوره، از هشت شب به بخور"
    },
    {
      "id": 120,
      "start": 5982.56,
      "end": 5989.46,
      "formatted_start": "01:39:42.560",
      "formatted_end": "01:39:49.460",
      "text": "قبل از اینکه بخواب دستشوی بگه، بعد از این دستشوی اومد، این اسپریو، این درماخشانی گذاریه که بزن توی این"
    },
    {
      "id": 121,
      "start": 5989.46,
      "end": 5992.46,
      "formatted_start": "01:39:49.460",
      "formatted_end": "01:39:52.460",
      "text": "این آن گذاریه که هم بزن توی این"
    },
    {
      "id": 122,
      "start": 5992.46,
      "end": 5995.5,
      "formatted_start": "01:39:52.460",
      "formatted_end": "01:39:55.500",
      "text": "تمام، دیگه میخواب با خیال رو بخورم"
    },
    {
      "id": 123,
      "start": 5995.5,
      "end": 5997.5,
      "formatted_start": "01:39:55.500",
      "formatted_end": "01:39:57.500",
      "text": "این آزمایش هر بیدم لازمه یا نه؟"
    }
  ],
