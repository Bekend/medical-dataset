    },
    {
      "id": 8,
      "start": 5116.0,
      "end": 5120.0,
      "formatted_start": "01:25:16.000",
      "formatted_end": "01:25:20.000",
      "text": "اینو من دیگه مراسم رفته بودم، لباسش گیپوری بود، خب؟"
    },
    {
      "id": 9,
      "start": 5120.0,
      "end": 5122.0,
      "formatted_start": "01:25:20.000",
      "formatted_end": "01:25:22.000",
      "text": "اینو من دیگه مراسم رفته بودم، لباسش گیپوری بود، خب؟"
    },
    {
      "id": 10,
      "start": 5122.0,
      "end": 5124.0,
      "formatted_start": "01:25:22.000",
      "formatted_end": "01:25:24.000",
      "text": "اینو من دیگه مراسم رفته بودم، لباسش گیپوری بود، خب؟"
    },
    {
      "id": 11,
      "start": 5124.0,
      "end": 5154.0,
      "formatted_start": "01:25:24.000",
      "formatted_end": "01:25:54.000",
      "text": "اینجا باید برداریم که اینجا باید برداریم که اینجا باید برداریم که اینجا باید برداریم که اینجا باید برداریم که اینجا باید برداریم که اینجا باید برداریم که اینجا باید برداریم که اینجا باید برداریم که اینجا باید برداریم که اینجا باید برداریم که اینجا باید برداریم که اینجا باید برداریم که اینجا باید برداریم ک"
    },
    {
      "id": 12,
      "start": 5154.0,
      "end": 5168.0,
      "formatted_start": "01:25:54.000",
      "formatted_end": "01:26:08.000",
      "text": "اینکه این روشتشون بیشتره نیاز به بیتامین دیه بیشتری دارن که استخونهاشون روشت بکنن"
    },
    {
      "id": 13,
      "start": 5168.0,
      "end": 5176.0,
      "formatted_start": "01:26:08.000",
      "formatted_end": "01:26:16.000",
      "text": "و اگر همه نرمی استخون بگیرن یعنی توپل میشن ولی استخونهاشون نرمیشن خب اینا حتما باید بکنن"
    },
    {
      "id": 14,
      "start": 5176.0,
      "end": 5183.24,
      "formatted_start": "01:26:16.000",
      "formatted_end": "01:26:23.240",
      "text": "بله دکتر اینقدر شما گفت خوبه ولی مثلا در کل اگه بخواییم برای قدرش یک چیز لازم هستن"
    },
    {
      "id": 15,
      "start": 5183.24,
      "end": 5185.76,
      "formatted_start": "01:26:23.240",
      "formatted_end": "01:26:25.760",
      "text": "یک چیز تقریتی بشه بگیم برای رشت خواهد بشه؟"
    },
    {
      "id": 16,
      "start": 5185.76,
      "end": 5189.32,
      "formatted_start": "01:26:25.760",
      "formatted_end": "01:26:29.320",
      "text": "اگه رشت خواهد دارو بخواهم بشه بدم باید خیلی برد نیستیم باشیم"
    },
    {
      "id": 17,
      "start": 5189.32,
      "end": 5191.34,
      "formatted_start": "01:26:29.320",
      "formatted_end": "01:26:31.340",
      "text": "نه نیازی ندارم"
    },
    {
      "id": 18,
      "start": 5191.34,
      "end": 5192.64,
      "formatted_start": "01:26:31.340",
      "formatted_end": "01:26:32.640",
      "text": "در کل نوریشی"
    },
    {
      "id": 19,
      "start": 5192.64,
      "end": 5193.68,
      "formatted_start": "01:26:32.640",
      "formatted_end": "01:26:33.680",
      "text": "انا شیر چی میخوره؟"
    },
    {
      "id": 20,
      "start": 5193.68,
      "end": 5194.74,
      "formatted_start": "01:26:33.680",
      "formatted_end": "01:26:34.740",
      "text": "شیر خودم میخورم"
    },
    {
      "id": 21,
      "start": 5194.74,
      "end": 5196.82,
      "formatted_start": "01:26:34.740",
      "formatted_end": "01:26:36.820",
      "text": "خیلی هم خوب شیر خوبی داری"
    },
    {
      "id": 22,
      "start": 5196.82,
      "end": 5200.34,
      "formatted_start": "01:26:36.820",
      "formatted_end": "01:26:40.340",
      "text": "از اینکه بزن داره میخوره، برای چی مفرد چیزهای الافه بشه بگیر"
    },
    {
      "id": 23,
      "start": 5200.34,
      "end": 5202.34,
      "formatted_start": "01:26:40.340",
      "formatted_end": "01:26:42.340",
      "text": "فقط تو آهنگ رو میتوانی بشه بگیر"
    },
    {
      "id": 24,
      "start": 5202.34,
      "end": 5204.34,
      "formatted_start": "01:26:42.340",
      "formatted_end": "01:26:44.340",
      "text": "آهنگ رو میتوانی بشه بگیر"
    },
    {
      "id": 25,
      "start": 5204.34,
      "end": 5207.34,
      "formatted_start": "01:26:44.340",
      "formatted_end": "01:26:47.340",
      "text": "بر این، عناده بخشید"
    },
    {
      "id": 26,
      "start": 5207.34,
      "end": 5210.34,
      "formatted_start": "01:26:47.340",
      "formatted_end": "01:26:50.340",
      "text": "سول فرشینه اقل سابقه حساسیت بشت"
    },
    {
      "id": 27,
      "start": 5210.34,
      "end": 5213.34,
      "formatted_start": "01:26:50.340",
      "formatted_end": "01:26:53.340",
      "text": "آره، در اینکه هم برشت بشه بگیر"
    },
    {
      "id": 28,
      "start": 5213.34,
      "end": 5215.34,
      "formatted_start": "01:26:53.340",
      "formatted_end": "01:26:55.340",
      "text": "اسپریشو کیف نکرده، خب چی کار داری؟"
    },
    {
      "id": 29,
      "start": 5215.34,
      "end": 5216.34,
      "formatted_start": "01:26:55.340",
      "formatted_end": "01:26:56.340",
      "text": "داری هی کنه"
    },
    {
      "id": 30,
      "start": 5216.34,
      "end": 5218.34,
      "formatted_start": "01:26:56.340",
      "formatted_end": "01:26:58.340",
      "text": "آره، تازه گرفته بودم"
    },
    {
      "id": 31,
      "start": 5218.34,
      "end": 5222.64,
      "formatted_start": "01:26:58.340",
      "formatted_end": "01:27:02.640",
      "text": "این اصلا از رفت که یکم از روی کرده شده نمیذاره ایسپریشو مورد سردادن"
    },
    {
      "id": 32,
      "start": 5222.64,
      "end": 5224.64,
      "formatted_start": "01:27:02.640",
      "formatted_end": "01:27:04.640",
      "text": "نه نمیذارم"
    },
    {
      "id": 33,
      "start": 5224.64,
      "end": 5226.64,
      "formatted_start": "01:27:04.640",
      "formatted_end": "01:27:06.640",
      "text": "چون چنده همون"
    },
    {
      "id": 34,
      "start": 5228.22,
      "end": 5229.4,
      "formatted_start": "01:27:08.220",
      "formatted_end": "01:27:09.400",
      "text": "اون صدرن داره یا؟"
    },
    {
      "id": 35,
      "start": 5229.4,
      "end": 5231.4,
      "formatted_start": "01:27:09.400",
      "formatted_end": "01:27:11.400",
      "text": "ایسپریشون داریشون من این صدرن دارم"
    },
    {
      "id": 36,
      "start": 5231.4,
      "end": 5233.4,
      "formatted_start": "01:27:11.400",
      "formatted_end": "01:27:13.400",
      "text": "دارم دو بسته دارم"
    },
    {
      "id": 37,
      "start": 5233.4,
      "end": 5235.4,
      "formatted_start": "01:27:13.400",
      "formatted_end": "01:27:15.400",
      "text": "خیلی از خوش دردار بازم"
    },
    {
      "id": 38,
      "start": 5235.4,
      "end": 5237.4,
      "formatted_start": "01:27:15.400",
      "formatted_end": "01:27:17.400",
      "text": "خب بریم"
    },
    {
      "id": 39,
      "start": 5237.4,
      "end": 5239.4,
      "formatted_start": "01:27:17.400",
      "formatted_end": "01:27:19.400",
      "text": "ایسپریه"
    },
    {
      "id": 40,
      "start": 5239.4,
      "end": 5241.4,
      "formatted_start": "01:27:19.400",
      "formatted_end": "01:27:21.400",
      "text": "یه دونه نارنج"
    },
    {
      "id": 41,
      "start": 5241.4,
      "end": 5243.4,
      "formatted_start": "01:27:21.400",
      "formatted_end": "01:27:23.400",
      "text": "ای آبی هم داریم"
    },
    {
      "id": 42,
      "start": 5243.4,
      "end": 5245.4,
      "formatted_start": "01:27:23.400",
      "formatted_end": "01:27:25.400",
      "text": "ایسپریه آبی شما خب"
    },
    {
      "id": 43,
      "start": 5245.4,
      "end": 5247.4,
      "formatted_start": "01:27:25.400",
      "formatted_end": "01:27:27.400",
      "text": "الان که رفتی خونه هر چهار ساعت"
    },
    {
      "id": 44,
      "start": 5247.4,
      "end": 5251.4,
      "formatted_start": "01:27:27.400",
      "formatted_end": "01:27:31.400",
      "text": "دو پاف براش بزن تا آخر شب"
    },
    {
      "id": 45,
      "start": 5251.4,
      "end": 5257.4,
      "formatted_start": "01:27:31.400",
      "formatted_end": "01:27:37.400",
      "text": "از فردا دیگه صبح و زبون و عصر رو شب بزن"
    },
    {
      "id": 46,
      "start": 5257.4,
      "end": 5262.4,
      "formatted_start": "01:27:37.400",
      "formatted_end": "01:27:42.400",
      "text": "از پره سخت دارید اینم"
    },
    {
      "id": 47,
      "start": 5262.4,
      "end": 5265.4,
      "formatted_start": "01:27:42.400",
      "formatted_end": "01:27:45.400",
      "text": "روزی سه پار دو پاف بزن"
    },
    {
      "id": 48,
      "start": 5265.4,
      "end": 5270.4,
      "formatted_start": "01:27:45.400",
      "formatted_end": "01:27:50.400",
      "text": "از پره نارنجی شد تا دوازده پایش دو پاف بزن"
    },
    {
      "id": 49,
      "start": 5270.4,
      "end": 5271.4,
      "formatted_start": "01:27:50.400",
      "formatted_end": "01:27:51.400",
      "text": "خوب؟"
    },
    {
      "id": 50,
      "start": 5271.4,
      "end": 5273.4,
      "formatted_start": "01:27:51.400",
      "formatted_end": "01:27:53.400",
      "text": "اینم"
    },
    {
      "id": 51,
      "start": 5273.4,
      "end": 5280.4,
      "formatted_start": "01:27:53.400",
      "formatted_end": "01:28:00.400",
      "text": "بعد دیگه میریم سراغ این پودرشو چون از چهار یه دونه بهش بده"
    },
    {
      "id": 52,
      "start": 5280.4,
      "end": 5289.4,
      "formatted_start": "01:28:00.400",
      "formatted_end": "01:28:09.400",
      "text": "بعد یه دونه شربت فارانوکس براش منو بشتم هر دوازده سال از پنج سیسی بهش بده با یه شربت نیوتادین"
    },
    {
      "id": 53,
      "start": 5289.4,
      "end": 5291.4,
      "formatted_start": "01:28:09.400",
      "formatted_end": "01:28:11.400",
      "text": "من این دوتو شربتی بشم"
    },
    {
      "id": 54,
      "start": 5291.4,
      "end": 5293.4,
      "formatted_start": "01:28:11.400",
      "formatted_end": "01:28:13.400",
      "text": "هر دوتوشم قبل از استفاده کردم"
    },
    {
      "id": 55,
      "start": 5293.4,
      "end": 5295.4,
      "formatted_start": "01:28:13.400",
      "formatted_end": "01:28:15.400",
      "text": "این نیوتادین بهتره یا پلارجین بهتره؟"
    },
    {
      "id": 56,
      "start": 5295.4,
      "end": 5297.4,
      "formatted_start": "01:28:15.400",
      "formatted_end": "01:28:17.400",
      "text": "نه نیوتادین"
    },
    {
      "id": 57,
      "start": 5297.4,
      "end": 5300.4,
      "formatted_start": "01:28:17.400",
      "formatted_end": "01:28:20.400",
      "text": "برای کسی که حساسیت داره نیوتادین بهتره"
    },
    {
      "id": 58,
      "start": 5300.4,
      "end": 5304.16,
      "formatted_start": "01:28:20.400",
      "formatted_end": "01:28:24.160",
      "text": "نیوتادین فرق بده. نیوتادین یک داروی ضد حساسیته"
    },
    {
      "id": 59,
      "start": 5304.16,
      "end": 5306.4,
      "formatted_start": "01:28:24.160",
      "formatted_end": "01:28:26.400",
      "text": "افتراری اون رو نیوتادین بهش بده"
    },
    {
      "id": 60,
      "start": 5306.4,
      "end": 5308.8,
      "formatted_start": "01:28:26.400",
      "formatted_end": "01:28:28.800",
      "text": "پلانژی بیشتر ولی صرف هست"
    },
    {
      "id": 61,
      "start": 5308.8,
      "end": 5311.92,
      "formatted_start": "01:28:28.800",
      "formatted_end": "01:28:31.920",
      "text": "ولی نیوتادین بدی بهتره"
    },
    {
      "id": 62,
      "start": 5311.92,
      "end": 5318.4,
      "formatted_start": "01:28:31.920",
      "formatted_end": "01:28:38.400",
      "text": "نیوتادین بهش بدی اونم برطرف بگیره"
    },
    {
      "id": 63,
      "start": 5318.4,
      "end": 5336.4,
      "formatted_start": "01:28:38.400",
      "formatted_end": "01:28:56.400",
      "text": "بچه هایی که آلرشی دارند وقتی سرما میخورند احتمالش بیشتر است که این سرما خوردکی رو به گوششون بزنند."
    },
    {
      "id": 64,
      "start": 5336.4,
      "end": 5341.7,
      "formatted_start": "01:28:56.400",
      "formatted_end": "01:29:01.700",
      "text": "چون اینا عادت دارن مثلا خابیده شیر میخورن وقتی من کشید انجام بیدن"
    },
    {
      "id": 65,
      "start": 5341.7,
      "end": 5345.86,
      "formatted_start": "01:29:01.700",
      "formatted_end": "01:29:05.860",
      "text": "این میکروبایی که دو گلدشون ده کشیده میشه به سمت بوش میانیشون"
    },
    {
      "id": 66,
      "start": 5345.86,
      "end": 5347.56,
      "formatted_start": "01:29:05.860",
      "formatted_end": "01:29:07.560",
      "text": "آه از بوشه باید شیر بودم"
    },
    {
      "id": 67,
      "start": 5347.56,
      "end": 5353.3,
      "formatted_start": "01:29:07.560",
      "formatted_end": "01:29:13.300",
      "text": "موقعی که فرمایی کنه یکمی حالت نیمه نشسته به شیر مده"
    },
    {
      "id": 68,
      "start": 5353.3,
      "end": 5354.52,
      "formatted_start": "01:29:13.300",
      "formatted_end": "01:29:14.520",
      "text": "یعنی خابیده خابیده نمیشه"
    },
    {
      "id": 69,
      "start": 5354.52,
      "end": 5356.72,
      "formatted_start": "01:29:14.520",
      "formatted_end": "01:29:16.720",
      "text": "یکی خابیده نمیخواده خودش"
    },
    {
      "id": 70,
      "start": 5356.72,
      "end": 5358.8,
      "formatted_start": "01:29:16.720",
      "formatted_end": "01:29:18.800",
      "text": "وقتی دیرات بشه که بلند میشه"
    },
    {
      "id": 71,
      "start": 5358.8,
      "end": 5361.8,
      "formatted_start": "01:29:18.800",
      "formatted_end": "01:29:21.800",
      "text": "آه خوبه اینجوری بهتره اتفاقم"
    },
    {
      "id": 72,
      "start": 5363.8,
      "end": 5365.8,
      "formatted_start": "01:29:23.800",
      "formatted_end": "01:29:25.800",
      "text": "خودش طلاعه خودش میخوانی"
    },
    {
      "id": 73,
      "start": 5365.8,
      "end": 5366.8,
      "formatted_start": "01:29:25.800",
      "formatted_end": "01:29:26.800",
      "text": "ازم اسمشی بود؟"
    },
    {
      "id": 74,
      "start": 5366.8,
      "end": 5367.8,
      "formatted_start": "01:29:26.800",
      "formatted_end": "01:29:27.800",
      "text": "جانان"
    },
    {
      "id": 75,
      "start": 5367.8,
      "end": 5368.8,
      "formatted_start": "01:29:27.800",
      "formatted_end": "01:29:28.800",
      "text": "جانان"
    },
    {
      "id": 76,
      "start": 5372.8,
      "end": 5375.8,
      "formatted_start": "01:29:32.800",
      "formatted_end": "01:29:35.800",
      "text": "خاندکتر یه کار دیگر داشتم"
    },
    {
      "id": 77,
      "start": 5375.8,
      "end": 5379.8,
      "formatted_start": "01:29:35.800",
      "formatted_end": "01:29:39.800",
      "text": "یعنی فونت اضراری داره یه مثلا یکم بو داره"
    },
    {
      "id": 78,
      "start": 5379.8,
      "end": 5380.8,
      "formatted_start": "01:29:39.800",
      "formatted_end": "01:29:40.800",
      "text": "بعضی وقتا اضرارش؟"
    },
    {
      "id": 79,
      "start": 5380.8,
      "end": 5382.8,
      "formatted_start": "01:29:40.800",
      "formatted_end": "01:29:42.800",
      "text": "نه بخاطر غذایی که میخوره"
    },
    {
      "id": 80,
      "start": 5382.8,
      "end": 5384.8,
      "formatted_start": "01:29:42.800",
      "formatted_end": "01:29:44.800",
      "text": "بخاطر ویتامینی که میخوره"
    },
    {
      "id": 81,
      "start": 5384.8,
      "end": 5400.0,
      "formatted_start": "01:29:44.800",
      "formatted_end": "01:30:00.000",
