      "start": 9817.0,
      "end": 9820.0,
      "formatted_start": "02:43:37.000",
      "formatted_end": "02:43:40.000",
      "text": "و از آنکه که داد"
    },
    {
      "id": 91,
      "start": 9820.0,
      "end": 9823.0,
      "formatted_start": "02:43:40.000",
      "formatted_end": "02:43:43.000",
      "text": "یک دونه بهش دست بده"
    },
    {
      "id": 92,
      "start": 9823.0,
      "end": 9824.0,
      "formatted_start": "02:43:43.000",
      "formatted_end": "02:43:44.000",
      "text": "این چیزی که بابا بود"
    },
    {
      "id": 93,
      "start": 9824.0,
      "end": 9827.28,
      "formatted_start": "02:43:44.000",
      "formatted_end": "02:43:47.280",
      "text": "خفه علامت دیگه هی هم نداره تبشان که قدر اونو نیشت"
    },
    {
      "id": 94,
      "start": 9827.28,
      "end": 9827.88,
      "formatted_start": "02:43:47.280",
      "formatted_end": "02:43:47.880",
      "text": "نه آره تب نداره"
    },
    {
      "id": 95,
      "start": 9827.88,
      "end": 9828.76,
      "formatted_start": "02:43:47.880",
      "formatted_end": "02:43:48.760",
      "text": "همینه تا"
    },
    {
      "id": 96,
      "start": 9828.76,
      "end": 9842.76,
      "formatted_start": "02:43:48.760",
      "formatted_end": "02:44:02.760",
      "text": "اگه علامت جدیدی پیدا شد من یه قیام بده"
    },
    {
      "id": 97,
      "start": 9842.76,
      "end": 9843.24,
      "formatted_start": "02:44:02.760",
      "formatted_end": "02:44:03.240",
      "text": "باشه"
    },
    {
      "id": 98,
      "start": 9843.24,
      "end": 9847.24,
      "formatted_start": "02:44:03.240",
      "formatted_end": "02:44:07.240",
      "text": "خدای برسان"
    },
    {
      "id": 99,
      "start": 9847.24,
      "end": 9849.48,
      "formatted_start": "02:44:07.240",
      "formatted_end": "02:44:09.480",
      "text": "تقور داری؟"
    },
    {
      "id": 100,
      "start": 9849.48,
      "end": 9851.28,
      "formatted_start": "02:44:09.480",
      "formatted_end": "02:44:11.280",
      "text": "آره دیگه سامیتانی کنه"
    },
    {
      "id": 101,
      "start": 9851.28,
      "end": 9853.98,
      "formatted_start": "02:44:11.280",
      "formatted_end": "02:44:13.980",
      "text": "برسان"
    },
    {
      "id": 102,
      "start": 9853.98,
      "end": 9857.98,
      "formatted_start": "02:44:13.980",
      "formatted_end": "02:44:17.980",
      "text": "بیا بیرون بزرگ بگیر برنامه"
    },
    {
      "id": 103,
      "start": 9857.98,
      "end": 9859.98,
      "formatted_start": "02:44:17.980",
      "formatted_end": "02:44:19.980",
      "text": "بیا بسرگشت بگیر"
    },
    {
      "id": 104,
      "start": 9859.98,
      "end": 9863.98,
      "formatted_start": "02:44:19.980",
      "formatted_end": "02:44:23.980",
      "text": "مرسی اینا هم بیا در جواب چیزی که مثلا میدیم"
    },
    {
      "id": 105,
      "start": 9863.98,
      "end": 9865.98,
      "formatted_start": "02:44:23.980",
      "formatted_end": "02:44:25.980",
      "text": "خوب اگر باشه"
    },
    {
      "id": 106,
      "start": 9865.98,
      "end": 9869.98,
      "formatted_start": "02:44:25.980",
      "formatted_end": "02:44:29.980",
      "text": "ولی خب چون هیلما اصلا مثل گل گلی حرفی داد یادم"
    },
    {
      "id": 107,
      "start": 9869.98,
      "end": 9873.98,
      "formatted_start": "02:44:29.980",
      "formatted_end": "02:44:33.980",
      "text": "نه نه این در اززوز دختر کنالا برای الانش خوبه"
    },
    {
      "id": 108,
      "start": 9873.98,
      "end": 9875.98,
      "formatted_start": "02:44:33.980",
      "formatted_end": "02:44:35.980",
      "text": "خدافردی من مومه"
    },
    {
      "id": 109,
      "start": 9875.98,
      "end": 9877.98,
      "formatted_start": "02:44:35.980",
      "formatted_end": "02:44:37.980",
      "text": "خوش اومدی؟"
    },
    {
      "id": 110,
      "start": 9883.98,
      "end": 9899.98,
      "formatted_start": "02:44:43.980",
      "formatted_end": "02:44:59.980",
      "text": "موسیقی"
    }
  ],
  "status": "completed"
}