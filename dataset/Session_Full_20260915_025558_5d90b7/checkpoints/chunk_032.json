  "stt_segments": [
    {
      "id": 0,
      "start": 9600.0,
      "end": 9616.0,
      "formatted_start": "02:40:00.000",
      "formatted_end": "02:40:16.000",
      "text": "این چربی ها دفت شده، درمت به رنگ مصبوک کرم میشه. که این اتفاق میافته وقتی که یه ویروس بچه بگیره، پرزای رودش آسیب میبینه، نمیتونه چربی رو جزد کنه."
    },
    {
      "id": 1,
      "start": 9616.0,
      "end": 9620.0,
      "formatted_start": "02:40:16.000",
      "formatted_end": "02:40:20.000",
      "text": "این روی اینجوری تاثیر روش بذاشته"
    },
    {
      "id": 2,
      "start": 9620.0,
      "end": 9624.0,
      "formatted_start": "02:40:20.000",
      "formatted_end": "02:40:24.000",
      "text": "اهدمالا ازخال هم شدیدتر هم بیشه"
    },
    {
      "id": 3,
      "start": 9624.0,
      "end": 9628.0,
      "formatted_start": "02:40:24.000",
      "formatted_end": "02:40:28.000",
      "text": "تعداد دفعاتش زیاد نبوده بلی خوب دیگه"
    },
    {
      "id": 4,
      "start": 9628.0,
      "end": 9632.0,
      "formatted_start": "02:40:28.000",
      "formatted_end": "02:40:32.000",
      "text": "شیر خوش بیگذ میخوره"
    },
    {
      "id": 5,
      "start": 9632.0,
