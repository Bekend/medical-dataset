  "stt_segments": [
    {
      "id": 0,
      "start": 5400.0,
      "end": 5402.0,
      "formatted_start": "01:30:00.000",
      "formatted_end": "01:30:02.000",
      "text": "این یه بار زدن دیگه کلان من..."
    },
    {
      "id": 1,
      "start": 5402.0,
      "end": 5408.0,
      "formatted_start": "01:30:02.000",
      "formatted_end": "01:30:08.000",
      "text": "ببین این داپومالی نیست که میخوای مدام استفاده کنه، فقط وقتی خیلی سختگی شدیده باید استفاده کنه."
    },
    {
      "id": 2,
      "start": 5408.0,
      "end": 5419.0,
      "formatted_start": "01:30:08.000",
      "formatted_end": "01:30:19.000",
      "text": "آخه این مثلا جای پوشکش یا بعضی وقتی پوستش هم حساسه، قرمز میشه، من یه کچولو فقط روی این علام خالی هم شده، وقتی یه کچولو بهش میزنم..."
    },
    {
      "id": 3,
      "start": 5419.0,
      "end": 5423.0,
      "formatted_start": "01:30:19.000",
      "formatted_end": "01:30:23.000",
      "text": "میزنید، خوب میشه، چون این دارویتی به حد و خیلی از اینکه نداری بگیرم."
    },
    {
      "id": 4,
      "start": 5423.0,
      "end": 5426.0,
      "formatted_start": "01:30:23.000",
      "formatted_end": "01:30:26.000",
      "text": "ببین من مدام استفاده نمیدونم"
    },
    {
      "id": 5,
      "start": 5426.0,
      "end": 5428.0,
      "formatted_start": "01:30:26.000",
      "formatted_end": "01:30:28.000",
      "text": "نه مدام که نه هر وقت باید غذی میبینم"
    },
    {
      "id": 6,
      "start": 5428.0,
      "end": 5430.0,
      "formatted_start": "01:30:28.000",
      "formatted_end": "01:30:30.000",
      "text": "یک گوگر رو بزن باش"
    },
    {
      "id": 7,
      "start": 5449.0,
      "end": 5451.0,
      "formatted_start": "01:30:49.000",
      "formatted_end": "01:30:51.000",
      "text": "خیلی خوشحاله"
    },
    {
      "id": 8,
      "start": 5451.0,
      "end": 5480.98,
      "formatted_start": "01:30:51.000",
      "formatted_end": "01:31:20.980",
      "text": "خیلی خوش آمده باشید"
    },
    {
      "id": 9,
      "start": 5481.0,
      "end": 5483.0,
      "formatted_start": "01:31:21.000",
      "formatted_end": "01:31:23.000",
      "text": "مردم باید برداریم"
    },
    {
      "id": 10,
      "start": 5483.0,
      "end": 5485.0,
      "formatted_start": "01:31:23.000",
      "formatted_end": "01:31:25.000",
      "text": "سلام"
    },
    {
      "id": 11,
      "start": 5485.0,
      "end": 5487.0,
      "formatted_start": "01:31:25.000",
      "formatted_end": "01:31:27.000",
      "text": "مردم باید برداریم"
    },
    {
      "id": 12,
      "start": 5487.0,
      "end": 5489.0,
      "formatted_start": "01:31:27.000",
      "formatted_end": "01:31:29.000",
      "text": "مردم باید برداریم"
    },
    {
