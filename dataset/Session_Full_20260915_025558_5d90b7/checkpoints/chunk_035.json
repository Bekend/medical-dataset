  "stt_segments": [
    {
      "id": 0,
      "start": 10500.0,
      "end": 10513.5,
      "formatted_start": "02:55:00.000",
      "formatted_end": "02:55:13.500",
      "text": "امکانش هست، مثلا صبح ساعت نه بیرشنا، قبلش هیچی نمیخوریم، یه طرف ندید، او خواهد آره، و بعد از اینکه میاد، من میگم شاید به خاطر این اتفاق افتاد این زرگیجه؟"
    },
    {
      "id": 1,
      "start": 10513.5,
      "end": 10516.0,
      "formatted_start": "02:55:13.500",
      "formatted_end": "02:55:16.000",
      "text": "میتونه، میتونه اینجور باشه."
    },
    {
      "id": 2,
      "start": 10516.0,
      "end": 10525.0,
      "formatted_start": "02:55:16.000",
      "formatted_end": "02:55:25.000",
      "text": "ببین حالا فعلا یه مدتی از ذرا تغذیه. صبح حتما قبل از اینکه بریشنا، یه چیز پروتینی بخواد، مثل تخمه بخواد،"
    },
    {
      "id": 3,
      "start": 10525.0,
      "end": 10530.0,
      "formatted_start": "02:55:25.000",
      "formatted_end": "02:55:30.000",
      "text": "یا مثلا چیز نخور، مثلا چیزای شیرین نخور چون اونجا غندش میبنه"
    },
    {
      "id": 4,
      "start": 10530.0,
      "end": 10534.0,
      "formatted_start": "02:55:30.000",
      "formatted_end": "02:55:34.000",
      "text": "یه چیز تقمه با قشن نمک بزن، خواب بخو"
    },
    {
      "id": 5,
      "start": 10534.0,
      "end": 10537.0,
      "formatted_start": "02:55:34.000",
      "formatted_end": "02:55:37.000",
      "text": "بعد از شنا اومدی و باید کارشی دارد خواست بخور"
    },
    {
      "id": 6,
      "start": 10537.0,
      "end": 10540.0,
      "formatted_start": "02:55:37.000",
      "formatted_end": "02:55:40.000",
      "text": "باشه این کار رو انجام بده، فنان ازمایش داری"
    },
    {
      "id": 7,
      "start": 10540.0,
      "end": 10543.0,
      "formatted_start": "02:55:40.000",
      "formatted_end": "02:55:43.000",
      "text": "نه بابا ازمانش به این رویستیم"
    },
    {
      "id": 8,
      "start": 10543.0,
      "end": 10545.0,
      "formatted_start": "02:55:43.000",
      "formatted_end": "02:55:45.000",
      "text": "یه دارو هم براش می نویسن"
    },
    {
      "id": 9,
      "start": 10545.0,
      "end": 10548.0,
      "formatted_start": "02:55:45.000",
      "formatted_end": "02:55:48.000",
      "text": "باباش خیلی چیز میگرد که میگفت شاید کبونی داشته باشه"
    },
    {
      "id": 10,
      "start": 10548.0,
      "end": 10553.0,
      "formatted_start": "02:55:48.000",
      "formatted_end": "02:55:53.000",
      "text": "چون دیروزم آوردش میبود لباش همه کبول شده بوده"
    },
    {
      "id": 11,
      "start": 10553.0,
      "end": 10558.0,
      "formatted_start": "02:55:53.000",
      "formatted_end": "02:55:58.000",
      "text": "خب حتما میخواد بخواد درده دینازمش"
    },
    {
      "id": 12,
      "start": 10558.0,
      "end": 10562.0,
      "formatted_start": "02:55:58.000",
      "formatted_end": "02:56:02.000",
      "text": "باباش مگه باید تشخیص بده؟ من باید تشخیص بده؟ مگه نه؟ بینا؟"
    },
    {
      "id": 13,
      "start": 10562.0,
      "end": 10566.0,
      "formatted_start": "02:56:02.000",
      "formatted_end": "02:56:06.000",
      "text": "مگه بابا دکتره؟ عزیزا دلم"
    },
    {
      "id": 14,
      "start": 10566.0,
      "end": 10568.0,
      "formatted_start": "02:56:06.000",
      "formatted_end": "02:56:08.000",
      "text": "خاله من اینجور دارم که میگم رایت بکنه"
    },
    {
      "id": 15,
      "start": 10568.0,
      "end": 10570.0,
      "formatted_start": "02:56:08.000",
      "formatted_end": "02:56:10.000",
      "text": "یه دارو هم براش مینویسنند استفاده بکنن"
    },
    {
      "id": 16,
      "start": 10570.0,
      "end": 10573.0,
      "formatted_start": "02:56:10.000",
      "formatted_end": "02:56:13.000",
      "text": "آزمهاشش هم مینویسن وقت داریم تا یه ماه"
    },
    {
      "id": 17,
      "start": 10573.0,
      "end": 10576.0,
      "formatted_start": "02:56:13.000",
      "formatted_end": "02:56:16.000",
      "text": "ما، ولی اگر بیدیم بکرم نشد، آزمایش نمیشه"
    },
    {
      "id": 18,
      "start": 10577.0,
      "end": 10579.0,
      "formatted_start": "02:56:17.000",
      "formatted_end": "02:56:19.000",
      "text": "خب بیمه دادی؟"
    },
    {
      "id": 19,
      "start": 10579.0,
      "end": 10583.0,
      "formatted_start": "02:56:19.000",
      "formatted_end": "02:56:23.000",
      "text": "بیمه؟ بالا داری میریز، اما یعنی از اون بیمه اوکیل نشده"
    },
    {
      "id": 20,
      "start": 10583.0,
      "end": 10586.0,
      "formatted_start": "02:56:23.000",
      "formatted_end": "02:56:26.000",
      "text": "نشده، خب بیمه اوکیل کن و بعدا بیرون آزمایشو برنیم"
    },
    {
      "id": 21,
      "start": 10586.0,
      "end": 10587.0,
      "formatted_start": "02:56:26.000",
      "formatted_end": "02:56:27.000",
      "text": "خب براش میده"
    },
    {
      "id": 22,
      "start": 10587.0,
      "end": 10589.0,
      "formatted_start": "02:56:27.000",
      "formatted_end": "02:56:29.000",
      "text": "تاثیر داره یعنی آزمایشو؟"
    },
    {
      "id": 23,
      "start": 10589.0,
      "end": 10593.0,
      "formatted_start": "02:56:29.000",
      "formatted_end": "02:56:33.000",
      "text": "نه، آزمایش که تاثیر داره، در این حال فیزی، طول، دار و اینا"
    },
    {
      "id": 24,
      "start": 10593.0,
      "end": 10596.14,
      "formatted_start": "02:56:33.000",
      "formatted_end": "02:56:36.140",
      "text": "دارو اینا قیاد زیاد ترمیل نداره ولی آزمایش ترسیر"
    },
    {
      "id": 25,
      "start": 10596.14,
      "end": 10598.54,
      "formatted_start": "02:56:36.140",
      "formatted_end": "02:56:38.540",
      "text": "چاونه فکر کنم یک ماه ازاد همینه"
    },
    {
      "id": 26,
      "start": 10598.54,
      "end": 10599.74,
      "formatted_start": "02:56:38.540",
      "formatted_end": "02:56:39.740",
      "text": "آزاد میریدی؟"
    },
    {
      "id": 27,
      "start": 10599.74,
      "end": 10606.76,
      "formatted_start": "02:56:39.740",
      "formatted_end": "02:56:46.760",
      "text": "خب این شعبت فروگلوگلونی نیست"
    },
    {
      "id": 28,
      "start": 10606.76,
      "end": 10608.24,
      "formatted_start": "02:56:46.760",
      "formatted_end": "02:56:48.240",
      "text": "همون رو روز دست بیتی باید شدید"
    },
    {
      "id": 29,
      "start": 10608.24,
      "end": 10609.44,
      "formatted_start": "02:56:48.240",
      "formatted_end": "02:56:49.440",
      "text": "اون برخونه؟"
    },
    {
      "id": 30,
      "start": 10609.44,
      "end": 10609.74,
      "formatted_start": "02:56:49.440",
      "formatted_end": "02:56:49.740",
      "text": "آیا"
    },
    {
      "id": 31,
      "start": 10609.74,
      "end": 10611.3,
      "formatted_start": "02:56:49.740",
      "formatted_end": "02:56:51.300",
      "text": "خب"
    },
    {
      "id": 32,
      "start": 10611.3,
      "end": 10615.98,
      "formatted_start": "02:56:51.300",
      "formatted_end": "02:56:55.980",
      "text": "و کاملوگلونین قدر 138"
    },
    {
      "id": 33,
      "start": 10615.98,
      "end": 10617.34,
      "formatted_start": "02:56:55.980",
      "formatted_end": "02:56:57.340",
      "text": "و روزم 42"
    },
    {
      "id": 34,
      "start": 10617.34,
      "end": 10618.48,
      "formatted_start": "02:56:57.340",
      "formatted_end": "02:56:58.480",
      "text": "خب"
    },
    {
      "id": 35,
      "start": 10618.48,
      "end": 10619.84,
      "formatted_start": "02:56:58.480",
      "formatted_end": "02:56:59.840",
      "text": "ده ساله شدید"
    },
    {
      "id": 36,
      "start": 10619.84,
      "end": 10620.8,
      "formatted_start": "02:56:59.840",
      "formatted_end": "02:57:00.800",
      "text": "ده ساله شد"
    },
    {
      "id": 37,
      "start": 10620.8,
      "end": 10621.66,
      "formatted_start": "02:57:00.800",
      "formatted_end": "02:57:01.660",
      "text": "خب برو ماله باید"
    },
    {
      "id": 38,
      "start": 10621.66,
      "end": 10625.16,
      "formatted_start": "02:57:01.660",
      "formatted_end": "02:57:05.160",
      "text": "با کپش برو"
    },
    {
      "id": 39,
      "start": 10625.16,
      "end": 10626.16,
      "formatted_start": "02:57:05.160",
      "formatted_end": "02:57:06.160",
      "text": "با کپش برو"
    },
    {
      "id": 40,
      "start": 10626.16,
      "end": 10626.2,
      "formatted_start": "02:57:06.160",
      "formatted_end": "02:57:06.200",
      "text": "با کپش برو"
    },
    {
      "id": 41,
      "start": 10626.2,
      "end": 10626.24,
      "formatted_start": "02:57:06.200",
      "formatted_end": "02:57:06.240",
      "text": "با کپش برو"
    },
    {
      "id": 42,
      "start": 10626.24,
      "end": 10626.28,
      "formatted_start": "02:57:06.240",
      "formatted_end": "02:57:06.280",
      "text": "با کپش برو"
    },
    {
      "id": 43,
      "start": 10626.28,
      "end": 10626.32,
      "formatted_start": "02:57:06.280",
      "formatted_end": "02:57:06.320",
      "text": "با کپش برو"
    },
    {
      "id": 44,
      "start": 10626.32,
      "end": 10626.36,
      "formatted_start": "02:57:06.320",
      "formatted_end": "02:57:06.360",
      "text": "با کپش برو"
    },
    {
      "id": 45,
      "start": 10626.36,
      "end": 10626.4,
      "formatted_start": "02:57:06.360",
      "formatted_end": "02:57:06.400",
      "text": "با کپش برو"
    },
    {
      "id": 46,
      "start": 10626.4,
      "end": 10626.44,
      "formatted_start": "02:57:06.400",
      "formatted_end": "02:57:06.440",
