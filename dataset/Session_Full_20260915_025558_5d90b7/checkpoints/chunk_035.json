    },
    {
      "id": 59,
      "start": 10627.62,
      "end": 10627.64,
      "formatted_start": "02:57:07.620",
      "formatted_end": "02:57:07.640",
      "text": "با کپش برو"
    },
    {
      "id": 60,
      "start": 10627.64,
      "end": 10627.68,
      "formatted_start": "02:57:07.640",
      "formatted_end": "02:57:07.680",
      "text": "با کپش برو"
    },
    {
      "id": 61,
      "start": 10627.68,
      "end": 10627.7,
      "formatted_start": "02:57:07.680",
      "formatted_end": "02:57:07.700",
      "text": "با کپش برو"
    },
    {
      "id": 62,
      "start": 10627.7,
      "end": 10629.7,
      "formatted_start": "02:57:07.700",
      "formatted_end": "02:57:09.700",
      "text": "سندل کم میکنم"
    },
    {
      "id": 63,
      "start": 10634.7,
      "end": 10636.7,
      "formatted_start": "02:57:14.700",
      "formatted_end": "02:57:16.700",
      "text": "بگو اینکه این ها 140 و نیمه"
    },
    {
      "id": 64,
      "start": 10636.7,
      "end": 10638.7,
      "formatted_start": "02:57:16.700",
      "formatted_end": "02:57:18.700",
      "text": "این ها 138"
    },
    {
      "id": 65,
      "start": 10638.7,
      "end": 10640.7,
      "formatted_start": "02:57:18.700",
      "formatted_end": "02:57:20.700",
      "text": "ببین 138"
    },
    {
      "id": 66,
      "start": 10644.7,
      "end": 10646.7,
      "formatted_start": "02:57:24.700",
      "formatted_end": "02:57:26.700",
      "text": "این هست"
    },
    {
      "id": 67,
      "start": 10651.7,
      "end": 10653.7,
      "formatted_start": "02:57:31.700",
      "formatted_end": "02:57:33.700",
      "text": "ببین دختر بچه یه ده سال"
    },
    {
      "id": 68,
      "start": 10653.7,
      "end": 10661.7,
      "formatted_start": "02:57:33.700",
      "formatted_end": "02:57:41.700",
      "text": "با قدر 138 باید وزنش باشه 32"
    },
    {
      "id": 69,
      "start": 10661.7,
      "end": 10665.7,
      "formatted_start": "02:57:41.700",
      "formatted_end": "02:57:45.700",
      "text": "از این کندی چلو؟"
    },
    {
      "id": 70,
      "start": 10665.7,
      "end": 10667.7,
      "formatted_start": "02:57:45.700",
      "formatted_end": "02:57:47.700",
      "text": "چلو 3"
    },
    {
      "id": 71,
      "start": 10667.7,
      "end": 10671.7,
      "formatted_start": "02:57:47.700",
      "formatted_end": "02:57:51.700",
      "text": "اما دقیقا 5-6 کلو باید کم بکنی"
    },
    {
      "id": 72,
      "start": 10671.7,
      "end": 10677.7,
      "formatted_start": "02:57:51.700",
      "formatted_end": "02:57:57.700",
      "text": "نه اینکه بگم کم بکنی ها موازه باش عزیز بیشتر نشین"
    },
    {
      "id": 73,
      "start": 10677.7,
      "end": 10683.7,
      "formatted_start": "02:57:57.700",
      "formatted_end": "02:58:03.700",
      "text": "خب مواظب باش از نویشتر نشید هم دو سه هفته خودتو وضع بکن"
    },
    {
      "id": 74,
      "start": 10683.7,
      "end": 10686.7,
      "formatted_start": "02:58:03.700",
      "formatted_end": "02:58:06.700",
      "text": "اگه دیدی داره بیره بالا رعایت بکن خب"
    },
    {
      "id": 75,
      "start": 10686.7,
      "end": 10690.7,
      "formatted_start": "02:58:06.700",
      "formatted_end": "02:58:10.700",
      "text": "حالا نه که رعایت کردن شما نه میدونی که چینت خوری ببین"
    },
    {
      "id": 76,
      "start": 10690.7,
      "end": 10696.7,
      "formatted_start": "02:58:10.700",
      "formatted_end": "02:58:16.700",
      "text": "غذاهای چرد، شیرین، کمتر بخور"
    },
    {
      "id": 77,
      "start": 10696.7,
      "end": 10701.7,
      "formatted_start": "02:58:16.700",
      "formatted_end": "02:58:21.700",
      "text": "خب مثلا فرستفود، فرستفود، نوشابه"
    },
    {
      "id": 78,
      "start": 10701.7,
      "end": 10702.7,
      "formatted_start": "02:58:21.700",
      "formatted_end": "02:58:22.700",
      "text": "آقای نوشابه"
    },
    {
      "id": 79,
      "start": 10702.7,
      "end": 10706.2,
      "formatted_start": "02:58:22.700",
      "formatted_end": "02:58:26.200",
      "text": "آب میوه سنتی، آب میوه های بیرون"
    },
    {
      "id": 80,
      "start": 10706.2,
      "end": 10708.7,
      "formatted_start": "02:58:26.200",
      "formatted_end": "02:58:28.700",
      "text": "آب چیپس و"
    },
    {
      "id": 81,
      "start": 10711.2,
      "end": 10712.7,
      "formatted_start": "02:58:31.200",
      "formatted_end": "02:58:32.700",
      "text": "کیک و"
    },
    {
      "id": 82,
      "start": 10712.7,
      "end": 10715.7,
      "formatted_start": "02:58:32.700",
      "formatted_end": "02:58:35.700",
      "text": "به بالا من رو بامانه کلوچه و"
    },
    {
      "id": 83,
      "start": 10715.7,
      "end": 10718.7,
      "formatted_start": "02:58:35.700",
      "formatted_end": "02:58:38.700",
      "text": "اینها رو کمتر بخور، خواست دارو بخور، اشخاص نداره"
    },
    {
      "id": 84,
      "start": 10718.7,
      "end": 10720.7,
      "formatted_start": "02:58:38.700",
      "formatted_end": "02:58:40.700",
      "text": "خب، اینها رو نمیگم اصلا"
    },
    {
      "id": 85,
      "start": 10720.7,
      "end": 10723.7,
      "formatted_start": "02:58:40.700",
      "formatted_end": "02:58:43.700",
      "text": "خب، بالا خاطر من هم بساً گاهی حوض چیپس میکنم"
    },
    {
      "id": 86,
      "start": 10723.7,
      "end": 10725.7,
      "formatted_start": "02:58:43.700",
      "formatted_end": "02:58:45.700",
      "text": "اولی بساً ماهیه با"
    },
    {
      "id": 87,
      "start": 10725.7,
      "end": 10729.7,
      "formatted_start": "02:58:45.700",
      "formatted_end": "02:58:49.700",
      "text": "خب، اصلا چیپس علاوه برای این که وضعون برای بالا"
    },
    {
      "id": 88,
      "start": 10729.7,
      "end": 10731.7,
      "formatted_start": "02:58:49.700",
      "formatted_end": "02:58:51.700",
      "text": "اصلا ما با وضع هم کار نداریم"
    },
    {
      "id": 89,
      "start": 10731.7,
      "end": 10734.66,
      "formatted_start": "02:58:51.700",
      "formatted_end": "02:58:54.660",
      "text": "چپس یک ماده سرطان زاست"
    },
    {
      "id": 90,
      "start": 10734.66,
      "end": 10737.16,
      "formatted_start": "02:58:54.660",
      "formatted_end": "02:58:57.160",
      "text": "خب به خاطر اینکه"
    },
    {
      "id": 91,
      "start": 10737.16,
      "end": 10742.2,
      "formatted_start": "02:58:57.160",
      "formatted_end": "02:59:02.200",
      "text": "یک روغن داق و ست ها بار این سپزمیتوش میزن درمیرن"
    },
    {
      "id": 92,
      "start": 10742.2,
      "end": 10746.94,
      "formatted_start": "02:59:02.200",
      "formatted_end": "02:59:06.940",
      "text": "خب تمام اکسید میشه و این اکسیدها دو بلند ایجاد سرطان می کنن"
    },
    {
      "id": 93,
      "start": 10746.94,
      "end": 10749.52,
      "formatted_start": "02:59:06.940",
      "formatted_end": "02:59:09.520",
      "text": "خب در نتیجه ما باید کم باشیم"
    },
    {
      "id": 94,
      "start": 10749.52,
      "end": 10750.68,
      "formatted_start": "02:59:09.520",
      "formatted_end": "02:59:10.680",
      "text": "باش عزیزم"
    },
    {
      "id": 95,
      "start": 10750.68,
      "end": 10752.68,
      "formatted_start": "02:59:10.680",
      "formatted_end": "02:59:12.680",
      "text": "همین را رایت بکن"
    },
    {
      "id": 96,
      "start": 10752.68,
      "end": 10754.5,
      "formatted_start": "02:59:12.680",
      "formatted_end": "02:59:14.500",
      "text": "این شروطتن بخود"
    },
    {
      "id": 97,
      "start": 10754.5,
      "end": 10756.8,
      "formatted_start": "02:59:14.500",
      "formatted_end": "02:59:16.800",
      "text": "دیگه خوب میشیم"
    },
    {
      "id": 98,
      "start": 10756.8,
      "end": 10758.76,
      "formatted_start": "02:59:16.800",
      "formatted_end": "02:59:18.760",
      "text": "نگرد میشم نباشم"
    },
    {
      "id": 99,
      "start": 10758.76,
      "end": 10763.24,
      "formatted_start": "02:59:18.760",
      "formatted_end": "02:59:23.240",
      "text": "از این آزمایش رو نداده باز بیارمش"
    },
    {
      "id": 100,
      "start": 10763.24,
      "end": 10767.4,
      "formatted_start": "02:59:23.240",
      "formatted_end": "02:59:27.400",
      "text": "آره اگر بیمترون رو درست کنم"
    },
    {
      "id": 101,
      "start": 10767.4,
      "end": 10770.04,
      "formatted_start": "02:59:27.400",
      "formatted_end": "02:59:30.040",
      "text": "چون بیتامین گیو ایوان برای قدش همش نگرده"
    },
    {
      "id": 102,
      "start": 10770.04,
      "end": 10770.88,
      "formatted_start": "02:59:30.040",
      "formatted_end": "02:59:30.880",
      "text": "میدین خب؟"
    },
    {
      "id": 103,
      "start": 10770.88,
      "end": 10771.32,
      "formatted_start": "02:59:30.880",
      "formatted_end": "02:59:31.320",
      "text": "نه"
    },
    {
      "id": 104,
      "start": 10771.32,
      "end": 10772.58,
      "formatted_start": "02:59:31.320",
      "formatted_end": "02:59:32.580",
      "text": "میدین خب؟"
    },
    {
      "id": 105,
      "start": 10772.58,
      "end": 10776.16,
      "formatted_start": "02:59:32.580",
      "formatted_end": "02:59:36.160",
      "text": "نمیدن برای قدش و این هم خوبی نگرده"
    },
    {
      "id": 106,
      "start": 10776.16,
      "end": 10777.16,
      "formatted_start": "02:59:36.160",
      "formatted_end": "02:59:37.160",
      "text": "نه قدش خوبه"
    },
    {
      "id": 107,
      "start": 10777.16,
      "end": 10778.02,
      "formatted_start": "02:59:37.160",
      "formatted_end": "02:59:38.020",
      "text": "خوبه؟"
    },
    {
      "id": 108,
      "start": 10778.02,
      "end": 10780.4,
      "formatted_start": "02:59:38.020",
      "formatted_end": "02:59:40.400",
      "text": "قدش مطمئن بالای 50%"
    },
    {
      "id": 109,
      "start": 10780.4,
      "end": 10781.7,
      "formatted_start": "02:59:40.400",
      "formatted_end": "02:59:41.700",
      "text": "آره"
    },
    {
      "id": 110,
      "start": 10781.7,
      "end": 10784.68,
      "formatted_start": "02:59:41.700",
      "formatted_end": "02:59:44.680",
      "text": "نه نه"
    },
    {
      "id": 111,
      "start": 10784.68,
      "end": 10787.0,
      "formatted_start": "02:59:44.680",
      "formatted_end": "02:59:47.000",
      "text": "الان هم آزمایش چیزی"
    },
    {
      "id": 112,
      "start": 10787.0,
      "end": 10789.0,
      "formatted_start": "02:59:47.000",
      "formatted_end": "02:59:49.000",
      "text": "از این وقت به سرنش دیگه رو برم"
    },
    {
      "id": 113,
      "start": 10789.0,
      "end": 10791.0,
      "formatted_start": "02:59:49.000",
      "formatted_end": "02:59:51.000",
      "text": "توی منحنی منحنی بالا برم"
    },
    {
      "id": 114,
      "start": 10791.0,
      "end": 10793.0,
      "formatted_start": "02:59:51.000",
      "formatted_end": "02:59:53.000",
      "text": "آه، بس خوابش خوب"
    },
    {
      "id": 115,
      "start": 10793.0,
      "end": 10795.0,
      "formatted_start": "02:59:53.000",
      "formatted_end": "02:59:55.000",
      "text": "بیتامین ده سهه"
    },
    {
      "id": 116,
      "start": 10795.0,
      "end": 10797.0,
      "formatted_start": "02:59:55.000",
      "formatted_end": "02:59:57.000",
      "text": "از این میتامین هیه که میگن"
    },
    {
      "id": 117,
      "start": 10797.0,
      "end": 10799.0,
      "formatted_start": "02:59:57.000",
      "formatted_end": "02:59:59.000",
      "text": "که که دو خراب نگار"
    },
    {
      "id": 118,
      "start": 10799.0,
      "end": 10801.0,
      "formatted_start": "02:59:59.000",
      "formatted_end": "03:00:01.000",
      "text": "من خودم الان میترشتن برم"
    }
  ],
  "status": "completed"
}