    },
    {
      "id": 47,
      "start": 10626.44,
      "end": 10626.48,
      "formatted_start": "02:57:06.440",
      "formatted_end": "02:57:06.480",
      "text": "با کپش برو"
    },
    {
      "id": 48,
      "start": 10626.48,
      "end": 10627.28,
      "formatted_start": "02:57:06.480",
      "formatted_end": "02:57:07.280",
      "text": "با کپش برو"
    },
    {
      "id": 49,
      "start": 10627.28,
      "end": 10627.32,
      "formatted_start": "02:57:07.280",
      "formatted_end": "02:57:07.320",
      "text": "با کپش برو"
    },
    {
      "id": 50,
      "start": 10627.32,
      "end": 10627.36,
      "formatted_start": "02:57:07.320",
      "formatted_end": "02:57:07.360",
      "text": "با کپش برو"
    },
    {
      "id": 51,
      "start": 10627.36,
      "end": 10627.38,
      "formatted_start": "02:57:07.360",
      "formatted_end": "02:57:07.380",
      "text": "با کپش برو"
    },
    {
      "id": 52,
      "start": 10627.38,
      "end": 10627.4,
      "formatted_start": "02:57:07.380",
      "formatted_end": "02:57:07.400",
