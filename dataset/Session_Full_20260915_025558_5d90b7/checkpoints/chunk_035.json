    },
    {
      "id": 53,
      "start": 10627.4,
      "end": 10627.44,
      "formatted_start": "02:57:07.400",
      "formatted_end": "02:57:07.440",
      "text": "با کپش برو"
    },
    {
      "id": 54,
      "start": 10627.44,
      "end": 10627.48,
      "formatted_start": "02:57:07.440",
      "formatted_end": "02:57:07.480",
