  "stt_segments": [
    {
      "id": 0,
      "start": 1800.0,
      "end": 1815.0,
      "formatted_start": "00:30:00.000",
      "formatted_end": "00:30:15.000",
      "text": "آقای عربازاده، آنظمه های کفیده، آقا این آزمایش ها اکثراً چهر، چهر و یک اصلاً طبیعه، تا هشتار، صد هم طبیعه، خب؟"
    },
    {
      "id": 1,
      "start": 1815.0,
      "end": 1823.0,
      "formatted_start": "00:30:15.000",
      "formatted_end": "00:30:23.000",
      "text": "چون باید سه چهار برابر نرمال باشه ما میگیم غیر عادی، نرمالش چهره، سه چهار برابر اون میشه سد و بیس، سد و شست."
    },
    {
      "id": 2,
      "start": 1823.0,
      "end": 1830.5,
      "formatted_start": "00:30:23.000",
      "formatted_end": "00:30:30.500",
      "text": "این با شانسه ببینید آزمایش یوهاد تو سپید نرمال بوده"
    },
    {
      "id": 3,
      "start": 1830.5,
      "end": 1835.76,
      "formatted_start": "00:30:30.500",
      "formatted_end": "00:30:35.760",
      "text": "تو بحاری اومده گیردم من فرمایید یه آزمایش ادراک یه آزمایشگاه دیگه بگیر"
    },
    {
      "id": 4,
      "start": 1835.76,
      "end": 1838.0,
      "formatted_start": "00:30:35.760",
      "formatted_end": "00:30:38.000",
      "text": "تا هنوز وحشت دارید"
    },
    {
      "id": 5,
      "start": 1838.0,
      "end": 1839.76,
      "formatted_start": "00:30:38.000",
      "formatted_end": "00:30:39.760",
      "text": "نه وحشت ندارم"
    },
    {
      "id": 6,
      "start": 1839.76,
      "end": 1843.66,
      "formatted_start": "00:30:39.760",
      "formatted_end": "00:30:43.660",
      "text": "وحشت بیوجود میاد اصلا بحث سربازیت هم اون است"
    },
    {
      "id": 7,
      "start": 1843.66,
      "end": 1844.76,
      "formatted_start": "00:30:43.660",
      "formatted_end": "00:30:44.760",
      "text": "استفادامیت هم ایست"
    },
    {
      "id": 8,
      "start": 1844.76,
      "end": 1847.0,
      "formatted_start": "00:30:44.760",
      "formatted_end": "00:30:47.000",
      "text": "بحث خود وجودته"
    },
    {
      "id": 9,
      "start": 1847.0,
      "end": 1850.0,
      "formatted_start": "00:30:47.000",
      "formatted_end": "00:30:50.000",
      "text": "دیگه خب از کلی هم چرا خون داره میره"
    },
    {
      "id": 10,
      "start": 1850.0,
      "end": 1860.0,
      "formatted_start": "00:30:50.000",
      "formatted_end": "00:31:00.000",
      "text": "یکی من دردی نفت از سوزشی نفت. اینجا میخواهم چرا باید مصبت بزنیم از آزمایشها؟"
    },
    {
      "id": 11,
      "start": 1860.0,
      "end": 1867.0,
      "formatted_start": "00:31:00.000",
      "formatted_end": "00:31:07.000",
      "text": "من یک آزمایشها یا دو تا پاشایی یا چپلی برو"
    },
    {
      "id": 12,
      "start": 1867.0,
      "end": 1868.0,
      "formatted_start": "00:31:07.000",
      "formatted_end": "00:31:08.000",
      "text": "گمبه؟"
    },
    {
      "id": 13,
      "start": 1868.0,
      "end": 1872.0,
      "formatted_start": "00:31:08.000",
      "formatted_end": "00:31:12.000",
      "text": "آره گمبه. همینکه اختلال داره من دوباره برات بیمیسم"
    },
    {
      "id": 14,
      "start": 1872.0,
      "end": 1877.0,
      "formatted_start": "00:31:12.000",
      "formatted_end": "00:31:17.000",
      "text": "بعد مایات زیاد مصرف هستم. ببین مایات. بعض مایات ساده عرض میشه"
    },
    {
      "id": 15,
      "start": 1877.0,
      "end": 1887.0,
      "formatted_start": "00:31:17.000",
      "formatted_end": "00:31:27.000",
      "text": "یعنی آب زیاد تری می کنی، آب زیاد چه کار می کنه؟ اگر پرخون هم که باشه تو ادرار، تو اینو ضبط می کنه، رقیق می کنه"
    },
    {
      "id": 16,
      "start": 1887.0,
      "end": 1893.0,
      "formatted_start": "00:31:27.000",
      "formatted_end": "00:31:33.000",
      "text": "اگر پرخون هم که باشه وقتی آب زیاد بخوره، حجم اروقی، آب زیاد می شه، درمان"
    },
    {
      "id": 17,
      "start": 1893.0,
      "end": 1899.0,
      "formatted_start": "00:31:33.000",
      "formatted_end": "00:31:39.000",
      "text": "شما می کنید چه کار می کنید؟ قبل آزمایش، دو سه ساعت قبل آزمایش، تا می توانید آب بخور"
    },
    {
      "id": 18,
      "start": 1899.0,
      "end": 1906.0,
      "formatted_start": "00:31:39.000",
      "formatted_end": "00:31:46.000",
      "text": "بعد برو آزمایش بده اگر دیدی آزمایش ها زرمال بود تو استخدامیت همین کار بود"
    },
    {
      "id": 19,
      "start": 1906.0,
      "end": 1913.0,
      "formatted_start": "00:31:46.000",
      "formatted_end": "00:31:53.000",
      "text": "درسته؟ تو یا آزمایشی که میدن به همون درمانگای سپاه یا ارجاع"
    },
    {
      "id": 20,
      "start": 1913.0,
      "end": 1916.0,
      "formatted_start": "00:31:53.000",
      "formatted_end": "00:31:56.000",
      "text": "اونجا مایه هات بخور بعد ببین چی جوری میشه"
    },
    {
      "id": 21,
      "start": 1916.0,
      "end": 1919.0,
      "formatted_start": "00:31:56.000",
      "formatted_end": "00:31:59.000",
      "text": "نداره میشه برم خود رو به همون آزمایشگاه گربن"
    },
    {
      "id": 22,
      "start": 1919.0,
      "end": 1924.0,
      "formatted_start": "00:31:59.000",
      "formatted_end": "00:32:04.000",
      "text": "که میخوام همونجا آزمایش استخدامیت برم تو همون آزمایشگاه"
    },
    {
      "id": 23,
      "start": 1924.0,
      "end": 1926.0,
      "formatted_start": "00:32:04.000",
      "formatted_end": "00:32:06.000",
      "text": "همین کلکه بزن"
    },
    {
      "id": 24,
      "start": 1926.0,
      "end": 1928.82,
      "formatted_start": "00:32:06.000",
      "formatted_end": "00:32:08.820",
      "text": "یعنی با یه اسم دیگه یه مصدقی آزاد می باشه"
    },
    {
      "id": 25,
      "start": 1928.82,
      "end": 1932.28,
      "formatted_start": "00:32:08.820",
      "formatted_end": "00:32:12.280",
      "text": "مثلا بگو یه نسخه یه به اسم کسی دیگه آزاد برو"
    },
    {
      "id": 26,
      "start": 1932.28,
      "end": 1933.28,
      "formatted_start": "00:32:12.280",
      "formatted_end": "00:32:13.280",
      "text": "چون بیرون هست"
    },
    {
      "id": 27,
      "start": 1933.28,
      "end": 1934.78,
      "formatted_start": "00:32:13.280",
      "formatted_end": "00:32:14.780",
      "text": "آره دیگه یه کدرم دیگه بدم"
    },
    {
      "id": 28,
      "start": 1934.78,
      "end": 1935.58,
      "formatted_start": "00:32:14.780",
      "formatted_end": "00:32:15.580",
      "text": "نه اون بشه"
    },
    {
      "id": 29,
      "start": 1935.58,
      "end": 1937.58,
      "formatted_start": "00:32:15.580",
      "formatted_end": "00:32:17.580",
      "text": "حالا من خواه ندارم هر جور که دوسته"
    },
    {
      "id": 30,
      "start": 1937.58,
      "end": 1940.18,
      "formatted_start": "00:32:17.580",
      "formatted_end": "00:32:20.180",
      "text": "ولی آب بخور، حسابی هم آب بخور"
    },
    {
      "id": 31,
      "start": 1940.18,
      "end": 1944.0,
      "formatted_start": "00:32:20.180",
      "formatted_end": "00:32:24.000",
      "text": "یعنی 3-4 سال قبل از رفتن شروع به آب فردن کن تا لحظه آخر"
    },
    {
      "id": 32,
      "start": 1944.0,
      "end": 1948.64,
      "formatted_start": "00:32:24.000",
      "formatted_end": "00:32:28.640",
      "text": "بعد پر آزمایش بده، ببین اون دستگاهی اونا چی نیشون میده"
    },
    {
      "id": 33,
      "start": 1948.64,
      "end": 1950.64,
      "formatted_start": "00:32:28.640",
      "formatted_end": "00:32:30.640",
      "text": "بعد قله اونا رو گرفتی"
    },
    {
      "id": 34,
      "start": 1950.64,
      "end": 1952.64,
      "formatted_start": "00:32:30.640",
      "formatted_end": "00:32:32.640",
      "text": "آره"
    },
    {
      "id": 35,
      "start": 1952.64,
      "end": 1954.64,
      "formatted_start": "00:32:32.640",
      "formatted_end": "00:32:34.640",
      "text": "این بکره"
    },
    {
      "id": 36,
      "start": 1954.64,
      "end": 1960.64,
      "formatted_start": "00:32:34.640",
      "formatted_end": "00:32:40.640",
      "text": "میمونه ازماششو بینیسم یا کدی بینیم چیزی باید چرا"
    },
    {
      "id": 37,
      "start": 1960.64,
      "end": 1964.64,
      "formatted_start": "00:32:40.640",
      "formatted_end": "00:32:44.640",
      "text": "ازماش رو روی برگه بسام بینیسم"
    },
    {
      "id": 38,
      "start": 1964.64,
      "end": 1966.64,
      "formatted_start": "00:32:44.640",
      "formatted_end": "00:32:46.640",
      "text": "کاشه بینیم"
    },
    {
      "id": 39,
      "start": 1966.64,
      "end": 1968.64,
      "formatted_start": "00:32:46.640",
      "formatted_end": "00:32:48.640",
      "text": "کدومه اولیامون"
    },
    {
      "id": 40,
      "start": 1968.64,
      "end": 1970.64,
      "formatted_start": "00:32:48.640",
      "formatted_end": "00:32:50.640",
