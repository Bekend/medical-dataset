    },
    {
      "id": 43,
      "start": 1974.64,
      "end": 1976.64,
      "formatted_start": "00:32:54.640",
      "formatted_end": "00:32:56.640",
      "text": "همینا که انجام داده باشه"
    },
    {
      "id": 44,
      "start": 1976.64,
      "end": 1979.64,
      "formatted_start": "00:32:56.640",
      "formatted_end": "00:32:59.640",
      "text": "همین ها که اشتغال در رو رو من براتون میدیسم"
    },
    {
      "id": 45,
      "start": 1979.64,
      "end": 1981.64,
      "formatted_start": "00:32:59.640",
      "formatted_end": "00:33:01.640",
      "text": "خوب"
    },
    {
      "id": 46,
      "start": 1983.64,
      "end": 1985.64,
      "formatted_start": "00:33:03.640",
      "formatted_end": "00:33:05.640",
      "text": "بینم چیز دیگه جانمونه"
    },
    {
      "id": 47,
      "start": 1989.64,
      "end": 1990.64,
      "formatted_start": "00:33:09.640",
      "formatted_end": "00:33:10.640",
      "text": "نه همین ها"
    },
    {
      "id": 48,
      "start": 1990.64,
      "end": 1991.64,
      "formatted_start": "00:33:10.640",
      "formatted_end": "00:33:11.640",
      "text": "میخدمت شما"
    },
    {
      "id": 49,
      "start": 1991.64,
      "end": 1993.64,
      "formatted_start": "00:33:11.640",
      "formatted_end": "00:33:13.640",
      "text": "به چه نامی؟"
    },
    {
      "id": 50,
      "start": 1995.64,
      "end": 1997.64,
      "formatted_start": "00:33:15.640",
      "formatted_end": "00:33:17.640",
      "text": "عرب سوید"
    },
    {
      "id": 51,
      "start": 1999.64,
      "end": 2000.64,
      "formatted_start": "00:33:19.640",
      "formatted_end": "00:33:20.640",
      "text": "آ خدمت شو"
    },
    {
      "id": 52,
      "start": 2000.64,
      "end": 2002.64,
      "formatted_start": "00:33:20.640",
      "formatted_end": "00:33:22.640",
      "text": "برای بشینه"
    },
    {
      "id": 53,
      "start": 2002.64,
      "end": 2003.64,
      "formatted_start": "00:33:22.640",
      "formatted_end": "00:33:23.640",
      "text": "بشینه دکتر"
    },
    {
      "id": 54,
      "start": 2003.64,
      "end": 2005.64,
      "formatted_start": "00:33:23.640",
      "formatted_end": "00:33:25.640",
      "text": "اون من دکتر رو گفتم یادمش برمیدیس"
    },
    {
      "id": 55,
      "start": 2005.64,
      "end": 2007.64,
      "formatted_start": "00:33:25.640",
      "formatted_end": "00:33:27.640",
      "text": "بشه دیگه با چکل داشتیم دارم"
    },
    {
      "id": 56,
      "start": 2007.64,
      "end": 2009.64,
      "formatted_start": "00:33:27.640",
      "formatted_end": "00:33:29.640",
      "text": "بعد آقای عرق دید"
    },
    {
      "id": 57,
      "start": 2009.64,
      "end": 2011.64,
      "formatted_start": "00:33:29.640",
      "formatted_end": "00:33:31.640",
      "text": "گرفتی ایجا باشه بیار منم دید"
    },
    {
      "id": 58,
      "start": 2011.64,
      "end": 2013.64,
      "formatted_start": "00:33:31.640",
      "formatted_end": "00:33:33.640",
      "text": "چشم"
    },
    {
      "id": 59,
      "start": 2013.64,
      "end": 2015.64,
      "formatted_start": "00:33:33.640",
      "formatted_end": "00:33:35.640",
      "text": "حاضر شدیدی داره؟ نه آره"
    },
    {
      "id": 60,
      "start": 2015.64,
      "end": 2017.64,
      "formatted_start": "00:33:35.640",
      "formatted_end": "00:33:37.640",
      "text": "خب بیار همینجور بیار من"
    },
    {
      "id": 61,
      "start": 2017.64,
      "end": 2019.64,
      "formatted_start": "00:33:37.640",
      "formatted_end": "00:33:39.640",
      "text": "سه بشید"
    },
    {
      "id": 62,
      "start": 2019.64,
      "end": 2021.64,
      "formatted_start": "00:33:39.640",
      "formatted_end": "00:33:41.640",
      "text": "خب باید"
    },
    {
      "id": 63,
      "start": 2025.64,
      "end": 2027.64,
      "formatted_start": "00:33:45.640",
      "formatted_end": "00:33:47.640",
      "text": "بفهم"
    },
    {
      "id": 64,
      "start": 2027.64,
      "end": 2029.64,
      "formatted_start": "00:33:47.640",
      "formatted_end": "00:33:49.640",
      "text": "خب"
    },
    {
      "id": 65,
      "start": 2029.64,
      "end": 2031.64,
      "formatted_start": "00:33:49.640",
      "formatted_end": "00:33:51.640",
      "text": "دیدید خانم یه از پیریه"
    },
    {
      "id": 66,
      "start": 2031.64,
      "end": 2033.64,
      "formatted_start": "00:33:51.640",
      "formatted_end": "00:33:53.640",
      "text": "داخل هر سوراخ بینی"
    },
    {
      "id": 67,
      "start": 2033.64,
      "end": 2040.64,
      "formatted_start": "00:33:53.640",
      "formatted_end": "00:34:00.640",
      "text": "سه تا میزنید. سه تا این سراخ با شفتت هم بزنید."
    },
    {
      "id": 68,
      "start": 2050.64,
      "end": 2055.64,
      "formatted_start": "00:34:10.640",
      "formatted_end": "00:34:15.640",
      "text": "همین چیزش مردم نیست. درست باید اینجوری باشه."
    },
    {
      "id": 69,
      "start": 2055.64,
      "end": 2063.64,
      "formatted_start": "00:34:15.640",
      "formatted_end": "00:34:23.640",
      "text": "این ها چیزی نیست، آبه با نمک داخلی بینی میزنید و تو سراخش بشن اینجا"
    },
    {
      "id": 70,
      "start": 2063.64,
      "end": 2068.64,
      "formatted_start": "00:34:23.640",
      "formatted_end": "00:34:28.640",
      "text": "بعد دو سه تا میزنید، این پخش اینچه تومنه، هشت خطری هم؟"
    },
    {
      "id": 71,
      "start": 2068.64,
      "end": 2071.64,
      "formatted_start": "00:34:28.640",
      "formatted_end": "00:34:31.640",
      "text": "بعد میزنید، بینیش رو مثلا با فینگیر میزنیم"
    },
    {
      "id": 72,
      "start": 2071.64,
      "end": 2076.64,
      "formatted_start": "00:34:31.640",
      "formatted_end": "00:34:36.640",
      "text": "چرا؟ این فینگیر هم، اینه که زدی، ده دقیقه بعد فینگیر رو خشن داریدی"
    },
    {
      "id": 73,
      "start": 2076.64,
      "end": 2077.64,
      "formatted_start": "00:34:36.640",
      "formatted_end": "00:34:37.640",
      "text": "نه، نه دارم"
    },
    {
      "id": 74,
      "start": 2077.64,
      "end": 2080.64,
      "formatted_start": "00:34:37.640",
      "formatted_end": "00:34:40.640",
      "text": "یه فینگیر، من برای تو میخوایی بگیرسم؟"
    },
    {
      "id": 75,
      "start": 2080.64,
      "end": 2081.64,
      "formatted_start": "00:34:40.640",
      "formatted_end": "00:34:41.640",
      "text": "نه، نه بگیرم"
    },
    {
      "id": 76,
      "start": 2081.64,
      "end": 2085.3,
      "formatted_start": "00:34:41.640",
      "formatted_end": "00:34:45.300",
      "text": "یک دماغ گیر بیدی پین گیر از این گیرانی ها"
    },
    {
      "id": 77,
      "start": 2085.3,
      "end": 2087.5,
      "formatted_start": "00:34:45.300",
      "formatted_end": "00:34:47.500",
      "text": "با اون هم تنمیزش باشید"
    },
    {
      "id": 78,
      "start": 2087.5,
      "end": 2088.1,
      "formatted_start": "00:34:47.500",
      "formatted_end": "00:34:48.100",
      "text": "خدا مکنه"
    },
