  "stt_segments": [
    {
      "id": 0,
      "start": 900.0,
      "end": 929.98,
      "formatted_start": "00:15:00.000",
      "formatted_end": "00:15:29.980",
      "text": "بیمار در مطب پزشکی، معاینه بیمار در مطب پزشکی، داروها، آزمایش و نسخه."
    },
    {
      "id": 1,
      "start": 930.0,
      "end": 960.0,
      "formatted_start": "00:15:30.000",
      "formatted_end": "00:16:00.000",
      "text": "اینجا باید بردارید که باید بردارید که باید بردارید که باید بردارید که باید بردارید که باید بردارید که باید بردارید که باید بردارید که باید بردارید که باید بردارید که باید بردارید که باید بردارید که باید بردارید که باید بردارید که باید بردارید که باید بردارید که باید بردارید که باید بردارید که بای"
    },
    {
      "id": 2,
      "start": 960.0,
      "end": 962.0,
      "formatted_start": "00:16:00.000",
      "formatted_end": "00:16:02.000",
      "text": "یک شروط یکتر"
    },
    {
      "id": 3,
      "start": 962.0,
      "end": 964.0,
      "formatted_start": "00:16:02.000",
      "formatted_end": "00:16:04.000",
      "text": "این هم هر هشت ساعت که قاشق اومرد بخورید"
    },
    {
      "id": 4,
      "start": 964.0,
      "end": 966.0,
      "formatted_start": "00:16:04.000",
      "formatted_end": "00:16:06.000",
      "text": "دومونیم سیزی"
    },
    {
      "id": 5,
      "start": 966.0,
      "end": 968.0,
      "formatted_start": "00:16:06.000",
      "formatted_end": "00:16:08.000",
      "text": "اریترومایسین مایسیویی"
    },
    {
      "id": 6,
      "start": 968.0,
      "end": 970.0,
      "formatted_start": "00:16:08.000",
      "formatted_end": "00:16:10.000",
      "text": "از بردیم؟ نه آزیترو نیست"
    },
    {
      "id": 7,
      "start": 970.0,
      "end": 972.0,
      "formatted_start": "00:16:10.000",
      "formatted_end": "00:16:12.000",
      "text": "این ها اریترومایسین هستند، آزیترو کچیک هستند"
    },
    {
      "id": 8,
      "start": 972.0,
      "end": 974.0,
      "formatted_start": "00:16:12.000",
      "formatted_end": "00:16:14.000",
      "text": "پدیابست"
    },
    {
      "id": 9,
      "start": 974.0,
      "end": 976.0,
      "formatted_start": "00:16:14.000",
      "formatted_end": "00:16:16.000",
      "text": "هر هشت ساعت 18 تا 20"
    },
    {
      "id": 10,
      "start": 976.0,
      "end": 978.0,
      "formatted_start": "00:16:16.000",
      "formatted_end": "00:16:18.000",
      "text": "تصدیبیدید دو برابر وزنید"
    },
    {
      "id": 11,
      "start": 978.0,
      "end": 980.0,
      "formatted_start": "00:16:18.000",
      "formatted_end": "00:16:20.000",
      "text": "دو تا هم تصدیبی دارد"
    },
    {
      "id": 12,
      "start": 980.0,
      "end": 982.0,
      "formatted_start": "00:16:20.000",
      "formatted_end": "00:16:22.000",
      "text": "که همینجا به من شیده بید"
    },
    {
      "id": 13,
      "start": 982.0,
      "end": 984.0,
      "formatted_start": "00:16:22.000",
      "formatted_end": "00:16:24.000",
      "text": "برای کنید چیزی"
    },
    {
      "id": 14,
      "start": 984.0,
      "end": 986.0,
      "formatted_start": "00:16:24.000",
      "formatted_end": "00:16:26.000",
      "text": "خدمت شما خیالانگانم"
    },
    {
      "id": 15,
      "start": 986.0,
      "end": 1014.0,
      "formatted_start": "00:16:26.000",
      "formatted_end": "00:16:54.000",
      "text": "موسیقی"
    },
    {
      "id": 16,
      "start": 1014.0,
      "end": 1043.98,
      "formatted_start": "00:16:54.000",
      "formatted_end": "00:17:23.980",
      "text": "موسیقی در موسیقی"
    },
    {
      "id": 17,
      "start": 1044.0,
      "end": 1059.0,
      "formatted_start": "00:17:24.000",
      "formatted_end": "00:17:39.000",
      "text": "موسیقی"
    },
    {
      "id": 18,
      "start": 1059.0,
      "end": 1061.0,
      "formatted_start": "00:17:39.000",
      "formatted_end": "00:17:41.000",
      "text": "سلام بابا جان، سلامت بزنید؟"
    },
    {
      "id": 19,
      "start": 1061.0,
      "end": 1062.0,
      "formatted_start": "00:17:41.000",
      "formatted_end": "00:17:42.000",
      "text": "سلام"
    },
    {
      "id": 20,
      "start": 1062.0,
      "end": 1066.0,
      "formatted_start": "00:17:42.000",
      "formatted_end": "00:17:46.000",
      "text": "بسیار سلام، بفهم کن برگیر رو معیبت کنید، خوشی برم"
    },
    {
      "id": 21,
      "start": 1066.0,
      "end": 1070.0,
      "formatted_start": "00:17:46.000",
      "formatted_end": "00:17:50.000",
      "text": "خدای خانم امینی، بفهم یک چند از این"
    },
    {
      "id": 22,
      "start": 1070.0,
      "end": 1072.0,
      "formatted_start": "00:17:50.000",
      "formatted_end": "00:17:52.000",
      "text": "چی شده کچون رو؟"
    },
    {
      "id": 23,
      "start": 1072.0,
      "end": 1074.0,
      "formatted_start": "00:17:52.000",
      "formatted_end": "00:17:54.000",
      "text": "سال پر من"
    },
    {
      "id": 24,
      "start": 1074.0,
      "end": 1078.0,
      "formatted_start": "00:17:54.000",
      "formatted_end": "00:17:58.000",
      "text": "بکنیم یک برده بینیش گرفت"
    },
    {
      "id": 25,
      "start": 1078.0,
      "end": 1080.0,
      "formatted_start": "00:17:58.000",
      "formatted_end": "00:18:00.000",
      "text": "یعنی سال پر نداره"
    },
    {
      "id": 26,
      "start": 1080.0,
      "end": 1082.0,
      "formatted_start": "00:18:00.000",
      "formatted_end": "00:18:02.000",
      "text": "اون روزی هم خودم تو شربت داره"
    },
    {
      "id": 27,
      "start": 1082.0,
      "end": 1086.0,
      "formatted_start": "00:18:02.000",
      "formatted_end": "00:18:06.000",
      "text": "بعد پیش من بیار که بگم که یک برده بینیش گرفت"
    },
    {
      "id": 28,
      "start": 1086.0,
      "end": 1088.0,
      "formatted_start": "00:18:06.000",
      "formatted_end": "00:18:08.000",
