  "stt_segments": [
    {
      "id": 0,
      "start": 1500.0,
      "end": 1508.0,
      "formatted_start": "00:25:00.000",
      "formatted_end": "00:25:08.000",
      "text": "اینجا پلاکت و خونت برگرده، اینجا دنبال سراخی."
    },
    {
      "id": 1,
      "start": 1508.0,
      "end": 1512.0,
      "formatted_start": "00:25:08.000",
      "formatted_end": "00:25:12.000",
      "text": "اینجده آخره چنده افترانی؟ یعنی نیم."
    },
    {
      "id": 2,
      "start": 1512.0,
      "end": 1518.0,
      "formatted_start": "00:25:12.000",
      "formatted_end": "00:25:18.000",
      "text": "این نیم شاید الان بگیرید، آزمایشگاهی بگیرید و بگیرید، نرماله."
    },
    {
      "id": 3,
      "start": 1518.0,
      "end": 1524.0,
      "formatted_start": "00:25:18.000",
      "formatted_end": "00:25:24.000",
      "text": "اینجا پلاکت و خونت، صد و پنجه ها نرماله، صد و چده و پنجه، پنجه."
    },
    {
      "id": 4,
      "start": 1524.0,
      "end": 1528.0,
      "formatted_start": "00:25:24.000",
      "formatted_end": "00:25:28.000",
      "text": "یعنی همه لبه مرزه که یکم بگیرن."
    },
    {
      "id": 5,
      "start": 1528.0,
      "end": 1530.0,
      "formatted_start": "00:25:28.000",
      "formatted_end": "00:25:30.000",
      "text": "ها تست کبیدی"
    },
    {
      "id": 6,
      "start": 1530.0,
      "end": 1532.0,
      "formatted_start": "00:25:30.000",
      "formatted_end": "00:25:32.000",
      "text": "خوب آفرین تست کبیدی"
    },
    {
      "id": 7,
      "start": 1532.0,
      "end": 1534.0,
      "formatted_start": "00:25:32.000",
      "formatted_end": "00:25:34.000",
      "text": "چه رو یک"
    },
    {
      "id": 8,
      "start": 1534.0,
      "end": 1536.0,
      "formatted_start": "00:25:34.000",
      "formatted_end": "00:25:36.000",
      "text": "چه رو یکی که باید چه رو داشته"
    },
    {
      "id": 9,
      "start": 1536.0,
      "end": 1538.0,
      "formatted_start": "00:25:36.000",
      "formatted_end": "00:25:38.000",
      "text": "این هم یکم از باب مرز میبرده"
    },
    {
      "id": 10,
      "start": 1538.0,
      "end": 1540.0,
      "formatted_start": "00:25:38.000",
      "formatted_end": "00:25:40.000",
      "text": "آره اونا با هم یکم هم"
    },
    {
      "id": 11,
      "start": 1540.0,
      "end": 1542.0,
      "formatted_start": "00:25:40.000",
      "formatted_end": "00:25:42.000",
      "text": "آره آره من کشکن به چی میگم"
    },
    {
      "id": 12,
      "start": 1542.0,
      "end": 1544.0,
      "formatted_start": "00:25:42.000",
      "formatted_end": "00:25:44.000",
      "text": "این آزمایه شد خوبه خوب"
    },
    {
      "id": 13,
      "start": 1544.0,
      "end": 1546.0,
      "formatted_start": "00:25:44.000",
      "formatted_end": "00:25:46.000",
      "text": "یعنی حیفه که با این"
    },
    {
      "id": 14,
      "start": 1546.0,
      "end": 1548.0,
      "formatted_start": "00:25:46.000",
      "formatted_end": "00:25:48.000",
      "text": "یک کم میلیمتری تو رفت میشید"
    },
    {
      "id": 15,
      "start": 1548.0,
      "end": 1550.0,
      "formatted_start": "00:25:48.000",
      "formatted_end": "00:25:50.000",
      "text": "دقیقا"
    },
    {
      "id": 16,
      "start": 1550.0,
      "end": 1552.0,
      "formatted_start": "00:25:50.000",
      "formatted_end": "00:25:52.000",
      "text": "خوب حالا شما آقای"
    },
    {
      "id": 17,
      "start": 1552.0,
      "end": 1554.0,
      "formatted_start": "00:25:52.000",
      "formatted_end": "00:25:54.000",
      "text": "اروالی زاده کاری که میکنین"
    },
    {
      "id": 18,
      "start": 1554.0,
      "end": 1556.0,
      "formatted_start": "00:25:54.000",
      "formatted_end": "00:25:56.000",
      "text": "برو یه آزمایشگاه"
    },
    {
      "id": 19,
      "start": 1556.0,
      "end": 1558.0,
      "formatted_start": "00:25:56.000",
      "formatted_end": "00:25:58.000",
      "text": "خب"
    },
    {
      "id": 20,
      "start": 1558.0,
      "end": 1562.0,
      "formatted_start": "00:25:58.000",
      "formatted_end": "00:26:02.000",
      "text": "من فکر می کنم این ها دستگاه خطا داره"
    },
    {
      "id": 21,
      "start": 1562.0,
      "end": 1564.0,
      "formatted_start": "00:26:02.000",
      "formatted_end": "00:26:04.000",
      "text": "یا مثلا سیاد چیزه"
    },
    {
      "id": 22,
      "start": 1564.0,
      "end": 1566.0,
      "formatted_start": "00:26:04.000",
      "formatted_end": "00:26:06.000",
      "text": "الان شما این رو اجدن می زنید"
    },
    {
      "id": 23,
      "start": 1566.0,
      "end": 1568.0,
      "formatted_start": "00:26:06.000",
      "formatted_end": "00:26:08.000",
      "text": "یه جایی دیگه بگیریم بگیر شمزن"
    },
    {
      "id": 24,
      "start": 1568.0,
      "end": 1570.0,
      "formatted_start": "00:26:08.000",
      "formatted_end": "00:26:10.000",
      "text": "خیلی کش اومده"
    },
    {
      "id": 25,
      "start": 1570.0,
      "end": 1572.0,
      "formatted_start": "00:26:10.000",
      "formatted_end": "00:26:12.000",
      "text": "من فکر می کنم با توجه بگیریم"
    },
    {
      "id": 26,
      "start": 1572.0,
      "end": 1574.0,
      "formatted_start": "00:26:12.000",
      "formatted_end": "00:26:14.000",
      "text": "تو سلامت کامل دیگه"
    },
    {
      "id": 27,
      "start": 1574.0,
      "end": 1576.0,
      "formatted_start": "00:26:14.000",
      "formatted_end": "00:26:16.000",
      "text": "دیگه افتادت داریم"
    },
    {
      "id": 28,
      "start": 1576.0,
      "end": 1578.0,
      "formatted_start": "00:26:16.000",
      "formatted_end": "00:26:18.000",
      "text": "می شون می دهید که پرلیبون هستی"
    },
    {
      "id": 29,
      "start": 1578.0,
      "end": 1580.0,
      "formatted_start": "00:26:18.000",
      "formatted_end": "00:26:20.000",
      "text": "خب"
    },
    {
      "id": 30,
      "start": 1580.0,
      "end": 1582.0,
      "formatted_start": "00:26:20.000",
      "formatted_end": "00:26:22.000",
      "text": "مشکل خودش"
    },
    {
      "id": 31,
      "start": 1582.0,
      "end": 1584.0,
      "formatted_start": "00:26:22.000",
      "formatted_end": "00:26:24.000",
      "text": "مشکل نداری درسته مشخص"
    },
    {
      "id": 32,
      "start": 1584.0,
      "end": 1585.0,
      "formatted_start": "00:26:24.000",
      "formatted_end": "00:26:25.000",
      "text": "درسته؟ مشخص؟"
    },
    {
      "id": 33,
      "start": 1585.0,
      "end": 1586.0,
      "formatted_start": "00:26:25.000",
      "formatted_end": "00:26:26.000",
      "text": "آره"
    },
    {
      "id": 34,
      "start": 1586.0,
      "end": 1591.0,
      "formatted_start": "00:26:26.000",
      "formatted_end": "00:26:31.000",
      "text": "حالا از سر این دو تا چیز دو زنان نیمی هسته بخواد دندگیت رو عوض کنی"
    },
    {
      "id": 35,
      "start": 1591.0,
      "end": 1592.0,
      "formatted_start": "00:26:31.000",
      "formatted_end": "00:26:32.000",
      "text": "همون دیگه است"
    },
    {
      "id": 36,
      "start": 1592.0,
      "end": 1594.0,
      "formatted_start": "00:26:32.000",
      "formatted_end": "00:26:34.000",
      "text": "خب شما چرا رفتین آزماشگاه؟"
    },
    {
      "id": 37,
      "start": 1594.0,
      "end": 1596.0,
      "formatted_start": "00:26:34.000",
      "formatted_end": "00:26:36.000",
      "text": "بس اینکه میخواستم"
    },
    {
      "id": 38,
      "start": 1596.0,
      "end": 1599.0,
      "formatted_start": "00:26:36.000",
      "formatted_end": "00:26:39.000",
      "text": "خب شما همین آزمایش رو من میدی بیستم"
    },
    {
      "id": 39,
      "start": 1599.0,
      "end": 1602.0,
      "formatted_start": "00:26:39.000",
      "formatted_end": "00:26:42.000",
      "text": "پروی آزماشگاه هست دیگه هر جا که توسته"
    },
    {
      "id": 40,
      "start": 1602.0,
      "end": 1606.0,
      "formatted_start": "00:26:42.000",
      "formatted_end": "00:26:46.000",
      "text": "خب من این آزماش رو، این آزماش رو یه یور رو نگاه میکنی"
    },
    {
      "id": 41,
      "start": 1607.0,
      "end": 1610.0,
      "formatted_start": "00:26:47.000",
      "formatted_end": "00:26:50.000",
      "text": "چه این آزماش رو نشته؟ پیت؟ چی نوشته؟"
    },
    {
      "id": 42,
      "start": 1610.0,
      "end": 1612.0,
      "formatted_start": "00:26:50.000",
      "formatted_end": "00:26:52.000",
      "text": "نرمال"
    },
    {
      "id": 43,
      "start": 1612.0,
      "end": 1614.0,
      "formatted_start": "00:26:52.000",
      "formatted_end": "00:26:54.000",
      "text": "یوها نرماله"
    },
    {
      "id": 44,
      "start": 1614.0,
      "end": 1616.0,
      "formatted_start": "00:26:54.000",
      "formatted_end": "00:26:56.000",
      "text": "دوتا سه"
    },
    {
      "id": 45,
      "start": 1616.0,
      "end": 1618.0,
      "formatted_start": "00:26:56.000",
      "formatted_end": "00:26:58.000",
      "text": "اون دوت طبیعه"
    },
    {
      "id": 46,
      "start": 1618.0,
      "end": 1620.0,
      "formatted_start": "00:26:58.000",
      "formatted_end": "00:27:00.000",
      "text": "تا پنجتا طبیعه"
    },
    {
      "id": 47,
      "start": 1620.0,
      "end": 1622.0,
      "formatted_start": "00:27:00.000",
      "formatted_end": "00:27:02.000",
      "text": "توی آزماش دکتر بحری از این فلاد توی خونو زده"
    },
    {
      "id": 48,
      "start": 1622.0,
      "end": 1624.0,
      "formatted_start": "00:27:02.000",
      "formatted_end": "00:27:04.000",
      "text": "ادران رو زده خونو زده خونو مصفر"
    },
    {
      "id": 49,
      "start": 1624.0,
      "end": 1626.0,
      "formatted_start": "00:27:04.000",
      "formatted_end": "00:27:06.000",
      "text": "من الان بشم"
    },
    {
      "id": 50,
      "start": 1626.0,
      "end": 1628.0,
      "formatted_start": "00:27:06.000",
      "formatted_end": "00:27:08.000",
      "text": "آره اونجا خیلی هم زده مصفر"
    },
    {
      "id": 51,
      "start": 1628.0,
      "end": 1630.0,
      "formatted_start": "00:27:08.000",
      "formatted_end": "00:27:10.000",
      "text": "همین میگن آزماشگاه ها با هم فردند"
    },
    {
      "id": 52,
      "start": 1630.0,
      "end": 1632.0,
      "formatted_start": "00:27:10.000",
      "formatted_end": "00:27:12.000",
      "text": "بله بخدا یک دکتر دیگه"
    },
    {
      "id": 53,
      "start": 1632.0,
      "end": 1634.0,
      "formatted_start": "00:27:12.000",
      "formatted_end": "00:27:14.000",
      "text": "من بود کنست"
    },
    {
      "id": 54,
      "start": 1634.0,
      "end": 1636.0,
      "formatted_start": "00:27:14.000",
      "formatted_end": "00:27:16.000",
      "text": "که این آزماشگاه دکتر بحری"
    },
    {
      "id": 55,
      "start": 1636.0,
      "end": 1638.0,
      "formatted_start": "00:27:16.000",
      "formatted_end": "00:27:18.000",
      "text": "اصلا میشه اعتبار نکنه"
    },
    {
      "id": 56,
      "start": 1638.0,
      "end": 1644.0,
      "formatted_start": "00:27:18.000",
      "formatted_end": "00:27:24.000",
      "text": "آره آره ببینید این زده 18 تا 20 تا این زده نرمان درسته؟"
    },
    {
      "id": 57,
      "start": 1644.0,
      "end": 1646.0,
      "formatted_start": "00:27:24.000",
      "formatted_end": "00:27:26.000",
      "text": "حالا کدامی کشون درسته؟"
    },
    {
      "id": 58,
      "start": 1646.0,
      "end": 1648.0,
      "formatted_start": "00:27:26.000",
      "formatted_end": "00:27:28.000",
      "text": "پیسو و سپید درسته"
    },
    {
      "id": 59,
      "start": 1648.0,
      "end": 1654.0,
      "formatted_start": "00:27:28.000",
      "formatted_end": "00:27:34.000",
      "text": "خیلی خوب تمام ممکنه اینم درست باشه مثلا هم شما اگر یه ورزش سنگین کنید"
    },
    {
      "id": 60,
      "start": 1654.0,
      "end": 1657.0,
      "formatted_start": "00:27:34.000",
      "formatted_end": "00:27:37.000",
      "text": "و یه آزمایش ادرابیدید خون تو ادرابیدید"
    },
    {
      "id": 61,
      "start": 1657.0,
      "end": 1666.0,
      "formatted_start": "00:27:37.000",
      "formatted_end": "00:27:46.000",
      "text": "تو برزی ها مثلا میدن و هم ورزش میکنن فردا میدن آزمایشگاه ببینن که مثلا چندتای خون دیده شده"
    },
    {
      "id": 62,
      "start": 1666.0,
      "end": 1672.0,
      "formatted_start": "00:27:46.000",
      "formatted_end": "00:27:52.000",
      "text": "میخواد اینکه در تحرکات بعض اینکه خون از کلی هم به صورت میکروسکوپی خارج میشه"
    },
    {
      "id": 63,
      "start": 1672.0,
      "end": 1679.0,
      "formatted_start": "00:27:52.000",
      "formatted_end": "00:27:59.000",
      "text": "یا ممکنه مثلا ببین شما اگر موریزی داشته باشید پس کن از ادرارت داره خون میره"
    },
    {
      "id": 64,
      "start": 1679.0,
      "end": 1682.0,
      "formatted_start": "00:27:59.000",
      "formatted_end": "00:28:02.000",
      "text": "آره، اما میگم من نه درک دارم نه سوزه شید"
    },
    {
      "id": 65,
      "start": 1682.0,
      "end": 1689.0,
      "formatted_start": "00:28:02.000",
      "formatted_end": "00:28:09.000",
      "text": "بعد شما وقتی که خون از ادرارت داره به صورت دائم میره چه اتفاق میفته؟"
    },
    {
      "id": 66,
      "start": 1689.0,
      "end": 1691.0,
      "formatted_start": "00:28:09.000",
      "formatted_end": "00:28:11.000",
      "text": "کم خون میشه"
    },
    {
      "id": 67,
      "start": 1691.0,
      "end": 1695.3,
      "formatted_start": "00:28:11.000",
      "formatted_end": "00:28:15.300",
      "text": "در حال اینجا خونت زد زده بالا یعنی پرخونی داره"
    },
    {
      "id": 68,
      "start": 1695.3,
      "end": 1696.3,
      "formatted_start": "00:28:15.300",
      "formatted_end": "00:28:16.300",
      "text": "بیشتری"
    },
    {
      "id": 69,
      "start": 1696.3,
      "end": 1699.3,
      "formatted_start": "00:28:16.300",
      "formatted_end": "00:28:19.300",
      "text": "این با این نمیخوره"
    },
    {
      "id": 70,
      "start": 1699.3,
      "end": 1701.3,
      "formatted_start": "00:28:19.300",
      "formatted_end": "00:28:21.300",
      "text": "خیلی خوب"
    },
    {
      "id": 71,
      "start": 1701.3,
      "end": 1703.3,
      "formatted_start": "00:28:21.300",
      "formatted_end": "00:28:23.300",
      "text": "خیلی خوب"
    },
    {
      "id": 72,
      "start": 1703.3,
      "end": 1705.3,
      "formatted_start": "00:28:23.300",
      "formatted_end": "00:28:25.300",
      "text": "خیلی خوب"
    },
    {
      "id": 73,
      "start": 1705.3,
      "end": 1707.3,
      "formatted_start": "00:28:25.300",
      "formatted_end": "00:28:27.300",
      "text": "خیلی خوب"
    },
    {
      "id": 74,
      "start": 1707.3,
      "end": 1709.3,
      "formatted_start": "00:28:27.300",
      "formatted_end": "00:28:29.300",
      "text": "خیلی خوب"
    },
    {
      "id": 75,
      "start": 1709.3,
      "end": 1711.3,
      "formatted_start": "00:28:29.300",
      "formatted_end": "00:28:31.300",
      "text": "خیلی خوب"
    },
    {
      "id": 76,
      "start": 1711.3,
      "end": 1713.3,
      "formatted_start": "00:28:31.300",
      "formatted_end": "00:28:33.300",
      "text": "خیلی خوب"
    },
    {
      "id": 77,
      "start": 1713.3,
      "end": 1715.3,
      "formatted_start": "00:28:33.300",
      "formatted_end": "00:28:35.300",
      "text": "خیلی خوب"
    },
    {
      "id": 78,
      "start": 1715.3,
      "end": 1717.3,
      "formatted_start": "00:28:35.300",
      "formatted_end": "00:28:37.300",
      "text": "خیلی خوب"
    },
    {
      "id": 79,
      "start": 1717.3,
      "end": 1719.3,
      "formatted_start": "00:28:37.300",
      "formatted_end": "00:28:39.300",
      "text": "خیلی خوب"
    },
    {
      "id": 80,
      "start": 1719.3,
      "end": 1721.3,
      "formatted_start": "00:28:39.300",
      "formatted_end": "00:28:41.300",
      "text": "خیلی خوب"
    },
    {
      "id": 81,
      "start": 1721.3,
      "end": 1723.3,
      "formatted_start": "00:28:41.300",
      "formatted_end": "00:28:43.300",
      "text": "خیلی خوب"
    },
    {
      "id": 82,
      "start": 1723.3,
      "end": 1725.3,
      "formatted_start": "00:28:43.300",
      "formatted_end": "00:28:45.300",
      "text": "خیلی خوب"
    },
    {
      "id": 83,
      "start": 1725.3,
      "end": 1727.3,
      "formatted_start": "00:28:45.300",
      "formatted_end": "00:28:47.300",
      "text": "خیلی خوب"
    },
    {
      "id": 84,
      "start": 1727.3,
      "end": 1730.3,
      "formatted_start": "00:28:47.300",
      "formatted_end": "00:28:50.300",
      "text": "یک آزمایش مرمال در یک آزمایشگاه دیگه"
    },
    {
      "id": 85,
      "start": 1730.3,
      "end": 1732.3,
      "formatted_start": "00:28:50.300",
      "formatted_end": "00:28:52.300",
      "text": "ببینیم برنامه نشون بود"
    },
    {
      "id": 86,
      "start": 1732.3,
      "end": 1735.3,
      "formatted_start": "00:28:52.300",
      "formatted_end": "00:28:55.300",
      "text": "به کیا میشون بود؟"
    },
    {
      "id": 87,
      "start": 1735.3,
      "end": 1739.3,
      "formatted_start": "00:28:55.300",
      "formatted_end": "00:28:59.300",
      "text": "این رو انتظام میکرد خودشون کلن درخواه دارن"
    },
    {
      "id": 88,
      "start": 1739.3,
      "end": 1741.3,
      "formatted_start": "00:28:59.300",
      "formatted_end": "00:29:01.300",
      "text": "متعد دارن"
    },
    {
      "id": 89,
      "start": 1741.3,
      "end": 1745.3,
      "formatted_start": "00:29:01.300",
      "formatted_end": "00:29:05.300",
      "text": "اینو میخوام واسه خیال خودم"
    },
    {
      "id": 90,
      "start": 1745.3,
      "end": 1747.3,
      "formatted_start": "00:29:05.300",
      "formatted_end": "00:29:07.300",
      "text": "نه ببینید نه نه"
    },
    {
      "id": 91,
      "start": 1747.3,
      "end": 1751.3,
      "formatted_start": "00:29:07.300",
      "formatted_end": "00:29:11.300",
      "text": "آره متعد شدیم ببینید آقای عقاب زاده"
    },
    {
      "id": 92,
      "start": 1751.3,
      "end": 1755.3,
      "formatted_start": "00:29:11.300",
      "formatted_end": "00:29:15.300",
      "text": "ببین تماما اینا بستگی داره بون کیت آزمایشگاهی اونجا"
    },
    {
      "id": 93,
      "start": 1755.3,
      "end": 1759.3,
      "formatted_start": "00:29:15.300",
      "formatted_end": "00:29:19.300",
      "text": "بالا ترس برای تو داشتی که با این آزمایش ها آیا..."
    },
    {
      "id": 94,
      "start": 1759.3,
      "end": 1763.3,
      "formatted_start": "00:29:19.300",
      "formatted_end": "00:29:23.300",
      "text": "اینو دلخواه رو دارن یه سیخه میدنگو فنگی کنن برای خود..."
    },
    {
      "id": 95,
      "start": 1763.3,
      "end": 1771.3,
      "formatted_start": "00:29:23.300",
      "formatted_end": "00:29:31.300",
      "text": "اگر میخوایی که، مثلا من بهت میگم، اگر میخوایی که پرخونیت رو کمخون نشان بدن باید مایات زیاد نصر کنیم"
    },
    {
      "id": 96,
      "start": 1771.3,
      "end": 1773.3,
      "formatted_start": "00:29:31.300",
      "formatted_end": "00:29:33.300",
      "text": "نه از پلاکت هم گفته بود..."
    },
    {
      "id": 97,
      "start": 1773.3,
      "end": 1776.3,
      "formatted_start": "00:29:33.300",
      "formatted_end": "00:29:36.300",
      "text": "پلاکت هم لب مرز ها، داروی نه..."
    },
    {
      "id": 98,
      "start": 1776.3,
      "end": 1780.3,
      "formatted_start": "00:29:36.300",
      "formatted_end": "00:29:40.300",
      "text": "نه، میترسم یه جای دیگه رو اقتدار ایجاد کنیم"
    },
    {
      "id": 99,
      "start": 1780.3,
      "end": 1783.1,
      "formatted_start": "00:29:40.300",
      "formatted_end": "00:29:43.100",
      "text": "با یه آدم سالم و یه سپی دارو بدین"
    },
    {
      "id": 100,
      "start": 1783.1,
      "end": 1785.64,
      "formatted_start": "00:29:43.100",
      "formatted_end": "00:29:45.640",
      "text": "برای یه جایی، بعد یه جای دیگه رو نزنیم"
    },
    {
      "id": 101,
      "start": 1785.64,
      "end": 1787.64,
      "formatted_start": "00:29:45.640",
      "formatted_end": "00:29:47.640",
      "text": "کلیه رو کم کار میکنیم، کبد رو"
    },
    {
      "id": 102,
      "start": 1787.64,
      "end": 1789.3,
      "formatted_start": "00:29:47.640",
      "formatted_end": "00:29:49.300",
      "text": "عوارض داره این داروها"
    },
    {
      "id": 103,
      "start": 1789.3,
      "end": 1792.8,
      "formatted_start": "00:29:49.300",
      "formatted_end": "00:29:52.800",
      "text": "نداری؟ برای نه من میتونم برای این چیزها بیدیسم تو برو کشار میشه"
    },
    {
      "id": 104,
      "start": 1792.8,
      "end": 1796.06,
      "formatted_start": "00:29:52.800",
      "formatted_end": "00:29:56.060",
      "text": "ولی قطعا عوارض داره، بعد اونجا گیره دیگه هم"
    },
    {
      "id": 105,
      "start": 1796.06,
      "end": 1798.06,
      "formatted_start": "00:29:56.060",
      "formatted_end": "00:29:58.060",
      "text": "خب؟"
    }
  ],
