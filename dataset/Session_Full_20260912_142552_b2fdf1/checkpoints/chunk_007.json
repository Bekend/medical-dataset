      "formatted_start": "00:35:00.000",
      "formatted_end": "00:35:10.000",
      "text": "از اینجا، با اینکه بیمار بیمار در مطب پزشکی، داروها، آزمایش و نسخه."
    },
    {
      "id": 1,
      "start": 2130.0,
      "end": 2150.0,
      "formatted_start": "00:35:30.000",
      "formatted_end": "00:35:50.000",
      "text": "موسیقی"
    },
    {
      "id": 2,
      "start": 2150.0,
      "end": 2152.0,
      "formatted_start": "00:35:50.000",
      "formatted_end": "00:35:52.000",
      "text": "اوه میگوید"
    },
    {
      "id": 3,
      "start": 2152.0,
      "end": 2154.0,
      "formatted_start": "00:35:52.000",
      "formatted_end": "00:35:54.000",
      "text": "اوه میگوید"
    },
    {
      "id": 4,
      "start": 2154.0,
      "end": 2156.0,
      "formatted_start": "00:35:54.000",
      "formatted_end": "00:35:56.000",
      "text": "اوه میگوید"
    },
    {
      "id": 5,
      "start": 2156.0,
      "end": 2158.0,
      "formatted_start": "00:35:56.000",
      "formatted_end": "00:35:58.000",
      "text": "اوه میگوید"
    },
    {
      "id": 6,
      "start": 2158.0,
      "end": 2160.0,
      "formatted_start": "00:35:58.000",
      "formatted_end": "00:36:00.000",
      "text": "اوه میگوید"
    },
    {
      "id": 7,
      "start": 2160.0,
      "end": 2162.0,
      "formatted_start": "00:36:00.000",
      "formatted_end": "00:36:02.000",
      "text": "اوه میگوید"
    },
    {
      "id": 8,
      "start": 2162.0,
      "end": 2164.0,
      "formatted_start": "00:36:02.000",
      "formatted_end": "00:36:04.000",
      "text": "اوه میگوید"
    },
    {
      "id": 9,
      "start": 2164.0,
      "end": 2166.0,
      "formatted_start": "00:36:04.000",
      "formatted_end": "00:36:06.000",
      "text": "اوه میگوید"
    },
    {
      "id": 10,
      "start": 2166.0,
      "end": 2168.0,
      "formatted_start": "00:36:06.000",
      "formatted_end": "00:36:08.000",
      "text": "خیلی گرمه بیرون"
    },
    {
      "id": 11,
      "start": 2168.0,
      "end": 2170.0,
      "formatted_start": "00:36:08.000",
      "formatted_end": "00:36:10.000",
      "text": "خیلی گرمه بیرون"
    },
    {
      "id": 12,
      "start": 2170.0,
      "end": 2172.0,
      "formatted_start": "00:36:10.000",
      "formatted_end": "00:36:12.000",
      "text": "اصلا جهنم این روز"
    },
    {
      "id": 13,
      "start": 2172.0,
      "end": 2174.0,
      "formatted_start": "00:36:12.000",
      "formatted_end": "00:36:14.000",
      "text": "اصلا جهنم این روز"
    },
    {
      "id": 14,
      "start": 2174.0,
      "end": 2176.0,
      "formatted_start": "00:36:14.000",
      "formatted_end": "00:36:16.000",
      "text": "خیلی گرمه بیرون"
    },
    {
      "id": 15,
      "start": 2176.0,
      "end": 2178.0,
      "formatted_start": "00:36:16.000",
      "formatted_end": "00:36:18.000",
      "text": "خیلی گرمه بیرون"
    },
    {
      "id": 16,
      "start": 2178.0,
      "end": 2186.0,
      "formatted_start": "00:36:18.000",
      "formatted_end": "00:36:26.000",
      "text": "این جلسه بیمارستان هسته؟"
    },
    {
      "id": 17,
      "start": 2186.0,
      "end": 2188.0,
      "formatted_start": "00:36:26.000",
      "formatted_end": "00:36:28.000",
      "text": "برای همین مجمع و دستاق"
    },
    {
      "id": 18,
      "start": 2188.0,
      "end": 2190.6,
      "formatted_start": "00:36:28.000",
      "formatted_end": "00:36:30.600",
      "text": "نه نه چیز دیگه"
    },
    {
      "id": 19,
      "start": 2190.6,
      "end": 2193.0,
      "formatted_start": "00:36:30.600",
      "formatted_end": "00:36:33.000",
      "text": "برای یک موضوع رو اکنن"
    },
    {
      "id": 20,
      "start": 2208.0,
      "end": 2215.0,
      "formatted_start": "00:36:48.000",
      "formatted_end": "00:36:55.000",
      "text": "موسیقی"
    },
    {
      "id": 21,
      "start": 2238.0,
      "end": 2240.0,
      "formatted_start": "00:37:18.000",
      "formatted_end": "00:37:20.000",
      "text": "گیگار هنوز سی سالت هست."
    },
    {
      "id": 22,
      "start": 2240.0,
      "end": 2244.0,
      "formatted_start": "00:37:20.000",
      "formatted_end": "00:37:24.000",
      "text": "بدن عوض میشه و طوان آدم هم مثل قبل نگهد."
    },
    {
      "id": 23,
      "start": 2244.0,
      "end": 2249.0,
      "formatted_start": "00:37:24.000",
      "formatted_end": "00:37:29.000",
      "text": "از این به بعد آرامش و سلامتی خود باید تو مولویت نگهد."
    },
    {
      "id": 24,
      "start": 2249.0,
      "end": 2254.0,
      "formatted_start": "00:37:29.000",
      "formatted_end": "00:37:34.000",
      "text": "سه بام، نباهاتون رو طوری بزرگ نکن گیگار بچه های خود نسه."
    },
    {
      "id": 25,
      "start": 2254.0,
      "end": 2259.0,
      "formatted_start": "00:37:34.000",
      "formatted_end": "00:37:39.000",
      "text": "دوست داشتنشون را شنگه، اما مسئولیت تربیتشون دیگه با تون بسه."
    },
    {
      "id": 26,
      "start": 2259.0,
      "end": 2264.0,
      "formatted_start": "00:37:39.000",
      "formatted_end": "00:37:44.000",
      "text": "چهارام، فقط باعث اینکه دعوانشه، همیشه سکون نکن."
    },
    {
      "id": 27,
      "start": 2264.0,
      "end": 2270.0,
      "formatted_start": "00:37:44.000",
      "formatted_end": "00:37:50.000",
      "text": "اگر چیزی ناراحت می کنه حرف بزن. اگر چیزی با شب خوب نیست حق و مرزت رو مشترس کن."
    },
    {
      "id": 28,
      "start": 2270.0,
      "end": 2278.0,
      "formatted_start": "00:37:50.000",
      "formatted_end": "00:37:58.000",
      "text": "پنجم، باسه استراحت کردن، بیرون رفتن یا انجام کاری که حالت رو خوب می کنه از کسی می رسد."
    },
    {
      "id": 29,
      "start": 2278.0,
      "end": 2281.0,
      "formatted_start": "00:37:58.000",
      "formatted_end": "00:38:01.000",
      "text": "دنیا وقتی به 60 سالی می رسد."
    },
    {
      "id": 30,
      "start": 2294.0,
      "end": 2322.0,
      "formatted_start": "00:38:14.000",
      "formatted_end": "00:38:42.000",
      "text": "موسیقی"
    },
