  "stt_segments": [
    {
      "id": 0,
      "start": 3900.0,
      "end": 3905.46,
      "formatted_start": "01:05:00.000",
      "formatted_end": "01:05:05.460",
      "text": "این بردارو پدریک کن و بزارش با سرش رو بزارو نداره."
    },
    {
      "id": 1,
      "start": 3905.46,
      "end": 3906.46,
      "formatted_start": "01:05:05.460",
      "formatted_end": "01:05:06.460",
      "text": "این بردارو."
    },
    {
      "id": 2,
      "start": 3906.46,
      "end": 3908.0,
      "formatted_start": "01:05:06.460",
      "formatted_end": "01:05:08.000",
      "text": "گوشاش تکون میده؟"
    },
    {
      "id": 3,
      "start": 3908.0,
      "end": 3909.0,
      "formatted_start": "01:05:08.000",
      "formatted_end": "01:05:09.000",
      "text": "آر خیلی."
    },
    {
      "id": 4,
      "start": 3909.0,
      "end": 3912.0,
      "formatted_start": "01:05:09.000",
      "formatted_end": "01:05:12.000",
      "text": "بعد از گوشا چه، از که اینجوری شده؟"
    },
    {
      "id": 5,
      "start": 3912.0,
      "end": 3914.0,
      "formatted_start": "01:05:12.000",
      "formatted_end": "01:05:14.000",
      "text": "الان یه هفته همش میگوشم."
    },
    {
      "id": 6,
      "start": 3914.0,
      "end": 3917.0,
      "formatted_start": "01:05:14.000",
      "formatted_end": "01:05:17.000",
      "text": "بعد از گوشا چه که ترشوی نداره؟"
    },
    {
      "id": 7,
      "start": 3917.0,
      "end": 3918.0,
      "formatted_start": "01:05:17.000",
      "formatted_end": "01:05:18.000",
      "text": "نه هیچی نداره."
    },
    {
      "id": 8,
      "start": 3918.0,
      "end": 3920.0,
      "formatted_start": "01:05:18.000",
      "formatted_end": "01:05:20.000",
      "text": "گوش راستی یا چپه؟"
    },
    {
      "id": 9,
      "start": 3920.0,
      "end": 3921.0,
      "formatted_start": "01:05:20.000",
      "formatted_end": "01:05:21.000",
      "text": "هر دو تارو میچینم."
    },
    {
      "id": 10,
      "start": 3921.0,
      "end": 3922.0,
      "formatted_start": "01:05:21.000",
      "formatted_end": "01:05:22.000",
      "text": "فرقی نداره."
    },
    {
      "id": 11,
      "start": 3922.0,
      "end": 3924.0,
      "formatted_start": "01:05:22.000",
      "formatted_end": "01:05:24.000",
      "text": "با این برنامه برم گرده بودیم"
    },
    {
      "id": 12,
      "start": 3924.0,
      "end": 3926.0,
      "formatted_start": "01:05:24.000",
      "formatted_end": "01:05:26.000",
      "text": "دست به گوشه هاش هم میزنی؟"
    },
    {
      "id": 13,
      "start": 3926.0,
      "end": 3928.0,
      "formatted_start": "01:05:26.000",
      "formatted_end": "01:05:28.000",
      "text": "آره خیلی دست هاش همه رو گوشه هاش همه"
    },
    {
      "id": 14,
      "start": 3928.0,
      "end": 3930.0,
      "formatted_start": "01:05:28.000",
      "formatted_end": "01:05:30.000",
      "text": "دست هاش همه هر دو گوش میزنی؟"
    },
    {
      "id": 15,
      "start": 3930.0,
      "end": 3932.0,
      "formatted_start": "01:05:30.000",
      "formatted_end": "01:05:32.000",
      "text": "هر دو گوش دست میزنیم"
    },
    {
      "id": 16,
      "start": 3932.0,
      "end": 3934.0,
      "formatted_start": "01:05:32.000",
      "formatted_end": "01:05:34.000",
      "text": "قبل سرما نخورده بوده؟"
    },
    {
      "id": 17,
      "start": 3934.0,
      "end": 3936.0,
      "formatted_start": "01:05:34.000",
      "formatted_end": "01:05:36.000",
      "text": "سرما نخورده بوده"
    },
    {
      "id": 18,
      "start": 3936.0,
      "end": 3938.0,
      "formatted_start": "01:05:36.000",
      "formatted_end": "01:05:38.000",
      "text": "که؟"
    },
    {
      "id": 19,
      "start": 3938.0,
      "end": 3940.0,
      "formatted_start": "01:05:38.000",
      "formatted_end": "01:05:40.000",
      "text": "یه ماه پیش میشه"
    },
    {
      "id": 20,
      "start": 3940.0,
      "end": 3942.0,
      "formatted_start": "01:05:40.000",
      "formatted_end": "01:05:42.000",
      "text": "نه مثلا که در روز یه هفت دقیق"
    },
    {
      "id": 21,
      "start": 3942.0,
      "end": 3944.0,
      "formatted_start": "01:05:42.000",
      "formatted_end": "01:05:44.000",
      "text": "نه دور سرما نخورده بود"
    },
    {
      "id": 22,
      "start": 3944.0,
      "end": 3946.0,
      "formatted_start": "01:05:44.000",
      "formatted_end": "01:05:46.000",
      "text": "چون بعد مثلا یه چند روز قبل"
    },
    {
      "id": 23,
      "start": 3946.0,
      "end": 3948.0,
      "formatted_start": "01:05:46.000",
      "formatted_end": "01:05:48.000",
      "text": "یه ماه پیش بود"
    },
    {
      "id": 24,
      "start": 3948.0,
      "end": 3949.0,
      "formatted_start": "01:05:48.000",
      "formatted_end": "01:05:49.000",
      "text": "نه هیچی نه"
    },
    {
      "id": 25,
      "start": 3949.0,
      "end": 3950.0,
      "formatted_start": "01:05:49.000",
      "formatted_end": "01:05:50.000",
      "text": "باید دست بگوشاش می کنی؟"
    },
    {
      "id": 26,
      "start": 3950.0,
      "end": 3951.0,
      "formatted_start": "01:05:50.000",
      "formatted_end": "01:05:51.000",
      "text": "باید دست شو"
    },
    {
      "id": 27,
      "start": 3951.0,
      "end": 3952.0,
      "formatted_start": "01:05:51.000",
      "formatted_end": "01:05:52.000",
      "text": "می قرارم"
    },
    {
      "id": 28,
      "start": 3952.0,
      "end": 3954.0,
      "formatted_start": "01:05:52.000",
      "formatted_end": "01:05:54.000",
      "text": "سنی چقدر؟"
    },
    {
      "id": 29,
      "start": 3954.0,
      "end": 3956.0,
      "formatted_start": "01:05:54.000",
      "formatted_end": "01:05:56.000",
      "text": "حشتی ماشه باشه تو نه ماه سی هم"
    },
    {
      "id": 30,
      "start": 3956.0,
      "end": 3957.0,
      "formatted_start": "01:05:56.000",
      "formatted_end": "01:05:57.000",
      "text": "نه ماه؟"
    },
    {
      "id": 31,
      "start": 3957.0,
      "end": 3958.0,
      "formatted_start": "01:05:57.000",
      "formatted_end": "01:05:58.000",
      "text": "آره"
    },
    {
      "id": 32,
      "start": 3958.0,
      "end": 3959.0,
      "formatted_start": "01:05:58.000",
      "formatted_end": "01:05:59.000",
      "text": "توی نه ماه تازه رفته"
    },
    {
      "id": 33,
      "start": 3959.0,
      "end": 3961.0,
      "formatted_start": "01:05:59.000",
      "formatted_end": "01:06:01.000",
