  "stt_segments": [
    {
      "id": 0,
      "start": 1200.0,
      "end": 1208.0,
      "formatted_start": "00:20:00.000",
      "formatted_end": "00:20:08.000",
      "text": "از گریه های برنامه دارید."
    },
    {
      "id": 1,
      "start": 1208.0,
      "end": 1216.0,
      "formatted_start": "00:20:08.000",
      "formatted_end": "00:20:16.000",
      "text": "از داروهای برنامه دارید."
    },
    {
      "id": 2,
      "start": 1216.0,
      "end": 1222.0,
      "formatted_start": "00:20:16.000",
      "formatted_end": "00:20:22.000",
      "text": "از گریه های برنامه دارید."
    },
    {
      "id": 3,
      "start": 1222.0,
      "end": 1224.0,
      "formatted_start": "00:20:22.000",
      "formatted_end": "00:20:24.000",
      "text": "این ها خوبیه این رو به نام بگیم"
    },
    {
      "id": 4,
      "start": 1224.0,
      "end": 1226.0,
      "formatted_start": "00:20:24.000",
      "formatted_end": "00:20:26.000",
      "text": "این هم برای نفخشه"
    },
    {
      "id": 5,
      "start": 1226.0,
      "end": 1228.0,
      "formatted_start": "00:20:26.000",
      "formatted_end": "00:20:28.000",
      "text": "خوبه؟ این هم داره بگو"
    },
    {
      "id": 6,
      "start": 1228.0,
      "end": 1230.0,
      "formatted_start": "00:20:28.000",
      "formatted_end": "00:20:30.000",
      "text": "خب اون هم برای نفخ و درپیچ هست"
    },
    {
      "id": 7,
      "start": 1230.0,
      "end": 1232.0,
      "formatted_start": "00:20:30.000",
      "formatted_end": "00:20:32.000",
      "text": "خب الان من ببینم"
    },
    {
      "id": 8,
      "start": 1232.0,
      "end": 1234.0,
      "formatted_start": "00:20:32.000",
      "formatted_end": "00:20:34.000",
      "text": "یه اسپریمی نویستم"
    },
    {
      "id": 9,
      "start": 1234.0,
      "end": 1236.0,
      "formatted_start": "00:20:34.000",
      "formatted_end": "00:20:36.000",
      "text": "تو بینیش میزنید"
    },
    {
      "id": 10,
      "start": 1236.0,
      "end": 1238.0,
      "formatted_start": "00:20:36.000",
      "formatted_end": "00:20:38.000",
      "text": "و از اینها انتهای بینی گرفتیدی"
    },
    {
      "id": 11,
      "start": 1238.0,
      "end": 1240.0,
      "formatted_start": "00:20:38.000",
      "formatted_end": "00:20:40.000",
      "text": "میده بچه هم نفس خوب"
    },
    {
      "id": 12,
      "start": 1240.0,
      "end": 1242.0,
      "formatted_start": "00:20:40.000",
      "formatted_end": "00:20:42.000",
      "text": "بزنواچیز میده ولی گلوشو"
    },
    {
      "id": 13,
      "start": 1242.0,
      "end": 1244.0,
      "formatted_start": "00:20:42.000",
      "formatted_end": "00:20:44.000",
      "text": "سینهشو اینا خوبه خوب"
    },
    {
      "id": 14,
      "start": 1244.0,
      "end": 1246.0,
      "formatted_start": "00:20:44.000",
      "formatted_end": "00:20:46.000",
      "text": "یه این ها خودتون هم ترسیدید"
    },
    {
      "id": 15,
      "start": 1246.0,
      "end": 1248.0,
      "formatted_start": "00:20:46.000",
      "formatted_end": "00:20:48.000",
      "text": "هر صدید بچه رو"
    },
    {
      "id": 16,
      "start": 1248.0,
      "end": 1254.0,
      "formatted_start": "00:20:48.000",
      "formatted_end": "00:20:54.000",
      "text": "میترکید اینجوریه هم خودم از بین دارید هم بچه هم هم پدر بچه"
    },
    {
      "id": 17,
      "start": 1254.0,
      "end": 1258.0,
      "formatted_start": "00:20:54.000",
      "formatted_end": "00:20:58.000",
      "text": "خب اونو امینی"
    },
    {
      "id": 18,
      "start": 1258.0,
      "end": 1262.0,
      "formatted_start": "00:20:58.000",
      "formatted_end": "00:21:02.000",
      "text": "امینی را خب"
    },
    {
      "id": 19,
      "start": 1262.0,
      "end": 1266.0,
      "formatted_start": "00:21:02.000",
      "formatted_end": "00:21:06.000",
      "text": "این داروش آزاده این یه اسپریه رینو"
    },
    {
      "id": 20,
      "start": 1266.0,
      "end": 1270.0,
      "formatted_start": "00:21:06.000",
      "formatted_end": "00:21:10.000",
      "text": "سالتینه خب"
    },
    {
      "id": 21,
      "start": 1270.0,
      "end": 1274.0,
      "formatted_start": "00:21:10.000",
      "formatted_end": "00:21:14.000",
      "text": "این را بیادین ببینم خب داروی دیگه نیاز نیست"
    },
    {
      "id": 22,
      "start": 1274.0,
      "end": 1276.0,
      "formatted_start": "00:21:14.000",
      "formatted_end": "00:21:16.000",
      "text": "آنتی بی تیک و دارونی میخوان بشونند"
    },
    {
      "id": 23,
      "start": 1276.0,
      "end": 1277.0,
      "formatted_start": "00:21:16.000",
      "formatted_end": "00:21:17.000",
      "text": "این چیه؟"
    },
    {
      "id": 24,
      "start": 1277.0,
      "end": 1278.0,
      "formatted_start": "00:21:17.000",
      "formatted_end": "00:21:18.000",
      "text": "این رو بده اینها اشکال نداره"
    },
    {
      "id": 25,
      "start": 1278.0,
      "end": 1279.0,
      "formatted_start": "00:21:18.000",
      "formatted_end": "00:21:19.000",
      "text": "این ها سرما خوده بود"
    },
    {
      "id": 26,
      "start": 1279.0,
      "end": 1282.0,
      "formatted_start": "00:21:19.000",
      "formatted_end": "00:21:22.000",
      "text": "بله این پنج روزی هفته بده این هم که برای نفخشه"
    },
    {
      "id": 27,
      "start": 1282.0,
      "end": 1283.0,
      "formatted_start": "00:21:22.000",
      "formatted_end": "00:21:23.000",
      "text": "مثلا چطوری بود این تنیب؟"
    },
    {
      "id": 28,
      "start": 1283.0,
      "end": 1287.0,
      "formatted_start": "00:21:23.000",
      "formatted_end": "00:21:27.000",
      "text": "این رو روزی سه بار هشت کسرفه کنانه بشتو بودم که اش میدید"
    },
    {
      "id": 29,
      "start": 1287.0,
      "end": 1289.0,
      "formatted_start": "00:21:27.000",
      "formatted_end": "00:21:29.000",
      "text": "من همینه خود سرما خوده بودم"
    },
    {
      "id": 30,
      "start": 1289.0,
      "end": 1290.0,
      "formatted_start": "00:21:29.000",
      "formatted_end": "00:21:30.000",
      "text": "خادمان؟"
    },
    {
      "id": 31,
      "start": 1290.0,
      "end": 1291.0,
      "formatted_start": "00:21:30.000",
      "formatted_end": "00:21:31.000",
      "text": "نه"
    },
    {
      "id": 32,
      "start": 1291.0,
      "end": 1293.0,
      "formatted_start": "00:21:31.000",
      "formatted_end": "00:21:33.000",
      "text": "این زوره بله ما بگم سرما خوده"
    },
    {
      "id": 33,
      "start": 1293.0,
      "end": 1294.0,
      "formatted_start": "00:21:33.000",
      "formatted_end": "00:21:34.000",
      "text": "نه نه دکتوری امام"
    },
    {
      "id": 34,
      "start": 1294.0,
      "end": 1295.0,
      "formatted_start": "00:21:34.000",
      "formatted_end": "00:21:35.000",
      "text": "ببین خادمان"
    },
    {
      "id": 35,
      "start": 1295.0,
      "end": 1301.58,
      "formatted_start": "00:21:35.000",
      "formatted_end": "00:21:41.580",
      "text": "ای این سرما خورده، این دنبال خورده، اصلا گلوش، سینش، دفتر تو خوابت هم میبوره"
    },
    {
      "id": 36,
      "start": 1301.58,
      "end": 1302.68,
      "formatted_start": "00:21:41.580",
      "formatted_end": "00:21:42.680",
      "text": "خب؟"
    },
    {
      "id": 37,
      "start": 1302.68,
      "end": 1307.68,
      "formatted_start": "00:21:42.680",
      "formatted_end": "00:21:47.680",
      "text": "الان بگو دختر متواجه نشد، افتاده باشید چی نیست باید بگو، اگه چی هستم آقا؟"
    },
    {
      "id": 38,
      "start": 1307.68,
      "end": 1310.88,
      "formatted_start": "00:21:47.680",
      "formatted_end": "00:21:50.880",
      "text": "من میدونم اینجوری میکنه، یه جوری هست"
    },
    {
      "id": 39,
      "start": 1310.88,
      "end": 1318.24,
      "formatted_start": "00:21:50.880",
      "formatted_end": "00:21:58.240",
      "text": "خب؟ باید میره تو مخه، تو مخه، پولتو بیادی به من میدی، میبری، برو بر میدی، دارو میدی، آخرم میدی، خم شده"
    },
    {
      "id": 40,
      "start": 1318.24,
      "end": 1320.24,
      "formatted_start": "00:21:58.240",
      "formatted_end": "00:22:00.240",
      "text": "اما اینجا میشه اینجا باید برام"
    },
    {
      "id": 41,
      "start": 1320.24,
      "end": 1322.24,
      "formatted_start": "00:22:00.240",
      "formatted_end": "00:22:02.240",
      "text": "خب پس من برای خودت میگم"
    },
    {
      "id": 42,
      "start": 1322.24,
      "end": 1324.24,
      "formatted_start": "00:22:02.240",
      "formatted_end": "00:22:04.240",
      "text": "اگر من میتونم یک نسخه یه"
    },
    {
      "id": 43,
      "start": 1324.24,
      "end": 1326.24,
      "formatted_start": "00:22:04.240",
      "formatted_end": "00:22:06.240",
      "text": "این نوستم بگیر دو سه میلیون ایشات بگیر"
    },
    {
      "id": 44,
      "start": 1326.24,
      "end": 1328.24,
      "formatted_start": "00:22:06.240",
      "formatted_end": "00:22:08.240",
      "text": "آخرم میشه"
    },
    {
      "id": 45,
      "start": 1328.24,
      "end": 1330.24,
      "formatted_start": "00:22:08.240",
      "formatted_end": "00:22:10.240",
      "text": "برای من نوشته کاری نداره"
    },
    {
      "id": 46,
      "start": 1330.24,
      "end": 1332.24,
      "formatted_start": "00:22:10.240",
      "formatted_end": "00:22:12.240",
      "text": "آره امروز سه دفعه"
    },
    {
      "id": 47,
      "start": 1332.24,
      "end": 1334.24,
      "formatted_start": "00:22:12.240",
      "formatted_end": "00:22:14.240",
      "text": "چیز کن"
    },
    {
      "id": 48,
      "start": 1334.24,
      "end": 1336.24,
      "formatted_start": "00:22:14.240",
      "formatted_end": "00:22:16.240",
      "text": "تازه اگر هم سرماوه بخوره"
    },
    {
      "id": 49,
      "start": 1336.24,
      "end": 1338.24,
      "formatted_start": "00:22:16.240",
      "formatted_end": "00:22:18.240",
      "text": "شبت"
    },
    {
      "id": 50,
      "start": 1338.24,
      "end": 1340.24,
      "formatted_start": "00:22:18.240",
      "formatted_end": "00:22:20.240",
      "text": "سه چار تا چیزو با هم داره"
    },
    {
      "id": 51,
      "start": 1340.24,
      "end": 1342.24,
      "formatted_start": "00:22:20.240",
      "formatted_end": "00:22:22.240",
      "text": "متوجه شده"
    },
    {
      "id": 52,
      "start": 1342.24,
      "end": 1344.24,
      "formatted_start": "00:22:22.240",
      "formatted_end": "00:22:24.240",
      "text": "چند تا داروی تکییدیه"
    },
    {
      "id": 53,
      "start": 1344.24,
      "end": 1346.24,
      "formatted_start": "00:22:24.240",
      "formatted_end": "00:22:26.240",
      "text": "کامل پوششون"
    },
    {
      "id": 54,
      "start": 1346.24,
      "end": 1350.24,
      "formatted_start": "00:22:26.240",
      "formatted_end": "00:22:30.240",
      "text": "یک بچه یک زمانی سرما خورده بود و چی شد؟"
    },
    {
      "id": 55,
      "start": 1350.24,
      "end": 1351.24,
      "formatted_start": "00:22:30.240",
      "formatted_end": "00:22:31.240",
      "text": "فوت"
    },
    {
      "id": 56,
      "start": 1351.24,
      "end": 1352.24,
      "formatted_start": "00:22:31.240",
      "formatted_end": "00:22:32.240",
      "text": "فوت کرد"
    },
    {
      "id": 57,
      "start": 1352.24,
      "end": 1355.24,
      "formatted_start": "00:22:32.240",
      "formatted_end": "00:22:35.240",
      "text": "شما یک بچه سرما خورده یک زمانی فوت کرده"
    },
    {
      "id": 58,
      "start": 1355.24,
      "end": 1356.24,
      "formatted_start": "00:22:35.240",
      "formatted_end": "00:22:36.240",
      "text": "الان چشمه ترسیده"
    },
    {
      "id": 59,
      "start": 1356.24,
      "end": 1359.24,
      "formatted_start": "00:22:36.240",
      "formatted_end": "00:22:39.240",
      "text": "مارگزیده میگه ریسمان سیاستیفید میترسه"
    },
    {
      "id": 60,
      "start": 1359.24,
      "end": 1361.24,
      "formatted_start": "00:22:39.240",
      "formatted_end": "00:22:41.240",
      "text": "که الان مارگزیده شده"
    },
    {
      "id": 61,
      "start": 1361.24,
      "end": 1364.24,
      "formatted_start": "00:22:41.240",
      "formatted_end": "00:22:44.240",
      "text": "الان همش وحشت دارید بچه هم اتص نره"
    },
    {
      "id": 62,
      "start": 1364.24,
      "end": 1366.24,
      "formatted_start": "00:22:44.240",
      "formatted_end": "00:22:46.240",
      "text": "بسیار بچه هم سرما خورده اینم نشه"
    },
    {
      "id": 63,
      "start": 1366.24,
      "end": 1367.24,
      "formatted_start": "00:22:46.240",
      "formatted_end": "00:22:47.240",
      "text": "زود دکتر داره"
    },
    {
      "id": 64,
      "start": 1367.24,
      "end": 1370.24,
      "formatted_start": "00:22:47.240",
      "formatted_end": "00:22:50.240",
      "text": "یک کنک آوردم اینجا بعد زیر"
    },
    {
      "id": 65,
      "start": 1370.24,
      "end": 1371.24,
      "formatted_start": "00:22:50.240",
      "formatted_end": "00:22:51.240",
      "text": "که بسایی رفتم کنم"
    },
    {
      "id": 66,
      "start": 1371.24,
      "end": 1401.24,
      "formatted_start": "00:22:51.240",
      "formatted_end": "00:23:21.240",
      "text": "از اینجا باید برداریم که باید برداریم که باید برداریم که باید برداریم که باید برداریم که باید برداریم که باید برداریم که باید برداریم که باید برداریم که باید برداریم که باید برداریم که باید برداریم که باید برداریم که باید برداریم که باید برداریم که باید برداریم که باید برداریم که باید برداریم که ب"
    },
    {
      "id": 67,
      "start": 1401.24,
      "end": 1407.24,
      "formatted_start": "00:23:21.240",
      "formatted_end": "00:23:27.240",
      "text": "این را به رست شما دکتر گفت که چرا انتریم می کنیم؟ اون امال خدا را بیده دیگه"
    },
    {
      "id": 68,
      "start": 1407.24,
      "end": 1409.24,
      "formatted_start": "00:23:27.240",
      "formatted_end": "00:23:29.240",
      "text": "اینکه همه شیره نیست"
    },
    {
      "id": 69,
      "start": 1409.24,
      "end": 1414.24,
      "formatted_start": "00:23:29.240",
      "formatted_end": "00:23:34.240",
      "text": "باید اینجا بینوستین چند روز بیدن؟"
    },
    {
      "id": 70,
      "start": 1414.24,
      "end": 1416.24,
      "formatted_start": "00:23:34.240",
      "formatted_end": "00:23:36.240",
      "text": "تا پنج روز"
    },
    {
      "id": 71,
      "start": 1416.24,
      "end": 1422.24,
      "formatted_start": "00:23:36.240",
      "formatted_end": "00:23:42.240",
      "text": "برو از این کتاب هم وقتی بیرون، بگیم اینها فکر نداره"
    },
    {
      "id": 72,
      "start": 1422.24,
      "end": 1424.24,
      "formatted_start": "00:23:42.240",
      "formatted_end": "00:23:44.240",
      "text": "خدا خودشی بخواد نگردی میداره"
    },
    {
      "id": 73,
      "start": 1424.24,
      "end": 1426.24,
      "formatted_start": "00:23:44.240",
      "formatted_end": "00:23:46.240",
      "text": "دستگاه نگردی"
    },
    {
      "id": 74,
      "start": 1426.24,
      "end": 1428.24,
      "formatted_start": "00:23:46.240",
      "formatted_end": "00:23:48.240",
      "text": "نه خانصبی یه اسپلی داره؟"
    },
    {
      "id": 75,
      "start": 1428.24,
      "end": 1430.24,
      "formatted_start": "00:23:48.240",
      "formatted_end": "00:23:50.240",
      "text": "نه میخواد بخواد بخواد"
    },
    {
      "id": 76,
      "start": 1430.24,
      "end": 1432.24,
      "formatted_start": "00:23:50.240",
      "formatted_end": "00:23:52.240",
      "text": "بخواد بخواد بخواد"
    },
    {
      "id": 77,
      "start": 1432.24,
      "end": 1434.24,
      "formatted_start": "00:23:52.240",
      "formatted_end": "00:23:54.240",
      "text": "بخواد بخواد"
    },
    {
      "id": 78,
      "start": 1434.24,
      "end": 1436.24,
      "formatted_start": "00:23:54.240",
      "formatted_end": "00:23:56.240",
      "text": "بخواد بخواد"
    },
    {
      "id": 79,
      "start": 1436.24,
      "end": 1438.24,
      "formatted_start": "00:23:56.240",
      "formatted_end": "00:23:58.240",
      "text": "بخواد بخواد"
    },
    {
      "id": 80,
      "start": 1438.24,
      "end": 1440.24,
      "formatted_start": "00:23:58.240",
      "formatted_end": "00:24:00.240",
      "text": "بخواد بخواد"
    },
    {
      "id": 81,
      "start": 1440.24,
      "end": 1442.24,
      "formatted_start": "00:24:00.240",
      "formatted_end": "00:24:02.240",
      "text": "بخواد بخواد"
    },
    {
      "id": 82,
      "start": 1442.24,
      "end": 1444.24,
      "formatted_start": "00:24:02.240",
      "formatted_end": "00:24:04.240",
      "text": "بخواد بخواد"
    },
    {
      "id": 83,
      "start": 1444.24,
      "end": 1446.24,
      "formatted_start": "00:24:04.240",
      "formatted_end": "00:24:06.240",
      "text": "بخواد بخواد"
    },
    {
      "id": 84,
      "start": 1446.24,
      "end": 1448.24,
      "formatted_start": "00:24:06.240",
      "formatted_end": "00:24:08.240",
      "text": "بخواد بخواد"
    },
    {
      "id": 85,
      "start": 1448.24,
      "end": 1450.24,
      "formatted_start": "00:24:08.240",
      "formatted_end": "00:24:10.240",
      "text": "بخواد بخواد"
    },
    {
      "id": 86,
      "start": 1450.24,
      "end": 1454.96,
      "formatted_start": "00:24:10.240",
      "formatted_end": "00:24:14.960",
      "text": "بله؟ یه اسپیلی رینوسالتینه دیگه، قیمت نداره"
    },
    {
      "id": 87,
      "start": 1454.96,
      "end": 1455.6,
      "formatted_start": "00:24:14.960",
      "formatted_end": "00:24:15.600",
      "text": "توی توی رو"
    },
    {
      "id": 88,
      "start": 1455.6,
      "end": 1456.1,
      "formatted_start": "00:24:15.600",
      "formatted_end": "00:24:16.100",
      "text": "جانم"
    },
    {
      "id": 89,
      "start": 1456.1,
      "end": 1458.48,
      "formatted_start": "00:24:16.100",
      "formatted_end": "00:24:18.480",
      "text": "خب، از اسپیلی روند شده کنم"
    },
    {
      "id": 90,
      "start": 1458.48,
      "end": 1459.48,
      "formatted_start": "00:24:18.480",
      "formatted_end": "00:24:19.480",
      "text": "بله، بسیار بله"
    },
    {
      "id": 91,
      "start": 1459.48,
      "end": 1460.44,
      "formatted_start": "00:24:19.480",
      "formatted_end": "00:24:20.440",
      "text": "سلامت باشیم"
    },
    {
      "id": 92,
      "start": 1460.44,
      "end": 1463.94,
      "formatted_start": "00:24:20.440",
      "formatted_end": "00:24:23.940",
      "text": "آزمایش دادم، دوری نگاهی میکنیم"
    },
    {
      "id": 93,
      "start": 1463.94,
      "end": 1464.32,
      "formatted_start": "00:24:23.940",
      "formatted_end": "00:24:24.320",
      "text": "بله"
    },
    {
      "id": 94,
      "start": 1464.32,
      "end": 1467.4,
      "formatted_start": "00:24:24.320",
      "formatted_end": "00:24:27.400",
      "text": "که تخون آزاشید و اونه، خب"
    },
    {
      "id": 95,
      "start": 1467.4,
      "end": 1467.84,
      "formatted_start": "00:24:27.400",
      "formatted_end": "00:24:27.840",
      "text": "ببینیم که"
    },
    {
      "id": 96,
      "start": 1467.84,
      "end": 1470.92,
      "formatted_start": "00:24:27.840",
      "formatted_end": "00:24:30.920",
      "text": "خب، از این بزرگ خدمتتون که"
    },
    {
      "id": 97,
      "start": 1470.92,
      "end": 1472.26,
      "formatted_start": "00:24:30.920",
      "formatted_end": "00:24:32.260",
      "text": "اسپیلی روند شده کنیم"
    },
    {
      "id": 98,
      "start": 1472.26,
      "end": 1473.26,
      "formatted_start": "00:24:32.260",
      "formatted_end": "00:24:33.260",
      "text": "نیرانتزامی"
    },
    {
      "id": 99,
      "start": 1473.26,
      "end": 1475.94,
      "formatted_start": "00:24:33.260",
      "formatted_end": "00:24:35.940",
      "text": "نیرانتزامی، همه ترسیدی از این آزمایش"
    },
    {
      "id": 100,
      "start": 1475.94,
      "end": 1478.94,
      "formatted_start": "00:24:35.940",
      "formatted_end": "00:24:38.940",
      "text": "خواهد داشت خودش تو نیرو هست"
    },
    {
      "id": 101,
      "start": 1478.94,
      "end": 1481.94,
      "formatted_start": "00:24:38.940",
      "formatted_end": "00:24:41.940",
      "text": "یا تو آزمایشگاه هم هست اتفاق"
    },
    {
      "id": 102,
      "start": 1481.94,
      "end": 1484.94,
      "formatted_start": "00:24:41.940",
      "formatted_end": "00:24:44.940",
      "text": "ولی این آزمایشگاه رو بگیره حتی یک دونه نه"
    },
    {
      "id": 103,
      "start": 1484.94,
      "end": 1485.94,
      "formatted_start": "00:24:44.940",
      "formatted_end": "00:24:45.940",
      "text": "برای پایین گوشت هست"
    },
    {
      "id": 104,
      "start": 1485.94,
      "end": 1487.94,
      "formatted_start": "00:24:45.940",
      "formatted_end": "00:24:47.940",
      "text": "ببین این قلزت نرمالش"
    },
