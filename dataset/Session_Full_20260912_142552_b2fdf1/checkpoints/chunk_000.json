  ],
  "stt_segments": [
    {
      "id": 0,
      "start": 0.0,
      "end": 26.0,
      "formatted_start": "00:00:00.000",
      "formatted_end": "00:00:26.000",
      "text": "برگر رو بیمار دید، مثل آی محمد زاده، دختر رو برمانه."
    },
    {
      "id": 1,
      "start": 26.0,
      "end": 30.0,
      "formatted_start": "00:00:26.000",
      "formatted_end": "00:00:30.000",
      "text": "چی شده دختر برو بفهم میخوایش میده"
    },
    {
      "id": 2,
      "start": 30.0,
      "end": 32.0,
      "formatted_start": "00:00:30.000",
      "formatted_end": "00:00:32.000",
      "text": "بعد دیشب تب میکنه"
    },
    {
      "id": 3,
      "start": 32.0,
      "end": 34.0,
      "formatted_start": "00:00:32.000",
      "formatted_end": "00:00:34.000",
      "text": "تب کرده"
    },
    {
      "id": 4,
      "start": 34.0,
      "end": 36.0,
      "formatted_start": "00:00:34.000",
      "formatted_end": "00:00:36.000",
      "text": "بعد چند شبه"
    },
    {
      "id": 5,
      "start": 36.0,
      "end": 40.0,
      "formatted_start": "00:00:36.000",
      "formatted_end": "00:00:40.000",
      "text": "این قسمت های گردن، صورت، بیر این قسمت ها"
    },
    {
      "id": 6,
      "start": 40.0,
      "end": 44.0,
      "formatted_start": "00:00:40.000",
      "formatted_end": "00:00:44.000",
      "text": "بعد به پایین خنکه، اینجا کلن تب بالا"
    },
    {
      "id": 7,
      "start": 44.0,
      "end": 47.0,
      "formatted_start": "00:00:44.000",
      "formatted_end": "00:00:47.000",
      "text": "بعد حالا ده ناشن مد"
    },
    {
      "id": 8,
      "start": 47.0,
      "end": 50.0,
      "formatted_start": "00:00:47.000",
      "formatted_end": "00:00:50.000",
      "text": "آرپیس جو بینین گهگاهی داره"
    },
    {
      "id": 9,
      "start": 50.0,
      "end": 52.0,
      "formatted_start": "00:00:50.000",
      "formatted_end": "00:00:52.000",
      "text": "کارت رفلس دست همون برشی کمش هست"
    },
    {
      "id": 10,
      "start": 52.0,
      "end": 55.0,
      "formatted_start": "00:00:52.000",
      "formatted_end": "00:00:55.000",
      "text": "یه آقو میزنه و اشان سیمه میره جلو برم میگرده"
    },
    {
      "id": 11,
      "start": 55.0,
      "end": 61.0,
      "formatted_start": "00:00:55.000",
      "formatted_end": "00:01:01.000",
      "text": "گاهی هم میاد گالا گرد میده و از اینجور هم میرده"
    },
    {
      "id": 12,
      "start": 61.0,
      "end": 65.0,
      "formatted_start": "00:01:01.000",
      "formatted_end": "00:01:05.000",
      "text": "روی زبونش هم سریفیدک زده بروشی گردش داره"
    },
    {
      "id": 13,
      "start": 65.0,
      "end": 67.0,
      "formatted_start": "00:01:05.000",
      "formatted_end": "00:01:07.000",
      "text": "روی کف زبونه؟"
    },
    {
      "id": 14,
      "start": 67.0,
      "end": 68.0,
      "formatted_start": "00:01:07.000",
      "formatted_end": "00:01:08.000",
      "text": "آره"
    },
    {
      "id": 15,
      "start": 68.0,
      "end": 69.0,
      "formatted_start": "00:01:08.000",
      "formatted_end": "00:01:09.000",
      "text": "پاش هم زده"
    },
    {
      "id": 16,
      "start": 69.0,
      "end": 70.0,
      "formatted_start": "00:01:09.000",
      "formatted_end": "00:01:10.000",
      "text": "نه روی کفش"
    },
    {
      "id": 17,
      "start": 70.0,
      "end": 74.0,
      "formatted_start": "00:01:10.000",
      "formatted_end": "00:01:14.000",
      "text": "پس ده ماهشه تب کرده اینجور آب ریزش داره"
    },
    {
      "id": 18,
      "start": 74.0,
      "end": 80.0,
      "formatted_start": "00:01:14.000",
      "formatted_end": "00:01:20.000",
      "text": "بلا به بعد برخیر اینجور سینه شم که فهمیدید که عادت خسخس داره"
    },
    {
      "id": 19,
      "start": 80.0,
      "end": 82.0,
      "formatted_start": "00:01:20.000",
      "formatted_end": "00:01:22.000",
      "text": "و داروی چیزی هم بشده دی؟"
    },
    {
      "id": 20,
      "start": 82.0,
      "end": 86.0,
      "formatted_start": "00:01:22.000",
      "formatted_end": "00:01:26.000",
      "text": "دوره یکمان استامینوفن میریم با دینتاکیل دوره"
    },
    {
      "id": 21,
      "start": 86.0,
      "end": 90.0,
      "formatted_start": "00:01:26.000",
      "formatted_end": "00:01:30.000",
      "text": "این دندونشه و میرونن طبش بند نمیان پرسید"
    },
    {
      "id": 22,
      "start": 90.0,
      "end": 92.0,
      "formatted_start": "00:01:30.000",
      "formatted_end": "00:01:32.000",
      "text": "این هم عمولا طبای ویروسیه"
    },
    {
      "id": 23,
      "start": 92.0,
      "end": 95.0,
      "formatted_start": "00:01:32.000",
      "formatted_end": "00:01:35.000",
      "text": "یعنی دندون یک طب خفیف میده"
    },
    {
      "id": 24,
      "start": 95.0,
      "end": 98.0,
      "formatted_start": "00:01:35.000",
      "formatted_end": "00:01:38.000",
      "text": "در تایی چند دقیقه بخشید"
    },
    {
      "id": 25,
      "start": 98.0,
      "end": 100.0,
      "formatted_start": "00:01:38.000",
      "formatted_end": "00:01:40.000",
      "text": "دوست و ساعت یعنی خوب میشه"
    },
    {
      "id": 26,
      "start": 100.0,
      "end": 102.0,
