      "formatted_start": "01:35:30.000",
      "formatted_end": "01:35:59.980",
      "text": "موسیقی در موسیقی درسته"
    },
    {
      "id": 2,
      "start": 5760.0,
      "end": 5774.0,
      "formatted_start": "01:36:00.000",
      "formatted_end": "01:36:14.000",
      "text": "موسیقی"
    },
    {
      "id": 3,
      "start": 5790.0,
      "end": 5796.0,
      "formatted_start": "01:36:30.000",
      "formatted_end": "01:36:36.000",
      "text": "غزا غزا هیریستن"
    },
    {
      "id": 4,
      "start": 5796.0,
      "end": 5801.0,
      "formatted_start": "01:36:36.000",
      "formatted_end": "01:36:41.000",
      "text": "قرار خاطر به سپان"
    },
    {
      "id": 5,
      "start": 5801.0,
      "end": 5807.0,
      "formatted_start": "01:36:41.000",
      "formatted_end": "01:36:47.000",
      "text": "لعظه براق زخط بخان"
    },
    {
      "id": 6,
      "start": 5807.0,
      "end": 5812.0,
      "formatted_start": "01:36:47.000",
      "formatted_end": "01:36:52.000",
      "text": "درستیه مرا به نین"
    },
    {
      "id": 7,
      "start": 5812.0,
      "end": 5817.0,
      "formatted_start": "01:36:52.000",
      "formatted_end": "01:36:57.000",
      "text": "در این زمانی غران"
    },
    {
      "id": 8,
      "start": 5817.0,
      "end": 5824.72,
      "formatted_start": "01:36:57.000",
      "formatted_end": "01:37:04.720",
      "text": "عقیبتی برامی میره"
    },
    {
      "id": 9,
      "start": 5824.72,
      "end": 5829.1,
      "formatted_start": "01:37:04.720",
      "formatted_end": "01:37:09.100",
      "text": "در این زمانیه بند"
    },
    {
      "id": 10,
      "start": 5847.0,
      "end": 5869.0,
      "formatted_start": "01:37:27.000",
      "formatted_end": "01:37:49.000",
      "text": "موسیقی"
    },
    {
      "id": 11,
      "start": 5869.0,
      "end": 5878.0,
      "formatted_start": "01:37:49.000",
      "formatted_end": "01:37:58.000",
      "text": "خوب مرا نگاه کن توی تمام دیدانم"
    },
    {
      "id": 12,
      "start": 5878.0,
      "end": 5887.0,
      "formatted_start": "01:37:58.000",
      "formatted_end": "01:38:07.000",
      "text": "خوبم اگر یا که بعدم دروت نیستم منم"
    },
    {
      "id": 13,
      "start": 5887.0,
      "end": 5897.0,
      "formatted_start": "01:38:07.000",
      "formatted_end": "01:38:17.000",
      "text": "مرا که پشت پاسدم برا و روزمان"
    },
    {
      "id": 14,
      "start": 5897.0,
      "end": 5901.82,
      "formatted_start": "01:38:17.000",
      "formatted_end": "01:38:21.820",
      "text": "اگر که عاشقی یا یاد"
    },
    {
      "id": 15,
      "start": 5901.82,
      "end": 5905.88,
      "formatted_start": "01:38:21.820",
      "formatted_end": "01:38:25.880",
      "text": "مرا به خاطر دست برم"
    },
    {
      "id": 16,
      "start": 5905.88,
      "end": 5910.86,
      "formatted_start": "01:38:25.880",
      "formatted_end": "01:38:30.860",
      "text": "اگر که دل سختی"
    },
    {
      "id": 17,
      "start": 5910.86,
      "end": 5914.82,
      "formatted_start": "01:38:30.860",
      "formatted_end": "01:38:34.820",
      "text": "با تو قریب نیستم"
    },
    {
      "id": 18,
      "start": 5914.82,
      "end": 5918.12,
      "formatted_start": "01:38:34.820",
      "formatted_end": "01:38:38.120",
      "text": "که با تو بغض اشنا"
    },
    {
      "id": 19,
      "start": 5918.12,
      "end": 5922.56,
      "formatted_start": "01:38:38.120",
      "formatted_end": "01:38:42.560",
      "text": "غزل غزل گریستم"
    },
    {
      "id": 20,
      "start": 5922.56,
      "end": 5926.22,
      "formatted_start": "01:38:42.560",
      "formatted_end": "01:38:46.220",
      "text": "مرا به خاطر دست برم"
    },
    {
      "id": 21,
      "start": 5926.22,
      "end": 5930.3,
      "formatted_start": "01:38:46.220",
      "formatted_end": "01:38:50.300",
      "text": "لحظه به لحظه خط به خط"
    },
    {
      "id": 22,
      "start": 5930.3,
      "end": 5934.5,
      "formatted_start": "01:38:50.300",
      "formatted_end": "01:38:54.500",
      "text": "درستی مرا ببینیم"
    },
    {
      "id": 23,
      "start": 5934.5,
      "end": 5937.32,
      "formatted_start": "01:38:54.500",
      "formatted_end": "01:38:57.320",
      "text": "در این زمانه قدم"
    },
    {
      "id": 24,
