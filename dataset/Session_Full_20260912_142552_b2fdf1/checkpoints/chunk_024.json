  "stt_segments": [
    {
      "id": 0,
      "start": 7200.0,
      "end": 7208.56,
      "formatted_start": "02:00:00.000",
      "formatted_end": "02:00:08.560",
      "text": "وکیلت کیه؟ بون وکیلت اسمس بده، پیام بده، بگو اینا رو بینویسه. خودشون رای بدن. رایشون را واقعا رکنن."
    },
    {
      "id": 1,
      "start": 7208.56,
      "end": 7214.24,
      "formatted_start": "02:00:08.560",
      "formatted_end": "02:00:14.240",
      "text": "من خواهند گفت که ما که نمیشناسیم، مثلا وکیل همون دکتر پاشایی فرق بود، دیگه این روی نمیگن."
    },
    {
      "id": 2,
      "start": 7214.24,
      "end": 7218.4,
      "formatted_start": "02:00:14.240",
      "formatted_end": "02:00:18.400",
      "text": "ببین پاشایی یه مدار اینجا از این موقعیتاش داره استفاده میکنه."
    },
    {
      "id": 3,
      "start": 7218.4,
      "end": 7221.76,
      "formatted_start": "02:00:18.400",
      "formatted_end": "02:00:21.760",
      "text": "آره دیگه همیشه همین بوده دیگه. تو این سالها همش نمیدون."
    },
    {
      "id": 4,
      "start": 7221.76,
      "end": 7224.26,
      "formatted_start": "02:00:21.760",
      "formatted_end": "02:00:24.260",
      "text": "ببین اگر چیزاش قیچی بشه"
    },
    {
      "id": 5,
      "start": 7224.28,
      "end": 7228.82,
      "formatted_start": "02:00:24.280",
      "formatted_end": "02:00:28.820",
      "text": "بکنید امشب میشه قیچی کرد وقتی فکر کنم الان وکالت حال گرفته دیگه"
    },
    {
      "id": 6,
      "start": 7228.84,
      "end": 7234.06,
      "formatted_start": "02:00:28.840",
      "formatted_end": "02:00:34.060",
      "text": "اون گرفته ولی شما رایاتونو بدیم در انتها بگیم این وکالت سیستمش موجوده"
    },
    {
      "id": 7,
      "start": 7234.08,
      "end": 7237.12,
      "formatted_start": "02:00:34.080",
      "formatted_end": "02:00:37.120",
      "text": "ما عوض کنیم یعنی اساسنامه را تغییر بدیم"
    },
    {
      "id": 8,
      "start": 7237.14,
      "end": 7241.14,
      "formatted_start": "02:00:37.140",
      "formatted_end": "02:00:41.140",
      "text": "اگر اینجوری باشه اینا با این اساسنامه همینه"
    },
    {
      "id": 9,
      "start": 7241.16,
      "end": 7242.44,
      "formatted_start": "02:00:41.160",
      "formatted_end": "02:00:42.440",
      "text": "همین همین بوده"
    },
    {
      "id": 10,
      "start": 7242.46,
      "end": 7246.16,
      "formatted_start": "02:00:42.460",
      "formatted_end": "02:00:46.160",
      "text": "ما تو مجموعه میتونیم ورود کنیم بگیم این اساسنامه اشکال لاره"
    },
    {
      "id": 11,
      "start": 7246.16,
      "end": 7253.4,
      "formatted_start": "02:00:46.160",
      "formatted_end": "02:00:53.400",
      "text": "امشب شما بعد از چیز این بذار زیر سال ببرید واقعا"
    },
    {
      "id": 12,
      "start": 7253.4,
      "end": 7255.92,
      "formatted_start": "02:00:53.400",
      "formatted_end": "02:00:55.920",
      "text": "منم اصلا خوشم نمیده"
    },
    {
      "id": 13,
      "start": 7255.92,
      "end": 7257.92,
      "formatted_start": "02:00:55.920",
      "formatted_end": "02:00:57.920",
      "text": "خانم دکتور ممنون باشید"
    },
    {
      "id": 14,
      "start": 7257.92,
      "end": 7259.92,
      "formatted_start": "02:00:57.920",
      "formatted_end": "02:00:59.920",
      "text": "مرسی خیلی خیلی خدافرم"
    },
    {
      "id": 15,
      "start": 7259.92,
      "end": 7261.92,
      "formatted_start": "02:00:59.920",
      "formatted_end": "02:01:01.920",
      "text": "خدافرم باشید امشب که خدافرم"
    },
    {
      "id": 16,
      "start": 7261.92,
      "end": 7263.92,
      "formatted_start": "02:01:01.920",
      "formatted_end": "02:01:03.920",
      "text": "مرسی خدافرم"
    }
  ],
  "status": "completed"
}