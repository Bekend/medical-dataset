  "stt_segments": [
    {
      "id": 0,
      "start": 6900.0,
      "end": 6906.4,
      "formatted_start": "01:55:00.000",
      "formatted_end": "01:55:06.400",
      "text": "قرابی یا نفسی؟ یکی از این دوتا. یا قرابی یا نفسی؟ ببین پرغاز..."
    },
    {
      "id": 1,
      "start": 6906.4,
      "end": 6908.0,
      "formatted_start": "01:55:06.400",
      "formatted_end": "01:55:08.000",
      "text": "عد البدر به که رای بده؟"
    },
    {
      "id": 2,
      "start": 6908.0,
      "end": 6917.6,
      "formatted_start": "01:55:08.000",
      "formatted_end": "01:55:17.600",
      "text": "عد البدر به پرغاز و شیخی رای نده، به خزینی رای بده چون اگر یه وقت یکی از ما رفتی بیاد فرد خونسا بیاد چون دمرتی پرغاز نیاد."
    },
    {
      "id": 3,
      "start": 6917.6,
      "end": 6918.4,
      "formatted_start": "01:55:17.600",
      "formatted_end": "01:55:18.400",
      "text": "باشه باشه باشه."
    },
    {
      "id": 4,
      "start": 6918.4,
      "end": 6919.6,
      "formatted_start": "01:55:18.400",
      "formatted_end": "01:55:19.600",
      "text": "پرغاز نیاد. خب؟"
    },
    {
      "id": 5,
      "start": 6919.6,
      "end": 6920.2,
      "formatted_start": "01:55:19.600",
      "formatted_end": "01:55:20.200",
      "text": "باشه باشه."
    },
    {
      "id": 6,
      "start": 6920.2,
      "end": 6927.36,
      "formatted_start": "01:55:20.200",
      "formatted_end": "01:55:27.360",
      "text": "دو نفر تو این سیستم من دیدم یکی پرغاز خطرناکه خب اصلا پرغاز بحشتناکه"
    },
    {
      "id": 7,
      "start": 6927.36,
      "end": 6933.36,
      "formatted_start": "01:55:27.360",
      "formatted_end": "01:55:33.360",
      "text": "یه منفع طلب هم داریم که دنبال سودیوی خود و اطرافیانشه شیخی"
    },
    {
      "id": 8,
      "start": 6933.36,
      "end": 6935.36,
      "formatted_start": "01:55:33.360",
      "formatted_end": "01:55:35.360",
      "text": "خب من این باعثش مشکلی هم ندارم"
    },
    {
      "id": 9,
      "start": 6935.36,
      "end": 6937.36,
      "formatted_start": "01:55:35.360",
      "formatted_end": "01:55:37.360",
      "text": "سالی پس شیفتارنیکی"
    },
    {
      "id": 10,
      "start": 6937.36,
      "end": 6939.36,
      "formatted_start": "01:55:37.360",
      "formatted_end": "01:55:39.360",
      "text": "نه نه سالی هم خیلی خوبه"
    },
    {
      "id": 11,
      "start": 6939.36,
      "end": 6941.36,
      "formatted_start": "01:55:39.360",
      "formatted_end": "01:55:41.360",
      "text": "سالی دید انتقادی داره خب"
    },
    {
      "id": 12,
      "start": 6941.36,
      "end": 6945.36,
      "formatted_start": "01:55:41.360",
      "formatted_end": "01:55:45.360",
      "text": "سالی آدم رکو مرده"
    },
    {
      "id": 13,
      "start": 6945.36,
      "end": 6947.36,
      "formatted_start": "01:55:45.360",
      "formatted_end": "01:55:47.360",
      "text": "سالی خب"
    },
    {
      "id": 14,
      "start": 6947.36,
      "end": 6951.36,
      "formatted_start": "01:55:47.360",
      "formatted_end": "01:55:51.360",
      "text": "سالی خوبه به نظر من واقعا سالی بیاد میتونه کمک کنه خب"
    },
    {
      "id": 15,
      "start": 6951.36,
      "end": 6953.36,
      "formatted_start": "01:55:51.360",
      "formatted_end": "01:55:53.360",
      "text": "سالی هم خوبه"
    },
    {
      "id": 16,
      "start": 6953.36,
      "end": 6957.36,
      "formatted_start": "01:55:53.360",
      "formatted_end": "01:55:57.360",
      "text": "حالا من فقط دو نفر خیلی حساس هستم پرغاز شیخی خب"
    },
    {
      "id": 17,
      "start": 6957.36,
      "end": 6958.42,
      "formatted_start": "01:55:57.360",
      "formatted_end": "01:55:58.420",
      "text": "تمام اکشن، تمام"
    },
    {
      "id": 18,
      "start": 6958.44,
      "end": 6961.58,
      "formatted_start": "01:55:58.440",
      "formatted_end": "01:56:01.580",
      "text": "دکتر، تمام کارهایی که ما نکردیم تو این دو سال"
    },
    {
      "id": 19,
      "start": 6961.6,
      "end": 6963.94,
      "formatted_start": "01:56:01.600",
      "formatted_end": "01:56:03.940",
      "text": "همه رو بالا ریز کرده"
    },
    {
      "id": 20,
      "start": 6963.96,
      "end": 6966.96,
      "formatted_start": "01:56:03.960",
      "formatted_end": "01:56:06.960",
      "text": "میخواد امشب تو کیسه خودش بریده که من کردم"
    },
    {
      "id": 21,
      "start": 6966.98,
      "end": 6970.12,
      "formatted_start": "01:56:06.980",
      "formatted_end": "01:56:10.120",
      "text": "یعنی تمام اصلا پاشای امروز گفت آقا این چه کاریه کرده؟"
    },
    {
      "id": 22,
      "start": 6970.14,
      "end": 6972.12,
      "formatted_start": "01:56:10.140",
      "formatted_end": "01:56:12.120",
      "text": "گفتم، گفت یه جوری شما چیز کن"
    },
    {
      "id": 23,
      "start": 6972.14,
      "end": 6974.2,
      "formatted_start": "01:56:12.140",
      "formatted_end": "01:56:14.200",
      "text": "اینگاه ما همه بوخ بودیم این همه کارها رو"
    },
    {
      "id": 24,
      "start": 6974.22,
      "end": 6976.48,
      "formatted_start": "01:56:14.220",
      "formatted_end": "01:56:16.480",
      "text": "بلحال حواسیت باشه، دکتر جان این پنجتا خوبه"
    },
    {
      "id": 25,
      "start": 6976.5,
      "end": 6977.6,
      "formatted_start": "01:56:16.500",
      "formatted_end": "01:56:17.600",
      "text": "باشه، باشه، تمام، تمام"
    },
    {
      "id": 26,
      "start": 6977.6,
      "end": 6980.36,
      "formatted_start": "01:56:17.600",
      "formatted_end": "01:56:20.360",
      "text": "اولم خودت، اینه خودت رو کنار نکشه"
    },
    {
      "id": 27,
      "start": 6980.36,
      "end": 6982.6,
      "formatted_start": "01:56:20.360",
      "formatted_end": "01:56:22.600",
      "text": "باشه، برباره ات زنده باشه"
    },
    {
      "id": 28,
      "start": 6982.6,
      "end": 6983.42,
      "formatted_start": "01:56:22.600",
      "formatted_end": "01:56:23.420",
      "text": "خدافز"
    },
    {
      "id": 29,
      "start": 6983.42,
      "end": 6984.36,
      "formatted_start": "01:56:23.420",
      "formatted_end": "01:56:24.360",
      "text": "خدافز"
    },
    {
      "id": 30,
      "start": 7007.6,
      "end": 7037.58,
      "formatted_start": "01:56:47.600",
      "formatted_end": "01:57:17.580",
      "text": "موسیقی در موسیقی درسته"
    },
    {
      "id": 31,
      "start": 7037.6,
      "end": 7050.6,
      "formatted_start": "01:57:17.600",
      "formatted_end": "01:57:30.600",
      "text": "موسیقی"
    },
    {
      "id": 32,
      "start": 7050.6,
      "end": 7052.6,
      "formatted_start": "01:57:30.600",
      "formatted_end": "01:57:32.600",
      "text": "حالا سلام خانم دکتور خوب هستی؟"
    },
    {
      "id": 33,
      "start": 7052.6,
      "end": 7054.6,
      "formatted_start": "01:57:32.600",
      "formatted_end": "01:57:34.600",
      "text": "سلام علیکم خوب است"
    },
    {
      "id": 34,
      "start": 7054.6,
      "end": 7056.6,
      "formatted_start": "01:57:34.600",
      "formatted_end": "01:57:36.600",
      "text": "یه دو دقیقه خانم دکتور وقت دارید؟"
    },
    {
      "id": 35,
      "start": 7056.6,
      "end": 7058.6,
      "formatted_start": "01:57:36.600",
      "formatted_end": "01:57:38.600",
      "text": "خواهشم برس برس داریم"
    },
    {
      "id": 36,
      "start": 7058.6,
      "end": 7060.6,
      "formatted_start": "01:57:38.600",
      "formatted_end": "01:57:40.600",
      "text": "خانم دکتور الان خبر دارید امشب مجمع اینا"
    },
    {
      "id": 37,
      "start": 7060.6,
      "end": 7066.6,
      "formatted_start": "01:57:40.600",
      "formatted_end": "01:57:46.600",
      "text": "خب چون از نظر فکری ما خیلی غلابت شما تو این ایت مدیری دیدم"
    },
    {
      "id": 38,
      "start": 7066.6,
      "end": 7070.6,
      "formatted_start": "01:57:46.600",
      "formatted_end": "01:57:50.600",
      "text": "یعنی به کورت دخال یه سری مساله مصبت و خوب و سازنده هستید"
    },
    {
      "id": 39,
      "start": 7070.6,
      "end": 7074.6,
      "formatted_start": "01:57:50.600",
      "formatted_end": "01:57:54.600",
      "text": "خواستم خواهش برم خودتون ورود داشته باشید یعنی تو به سایه اتخابات"
    },
    {
      "id": 40,
      "start": 7074.6,
      "end": 7080.78,
      "formatted_start": "01:57:54.600",
      "formatted_end": "01:58:00.780",
      "text": "خب باید فقط دو نفر رو حواست باشه که ما رای چیز ندیم آفنگی"
    },
    {
      "id": 41,
      "start": 7080.78,
      "end": 7084.32,
      "formatted_start": "01:58:00.780",
      "formatted_end": "01:58:04.320",
      "text": "یکی اون منفض طلب ها و اونهای که تخریبگر ها"
    },
    {
      "id": 42,
      "start": 7084.32,
      "end": 7090.44,
      "formatted_start": "01:58:04.320",
      "formatted_end": "01:58:10.440",
      "text": "اونها که تخریبگر ها و منفض طلب ها میدونید چی هستن دیگه"
    },
    {
      "id": 43,
      "start": 7090.44,
      "end": 7093.62,
      "formatted_start": "01:58:10.440",
      "formatted_end": "01:58:13.620",
      "text": "بگردی قضا و ترمیز و مشابه و اونا"
    },
    {
      "id": 44,
      "start": 7093.62,
      "end": 7097.26,
      "formatted_start": "01:58:13.620",
      "formatted_end": "01:58:17.260",
      "text": "خب اینا بیان قدرت مند بشن پیشتر فساد میکنن"
    },
    {
      "id": 45,
      "start": 7097.26,
      "end": 7104.48,
      "formatted_start": "01:58:17.260",
      "formatted_end": "01:58:24.480",
      "text": "بله آیا واقعا موثق خواهد بود رای ما و خواسته ما بیان نمند"
    },
    {
      "id": 46,
      "start": 7104.48,
      "end": 7105.82,
      "formatted_start": "01:58:24.480",
      "formatted_end": "01:58:25.820",
      "text": "اینو فکر مطمئن این؟"
    },
    {
      "id": 47,
      "start": 7105.82,
      "end": 7106.48,
      "formatted_start": "01:58:25.820",
      "formatted_end": "01:58:26.480",
      "text": "مطمئنم"
    },
    {
      "id": 48,
      "start": 7106.48,
      "end": 7108.48,
      "formatted_start": "01:58:26.480",
      "formatted_end": "01:58:28.480",
      "text": "من فکر میکنم قدرت دست اونا هست"
    },
    {
      "id": 49,
      "start": 7108.48,
      "end": 7110.9,
      "formatted_start": "01:58:28.480",
      "formatted_end": "01:58:30.900",
      "text": "ببین قدرت دست اوناهی و دیگه اینکن"
    },
    {
      "id": 50,
      "start": 7110.9,
      "end": 7112.08,
      "formatted_start": "01:58:30.900",
      "formatted_end": "01:58:32.080",
      "text": "یعنی رای اینا"
    },
    {
      "id": 51,
      "start": 7112.08,
      "end": 7114.48,
      "formatted_start": "01:58:32.080",
      "formatted_end": "01:58:34.480",
      "text": "ما خاندکتر رای ها ما رو حفظ نکنیم"
    },
    {
      "id": 52,
      "start": 7114.48,
      "end": 7117.82,
      "formatted_start": "01:58:34.480",
      "formatted_end": "01:58:37.820",
      "text": "نه اگه باشه که من واقعا مثل دفعه پیش با تعریف هم نمیخوام بدم"
    },
    {
      "id": 53,
      "start": 7117.82,
      "end": 7120.58,
      "formatted_start": "01:58:37.820",
      "formatted_end": "01:58:40.580",
      "text": "یعنی مثل دفعه پیش هم از ناچاری دادیم"
    },
    {
      "id": 54,
      "start": 7120.58,
      "end": 7122.92,
      "formatted_start": "01:58:40.580",
      "formatted_end": "01:58:42.920",
      "text": "ببین همین ناچاری رای دادن داره کار"
    },
    {
      "id": 55,
      "start": 7122.92,
      "end": 7123.92,
      "formatted_start": "01:58:42.920",
      "formatted_end": "01:58:43.920",
      "text": "بله بله"
    },
    {
      "id": 56,
      "start": 7123.92,
      "end": 7125.72,
      "formatted_start": "01:58:43.920",
      "formatted_end": "01:58:45.720",
      "text": "تو این دو سال تجربهشو دارم"
    },
    {
      "id": 57,
      "start": 7125.72,
      "end": 7129.02,
      "formatted_start": "01:58:45.720",
      "formatted_end": "01:58:49.020",
      "text": "یعنی واقعا فهمیدم که این های سیستمشون چی جوریه"
    },
    {
      "id": 58,
      "start": 7129.02,
      "end": 7131.8,
      "formatted_start": "01:58:49.020",
      "formatted_end": "01:58:51.800",
      "text": "خب چون شما مثلا یه مقدار تو آشیه تر بودین"
    },
    {
      "id": 59,
      "start": 7131.8,
      "end": 7133.96,
      "formatted_start": "01:58:51.800",
      "formatted_end": "01:58:53.960",
      "text": "ولی تو بعد من خودم دقیق بودم"
    },
    {
      "id": 60,
      "start": 7133.96,
      "end": 7138.14,
      "formatted_start": "01:58:53.960",
      "formatted_end": "01:58:58.140",
      "text": "الان ایشون اومده تمام اقداماتی که در بیمارستان انجام شده"
    },
    {
      "id": 61,
      "start": 7138.14,
      "end": 7141.56,
      "formatted_start": "01:58:58.140",
      "formatted_end": "01:59:01.560",
      "text": "لیست کرده به نام خودش که مدیر آمل داریم کارها رو میکنه"
    },
    {
      "id": 62,
      "start": 7141.56,
      "end": 7144.86,
      "formatted_start": "01:59:01.560",
      "formatted_end": "01:59:04.860",
      "text": "هر چی، ما هر کارهی که ما کردیم پاشایی کردیگران کرد"
    },
    {
      "id": 63,
      "start": 7144.86,
      "end": 7145.9,
      "formatted_start": "01:59:04.860",
      "formatted_end": "01:59:05.900",
      "text": "حالا کار ندارن"
    },
    {
      "id": 64,
      "start": 7145.9,
      "end": 7150.44,
      "formatted_start": "01:59:05.900",
      "formatted_end": "01:59:10.440",
      "text": "منظور اینه که اگر باقی افرادی که احساس میکنین رای ندید خواهشن"
    },
    {
      "id": 65,
      "start": 7150.44,
      "end": 7154.54,
      "formatted_start": "01:59:10.440",
      "formatted_end": "01:59:14.540",
      "text": "خب اینو چون رای بالا میان بعد میان مسئولیت بگیرن"
    },
    {
      "id": 66,
      "start": 7154.54,
      "end": 7157.7,
      "formatted_start": "01:59:14.540",
      "formatted_end": "01:59:17.700",
      "text": "بعد میگن ما رای ما بالا بوده الان مسئولیت با ما بدین"
    },
    {
      "id": 67,
      "start": 7157.7,
      "end": 7162.9,
      "formatted_start": "01:59:17.700",
      "formatted_end": "01:59:22.900",
      "text": "یک سیستم مافیایی این زمان دکتر علاقی میخوانی ایجاد کنن دوباره"
    },
    {
      "id": 68,
      "start": 7162.9,
      "end": 7164.36,
      "formatted_start": "01:59:22.900",
      "formatted_end": "01:59:24.360",
      "text": "آره آره دیگه"
    },
    {
      "id": 69,
      "start": 7164.36,
      "end": 7167.14,
      "formatted_start": "01:59:24.360",
      "formatted_end": "01:59:27.140",
      "text": "من فکر میکنم نمیشه این سیستم رو برداشت"
    },
    {
      "id": 70,
      "start": 7167.14,
      "end": 7169.9,
      "formatted_start": "01:59:27.140",
      "formatted_end": "01:59:29.900",
      "text": "من فکر میکنم این انتخابات خیلی ماییه"
    },
    {
      "id": 71,
      "start": 7169.9,
      "end": 7170.56,
      "formatted_start": "01:59:29.900",
      "formatted_end": "01:59:30.560",
      "text": "میتوه برداشت؟"
    },
    {
      "id": 72,
      "start": 7170.56,
      "end": 7175.56,
      "formatted_start": "01:59:30.560",
      "formatted_end": "01:59:35.560",
      "text": "این نظرهایی دارند، افرادی هستند و از آنها را قبول داشته باشند"
    },
    {
      "id": 73,
      "start": 7175.56,
      "end": 7179.56,
      "formatted_start": "01:59:35.560",
      "formatted_end": "01:59:39.560",
      "text": "شما، ما باید ورود کنیم و این وکالت را از بین ببریم"
    },
    {
      "id": 74,
      "start": 7179.56,
      "end": 7186.56,
      "formatted_start": "01:59:39.560",
      "formatted_end": "01:59:46.560",
      "text": "این ها یک سیستم اقتصاد شده است، باید بگیم آقا وکالت، کسایی که نیستند"
    },
    {
      "id": 75,
      "start": 7186.56,
      "end": 7192.56,
      "formatted_start": "01:59:46.560",
      "formatted_end": "01:59:52.560",
      "text": "میتونند به صورت مجازی یا باید بگیم آقا موقع انتخابات که امشبه است"
    },
    {
      "id": 76,
      "start": 7192.56,
      "end": 7198.56,
      "formatted_start": "01:59:52.560",
      "formatted_end": "01:59:58.560",
      "text": "بهشون اطلاع بدیم یا اسمس بدیم یا فضای مجازی که آقا ده نفر یا بیس نفر کاندید هستند"
    },
    {
      "id": 77,
      "start": 7198.56,
      "end": 7200.0,
      "formatted_start": "01:59:58.560",
      "formatted_end": "02:00:00.000",
      "text": "با هرکی رایی میخواهیدید"
    }
  ],
  "status": "completed"
}