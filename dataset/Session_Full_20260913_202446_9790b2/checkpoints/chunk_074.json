  "stt_segments": [
    {
      "id": 0,
      "start": 22200.0,
      "end": 22202.0,
      "formatted_start": "06:10:00.000",
      "formatted_end": "06:10:02.000",
      "text": "باید بگم خانم سبزمانه برم."
    },
    {
      "id": 1,
      "start": 22202.0,
      "end": 22204.0,
      "formatted_start": "06:10:02.000",
      "formatted_end": "06:10:04.000",
      "text": "آره، فره فرد و صبح."
    },
    {
      "id": 2,
      "start": 22204.0,
      "end": 22206.0,
      "formatted_start": "06:10:04.000",
      "formatted_end": "06:10:06.000",
      "text": "شکر کردن."
    },
    {
      "id": 3,
      "start": 22206.0,
      "end": 22208.0,
      "formatted_start": "06:10:06.000",
      "formatted_end": "06:10:08.000",
      "text": "سه و مرد بشه."
    },
    {
      "id": 4,
      "start": 22214.0,
      "end": 22216.0,
      "formatted_start": "06:10:14.000",
      "formatted_end": "06:10:16.000",
      "text": "سلام."
    },
    {
      "id": 5,
      "start": 22216.0,
      "end": 22218.0,
      "formatted_start": "06:10:16.000",
      "formatted_end": "06:10:18.000",
      "text": "خستن آقایش خانم برد."
    },
    {
      "id": 6,
      "start": 22218.0,
      "end": 22220.0,
      "formatted_start": "06:10:18.000",
      "formatted_end": "06:10:20.000",
      "text": "سلام خانم."
    },
    {
      "id": 7,
      "start": 22220.0,
      "end": 22222.0,
      "formatted_start": "06:10:20.000",
      "formatted_end": "06:10:22.000",
      "text": "اجازه هست؟"
    },
    {
      "id": 8,
      "start": 22222.0,
      "end": 22224.0,
      "formatted_start": "06:10:22.000",
      "formatted_end": "06:10:24.000",
      "text": "برم برش."
    },
    {
      "id": 9,
      "start": 22224.0,
      "end": 22226.0,
      "formatted_start": "06:10:24.000",
      "formatted_end": "06:10:26.000",
      "text": "خانم بختر،"
    },
    {
      "id": 10,
      "start": 22226.0,
      "end": 22228.0,
      "formatted_start": "06:10:26.000",
      "formatted_end": "06:10:28.000",
      "text": "چند وقتی"
    },
    {
      "id": 11,
      "start": 22228.0,
      "end": 22232.0,
      "formatted_start": "06:10:28.000",
      "formatted_end": "06:10:32.000",
      "text": "از صبح هم خیلی ناجور داره زخم میشه"
    },
    {
      "id": 12,
      "start": 22232.0,
      "end": 22233.0,
      "formatted_start": "06:10:32.000",
      "formatted_end": "06:10:33.000",
      "text": "میخاره؟"
    },
    {
      "id": 13,
      "start": 22233.0,
      "end": 22234.0,
      "formatted_start": "06:10:33.000",
      "formatted_end": "06:10:34.000",
      "text": "هم میخاره"
    },
    {
      "id": 14,
      "start": 22234.0,
      "end": 22237.0,
      "formatted_start": "06:10:34.000",
      "formatted_end": "06:10:37.000",
      "text": "بعد پاهم هم به همین شکل"
    },
    {
      "id": 15,
      "start": 22237.0,
      "end": 22240.0,
      "formatted_start": "06:10:37.000",
      "formatted_end": "06:10:40.000",
      "text": "بعد دست و پایه بدن هم نیست"
    },
    {
      "id": 16,
      "start": 22240.0,
      "end": 22243.0,
      "formatted_start": "06:10:40.000",
      "formatted_end": "06:10:43.000",
      "text": "میخاره برای که زخم میشه یا اول تو نمیزنه؟"
    },
    {
      "id": 17,
      "start": 22243.0,
      "end": 22247.0,
      "formatted_start": "06:10:43.000",
      "formatted_end": "06:10:47.000",
      "text": "نه نه میزنه بعد آرام و رام میخارم"
    },
    {
      "id": 18,
      "start": 22247.0,
      "end": 22252.0,
      "formatted_start": "06:10:47.000",
      "formatted_end": "06:10:52.000",
      "text": "بعد پستش کنده میشه یا مایه سفید رنگی میزنه بیرون"
    },
    {
      "id": 19,
      "start": 22252.0,
      "end": 22254.0,
      "formatted_start": "06:10:52.000",
      "formatted_end": "06:10:54.000",
      "text": "این شبهه آب"
    },
    {
      "id": 20,
      "start": 22254.0,
      "end": 22258.0,
      "formatted_start": "06:10:54.000",
      "formatted_end": "06:10:58.000",
      "text": "و بعد به یک زخم میشه"
    },
    {
      "id": 21,
      "start": 22258.0,
      "end": 22260.0,
      "formatted_start": "06:10:58.000",
      "formatted_end": "06:11:00.000",
      "text": "نبازتون زخم میشه کمتون"
    },
    {
      "id": 22,
      "start": 22260.0,
      "end": 22262.0,
      "formatted_start": "06:11:00.000",
      "formatted_end": "06:11:02.000",
      "text": "خواهید اون چیه؟"
    },
    {
      "id": 23,
      "start": 22262.0,
      "end": 22264.0,
      "formatted_start": "06:11:02.000",
      "formatted_end": "06:11:04.000",
      "text": "نظامی هم"
    },
    {
      "id": 24,
      "start": 22264.0,
      "end": 22266.0,
      "formatted_start": "06:11:04.000",
      "formatted_end": "06:11:06.000",
      "text": "سیستان هم شده"
    },
    {
      "id": 25,
      "start": 22266.0,
      "end": 22268.0,
      "formatted_start": "06:11:06.000",
      "formatted_end": "06:11:08.000",
      "text": "سیستان برای جسام خود نکرده بود"
    },
    {
      "id": 26,
      "start": 22268.0,
      "end": 22270.0,
      "formatted_start": "06:11:08.000",
      "formatted_end": "06:11:10.000",
      "text": "برای میلیستان"
    },
    {
      "id": 27,
      "start": 22270.0,
      "end": 22272.0,
      "formatted_start": "06:11:10.000",
      "formatted_end": "06:11:12.000",
      "text": "بله"
    },
    {
      "id": 28,
      "start": 22272.0,
      "end": 22275.0,
      "formatted_start": "06:11:12.000",
      "formatted_end": "06:11:15.000",
      "text": "اینجا میدون که کبه بشید همینست"
    },
    {
      "id": 29,
      "start": 22275.0,
      "end": 22277.0,
      "formatted_start": "06:11:15.000",
      "formatted_end": "06:11:17.000",
      "text": "برگرد آزمایش که برگرد"
    },
    {
      "id": 30,
      "start": 22277.0,
      "end": 22279.0,
      "formatted_start": "06:11:17.000",
      "formatted_end": "06:11:19.000",
      "text": "برگرد نوزماشه باشه"
    },
    {
      "id": 31,
      "start": 22279.0,
      "end": 22282.0,
      "formatted_start": "06:11:19.000",
      "formatted_end": "06:11:22.000",
      "text": "اینجا باشه هم"
    },
    {
      "id": 32,
      "start": 22282.0,
      "end": 22284.0,
      "formatted_start": "06:11:22.000",
      "formatted_end": "06:11:24.000",
      "text": "همینجور بوده؟ نه"
    },
    {
      "id": 33,
      "start": 22284.0,
      "end": 22286.0,
      "formatted_start": "06:11:24.000",
      "formatted_end": "06:11:26.000",
      "text": "نه؟ نه؟"
    },
    {
      "id": 34,
      "start": 22286.0,
      "end": 22288.0,
      "formatted_start": "06:11:26.000",
      "formatted_end": "06:11:28.000",
      "text": "اینجور که آرمانشون نست"
    },
    {
      "id": 35,
      "start": 22288.0,
      "end": 22290.0,
      "formatted_start": "06:11:28.000",
      "formatted_end": "06:11:30.000",
      "text": "اینها دیده بودی؟"
    },
    {
      "id": 36,
      "start": 22290.0,
      "end": 22292.0,
      "formatted_start": "06:11:30.000",
      "formatted_end": "06:11:32.000",
      "text": "اینجور بوده"
    },
    {
      "id": 37,
      "start": 22292.0,
      "end": 22294.0,
      "formatted_start": "06:11:32.000",
      "formatted_end": "06:11:34.000",
      "text": "پس که؟"
    },
    {
      "id": 38,
      "start": 22294.0,
      "end": 22296.0,
      "formatted_start": "06:11:34.000",
      "formatted_end": "06:11:36.000",
      "text": "اونجور رو باسر هم نه"
    },
    {
      "id": 39,
      "start": 22296.0,
      "end": 22298.0,
      "formatted_start": "06:11:36.000",
      "formatted_end": "06:11:38.000",
      "text": "بگو بسمتی چونه"
    },
    {
      "id": 40,
      "start": 22298.0,
      "end": 22300.0,
      "formatted_start": "06:11:38.000",
      "formatted_end": "06:11:40.000",
      "text": "بسمت هم چونه؟ آرمان"
    },
    {
      "id": 41,
      "start": 22300.0,
      "end": 22302.0,
      "formatted_start": "06:11:40.000",
      "formatted_end": "06:11:42.000",
      "text": "شما که میخوابید بیشتر میشونه"
    },
    {
      "id": 42,
      "start": 22302.0,
      "end": 22304.0,
      "formatted_start": "06:11:42.000",
      "formatted_end": "06:11:44.000",
      "text": "آرشو شیطان رو بشتر میشونه"
    },
    {
      "id": 43,
      "start": 22304.0,
      "end": 22306.0,
      "formatted_start": "06:11:44.000",
      "formatted_end": "06:11:46.000",
      "text": "چیزی که هست؟"
    },
    {
      "id": 44,
      "start": 22306.0,
      "end": 22308.0,
      "formatted_start": "06:11:46.000",
      "formatted_end": "06:11:48.000",
      "text": "چیزی که هست؟"
    },
    {
      "id": 45,
      "start": 22308.0,
      "end": 22310.0,
      "formatted_start": "06:11:48.000",
      "formatted_end": "06:11:50.000",
      "text": "چرا؟"
    },
    {
      "id": 46,
      "start": 22312.0,
      "end": 22314.0,
      "formatted_start": "06:11:52.000",
      "formatted_end": "06:11:54.000",
      "text": "چرا؟"
    },
    {
      "id": 47,
      "start": 22314.0,
      "end": 22316.0,
      "formatted_start": "06:11:54.000",
      "formatted_end": "06:11:56.000",
      "text": "نه، دیگه"
    },
    {
      "id": 48,
      "start": 22316.0,
      "end": 22318.0,
      "formatted_start": "06:11:56.000",
      "formatted_end": "06:11:58.000",
      "text": "چرا؟"
    },
    {
      "id": 49,
      "start": 22318.0,
      "end": 22320.0,
      "formatted_start": "06:11:58.000",
      "formatted_end": "06:12:00.000",
      "text": "در برم خانم خواب ببخشیم"
    },
    {
      "id": 50,
      "start": 22320.0,
      "end": 22322.0,
      "formatted_start": "06:12:00.000",
      "formatted_end": "06:12:02.000",
      "text": "از آنها خواب ببخشیم"
    },
    {
      "id": 51,
      "start": 22322.0,
      "end": 22324.0,
      "formatted_start": "06:12:02.000",
      "formatted_end": "06:12:04.000",
      "text": "شما نردید خانم خوابش؟"
    },
    {
      "id": 52,
      "start": 22324.0,
      "end": 22326.0,
      "formatted_start": "06:12:04.000",
      "formatted_end": "06:12:06.000",
      "text": "در مکم ببندن؟"
    },
    {
      "id": 53,
      "start": 22326.0,
      "end": 22328.0,
      "formatted_start": "06:12:06.000",
      "formatted_end": "06:12:08.000",
      "text": "نه"
    },
    {
      "id": 54,
      "start": 22328.0,
      "end": 22330.0,
      "formatted_start": "06:12:08.000",
      "formatted_end": "06:12:10.000",
      "text": "شما خوابش ندارید؟"
    },
    {
      "id": 55,
      "start": 22330.0,
      "end": 22332.0,
      "formatted_start": "06:12:10.000",
      "formatted_end": "06:12:12.000",
      "text": "نه"
    },
    {
      "id": 56,
      "start": 22332.0,
      "end": 22334.0,
      "formatted_start": "06:12:12.000",
      "formatted_end": "06:12:14.000",
      "text": "بچه ها کسی ندارند؟"
    },
    {
      "id": 57,
      "start": 22334.0,
      "end": 22336.0,
      "formatted_start": "06:12:14.000",
      "formatted_end": "06:12:16.000",
      "text": "نه"
    },
    {
      "id": 58,
      "start": 22336.0,
      "end": 22339.2,
      "formatted_start": "06:12:16.000",
      "formatted_end": "06:12:19.200",
      "text": "بچه ها کسی ندارد؟ همکارات کسی دورید؟"
    },
    {
      "id": 59,
      "start": 22339.2,
      "end": 22342.58,
      "formatted_start": "06:12:19.200",
      "formatted_end": "06:12:22.580",
      "text": "نه، اونجا فقط چیزی که هست، همینی رو خواستم بگم"
    },
    {
      "id": 60,
      "start": 22342.58,
      "end": 22346.18,
      "formatted_start": "06:12:22.580",
      "formatted_end": "06:12:26.180",
      "text": "اونجا رفتم دکتر، مثل اینکه"
    },
    {
      "id": 61,
      "start": 22346.18,
      "end": 22350.64,
      "formatted_start": "06:12:26.180",
      "formatted_end": "06:12:30.640",
      "text": "چون مرض پاکستان، دقیقا چه از روز مرض پاکستان"
    },
    {
      "id": 62,
      "start": 22350.64,
      "end": 22353.38,
      "formatted_start": "06:12:30.640",
      "formatted_end": "06:12:33.380",
      "text": "رفت آمد میشه به اونور"
    },
    {
      "id": 63,
      "start": 22353.38,
      "end": 22356.56,
      "formatted_start": "06:12:33.380",
      "formatted_end": "06:12:36.560",
      "text": "با پاکستان ها انتقادا در ارتباطیم"
    },
    {
      "id": 64,
      "start": 22356.56,
      "end": 22362.0,
      "formatted_start": "06:12:36.560",
      "formatted_end": "06:12:42.000",
      "text": "مثل اینکه یه اتبادی از همون مرض اونجا"
    },
    {
      "id": 65,
      "start": 22362.0,
      "end": 22364.6,
      "formatted_start": "06:12:42.000",
      "formatted_end": "06:12:44.600",
      "text": "شهر و مدیر و مرکزش همچین برازی رو"
    },
    {
      "id": 66,
      "start": 22364.6,
      "end": 22366.0,
      "formatted_start": "06:12:44.600",
      "formatted_end": "06:12:46.000",
      "text": "کار داشته بودن"
    },
    {
      "id": 67,
      "start": 22366.0,
      "end": 22368.0,
      "formatted_start": "06:12:46.000",
      "formatted_end": "06:12:48.000",
      "text": "بگوش من دارم شما هم میدین"
    },
    {
      "id": 68,
      "start": 22368.0,
      "end": 22371.0,
      "formatted_start": "06:12:48.000",
      "formatted_end": "06:12:51.000",
      "text": "بگو مرکزش همچین زرشن و آزاد"
    },
    {
      "id": 69,
      "start": 22371.0,
      "end": 22375.0,
      "formatted_start": "06:12:51.000",
      "formatted_end": "06:12:55.000",
      "text": "تمام ملاختها هاش و حباسه هاش با آب جشمنده شده"
    },
    {
      "id": 70,
      "start": 22375.0,
      "end": 22377.0,
      "formatted_start": "06:12:55.000",
      "formatted_end": "06:12:57.000",
      "text": "تا اینجا آمده برداره بود"
    },
    {
      "id": 71,
      "start": 22377.0,
      "end": 22379.0,
      "formatted_start": "06:12:57.000",
      "formatted_end": "06:12:59.000",
      "text": "داریم مسیرش گرمه گاله"
    },
    {
      "id": 72,
      "start": 22379.0,
      "end": 22381.0,
      "formatted_start": "06:12:59.000",
      "formatted_end": "06:13:01.000",
      "text": "نوع خواهش دیدید"
    },
    {
      "id": 73,
      "start": 22381.0,
      "end": 22383.0,
      "formatted_start": "06:13:01.000",
      "formatted_end": "06:13:03.000",
      "text": "این مولد گاله"
    },
    {
      "id": 74,
      "start": 22383.0,
      "end": 22384.0,
      "formatted_start": "06:13:03.000",
      "formatted_end": "06:13:04.000",
      "text": "برداشت میگی برداره"
    },
    {
      "id": 75,
      "start": 22384.0,
      "end": 22385.0,
      "formatted_start": "06:13:04.000",
      "formatted_end": "06:13:05.000",
      "text": "برداره؟"
    },
    {
      "id": 76,
      "start": 22385.0,
      "end": 22386.0,
      "formatted_start": "06:13:05.000",
      "formatted_end": "06:13:06.000",
      "text": "تا به تو درمون میشه"
    },
    {
      "id": 77,
      "start": 22386.0,
      "end": 22389.0,
      "formatted_start": "06:13:06.000",
      "formatted_end": "06:13:09.000",
      "text": "درمون کنه خیلی تزدیده همه"
    },
    {
      "id": 78,
      "start": 22389.0,
      "end": 22393.0,
      "formatted_start": "06:13:09.000",
      "formatted_end": "06:13:13.000",
      "text": "چیه دیگه مثلا شپش سر کن این هیچیزی بود"
    },
    {
      "id": 79,
      "start": 22393.0,
      "end": 22395.0,
      "formatted_start": "06:13:13.000",
      "formatted_end": "06:13:15.000",
      "text": "چون میگن یه هشنه ریزه"
    },
    {
      "id": 80,
      "start": 22395.0,
      "end": 22399.0,
      "formatted_start": "06:13:15.000",
      "formatted_end": "06:13:19.000",
      "text": "آره زیر همه این دوناهایی که رو پستش هست اون خونه میکنن"
    },
    {
      "id": 81,
      "start": 22399.0,
      "end": 22404.0,
      "formatted_start": "06:13:19.000",
      "formatted_end": "06:13:24.000",
      "text": "بعد از دقتی که میخوانه باز مثلا اینجاشو میکنه اینجاشو میکنه باز اینجا میگه"
    },
    {
      "id": 82,
      "start": 22404.0,
      "end": 22406.0,
      "formatted_start": "06:13:24.000",
      "formatted_end": "06:13:26.000",
      "text": "اینجا میخوانه اینجا باز اینجا میگه"
    },
    {
      "id": 83,
      "start": 22406.0,
      "end": 22412.0,
      "formatted_start": "06:13:26.000",
      "formatted_end": "06:13:32.000",
      "text": "بعد خوبه هم میگم دیگه تمام ملاقا رو آداشت"
    },
    {
      "id": 84,
      "start": 22412.0,
      "end": 22415.0,
      "formatted_start": "06:13:32.000",
      "formatted_end": "06:13:35.000",
      "text": "اونجا هم که رفتی باید همه رو اندازه تو آبه جوش"
    },
    {
      "id": 85,
      "start": 22415.0,
      "end": 22417.0,
      "formatted_start": "06:13:35.000",
      "formatted_end": "06:13:37.000",
      "text": "سرباز نداری؟"
    },
    {
      "id": 86,
      "start": 22417.0,
      "end": 22419.0,
      "formatted_start": "06:13:37.000",
      "formatted_end": "06:13:39.000",
      "text": "چرا؟"
    },
    {
      "id": 87,
      "start": 22419.0,
      "end": 22421.0,
      "formatted_start": "06:13:39.000",
      "formatted_end": "06:13:41.000",
      "text": "سرباز همه هر سر شده داره"
    },
    {
      "id": 88,
      "start": 22421.0,
      "end": 22423.0,
      "formatted_start": "06:13:41.000",
      "formatted_end": "06:13:43.000",
      "text": "اکثر سرباز ها بیان اینجا همه سرباز داره"
    },
    {
      "id": 89,
      "start": 22423.0,
      "end": 22427.0,
      "formatted_start": "06:13:43.000",
      "formatted_end": "06:13:47.000",
      "text": "و تو پایگاه میخوابی یا بیرون میخوابی؟"
    },
    {
      "id": 90,
      "start": 22427.0,
      "end": 22429.0,
      "formatted_start": "06:13:47.000",
      "formatted_end": "06:13:49.000",
      "text": "من تو پایگاه بیم"
    },
    {
      "id": 91,
      "start": 22429.0,
      "end": 22431.0,
      "formatted_start": "06:13:49.000",
      "formatted_end": "06:13:51.000",
      "text": "پاسکا هست"
    },
    {
      "id": 92,
      "start": 22431.0,
      "end": 22435.0,
      "formatted_start": "06:13:51.000",
      "formatted_end": "06:13:55.000",
      "text": "هم تو هم پاسکا میخوابی یا بیرون چون تمام ملفه ها رو به بچه ها بگوییم"
    },
    {
      "id": 93,
      "start": 22435.0,
      "end": 22437.0,
      "formatted_start": "06:13:55.000",
      "formatted_end": "06:13:57.000",
      "text": "خودم اتاق هم"
    },
    {
      "id": 94,
      "start": 22437.0,
      "end": 22439.0,
      "formatted_start": "06:13:57.000",
      "formatted_end": "06:13:59.000",
      "text": "تو اتاق فرق خودتونه"
    },
    {
      "id": 95,
      "start": 22439.0,
      "end": 22441.0,
      "formatted_start": "06:13:59.000",
      "formatted_end": "06:14:01.000",
      "text": "خودم تنها"
    },
    {
      "id": 96,
      "start": 22441.0,
      "end": 22443.0,
      "formatted_start": "06:14:01.000",
      "formatted_end": "06:14:03.000",
      "text": "هم کسی نگه هست"
    },
    {
      "id": 97,
      "start": 22443.0,
      "end": 22445.0,
      "formatted_start": "06:14:03.000",
      "formatted_end": "06:14:05.000",
      "text": "و اونجا تا آبجوش بگذاریم"
    },
    {
      "id": 98,
      "start": 22445.0,
      "end": 22448.0,
      "formatted_start": "06:14:05.000",
      "formatted_end": "06:14:08.000",
      "text": "آقا بدباره دارید اونجا هرچی همیدونه"
    },
    {
      "id": 99,
      "start": 22448.0,
      "end": 22450.0,
      "formatted_start": "06:14:08.000",
      "formatted_end": "06:14:10.000",
      "text": "نظافت و رعایت میتونی اونشب نه"
    },
    {
      "id": 100,
      "start": 22450.0,
      "end": 22452.0,
      "formatted_start": "06:14:10.000",
      "formatted_end": "06:14:12.000",
      "text": "یه گرد خاک میشه بسیار"
    },
    {
      "id": 101,
      "start": 22452.0,
      "end": 22454.0,
      "formatted_start": "06:14:12.000",
      "formatted_end": "06:14:14.000",
      "text": "خاک مهن نیست که"
    },
    {
      "id": 102,
      "start": 22454.0,
      "end": 22456.0,
      "formatted_start": "06:14:14.000",
      "formatted_end": "06:14:16.000",
      "text": "خاک نیست، میرژابه هستی؟"
    },
    {
      "id": 103,
      "start": 22456.0,
      "end": 22458.0,
      "formatted_start": "06:14:16.000",
      "formatted_end": "06:14:18.000",
      "text": "نه، پیشین"
    },
    {
      "id": 104,
      "start": 22458.0,
      "end": 22461.0,
      "formatted_start": "06:14:18.000",
      "formatted_end": "06:14:21.000",
      "text": "پیشین، خب توی آخه مرز بودن با پاکستان؟"
    },
    {
      "id": 105,
      "start": 22461.0,
      "end": 22464.0,
      "formatted_start": "06:14:21.000",
      "formatted_end": "06:14:24.000",
      "text": "خب نه، پیشین هم مرز پاکستان بود"
    },
    {
      "id": 106,
      "start": 22464.0,
      "end": 22466.0,
      "formatted_start": "06:14:24.000",
      "formatted_end": "06:14:26.000",
      "text": "شهرم میرژابه بود"
    },
    {
      "id": 107,
      "start": 22466.0,
      "end": 22468.0,
      "formatted_start": "06:14:26.000",
      "formatted_end": "06:14:28.000",
      "text": "همکار ما بود؟"
    },
    {
      "id": 108,
      "start": 22468.0,
      "end": 22471.0,
      "formatted_start": "06:14:28.000",
      "formatted_end": "06:14:31.000",
      "text": "آره بزشگه، نهانه جاست، فراجاست"
    },
    {
      "id": 109,
      "start": 22471.0,
      "end": 22472.0,
      "formatted_start": "06:14:31.000",
      "formatted_end": "06:14:32.000",
      "text": "نه شیفه"
    },
    {
      "id": 110,
      "start": 22472.0,
      "end": 22473.0,
      "formatted_start": "06:14:32.000",
      "formatted_end": "06:14:33.000",
      "text": "نه شیفه"
    },
    {
      "id": 111,
      "start": 22473.0,
      "end": 22476.0,
      "formatted_start": "06:14:33.000",
      "formatted_end": "06:14:36.000",
      "text": "و کف دستام هم اینطوری شده؟"
    },
    {
      "id": 112,
      "start": 22476.0,
      "end": 22478.0,
      "formatted_start": "06:14:36.000",
      "formatted_end": "06:14:38.000",
      "text": "این نه دیگه، این اکزم های خشکه"
    },
    {
      "id": 113,
      "start": 22478.0,
      "end": 22479.0,
      "formatted_start": "06:14:38.000",
      "formatted_end": "06:14:39.000",
      "text": "خشکه؟"
    },
    {
      "id": 114,
      "start": 22479.0,
      "end": 22481.0,
      "formatted_start": "06:14:39.000",
      "formatted_end": "06:14:41.000",
      "text": "این طریق خشکه"
    },
    {
      "id": 115,
      "start": 22481.0,
      "end": 22482.0,
      "formatted_start": "06:14:41.000",
      "formatted_end": "06:14:42.000",
      "text": "از این صحت داده"
    },
    {
      "id": 116,
      "start": 22482.0,
      "end": 22486.0,
      "formatted_start": "06:14:42.000",
      "formatted_end": "06:14:46.000",
      "text": "سابون داره، بچه استفاده کنه سابون گل سیرین"
    },
    {
      "id": 117,
      "start": 22486.0,
      "end": 22491.0,
      "formatted_start": "06:14:46.000",
      "formatted_end": "06:14:51.000",
      "text": "ولی اینه، بچه ها اینا نگیرن چون درد سر عذیت میشه تا خوش میشه"
    },
    {
      "id": 118,
      "start": 22491.0,
      "end": 22494.0,
      "formatted_start": "06:14:51.000",
      "formatted_end": "06:14:54.000",
      "text": "خورستون هم شیوه خوردنش اینجوریه که"
    },
    {
      "id": 119,
      "start": 22494.0,
      "end": 22498.0,
      "formatted_start": "06:14:54.000",
      "formatted_end": "06:14:58.000",
      "text": "امشب ستا میخوره، هفته دیگه هم ستا"
    },
    {
      "id": 120,
      "start": 22498.0,
      "end": 22500.0,
      "formatted_start": "06:14:58.000",
      "formatted_end": "06:15:00.000",
      "text": "یه پاماده"
    }
  ],
  "status": "completed"
}