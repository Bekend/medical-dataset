      "start": 9240.0,
      "end": 9245.0,
      "formatted_start": "02:34:00.000",
      "formatted_end": "02:34:05.000",
      "text": "برم میتونه بزنه اگه نتونست بزنه بس سرکاری برد بزنیم بریم"
    },
    {
      "id": 71,
      "start": 9245.0,
      "end": 9247.0,
      "formatted_start": "02:34:05.000",
      "formatted_end": "02:34:07.000",
      "text": "چون همونجا موبت بیدن"
    },
    {
      "id": 72,
      "start": 9247.0,
      "end": 9249.0,
      "formatted_start": "02:34:07.000",
      "formatted_end": "02:34:09.000",
      "text": "همونجا کجا بینم؟"
    },
    {
      "id": 73,
      "start": 9249.0,
      "end": 9254.0,
      "formatted_start": "02:34:09.000",
      "formatted_end": "02:34:14.000",
      "text": "ایمارس هم هزار پسر میدونه همونجا سیتی میکنیم"
    },
    {
      "id": 74,
      "start": 9254.0,
      "end": 9258.0,
      "formatted_start": "02:34:14.000",
      "formatted_end": "02:34:18.000",
      "text": "برم نیم ساعت بشین برد بید برد بزنیم"
    },
    {
      "id": 75,
      "start": 9258.0,
      "end": 9260.0,
      "formatted_start": "02:34:18.000",
      "formatted_end": "02:34:20.000",
      "text": "باید بید باشیم"
    },
    {
      "id": 76,
      "start": 9260.0,
      "end": 9261.0,
      "formatted_start": "02:34:20.000",
      "formatted_end": "02:34:21.000",
      "text": "بس اینکه باشه"
    },
    {
      "id": 77,
      "start": 9261.0,
      "end": 9263.0,
      "formatted_start": "02:34:21.000",
      "formatted_end": "02:34:23.000",
      "text": "اینها رو بیاری با خوره ات باشه"
    },
    {
      "id": 78,
      "start": 9263.0,
      "end": 9264.0,
      "formatted_start": "02:34:23.000",
      "formatted_end": "02:34:24.000",
      "text": "باشه"
    },
    {
      "id": 79,
      "start": 9264.0,
      "end": 9266.0,
      "formatted_start": "02:34:24.000",
      "formatted_end": "02:34:26.000",
      "text": "اینکه امروز میگیره باز بباره بیام؟"
    },
    {
      "id": 80,
      "start": 9266.0,
      "end": 9272.0,
      "formatted_start": "02:34:26.000",
      "formatted_end": "02:34:32.000",
      "text": "باید بیاری ببینیم. برم بشین و با همین پله آسانسور بری و ببینیم چه کار کنیم"
    },
    {
      "id": 81,
      "start": 9274.0,
      "end": 9278.0,
      "formatted_start": "02:34:34.000",
      "formatted_end": "02:34:38.000",
      "text": "بده خوندو تو برای شوهر باید میتونیم دویر چیز برمیدیم"
    },
    {
      "id": 82,
      "start": 9278.0,
      "end": 9279.0,
      "formatted_start": "02:34:38.000",
      "formatted_end": "02:34:39.000",
      "text": "چند ساله تونن؟"
    },
    {
      "id": 83,
      "start": 9279.0,
      "end": 9281.0,
      "formatted_start": "02:34:39.000",
      "formatted_end": "02:34:41.000",
      "text": "همه نرم شد چه ساله"
    },
    {
      "id": 84,
      "start": 9281.0,
      "end": 9284.0,
      "formatted_start": "02:34:41.000",
      "formatted_end": "02:34:44.000",
      "text": "چه ساله؟ زیاد پیست. بعد هرمانه تو چیم کردی؟"
    },
    {
      "id": 85,
      "start": 9284.0,
      "end": 9288.0,
      "formatted_start": "02:34:44.000",
      "formatted_end": "02:34:48.000",
      "text": "آره ما خیلی برازم نیمیدیم. شوهر باید یه دونه دو سال داریم تو هرمانه شوهر باشم"
    },
    {
      "id": 86,
      "start": 9288.0,
      "end": 9289.0,
      "formatted_start": "02:34:48.000",
      "formatted_end": "02:34:49.000",
      "text": "آه بچه داری؟"
    },
    {
      "id": 87,
      "start": 9289.0,
      "end": 9290.0,
      "formatted_start": "02:34:49.000",
      "formatted_end": "02:34:50.000",
      "text": "آره یه دونه"
    },
    {
      "id": 88,
      "start": 9290.0,
      "end": 9292.0,
      "formatted_start": "02:34:50.000",
      "formatted_end": "02:34:52.000",
      "text": "براتم همین بوده؟"
    },
    {
      "id": 89,
      "start": 9292.0,
      "end": 9293.0,
      "formatted_start": "02:34:52.000",
      "formatted_end": "02:34:53.000",
      "text": "نه"
    },
    {
      "id": 90,
      "start": 9293.0,
      "end": 9294.0,
      "formatted_start": "02:34:53.000",
      "formatted_end": "02:34:54.000",
      "text": "اینو اون از یه شهر دیگه داری؟"
    },
    {
      "id": 91,
      "start": 9294.0,
      "end": 9295.0,
      "formatted_start": "02:34:54.000",
      "formatted_end": "02:34:55.000",
      "text": "نه نه"
    },
    {
      "id": 92,
      "start": 9295.0,
      "end": 9299.0,
      "formatted_start": "02:34:55.000",
      "formatted_end": "02:34:59.000",
      "text": "خب الا که صانبیت داده این کامل این نام بارواریت همه"
    },
    {
      "id": 93,
      "start": 9299.0,
      "end": 9300.0,
      "formatted_start": "02:34:59.000",
      "formatted_end": "02:35:00.000",
      "text": "اگه ولش بره"
    }
  ],
  "status": "completed"
}