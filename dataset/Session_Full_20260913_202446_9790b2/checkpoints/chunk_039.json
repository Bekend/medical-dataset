  "stt_segments": [
    {
      "id": 0,
      "start": 11700.0,
      "end": 11702.0,
      "formatted_start": "03:15:00.000",
      "formatted_end": "03:15:02.000",
      "text": "از اینجا باید کار رو انجام بدهیم و برنامه کنیم."
    },
    {
      "id": 1,
      "start": 11702.0,
      "end": 11704.0,
      "formatted_start": "03:15:02.000",
      "formatted_end": "03:15:04.000",
      "text": "اما همه همه همه دست به برنامه کنیم."
    },
    {
      "id": 2,
      "start": 11704.0,
      "end": 11706.0,
      "formatted_start": "03:15:04.000",
      "formatted_end": "03:15:06.000",
      "text": "اولا مونم خودتون"
    },
    {
      "id": 3,
      "start": 11706.0,
      "end": 11710.0,
      "formatted_start": "03:15:06.000",
      "formatted_end": "03:15:10.000",
      "text": "دکتر اینجور سوام بگوید برسال رو میتونید برسال رو بگیرد"
    },
    {
      "id": 4,
      "start": 11710.0,
      "end": 11711.0,
      "formatted_start": "03:15:10.000",
      "formatted_end": "03:15:11.000",
      "text": "نه نه"
    },
    {
      "id": 5,
      "start": 11711.0,
      "end": 11714.0,
      "formatted_start": "03:15:11.000",
      "formatted_end": "03:15:14.000",
      "text": "این هم خودش میخواد اگر بعد کپسول و پولستاتو چشم بگیرد"
    },
    {
      "id": 6,
      "start": 11714.0,
      "end": 11715.0,
      "formatted_start": "03:15:14.000",
      "formatted_end": "03:15:15.000",
      "text": "چشم بگیرد؟"
    },
    {
      "id": 7,
      "start": 11715.0,
      "end": 11717.0,
      "formatted_start": "03:15:15.000",
      "formatted_end": "03:15:17.000",
