  "stt_segments": [
    {
      "id": 0,
      "start": 22800.0,
      "end": 22811.0,
      "formatted_start": "06:20:00.000",
      "formatted_end": "06:20:11.000",
      "text": "بازم حالا میخوای من دوتون مورد از همین پرسنم، فردا به من جا خوابم، فردا بگو من میپرسم و اشون بهتون میگم."
    },
    {
      "id": 1,
      "start": 22811.0,
      "end": 22825.0,
      "formatted_start": "06:20:11.000",
      "formatted_end": "06:20:25.000",
      "text": "شمارت رو دست قرار کنشی بذار، فردا ساعت یک، اگه یادم آورد، همونجا بهش سنگ بزنم، بپرسم، و از بهتون میگم چون دیگه قرار بود چیزه، بهتون میگم آیا میشه یا غرش میشه."
    },
    {
      "id": 2,
      "start": 22825.0,
      "end": 22829.8,
      "formatted_start": "06:20:25.000",
      "formatted_end": "06:20:29.800",
      "text": "چون الان چون کسی نمیده از این یه پسر اومد و میگی اصلا مشکل مرده داره"
    },
    {
      "id": 3,
      "start": 22829.8,
      "end": 22833.96,
      "formatted_start": "06:20:29.800",
      "formatted_end": "06:20:33.960",
      "text": "و پیروز دیدم که اومد میرو مصابه دیدم یه بامیش استفاده میشه"
    },
    {
      "id": 4,
      "start": 22833.96,
      "end": 22837.56,
      "formatted_start": "06:20:33.960",
      "formatted_end": "06:20:37.560",
      "text": "اصلا تجربه داره اصلا کم داره چون میرو نیست"
    },
    {
      "id": 5,
      "start": 22837.56,
      "end": 22840.44,
      "formatted_start": "06:20:37.560",
      "formatted_end": "06:20:40.440",
      "text": "چرا خاصی اونو اونقدر تحتش میده او از اینجا؟"
    },
    {
      "id": 6,
      "start": 22840.44,
      "end": 22841.64,
      "formatted_start": "06:20:40.440",
      "formatted_end": "06:20:41.640",
      "text": "با باشن از آن نه"
    },
    {
      "id": 7,
      "start": 22841.64,
      "end": 22846.52,
      "formatted_start": "06:20:41.640",
      "formatted_end": "06:20:46.520",
      "text": "یه بامیش اون راحت میده امسایه به این قرار دادی هم پیمانی شیشت پنج ساله میپرد"
    },
    {
      "id": 8,
      "start": 22846.52,
      "end": 22848.44,
      "formatted_start": "06:20:46.520",
      "formatted_end": "06:20:48.440",
      "text": "یه بامیش استفاده هم نیست خب"
    },
    {
      "id": 9,
      "start": 22848.44,
      "end": 22854.44,
      "formatted_start": "06:20:48.440",
      "formatted_end": "06:20:54.440",
      "text": "برای این الان هم نظریت خرابه خود می آمدید که بطیق هرکی هم نمیدونه چون با خوشته بشه نسبشون"
    },
    {
      "id": 10,
      "start": 22854.44,
      "end": 22857.44,
      "formatted_start": "06:20:54.440",
      "formatted_end": "06:20:57.440",
      "text": "می گویند و الان از این می آمدید که از خودو چند ها میشه، می بینند"
    },
    {
      "id": 11,
      "start": 22857.44,
      "end": 22861.44,
      "formatted_start": "06:20:57.440",
      "formatted_end": "06:21:01.440",
      "text": "کار تو سختیه، کار تو استخدامی سخته"
    },
    {
      "id": 12,
      "start": 22861.44,
      "end": 22865.44,
      "formatted_start": "06:21:01.440",
      "formatted_end": "06:21:05.440",
      "text": "باز اگه مثلا پیزهش تصمیمتش چقدره؟"
    },
    {
      "id": 13,
      "start": 22865.44,
      "end": 22866.44,
      "formatted_start": "06:21:05.440",
      "formatted_end": "06:21:06.440",
      "text": "دیپرون"
    },
    {
      "id": 14,
      "start": 22866.44,
      "end": 22870.44,
      "formatted_start": "06:21:06.440",
      "formatted_end": "06:21:10.440",
      "text": "دیپرون سخته، اگه لسانس یا دکتر باشه باز روحتر می بینند"
    },
    {
      "id": 15,
      "start": 22870.44,
      "end": 22873.44,
      "formatted_start": "06:21:10.440",
      "formatted_end": "06:21:13.440",
      "text": "کسی نمیدونه استخدامی شد"
    },
    {
      "id": 16,
      "start": 22873.44,
      "end": 22875.44,
      "formatted_start": "06:21:13.440",
      "formatted_end": "06:21:15.440",
      "text": "در این وقت که دوستان باشد و چی باید بفراد؟"
    },
    {
      "id": 17,
      "start": 22875.44,
      "end": 22877.44,
      "formatted_start": "06:21:15.440",
      "formatted_end": "06:21:17.440",
      "text": "دیگه هموقت چهار ماه گرد"
    },
    {
      "id": 18,
      "start": 22877.44,
      "end": 22881.44,
      "formatted_start": "06:21:17.440",
      "formatted_end": "06:21:21.440",
      "text": "در چون تهران به خودتون برم اصبتیشون"
    },
    {
      "id": 19,
      "start": 22881.44,
      "end": 22884.44,
      "formatted_start": "06:21:21.440",
      "formatted_end": "06:21:24.440",
      "text": "دیگه در خود خودشون که اگه بتداشتن برگرد"
    },
    {
      "id": 20,
      "start": 22884.44,
      "end": 22886.44,
      "formatted_start": "06:21:24.440",
      "formatted_end": "06:21:26.440",
      "text": "بعد ببینید همه چهار ماه بخواد زده"
    },
    {
      "id": 21,
      "start": 22886.44,
      "end": 22889.44,
      "formatted_start": "06:21:26.440",
      "formatted_end": "06:21:29.440",
      "text": "سی بار رفت"
    },
    {
      "id": 22,
      "start": 22889.44,
      "end": 22891.44,
      "formatted_start": "06:21:29.440",
      "formatted_end": "06:21:31.440",
      "text": "باز سیر باید ترکان"
    },
    {
      "id": 23,
      "start": 22891.44,
      "end": 22893.44,
      "formatted_start": "06:21:31.440",
      "formatted_end": "06:21:33.440",
      "text": "من تو نیستم این چیزها"
    },
    {
      "id": 24,
      "start": 22893.44,
      "end": 22895.44,
      "formatted_start": "06:21:33.440",
      "formatted_end": "06:21:35.440",
      "text": "دیگه من دیگه چیزهایی بهش میبزنم"
    },
    {
      "id": 25,
      "start": 22895.44,
      "end": 22897.44,
      "formatted_start": "06:21:35.440",
      "formatted_end": "06:21:37.440",
      "text": "اینقدر زجش دادن"
    },
    {
      "id": 26,
      "start": 22897.44,
      "end": 22903.44,
      "formatted_start": "06:21:37.440",
      "formatted_end": "06:21:43.440",
      "text": "دیگه متاسفانه تو فراج اگه تو تیمشون نباشی همینه خانم دکتر دیگه خواهدتون"
    },
    {
      "id": 27,
      "start": 22903.44,
      "end": 22909.44,
      "formatted_start": "06:21:43.440",
      "formatted_end": "06:21:49.440",
      "text": "دیگه خب اینم چون زدهش اینجا از همه سادرکاش بالاتره درجه نظامشانستان شیست سا زاده هم بود"
    },
    {
      "id": 28,
      "start": 22909.44,
      "end": 22912.44,
      "formatted_start": "06:21:49.440",
      "formatted_end": "06:21:52.440",
      "text": "میرچانه بود دیگه میتونه را از سادرکاش بالا میردید"
    },
    {
      "id": 29,
      "start": 22912.44,
      "end": 22915.44,
      "formatted_start": "06:21:52.440",
      "formatted_end": "06:21:55.440",
      "text": "خیلی زشکش کرده مشانه"
    },
    {
      "id": 30,
      "start": 22915.44,
      "end": 22919.44,
      "formatted_start": "06:21:55.440",
      "formatted_end": "06:21:59.440",
      "text": "الان عمرا فول میدن، نکارانه بشونه"
    },
    {
      "id": 31,
      "start": 22919.44,
      "end": 22921.44,
      "formatted_start": "06:21:59.440",
      "formatted_end": "06:22:01.440",
      "text": "آه به خدا بابدار که"
    },
    {
      "id": 32,
      "start": 22921.44,
      "end": 22927.44,
      "formatted_start": "06:22:01.440",
      "formatted_end": "06:22:07.440",
      "text": "از اینجا همه چیز کامل نیست"
    },
    {
      "id": 33,
      "start": 22927.44,
      "end": 22931.44,
      "formatted_start": "06:22:07.440",
      "formatted_end": "06:22:11.440",
      "text": "در فردا میشه"
    },
    {
      "id": 34,
      "start": 22931.44,
      "end": 22935.44,
      "formatted_start": "06:22:11.440",
      "formatted_end": "06:22:15.440",
      "text": "در فردا از این وقت"
    },
    {
      "id": 35,
      "start": 22935.44,
      "end": 22939.44,
      "formatted_start": "06:22:15.440",
      "formatted_end": "06:22:19.440",
      "text": "مواندش از سیروز هست"
    },
    {
      "id": 36,
      "start": 22939.44,
      "end": 22943.44,
      "formatted_start": "06:22:19.440",
      "formatted_end": "06:22:23.440",
      "text": "چیز بود که در کبد شد"
    },
    {
      "id": 37,
      "start": 22943.44,
      "end": 22947.44,
      "formatted_start": "06:22:23.440",
      "formatted_end": "06:22:27.440",
      "text": "من خود رو برداشت"
    },
    {
      "id": 38,
      "start": 22947.44,
      "end": 22949.44,
      "formatted_start": "06:22:27.440",
      "formatted_end": "06:22:29.440",
      "text": "انظمه های کبدی داردن همه چیز نداشت"
    },
    {
      "id": 39,
      "start": 22949.44,
      "end": 22951.44,
      "formatted_start": "06:22:29.440",
      "formatted_end": "06:22:31.440",
      "text": "بوده شد"
    },
    {
      "id": 40,
      "start": 22951.44,
      "end": 22957.44,
      "formatted_start": "06:22:31.440",
      "formatted_end": "06:22:37.440",
      "text": "چون او اگه بخواستن چیز باشه"
    },
    {
      "id": 41,
      "start": 22957.44,
      "end": 22961.44,
      "formatted_start": "06:22:37.440",
      "formatted_end": "06:22:41.440",
      "text": "نه هیپاتیب باشه"
    },
    {
      "id": 42,
      "start": 22961.44,
      "end": 22963.44,
      "formatted_start": "06:22:41.440",
      "formatted_end": "06:22:43.440",
      "text": "به همه پرسیدم"
    },
    {
      "id": 43,
      "start": 22963.44,
      "end": 22965.44,
      "formatted_start": "06:22:43.440",
      "formatted_end": "06:22:45.440",
      "text": "نه هیپاتیب نداشت"
    },
    {
      "id": 44,
      "start": 22965.44,
      "end": 22967.44,
      "formatted_start": "06:22:45.440",
      "formatted_end": "06:22:47.440",
      "text": "نه"
    },
    {
      "id": 45,
      "start": 22967.44,
      "end": 22969.44,
      "formatted_start": "06:22:47.440",
      "formatted_end": "06:22:49.440",
      "text": "پرسش من سخت بودم"
    },
    {
      "id": 46,
      "start": 22969.44,
      "end": 22973.44,
      "formatted_start": "06:22:49.440",
      "formatted_end": "06:22:53.440",
      "text": "شوشتنه بشدم سه تا همون"
    },
    {
      "id": 47,
      "start": 22973.44,
      "end": 22975.44,
      "formatted_start": "06:22:53.440",
      "formatted_end": "06:22:55.440",
      "text": "سه تا همون بودم"
    },
    {
      "id": 48,
      "start": 22975.44,
      "end": 22979.94,
      "formatted_start": "06:22:55.440",
      "formatted_end": "06:22:59.940",
      "text": "خاندکتر من بابا قندش فارغ رو دادیم"
    },
    {
      "id": 49,
      "start": 22979.94,
      "end": 22983.44,
      "formatted_start": "06:22:59.940",
      "formatted_end": "06:23:03.440",
      "text": "هر شب ده واحد میزنه"
    },
    {
      "id": 50,
      "start": 22983.44,
      "end": 22985.44,
      "formatted_start": "06:23:03.440",
      "formatted_end": "06:23:05.440",
      "text": "قندش اومده پایین سی سد شده"
    },
    {
      "id": 51,
      "start": 22985.44,
      "end": 22987.44,
      "formatted_start": "06:23:05.440",
      "formatted_end": "06:23:07.440",
      "text": "یه صبح میتونم بدن ده واحد دیر"
    },
    {
      "id": 52,
      "start": 22987.44,
      "end": 22989.44,
      "formatted_start": "06:23:07.440",
      "formatted_end": "06:23:09.440",
      "text": "مثلا"
    },
    {
      "id": 53,
      "start": 22989.44,
      "end": 22991.44,
      "formatted_start": "06:23:09.440",
      "formatted_end": "06:23:11.440",
      "text": "چکه قنده که سی سده؟"
    },
    {
      "id": 54,
      "start": 22991.44,
      "end": 22993.44,
      "formatted_start": "06:23:11.440",
      "formatted_end": "06:23:13.440",
      "text": "برنامه برده بزنیم"
    },
    {
      "id": 55,
      "start": 22993.44,
      "end": 22995.44,
      "formatted_start": "06:23:13.440",
      "formatted_end": "06:23:15.440",
      "text": "خب همونز باید دوتا اضافه کنیم"
    },
    {
      "id": 56,
      "start": 22995.44,
      "end": 22997.44,
      "formatted_start": "06:23:15.440",
      "formatted_end": "06:23:17.440",
      "text": "یه برنامه از خانم شفایی بگیر"
    },
    {
      "id": 57,
      "start": 22997.44,
      "end": 22999.44,
      "formatted_start": "06:23:17.440",
      "formatted_end": "06:23:19.440",
      "text": "پرون پرون کن بیار انسای ناشتن زده"
    },
    {
      "id": 58,
      "start": 22999.44,
      "end": 23001.44,
      "formatted_start": "06:23:19.440",
      "formatted_end": "06:23:21.440",
      "text": "کش انسای کشم بزن"
    },
    {
      "id": 59,
      "start": 23001.44,
      "end": 23003.44,
      "formatted_start": "06:23:21.440",
      "formatted_end": "06:23:23.440",
      "text": "بله من فورس ویدیو سیزه"
    },
    {
      "id": 60,
      "start": 23003.44,
      "end": 23005.44,
      "formatted_start": "06:23:23.440",
      "formatted_end": "06:23:25.440",
      "text": "اینکه این نیز هم یکم خوابون برده"
    },
    {
      "id": 61,
      "start": 23005.44,
      "end": 23007.44,
      "formatted_start": "06:23:25.440",
      "formatted_end": "06:23:27.440",
      "text": "چون در واقع باید خوارشتون رو قطع کنیم"
    },
    {
      "id": 62,
      "start": 23007.44,
      "end": 23009.44,
      "formatted_start": "06:23:27.440",
      "formatted_end": "06:23:29.440",
      "text": "پیدگه این انتشارش متوقف بشه"
    },
    {
      "id": 63,
      "start": 23009.44,
      "end": 23011.44,
      "formatted_start": "06:23:29.440",
      "formatted_end": "06:23:31.440",
      "text": "چون با ایجاد خوارش بخش بشه"
    },
    {
      "id": 64,
      "start": 23011.44,
      "end": 23013.44,
      "formatted_start": "06:23:31.440",
      "formatted_end": "06:23:33.440",
      "text": "بعد از نهار و شامب"
    },
    {
      "id": 65,
      "start": 23013.44,
      "end": 23015.44,
      "formatted_start": "06:23:33.440",
      "formatted_end": "06:23:35.440",
      "text": "یکم خوابتون بیده"
    },
    {
      "id": 66,
      "start": 23029.44,
      "end": 23031.44,
      "formatted_start": "06:23:49.440",
      "formatted_end": "06:23:51.440",
      "text": "نهار و شامب"
    },
    {
      "id": 67,
      "start": 23031.44,
      "end": 23033.44,
      "formatted_start": "06:23:51.440",
      "formatted_end": "06:23:53.440",
      "text": "ممنون بابا تو"
    },
    {
      "id": 68,
      "start": 23033.44,
      "end": 23035.44,
      "formatted_start": "06:23:53.440",
      "formatted_end": "06:23:55.440",
      "text": "بابا تو خود باید باید اینجا بگیر"
    },
    {
      "id": 69,
      "start": 23035.44,
      "end": 23037.44,
      "formatted_start": "06:23:55.440",
      "formatted_end": "06:23:57.440",
      "text": "چارت قند رو بگیر خب بگیر"
    },
    {
      "id": 70,
      "start": 23037.44,
      "end": 23039.44,
      "formatted_start": "06:23:57.440",
      "formatted_end": "06:23:59.440",
      "text": "بگیر شما بگیر بگیر چقدر اصوله زدی"
    },
    {
      "id": 71,
      "start": 23039.44,
      "end": 23041.44,
      "formatted_start": "06:23:59.440",
      "formatted_end": "06:24:01.440",
      "text": "باید بیرون اصوله شو"
    },
    {
      "id": 72,
      "start": 23041.44,
      "end": 23043.44,
      "formatted_start": "06:24:01.440",
      "formatted_end": "06:24:03.440",
      "text": "همونو که بهشون دادیم هر شکل در واقعی رو میزنیم"
    },
    {
      "id": 73,
      "start": 23043.44,
      "end": 23045.44,
      "formatted_start": "06:24:03.440",
      "formatted_end": "06:24:05.440",
      "text": "یک خود رو باید به پانگانده شوابه بزنیم"
    },
    {
      "id": 74,
      "start": 23045.44,
      "end": 23047.44,
      "formatted_start": "06:24:05.440",
      "formatted_end": "06:24:07.440",
      "text": "باید برون ست درسته"
    },
    {
      "id": 75,
      "start": 23047.44,
      "end": 23049.44,
      "formatted_start": "06:24:07.440",
      "formatted_end": "06:24:09.440",
      "text": "خب برای همگی دیگه باید چارت داشته باشید"
    },
    {
      "id": 76,
      "start": 23049.44,
      "end": 23051.44,
      "formatted_start": "06:24:09.440",
      "formatted_end": "06:24:11.440",
      "text": "برای تنظیم باشیم، بعد من به تنظیم باشم"
    },
    {
      "id": 77,
      "start": 23051.44,
      "end": 23053.44,
      "formatted_start": "06:24:11.440",
      "formatted_end": "06:24:13.440",
      "text": "تنظیم؟ خیلی خوشکار"
    },
    {
      "id": 78,
      "start": 23053.44,
      "end": 23055.44,
      "formatted_start": "06:24:13.440",
      "formatted_end": "06:24:15.440",
      "text": "ممنون، چکر"
    },
    {
      "id": 79,
      "start": 23055.44,
      "end": 23057.44,
      "formatted_start": "06:24:15.440",
      "formatted_end": "06:24:17.440",
      "text": "خوشکار"
    },
    {
      "id": 80,
      "start": 23057.44,
      "end": 23059.44,
      "formatted_start": "06:24:17.440",
      "formatted_end": "06:24:19.440",
      "text": "چی به چارتقند بشون؟ یه چارتقند"
    },
    {
      "id": 81,
      "start": 23059.44,
      "end": 23061.44,
      "formatted_start": "06:24:19.440",
      "formatted_end": "06:24:21.440",
      "text": "خانم علی خانم شفت"
    },
    {
      "id": 82,
      "start": 23061.44,
      "end": 23063.44,
      "formatted_start": "06:24:21.440",
      "formatted_end": "06:24:23.440",
      "text": "آرشان باید بشین"
    },
    {
      "id": 83,
      "start": 23063.44,
      "end": 23065.44,
      "formatted_start": "06:24:23.440",
      "formatted_end": "06:24:25.440",
      "text": "خانم"
    },
    {
      "id": 84,
      "start": 23065.44,
      "end": 23067.44,
      "formatted_start": "06:24:25.440",
      "formatted_end": "06:24:27.440",
      "text": "خانم که همون رو بیرون فهمید"
    },
    {
      "id": 85,
      "start": 23067.44,
      "end": 23069.44,
      "formatted_start": "06:24:27.440",
      "formatted_end": "06:24:29.440",
      "text": "علی خانم چرا باشت؟"
    },
    {
      "id": 86,
      "start": 23069.44,
      "end": 23071.44,
      "formatted_start": "06:24:29.440",
      "formatted_end": "06:24:31.440",
      "text": "آره"
    },
    {
      "id": 87,
      "start": 23071.44,
      "end": 23073.44,
      "formatted_start": "06:24:31.440",
      "formatted_end": "06:24:33.440",
      "text": "دستگاه روشنگ برم"
    },
    {
      "id": 88,
      "start": 23073.44,
      "end": 23075.44,
      "formatted_start": "06:24:33.440",
      "formatted_end": "06:24:35.440",
      "text": "دستگاه روشنگ برم"
    },
    {
      "id": 89,
      "start": 23075.44,
      "end": 23077.44,
      "formatted_start": "06:24:35.440",
      "formatted_end": "06:24:37.440",
      "text": "خانم دکتور"
    },
    {
      "id": 90,
      "start": 23077.44,
      "end": 23079.44,
      "formatted_start": "06:24:37.440",
      "formatted_end": "06:24:39.440",
      "text": "اینجا باید بردارید که خوب بگوید"
    },
    {
      "id": 91,
      "start": 23079.44,
      "end": 23082.44,
      "formatted_start": "06:24:39.440",
      "formatted_end": "06:24:42.440",
      "text": "این برای چهار دقیقاً در مورد خوب"
    },
    {
      "id": 92,
      "start": 23082.44,
      "end": 23083.44,
      "formatted_start": "06:24:42.440",
      "formatted_end": "06:24:43.440",
      "text": "خانم"
    },
    {
      "id": 93,
      "start": 23083.44,
      "end": 23087.44,
      "formatted_start": "06:24:43.440",
      "formatted_end": "06:24:47.440",
      "text": "برد انترونی رو با شما بشتد"
    },
    {
      "id": 94,
      "start": 23087.44,
      "end": 23088.44,
      "formatted_start": "06:24:47.440",
      "formatted_end": "06:24:48.440",
      "text": "خوب"
    },
    {
      "id": 95,
      "start": 23088.44,
      "end": 23090.44,
      "formatted_start": "06:24:48.440",
      "formatted_end": "06:24:50.440",
      "text": "الان میشه نباید باید ببینید چجا چون بشد"
    },
    {
      "id": 96,
      "start": 23090.44,
      "end": 23091.44,
      "formatted_start": "06:24:50.440",
      "formatted_end": "06:24:51.440",
      "text": "و انترونی رو چه بازر دارن"
    },
    {
      "id": 97,
      "start": 23091.44,
      "end": 23093.44,
      "formatted_start": "06:24:51.440",
      "formatted_end": "06:24:53.440",
      "text": "خونه او رو باید بیدا کنم"
    },
    {
      "id": 98,
      "start": 23095.44,
      "end": 23097.44,
      "formatted_start": "06:24:55.440",
      "formatted_end": "06:24:57.440",
      "text": "مشکلش باناست"
    },
    {
      "id": 99,
      "start": 23097.44,
      "end": 23099.44,
      "formatted_start": "06:24:57.440",
      "formatted_end": "06:24:59.440",
      "text": "برد ببینید که شما شد چند تا"
    }
  ],
  "status": "completed"
}