      "end": 1855.4,
      "formatted_start": "00:30:30.000",
      "formatted_end": "00:30:55.400",
      "text": "بفهمه"
    },
    {
      "id": 2,
      "start": 1855.4,
      "end": 1856.48,
      "formatted_start": "00:30:55.400",
      "formatted_end": "00:30:56.480",
      "text": "سلام"
    },
    {
      "id": 3,
      "start": 1856.48,
      "end": 1858.48,
      "formatted_start": "00:30:56.480",
      "formatted_end": "00:30:58.480",
      "text": "بسیار خوب"
    },
    {
      "id": 4,
      "start": 1858.48,
      "end": 1860.48,
      "formatted_start": "00:30:58.480",
      "formatted_end": "00:31:00.480",
      "text": "چی شده خانم کوکن؟"
    },
    {
      "id": 5,
      "start": 1860.48,
      "end": 1862.48,
      "formatted_start": "00:31:00.480",
      "formatted_end": "00:31:02.480",
      "text": "دختر از ندید"
    },
    {
      "id": 6,
      "start": 1862.48,
      "end": 1864.48,
      "formatted_start": "00:31:02.480",
      "formatted_end": "00:31:04.480",
      "text": "یک هفته درد می کنیم"
    },
    {
      "id": 7,
      "start": 1864.48,
      "end": 1866.48,
      "formatted_start": "00:31:04.480",
      "formatted_end": "00:31:06.480",
      "text": "دو دفعه دکتر دارم"
    },
    {
      "id": 8,
      "start": 1866.48,
      "end": 1868.48,
      "formatted_start": "00:31:06.480",
      "formatted_end": "00:31:08.480",
      "text": "یک هفته تب داره"
    },
    {
      "id": 9,
      "start": 1868.48,
      "end": 1870.48,
      "formatted_start": "00:31:08.480",
      "formatted_end": "00:31:10.480",
      "text": "چی دیدی؟ دو دفعه دکتر"
    },
    {
      "id": 10,
      "start": 1870.48,
      "end": 1872.48,
      "formatted_start": "00:31:10.480",
      "formatted_end": "00:31:12.480",
      "text": "دیگه؟"
    },
    {
      "id": 11,
      "start": 1872.48,
      "end": 1874.48,
      "formatted_start": "00:31:12.480",
      "formatted_end": "00:31:14.480",
      "text": "خب غیر از تب چه مشکلی داره؟"
    },
    {
      "id": 12,
      "start": 1874.48,
      "end": 1876.48,
      "formatted_start": "00:31:14.480",
      "formatted_end": "00:31:16.480",
      "text": "حالا تهبو برام می آرد"
    },
    {
      "id": 13,
      "start": 1876.48,
      "end": 1878.48,
      "formatted_start": "00:31:16.480",
      "formatted_end": "00:31:18.480",
      "text": "سردرد"
    },
    {
      "id": 14,
      "start": 1878.48,
      "end": 1880.48,
      "formatted_start": "00:31:18.480",
      "formatted_end": "00:31:20.480",
      "text": "سردرد"
    },
    {
      "id": 15,
      "start": 1880.48,
      "end": 1882.48,
      "formatted_start": "00:31:20.480",
      "formatted_end": "00:31:22.480",
      "text": "بعد تهبو سردرد"
    },
    {
      "id": 16,
      "start": 1882.48,
      "end": 1884.48,
      "formatted_start": "00:31:22.480",
      "formatted_end": "00:31:24.480",
      "text": "بعد اصحال اینا چی؟"
    },
    {
      "id": 17,
      "start": 1884.48,
      "end": 1886.48,
      "formatted_start": "00:31:24.480",
      "formatted_end": "00:31:26.480",
      "text": "درست می کنه؟"
    },
    {
      "id": 18,
      "start": 1886.48,
      "end": 1888.48,
      "formatted_start": "00:31:26.480",
      "formatted_end": "00:31:28.480",
      "text": "بیشتر پیشانی و آینا رو بگم"
    },
    {
      "id": 19,
      "start": 1888.48,
      "end": 1890.48,
      "formatted_start": "00:31:28.480",
      "formatted_end": "00:31:30.480",
      "text": "صبح درت می کنی یا غروبا؟"
    },
    {
      "id": 20,
      "start": 1890.48,
      "end": 1894.48,
      "formatted_start": "00:31:30.480",
      "formatted_end": "00:31:34.480",
      "text": "از پنجشنبه بعد از ظهر این سرددش بشه"
    },
    {
      "id": 21,
      "start": 1894.48,
      "end": 1896.48,
      "formatted_start": "00:31:34.480",
      "formatted_end": "00:31:36.480",
      "text": "صبح بعد از ظهرش فرق نداره؟"
    },
    {
      "id": 22,
      "start": 1896.48,
      "end": 1897.48,
      "formatted_start": "00:31:36.480",
      "formatted_end": "00:31:37.480",
      "text": "نه"
    },
    {
      "id": 23,
      "start": 1897.48,
      "end": 1900.48,
      "formatted_start": "00:31:37.480",
      "formatted_end": "00:31:40.480",
      "text": "طبش تو یه هفتهه ولی سردد یک دو روزه"
    },
    {
      "id": 24,
      "start": 1900.48,
      "end": 1902.48,
      "formatted_start": "00:31:40.480",
      "formatted_end": "00:31:42.480",
      "text": "بیا اینجا با اینجا"
    },
    {
      "id": 25,
      "start": 1902.48,
      "end": 1904.48,
      "formatted_start": "00:31:42.480",
      "formatted_end": "00:31:44.480",
      "text": "طب بشین بفهم"
    },
    {
      "id": 26,
      "start": 1904.48,
      "end": 1906.48,
      "formatted_start": "00:31:44.480",
      "formatted_end": "00:31:46.480",
      "text": "زیاده کم میشه؟"
    },
    {
      "id": 27,
      "start": 1906.48,
      "end": 1908.48,
      "formatted_start": "00:31:46.480",
      "formatted_end": "00:31:48.480",
      "text": "آره"
    },
    {
      "id": 28,
      "start": 1910.48,
      "end": 1912.48,
      "formatted_start": "00:31:50.480",
      "formatted_end": "00:31:52.480",
      "text": "دنتو باز کن"
    },
    {
      "id": 29,
      "start": 1912.48,
      "end": 1915.48,
      "formatted_start": "00:31:52.480",
      "formatted_end": "00:31:55.480",
      "text": "من اینکه بیشتر مشکلی نداره"
    },
    {
      "id": 30,
      "start": 1915.48,
      "end": 1918.48,
      "formatted_start": "00:31:55.480",
      "formatted_end": "00:31:58.480",
      "text": "خداونده که از اینجا باشه"
    },
    {
