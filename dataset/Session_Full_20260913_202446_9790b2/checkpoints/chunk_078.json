  "stt_segments": [
    {
      "id": 0,
      "start": 23400.0,
      "end": 23405.0,
      "formatted_start": "06:30:00.000",
      "formatted_end": "06:30:05.000",
      "text": "اصلا اینگه هم برای همه آدم هایی افزار به تمام انسان های دنیا همینطوریه."
    },
    {
      "id": 1,
      "start": 23405.0,
      "end": 23408.0,
      "formatted_start": "06:30:05.000",
      "formatted_end": "06:30:08.000",
      "text": "امرا تا از این اسفرانیت هم خودت هم خسته شده."
    },
    {
      "id": 2,
      "start": 23408.0,
      "end": 23415.0,
      "formatted_start": "06:30:08.000",
      "formatted_end": "06:30:15.000",
      "text": "تا که... تا که این بچه راه میتوانه من ریگرم شواره هر... اصلا این بچه از چونه زده؟"
    },
    {
      "id": 3,
      "start": 23415.0,
      "end": 23416.0,
      "formatted_start": "06:30:15.000",
      "formatted_end": "06:30:16.000",
      "text": "بسیار."
    },
    {
      "id": 4,
      "start": 23416.0,
      "end": 23418.0,
      "formatted_start": "06:30:16.000",
      "formatted_end": "06:30:18.000",
      "text": "خودم خیلی از این موضوع ندارد."
    },
    {
      "id": 5,
      "start": 23418.0,
      "end": 23419.0,
      "formatted_start": "06:30:18.000",
      "formatted_end": "06:30:19.000",
      "text": "نمیتونم."
    },
    {
      "id": 6,
      "start": 23419.0,
      "end": 23426.0,
      "formatted_start": "06:30:19.000",
      "formatted_end": "06:30:26.000",
      "text": "همین دیگه در وضعیتتون میکنه. در واقع این حس عذابش داره و بعدش شما خیلی ازش میته."
    },
    {
      "id": 7,
      "start": 23430.0,
      "end": 23433.5,
      "formatted_start": "06:30:30.000",
      "formatted_end": "06:30:33.500",
      "text": "یا یه مورد اصلا یه حرفی بعضی وقتی"
    },
    {
      "id": 8,
      "start": 23433.5,
      "end": 23436.5,
      "formatted_start": "06:30:33.500",
      "formatted_end": "06:30:36.500",
      "text": "ببین سیرتولین و دپامین مغز دست ما نیست"
    },
    {
      "id": 9,
      "start": 23436.5,
      "end": 23441.34,
      "formatted_start": "06:30:36.500",
      "formatted_end": "06:30:41.340",
      "text": "ما مریض دیابیتی رو راحت میپردیدیم در جامعه"
    },
    {
      "id": 10,
      "start": 23441.34,
      "end": 23444.42,
      "formatted_start": "06:30:41.340",
      "formatted_end": "06:30:44.420",
      "text": "ولی کسی که سیرتولینش پایینه و افزوردگی"
    },
    {
      "id": 11,
      "start": 23444.42,
      "end": 23446.74,
      "formatted_start": "06:30:44.420",
      "formatted_end": "06:30:46.740",
      "text": "و خب این در واقع دست فرقی"
    },
    {
      "id": 12,
      "start": 23446.74,
      "end": 23448.82,
      "formatted_start": "06:30:46.740",
      "formatted_end": "06:30:48.820",
      "text": "یه آدم افزوردگی باید تلاش کنش"
    },
    {
      "id": 13,
      "start": 23448.82,
      "end": 23450.54,
      "formatted_start": "06:30:48.820",
      "formatted_end": "06:30:50.540",
      "text": "همه چی دست شما نیست"
    },
    {
      "id": 14,
      "start": 23450.54,
      "end": 23454.14,
      "formatted_start": "06:30:50.540",
      "formatted_end": "06:30:54.140",
      "text": "وقتی شما مدت طولانی دارید این شهرها دیدید"
    },
    {
      "id": 15,
      "start": 23454.14,
      "end": 23455.6,
      "formatted_start": "06:30:54.140",
      "formatted_end": "06:30:55.600",
      "text": "سیرتولین و مغزتون پایینه"
    },
    {
      "id": 16,
      "start": 23455.6,
      "end": 23457.6,
      "formatted_start": "06:30:55.600",
      "formatted_end": "06:30:57.600",
      "text": "این باید از دیگر و بارک نشوند"
    },
    {
      "id": 17,
      "start": 23457.6,
      "end": 23461.6,
      "formatted_start": "06:30:57.600",
      "formatted_end": "06:31:01.600",
      "text": "دست شغال نیست مقصد هم شغال نیست"
    },
    {
      "id": 18,
      "start": 23461.6,
      "end": 23463.6,
      "formatted_start": "06:31:01.600",
      "formatted_end": "06:31:03.600",
      "text": "یک نفر دیابیتی میشه مقصد خودشه"
    },
    {
      "id": 19,
      "start": 23463.6,
      "end": 23465.6,
      "formatted_start": "06:31:03.600",
      "formatted_end": "06:31:05.600",
      "text": "اینو برگیرم"
    },
    {
      "id": 20,
      "start": 23465.6,
      "end": 23467.6,
      "formatted_start": "06:31:05.600",
      "formatted_end": "06:31:07.600",
      "text": "اون روزو خیلی میخوام"
    },
    {
      "id": 21,
      "start": 23467.6,
      "end": 23469.6,
      "formatted_start": "06:31:07.600",
      "formatted_end": "06:31:09.600",
      "text": "دو این خمیزه نیست"
    },
    {
      "id": 22,
      "start": 23469.6,
      "end": 23471.6,
      "formatted_start": "06:31:09.600",
      "formatted_end": "06:31:11.600",
      "text": "دو این روزو که برای شما اصلا خواب آبار نیست"
    },
    {
      "id": 23,
      "start": 23471.6,
      "end": 23473.6,
      "formatted_start": "06:31:11.600",
      "formatted_end": "06:31:13.600",
      "text": "میخوام همینجور من درس هم میخونم"
    },
    {
      "id": 24,
      "start": 23473.6,
      "end": 23475.6,
      "formatted_start": "06:31:13.600",
      "formatted_end": "06:31:15.600",
      "text": "دو این روزو اصلا خواب آبار نیست"
    },
    {
      "id": 25,
      "start": 23475.6,
      "end": 23477.6,
      "formatted_start": "06:31:15.600",
      "formatted_end": "06:31:17.600",
      "text": "دو این خمیزه نیست"
    },
    {
      "id": 26,
      "start": 23477.6,
      "end": 23479.6,
      "formatted_start": "06:31:17.600",
      "formatted_end": "06:31:19.600",
      "text": "دو این میخوام"
    },
    {
      "id": 27,
      "start": 23479.6,
      "end": 23481.6,
      "formatted_start": "06:31:19.600",
      "formatted_end": "06:31:21.600",
      "text": "دو این خمیزه نیست"
    },
    {
      "id": 28,
      "start": 23481.6,
      "end": 23485.6,
      "formatted_start": "06:31:21.600",
      "formatted_end": "06:31:25.600",
      "text": "این کهتنگامش از به قدر وزن بالا هم ناشد نیست؟"
    },
    {
      "id": 29,
      "start": 23485.6,
      "end": 23491.6,
      "formatted_start": "06:31:25.600",
      "formatted_end": "06:31:31.600",
      "text": "وزن بالا میتونه اختلال خواب بده و اختلال خواب میتونه خستگی دائم بده"
    },
    {
      "id": 30,
      "start": 23491.6,
      "end": 23502.6,
      "formatted_start": "06:31:31.600",
      "formatted_end": "06:31:42.600",
      "text": "ولی وزن که میوز کنید، رژیم میرمیده ها که از از هر کیلو که کم میکنم حال دلم خوب میشه، افتاد نشات دارم، اصلا کاملا تو چهره ماشه"
    },
    {
      "id": 31,
      "start": 23502.6,
      "end": 23506.6,
      "formatted_start": "06:31:42.600",
      "formatted_end": "06:31:46.600",
      "text": "آفنه اتخابتون کم میشه، میگم که افتاد خواب بالا میدون"
    },
    {
      "id": 32,
      "start": 23506.6,
      "end": 23511.6,
      "formatted_start": "06:31:46.600",
      "formatted_end": "06:31:51.600",
      "text": "داروی که براتون نوشتم شروع که خواهش وزنی بده"
    },
    {
      "id": 33,
      "start": 23511.6,
      "end": 23514.6,
      "formatted_start": "06:31:51.600",
      "formatted_end": "06:31:54.600",
      "text": "اشتهادتون نمیخوای کم برم"
    },
    {
      "id": 34,
      "start": 23514.6,
      "end": 23516.6,
      "formatted_start": "06:31:54.600",
      "formatted_end": "06:31:56.600",
      "text": "چون من متحجب به وزن شرایطتون نمیشم"
    },
    {
      "id": 35,
      "start": 23516.6,
      "end": 23518.6,
      "formatted_start": "06:31:56.600",
      "formatted_end": "06:31:58.600",
      "text": "یک خواهور نماشه دومون که"
    },
    {
      "id": 36,
      "start": 23518.6,
      "end": 23520.6,
      "formatted_start": "06:31:58.600",
      "formatted_end": "06:32:00.600",
      "text": "دیگه همون تعمل داشته باشه"
    },
    {
      "id": 37,
      "start": 23520.6,
      "end": 23523.6,
      "formatted_start": "06:32:00.600",
      "formatted_end": "06:32:03.600",
      "text": "اگر ناسم مانکه دارو بهتون نسازه"
    },
    {
      "id": 38,
      "start": 23523.6,
      "end": 23526.6,
      "formatted_start": "06:32:03.600",
      "formatted_end": "06:32:06.600",
      "text": "یه وقت هوایی بده یه وقت فوزای اول شاید خواهدتون بگیر"
    },
    {
      "id": 39,
      "start": 23526.6,
      "end": 23528.6,
      "formatted_start": "06:32:06.600",
      "formatted_end": "06:32:08.600",
      "text": "بخواد آرامشی که میده نبخواد تا رسید"
    },
    {
      "id": 40,
      "start": 23528.6,
      "end": 23558.6,
      "formatted_start": "06:32:08.600",
      "formatted_end": "06:32:38.600",
