    },
    {
      "id": 71,
      "start": 5329.0,
      "end": 5335.0,
      "formatted_start": "01:28:49.000",
      "formatted_end": "01:28:55.000",
      "text": "سابقه این هایپا تیرویدی کم کنید"
    },
    {
      "id": 72,
      "start": 5335.0,
      "end": 5337.0,
      "formatted_start": "01:28:55.000",
      "formatted_end": "01:28:57.000",
      "text": "پروپت نیست"
    },
    {
      "id": 73,
      "start": 5337.0,
      "end": 5341.0,
      "formatted_start": "01:28:57.000",
      "formatted_end": "01:29:01.000",
      "text": "پروپت اینجا چون نوشته هایپا تیرویدی است"
    },
    {
      "id": 74,
      "start": 5341.0,
      "end": 5343.0,
      "formatted_start": "01:29:01.000",
      "formatted_end": "01:29:03.000",
      "text": "خوبه در صورت"
    },
    {
      "id": 75,
      "start": 5343.0,
      "end": 5345.0,
      "formatted_start": "01:29:03.000",
      "formatted_end": "01:29:05.000",
      "text": "برای حال کنترلی"
    },
    {
      "id": 76,
      "start": 5345.0,
      "end": 5347.0,
      "formatted_start": "01:29:05.000",
      "formatted_end": "01:29:07.000",
      "text": "برای من نظر بگیم"
    },
    {
      "id": 77,
      "start": 5347.0,
      "end": 5349.0,
      "formatted_start": "01:29:07.000",
      "formatted_end": "01:29:09.000",
      "text": "آره اوکی"
    },
    {
      "id": 78,
      "start": 5349.0,
      "end": 5351.0,
      "formatted_start": "01:29:09.000",
      "formatted_end": "01:29:11.000",
      "text": "بعد به وقتی فشارتون نمیدونیم"
    },
    {
      "id": 79,
      "start": 5351.0,
      "end": 5352.0,
      "formatted_start": "01:29:11.000",
      "formatted_end": "01:29:12.000",
      "text": "چند؟"
    },
    {
      "id": 80,
      "start": 5352.0,
      "end": 5353.0,
      "formatted_start": "01:29:12.000",
      "formatted_end": "01:29:13.000",
      "text": "چند درسته هم از شما بسته"
    },
    {
      "id": 81,
      "start": 5353.0,
      "end": 5357.0,
      "formatted_start": "01:29:13.000",
      "formatted_end": "01:29:17.000",
      "text": "آه فشارتون خوبه، زبانبالتون هم خوبه، یکم سرس دارید"
    },
    {
      "id": 82,
      "start": 5357.0,
      "end": 5368.0,
      "formatted_start": "01:29:17.000",
      "formatted_end": "01:29:28.000",
      "text": "بگذاری کم کن، آینا هم ناماله، کلیه خوبه، آنزیمای کبت خوبه، خفونت خیمت نداری، ادرارت هم"
    },
    {
      "id": 83,
      "start": 5368.0,
      "end": 5370.0,
      "formatted_start": "01:29:28.000",
      "formatted_end": "01:29:30.000",
      "text": "سوزش داری ادرار؟"
    },
    {
      "id": 84,
      "start": 5370.0,
      "end": 5371.0,
      "formatted_start": "01:29:30.000",
      "formatted_end": "01:29:31.000",
      "text": "ندارم"
    },
    {
      "id": 85,
      "start": 5371.0,
      "end": 5375.0,
      "formatted_start": "01:29:31.000",
      "formatted_end": "01:29:35.000",
      "text": "چه خفونت شدید زده؟ خفونت خیلی شدید"
    },
    {
      "id": 86,
      "start": 5375.0,
      "end": 5400.0,
