    },
    {
      "id": 49,
      "start": 5266.0,
      "end": 5269.0,
      "formatted_start": "01:27:46.000",
      "formatted_end": "01:27:49.000",
      "text": "تمام سایتای بیموها خرچ شده شده"
    },
    {
      "id": 50,
      "start": 5269.0,
      "end": 5270.0,
      "formatted_start": "01:27:49.000",
      "formatted_end": "01:27:50.000",
      "text": "ببینیم چه اتفاق میام"
    },
    {
      "id": 51,
      "start": 5270.0,
      "end": 5272.0,
      "formatted_start": "01:27:50.000",
      "formatted_end": "01:27:52.000",
      "text": "بس باشه با ما تماس میگیم کدوم به همون"
    },
    {
      "id": 52,
      "start": 5272.0,
      "end": 5273.0,
      "formatted_start": "01:27:52.000",
      "formatted_end": "01:27:53.000",
      "text": "آره خدا با همون"
    },
    {
      "id": 53,
      "start": 5273.0,
      "end": 5274.0,
      "formatted_start": "01:27:53.000",
      "formatted_end": "01:27:54.000",
      "text": "بس چی باده"
    },
    {
      "id": 54,
      "start": 5274.0,
      "end": 5277.0,
      "formatted_start": "01:27:54.000",
      "formatted_end": "01:27:57.000",
      "text": "آره خدا با همون کار نجستیم بگیر بس باشه حتما دست داریم رفت همه رو انجام میدیم"
    },
    {
      "id": 55,
      "start": 5277.0,
      "end": 5279.0,
      "formatted_start": "01:27:57.000",
      "formatted_end": "01:27:59.000",
      "text": "خدا با همون دست چی باده"
    },
    {
