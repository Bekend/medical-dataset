    },
    {
      "id": 21,
      "start": 5146.0,
      "end": 5148.0,
      "formatted_start": "01:25:46.000",
      "formatted_end": "01:25:48.000",
      "text": "بسیار خواهد باشی"
    },
    {
      "id": 22,
      "start": 5148.0,
      "end": 5150.0,
      "formatted_start": "01:25:48.000",
      "formatted_end": "01:25:50.000",
      "text": "بسیار خواهد باشی"
    },
    {
      "id": 23,
      "start": 5150.0,
      "end": 5157.0,
      "formatted_start": "01:25:50.000",
      "formatted_end": "01:25:57.000",
      "text": "این تاولایی که من که برای اینکه خیلی کار می کردم، این تاولایی که اصلا ترتمیز کنم پانه و روز"
    },
    {
      "id": 24,
      "start": 5157.0,
      "end": 5159.0,
      "formatted_start": "01:25:57.000",
      "formatted_end": "01:25:59.000",
      "text": "از که چکا برده؟"
    },
    {
      "id": 25,
      "start": 5159.0,
      "end": 5161.0,
      "formatted_start": "01:25:59.000",
      "formatted_end": "01:26:01.000",
      "text": "کنم که شکم هایی می شوند"
    },
    {
      "id": 26,
      "start": 5161.0,
      "end": 5163.0,
      "formatted_start": "01:26:01.000",
      "formatted_end": "01:26:03.000",
      "text": "که چکا برم از برد برم شب"
    },
    {
      "id": 27,
      "start": 5163.0,
      "end": 5167.0,
      "formatted_start": "01:26:03.000",
      "formatted_end": "01:26:07.000",
      "text": "کورسای ویبون من و اینجور چیزا واسه تقویتی بازش هست؟"
    },
    {
      "id": 28,
      "start": 5167.0,
      "end": 5170.0,
      "formatted_start": "01:26:07.000",
      "formatted_end": "01:26:10.000",
      "text": "بزار ببینم چیاش کمه، بعد کنم او"
    },
    {
      "id": 29,
      "start": 5170.0,
      "end": 5174.0,
      "formatted_start": "01:26:10.000",
      "formatted_end": "01:26:14.000",
      "text": "چون ببینم شاید اصلا ماما کم برم میشن، بهتون ای دیگه بود"
    },
    {
      "id": 30,
      "start": 5174.0,
      "end": 5204.0,
      "formatted_start": "01:26:14.000",
      "formatted_end": "01:26:44.000",
      "text": "بگو بگو بگو بگو بگو بگو بگو بگو بگو بگو بگو بگو بگو بگو بگو بگو بگو بگو بگو بگو بگو بگو بگو بگو بگو بگو بگو بگو بگو بگو بگو بگو بگو بگو بگو بگو بگو بگو بگو بگو بگو بگو بگو بگو بگو بگو بگو بگو بگو بگو بگو بگو بگو بگو بگو بگو بگو بگو بگو بگو بگو بگو بگو بگو بگو بگو بگو بگو بگو بگو بگو بگو بگو بگو ب"
    },
    {
      "id": 31,
      "start": 5204.0,
      "end": 5206.0,
      "formatted_start": "01:26:44.000",
      "formatted_end": "01:26:46.000",
      "text": "برنامه باید براتون تماس بگیرم."
    },
    {
      "id": 32,
      "start": 5206.0,
      "end": 5208.0,
      "formatted_start": "01:26:46.000",
      "formatted_end": "01:26:48.000",
      "text": "یک چکار براتون می نوستم؟"
    },
    {
      "id": 33,
      "start": 5208.0,
      "end": 5210.0,
      "formatted_start": "01:26:48.000",
      "formatted_end": "01:26:50.000",
      "text": "ناشتا بدیم، داراتون نوستم، پنتو پروزور بزاریم، کار کن کن."
    },
    {
      "id": 34,
      "start": 5210.0,
      "end": 5212.0,
      "formatted_start": "01:26:50.000",
      "formatted_end": "01:26:52.000",
      "text": "برنامه خانداشتون، یک بست، یک ورق هیرویت هم ببینید؟"
    },
    {
      "id": 35,
      "start": 5212.0,
      "end": 5242.0,
      "formatted_start": "01:26:52.000",
      "formatted_end": "01:27:22.000",
      "text": "بعد باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید با"
    },
    {
      "id": 36,
      "start": 5242.0,
      "end": 5245.06,
      "formatted_start": "01:27:22.000",
      "formatted_end": "01:27:25.060",
      "text": "424-92-17"
    },
    {
      "id": 37,
      "start": 5246.1,
      "end": 5248.0,
      "formatted_start": "01:27:26.100",
      "formatted_end": "01:27:28.000",
      "text": "باش عزیز تماس بیان خوب"
    },
    {
      "id": 38,
      "start": 5248.0,
      "end": 5249.0,
      "formatted_start": "01:27:28.000",
      "formatted_end": "01:27:29.000",
      "text": "باش عزیز"
    },
    {
      "id": 39,
      "start": 5249.0,
      "end": 5250.0,
      "formatted_start": "01:27:29.000",
      "formatted_end": "01:27:30.000",
      "text": "سلامت باش عزیز"
    },
    {
      "id": 40,
      "start": 5250.0,
      "end": 5252.0,
      "formatted_start": "01:27:30.000",
      "formatted_end": "01:27:32.000",
      "text": "و چه کام من باز"
    },
    {
      "id": 41,
      "start": 5252.0,
      "end": 5253.0,
      "formatted_start": "01:27:32.000",
      "formatted_end": "01:27:33.000",
      "text": "بعدم برم چه کام"
    },
    {
      "id": 42,
      "start": 5253.0,
      "end": 5255.0,
      "formatted_start": "01:27:33.000",
      "formatted_end": "01:27:35.000",
      "text": "چه کام بتونه برج جدیدی از فردا بری"
    },
    {
      "id": 43,
      "start": 5255.0,
      "end": 5256.0,
      "formatted_start": "01:27:35.000",
      "formatted_end": "01:27:36.000",
