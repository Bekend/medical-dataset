      "start": 5258.0,
      "end": 5261.0,
      "formatted_start": "01:27:38.000",
      "formatted_end": "01:27:41.000",
      "text": "بس امروز مانیم تو این داروانو بگیریم"
    },
    {
      "id": 47,
      "start": 5261.0,
      "end": 5263.0,
      "formatted_start": "01:27:41.000",
      "formatted_end": "01:27:43.000",
      "text": "اطلاعا چرا این داروان بس میشه؟"
    },
