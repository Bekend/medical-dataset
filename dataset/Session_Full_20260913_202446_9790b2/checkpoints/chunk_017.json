  "stt_segments": [
    {
      "id": 0,
      "start": 5100.0,
      "end": 5102.0,
      "formatted_start": "01:25:00.000",
      "formatted_end": "01:25:02.000",
      "text": "سیمی، سیست افراری نداشتی؟"
    },
    {
      "id": 1,
      "start": 5102.0,
      "end": 5105.0,
      "formatted_start": "01:25:02.000",
      "formatted_end": "01:25:05.000",
      "text": "نه، شما برای من اسکن نمیشتید، یادتون باشید."
    },
    {
      "id": 2,
      "start": 5105.0,
      "end": 5106.0,
      "formatted_start": "01:25:05.000",
      "formatted_end": "01:25:06.000",
      "text": "آه، خوب بود، آنها؟"
    },
    {
      "id": 3,
      "start": 5106.0,
      "end": 5111.0,
      "formatted_start": "01:25:06.000",
      "formatted_end": "01:25:11.000",
      "text": "آه، خوب بود، آنها، خوب بود، باید بگوییم که مثلا این مشکل در چیز دارم."
    },
    {
      "id": 4,
      "start": 5111.0,
      "end": 5112.0,
      "formatted_start": "01:25:11.000",
      "formatted_end": "01:25:12.000",
      "text": "مطبوع."
    },
    {
      "id": 5,
      "start": 5112.0,
      "end": 5115.0,
      "formatted_start": "01:25:12.000",
      "formatted_end": "01:25:15.000",
      "text": "آنها کار کنه، من بخوری کار نمی کنم؟"
    },
    {
      "id": 6,
      "start": 5115.0,
      "end": 5118.0,
      "formatted_start": "01:25:15.000",
      "formatted_end": "01:25:18.000",
      "text": "شما وقت تماه کردن، من جلدشم گم کردم."
    },
    {
      "id": 7,
      "start": 5118.0,
      "end": 5120.0,
      "formatted_start": "01:25:18.000",
      "formatted_end": "01:25:20.000",
      "text": "اصلا کار کن تو نباید تماه کن."
    },
    {
      "id": 8,
      "start": 5120.0,
      "end": 5122.0,
      "formatted_start": "01:25:20.000",
      "formatted_end": "01:25:22.000",
      "text": "آره، من هم اشتباه کردم، جلدشم گم کردم."
    },
    {
      "id": 9,
      "start": 5122.0,
      "end": 5125.0,
      "formatted_start": "01:25:22.000",
      "formatted_end": "01:25:25.000",
      "text": "از آریان برای منتقل"
    },
    {
      "id": 10,
      "start": 5125.0,
      "end": 5127.0,
      "formatted_start": "01:25:25.000",
      "formatted_end": "01:25:27.000",
      "text": "آریان برای منتقل"
    },
    {
      "id": 11,
      "start": 5127.0,
      "end": 5129.0,
      "formatted_start": "01:25:27.000",
      "formatted_end": "01:25:29.000",
      "text": "پس زیر چشم هم یه هفته است"
    },
    {
      "id": 12,
      "start": 5129.0,
      "end": 5131.0,
      "formatted_start": "01:25:29.000",
      "formatted_end": "01:25:31.000",
      "text": "اینجوری یه خون میشون"
    },
    {
      "id": 13,
      "start": 5131.0,
      "end": 5133.0,
      "formatted_start": "01:25:31.000",
      "formatted_end": "01:25:33.000",
      "text": "یه خون زیر چشم هم کبور شد و آنه بکنه"
    },
    {
      "id": 14,
      "start": 5133.0,
      "end": 5135.0,
      "formatted_start": "01:25:33.000",
      "formatted_end": "01:25:35.000",
      "text": "خونی زیر چیزی داری؟"
    },
    {
      "id": 15,
      "start": 5135.0,
      "end": 5136.0,
      "formatted_start": "01:25:35.000",
      "formatted_end": "01:25:36.000",
      "text": "نه"
    },
    {
      "id": 16,
      "start": 5136.0,
      "end": 5138.0,
      "formatted_start": "01:25:36.000",
      "formatted_end": "01:25:38.000",
      "text": "خیلی خیلی حساسیتی باشی"
    },
    {
      "id": 17,
      "start": 5138.0,
      "end": 5140.0,
      "formatted_start": "01:25:38.000",
      "formatted_end": "01:25:40.000",
      "text": "بسیار خواهد باشی"
    },
    {
      "id": 18,
      "start": 5140.0,
      "end": 5142.0,
      "formatted_start": "01:25:40.000",
      "formatted_end": "01:25:42.000",
      "text": "بسیار خواهد باشی"
    },
    {
      "id": 19,
      "start": 5142.0,
      "end": 5144.0,
      "formatted_start": "01:25:42.000",
      "formatted_end": "01:25:44.000",
      "text": "بسیار خواهد باشی"
    },
    {
      "id": 20,
      "start": 5144.0,
      "end": 5146.0,
      "formatted_start": "01:25:44.000",
      "formatted_end": "01:25:46.000",
