      "start": 5290.0,
      "end": 5291.0,
      "formatted_start": "01:28:10.000",
      "formatted_end": "01:28:11.000",
      "text": "بس چی باده"
    },
    {
      "id": 68,
      "start": 5321.0,
      "end": 5323.0,
      "formatted_start": "01:28:41.000",
      "formatted_end": "01:28:43.000",
      "text": "این جرائه جنگی است"
    },
    {
      "id": 69,
      "start": 5323.0,
      "end": 5327.0,
      "formatted_start": "01:28:43.000",
      "formatted_end": "01:28:47.000",
      "text": "جرائه های کشی دختران برخورده است"
    },
    {
      "id": 70,
      "start": 5327.0,
      "end": 5329.0,
      "formatted_start": "01:28:47.000",
      "formatted_end": "01:28:49.000",
