      "start": 5719.0,
      "end": 5721.0,
      "formatted_start": "01:35:19.000",
      "formatted_end": "01:35:21.000",
      "text": "یه تفسیری؟"
    },
    {
      "id": 7,
      "start": 5721.0,
      "end": 5725.0,
      "formatted_start": "01:35:21.000",
      "formatted_end": "01:35:25.000",
      "text": "۷۷۴، ۷۶، ۹۵"
    },
    {
