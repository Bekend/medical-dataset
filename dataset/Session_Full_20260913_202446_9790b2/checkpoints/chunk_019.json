      "end": 5856.0,
      "formatted_start": "01:37:34.000",
      "formatted_end": "01:37:36.000",
      "text": "پنجاه بار زن زدن"
    },
    {
      "id": 56,
      "start": 5856.0,
      "end": 5860.0,
      "formatted_start": "01:37:36.000",
      "formatted_end": "01:37:40.000",
      "text": "من ما اینقدر توضیح میدیم اینجا"
    },
    {
      "id": 57,
      "start": 5860.0,
      "end": 5862.0,
      "formatted_start": "01:37:40.000",
      "formatted_end": "01:37:42.000",
      "text": "ازا توضیح میدیم بکنم که ایش میشن"
    },
    {
      "id": 58,
      "start": 5863.86,
      "end": 5865.86,
      "formatted_start": "01:37:43.860",
      "formatted_end": "01:37:45.860",
      "text": "مرد داره اون سال رو"
    },
    {
      "id": 59,
      "start": 5865.86,
      "end": 5867.0,
      "formatted_start": "01:37:45.860",
      "formatted_end": "01:37:47.000",
      "text": "این یا ورد هستی"
    },
    {
      "id": 60,
      "start": 5867.0,
      "end": 5868.0,
      "formatted_start": "01:37:47.000",
      "formatted_end": "01:37:48.000",
      "text": "برای کنی"
    },
    {
      "id": 61,
      "start": 5868.0,
      "end": 5870.0,
      "formatted_start": "01:37:48.000",
      "formatted_end": "01:37:50.000",
      "text": "برای این برای کنی همه نشستی"
    },
    {
      "id": 62,
      "start": 5870.0,
      "end": 5872.0,
      "formatted_start": "01:37:50.000",
      "formatted_end": "01:37:52.000",
      "text": "کامگا داریم کنی گفته که"
    },
    {
      "id": 63,
      "start": 5875.0,
      "end": 5877.0,
      "formatted_start": "01:37:55.000",
      "formatted_end": "01:37:57.000",
      "text": "وازارتان هشتاد آزروباستانی"
    },
    {
      "id": 64,
      "start": 5877.0,
      "end": 5879.0,
      "formatted_start": "01:37:57.000",
      "formatted_end": "01:37:59.000",
      "text": "که آیس آفراش نداشتی"
    },
    {
      "id": 65,
      "start": 5879.0,
      "end": 5882.0,
      "formatted_start": "01:37:59.000",
      "formatted_end": "01:38:02.000",
      "text": "مریض همون مرخص کردی"
    },
    {
      "id": 66,
      "start": 5882.0,
      "end": 5885.0,
      "formatted_start": "01:38:02.000",
      "formatted_end": "01:38:05.000",
      "text": "اما تو نمیسیم اونو هم تو فونه نداره خیلی"
    },
    {
      "id": 67,
      "start": 5885.0,
      "end": 5886.0,
      "formatted_start": "01:38:05.000",
      "formatted_end": "01:38:06.000",
      "text": "بعد بهش گفتی قرص فشار"
    },
    {
      "id": 68,
      "start": 5886.0,
      "end": 5888.0,
      "formatted_start": "01:38:06.000",
      "formatted_end": "01:38:08.000",
      "text": "میمونی نداشته"
    },
    {
      "id": 69,
      "start": 5888.0,
      "end": 5891.24,
      "formatted_start": "01:38:08.000",
      "formatted_end": "01:38:11.240",
      "text": "چرا دیگه بابا قبل هم والزارتان میخورد نخورد"
    },
    {
      "id": 70,
      "start": 5891.24,
      "end": 5893.52,
      "formatted_start": "01:38:11.240",
      "formatted_end": "01:38:13.520",
      "text": "آه والزارتان هم هم اینها رو باید خورد"
    },
    {
      "id": 71,
      "start": 5893.52,
      "end": 5895.76,
      "formatted_start": "01:38:13.520",
      "formatted_end": "01:38:15.760",
      "text": "فقط آن فروزمایی دیگه من گفتم آدم"
    },
    {
      "id": 72,
      "start": 5895.76,
      "end": 5896.72,
      "formatted_start": "01:38:15.760",
      "formatted_end": "01:38:16.720",
      "text": "دیگه والزارتان"
    },
    {
      "id": 73,
      "start": 5896.72,
      "end": 5897.22,
      "formatted_start": "01:38:16.720",
      "formatted_end": "01:38:17.220",
      "text": "همینطور چی گفته؟"
    },
    {
      "id": 74,
      "start": 5897.22,
      "end": 5897.72,
      "formatted_start": "01:38:17.220",
      "formatted_end": "01:38:17.720",
      "text": "همینطور چی گفته؟"
    },
    {
      "id": 75,
      "start": 5897.72,
      "end": 5900.92,
      "formatted_start": "01:38:17.720",
      "formatted_end": "01:38:20.920",
      "text": "بارتارتان ۸۰ آیس آرمویدون اقرار میخورد"
    },
    {
      "id": 76,
      "start": 5900.92,
      "end": 5902.92,
      "formatted_start": "01:38:20.920",
      "formatted_end": "01:38:22.920",
      "text": "خب نمیخوام بخور بارتارتان"
    },
    {
      "id": 77,
      "start": 5902.92,
      "end": 5903.42,
      "formatted_start": "01:38:22.920",
      "formatted_end": "01:38:23.420",
      "text": "بگی نانخورم"
    },
    {
      "id": 78,
      "start": 5903.42,
      "end": 5904.92,
      "formatted_start": "01:38:23.420",
      "formatted_end": "01:38:24.920",
      "text": "آترو و آیس آرمویدون بخورد چرا؟"
    },
    {
      "id": 79,
      "start": 5904.92,
      "end": 5906.12,
      "formatted_start": "01:38:24.920",
      "formatted_end": "01:38:26.120",
      "text": "آترو و آیس آرمویدون"
    },
    {
      "id": 80,
      "start": 5906.12,
      "end": 5908.12,
      "formatted_start": "01:38:26.120",
      "formatted_end": "01:38:28.120",
      "text": "ببین شخص چیز براش اضافه کنه"
    },
    {
      "id": 81,
      "start": 5908.12,
      "end": 5911.32,
      "formatted_start": "01:38:28.120",
      "formatted_end": "01:38:31.320",
      "text": "ببین آریان چی گفت دیگه؟ چی شد نتیجهش؟"
    },
    {
      "id": 82,
      "start": 5912.72,
      "end": 5914.12,
      "formatted_start": "01:38:32.720",
      "formatted_end": "01:38:34.120",
      "text": "جان صلاح برسید"
    },
    {
      "id": 83,
      "start": 5914.12,
      "end": 5916.12,
      "formatted_start": "01:38:34.120",
      "formatted_end": "01:38:36.120",
      "text": "باید شوید نسید نسید نشونه باشه"
    },
    {
      "id": 84,
      "start": 5916.12,
      "end": 5917.12,
      "formatted_start": "01:38:36.120",
      "formatted_end": "01:38:37.120",
      "text": "باید بخورم باید بخورم"
    },
    {
      "id": 85,
      "start": 5917.12,
      "end": 5918.12,
      "formatted_start": "01:38:37.120",
      "formatted_end": "01:38:38.120",
      "text": "چطوری باید بگو نمون کنه؟"
    },
    {
      "id": 86,
      "start": 5927.72,
      "end": 5933.72,
      "formatted_start": "01:38:47.720",
      "formatted_end": "01:38:53.720",
      "text": "این داشته ها 75 بود. الان اینجا گریخند در ساعت بعد سوانه. الان ساعت 15 بود."
    },
    {
      "id": 87,
      "start": 5933.72,
      "end": 5935.72,
      "formatted_start": "01:38:53.720",
      "formatted_end": "01:38:55.720",
      "text": "خب اینو باید کم کنیم. شب چند تا میزنیم؟"
    },
    {
      "id": 88,
      "start": 5935.72,
      "end": 5937.72,
      "formatted_start": "01:38:55.720",
      "formatted_end": "01:38:57.720",
      "text": "20 تا میزنیم. اما خیلی غم نداریم."
    },
    {
      "id": 89,
      "start": 5937.72,
      "end": 5939.72,
      "formatted_start": "01:38:57.720",
      "formatted_end": "01:38:59.720",
      "text": "16 تا."
    },
    {
      "id": 90,
      "start": 5939.72,
      "end": 5943.72,
      "formatted_start": "01:38:59.720",
      "formatted_end": "01:39:03.720",
      "text": "اولش یکم سرده بیم. در اینکه مجبوره یک بیمارساست."
    },
    {
      "id": 91,
      "start": 5943.72,
      "end": 5949.72,
      "formatted_start": "01:39:03.720",
      "formatted_end": "01:39:09.720",
      "text": "بیمارسان بودم اینو بینداد. دیدی ای گفتم بیمارسان بیدم. اونو داد که شما میلدن."
    },
    {
      "id": 92,
      "start": 5949.72,
      "end": 5954.72,
      "formatted_start": "01:39:09.720",
      "formatted_end": "01:39:14.720",
      "text": "آره دیدی، آخه نمیشه که اصلا اونو ندارین و ببین خندگار این موضوع"
    },
    {
      "id": 93,
      "start": 5954.72,
      "end": 5956.72,
      "formatted_start": "01:39:14.720",
      "formatted_end": "01:39:16.720",
      "text": "خب 16 تا لازم باشه"
    },
    {
      "id": 94,
      "start": 5956.72,
      "end": 5958.72,
      "formatted_start": "01:39:16.720",
      "formatted_end": "01:39:18.720",
      "text": "نه، همون ساعت دهشم"
    },
    {
      "id": 95,
      "start": 5958.72,
      "end": 5961.72,
      "formatted_start": "01:39:18.720",
      "formatted_end": "01:39:21.720",
      "text": "آف برد، این گفتارو اینجوری کردی"
    },
    {
      "id": 96,
      "start": 5961.72,
      "end": 5962.72,
      "formatted_start": "01:39:21.720",
      "formatted_end": "01:39:22.720",
      "text": "این بیتان کار کنه"
    },
    {
      "id": 97,
      "start": 5962.72,
      "end": 5963.72,
      "formatted_start": "01:39:22.720",
      "formatted_end": "01:39:23.720",
      "text": "خیلی خوب بیده"
    },
    {
      "id": 98,
      "start": 5963.72,
      "end": 5966.72,
      "formatted_start": "01:39:23.720",
      "formatted_end": "01:39:26.720",
      "text": "آره، خب اینکه دیوکارتو خوب شده، همشه که نمی کنه"
    },
    {
      "id": 99,
      "start": 5966.72,
      "end": 5967.72,
      "formatted_start": "01:39:26.720",
      "formatted_end": "01:39:27.720",
      "text": "این یه وسط دیگه دارم"
    },
    {
      "id": 100,
      "start": 5967.72,
      "end": 5968.72,
      "formatted_start": "01:39:27.720",
      "formatted_end": "01:39:28.720",
      "text": "آره"
    },
    {
      "id": 101,
      "start": 5968.72,
      "end": 5969.72,
      "formatted_start": "01:39:28.720",
      "formatted_end": "01:39:29.720",
      "text": "اما اینه همشه بوده"
    },
    {
      "id": 102,
      "start": 5969.72,
      "end": 5970.72,
      "formatted_start": "01:39:29.720",
      "formatted_end": "01:39:30.720",
      "text": "نه، تا آخر بکنه، تموم شده"
    },
    {
      "id": 103,
      "start": 5970.72,
      "end": 5972.72,
      "formatted_start": "01:39:30.720",
      "formatted_end": "01:39:32.720",
      "text": "اینی کار کنه تا بخورن"
    },
    {
      "id": 104,
      "start": 5972.72,
      "end": 5973.72,
      "formatted_start": "01:39:32.720",
      "formatted_end": "01:39:33.720",
      "text": "اینو همیشه کنیم"
    },
    {
      "id": 105,
      "start": 5973.72,
      "end": 5975.72,
      "formatted_start": "01:39:33.720",
      "formatted_end": "01:39:35.720",
      "text": "حالا برایت اینو پرونده ساختید یا نسخه؟"
    },
    {
      "id": 106,
      "start": 5975.72,
      "end": 5977.72,
      "formatted_start": "01:39:35.720",
      "formatted_end": "01:39:37.720",
      "text": "آره، وقت تا بیم دونن"
    },
    {
      "id": 107,
      "start": 5977.72,
      "end": 5980.72,
      "formatted_start": "01:39:37.720",
      "formatted_end": "01:39:40.720",
      "text": "خوب، خیلی خوب دیگه، فقط اینو خودشون زده"
    },
    {
      "id": 108,
      "start": 5980.72,
      "end": 5983.72,
      "formatted_start": "01:39:40.720",
      "formatted_end": "01:39:43.720",
      "text": "بعد اینه همیشه کنید، این شکرار کنن که دیگه"
    },
    {
      "id": 109,
      "start": 5983.72,
      "end": 5987.72,
      "formatted_start": "01:39:43.720",
      "formatted_end": "01:39:47.720",
      "text": "شکرم برد یه روز درمیان، لاغر بیره دید یه روز درمیان کار کنن"
    },
    {
      "id": 110,
      "start": 5987.72,
      "end": 5989.72,
      "formatted_start": "01:39:47.720",
      "formatted_end": "01:39:49.720",
      "text": "خود تنظیم کن"
    },
    {
      "id": 111,
      "start": 5989.72,
      "end": 5991.72,
      "formatted_start": "01:39:49.720",
      "formatted_end": "01:39:51.720",
      "text": "وقتی میدینی مثلا الان دارا هر روز کار میکنی"
    },
    {
      "id": 112,
      "start": 5991.72,
      "end": 5993.72,
      "formatted_start": "01:39:51.720",
      "formatted_end": "01:39:53.720",
      "text": "اینجا باید برگزاری کنید"
    },
    {
      "id": 113,
      "start": 5993.72,
      "end": 5995.72,
      "formatted_start": "01:39:53.720",
      "formatted_end": "01:39:55.720",
      "text": "اینجا باید برگزاری کنید"
    },
    {
      "id": 114,
      "start": 5995.72,
      "end": 5997.72,
      "formatted_start": "01:39:55.720",
      "formatted_end": "01:39:57.720",
      "text": "اینجا باید برگزاری کنید"
    },
    {
      "id": 115,
      "start": 5997.72,
      "end": 5999.72,
      "formatted_start": "01:39:57.720",
      "formatted_end": "01:39:59.720",
      "text": "اینجا باید برگزاری کنید"
    }
  ],
  "status": "completed"
}