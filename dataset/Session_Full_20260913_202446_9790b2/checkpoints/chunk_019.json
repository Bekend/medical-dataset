    },
    {
      "id": 28,
      "start": 5796.0,
      "end": 5798.0,
      "formatted_start": "01:36:36.000",
      "formatted_end": "01:36:38.000",
      "text": "از اینجا باید برنامه باید بسیار داریم"
    },
    {
      "id": 29,
      "start": 5798.0,
      "end": 5800.0,
      "formatted_start": "01:36:38.000",
      "formatted_end": "01:36:40.000",
      "text": "چرا؟"
    },
    {
      "id": 30,
      "start": 5800.0,
      "end": 5803.0,
      "formatted_start": "01:36:40.000",
      "formatted_end": "01:36:43.000",
      "text": "از درمیان باز میره توری که شدن"
    },
    {
      "id": 31,
      "start": 5803.0,
      "end": 5806.0,
      "formatted_start": "01:36:43.000",
      "formatted_end": "01:36:46.000",
      "text": "برای اون یه هفته دیگه با اونها"
    },
    {
      "id": 32,
      "start": 5806.0,
      "end": 5809.0,
      "formatted_start": "01:36:46.000",
      "formatted_end": "01:36:49.000",
      "text": "من تا زکای سی توری هستم"
    },
    {
      "id": 33,
      "start": 5809.0,
      "end": 5810.0,
      "formatted_start": "01:36:49.000",
      "formatted_end": "01:36:50.000",
