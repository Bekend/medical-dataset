    },
    {
      "id": 40,
      "start": 5822.0,
      "end": 5825.0,
      "formatted_start": "01:37:02.000",
      "formatted_end": "01:37:05.000",
      "text": "برسه دار و اینو گفتی آخر هفته"
    },
    {
      "id": 41,
      "start": 5825.0,
      "end": 5827.0,
      "formatted_start": "01:37:05.000",
      "formatted_end": "01:37:07.000",
      "text": "سه تا با هم دیگه بخوره؟"
    },
    {
      "id": 42,
      "start": 5827.0,
      "end": 5828.0,
      "formatted_start": "01:37:07.000",
      "formatted_end": "01:37:08.000",
      "text": "هر هفته یک بار"
    },
    {
      "id": 43,
      "start": 5828.0,
      "end": 5830.0,
      "formatted_start": "01:37:08.000",
      "formatted_end": "01:37:10.000",
      "text": "هر هفته یه دوره نه"
    },
    {
      "id": 44,
      "start": 5830.0,
      "end": 5834.0,
      "formatted_start": "01:37:10.000",
      "formatted_end": "01:37:14.000",
      "text": "هر هفته سه تا این هفته سه تا هفته بعد"
    },
    {
      "id": 45,
      "start": 5834.0,
      "end": 5836.0,
      "formatted_start": "01:37:14.000",
      "formatted_end": "01:37:16.000",
      "text": "سه تا این هفته سه تا هفته بعد"
    },
    {
      "id": 46,
      "start": 5836.0,
      "end": 5838.0,
      "formatted_start": "01:37:16.000",
      "formatted_end": "01:37:18.000",
      "text": "آره؟"
    },
    {
      "id": 47,
      "start": 5838.0,
      "end": 5840.0,
      "formatted_start": "01:37:18.000",
      "formatted_end": "01:37:20.000",
      "text": "آره"
    },
    {
      "id": 48,
      "start": 5840.0,
      "end": 5842.0,
      "formatted_start": "01:37:20.000",
      "formatted_end": "01:37:22.000",
      "text": "بله"
    },
    {
      "id": 49,
      "start": 5842.0,
      "end": 5844.0,
      "formatted_start": "01:37:22.000",
      "formatted_end": "01:37:24.000",
      "text": "با دفعه سه"
    },
    {
      "id": 50,
      "start": 5844.0,
      "end": 5846.0,
      "formatted_start": "01:37:24.000",
      "formatted_end": "01:37:26.000",
      "text": "چند مرد هم زد؟"
    },
    {
      "id": 51,
      "start": 5846.0,
      "end": 5848.0,
      "formatted_start": "01:37:26.000",
      "formatted_end": "01:37:28.000",
      "text": "دیمونه همون کردم به خدا اینقدر من بهشون میکنم"
    },
    {
      "id": 52,
      "start": 5848.0,
      "end": 5850.0,
      "formatted_start": "01:37:28.000",
      "formatted_end": "01:37:30.000",
      "text": "یکی خورده دستش گز گز میکنه"
    },
    {
      "id": 53,
      "start": 5850.0,
      "end": 5852.0,
      "formatted_start": "01:37:30.000",
      "formatted_end": "01:37:32.000",
      "text": "هر روز داره مکنه"
    },
    {
      "id": 54,
      "start": 5852.0,
      "end": 5854.0,
      "formatted_start": "01:37:32.000",
      "formatted_end": "01:37:34.000",
      "text": "خیلی گناه"
    },
    {
