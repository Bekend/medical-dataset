      "end": 5817.0,
      "formatted_start": "01:36:56.000",
      "formatted_end": "01:36:57.000",
      "text": "اشتباه"
    },
    {
      "id": 38,
      "start": 5818.0,
      "end": 5820.0,
      "formatted_start": "01:36:58.000",
      "formatted_end": "01:37:00.000",
      "text": "همینطور برسه؟ برسه؟"
    },
    {
      "id": 39,
      "start": 5820.0,
      "end": 5821.0,
      "formatted_start": "01:37:00.000",
      "formatted_end": "01:37:01.000",
