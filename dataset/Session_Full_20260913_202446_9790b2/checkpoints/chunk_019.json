    },
    {
      "id": 34,
      "start": 5810.0,
      "end": 5812.0,
      "formatted_start": "01:36:50.000",
      "formatted_end": "01:36:52.000",
      "text": "از درمیان باز میره توری نداشتن"
    },
    {
      "id": 35,
      "start": 5812.0,
      "end": 5814.0,
      "formatted_start": "01:36:52.000",
      "formatted_end": "01:36:54.000",
      "text": "یه پایست هم به هشت روی مداری موجوده"
    },
    {
      "id": 36,
      "start": 5814.0,
      "end": 5816.0,
      "formatted_start": "01:36:54.000",
      "formatted_end": "01:36:56.000",
      "text": "یک موجوده این توپون هست بوده"
    },
