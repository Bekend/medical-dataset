    },
    {
      "id": 26,
      "start": 5792.0,
      "end": 5794.0,
      "formatted_start": "01:36:32.000",
      "formatted_end": "01:36:34.000",
      "text": "از اینجا باید برنامه باید بسیار داریم"
    },
    {
      "id": 27,
      "start": 5794.0,
