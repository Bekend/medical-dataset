  "stt_segments": [
    {
      "id": 0,
      "start": 6300.0,
      "end": 6310.0,
      "formatted_start": "01:45:00.000",
      "formatted_end": "01:45:10.000",
      "text": "از این موضوع هم نرمد استفاده مانید، تخلیم و کفتی یک الان دوبار آن پس بخورید، گوشت قرمز هر دیگه یک بار، چگر و کل پاچه و این هم اصلا افراد."
    },
    {
      "id": 1,
      "start": 6310.0,
      "end": 6313.0,
      "formatted_start": "01:45:10.000",
      "formatted_end": "01:45:13.000",
      "text": "مشابه در سه جو چیز هم که نمی بودید."
    },
    {
      "id": 2,
      "start": 6313.0,
      "end": 6322.0,
      "formatted_start": "01:45:13.000",
      "formatted_end": "01:45:22.000",
      "text": "بعد آزمای قبل بالاست، قبلتون چرپ شده، اتزارم داریم دید از شرکتون بالاست."
    },
    {
      "id": 3,
      "start": 6322.0,
      "end": 6324.0,
      "formatted_start": "01:45:22.000",
      "formatted_end": "01:45:24.000",
      "text": "دستیابه بود"
    },
    {
      "id": 4,
      "start": 6324.0,
      "end": 6326.0,
      "formatted_start": "01:45:24.000",
      "formatted_end": "01:45:26.000",
      "text": "دستیابه بود"
    },
    {
      "id": 5,
      "start": 6326.0,
      "end": 6328.0,
      "formatted_start": "01:45:26.000",
      "formatted_end": "01:45:28.000",
      "text": "قندتون اصلا این کنتر رو نیست"
    },
    {
      "id": 6,
      "start": 6328.0,
      "end": 6330.0,
      "formatted_start": "01:45:28.000",
      "formatted_end": "01:45:30.000",
      "text": "چند قنده؟"
    },
    {
      "id": 7,
      "start": 6330.0,
      "end": 6332.0,
      "formatted_start": "01:45:30.000",
      "formatted_end": "01:45:32.000",
      "text": "سه ماهتون نه و هیفته است"
    },
    {
      "id": 8,
      "start": 6332.0,
      "end": 6334.0,
      "formatted_start": "01:45:32.000",
      "formatted_end": "01:45:34.000",
      "text": "سه ماهه نه و هیفته"
    },
    {
      "id": 9,
      "start": 6334.0,
      "end": 6336.0,
      "formatted_start": "01:45:34.000",
      "formatted_end": "01:45:36.000",
      "text": "یعنی که متوسط قند شما"
    },
    {
      "id": 10,
      "start": 6336.0,
      "end": 6338.0,
      "formatted_start": "01:45:36.000",
      "formatted_end": "01:45:38.000",
      "text": "در سه ماه بزشته چازند"
    },
    {
      "id": 11,
      "start": 6338.0,
      "end": 6340.0,
      "formatted_start": "01:45:38.000",
      "formatted_end": "01:45:40.000",
      "text": "در سه ماه بزشته چازند"
    },
    {
      "id": 12,
      "start": 6340.0,
      "end": 6342.0,
      "formatted_start": "01:45:40.000",
      "formatted_end": "01:45:42.000",
      "text": "در سه ماه بزشته چازند"
    },
    {
      "id": 13,
      "start": 6342.0,
      "end": 6344.0,
      "formatted_start": "01:45:42.000",
      "formatted_end": "01:45:44.000",
      "text": "چرا قند ناشناتونو چک نکردن؟"
    },
    {
      "id": 14,
      "start": 6344.0,
      "end": 6346.0,
      "formatted_start": "01:45:44.000",
      "formatted_end": "01:45:46.000",
      "text": "نه میدونم"
    },
    {
      "id": 15,
      "start": 6346.0,
      "end": 6348.0,
      "formatted_start": "01:45:46.000",
      "formatted_end": "01:45:48.000",
      "text": "بعد یکی چشم بزرگت"
    },
    {
      "id": 16,
      "start": 6348.0,
      "end": 6350.0,
      "formatted_start": "01:45:48.000",
      "formatted_end": "01:45:50.000",
      "text": "تا نویره بخوادید قضایی نداریم"
    },
    {
      "id": 17,
      "start": 6350.0,
      "end": 6354.0,
      "formatted_start": "01:45:50.000",
      "formatted_end": "01:45:54.000",
      "text": "نه، بعد تیرویدتون کمکار شدید داری"
    },
    {
      "id": 18,
      "start": 6354.0,
      "end": 6356.0,
      "formatted_start": "01:45:54.000",
      "formatted_end": "01:45:56.000",
      "text": "برسه نمی کنم"
    },
    {
      "id": 19,
      "start": 6356.0,
      "end": 6358.0,
      "formatted_start": "01:45:56.000",
      "formatted_end": "01:45:58.000",
      "text": "ناشته یک ساعت رایت می کنی؟"
    },
    {
      "id": 20,
      "start": 6358.0,
      "end": 6361.0,
      "formatted_start": "01:45:58.000",
      "formatted_end": "01:46:01.000",
      "text": "چقدر بعدش صبح نمی کنی؟"
    },
    {
      "id": 21,
      "start": 6361.0,
      "end": 6364.0,
      "formatted_start": "01:46:01.000",
      "formatted_end": "01:46:04.000",
      "text": "من از اینکه می کنم بسیار دقیقا بعد نمی کنم"
    },
    {
      "id": 22,
      "start": 6364.0,
      "end": 6366.0,
      "formatted_start": "01:46:04.000",
      "formatted_end": "01:46:06.000",
      "text": "اینجور نخود"
    },
    {
      "id": 23,
      "start": 6366.0,
      "end": 6367.0,
      "formatted_start": "01:46:06.000",
      "formatted_end": "01:46:07.000",
      "text": "نخود"
    },
    {
      "id": 24,
      "start": 6367.0,
      "end": 6369.0,
      "formatted_start": "01:46:07.000",
      "formatted_end": "01:46:09.000",
      "text": "اونو بعد یک ساعت بگذارم"
    },
    {
      "id": 25,
      "start": 6369.0,
      "end": 6373.0,
      "formatted_start": "01:46:09.000",
      "formatted_end": "01:46:13.000",
      "text": "یک الا سه ساعت ناشته، نماز که ویدار می شید بفرین بخوابید"
    },
    {
      "id": 26,
      "start": 6373.0,
      "end": 6374.0,
      "formatted_start": "01:46:13.000",
      "formatted_end": "01:46:14.000",
      "text": "کلم"
    },
    {
      "id": 27,
      "start": 6374.0,
      "end": 6376.0,
      "formatted_start": "01:46:14.000",
      "formatted_end": "01:46:16.000",
      "text": "بعد تیمپرازون چی هست؟"
    },
    {
      "id": 28,
      "start": 6376.0,
      "end": 6378.0,
      "formatted_start": "01:46:16.000",
      "formatted_end": "01:46:18.000",
      "text": "کام، یک ساعت حد اقل فاصله"
    },
    {
      "id": 29,
      "start": 6378.0,
      "end": 6380.0,
      "formatted_start": "01:46:18.000",
      "formatted_end": "01:46:20.000",
      "text": "خونسه ها در این سال درسته ها؟"
    },
    {
      "id": 30,
      "start": 6380.0,
      "end": 6382.0,
      "formatted_start": "01:46:20.000",
      "formatted_end": "01:46:22.000",
      "text": "کلا خونسه هاش بگویم"
    },
    {
      "id": 31,
      "start": 6382.0,
      "end": 6384.0,
      "formatted_start": "01:46:22.000",
      "formatted_end": "01:46:24.000",
      "text": "با این پرازون میخوردی؟"
    },
    {
      "id": 32,
      "start": 6384.0,
      "end": 6386.0,
      "formatted_start": "01:46:24.000",
      "formatted_end": "01:46:26.000",
      "text": "با این پرازون همزا ها میخوردی"
    },
    {
      "id": 33,
      "start": 6386.0,
      "end": 6388.0,
      "formatted_start": "01:46:26.000",
      "formatted_end": "01:46:28.000",
      "text": "خونسه ها در این سال درسته ها بگویم"
    },
    {
      "id": 34,
      "start": 6388.0,
      "end": 6390.0,
      "formatted_start": "01:46:28.000",
      "formatted_end": "01:46:30.000",
      "text": "تا الان این کار درسته نمیخوردی"
    },
    {
      "id": 35,
      "start": 6390.0,
      "end": 6392.0,
      "formatted_start": "01:46:30.000",
      "formatted_end": "01:46:32.000",
      "text": "خونسه ها درسته ها درسته ها"
    },
    {
      "id": 36,
      "start": 6392.0,
      "end": 6394.0,
      "formatted_start": "01:46:32.000",
      "formatted_end": "01:46:34.000",
      "text": "کجا بود؟"
    },
    {
      "id": 37,
      "start": 6394.0,
      "end": 6396.0,
      "formatted_start": "01:46:34.000",
      "formatted_end": "01:46:36.000",
      "text": "از پا فاسده باید داریم"
    },
    {
      "id": 38,
      "start": 6396.0,
      "end": 6398.0,
      "formatted_start": "01:46:36.000",
      "formatted_end": "01:46:38.000",
      "text": "حد اقل یک ساعت"
    },
    {
      "id": 39,
      "start": 6398.0,
      "end": 6406.0,
      "formatted_start": "01:46:38.000",
      "formatted_end": "01:46:46.000",
      "text": "کلم، پاو، طلوب، طروبچه، سویا، شرقم، لبو، ممنون"
    },
    {
      "id": 40,
      "start": 6406.0,
      "end": 6408.0,
      "formatted_start": "01:46:46.000",
      "formatted_end": "01:46:48.000",
      "text": "از اینجا باید بردارید."
    },
    {
      "id": 41,
      "start": 6408.0,
      "end": 6410.0,
      "formatted_start": "01:46:48.000",
      "formatted_end": "01:46:50.000",
      "text": "از اینجا باید بردارید."
    },
    {
      "id": 42,
      "start": 6410.0,
      "end": 6412.0,
      "formatted_start": "01:46:50.000",
      "formatted_end": "01:46:52.000",
      "text": "از اینجا باید بردارید."
    },
    {
      "id": 43,
      "start": 6412.0,
      "end": 6414.0,
      "formatted_start": "01:46:52.000",
      "formatted_end": "01:46:54.000",
      "text": "از اینجا باید بردارید."
    },
    {
      "id": 44,
      "start": 6414.0,
      "end": 6416.0,
      "formatted_start": "01:46:54.000",
      "formatted_end": "01:46:56.000",
      "text": "از اینجا باید بردارید."
    },
    {
      "id": 45,
      "start": 6416.0,
      "end": 6418.0,
      "formatted_start": "01:46:56.000",
      "formatted_end": "01:46:58.000",
      "text": "از اینجا باید بردارید."
    },
    {
      "id": 46,
      "start": 6418.0,
      "end": 6420.0,
      "formatted_start": "01:46:58.000",
      "formatted_end": "01:47:00.000",
      "text": "از اینجا باید بردارید."
    },
    {
      "id": 47,
      "start": 6420.0,
      "end": 6422.0,
      "formatted_start": "01:47:00.000",
      "formatted_end": "01:47:02.000",
      "text": "از اینجا باید بردارید."
    },
    {
      "id": 48,
      "start": 6422.0,
      "end": 6424.0,
      "formatted_start": "01:47:02.000",
      "formatted_end": "01:47:04.000",
      "text": "از اینجا باید بردارید."
    },
    {
      "id": 49,
      "start": 6424.0,
      "end": 6426.0,
      "formatted_start": "01:47:04.000",
      "formatted_end": "01:47:06.000",
      "text": "از اینجا باید بردارید."
    },
    {
      "id": 50,
      "start": 6426.0,
      "end": 6428.0,
      "formatted_start": "01:47:06.000",
      "formatted_end": "01:47:08.000",
      "text": "از اینجا باید بردارید."
    },
    {
      "id": 51,
      "start": 6428.0,
      "end": 6430.0,
      "formatted_start": "01:47:08.000",
      "formatted_end": "01:47:10.000",
      "text": "روز چند تا میخوادیم؟"
    },
    {
      "id": 52,
      "start": 6430.0,
      "end": 6431.0,
      "formatted_start": "01:47:10.000",
      "formatted_end": "01:47:11.000",
      "text": "روز چند؟"
    },
    {
      "id": 53,
      "start": 6431.0,
      "end": 6432.0,
      "formatted_start": "01:47:11.000",
      "formatted_end": "01:47:12.000",
      "text": "ناشب و تیرویده"
    },
    {
      "id": 54,
      "start": 6432.0,
      "end": 6434.0,
      "formatted_start": "01:47:12.000",
      "formatted_end": "01:47:14.000",
      "text": "تیرویده میخواد"
    },
    {
      "id": 55,
      "start": 6434.0,
      "end": 6436.0,
      "formatted_start": "01:47:14.000",
      "formatted_end": "01:47:16.000",
      "text": "الان که تا حالا اینجا رو نخواده"
    },
    {
      "id": 56,
      "start": 6436.0,
      "end": 6437.0,
      "formatted_start": "01:47:16.000",
      "formatted_end": "01:47:17.000",
      "text": "خب؟"
    },
    {
      "id": 57,
      "start": 6437.0,
      "end": 6442.0,
      "formatted_start": "01:47:17.000",
      "formatted_end": "01:47:22.000",
      "text": "برامیش شش هفته بعد بشه چند روز آزمایش بدین تازه میخواد اثر کنی و این این چه اتفاقه بینید؟"
    },
    {
      "id": 58,
      "start": 6442.0,
      "end": 6445.0,
      "formatted_start": "01:47:22.000",
      "formatted_end": "01:47:25.000",
      "text": "اینجا میبینیم شش هفته"
    },
    {
      "id": 59,
      "start": 6446.0,
      "end": 6447.0,
      "formatted_start": "01:47:26.000",
      "formatted_end": "01:47:27.000",
      "text": "بعد چه بگیریم؟"
    },
    {
      "id": 60,
      "start": 6447.0,
      "end": 6449.0,
      "formatted_start": "01:47:27.000",
      "formatted_end": "01:47:29.000",
      "text": "این از این موضوع"
    },
    {
      "id": 61,
      "start": 6449.0,
      "end": 6450.0,
      "formatted_start": "01:47:29.000",
      "formatted_end": "01:47:30.000",
      "text": "حالا به این سراغ رو بگم"
    },
    {
      "id": 62,
      "start": 6450.0,
      "end": 6452.0,
      "formatted_start": "01:47:30.000",
      "formatted_end": "01:47:32.000",
      "text": "برای رفتن دارو چه اتفاقی بگیری؟"
    },
    {
      "id": 63,
      "start": 6452.0,
      "end": 6455.34,
      "formatted_start": "01:47:32.000",
      "formatted_end": "01:47:35.340",
      "text": "از خود می کنم آیدیوکی رو گفته شکر کرده که بیشتر نعوضش کنه"
    },
    {
      "id": 64,
      "start": 6455.34,
      "end": 6457.34,
      "formatted_start": "01:47:35.340",
      "formatted_end": "01:47:37.340",
      "text": "اطرافی به جواب اصلا نداره"
    },
    {
      "id": 65,
      "start": 6457.34,
      "end": 6460.96,
      "formatted_start": "01:47:37.340",
      "formatted_end": "01:47:40.960",
      "text": "من می کنم شمایستی منو از اینجا که می بینیم چطوری"
    },
    {
      "id": 66,
      "start": 6460.96,
      "end": 6462.8,
      "formatted_start": "01:47:40.960",
      "formatted_end": "01:47:42.800",
      "text": "می کنم شکرم دیگه"
    },
    {
      "id": 67,
      "start": 6462.8,
      "end": 6465.8,
      "formatted_start": "01:47:42.800",
      "formatted_end": "01:47:45.800",
      "text": "طیب دیابیتیه خب می گوید پادرون ناغر"
    },
    {
      "id": 68,
      "start": 6465.8,
      "end": 6468.8,
      "formatted_start": "01:47:45.800",
      "formatted_end": "01:47:48.800",
      "text": "ضعیب شده دور بزرگانتون"
    },
    {
      "id": 69,
      "start": 6468.8,
      "end": 6471.8,
      "formatted_start": "01:47:48.800",
      "formatted_end": "01:47:51.800",
      "text": "بازتون با چک می شه شکرمتون بزرگانتون"
    },
    {
      "id": 70,
      "start": 6471.8,
      "end": 6476.3,
      "formatted_start": "01:47:51.800",
      "formatted_end": "01:47:56.300",
      "text": "تجمع جرم می کنید جرم در دورتون تا بسکین مای رو بگیر بالا می ده"
    },
    {
      "id": 71,
      "start": 6476.3,
      "end": 6481.3,
      "formatted_start": "01:47:56.300",
      "formatted_end": "01:48:01.300",
      "text": "شما باس چیز چربی چی می کنید دوزار نکردید؟"
    },
    {
      "id": 72,
      "start": 6481.3,
      "end": 6483.3,
      "formatted_start": "01:48:01.300",
      "formatted_end": "01:48:03.300",
      "text": "چربی چیزی بگو کنم؟"
    },
    {
      "id": 73,
      "start": 6483.3,
      "end": 6485.3,
      "formatted_start": "01:48:03.300",
      "formatted_end": "01:48:05.300",
      "text": "این روزواستانتین رو کنید"
    },
    {
      "id": 74,
      "start": 6485.3,
      "end": 6487.3,
      "formatted_start": "01:48:05.300",
      "formatted_end": "01:48:07.300",
      "text": "دو روزون تا حالا سکتوری نکردن باشید"
    },
    {
      "id": 75,
      "start": 6487.3,
      "end": 6492.3,
      "formatted_start": "01:48:07.300",
      "formatted_end": "01:48:12.300",
      "text": "آه، چون بعد زور حد دارد چیز پنج دارد اون پیدا رو بگیرند"
    },
    {
      "id": 76,
      "start": 6506.3,
      "end": 6516.3,
      "formatted_start": "01:48:26.300",
      "formatted_end": "01:48:36.300",
      "text": "چیلین شکولات مشابه به لسته مندونه خربوزه انبور موز مکارانی اصل روبه کولوز اینا همه ممنوعه"
    },
    {
      "id": 77,
      "start": 6516.3,
      "end": 6525.3,
      "formatted_start": "01:48:36.300",
      "formatted_end": "01:48:45.300",
      "text": "آب نواز قربورتی رژیمی خلان ندارید چایتون با یه دونه با توت خوش کچه از توت خوش رستایی میتونید بخورید"
    },
    {
      "id": 78,
      "start": 6525.3,
      "end": 6532.3,
      "formatted_start": "01:48:45.300",
      "formatted_end": "01:48:52.300",
      "text": "توت خوش خورما یه چاران خورما خوش با یه دونه اناب با دو سه تا مویز"
    },
    {
      "id": 79,
      "start": 6532.3,
      "end": 6536.8,
      "formatted_start": "01:48:52.300",
      "formatted_end": "01:48:56.800",
      "text": "نونتون لباش نباشه، نونای دیگه مشکلی نداره"
    },
    {
      "id": 80,
      "start": 6536.8,
      "end": 6541.3,
      "formatted_start": "01:48:56.800",
      "formatted_end": "01:49:01.300",
      "text": "و سنگرگ و جو ترجیح همونه"
    },
    {
      "id": 81,
      "start": 6541.3,
      "end": 6545.3,
      "formatted_start": "01:49:01.300",
      "formatted_end": "01:49:05.300",
      "text": "برنجتون راحت 10 الى 12 پاشوک برنج"
    },
    {
      "id": 82,
      "start": 6545.3,
      "end": 6552.3,
      "formatted_start": "01:49:05.300",
      "formatted_end": "01:49:12.300",
      "text": "سیر نمیشید، عدس، ماش، بری چشم برباری"
    },
    {
      "id": 83,
      "start": 6552.3,
      "end": 6555.3,
      "formatted_start": "01:49:12.300",
      "formatted_end": "01:49:15.300",
      "text": "عدس، من نقلس دارم، عدس ببارم چی؟"
    },
    {
      "id": 84,
      "start": 6555.3,
      "end": 6560.3,
      "formatted_start": "01:49:15.300",
      "formatted_end": "01:49:20.300",
      "text": "نقلس فقط اسفناج و گوشت قرمز نمونه"
    },
    {
      "id": 85,
      "start": 6560.3,
      "end": 6562.3,
      "formatted_start": "01:49:20.300",
      "formatted_end": "01:49:22.300",
      "text": "ادس حضیعت می کنم؟"
    },
    {
      "id": 86,
      "start": 6562.3,
      "end": 6564.3,
      "formatted_start": "01:49:22.300",
      "formatted_end": "01:49:24.300",
      "text": "نه، خب مجبور بگیرم، ادس نفتر"
    },
    {
      "id": 87,
      "start": 6564.3,
      "end": 6566.3,
      "formatted_start": "01:49:24.300",
      "formatted_end": "01:49:26.300",
      "text": "نه، نفتر نفتر"
    },
    {
      "id": 88,
      "start": 6568.3,
      "end": 6570.3,
      "formatted_start": "01:49:28.300",
      "formatted_end": "01:49:30.300",
      "text": "بهتر بودم اون نقصه و بکنم اون پولیه"
    },
    {
      "id": 89,
      "start": 6570.3,
      "end": 6572.3,
      "formatted_start": "01:49:30.300",
      "formatted_end": "01:49:32.300",
      "text": "از همچنان خوب"
    },
    {
      "id": 90,
      "start": 6572.3,
      "end": 6574.3,
      "formatted_start": "01:49:32.300",
      "formatted_end": "01:49:34.300",
      "text": "از این هم بهتری هایی توی سیدیل پروفتات بوده"
    },
    {
      "id": 91,
      "start": 6574.3,
      "end": 6576.3,
      "formatted_start": "01:49:34.300",
      "formatted_end": "01:49:36.300",
      "text": "خب ادرایتوش قلب داره"
    },
    {
      "id": 92,
      "start": 6576.3,
      "end": 6578.3,
      "formatted_start": "01:49:36.300",
      "formatted_end": "01:49:38.300",
      "text": "که همونی بهتر خوب ناشی از همین موضوع"
    },
    {
      "id": 93,
      "start": 6578.3,
      "end": 6580.3,
      "formatted_start": "01:49:38.300",
      "formatted_end": "01:49:40.300",
      "text": "و بس من"
    },
    {
      "id": 94,
      "start": 6580.3,
      "end": 6582.3,
      "formatted_start": "01:49:40.300",
      "formatted_end": "01:49:42.300",
      "text": "بعد مصنع از این هم من برد دارو"
    },
    {
      "id": 95,
      "start": 6582.3,
      "end": 6584.3,
      "formatted_start": "01:49:42.300",
      "formatted_end": "01:49:44.300",
      "text": "بنویسم، بگی دارو کنه باز کنه نده"
    },
    {
      "id": 96,
      "start": 6584.3,
      "end": 6586.3,
      "formatted_start": "01:49:44.300",
      "formatted_end": "01:49:46.300",
      "text": "بعد باید دفتر سالتا یه برگه بگیریم"
    },
    {
      "id": 97,
      "start": 6586.3,
      "end": 6588.8,
      "formatted_start": "01:49:46.300",
      "formatted_end": "01:49:48.800",
      "text": "داروی کنیسی پرونده یه پر"
    },
    {
      "id": 98,
      "start": 6588.8,
      "end": 6591.8,
      "formatted_start": "01:49:48.800",
      "formatted_end": "01:49:51.800",
      "text": "بعد این پرونده تو ازایم دارو بیرون میشه"
    }
  ],
  "status": "completed"
}