    },
    {
      "id": 15,
      "start": 7324.0,
      "end": 7354.0,
      "formatted_start": "02:02:04.000",
      "formatted_end": "02:02:34.000",
      "text": "از اینجا باید بردارید که اینجا باید بردارید که اینجا بردارید که اینجا بردارید که اینجا بردارید که اینجا بردارید که اینجا بردارید که اینجا بردارید که اینجا بردارید که اینجا بردارید که اینجا بردارید که اینجا بردارید که اینجا بردارید که اینجا بردارید که اینجا بردارید که اینجا بردارید که اینجا بردارید که اینجا برداری"
    },
    {
      "id": 16,
      "start": 7354.0,
      "end": 7383.98,
      "formatted_start": "02:02:34.000",
      "formatted_end": "02:03:03.980",
      "text": "موسیقی در موسیقی"
    },
    {
      "id": 17,
      "start": 7384.0,
      "end": 7412.0,
      "formatted_start": "02:03:04.000",
      "formatted_end": "02:03:32.000",
      "text": "موسیقی"
    },
    {
      "id": 18,
      "start": 7412.0,
      "end": 7414.0,
      "formatted_start": "02:03:32.000",
      "formatted_end": "02:03:34.000",
      "text": "پنده شان عموما چنده؟"
    },
    {
      "id": 19,
      "start": 7414.0,
      "end": 7416.0,
      "formatted_start": "02:03:34.000",
      "formatted_end": "02:03:36.000",
      "text": "ست و سیر"
    },
    {
      "id": 20,
      "start": 7416.0,
      "end": 7418.0,
      "formatted_start": "02:03:36.000",
      "formatted_end": "02:03:38.000",
      "text": "ست و سیر"
    },
    {
      "id": 21,
      "start": 7418.0,
      "end": 7421.0,
      "formatted_start": "02:03:38.000",
      "formatted_end": "02:03:41.000",
      "text": "پنجا ناشتا ساله، پنجا دیگه بالا است"
    },
    {
      "id": 22,
      "start": 7425.0,
      "end": 7428.0,
      "formatted_start": "02:03:45.000",
      "formatted_end": "02:03:48.000",
      "text": "ایونسی چند مرد چند مرد شکلیت داری؟"
    },
    {
      "id": 23,
      "start": 7428.0,
      "end": 7429.0,
      "formatted_start": "02:03:48.000",
      "formatted_end": "02:03:49.000",
      "text": "چند مرد؟"
    },
    {
      "id": 24,
      "start": 7429.0,
      "end": 7431.0,
      "formatted_start": "02:03:49.000",
      "formatted_end": "02:03:51.000",
      "text": "هشت و شش"
    },
    {
      "id": 25,
      "start": 7431.0,
      "end": 7433.0,
      "formatted_start": "02:03:51.000",
      "formatted_end": "02:03:53.000",
      "text": "هشت و شش؟ بالا"
    },
    {
      "id": 26,
      "start": 7433.0,
      "end": 7435.0,
      "formatted_start": "02:03:53.000",
      "formatted_end": "02:03:55.000",
      "text": "شبها چه برسه پنده استفاده می کنی؟"
    },
    {
      "id": 27,
      "start": 7435.0,
      "end": 7439.0,
      "formatted_start": "02:03:55.000",
      "formatted_end": "02:03:59.000",
      "text": "سه مدر، دو مدر، همه هم یاز هایی می کنیم"
    },
    {
      "id": 28,
      "start": 7439.0,
      "end": 7442.46,
      "formatted_start": "02:03:59.000",
      "formatted_end": "02:04:02.460",
      "text": "او برسیش آورده بود و باید برس برسشو کم کرده"
    },
    {
      "id": 29,
      "start": 7442.46,
      "end": 7444.34,
      "formatted_start": "02:04:02.460",
      "formatted_end": "02:04:04.340",
      "text": "میتخورون باید گلیه رو"
    },
    {
      "id": 30,
      "start": 7444.34,
      "end": 7446.34,
      "formatted_start": "02:04:04.340",
      "formatted_end": "02:04:06.340",
      "text": "گلیه به انکلابیت میخورن"
    },
    {
      "id": 31,
      "start": 7446.34,
      "end": 7451.2,
      "formatted_start": "02:04:06.340",
      "formatted_end": "02:04:11.200",
      "text": "بعد انشاءالله کم کم گلیه به انکلابیتش عوض کنیم"
    },
    {
      "id": 32,
      "start": 7451.2,
      "end": 7453.2,
      "formatted_start": "02:04:11.200",
      "formatted_end": "02:04:13.200",
      "text": "که اونو مثلا توی ارکاد موسیقی ممنون"
    },
    {
      "id": 33,
      "start": 7453.2,
      "end": 7456.2,
      "formatted_start": "02:04:13.200",
      "formatted_end": "02:04:16.200",
      "text": "افتقان میبینیم از هر مورد"
    },
    {
      "id": 34,
      "start": 7456.2,
      "end": 7458.2,
      "formatted_start": "02:04:16.200",
      "formatted_end": "02:04:18.200",
      "text": "گلیه کلازی"
    },
    {
      "id": 35,
      "start": 7458.2,
      "end": 7461.2,
      "formatted_start": "02:04:18.200",
      "formatted_end": "02:04:21.200",
      "text": "اینو میتخور باید میخوریم"
    },
    {
      "id": 36,
      "start": 7461.2,
      "end": 7463.2,
      "formatted_start": "02:04:21.200",
      "formatted_end": "02:04:23.200",
      "text": "آه اینی بود"
    },
    {
      "id": 37,
      "start": 7463.2,
      "end": 7465.2,
      "formatted_start": "02:04:23.200",
      "formatted_end": "02:04:25.200",
      "text": "اینو تو باید میخوریم"
    },
    {
      "id": 38,
      "start": 7465.2,
      "end": 7467.2,
      "formatted_start": "02:04:25.200",
      "formatted_end": "02:04:27.200",
      "text": "آه نه"
    },
    {
      "id": 39,
      "start": 7467.2,
      "end": 7469.2,
      "formatted_start": "02:04:27.200",
      "formatted_end": "02:04:29.200",
      "text": "اون خیلی قدر شاگارده باید"
    },
    {
      "id": 40,
      "start": 7469.2,
      "end": 7471.2,
      "formatted_start": "02:04:29.200",
      "formatted_end": "02:04:31.200",
      "text": "اون روز چند بار میخورید؟"
    },
    {
      "id": 41,
      "start": 7471.2,
      "end": 7473.2,
      "formatted_start": "02:04:31.200",
      "formatted_end": "02:04:33.200",
      "text": "اولین سه بار میخورید"
    },
    {
      "id": 42,
      "start": 7473.2,
      "end": 7475.2,
      "formatted_start": "02:04:33.200",
      "formatted_end": "02:04:35.200",
      "text": "اولین دو بار"
    },
    {
      "id": 43,
      "start": 7475.2,
      "end": 7477.2,
      "formatted_start": "02:04:35.200",
      "formatted_end": "02:04:37.200",
      "text": "اون سه بار که خیلی سیاده"
    },
    {
      "id": 44,
      "start": 7477.2,
      "end": 7479.2,
      "formatted_start": "02:04:37.200",
      "formatted_end": "02:04:39.200",
      "text": "از اون یای سامانه که بود"
    },
    {
      "id": 45,
      "start": 7479.2,
      "end": 7481.2,
      "formatted_start": "02:04:39.200",
      "formatted_end": "02:04:41.200",
      "text": "اون روز باید از دو بار کمش کردیم"
    },
    {
      "id": 46,
      "start": 7481.2,
      "end": 7483.2,
      "formatted_start": "02:04:41.200",
      "formatted_end": "02:04:43.200",
      "text": "دو بار"
    },
    {
      "id": 47,
      "start": 7483.2,
      "end": 7485.2,
      "formatted_start": "02:04:43.200",
      "formatted_end": "02:04:45.200",
      "text": "اون روز دو بار"
    },
    {
      "id": 48,
      "start": 7485.2,
      "end": 7487.2,
      "formatted_start": "02:04:45.200",
      "formatted_end": "02:04:47.200",
      "text": "شب کامل میخورید؟"
    },
    {
      "id": 49,
      "start": 7487.2,
      "end": 7489.2,
      "formatted_start": "02:04:47.200",
      "formatted_end": "02:04:49.200",
      "text": "نه"
    },
    {
      "id": 50,
      "start": 7489.2,
      "end": 7491.2,
      "formatted_start": "02:04:49.200",
      "formatted_end": "02:04:51.200",
      "text": "دست به شب زرفت نمیاخدی؟"
    },
    {
      "id": 51,
      "start": 7491.2,
