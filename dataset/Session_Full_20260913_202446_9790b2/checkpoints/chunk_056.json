  "stt_segments": [
    {
      "id": 0,
      "start": 16800.0,
      "end": 16802.0,
      "formatted_start": "04:40:00.000",
      "formatted_end": "04:40:02.000",
      "text": "از اینجا باید بردارید."
    },
    {
      "id": 1,
      "start": 16830.0,
      "end": 16860.0,
      "formatted_start": "04:40:30.000",
      "formatted_end": "04:41:00.000",
      "text": "از اینجا باید برداریم که اینجا باید برداریم که اینجا باید برداریم که اینجا باید برداریم که اینجا باید برداریم که اینجا باید برداریم که اینجا باید برداریم که اینجا باید برداریم که اینجا باید برداریم که اینجا باید برداریم که اینجا باید برداریم که اینجا باید برداریم که اینجا باید برداریم که اینجا باید برداری"
    },
    {
      "id": 2,
      "start": 16860.0,
      "end": 16862.0,
      "formatted_start": "04:41:00.000",
      "formatted_end": "04:41:02.000",
      "text": "این بخواهش هم اینه"
    },
    {
      "id": 3,
      "start": 16862.0,
      "end": 16864.0,
      "formatted_start": "04:41:02.000",
      "formatted_end": "04:41:04.000",
      "text": "خب بیان خیلی راحت تره"
    },
    {
      "id": 4,
      "start": 16864.0,
      "end": 16866.0,
      "formatted_start": "04:41:04.000",
      "formatted_end": "04:41:06.000",
      "text": "این بخواهش عملتره"
    },
    {
      "id": 5,
      "start": 16866.0,
      "end": 16868.0,
      "formatted_start": "04:41:06.000",
      "formatted_end": "04:41:08.000",
      "text": "چون ناگرشتن و حالا احساسش میکنم دست نگرم"
    },
    {
      "id": 6,
      "start": 16868.0,
      "end": 16870.0,
      "formatted_start": "04:41:08.000",
      "formatted_end": "04:41:10.000",
      "text": "این اینجا هست درسته؟"
    },
    {
      "id": 7,
      "start": 16870.0,
      "end": 16872.0,
      "formatted_start": "04:41:10.000",
      "formatted_end": "04:41:12.000",
      "text": "این بره شما هست"
    },
    {
      "id": 8,
      "start": 16872.0,
      "end": 16874.0,
      "formatted_start": "04:41:12.000",
      "formatted_end": "04:41:14.000",
      "text": "رو کن این بره ها اینجا هم میاد"
    },
    {
      "id": 9,
      "start": 16874.0,
      "end": 16876.0,
      "formatted_start": "04:41:14.000",
      "formatted_end": "04:41:16.000",
      "text": "ببینی؟"
    },
    {
      "id": 10,
      "start": 16876.0,
      "end": 16878.0,
      "formatted_start": "04:41:16.000",
      "formatted_end": "04:41:18.000",
      "text": "در آمدنی با بستن یه بره هم در آمدن"
    },
    {
      "id": 11,
      "start": 16878.0,
      "end": 16880.0,
      "formatted_start": "04:41:18.000",
      "formatted_end": "04:41:20.000",
      "text": "این بخواهش عملتره"
    },
    {
      "id": 12,
      "start": 16880.0,
      "end": 16882.0,
      "formatted_start": "04:41:20.000",
      "formatted_end": "04:41:22.000",
      "text": "دست شما درم نکنه؟"
    },
    {
      "id": 13,
      "start": 16882.0,
      "end": 16884.0,
      "formatted_start": "04:41:22.000",
      "formatted_end": "04:41:24.000",
      "text": "خیلی خیلی باید بشه بیتر"
    },
    {
      "id": 14,
      "start": 16884.0,
      "end": 16886.0,
      "formatted_start": "04:41:24.000",
      "formatted_end": "04:41:26.000",
      "text": "اگر اون برد یسته شد"
    },
    {
      "id": 15,
      "start": 16886.0,
      "end": 16888.0,
      "formatted_start": "04:41:26.000",
      "formatted_end": "04:41:28.000",
      "text": "این موقع باید عمل و ترمیم این هم میخواد."
    },
    {
      "id": 16,
      "start": 16888.0,
      "end": 16890.0,
      "formatted_start": "04:41:28.000",
      "formatted_end": "04:41:30.000",
      "text": "فعلا چیزی به نفر پارگی نداره."
    },
    {
      "id": 17,
      "start": 16890.0,
      "end": 16892.0,
      "formatted_start": "04:41:30.000",
      "formatted_end": "04:41:32.000",
      "text": "اینجور که من کسی که تصادم کردم اعتبارا افرشان آمده."
    },
    {
      "id": 18,
      "start": 16892.0,
      "end": 16894.0,
      "formatted_start": "04:41:32.000",
      "formatted_end": "04:41:34.000",
      "text": "میخوایی؟ من که 90 درستم مطمئن میشه است."
    },
    {
      "id": 19,
      "start": 16894.0,
      "end": 16896.0,
      "formatted_start": "04:41:34.000",
      "formatted_end": "04:41:36.000",
      "text": "نه."
    },
    {
      "id": 20,
      "start": 16896.0,
      "end": 16898.0,
      "formatted_start": "04:41:36.000",
      "formatted_end": "04:41:38.000",
      "text": "نه چون سوکرافی این هم جدید بعد از عمل این همه چی انجام دادن."
    },
    {
      "id": 21,
      "start": 16898.0,
      "end": 16900.0,
      "formatted_start": "04:41:38.000",
      "formatted_end": "04:41:40.000",
      "text": "خوب با تنها چیز هم."
    },
    {
      "id": 22,
      "start": 16900.0,
      "end": 16902.0,
      "formatted_start": "04:41:40.000",
      "formatted_end": "04:41:42.000",
      "text": "چیکار کاری کنید؟"
    },
    {
      "id": 23,
      "start": 16902.0,
      "end": 16904.0,
      "formatted_start": "04:41:42.000",
      "formatted_end": "04:41:44.000",
      "text": "نه."
    },
    {
      "id": 24,
      "start": 16904.0,
      "end": 16906.0,
      "formatted_start": "04:41:44.000",
      "formatted_end": "04:41:46.000",
      "text": "نه."
    },
    {
      "id": 25,
      "start": 16906.0,
      "end": 16908.0,
      "formatted_start": "04:41:46.000",
      "formatted_end": "04:41:48.000",
      "text": "نه."
    },
    {
      "id": 26,
      "start": 16908.0,
      "end": 16910.0,
      "formatted_start": "04:41:48.000",
      "formatted_end": "04:41:50.000",
      "text": "نه."
    },
    {
      "id": 27,
      "start": 16910.0,
      "end": 16912.0,
      "formatted_start": "04:41:50.000",
      "formatted_end": "04:41:52.000",
      "text": "نه."
    },
    {
      "id": 28,
      "start": 16912.0,
      "end": 16914.0,
      "formatted_start": "04:41:52.000",
      "formatted_end": "04:41:54.000",
      "text": "نه."
    },
    {
      "id": 29,
      "start": 16914.0,
      "end": 16916.5,
      "formatted_start": "04:41:54.000",
      "formatted_end": "04:41:56.500",
      "text": "با تنها چیزم چکاب کامل"
    },
    {
      "id": 30,
      "start": 16916.5,
      "end": 16920.54,
      "formatted_start": "04:41:56.500",
      "formatted_end": "04:42:00.540",
      "text": "کنبت می بیدم را ریا می را گفتم شاید یه وقتی مشکل اینا داشت باشم"
    },
    {
      "id": 31,
      "start": 16920.54,
      "end": 16923.24,
      "formatted_start": "04:42:00.540",
      "formatted_end": "04:42:03.240",
      "text": "از این چکاب کامل همه چی دارم"
    },
    {
      "id": 32,
      "start": 16923.24,
      "end": 16924.68,
      "formatted_start": "04:42:03.240",
      "formatted_end": "04:42:04.680",
      "text": "همه چی دوکه ای"
    },
    {
      "id": 33,
      "start": 16924.68,
      "end": 16929.24,
      "formatted_start": "04:42:04.680",
      "formatted_end": "04:42:09.240",
      "text": "اونقدر همه چکستید اینا بوده یو خورده و از اینو درسته بینا شکسته باشی"
    },
    {
      "id": 34,
      "start": 16929.24,
      "end": 16930.76,
      "formatted_start": "04:42:09.240",
      "formatted_end": "04:42:10.760",
      "text": "دارو ها دارید؟"
    },
    {
      "id": 35,
      "start": 16930.76,
      "end": 16934.16,
      "formatted_start": "04:42:10.760",
      "formatted_end": "04:42:14.160",
      "text": "دارو ها می نه، افراد دختر سپاره میکنن اینا نگرنه"
    },
    {
      "id": 36,
      "start": 16934.16,
      "end": 16936.56,
      "formatted_start": "04:42:14.160",
      "formatted_end": "04:42:16.560",
      "text": "توی مسلیم ممنون میشم دست چی ما داریم"
    },
    {
      "id": 37,
      "start": 16936.56,
      "end": 16944.56,
      "formatted_start": "04:42:16.560",
      "formatted_end": "04:42:24.560",
      "text": "اینجور چیز رو از اینجور موانه نوشتی دیگره"
    },
    {
      "id": 38,
      "start": 16944.56,
      "end": 16948.56,
      "formatted_start": "04:42:24.560",
      "formatted_end": "04:42:28.560",
      "text": "من اینجور رو بسیار درمون داشتم"
    },
    {
      "id": 39,
      "start": 16948.56,
      "end": 16952.56,
      "formatted_start": "04:42:28.560",
      "formatted_end": "04:42:32.560",
      "text": "من رو بسیار درمون داشتم"
    },
    {
      "id": 40,
      "start": 16959.56,
      "end": 16962.56,
      "formatted_start": "04:42:39.560",
      "formatted_end": "04:42:42.560",
      "text": "از این داره"
    },
    {
      "id": 41,
      "start": 16962.56,
      "end": 16965.56,
      "formatted_start": "04:42:42.560",
      "formatted_end": "04:42:45.560",
      "text": "اینو گفتم دورا اینو رو بیارم استفاده می کنم"
    },
    {
      "id": 42,
      "start": 16965.56,
      "end": 16966.56,
      "formatted_start": "04:42:45.560",
      "formatted_end": "04:42:46.560",
      "text": "از این دارم"
    },
    {
      "id": 43,
      "start": 16966.56,
      "end": 16968.56,
      "formatted_start": "04:42:46.560",
      "formatted_end": "04:42:48.560",
      "text": "اونو که نداریم بگیم"
    },
    {
      "id": 44,
      "start": 16968.56,
      "end": 16971.56,
      "formatted_start": "04:42:48.560",
      "formatted_end": "04:42:51.560",
      "text": "اینو دارم"
    },
    {
      "id": 45,
      "start": 16971.56,
      "end": 16974.56,
      "formatted_start": "04:42:51.560",
      "formatted_end": "04:42:54.560",
      "text": "دوباره برام نوشته برم"
    },
    {
      "id": 46,
      "start": 16974.56,
      "end": 16976.56,
      "formatted_start": "04:42:54.560",
      "formatted_end": "04:42:56.560",
      "text": "اونو ببینیم"
    },
    {
      "id": 47,
      "start": 16976.56,
      "end": 16978.56,
      "formatted_start": "04:42:56.560",
      "formatted_end": "04:42:58.560",
      "text": "اونو که اونو قلبی نه"
    },
    {
      "id": 48,
      "start": 16978.56,
      "end": 16980.56,
      "formatted_start": "04:42:58.560",
      "formatted_end": "04:43:00.560",
      "text": "این سه دارو باهمه"
    },
    {
      "id": 49,
      "start": 16980.56,
      "end": 16983.56,
      "formatted_start": "04:43:00.560",
      "formatted_end": "04:43:03.560",
      "text": "به خاطر سه دارو باهمه بینم اینو میخوره هیچقدر"
    },
    {
      "id": 50,
      "start": 16983.56,
      "end": 16985.56,
      "formatted_start": "04:43:03.560",
      "formatted_end": "04:43:05.560",
      "text": "بعد اینو برای چی میخوره از این؟"
    },
    {
      "id": 51,
      "start": 16985.56,
      "end": 16989.56,
      "formatted_start": "04:43:05.560",
      "formatted_end": "04:43:09.560",
      "text": "اینو دست پایینو خارج گرفته بود"
    },
    {
      "id": 52,
      "start": 16989.56,
      "end": 16990.56,
      "formatted_start": "04:43:09.560",
      "formatted_end": "04:43:10.560",
      "text": "خب"
    },
    {
      "id": 53,
      "start": 16990.56,
      "end": 16992.56,
      "formatted_start": "04:43:10.560",
      "formatted_end": "04:43:12.560",
      "text": "رفته بودم گفت که باید از این بخوری"
    },
    {
      "id": 54,
      "start": 16992.56,
      "end": 16994.56,
      "formatted_start": "04:43:12.560",
      "formatted_end": "04:43:14.560",
      "text": "الان خوب شدی؟"
    },
    {
      "id": 55,
      "start": 16994.56,
      "end": 16996.56,
      "formatted_start": "04:43:14.560",
      "formatted_end": "04:43:16.560",
      "text": "چون این زیاد بخوری، کبدتو از کار میدازه"
    },
    {
      "id": 56,
      "start": 16996.56,
      "end": 16998.56,
      "formatted_start": "04:43:16.560",
      "formatted_end": "04:43:18.560",
      "text": "اصلا نمیستم"
    },
    {
      "id": 57,
      "start": 16998.56,
      "end": 17000.56,
      "formatted_start": "04:43:18.560",
      "formatted_end": "04:43:20.560",
      "text": "خوب شده دیگه؟"
    },
    {
      "id": 58,
      "start": 17000.56,
      "end": 17002.56,
      "formatted_start": "04:43:20.560",
      "formatted_end": "04:43:22.560",
      "text": "کبدم، آره"
    },
    {
      "id": 59,
      "start": 17002.56,
      "end": 17004.56,
      "formatted_start": "04:43:22.560",
      "formatted_end": "04:43:24.560",
      "text": "کبده چرک میکنه بر روز؟"
    },
    {
      "id": 60,
      "start": 17004.56,
      "end": 17006.56,
      "formatted_start": "04:43:24.560",
      "formatted_end": "04:43:26.560",
      "text": "گوجه دیگه نمیخورم، اصلا از گوجه"
    },
    {
      "id": 61,
      "start": 17006.56,
      "end": 17008.56,
      "formatted_start": "04:43:26.560",
      "formatted_end": "04:43:28.560",
      "text": "دیگه گوجه هم خرد کردم"
    },
    {
      "id": 62,
      "start": 17008.56,
      "end": 17010.56,
      "formatted_start": "04:43:28.560",
      "formatted_end": "04:43:30.560",
      "text": "اصلا از خواهد نمیخورم"
    },
    {
      "id": 63,
      "start": 17010.56,
      "end": 17012.56,
      "formatted_start": "04:43:30.560",
      "formatted_end": "04:43:32.560",
      "text": "برای با سفر شرط"
    },
    {
      "id": 64,
      "start": 17012.56,
      "end": 17014.56,
      "formatted_start": "04:43:32.560",
      "formatted_end": "04:43:34.560",
      "text": "من که دو کارم هستیم"
    },
    {
      "id": 65,
      "start": 17014.56,
      "end": 17016.56,
      "formatted_start": "04:43:34.560",
      "formatted_end": "04:43:36.560",
      "text": "آره"
    },
    {
      "id": 66,
      "start": 17016.56,
      "end": 17036.56,
      "formatted_start": "04:43:36.560",
      "formatted_end": "04:43:56.560",
      "text": "موسیقی"
    },
    {
      "id": 67,
      "start": 17046.56,
      "end": 17070.56,
      "formatted_start": "04:44:06.560",
      "formatted_end": "04:44:30.560",
      "text": "موسیقی"
    },
    {
      "id": 68,
      "start": 17070.56,
      "end": 17072.56,
      "formatted_start": "04:44:30.560",
      "formatted_end": "04:44:32.560",
      "text": "محب هستم"
    },
    {
      "id": 69,
      "start": 17072.56,
      "end": 17074.56,
      "formatted_start": "04:44:32.560",
      "formatted_end": "04:44:34.560",
      "text": "حضرت روز چندتا میکنی؟"
    },
    {
      "id": 70,
      "start": 17074.56,
      "end": 17076.56,
      "formatted_start": "04:44:34.560",
      "formatted_end": "04:44:36.560",
      "text": "از اینکه سال میکنه"
    },
    {
      "id": 71,
      "start": 17076.56,
      "end": 17078.56,
      "formatted_start": "04:44:36.560",
      "formatted_end": "04:44:38.560",
      "text": "خب، هم روز یک"
    },
    {
      "id": 72,
      "start": 17091.56,
      "end": 17093.56,
      "formatted_start": "04:44:51.560",
      "formatted_end": "04:44:53.560",
      "text": "خانگلچین"
    },
    {
      "id": 73,
      "start": 17095.56,
      "end": 17097.56,
      "formatted_start": "04:44:55.560",
      "formatted_end": "04:44:57.560",
      "text": "خانگلچین"
    }
  ],
  "status": "completed"
}