  "stt_segments": [
    {
      "id": 0,
      "start": 25200.0,
      "end": 25230.0,
      "formatted_start": "07:00:00.000",
      "formatted_end": "07:00:30.000",
      "text": "از اینجوری، از اینجوری، از اینجوری، از اینجوری، از اینجوری، از اینجوری، از اینجوری، از اینجوری، از اینجوری، از اینجوری، از اینجوری، از اینجوری، از اینجوری، از اینجوری، از اینجوری، از اینجوری، از اینجوری، از اینجوری، از اینجوری، از اینجوری، از اینجوری، از اینجوری، از اینجوری، از اینجوری، از اینجوری، از اینجوری، از اینجوری، از اینجوری"
    },
    {
      "id": 1,
      "start": 25230.0,
      "end": 25235.0,
      "formatted_start": "07:00:30.000",
      "formatted_end": "07:00:35.000",
      "text": "خاطر اینکه تحریکتون کم عاد سرس کرده از اون رو بند میشه"
    },
    {
      "id": 2,
      "start": 25235.0,
      "end": 25244.0,
      "formatted_start": "07:00:35.000",
      "formatted_end": "07:00:44.000",
      "text": "گفتی پروستات خوشگون نمیشه با میده پر حتی ما میخواییم ادتو از ادنه بخوای پروستات رو توسط ازش آگرده"
    },
    {
      "id": 3,
      "start": 25244.0,
      "end": 25247.0,
      "formatted_start": "07:00:44.000",
      "formatted_end": "07:00:47.000",
      "text": "همه دیگه"
    },
    {
      "id": 4,
      "start": 25247.0,
      "end": 25248.0,
      "formatted_start": "07:00:47.000",
      "formatted_end": "07:00:48.000",
      "text": "آمد که؟"
    },
    {
      "id": 5,
      "start": 25248.0,
      "end": 25249.0,
      "formatted_start": "07:00:48.000",
      "formatted_end": "07:00:49.000",
      "text": "چه که؟"
    },
    {
      "id": 6,
      "start": 25249.0,
      "end": 25253.0,
      "formatted_start": "07:00:49.000",
      "formatted_end": "07:00:53.000",
      "text": "بازی آرکناش باید تشکر بشه چه که یکمی در اینکه همین پروستاتش کنه"
    },
    {
      "id": 7,
      "start": 25253.0,
      "end": 25256.0,
      "formatted_start": "07:00:53.000",
      "formatted_end": "07:00:56.000",
      "text": "سه ماه دیگه زودتر لازم نیست"
    },
    {
      "id": 8,
      "start": 25256.0,
      "end": 25259.0,
      "formatted_start": "07:00:56.000",
      "formatted_end": "07:00:59.000",
      "text": "سنوه که رو که رو بدم چهار شش ماه"
    },
    {
      "id": 9,
      "start": 25259.0,
      "end": 25289.0,
      "formatted_start": "07:00:59.000",
      "formatted_end": "07:01:29.000",
      "text": "از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه ا"
    },
    {
      "id": 10,
      "start": 25319.0,
      "end": 25323.0,
      "formatted_start": "07:01:59.000",
      "formatted_end": "07:02:03.000",
      "text": "برو پشت سنجری، من بخوا نامش رو بدون اسم نبشتم"
    },
    {
      "id": 11,
      "start": 25323.0,
      "end": 25326.0,
      "formatted_start": "07:02:03.000",
      "formatted_end": "07:02:06.000",
      "text": "آه، بگم نامش رو بدون اسم نبشتم، برم بیش سنجری"
    },
    {
      "id": 12,
      "start": 25326.0,
      "end": 25329.0,
      "formatted_start": "07:02:06.000",
      "formatted_end": "07:02:09.000",
      "text": "یا هر دکتر رو گوارش یا خودتون میدونید"
    },
    {
      "id": 13,
      "start": 25329.0,
      "end": 25331.0,
      "formatted_start": "07:02:09.000",
      "formatted_end": "07:02:11.000",
      "text": "آره، بخوا من بدون اسم نبشتم"
    },
    {
      "id": 14,
      "start": 25331.0,
      "end": 25332.0,
      "formatted_start": "07:02:11.000",
      "formatted_end": "07:02:12.000",
      "text": "باشه، تا ماند"
    },
    {
      "id": 15,
      "start": 25332.0,
      "end": 25334.0,
      "formatted_start": "07:02:12.000",
      "formatted_end": "07:02:14.000",
      "text": "فشارت یازم، درسته؟"
    },
    {
      "id": 16,
      "start": 25334.0,
      "end": 25335.0,
      "formatted_start": "07:02:14.000",
      "formatted_end": "07:02:15.000",
      "text": "یازم"
    },
    {
      "id": 17,
      "start": 25335.0,
      "end": 25336.0,
      "formatted_start": "07:02:15.000",
      "formatted_end": "07:02:16.000",
      "text": "زمونی کن"
    },
    {
      "id": 18,
      "start": 25349.0,
      "end": 25351.0,
      "formatted_start": "07:02:29.000",
      "formatted_end": "07:02:31.000",
      "text": "جانب"
    },
    {
      "id": 19,
      "start": 25351.0,
      "end": 25355.0,
      "formatted_start": "07:02:31.000",
      "formatted_end": "07:02:35.000",
      "text": "من این خورسه از روزی که خوردم"
    },
    {
      "id": 20,
      "start": 25355.0,
      "end": 25359.0,
      "formatted_start": "07:02:35.000",
      "formatted_end": "07:02:39.000",
      "text": "همجا سرگیجه بعد بلا میشدم اساس حالا تعبه داشتم"
    },
    {
      "id": 21,
      "start": 25359.0,
      "end": 25361.0,
      "formatted_start": "07:02:39.000",
      "formatted_end": "07:02:41.000",
      "text": "من توانه این کارو بکنم"
    },
    {
      "id": 22,
      "start": 25361.0,
      "end": 25365.0,
      "formatted_start": "07:02:41.000",
      "formatted_end": "07:02:45.000",
      "text": "من گفتم هفته اوله هنوز خورس آدم در کنار شد اینجا شدن پیدیدم"
    },
    {
      "id": 23,
      "start": 25365.0,
      "end": 25367.0,
      "formatted_start": "07:02:45.000",
      "formatted_end": "07:02:47.000",
      "text": "بعد افتقان نداشتی؟"
    },
    {
      "id": 24,
      "start": 25367.0,
      "end": 25369.0,
      "formatted_start": "07:02:47.000",
      "formatted_end": "07:02:49.000",
      "text": "زیاد نه"
    },
    {
      "id": 25,
      "start": 25369.0,
      "end": 25375.0,
      "formatted_start": "07:02:49.000",
      "formatted_end": "07:02:55.000",
      "text": "اگه افتقان نداشتید که خودتون بر تصمیم دیدید"
    },
    {
      "id": 26,
      "start": 25375.0,
      "end": 25381.0,
      "formatted_start": "07:02:55.000",
      "formatted_end": "07:03:01.000",
      "text": "اگر کنترل شده و افتقام نداشتی که کنترل شده، او ادار را ادار کنید."
    },
    {
      "id": 27,
      "start": 25381.0,
      "end": 25388.0,
      "formatted_start": "07:03:01.000",
      "formatted_end": "07:03:08.000",
      "text": "اگر این وضعیت برقیر قابل تهمال است، دیگر اگر این کورس را تنقل کنید، تو همه کورس ها را بیش برید."
    },
    {
      "id": 28,
      "start": 25388.0,
      "end": 25391.0,
      "formatted_start": "07:03:08.000",
      "formatted_end": "07:03:11.000",
      "text": "اگر جواب نداد، از اون را میشونید."
    },
    {
      "id": 29,
      "start": 25391.0,
      "end": 25396.0,
      "formatted_start": "07:03:11.000",
      "formatted_end": "07:03:16.000",
      "text": "نه، الان دارم از روز که این کورس را کنم، خیلی کنترل شده و خوب هم هست."
    },
    {
      "id": 30,
      "start": 25396.0,
      "end": 25398.0,
      "formatted_start": "07:03:16.000",
      "formatted_end": "07:03:18.000",
      "text": "چون عوارض کورس هست."
    },
    {
      "id": 31,
      "start": 25398.0,
      "end": 25404.0,
      "formatted_start": "07:03:18.000",
      "formatted_end": "07:03:24.000",
      "text": "من شاید هفته اول مردم بخاطر قرصه، مثلا این حال تاول سرگیجه دارم"
    },
    {
      "id": 32,
      "start": 25404.0,
      "end": 25410.0,
      "formatted_start": "07:03:24.000",
      "formatted_end": "07:03:30.000",
      "text": "هنوز هم که نزدیک دو ماه رد شده میکنم فکر میکنم که سرگیجه دارم اینا"
    },
    {
      "id": 33,
      "start": 25410.0,
      "end": 25413.0,
      "formatted_start": "07:03:30.000",
      "formatted_end": "07:03:33.000",
      "text": "دیگه الان هم تکرار داروی داشتن، میتونیم"
    },
    {
      "id": 34,
      "start": 25413.0,
      "end": 25419.0,
      "formatted_start": "07:03:33.000",
      "formatted_end": "07:03:39.000",
      "text": "من چیز میکنم؟ بیشتر به دوتا من نزدیک میدم، بخواب"
    },
    {
      "id": 35,
      "start": 25419.0,
      "end": 25422.0,
      "formatted_start": "07:03:39.000",
      "formatted_end": "07:03:42.000",
      "text": "اگه دیدیم آقای تاول هم داروی دادم"
    },
    {
      "id": 36,
      "start": 25422.0,
      "end": 25426.0,
      "formatted_start": "07:03:42.000",
      "formatted_end": "07:03:46.000",
      "text": "از سلین را با هرین و سلین را بردارم"
    },
    {
      "id": 37,
      "start": 25426.0,
      "end": 25432.0,
      "formatted_start": "07:03:46.000",
      "formatted_end": "07:03:52.000",
      "text": "از اینکه از 20 روزی را که نزدم، وزنم آمد و پایین رفت باید بردارم"
    },
    {
      "id": 38,
      "start": 25432.0,
      "end": 25438.0,
      "formatted_start": "07:03:52.000",
      "formatted_end": "07:03:58.000",
      "text": "در اینجا با هرین و سلین را بردارم"
    },
    {
      "id": 39,
      "start": 25442.0,
      "end": 25448.0,
      "formatted_start": "07:04:02.000",
      "formatted_end": "07:04:08.000",
      "text": "اینکه وزنم آمد و پایین رفت بردارم، بردارم بردارم"
    },
    {
      "id": 40,
      "start": 25448.0,
      "end": 25453.0,
      "formatted_start": "07:04:08.000",
      "formatted_end": "07:04:13.000",
      "text": "چند روز را گرفتم و دیدم مثلا سیر شب و پنج هایی"
    },
    {
      "id": 41,
      "start": 25470.0,
      "end": 25474.0,
      "formatted_start": "07:04:30.000",
      "formatted_end": "07:04:34.000",
      "text": "چند روزم فشارم رو گرفتم و دیدم نور و پنجه"
    },
    {
      "id": 42,
      "start": 25474.0,
      "end": 25479.0,
      "formatted_start": "07:04:34.000",
      "formatted_end": "07:04:39.000",
      "text": "آهان، جا فشارتون پرین اومده. چرا؟ بازا فشار میکنی؟"
    },
    {
      "id": 43,
      "start": 25479.0,
      "end": 25485.0,
      "formatted_start": "07:04:39.000",
      "formatted_end": "07:04:45.000",
      "text": "نه، اصلا این مدت من اشاره هم گرفتم، همه ش درد، درد، یازیدم، بارو مثلا نرم."
    },
    {
      "id": 44,
      "start": 25485.0,
      "end": 25488.0,
      "formatted_start": "07:04:45.000",
      "formatted_end": "07:04:48.000",
      "text": "این همه بارداری و این برداری."
    },
    {
      "id": 45,
      "start": 25488.0,
      "end": 25489.0,
      "formatted_start": "07:04:48.000",
      "formatted_end": "07:04:49.000",
      "text": "این برداری چیه؟"
    },
    {
      "id": 46,
      "start": 25489.0,
      "end": 25490.0,
      "formatted_start": "07:04:49.000",
      "formatted_end": "07:04:50.000",
      "text": "این برداری چیه؟"
    },
    {
      "id": 47,
      "start": 25490.0,
      "end": 25491.0,
      "formatted_start": "07:04:50.000",
      "formatted_end": "07:04:51.000",
      "text": "این برداری چیه؟"
    },
    {
      "id": 48,
      "start": 25491.0,
      "end": 25492.0,
      "formatted_start": "07:04:51.000",
      "formatted_end": "07:04:52.000",
      "text": "این برداری چیه؟"
    },
    {
      "id": 49,
      "start": 25492.0,
      "end": 25493.0,
      "formatted_start": "07:04:52.000",
      "formatted_end": "07:04:53.000",
      "text": "این برداری چیه؟"
    },
    {
      "id": 50,
      "start": 25493.0,
      "end": 25494.0,
      "formatted_start": "07:04:53.000",
      "formatted_end": "07:04:54.000",
      "text": "این برداری چیه؟"
    },
    {
      "id": 51,
      "start": 25494.0,
      "end": 25495.0,
      "formatted_start": "07:04:54.000",
      "formatted_end": "07:04:55.000",
      "text": "این برداری چیه؟"
    },
    {
      "id": 52,
      "start": 25495.0,
      "end": 25496.0,
      "formatted_start": "07:04:55.000",
      "formatted_end": "07:04:56.000",
      "text": "این برداری چیه؟"
    },
    {
      "id": 53,
      "start": 25496.0,
      "end": 25497.0,
      "formatted_start": "07:04:56.000",
      "formatted_end": "07:04:57.000",
      "text": "این برداری چیه؟"
    },
    {
      "id": 54,
      "start": 25497.0,
      "end": 25500.0,
      "formatted_start": "07:04:57.000",
      "formatted_end": "07:05:00.000",
      "text": "موسیقی"
    }
  ],
  "status": "completed"
}