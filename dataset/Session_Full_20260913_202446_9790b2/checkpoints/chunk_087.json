  "stt_segments": [
    {
      "id": 0,
      "start": 26100.0,
      "end": 26107.16,
      "formatted_start": "07:15:00.000",
      "formatted_end": "07:15:07.160",
      "text": "مامانتون شستا، این برای مامانتون نباید شستا شو بخوره، خب؟"
    },
    {
      "id": 1,
      "start": 26107.16,
      "end": 26110.76,
      "formatted_start": "07:15:07.160",
      "formatted_end": "07:15:10.760",
      "text": "باقیر بدین به خوهرتون کمک داریم."
    },
    {
      "id": 2,
      "start": 26110.76,
      "end": 26112.76,
      "formatted_start": "07:15:10.760",
      "formatted_end": "07:15:12.760",
      "text": "چند تا شو بخوره شو بخوره؟"
    },
    {
      "id": 3,
      "start": 26112.76,
      "end": 26118.24,
      "formatted_start": "07:15:12.760",
      "formatted_end": "07:15:18.240",
      "text": "مامانتون نهایتا ده تا پونزه تا، چون کلیهش کمکاره، نباید زیاد بخوره."
    },
    {
      "id": 4,
      "start": 26118.24,
      "end": 26120.24,
      "formatted_start": "07:15:18.240",
      "formatted_end": "07:15:20.240",
      "text": "برای ده تا شو بخوره."
    },
    {
      "id": 5,
      "start": 26120.24,
      "end": 26122.24,
      "formatted_start": "07:15:20.240",
      "formatted_end": "07:15:22.240",
      "text": "ده تا پونزه تا..."
    },
    {
      "id": 6,
      "start": 26122.24,
      "end": 26123.24,
      "formatted_start": "07:15:22.240",
      "formatted_end": "07:15:23.240",
      "text": "این همه با جدیده؟"
    },
    {
      "id": 7,
      "start": 26123.24,
      "end": 26124.24,
      "formatted_start": "07:15:23.240",
      "formatted_end": "07:15:24.240",
      "text": "آره، این با جدیده."
    },
    {
      "id": 8,
      "start": 26124.24,
      "end": 26127.24,
      "formatted_start": "07:15:24.240",
      "formatted_end": "07:15:27.240",
      "text": "هر دو تو جدید هستن. برای ما بخواهیم این ها که تکمال قدیم نیست."
    },
    {
      "id": 9,
      "start": 26127.24,
      "end": 26129.24,
      "formatted_start": "07:15:27.240",
      "formatted_end": "07:15:29.240",
      "text": "نه نه، همه جدید."
    },
    {
      "id": 10,
      "start": 26129.24,
      "end": 26131.24,
      "formatted_start": "07:15:29.240",
      "formatted_end": "07:15:31.240",
      "text": "جان، هر دوازده ساعت."
    },
    {
      "id": 11,
      "start": 26131.24,
      "end": 26133.24,
      "formatted_start": "07:15:31.240",
      "formatted_end": "07:15:33.240",
      "text": "ده اون جدیده."
    },
    {
      "id": 12,
      "start": 26135.24,
      "end": 26137.24,
      "formatted_start": "07:15:35.240",
      "formatted_end": "07:15:37.240",
      "text": "مثلا این صفحه جدید بازبور نمیشه."
    },
    {
      "id": 13,
      "start": 26139.24,
      "end": 26141.24,
      "formatted_start": "07:15:39.240",
      "formatted_end": "07:15:41.240",
      "text": "قبلی را دست نداریم."
    },
    {
      "id": 14,
      "start": 26146.24,
      "end": 26148.24,
      "formatted_start": "07:15:46.240",
      "formatted_end": "07:15:48.240",
      "text": "چی خیلی مرسه برشون."
    },
    {
      "id": 15,
      "start": 26148.24,
      "end": 26149.24,
      "formatted_start": "07:15:48.240",
      "formatted_end": "07:15:49.240",
      "text": "سه."
    },
    {
      "id": 16,
      "start": 26149.24,
      "end": 26152.24,
      "formatted_start": "07:15:49.240",
      "formatted_end": "07:15:52.240",
      "text": "این آنها برای من بدتر میشه."
    },
    {
      "id": 17,
      "start": 26152.24,
      "end": 26154.24,
      "formatted_start": "07:15:52.240",
      "formatted_end": "07:15:54.240",
      "text": "اینجا که هر درسته بیسته درمونش"
    },
    {
      "id": 18,
      "start": 26154.24,
      "end": 26156.24,
      "formatted_start": "07:15:54.240",
      "formatted_end": "07:15:56.240",
      "text": "خب اون گره نداره"
    },
    {
      "id": 19,
      "start": 26156.24,
      "end": 26158.24,
      "formatted_start": "07:15:56.240",
      "formatted_end": "07:15:58.240",
      "text": "اون درمونه نه صحبت بکنه"
    },
    {
      "id": 20,
      "start": 26158.24,
      "end": 26160.24,
      "formatted_start": "07:15:58.240",
      "formatted_end": "07:16:00.240",
      "text": "از اون عرض نیست بیشتر"
    },
    {
      "id": 21,
      "start": 26160.24,
      "end": 26162.24,
      "formatted_start": "07:16:00.240",
      "formatted_end": "07:16:02.240",
      "text": "برو با من توی خونه هنو با هم برم شنو"
    },
    {
      "id": 22,
      "start": 26168.24,
      "end": 26170.24,
      "formatted_start": "07:16:08.240",
      "formatted_end": "07:16:10.240",
      "text": "چون هم فکر میکنن بهش گفتم"
    },
    {
      "id": 23,
      "start": 26170.24,
      "end": 26172.24,
      "formatted_start": "07:16:10.240",
      "formatted_end": "07:16:12.240",
      "text": "خب نفر وقتی الان میاد دارو تذکرشون باشن"
    },
    {
      "id": 24,
      "start": 26172.24,
      "end": 26174.24,
      "formatted_start": "07:16:12.240",
      "formatted_end": "07:16:14.240",
      "text": "چاره این زیر"
    },
    {
      "id": 25,
      "start": 26174.24,
      "end": 26176.24,
      "formatted_start": "07:16:14.240",
      "formatted_end": "07:16:16.240",
      "text": "نمیشه دوست اول نعیز رو"
    },
    {
      "id": 26,
      "start": 26176.24,
      "end": 26178.24,
      "formatted_start": "07:16:16.240",
      "formatted_end": "07:16:18.240",
      "text": "اول کبرو دروش سخت شرکت بکنه"
    },
    {
      "id": 27,
      "start": 26178.24,
      "end": 26180.24,
      "formatted_start": "07:16:18.240",
      "formatted_end": "07:16:20.240",
      "text": "خب شرکت رو این درد بکنی"
    },
    {
      "id": 28,
      "start": 26180.24,
      "end": 26186.24,
      "formatted_start": "07:16:20.240",
      "formatted_end": "07:16:26.240",
      "text": "اگر دیگه نمیخوایی با جایی بشویم خودم"
    },
    {
      "id": 29,
      "start": 26186.24,
      "end": 26188.24,
      "formatted_start": "07:16:26.240",
      "formatted_end": "07:16:28.240",
      "text": "این بخودن اینقدر خنک پریز رو خودت"
    },
    {
      "id": 30,
      "start": 26188.24,
      "end": 26190.24,
      "formatted_start": "07:16:28.240",
      "formatted_end": "07:16:30.240",
      "text": "ازشن یک روزنید"
    },
    {
      "id": 31,
      "start": 26190.24,
      "end": 26192.24,
      "formatted_start": "07:16:30.240",
      "formatted_end": "07:16:32.240",
      "text": "تاییده تاییده"
    },
    {
      "id": 32,
      "start": 26192.24,
      "end": 26194.24,
      "formatted_start": "07:16:32.240",
      "formatted_end": "07:16:34.240",
      "text": "من خواهد دیگه تو بگم"
    },
    {
      "id": 33,
      "start": 26194.24,
      "end": 26196.24,
      "formatted_start": "07:16:34.240",
      "formatted_end": "07:16:36.240",
      "text": "نه منو خواهم"
    },
    {
      "id": 34,
      "start": 26196.24,
      "end": 26198.24,
      "formatted_start": "07:16:36.240",
      "formatted_end": "07:16:38.240",
      "text": "چون منو بوده زدن بودم"
    },
    {
      "id": 35,
      "start": 26198.24,
      "end": 26200.24,
      "formatted_start": "07:16:38.240",
      "formatted_end": "07:16:40.240",
      "text": "تو بعد زیاده نمیدونی"
    },
    {
      "id": 36,
      "start": 26200.24,
      "end": 26202.24,
      "formatted_start": "07:16:40.240",
      "formatted_end": "07:16:42.240",
      "text": "منو سامنه بود"
    },
    {
      "id": 37,
      "start": 26210.24,
      "end": 26212.24,
      "formatted_start": "07:16:50.240",
      "formatted_end": "07:16:52.240",
      "text": "از اینجا باید برداریم"
    },
    {
      "id": 38,
      "start": 26212.24,
      "end": 26214.24,
      "formatted_start": "07:16:52.240",
      "formatted_end": "07:16:54.240",
      "text": "از اینجا باید برداریم"
    },
    {
      "id": 39,
      "start": 26214.24,
      "end": 26216.24,
      "formatted_start": "07:16:54.240",
      "formatted_end": "07:16:56.240",
      "text": "از اینجا باید برداریم"
    },
    {
      "id": 40,
      "start": 26216.24,
      "end": 26218.24,
      "formatted_start": "07:16:56.240",
      "formatted_end": "07:16:58.240",
