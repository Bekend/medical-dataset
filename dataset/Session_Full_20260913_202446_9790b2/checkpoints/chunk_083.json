      "end": 24930.0,
      "formatted_start": "06:55:00.000",
      "formatted_end": "06:55:30.000",
      "text": "از اینجا، با اینجا، با اینجا، با اینجا، با اینجا، با اینجا، با اینجا، با اینجا، با اینجا، با اینجا، با اینجا، با اینجا، با اینجا، با اینجا، با اینجا، با اینجا، با اینجا، با اینجا، با اینجا، با اینجا، با اینجا، با اینجا، با اینجا، با اینجا، با اینجا، با اینجا، با اینجا، با اینجا، با اینجا، با اینجا، با اینجا، با اینجا"
    },
    {
      "id": 1,
      "start": 24930.0,
      "end": 24935.0,
      "formatted_start": "06:55:30.000",
      "formatted_end": "06:55:35.000",
      "text": "روغ همسور، گردنی، طبق مار، دلستر، مشابه"
    },
    {
      "id": 2,
      "start": 24935.0,
      "end": 24938.0,
      "formatted_start": "06:55:35.000",
      "formatted_end": "06:55:38.000",
      "text": "کلنگ کم مرسی نداریم"
    },
    {
      "id": 3,
      "start": 24938.0,
      "end": 24943.0,
      "formatted_start": "06:55:38.000",
      "formatted_end": "06:55:43.000",
      "text": "کلنگ زیاد رو استفاده نکنید، خوابادو دیگه خستگیدی، چی ندارید؟"
    },
    {
      "id": 4,
      "start": 24943.0,
      "end": 24945.0,
      "formatted_start": "06:55:43.000",
      "formatted_end": "06:55:45.000",
      "text": "سو رو کسای کارش میتونید باید داریم"
    },
    {
      "id": 5,
      "start": 24945.0,
      "end": 24948.0,
      "formatted_start": "06:55:45.000",
      "formatted_end": "06:55:48.000",
      "text": "نه، باید سو رو بینجوری نیستیم"
    },
    {
      "id": 6,
      "start": 24948.0,
      "end": 24949.0,
      "formatted_start": "06:55:48.000",
      "formatted_end": "06:55:49.000",
      "text": "نه، سو باید بینجوری نیستیم"
    },
    {
      "id": 7,
      "start": 24949.0,
      "end": 24951.0,
      "formatted_start": "06:55:49.000",
      "formatted_end": "06:55:51.000",
      "text": "ترواب دارید؟ پیادر همونو بارید؟"
    },
    {
      "id": 8,
      "start": 24951.0,
      "end": 24952.0,
      "formatted_start": "06:55:51.000",
      "formatted_end": "06:55:52.000",
      "text": "نه"
    },
    {
      "id": 9,
      "start": 24952.0,
      "end": 24954.0,
      "formatted_start": "06:55:52.000",
      "formatted_end": "06:55:54.000",
      "text": "ترواب که تو نزیاد کنید"
    },
    {
      "id": 10,
      "start": 24954.0,
      "end": 24956.0,
      "formatted_start": "06:55:54.000",
      "formatted_end": "06:55:56.000",
      "text": "نه، نه، نه"
    },
    {
      "id": 11,
      "start": 24956.0,
      "end": 24964.0,
      "formatted_start": "06:55:56.000",
      "formatted_end": "06:56:04.000",
      "text": "پس ها کم موخورن، من اصلا شرگی کمتر موخورن، شب اصلا چیزی شرگ نموخورن، پرای این نموخورن"
    },
    {
      "id": 12,
      "start": 24964.0,
      "end": 24969.0,
      "formatted_start": "06:56:04.000",
      "formatted_end": "06:56:09.000",
      "text": "شب مثلا اگه سرم در حدود برده بوده، حدود برده هشتاد شدن"
    },
    {
      "id": 13,
      "start": 24969.0,
      "end": 24974.0,
      "formatted_start": "06:56:09.000",
      "formatted_end": "06:56:14.000",
      "text": "نامودر پنیز با گوژه میکردن بیشتر، شباتو کلا مکردن"
    },
    {
      "id": 14,
      "start": 24974.0,
      "end": 24980.0,
      "formatted_start": "06:56:14.000",
      "formatted_end": "06:56:20.000",
      "text": "شب سرم نیشن اتیپی داره، اما سرم به دامادرشون شب سرم نکرده، شب داشتن"
    },
    {
      "id": 15,
      "start": 24980.0,
      "end": 24984.0,
      "formatted_start": "06:56:20.000",
      "formatted_end": "06:56:24.000",
      "text": "همه ش به تغذیر رو نداره"
    },
    {
      "id": 16,
      "start": 24984.0,
      "end": 24986.0,
      "formatted_start": "06:56:24.000",
      "formatted_end": "06:56:26.000",
      "text": "این کارویان خیلی کم شده"
    },
    {
      "id": 17,
      "start": 24986.0,
      "end": 24988.0,
      "formatted_start": "06:56:26.000",
      "formatted_end": "06:56:28.000",
      "text": "یکم تحرکشون و عملتیشون خواهید"
    },
    {
      "id": 18,
      "start": 24988.0,
      "end": 24990.0,
      "formatted_start": "06:56:28.000",
      "formatted_end": "06:56:30.000",
      "text": "یکم تحرکشون و عملتیشون خواهید"
    },
    {
      "id": 19,
      "start": 24990.0,
      "end": 24992.0,
      "formatted_start": "06:56:30.000",
      "formatted_end": "06:56:32.000",
      "text": "یکم تحرکشون و عملتیشون خواهید"
    },
    {
      "id": 20,
      "start": 24992.0,
      "end": 24994.0,
      "formatted_start": "06:56:32.000",
      "formatted_end": "06:56:34.000",
      "text": "یکم تحرکشون و عملتیشون خواهید"
    },
    {
      "id": 21,
      "start": 24994.0,
      "end": 24996.0,
      "formatted_start": "06:56:34.000",
      "formatted_end": "06:56:36.000",
      "text": "یکم تحرکشون و عملتیشون خواهید"
    },
    {
      "id": 22,
      "start": 24996.0,
      "end": 24998.0,
      "formatted_start": "06:56:36.000",
      "formatted_end": "06:56:38.000",
      "text": "یکم تحرکشون و عملتیشون خواهید"
    },
    {
      "id": 23,
      "start": 24998.0,
      "end": 25000.0,
      "formatted_start": "06:56:38.000",
      "formatted_end": "06:56:40.000",
      "text": "یکم تحرکشون و عملتیشون خواهید"
    },
    {
      "id": 24,
      "start": 25000.0,
      "end": 25002.0,
      "formatted_start": "06:56:40.000",
      "formatted_end": "06:56:42.000",
      "text": "یکم تحرکشون و عملتیشون خواهید"
    },
    {
      "id": 25,
      "start": 25002.0,
      "end": 25004.0,
      "formatted_start": "06:56:42.000",
      "formatted_end": "06:56:44.000",
      "text": "این چیه؟"
    },
    {
      "id": 26,
      "start": 25004.0,
      "end": 25007.0,
      "formatted_start": "06:56:44.000",
      "formatted_end": "06:56:47.000",
      "text": "این چیه؟ مهم، تعداد گلوله قرمز بینند"
    },
    {
      "id": 27,
      "start": 25007.0,
      "end": 25008.0,
      "formatted_start": "06:56:47.000",
      "formatted_end": "06:56:48.000",
      "text": "مشکل نداره"
    },
    {
      "id": 28,
      "start": 25008.0,
      "end": 25012.0,
      "formatted_start": "06:56:48.000",
      "formatted_end": "06:56:52.000",
      "text": "این چیه؟ انترنت زده بود که خورده نگرم شده با خود؟"
    },
    {
      "id": 29,
      "start": 25012.0,
      "end": 25014.0,
      "formatted_start": "06:56:52.000",
      "formatted_end": "06:56:54.000",
      "text": "این چیز هیچی همه که میبینید"
    },
    {
      "id": 30,
      "start": 25014.0,
      "end": 25020.0,
      "formatted_start": "06:56:54.000",
      "formatted_end": "06:57:00.000",
      "text": "کل آزمایش هاشو، تنها مشکلی داره که هم خودیش همش چیزی که قرمز نزده بود"
    },
    {
      "id": 31,
      "start": 25020.0,
      "end": 25026.0,
      "formatted_start": "06:57:00.000",
      "formatted_end": "06:57:06.000",
      "text": "چربشون براز بیتانیدی و همین موضوع پرستاد خیلی مهم"
    },
    {
      "id": 32,
      "start": 25026.0,
      "end": 25027.0,
      "formatted_start": "06:57:06.000",
      "formatted_end": "06:57:07.000",
      "text": "همه پرستاد چی بخونه؟"
    },
    {
      "id": 33,
      "start": 25027.0,
      "end": 25030.0,
      "formatted_start": "06:57:07.000",
      "formatted_end": "06:57:10.000",
      "text": "بهتون دارون میدم که همسون پرستاد بخونه"
    },
    {
      "id": 34,
      "start": 25030.0,
      "end": 25032.0,
      "formatted_start": "06:57:10.000",
      "formatted_end": "06:57:12.000",
      "text": "چند ساله تونه؟"
    },
    {
      "id": 35,
      "start": 25032.0,
      "end": 25034.0,
      "formatted_start": "06:57:12.000",
      "formatted_end": "06:57:14.000",
      "text": "سنتونه"
    },
    {
      "id": 36,
      "start": 25034.0,
      "end": 25036.0,
      "formatted_start": "06:57:14.000",
      "formatted_end": "06:57:16.000",
      "text": "سنتونه"
    },
    {
      "id": 37,
      "start": 25036.0,
      "end": 25038.0,
      "formatted_start": "06:57:16.000",
      "formatted_end": "06:57:18.000",
      "text": "موقع ادرار سوزش داری؟"
    },
    {
      "id": 38,
      "start": 25038.0,
      "end": 25040.0,
      "formatted_start": "06:57:18.000",
      "formatted_end": "06:57:20.000",
      "text": "ادرار سوزش داریم"
    },
    {
      "id": 39,
      "start": 25040.0,
      "end": 25042.0,
      "formatted_start": "06:57:20.000",
      "formatted_end": "06:57:22.000",
      "text": "کم رو دیگری یک"
    },
    {
      "id": 40,
      "start": 25042.0,
      "end": 25044.0,
      "formatted_start": "06:57:22.000",
      "formatted_end": "06:57:24.000",
      "text": "دیگری شده یک"
    },
    {
      "id": 41,
      "start": 25044.0,
      "end": 25046.0,
      "formatted_start": "06:57:24.000",
      "formatted_end": "06:57:26.000",
      "text": "محسنت تون برم داشته خوب کم کم کم"
    },
    {
      "id": 42,
      "start": 25046.0,
      "end": 25048.0,
      "formatted_start": "06:57:26.000",
      "formatted_end": "06:57:28.000",
      "text": "ادرار میمونه میمونه"
    },
    {
      "id": 43,
      "start": 25048.0,
      "end": 25050.0,
      "formatted_start": "06:57:28.000",
      "formatted_end": "06:57:30.000",
      "text": "خوب نمیدوند باریک میشه اینو"
    },
    {
      "id": 44,
      "start": 25050.0,
      "end": 25052.0,
      "formatted_start": "06:57:30.000",
      "formatted_end": "06:57:32.000",
      "text": "کم کم افتاده"
    },
    {
      "id": 45,
      "start": 25052.0,
      "end": 25054.0,
      "formatted_start": "06:57:32.000",
      "formatted_end": "06:57:34.000",
      "text": "زندگی شده یا نه؟"
    },
    {
      "id": 46,
      "start": 25054.0,
      "end": 25056.0,
      "formatted_start": "06:57:34.000",
      "formatted_end": "06:57:36.000",
      "text": "زندگی شده یا نه"
    },
    {
      "id": 47,
      "start": 25056.0,
      "end": 25058.0,
      "formatted_start": "06:57:36.000",
      "formatted_end": "06:57:38.000",
      "text": "داری داده دیگری"
    },
    {
      "id": 48,
      "start": 25058.0,
      "end": 25063.46,
      "formatted_start": "06:57:38.000",
      "formatted_end": "06:57:43.460",
      "text": "این آروقه کمتر شده و همینوز ترنده"
    },
    {
      "id": 49,
      "start": 25063.46,
      "end": 25066.16,
      "formatted_start": "06:57:43.460",
      "formatted_end": "06:57:46.160",
      "text": "بردشون به خاطر کمتشون چرمه"
    },
    {
      "id": 50,
      "start": 25066.16,
      "end": 25067.54,
      "formatted_start": "06:57:46.160",
      "formatted_end": "06:57:47.540",
      "text": "بردشون بردشون"
    },
    {
      "id": 51,
      "start": 25067.54,
      "end": 25068.66,
      "formatted_start": "06:57:47.540",
      "formatted_end": "06:57:48.660",
      "text": "بردشون بردشون"
    },
    {
      "id": 52,
      "start": 25068.66,
      "end": 25070.66,
      "formatted_start": "06:57:48.660",
      "formatted_end": "06:57:50.660",
      "text": "بشه ها میاره رومده"
    },
    {
      "id": 53,
      "start": 25070.66,
      "end": 25071.66,
      "formatted_start": "06:57:50.660",
      "formatted_end": "06:57:51.660",
      "text": "بشه ها میاره رومده"
    },
    {
      "id": 54,
      "start": 25071.66,
      "end": 25076.0,
      "formatted_start": "06:57:51.660",
      "formatted_end": "06:57:56.000",
      "text": "سر کنید تو خونتون بعد این غذا میخورید تا نیم ساعت نشینید"
    },
    {
      "id": 55,
      "start": 25076.0,
      "end": 25077.0,
      "formatted_start": "06:57:56.000",
      "formatted_end": "06:57:57.000",
      "text": "سر کنید تو خونتون بعد این غذا میخورید تا نیم ساعت نشینید"
    },
    {
      "id": 56,
      "start": 25077.0,
      "end": 25079.0,
      "formatted_start": "06:57:57.000",
      "formatted_end": "06:57:59.000",
      "text": "همون آهسته تو خونه رافه"
    },
    {
      "id": 57,
      "start": 25079.0,
      "end": 25080.0,
      "formatted_start": "06:57:59.000",
      "formatted_end": "06:58:00.000",
      "text": "همون آهسته تو خونه رافه"
    },
    {
      "id": 58,
      "start": 25080.0,
      "end": 25081.0,
      "formatted_start": "06:58:00.000",
      "formatted_end": "06:58:01.000",
      "text": "نمیخواد ورزش سر کنید"
    },
    {
      "id": 59,
      "start": 25081.0,
      "end": 25085.0,
      "formatted_start": "06:58:01.000",
      "formatted_end": "06:58:05.000",
      "text": "بازرم یه مدت میشینم قبل از هر ادرازی کنم"
    },
    {
      "id": 60,
      "start": 25085.0,
      "end": 25087.0,
      "formatted_start": "06:58:05.000",
      "formatted_end": "06:58:07.000",
      "text": "راه بدم"
    },
    {
      "id": 61,
      "start": 25087.0,
      "end": 25094.0,
      "formatted_start": "06:58:07.000",
      "formatted_end": "06:58:14.000",
      "text": "بله همینی که این موضوع کبد چرم شما بخواده بی تردکیه"
    },
    {
      "id": 62,
      "start": 25094.0,
      "end": 25101.0,
      "formatted_start": "06:58:14.000",
      "formatted_end": "06:58:21.000",
      "text": "من صبح که اداره میرم تا زور یاده که جشنگی دیگه نمیرم"
    },
    {
      "id": 63,
      "start": 25101.0,
      "end": 25104.0,
      "formatted_start": "06:58:21.000",
      "formatted_end": "06:58:24.000",
      "text": "این مشکلی بخاطر این نبود دیگه برای پلاستاد؟"
    },
    {
      "id": 64,
      "start": 25104.0,
      "end": 25108.0,
      "formatted_start": "06:58:24.000",
      "formatted_end": "06:58:28.000",
      "text": "نه پلاستاد، پلاستاد، پلاستاد ادرانم بر ترجمه کنم"
    },
    {
      "id": 65,
      "start": 25108.0,
      "end": 25110.0,
      "formatted_start": "06:58:28.000",
      "formatted_end": "06:58:30.000",
      "text": "خیلی بگم"
    },
    {
      "id": 66,
      "start": 25110.0,
      "end": 25114.24,
      "formatted_start": "06:58:30.000",
      "formatted_end": "06:58:34.240",
      "text": "اما صبح دیگه کنجا دستویی قرنگی نره نمیدونه"
    },
    {
      "id": 67,
      "start": 25114.24,
      "end": 25116.24,
      "formatted_start": "06:58:34.240",
      "formatted_end": "06:58:36.240",
      "text": "سخت نشستن با خاطر اینکه"
    },
    {
      "id": 68,
      "start": 25116.24,
      "end": 25119.24,
      "formatted_start": "06:58:36.240",
      "formatted_end": "06:58:39.240",
      "text": "اون باعث پروستاتتون نشده ها"
    },
    {
      "id": 69,
      "start": 25119.24,
      "end": 25123.24,
      "formatted_start": "06:58:39.240",
      "formatted_end": "06:58:43.240",
      "text": "پروستاتتون همه آقایون با افزایش سن بعد از 30 سال شروع میشه"
    },
    {
      "id": 70,
      "start": 25123.24,
      "end": 25125.24,
      "formatted_start": "06:58:43.240",
      "formatted_end": "06:58:45.240",
      "text": "دیگه در واقع درمان"
    },
    {
      "id": 71,
      "start": 25125.24,
      "end": 25127.24,
      "formatted_start": "06:58:45.240",
      "formatted_end": "06:58:47.240",
      "text": "تو مشکل عرضی نپردیده"
    },
    {
      "id": 72,
      "start": 25127.24,
      "end": 25129.24,
      "formatted_start": "06:58:47.240",
      "formatted_end": "06:58:49.240",
      "text": "نه نه"
    },
    {
      "id": 73,
      "start": 25129.24,
      "end": 25133.24,
      "formatted_start": "06:58:49.240",
      "formatted_end": "06:58:53.240",
      "text": "کپسول پروستاتتون خورس پروستاتتون هر شب بخوایید خب"
    },
    {
      "id": 74,
      "start": 25133.24,
      "end": 25139.24,
      "formatted_start": "06:58:53.240",
      "formatted_end": "06:58:59.240",
      "text": "کپسون نمیداشتم به خاطر اینکه در وقت توی جنسی توی مشکل نجات نکنه"
    },
    {
      "id": 75,
      "start": 25140.24,
      "end": 25146.24,
      "formatted_start": "06:59:00.240",
      "formatted_end": "06:59:06.240",
      "text": "همدوچان برفشتر از این اومده باشه دلیل سپرک که میمانشونه"
    },
    {
      "id": 76,
      "start": 25146.24,
      "end": 25147.24,
      "formatted_start": "06:59:06.240",
      "formatted_end": "06:59:07.240",
      "text": "بیمه نمیخوره"
    },
    {
      "id": 77,
      "start": 25148.24,
      "end": 25149.24,
      "formatted_start": "06:59:08.240",
      "formatted_end": "06:59:09.240",
      "text": "آزاده"
    },
    {
      "id": 78,
      "start": 25149.24,
      "end": 25150.24,
      "formatted_start": "06:59:09.240",
      "formatted_end": "06:59:10.240",
      "text": "آزاده؟"
    },
    {
      "id": 79,
      "start": 25150.24,
      "end": 25151.24,
      "formatted_start": "06:59:10.240",
      "formatted_end": "06:59:11.240",
      "text": "آه آزاده"
    },
    {
      "id": 80,
      "start": 25151.24,
      "end": 25152.24,
      "formatted_start": "06:59:11.240",
      "formatted_end": "06:59:12.240",
      "text": "آره بیمه نمیخوره"
    },
    {
      "id": 81,
      "start": 25152.24,
      "end": 25154.24,
      "formatted_start": "06:59:12.240",
      "formatted_end": "06:59:14.240",
      "text": "بیمه تکمیلی داره این شد بکنه"
    },
    {
      "id": 82,
      "start": 25154.24,
      "end": 25156.24,
      "formatted_start": "06:59:14.240",
      "formatted_end": "06:59:16.240",
      "text": "بیمه نمیخوره اگه نمیمون کنه باید آزاده بیمه"
    },
    {
      "id": 83,
      "start": 25156.24,
      "end": 25159.24,
      "formatted_start": "06:59:16.240",
      "formatted_end": "06:59:19.240",
      "text": "چون تکمیلی داره میزنم برین آسان توی سیستم هستیم"
    },
    {
      "id": 84,
      "start": 25159.24,
      "end": 25166.24,
      "formatted_start": "06:59:19.240",
      "formatted_end": "06:59:26.240",
      "text": "اما سینوپین، چون این چیزهایی که اینجوریه، اما از اینجور باز نمیدونه، سینوپین دو کلیه برسن"
    },
    {
      "id": 85,
      "start": 25166.24,
      "end": 25169.24,
      "formatted_start": "06:59:26.240",
      "formatted_end": "06:59:29.240",
      "text": "خب، از کلیه برسن، اما برام دوتو برای کمرا همگه میاده"
    },
    {
      "id": 86,
      "start": 25169.24,
      "end": 25171.24,
      "formatted_start": "06:59:29.240",
      "formatted_end": "06:59:31.240",
      "text": "نه خب ببینم اسطوپین"
    },
    {
      "id": 87,
      "start": 25171.24,
      "end": 25173.24,
      "formatted_start": "06:59:31.240",
      "formatted_end": "06:59:33.240",
      "text": "ببینم اسطوپین شو ببخشیم شو"
    },
    {
      "id": 88,
      "start": 25173.24,
      "end": 25175.24,
      "formatted_start": "06:59:33.240",
      "formatted_end": "06:59:35.240",
      "text": "اسطوپین"
    },
    {
      "id": 89,
      "start": 25177.24,
      "end": 25179.24,
      "formatted_start": "06:59:37.240",
      "formatted_end": "06:59:39.240",
      "text": "حالا این دستایم کلیه یه برم میسته؟"
    },
    {
      "id": 90,
      "start": 25179.24,
      "end": 25181.24,
      "formatted_start": "06:59:39.240",
      "formatted_end": "06:59:41.240",
      "text": "نه"
    },
    {
      "id": 91,
      "start": 25181.24,
      "end": 25183.24,
      "formatted_start": "06:59:41.240",
      "formatted_end": "06:59:43.240",
      "text": "چی؟"
    },
    {
      "id": 92,
      "start": 25183.24,
      "end": 25185.24,
      "formatted_start": "06:59:43.240",
      "formatted_end": "06:59:45.240",
      "text": "اون دستایم داشتم"
    },
    {
      "id": 93,
      "start": 25185.24,
      "end": 25187.24,
      "formatted_start": "06:59:45.240",
      "formatted_end": "06:59:47.240",
      "text": "کلیه تو؟ چرا؟"
    },
    {
      "id": 94,
      "start": 25187.24,
      "end": 25189.24,
      "formatted_start": "06:59:47.240",
      "formatted_end": "06:59:49.240",
      "text": "میتونه اونم کلیه تو زعیب کرده"
    },
    {
      "id": 95,
      "start": 25189.24,
      "end": 25191.24,
      "formatted_start": "06:59:49.240",
      "formatted_end": "06:59:51.240",
      "text": "چون ولی اون وقتی شما"
    },
    {
      "id": 96,
      "start": 25191.24,
      "end": 25193.24,
      "formatted_start": "06:59:51.240",
      "formatted_end": "06:59:53.240",
      "text": "اصلا به سموعی ایچکار نداریم"
    },
    {
      "id": 97,
      "start": 25193.24,
      "end": 25195.24,
      "formatted_start": "06:59:53.240",
      "formatted_end": "06:59:55.240",
      "text": "حال به شما مراکره"
    },
    {
      "id": 98,
      "start": 25195.24,
      "end": 25197.24,
      "formatted_start": "06:59:55.240",
      "formatted_end": "06:59:57.240",
      "text": "یه آقا من ادارم"
    },
    {
      "id": 99,
      "start": 25197.24,
      "end": 25199.24,
      "formatted_start": "06:59:57.240",
      "formatted_end": "06:59:59.240",
      "text": "اون فشارش باشید"
    }
  ],
  "status": "completed"
}