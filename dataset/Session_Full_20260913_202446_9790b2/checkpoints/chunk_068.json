    },
    {
      "id": 24,
      "start": 20517.0,
      "end": 20519.0,
      "formatted_start": "05:41:57.000",
      "formatted_end": "05:41:59.000",
      "text": "اونجا برمشون داره"
    },
    {
      "id": 25,
      "start": 20519.0,
      "end": 20521.0,
      "formatted_start": "05:41:59.000",
      "formatted_end": "05:42:01.000",
      "text": "آسم برد چرا اسپلاتو برد می کنی؟"
    },
    {
      "id": 26,
      "start": 20521.0,
      "end": 20523.5,
      "formatted_start": "05:42:01.000",
      "formatted_end": "05:42:03.500",
      "text": "اصلا نمی زنند خاندون همه خوب می شوند نمی زنند"
    },
    {
      "id": 27,
      "start": 20523.5,
      "end": 20525.0,
      "formatted_start": "05:42:03.500",
      "formatted_end": "05:42:05.000",
      "text": "آدم واید راستش کنه"
    },
    {
      "id": 28,
      "start": 20525.0,
      "end": 20529.0,
      "formatted_start": "05:42:05.000",
      "formatted_end": "05:42:09.000",
      "text": "خب این باعث می شود که بعدا بزرگتر بشه"
    },
    {
      "id": 29,
      "start": 20529.0,
      "end": 20532.5,
      "formatted_start": "05:42:09.000",
      "formatted_end": "05:42:12.500",
      "text": "دیگه یه آسم شدید می گیره که خب با دارور قبیل هم همدونه کنه"
    },
    {
      "id": 30,
      "start": 20532.5,
      "end": 20534.5,
      "formatted_start": "05:42:12.500",
      "formatted_end": "05:42:14.500",
      "text": "حالا مثلا می گوید اینجا می سوزه خب؟"
    },
    {
      "id": 31,
      "start": 20534.5,
      "end": 20535.0,
      "formatted_start": "05:42:14.500",
      "formatted_end": "05:42:15.000",
      "text": "آسم"
    },
    {
      "id": 32,
      "start": 20535.0,
      "end": 20536.0,
      "formatted_start": "05:42:15.000",
      "formatted_end": "05:42:16.000",
      "text": "می سوزه خب؟"
    },
    {
      "id": 33,
      "start": 20536.0,
      "end": 20538.0,
      "formatted_start": "05:42:16.000",
      "formatted_end": "05:42:18.000",
      "text": "حالا میزنه در سر بوده خب؟"
    },
    {
      "id": 34,
      "start": 20538.0,
      "end": 20539.0,
      "formatted_start": "05:42:18.000",
      "formatted_end": "05:42:19.000",
      "text": "برای من"
    },
    {
      "id": 35,
      "start": 20539.0,
      "end": 20540.0,
      "formatted_start": "05:42:19.000",
      "formatted_end": "05:42:20.000",
      "text": "سرمان می شوند"
    },
    {
      "id": 36,
      "start": 20540.0,
      "end": 20540.5,
      "formatted_start": "05:42:20.000",
      "formatted_end": "05:42:20.500",
      "text": "آره"
    },
    {
      "id": 37,
      "start": 20540.5,
      "end": 20545.5,
      "formatted_start": "05:42:20.500",
      "formatted_end": "05:42:25.500",
      "text": "من اینجا میخوام چرا منه؟ خب بگو تو هر سنده تا میده باید بشتر میشی"
    },
    {
      "id": 38,
      "start": 20545.5,
      "end": 20547.5,
      "formatted_start": "05:42:25.500",
      "formatted_end": "05:42:27.500",
      "text": "بگو باید بزنی استفاده اتا"
    },
    {
      "id": 39,
      "start": 20547.5,
      "end": 20549.5,
      "formatted_start": "05:42:27.500",
      "formatted_end": "05:42:29.500",
      "text": "از سنگون پرنده چیزی بوده"
    },
    {
      "id": 40,
      "start": 20549.5,
      "end": 20550.5,
      "formatted_start": "05:42:29.500",
      "formatted_end": "05:42:30.500",
      "text": "نه"
    },
    {
      "id": 41,
      "start": 20550.5,
      "end": 20552.5,
      "formatted_start": "05:42:30.500",
      "formatted_end": "05:42:32.500",
      "text": "از سنگون داری من یک اتاق دیگه هست"
    },
    {
      "id": 42,
      "start": 20552.5,
      "end": 20554.5,
      "formatted_start": "05:42:32.500",
      "formatted_end": "05:42:34.500",
      "text": "برای اتاق سمیزی بود"
    },
    {
      "id": 43,
      "start": 20554.5,
      "end": 20556.5,
      "formatted_start": "05:42:34.500",
      "formatted_end": "05:42:36.500",
      "text": "اتاق توبات نیست به حوال حالتون"
    },
    {
      "id": 44,
      "start": 20556.5,
      "end": 20558.5,
      "formatted_start": "05:42:36.500",
      "formatted_end": "05:42:38.500",
      "text": "نه نه بیشتر برسون"
    },
    {
      "id": 45,
      "start": 20558.5,
      "end": 20561.5,
      "formatted_start": "05:42:38.500",
      "formatted_end": "05:42:41.500",
      "text": "بلی اگه میخوایم بهش میگم جمعیشون"
    },
    {
      "id": 46,
      "start": 20561.5,
      "end": 20563.5,
      "formatted_start": "05:42:41.500",
      "formatted_end": "05:42:43.500",
      "text": "چون اینو همه جده تو درگه"
    },
    {
      "id": 47,
      "start": 20563.5,
      "end": 20565.5,
      "formatted_start": "05:42:43.500",
      "formatted_end": "05:42:45.500",
      "text": "بله شوهر خودم آن رو ریش در چیزه"
    },
    {
      "id": 48,
      "start": 20565.5,
      "end": 20566.5,
      "formatted_start": "05:42:45.500",
      "formatted_end": "05:42:46.500",
      "text": "خوبه نه"
    },
    {
      "id": 49,
      "start": 20566.5,
      "end": 20567.5,
      "formatted_start": "05:42:46.500",
      "formatted_end": "05:42:47.500",
      "text": "اینجوری چه نگه هست؟"
    },
    {
      "id": 50,
      "start": 20567.5,
      "end": 20569.5,
      "formatted_start": "05:42:47.500",
      "formatted_end": "05:42:49.500",
      "text": "چی میدونم؟ دوتا اووردن زیادی اینگه نه"
    },
    {
      "id": 51,
      "start": 20569.5,
      "end": 20574.5,
      "formatted_start": "05:42:49.500",
      "formatted_end": "05:42:54.500",
      "text": "برکه زنو اطراف و تمام موید همون کنه هست خوری میشه"
    },
    {
      "id": 52,
      "start": 20574.5,
      "end": 20576.5,
      "formatted_start": "05:42:54.500",
      "formatted_end": "05:42:56.500",
      "text": "نفس میدونش"
    },
    {
      "id": 53,
      "start": 20576.5,
      "end": 20586.5,
      "formatted_start": "05:42:56.500",
      "formatted_end": "05:43:06.500",
      "text": "از این حال، با این نظر کنید که این نظر را به نظر آنها برداشت."
    },
    {
      "id": 54,
      "start": 20586.5,
      "end": 20596.5,
      "formatted_start": "05:43:06.500",
      "formatted_end": "05:43:16.500",
      "text": "از این حال، با این نظر کنید که این نظر را به نظر آنها برداشت."
    },
    {
      "id": 55,
      "start": 20596.5,
      "end": 20598.5,
      "formatted_start": "05:43:16.500",
      "formatted_end": "05:43:18.500",
      "text": "نه، سویزه نداره"
    },
    {
      "id": 56,
      "start": 20598.5,
      "end": 20599.5,
      "formatted_start": "05:43:18.500",
      "formatted_end": "05:43:19.500",
      "text": "فرماتیس چیه؟"
    },
    {
      "id": 57,
      "start": 20599.5,
      "end": 20600.5,
      "formatted_start": "05:43:19.500",
      "formatted_end": "05:43:20.500",
      "text": "یه هست، فرماتیس"
    },
    {
      "id": 58,
      "start": 20600.5,
      "end": 20604.5,
      "formatted_start": "05:43:20.500",
      "formatted_end": "05:43:24.500",
      "text": "اونو بیش بستن، کش نمی کنه، خیلی خیلی خیلی خیلی"
    },
    {
      "id": 59,
      "start": 20604.5,
      "end": 20606.5,
      "formatted_start": "05:43:24.500",
      "formatted_end": "05:43:26.500",
      "text": "نه، سی بار کنه"
    },
    {
      "id": 60,
      "start": 20606.5,
      "end": 20608.5,
      "formatted_start": "05:43:26.500",
      "formatted_end": "05:43:28.500",
      "text": "بچه برده شدن"
    },
    {
      "id": 61,
      "start": 20608.5,
      "end": 20610.5,
      "formatted_start": "05:43:28.500",
      "formatted_end": "05:43:30.500",
      "text": "باید شما درم وردش برده شدن"
    },
    {
      "id": 62,
      "start": 20610.5,
      "end": 20612.5,
      "formatted_start": "05:43:30.500",
      "formatted_end": "05:43:32.500",
      "text": "اصلا خیلی خوب شدن شما باید بیش برده شدن"
    },
    {
      "id": 63,
      "start": 20612.5,
      "end": 20615.5,
      "formatted_start": "05:43:32.500",
      "formatted_end": "05:43:35.500",
      "text": "اصلا این شما یه وردی نیسته، باید بیش برده خیلی خوب شدن"
    },
    {
      "id": 64,
      "start": 20615.5,
      "end": 20617.5,
      "formatted_start": "05:43:35.500",
      "formatted_end": "05:43:37.500",
      "text": "ببینید چیه، ببینید چیه"
    },
    {
