      "start": 21235.44,
      "end": 21237.44,
      "formatted_start": "05:53:55.440",
      "formatted_end": "05:53:57.440",
      "text": "هر اینجا برگردیم"
    },
    {
      "id": 84,
      "start": 21237.44,
      "end": 21239.44,
      "formatted_start": "05:53:57.440",
      "formatted_end": "05:53:59.440",
      "text": "اینجا آزمایش همون کم همون"
    },
    {
      "id": 85,
      "start": 21239.44,
      "end": 21269.44,
      "formatted_start": "05:53:59.440",
      "formatted_end": "05:54:29.440",
      "text": "از اینجا باید بردارید که اینجا باید بردارید که اینجا بردارید که اینجا بردارید که اینجا بردارید که اینجا بردارید که اینجا بردارید که اینجا بردارید که اینجا بردارید که اینجا بردارید که اینجا بردارید که اینجا بردارید که اینجا بردارید که اینجا بردارید که اینجا بردارید که اینجا بردارید که اینجا بردارید که اینجا برداری"
    },
    {
      "id": 86,
      "start": 21269.44,
      "end": 21274.44,
      "formatted_start": "05:54:29.440",
      "formatted_end": "05:54:34.440",
      "text": "این آزمایشی که من رفتم چند سپیش کردم"
    },
    {
      "id": 87,
      "start": 21274.44,
      "end": 21277.44,
      "formatted_start": "05:54:34.440",
      "formatted_end": "05:54:37.440",
      "text": "اون همین با ماتیس مویلها رو چک کرده"
    },
    {
      "id": 88,
      "start": 21277.44,
      "end": 21281.44,
      "formatted_start": "05:54:37.440",
      "formatted_end": "05:54:41.440",
      "text": "این آزمایشی که دو بردی که بیشتر بود"
    },
    {
      "id": 89,
      "start": 21281.44,
      "end": 21283.44,
      "formatted_start": "05:54:41.440",
      "formatted_end": "05:54:43.440",
      "text": "ماتیس همون چک کرده"
    },
    {
      "id": 90,
      "start": 21283.44,
      "end": 21287.44,
      "formatted_start": "05:54:43.440",
      "formatted_end": "05:54:47.440",
      "text": "این ناقصه ها از اونه من همینجورم برای چی کامل چک نکردم"
