      "text": "یادو یازو برد انجام بدی، خاطر جمع بشیم که فقط این آسمه، حالا یعنی این آسمه سادت شروع شده،"
    },
    {
      "id": 1,
      "start": 21008.0,
      "end": 21017.0,
      "formatted_start": "05:50:08.000",
      "formatted_end": "05:50:17.000",
      "text": "بعد شغله یکی دوشی که همدو گباره، چاپونه، یا جایی که سرب داره، خاک داره، اینها، ذرات پلاستیک داره، اینها رو بردید بردید."
    },
    {
      "id": 2,
      "start": 21017.0,
      "end": 21020.0,
      "formatted_start": "05:50:17.000",
      "formatted_end": "05:50:20.000",
      "text": "حالا این آزمایشو باید که انجام بدیم؟"
    },
    {
      "id": 3,
      "start": 21020.0,
      "end": 21023.0,
      "formatted_start": "05:50:20.000",
      "formatted_end": "05:50:23.000",
      "text": "آره، بخواهیم، چون شوستایی بیرون نداریم."
    },
    {
      "id": 4,
      "start": 21023.0,
      "end": 21025.0,
      "formatted_start": "05:50:23.000",
      "formatted_end": "05:50:25.000",
      "text": "آره، آزمایشاش هم مخصوص هستن؟"
    },
    {
      "id": 5,
      "start": 21025.0,
      "end": 21029.0,
      "formatted_start": "05:50:25.000",
      "formatted_end": "05:50:29.000",
      "text": "الان بیمه تنهای اجتماعی داری فرق میکنه ما بیمه رو رو سریع"
    },
    {
      "id": 6,
      "start": 21029.0,
      "end": 21032.0,
      "formatted_start": "05:50:29.000",
      "formatted_end": "05:50:32.000",
      "text": "ما داما دامند باید داروشو برسیم"
    },
    {
      "id": 7,
      "start": 21032.0,
      "end": 21034.0,
      "formatted_start": "05:50:32.000",
      "formatted_end": "05:50:34.000",
      "text": "داروشو که بیمه خوردی چیز"
    },
    {
      "id": 8,
      "start": 21034.0,
      "end": 21043.0,
      "formatted_start": "05:50:34.000",
      "formatted_end": "05:50:43.000",
      "text": "آزمایشو خاصه، یه وقتی خدایی اگه مشکل داشته باشه باز باید همین راه داباره برید که باید داروش مدرک سازی بکنیم"
    },
    {
      "id": 9,
      "start": 21043.0,
      "end": 21046.0,
      "formatted_start": "05:50:43.000",
      "formatted_end": "05:50:46.000",
      "text": "داروشو بیمه نوشتم"
    },
    {
      "id": 10,
      "start": 21046.0,
      "end": 21048.0,
      "formatted_start": "05:50:46.000",
      "formatted_end": "05:50:48.000",
      "text": "آزمایشو هر وقت خواست بره نشته این هست"
    },
    {
      "id": 11,
      "start": 21048.0,
      "end": 21050.0,
      "formatted_start": "05:50:48.000",
      "formatted_end": "05:50:50.000",
      "text": "چون شیش ساعت ناشته باشه بره"
    },
    {
      "id": 12,
      "start": 21050.0,
      "end": 21052.0,
      "formatted_start": "05:50:50.000",
      "formatted_end": "05:50:52.000",
      "text": "چرا ناشته باشه؟"
    },
    {
      "id": 13,
      "start": 21052.0,
      "end": 21054.0,
      "formatted_start": "05:50:52.000",
      "formatted_end": "05:50:54.000",
      "text": "شبانی دارو شاید شامل میبینه"
    },
    {
      "id": 14,
      "start": 21054.0,
      "end": 21056.0,
      "formatted_start": "05:50:54.000",
      "formatted_end": "05:50:56.000",
      "text": "نه دارو خوب میشه خب"
    },
    {
      "id": 15,
      "start": 21056.0,
      "end": 21058.0,
      "formatted_start": "05:50:56.000",
      "formatted_end": "05:50:58.000",
      "text": "ولی من باید بینم چرا تو اینقدر"
    },
    {
      "id": 16,
      "start": 21058.0,
      "end": 21060.0,
      "formatted_start": "05:50:58.000",
      "formatted_end": "05:51:00.000",
      "text": "ریعه آزمه شدیدی نبیده"
    },
    {
      "id": 17,
      "start": 21060.0,
      "end": 21062.0,
      "formatted_start": "05:51:00.000",
      "formatted_end": "05:51:02.000",
      "text": "از اینه باید نمیدونی این مثل اون"
    },
    {
      "id": 18,
      "start": 21062.0,
      "end": 21064.0,
      "formatted_start": "05:51:02.000",
      "formatted_end": "05:51:04.000",
      "text": "آزمه شاید 2-3 تومن شاید بشه"
    },
    {
      "id": 19,
      "start": 21064.0,
      "end": 21066.0,
      "formatted_start": "05:51:04.000",
      "formatted_end": "05:51:06.000",
      "text": "حالا یه کار کن اول اصلا داروشو بخوره خب"
    },
    {
      "id": 20,
      "start": 21066.0,
      "end": 21068.0,
      "formatted_start": "05:51:06.000",
      "formatted_end": "05:51:08.000",
      "text": "یه ماه که خالش خوب باشه"
    },
    {
      "id": 21,
      "start": 21068.0,
      "end": 21070.0,
      "formatted_start": "05:51:08.000",
      "formatted_end": "05:51:10.000",
      "text": "بیایش صدای ریعه شو گوش بدن"
    },
    {
      "id": 22,
      "start": 21070.0,
      "end": 21075.52,
      "formatted_start": "05:51:10.000",
      "formatted_end": "05:51:15.520",
      "text": "اگر کسی دیگر ساخت بشه که یکی برای یک دیگری اینجور بمانه دیگه باید کامل بررسه بشه"
    },
    {
      "id": 23,
      "start": 21075.52,
      "end": 21081.52,
      "formatted_start": "05:51:15.520",
      "formatted_end": "05:51:21.520",
      "text": "خب چون یکمک بیاری دوماتیز بردیه نباشه یک بیاری دیگه نباشه خب غذایی باور میاد"
    },
    {
      "id": 24,
      "start": 21081.52,
      "end": 21086.52,
      "formatted_start": "05:51:21.520",
      "formatted_end": "05:51:26.520",
      "text": "یکمک که خوبه بیاریش گوش بدم تو این سر نباید مصنفه از شدیدی بشه"
    },
    {
      "id": 25,
      "start": 21086.52,
      "end": 21088.76,
      "formatted_start": "05:51:26.520",
      "formatted_end": "05:51:28.760",
      "text": "بس پیدا بردار بشه؟"
    },
    {
      "id": 26,
      "start": 21088.76,
      "end": 21089.76,
      "formatted_start": "05:51:28.760",
      "formatted_end": "05:51:29.760",
      "text": "بردار بشه"
    },
    {
      "id": 27,
      "start": 21089.76,
      "end": 21090.44,
      "formatted_start": "05:51:29.760",
      "formatted_end": "05:51:30.440",
      "text": "خانه؟"
    },
    {
      "id": 28,
      "start": 21090.44,
      "end": 21091.0,
      "formatted_start": "05:51:30.440",
      "formatted_end": "05:51:31.000",
      "text": "باشه"
    },
    {
      "id": 29,
      "start": 21091.0,
      "end": 21092.64,
      "formatted_start": "05:51:31.000",
      "formatted_end": "05:51:32.640",
      "text": "باشه اینجور دستی ما در این موضوع داریم"
    },
    {
      "id": 30,
      "start": 21092.64,
      "end": 21093.44,
      "formatted_start": "05:51:32.640",
      "formatted_end": "05:51:33.440",
      "text": "خب"
    },
    {
      "id": 31,
      "start": 21093.44,
      "end": 21095.44,
      "formatted_start": "05:51:33.440",
      "formatted_end": "05:51:35.440",
      "text": "برای اینجا، از اینجا باید برداریم."
    },
    {
      "id": 32,
      "start": 21095.44,
      "end": 21097.44,
      "formatted_start": "05:51:35.440",
      "formatted_end": "05:51:37.440",
      "text": "برای اینجا، از اینجا باید برداریم."
    },
    {
      "id": 33,
      "start": 21097.44,
      "end": 21102.44,
      "formatted_start": "05:51:37.440",
      "formatted_end": "05:51:42.440",
      "text": "از این نصف صبح از صبح شب این هم نصف قبل از صبح. یه دونه قبل از صبح آنی."
    },
    {
      "id": 34,
      "start": 21102.44,
      "end": 21106.44,
      "formatted_start": "05:51:42.440",
      "formatted_end": "05:51:46.440",
      "text": "بعد به یک همه شکل ها تروا داشته همه شکل همه شکل هم بد بوده."
    },
    {
      "id": 35,
      "start": 21106.44,
      "end": 21109.44,
      "formatted_start": "05:51:46.440",
      "formatted_end": "05:51:49.440",
      "text": "حالا بعد دو ماه اومده."
    },
    {
      "id": 36,
      "start": 21109.44,
      "end": 21113.44,
      "formatted_start": "05:51:49.440",
      "formatted_end": "05:51:53.440",
      "text": "باید برس داریم دو ماه در این همه تروا نمیدونیم که باید برس ناشته میده بهش بگیم."
    },
    {
      "id": 37,
      "start": 21113.44,
      "end": 21115.44,
      "formatted_start": "05:51:53.440",
      "formatted_end": "05:51:55.440",
      "text": "برس ناشته میده."
    },
    {
      "id": 38,
      "start": 21115.44,
      "end": 21121.44,
      "formatted_start": "05:51:55.440",
      "formatted_end": "05:52:01.440",
      "text": "اما اینکه باید برس ناشته میده بشید"
    },
    {
      "id": 39,
      "start": 21121.44,
      "end": 21123.44,
      "formatted_start": "05:52:01.440",
      "formatted_end": "05:52:03.440",
      "text": "برس ناشته میده"
    },
    {
      "id": 40,
      "start": 21123.44,
      "end": 21125.44,
      "formatted_start": "05:52:03.440",
      "formatted_end": "05:52:05.440",
      "text": "باید برس ناشته میده بشید"
    },
    {
      "id": 41,
      "start": 21125.44,
      "end": 21127.44,
      "formatted_start": "05:52:05.440",
      "formatted_end": "05:52:07.440",
      "text": "باید برس ناشته میده بشید"
    },
    {
      "id": 42,
      "start": 21127.44,
      "end": 21129.44,
      "formatted_start": "05:52:07.440",
      "formatted_end": "05:52:09.440",
      "text": "باید برس ناشته میده بشید"
    },
    {
      "id": 43,
      "start": 21129.44,
      "end": 21131.44,
      "formatted_start": "05:52:09.440",
      "formatted_end": "05:52:11.440",
      "text": "باید برس ناشته میده بشید"
    },
    {
      "id": 44,
      "start": 21131.44,
      "end": 21133.44,
      "formatted_start": "05:52:11.440",
      "formatted_end": "05:52:13.440",
      "text": "باید برس ناشته میده بشید"
    },
    {
      "id": 45,
      "start": 21133.44,
      "end": 21135.44,
      "formatted_start": "05:52:13.440",
      "formatted_end": "05:52:15.440",
      "text": "باید برس ناشته میده بشید"
    },
    {
      "id": 46,
      "start": 21135.44,
      "end": 21137.44,
      "formatted_start": "05:52:15.440",
      "formatted_end": "05:52:17.440",
      "text": "باید برس ناشته میده بشید"
    },
    {
      "id": 47,
      "start": 21137.44,
      "end": 21139.44,
      "formatted_start": "05:52:17.440",
      "formatted_end": "05:52:19.440",
      "text": "باید برس ناشته میده بشید"
    },
    {
      "id": 48,
      "start": 21139.44,
      "end": 21141.44,
      "formatted_start": "05:52:19.440",
      "formatted_end": "05:52:21.440",
      "text": "باید برس ناشته میده بشید"
    },
    {
      "id": 49,
      "start": 21141.44,
      "end": 21144.44,
      "formatted_start": "05:52:21.440",
      "formatted_end": "05:52:24.440",
      "text": "اینجا با سلسلی نشیدی بذاریم یا بازر بگیریم"
    },
    {
      "id": 50,
      "start": 21144.44,
      "end": 21147.44,
      "formatted_start": "05:52:24.440",
      "formatted_end": "05:52:27.440",
      "text": "با سلسلی نشیدی بذاریم یا بازر بگیریم"
    },
    {
      "id": 51,
      "start": 21147.44,
      "end": 21150.44,
      "formatted_start": "05:52:27.440",
      "formatted_end": "05:52:30.440",
      "text": "با سلسلی نشیدی بذاریم یا بازر بگیریم"
    },
    {
      "id": 52,
      "start": 21150.44,
      "end": 21153.44,
      "formatted_start": "05:52:30.440",
      "formatted_end": "05:52:33.440",
      "text": "با سلسلی نشیدی بذاریم یا بازر بگیریم"
    },
    {
      "id": 53,
      "start": 21153.44,
      "end": 21156.44,
      "formatted_start": "05:52:33.440",
      "formatted_end": "05:52:36.440",
      "text": "با سلسلی نشیدی بذاریم یا بازر بگیریم"
    },
    {
      "id": 54,
      "start": 21156.44,
      "end": 21159.44,
      "formatted_start": "05:52:36.440",
      "formatted_end": "05:52:39.440",
      "text": "با سلسلی نشیدی بذاریم یا بازر بگیریم"
    },
    {
      "id": 55,
      "start": 21159.44,
      "end": 21162.44,
      "formatted_start": "05:52:39.440",
      "formatted_end": "05:52:42.440",
      "text": "با سلسلی نشیدی بذاریم یا بازر بگیریم"
    },
    {
      "id": 56,
      "start": 21162.44,
      "end": 21165.44,
      "formatted_start": "05:52:42.440",
      "formatted_end": "05:52:45.440",
      "text": "باید بزرگ بشیم، اینجور این ها غریب نمیتونم بگناهیم"
    },
    {
      "id": 57,
      "start": 21165.44,
      "end": 21167.44,
      "formatted_start": "05:52:45.440",
      "formatted_end": "05:52:47.440",
      "text": "آشتی کنم، خیلی بابا"
    },
    {
      "id": 58,
      "start": 21169.44,
      "end": 21172.44,
      "formatted_start": "05:52:49.440",
      "formatted_end": "05:52:52.440",
      "text": "اینو تازه اونو باز باشیم"
    },
    {
      "id": 59,
      "start": 21175.44,
      "end": 21177.44,
      "formatted_start": "05:52:55.440",
      "formatted_end": "05:52:57.440",
      "text": "سرخ باشی؟"
    },
    {
      "id": 60,
      "start": 21177.44,
      "end": 21179.44,
      "formatted_start": "05:52:57.440",
      "formatted_end": "05:52:59.440",
      "text": "جا؟ نه"
    },
    {
      "id": 61,
      "start": 21180.44,
      "end": 21185.44,
      "formatted_start": "05:53:00.440",
      "formatted_end": "05:53:05.440",
      "text": "خوب دختر، خوب این زخمه آهنگ رو چک نکردی؟ همه آزمایش دادی"
    },
    {
      "id": 62,
      "start": 21185.44,
      "end": 21188.44,
      "formatted_start": "05:53:05.440",
      "formatted_end": "05:53:08.440",
      "text": "باید ببینیم ما اینترنت میگیم می ناری یا نه"
    },
    {
      "id": 63,
      "start": 21188.44,
      "end": 21192.44,
      "formatted_start": "05:53:08.440",
      "formatted_end": "05:53:12.440",
      "text": "اگر آهنگ از سخانه بالا بود که می نار می شود"
    },
    {
      "id": 64,
      "start": 21192.44,
      "end": 21194.44,
      "formatted_start": "05:53:12.440",
      "formatted_end": "05:53:14.440",
      "text": "اگر پنج باشد اصلا فهر آهنگ باشد باشید"
    },
    {
      "id": 65,
      "start": 21196.44,
      "end": 21199.44,
      "formatted_start": "05:53:16.440",
      "formatted_end": "05:53:19.440",
      "text": "اینجورم چک نکرده که اینو برداریم و می رویشم"
    },
    {
      "id": 66,
      "start": 21200.44,
      "end": 21201.44,
      "formatted_start": "05:53:20.440",
      "formatted_end": "05:53:21.440",
      "text": "همچنین رو برمی کنیم"
    },
    {
      "id": 67,
      "start": 21201.44,
      "end": 21203.44,
      "formatted_start": "05:53:21.440",
      "formatted_end": "05:53:23.440",
      "text": "اصلا خیلی بوده آدم آنهایی برمی هدید"
    },
    {
      "id": 68,
      "start": 21204.44,
      "end": 21205.44,
      "formatted_start": "05:53:24.440",
      "formatted_end": "05:53:25.440",
      "text": "هرگاه تیار بسیاری"
    },
    {
      "id": 69,
      "start": 21205.44,
      "end": 21209.44,
      "formatted_start": "05:53:25.440",
      "formatted_end": "05:53:29.440",
      "text": "آزمایش مخصوص داره دیگه نامر استرس و چیل نداره مریض به مرگ بشه"
    },
    {
      "id": 70,
      "start": 21209.44,
      "end": 21212.44,
      "formatted_start": "05:53:29.440",
      "formatted_end": "05:53:32.440",
      "text": "بله جایی نمیستم بازمان بردار جانبیت تشکیل"
    },
    {
      "id": 71,
      "start": 21212.44,
      "end": 21214.44,
      "formatted_start": "05:53:32.440",
      "formatted_end": "05:53:34.440",
      "text": "این آزمایش هم در اینجا روشتند"
    },
    {
      "id": 72,
      "start": 21214.44,
      "end": 21215.44,
      "formatted_start": "05:53:34.440",
      "formatted_end": "05:53:35.440",
      "text": "در اینجا؟"
    },
    {
      "id": 73,
      "start": 21215.44,
      "end": 21217.44,
      "formatted_start": "05:53:35.440",
      "formatted_end": "05:53:37.440",
      "text": "اینجا روشتند، همه من"
    },
    {
      "id": 74,
      "start": 21217.44,
      "end": 21219.44,
      "formatted_start": "05:53:37.440",
      "formatted_end": "05:53:39.440",
      "text": "چون اینجا دارو آشوند؟"
    },
    {
      "id": 75,
      "start": 21219.44,
      "end": 21221.44,
      "formatted_start": "05:53:39.440",
      "formatted_end": "05:53:41.440",
      "text": "اینجا"
    },
    {
      "id": 76,
      "start": 21221.44,
      "end": 21223.44,
      "formatted_start": "05:53:41.440",
      "formatted_end": "05:53:43.440",
      "text": "چون دارو آشوند؟"
    },
    {
      "id": 77,
      "start": 21223.44,
      "end": 21225.44,
      "formatted_start": "05:53:43.440",
      "formatted_end": "05:53:45.440",
      "text": "دارو آشوند، بلکه در اینجا برگردیم"
    },
    {
      "id": 78,
      "start": 21225.44,
      "end": 21227.44,
      "formatted_start": "05:53:45.440",
      "formatted_end": "05:53:47.440",
      "text": "هرچی سه همون کم همون"
    },
    {
      "id": 79,
      "start": 21227.44,
      "end": 21229.44,
      "formatted_start": "05:53:47.440",
      "formatted_end": "05:53:49.440",
      "text": "کم همون کم همون"
    },
    {
      "id": 80,
      "start": 21229.44,
      "end": 21231.44,
      "formatted_start": "05:53:49.440",
      "formatted_end": "05:53:51.440",
      "text": "کم همون"
    },
    {
      "id": 81,
      "start": 21231.44,
      "end": 21233.44,
      "formatted_start": "05:53:51.440",
      "formatted_end": "05:53:53.440",
      "text": "همجوری هیوه اینجا ببتوخ برداشتند"
    },
    {
      "id": 82,
      "start": 21233.44,
      "end": 21235.44,
      "formatted_start": "05:53:53.440",
      "formatted_end": "05:53:55.440",
      "text": "اما برای تا آزمایش ثابت بشند"
