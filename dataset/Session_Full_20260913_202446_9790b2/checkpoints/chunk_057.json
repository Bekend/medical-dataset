  "stt_segments": [
    {
      "id": 0,
      "start": 17100.0,
      "end": 17110.0,
      "formatted_start": "04:45:00.000",
      "formatted_end": "04:45:10.000",
      "text": "باید بشین شما رو از این روزه چندتا میخوره؟"
    },
    {
      "id": 1,
      "start": 17110.0,
      "end": 17112.0,
      "formatted_start": "04:45:10.000",
      "formatted_end": "04:45:12.000",
      "text": "این هم یکیه."
    },
    {
      "id": 2,
      "start": 17112.0,
      "end": 17114.0,
      "formatted_start": "04:45:12.000",
      "formatted_end": "04:45:14.000",
      "text": "بعد این که نستن؟"
    },
    {
      "id": 3,
      "start": 17114.0,
      "end": 17116.0,
      "formatted_start": "04:45:14.000",
      "formatted_end": "04:45:16.000",
      "text": "نه."
    },
    {
      "id": 4,
      "start": 17116.0,
      "end": 17118.0,
      "formatted_start": "04:45:16.000",
      "formatted_end": "04:45:18.000",
      "text": "چون سم بابندرده."
    },
    {
      "id": 5,
      "start": 17118.0,
      "end": 17120.0,
      "formatted_start": "04:45:18.000",
      "formatted_end": "04:45:20.000",
      "text": "سیتی باز نشدستن؟"
    },
    {
      "id": 6,
      "start": 17120.0,
      "end": 17122.0,
      "formatted_start": "04:45:20.000",
      "formatted_end": "04:45:22.000",
      "text": "چرا؟ بعد بخورش بودم."
    },
    {
      "id": 7,
      "start": 17122.0,
      "end": 17124.0,
      "formatted_start": "04:45:22.000",
      "formatted_end": "04:45:24.000",
      "text": "این هم یکیه."
    },
    {
      "id": 8,
      "start": 17124.0,
      "end": 17126.0,
      "formatted_start": "04:45:24.000",
      "formatted_end": "04:45:26.000",
      "text": "این میزه؟"
    },
    {
      "id": 9,
      "start": 17126.0,
