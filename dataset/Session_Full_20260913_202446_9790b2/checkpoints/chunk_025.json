    },
    {
      "id": 15,
      "start": 7576.0,
      "end": 7578.0,
      "formatted_start": "02:06:16.000",
      "formatted_end": "02:06:18.000",
      "text": "سامانه اوکی"
    },
    {
      "id": 16,
      "start": 7578.0,
      "end": 7580.0,
      "formatted_start": "02:06:18.000",
      "formatted_end": "02:06:20.000",
      "text": "سامانه اوکی"
    },
    {
      "id": 17,
      "start": 7580.0,
      "end": 7582.0,
      "formatted_start": "02:06:20.000",
      "formatted_end": "02:06:22.000",
      "text": "چون داروی صفت نرمیدم"
    },
    {
      "id": 18,
      "start": 7582.0,
      "end": 7584.0,
      "formatted_start": "02:06:22.000",
      "formatted_end": "02:06:24.000",
      "text": "ولی الان به نظر تو داروی نرمیدم"
    },
    {
      "id": 19,
      "start": 7584.0,
      "end": 7586.0,
      "formatted_start": "02:06:24.000",
      "formatted_end": "02:06:26.000",
      "text": "چون داروی نرمیدم"
    },
    {
      "id": 20,
      "start": 7586.0,
      "end": 7588.0,
      "formatted_start": "02:06:26.000",
      "formatted_end": "02:06:28.000",
      "text": "اوکی"
    },
    {
      "id": 21,
      "start": 7588.0,
      "end": 7590.0,
      "formatted_start": "02:06:28.000",
      "formatted_end": "02:06:30.000",
      "text": "اوکی"
    },
    {
      "id": 22,
      "start": 7590.0,
      "end": 7592.0,
      "formatted_start": "02:06:30.000",
      "formatted_end": "02:06:32.000",
      "text": "اوکی"
    },
    {
      "id": 23,
      "start": 7592.0,
      "end": 7594.0,
      "formatted_start": "02:06:32.000",
      "formatted_end": "02:06:34.000",
      "text": "اوکی"
    },
    {
      "id": 24,
      "start": 7594.0,
      "end": 7596.0,
      "formatted_start": "02:06:34.000",
      "formatted_end": "02:06:36.000",
      "text": "اوکی"
    },
    {
      "id": 25,
      "start": 7596.0,
      "end": 7598.0,
      "formatted_start": "02:06:36.000",
      "formatted_end": "02:06:38.000",
      "text": "اوکی"
    },
    {
      "id": 26,
      "start": 7598.0,
      "end": 7600.0,
      "formatted_start": "02:06:38.000",
      "formatted_end": "02:06:40.000",
      "text": "اوکی"
    },
    {
      "id": 27,
      "start": 7600.0,
      "end": 7606.0,
      "formatted_start": "02:06:40.000",
      "formatted_end": "02:06:46.000",
      "text": "خب نه سخت که نیست اون چیزی که در شیمسه گفته دیگه ناش بدنه"
    },
    {
      "id": 28,
      "start": 7606.0,
      "end": 7609.0,
      "formatted_start": "02:06:46.000",
      "formatted_end": "02:06:49.000",
      "text": "باست هم گفتیم در خود میزن دوران بمیمونه"
    },
    {
      "id": 29,
      "start": 7609.0,
      "end": 7614.0,
      "formatted_start": "02:06:49.000",
      "formatted_end": "02:06:54.000",
      "text": "نه سوابق اینا میخوای بری میگه که چیزه بیماره بعد هیچ کار چیلاسه"
    },
    {
      "id": 30,
      "start": 7614.0,
      "end": 7618.0,
      "formatted_start": "02:06:54.000",
      "formatted_end": "02:06:58.000",
      "text": "نه باید اتفاقا مثلا که میتونید ازشون همون مصدق باز تندید بزنید"
    },
    {
      "id": 31,
      "start": 7618.0,
      "end": 7626.0,
      "formatted_start": "02:06:58.000",
      "formatted_end": "02:07:06.000",
      "text": "آره هم به سر تندید نمایش سوابق نفتم یه بشه باش شمارتون توی دفتر کشفان شما سفت کنید"
    },
    {
      "id": 32,
      "start": 7626.0,
      "end": 7629.74,
      "formatted_start": "02:07:06.000",
      "formatted_end": "02:07:09.740",
      "text": "حالا منم شفتی نمسونه باش برم و منم شو"
    },
    {
      "id": 33,
      "start": 7629.74,
      "end": 7630.46,
      "formatted_start": "02:07:09.740",
      "formatted_end": "02:07:10.460",
      "text": "مرز بفرستم"
    },
    {
      "id": 34,
      "start": 7630.46,
      "end": 7631.14,
      "formatted_start": "02:07:10.460",
      "formatted_end": "02:07:11.140",
      "text": "مرز بفرستم"
    },
    {
      "id": 35,
      "start": 7631.14,
      "end": 7632.72,
      "formatted_start": "02:07:11.140",
      "formatted_end": "02:07:12.720",
      "text": "خانم مجایدی بخواهم"
    },
    {
      "id": 36,
      "start": 7632.72,
      "end": 7645.82,
      "formatted_start": "02:07:12.720",
      "formatted_end": "02:07:25.820",
      "text": "سلام"
    },
    {
      "id": 37,
      "start": 7645.82,
      "end": 7646.34,
      "formatted_start": "02:07:25.820",
      "formatted_end": "02:07:26.340",
      "text": "سلام"
    },
    {
      "id": 38,
      "start": 7646.34,
      "end": 7655.88,
      "formatted_start": "02:07:26.340",
      "formatted_end": "02:07:35.880",
      "text": "باشیم برم"
    },
    {
      "id": 39,
      "start": 7655.88,
      "end": 7685.88,
      "formatted_start": "02:07:35.880",
      "formatted_end": "02:08:05.880",
      "text": "از اینجا باید بردارید که از اینجا باید بردارید که از اینجا بردارید که از اینجا بردارید که از اینجا بردارید که از اینجا بردارید که از اینجا بردارید که از اینجا بردارید که از اینجا بردارید که از اینجا بردارید که از اینجا بردارید که از اینجا بردارید که از اینجا بردارید که از اینجا بردارید که از اینجا بردارید که از اینج"
    },
    {
      "id": 40,
      "start": 7685.88,
      "end": 7687.88,
      "formatted_start": "02:08:05.880",
      "formatted_end": "02:08:07.880",
      "text": "که سرطانشو عمل کرده؟"
    },
    {
      "id": 41,
      "start": 7687.88,
      "end": 7689.88,
      "formatted_start": "02:08:07.880",
      "formatted_end": "02:08:09.880",
      "text": "این صدایی نمیشه"
    },
    {
      "id": 42,
      "start": 7689.88,
      "end": 7691.88,
      "formatted_start": "02:08:09.880",
      "formatted_end": "02:08:11.880",
      "text": "شما مگه پرورده نداره؟"
    },
    {
      "id": 43,
      "start": 7691.88,
      "end": 7693.88,
      "formatted_start": "02:08:11.880",
      "formatted_end": "02:08:13.880",
      "text": "تو سیستمه دیگه"
    },
    {
      "id": 44,
      "start": 7693.88,
      "end": 7695.88,
      "formatted_start": "02:08:13.880",
      "formatted_end": "02:08:15.880",
      "text": "من این رو میادم"
    },
    {
      "id": 45,
      "start": 7695.88,
      "end": 7697.88,
      "formatted_start": "02:08:15.880",
      "formatted_end": "02:08:17.880",
      "text": "چرا ورز سرطانی داره؟"
    },
    {
      "id": 46,
      "start": 7697.88,
      "end": 7699.88,
      "formatted_start": "02:08:17.880",
      "formatted_end": "02:08:19.880",
      "text": "و الان داره شیوع نرمونی میشه؟"
    },
    {
      "id": 47,
      "start": 7699.88,
      "end": 7701.88,
      "formatted_start": "02:08:19.880",
      "formatted_end": "02:08:21.880",
      "text": "نه دیگه این همه تموم شده"
    },
    {
      "id": 48,
      "start": 7701.88,
      "end": 7703.88,
      "formatted_start": "02:08:21.880",
      "formatted_end": "02:08:23.880",
      "text": "فقط همین دوره ای که شما میکنید استفاده می کنید"
    },
    {
      "id": 49,
      "start": 7703.88,
      "end": 7705.88,
      "formatted_start": "02:08:23.880",
      "formatted_end": "02:08:25.880",
      "text": "همین اونها رو سرطان می کنید"
    },
    {
      "id": 50,
      "start": 7705.88,
      "end": 7707.88,
      "formatted_start": "02:08:25.880",
      "formatted_end": "02:08:27.880",
      "text": "خب ممکنه دوباره یه درست خوبه نکرده"
    },
    {
      "id": 51,
      "start": 7707.88,
      "end": 7709.88,
      "formatted_start": "02:08:27.880",
      "formatted_end": "02:08:29.880",
      "text": "عرض داشته باشه"
    },
    {
      "id": 52,
      "start": 7709.88,
      "end": 7711.88,
      "formatted_start": "02:08:29.880",
      "formatted_end": "02:08:31.880",
      "text": "یه آزمایش میدیسم"
    },
    {
      "id": 53,
      "start": 7711.88,
      "end": 7714.88,
      "formatted_start": "02:08:31.880",
      "formatted_end": "02:08:34.880",
      "text": "یک آزمایش میلیسم، حتما انجام بده"
    },
    {
      "id": 54,
      "start": 7714.88,
      "end": 7716.88,
      "formatted_start": "02:08:34.880",
      "formatted_end": "02:08:36.880",
      "text": "خوشحال"
    },
    {
      "id": 55,
      "start": 7716.88,
      "end": 7720.88,
      "formatted_start": "02:08:36.880",
      "formatted_end": "02:08:40.880",
      "text": "درم همه مالی چیزی نزده، چی بوده درم هم حاضر نیست"
    },
    {
      "id": 56,
      "start": 7720.88,
      "end": 7723.88,
      "formatted_start": "02:08:40.880",
      "formatted_end": "02:08:43.880",
      "text": "آساسی زده زبونش"
    },
    {
      "id": 57,
      "start": 7723.88,
      "end": 7726.88,
      "formatted_start": "02:08:43.880",
      "formatted_end": "02:08:46.880",
      "text": "این درم ها با سی درواست یا؟"
    },
    {
      "id": 58,
      "start": 7726.88,
      "end": 7731.88,
      "formatted_start": "02:08:46.880",
      "formatted_end": "02:08:51.880",
      "text": "همه مالی هم درواست کلن تموم شده، یک سرم دیگه سیلیس بهتوش ده"
    },
    {
      "id": 59,
      "start": 7731.88,
      "end": 7737.88,
      "formatted_start": "02:08:51.880",
      "formatted_end": "02:08:57.880",
      "text": "این دیگه دیگه چی دارم، شکر من کنم، کنم، بچه کنم"
    },
    {
      "id": 60,
      "start": 7737.88,
      "end": 7757.88,
      "formatted_start": "02:08:57.880",
      "formatted_end": "02:09:17.880",
      "text": "موسیقی"
    },
    {
      "id": 61,
      "start": 7787.88,
      "end": 7789.88,
      "formatted_start": "02:09:47.880",
      "formatted_end": "02:09:49.880",
      "text": "از اینجا باید باید برداری کنید."
    },
    {
      "id": 62,
      "start": 7789.88,
      "end": 7791.88,
      "formatted_start": "02:09:49.880",
      "formatted_end": "02:09:51.880",
      "text": "اینجا باید برداری کنید."
    },
    {
      "id": 63,
      "start": 7791.88,
      "end": 7793.88,
      "formatted_start": "02:09:51.880",
      "formatted_end": "02:09:53.880",
      "text": "اینجا باید برداری کنید."
    },
    {
      "id": 64,
      "start": 7793.88,
      "end": 7795.88,
      "formatted_start": "02:09:53.880",
      "formatted_end": "02:09:55.880",
      "text": "اینجا باید برداری کنید."
    },
    {
      "id": 65,
      "start": 7795.88,
      "end": 7797.88,
      "formatted_start": "02:09:55.880",
      "formatted_end": "02:09:57.880",
      "text": "اینجا باید برداری کنید."
    },
    {
      "id": 66,
      "start": 7797.88,
      "end": 7799.88,
      "formatted_start": "02:09:57.880",
      "formatted_end": "02:09:59.880",
      "text": "اینجا باید برداری کنید."
    }
