    },
    {
      "id": 2,
      "start": 20704.0,
      "end": 20706.0,
      "formatted_start": "05:45:04.000",
      "formatted_end": "05:45:06.000",
      "text": "آره."
    },
    {
      "id": 3,
      "start": 20706.0,
      "end": 20708.0,
      "formatted_start": "05:45:06.000",
      "formatted_end": "05:45:08.000",
      "text": "از اینجا باید برداری کنید."
    },
    {
      "id": 4,
      "start": 20708.0,
      "end": 20710.0,
      "formatted_start": "05:45:08.000",
      "formatted_end": "05:45:10.000",
      "text": "از اینجا باید برداری کنید."
    },
    {
      "id": 5,
      "start": 20710.0,
      "end": 20712.0,
      "formatted_start": "05:45:10.000",
      "formatted_end": "05:45:12.000",
      "text": "از اینجا باید برداری کنید."
    },
    {
      "id": 6,
      "start": 20712.0,
      "end": 20714.0,
      "formatted_start": "05:45:12.000",
      "formatted_end": "05:45:14.000",
      "text": "از اینجا باید برداری کنید."
    },
    {
      "id": 7,
      "start": 20714.0,
      "end": 20716.0,
      "formatted_start": "05:45:14.000",
      "formatted_end": "05:45:16.000",
      "text": "از اینجا باید برداری کنید."
    },
    {
      "id": 8,
      "start": 20716.0,
      "end": 20718.0,
      "formatted_start": "05:45:16.000",
      "formatted_end": "05:45:18.000",
      "text": "از اینجا باید برداری کنید."
    },
    {
      "id": 9,
      "start": 20718.0,
      "end": 20720.0,
      "formatted_start": "05:45:18.000",
      "formatted_end": "05:45:20.000",
      "text": "از اینجا باید برداری کنید."
    },
    {
      "id": 10,
      "start": 20720.0,
      "end": 20722.0,
      "formatted_start": "05:45:20.000",
      "formatted_end": "05:45:22.000",
      "text": "از اینجا باید برداری کنید."
    },
    {
      "id": 11,
      "start": 20722.0,
      "end": 20730.0,
      "formatted_start": "05:45:22.000",
      "formatted_end": "05:45:30.000",
      "text": "اینکه دنگرد سوکو آزخان بود که به خدا هم عاشنایی هم فامیل آدمی با خانم بعد از جان فامیل مونه"
    },
    {
      "id": 12,
      "start": 20730.0,
      "end": 20734.0,
      "formatted_start": "05:45:30.000",
      "formatted_end": "05:45:34.000",
      "text": "آتفه مثلا جاری میره"
    },
    {
      "id": 13,
      "start": 20734.0,
      "end": 20738.0,
      "formatted_start": "05:45:34.000",
      "formatted_end": "05:45:38.000",
      "text": "من یه برنامه خیلی چون میگم که پشت نسید بره بره بره"
    },
    {
      "id": 14,
      "start": 20738.0,
      "end": 20744.0,
      "formatted_start": "05:45:38.000",
      "formatted_end": "05:45:44.000",
      "text": "باید همه از جامعه سیلم بفترم بفترم پسر من با آسم این به خدا خیلی بجیرون خوب شد"
    },
    {
      "id": 15,
      "start": 20744.0,
      "end": 20751.0,
      "formatted_start": "05:45:44.000",
      "formatted_end": "05:45:51.000",
      "text": "من گروه برد متقرصه سیوان بردم کن نوهد خودبار بره نوهد جایی بره خطرناکه خواب بره"
    },
    {
      "id": 16,
      "start": 20751.0,
      "end": 20753.0,
      "formatted_start": "05:45:51.000",
      "formatted_end": "05:45:53.000",
      "text": "اسمان بده و روزی"
    },
    {
      "id": 17,
      "start": 20753.0,
      "end": 20755.0,
      "formatted_start": "05:45:53.000",
      "formatted_end": "05:45:55.000",
      "text": "دو درش بله همه اینا"
    },
    {
      "id": 18,
      "start": 20755.0,
      "end": 20757.0,
      "formatted_start": "05:45:55.000",
      "formatted_end": "05:45:57.000",
      "text": "بله من ندیدم"
    },
    {
      "id": 19,
      "start": 20757.0,
      "end": 20759.0,
      "formatted_start": "05:45:57.000",
      "formatted_end": "05:45:59.000",
      "text": "از اینکه من رو قرد کردی صورتی تو استفاده کنی"
    },
    {
      "id": 20,
      "start": 20759.0,
      "end": 20761.0,
      "formatted_start": "05:45:59.000",
      "formatted_end": "05:46:01.000",
      "text": "چشم"
    },
    {
      "id": 21,
      "start": 20761.0,
      "end": 20763.0,
      "formatted_start": "05:46:01.000",
      "formatted_end": "05:46:03.000",
      "text": "باشه اینو"
    },
    {
      "id": 22,
      "start": 20763.0,
      "end": 20765.0,
      "formatted_start": "05:46:03.000",
      "formatted_end": "05:46:05.000",
      "text": "اینو هیچ رفتر نکن"
    },
    {
      "id": 23,
      "start": 20765.0,
      "end": 20767.0,
      "formatted_start": "05:46:05.000",
      "formatted_end": "05:46:07.000",
      "text": "قلبت خروب میشه"
    },
    {
      "id": 24,
      "start": 20767.0,
      "end": 20769.0,
      "formatted_start": "05:46:07.000",
      "formatted_end": "05:46:09.000",
      "text": "باشه باور کن"
    },
    {
      "id": 25,
      "start": 20769.0,
      "end": 20771.0,
      "formatted_start": "05:46:09.000",
      "formatted_end": "05:46:11.000",
      "text": "خدایی نکرده قلبت خروب شد"
    },
    {
      "id": 26,
      "start": 20771.0,
      "end": 20773.0,
      "formatted_start": "05:46:11.000",
      "formatted_end": "05:46:13.000",
      "text": "درد سرداره ها"
    },
    {
      "id": 27,
      "start": 20773.0,
      "end": 20775.0,
      "formatted_start": "05:46:13.000",
      "formatted_end": "05:46:15.000",
      "text": "سر زندگی سختی داره"
    },
    {
      "id": 28,
      "start": 20775.0,
      "end": 20777.0,
      "formatted_start": "05:46:15.000",
      "formatted_end": "05:46:17.000",
      "text": "من یه تیرویت ازت چیم کنم"
    },
    {
      "id": 29,
      "start": 20777.0,
      "end": 20779.0,
      "formatted_start": "05:46:17.000",
      "formatted_end": "05:46:19.000",
      "text": "با یه روماتیس به خطه که"
    },
    {
      "id": 30,
      "start": 20779.0,
      "end": 20781.0,
      "formatted_start": "05:46:19.000",
      "formatted_end": "05:46:21.000",
      "text": "بچه بود رو آسم داشت؟"
    },
    {
      "id": 31,
      "start": 20781.0,
      "end": 20783.0,
      "formatted_start": "05:46:21.000",
      "formatted_end": "05:46:23.000",
      "text": "نه انقدر چیز نداشت"
    },
    {
      "id": 32,
      "start": 20783.0,
      "end": 20785.0,
      "formatted_start": "05:46:23.000",
      "formatted_end": "05:46:25.000",
      "text": "اصلا اینجا اونوردیم شهرستان گرفتش"
    },
    {
      "id": 33,
      "start": 20785.0,
      "end": 20787.0,
      "formatted_start": "05:46:25.000",
      "formatted_end": "05:46:27.000",
      "text": "آهان شاید به خاطر بود"
    },
    {
      "id": 34,
      "start": 20787.0,
      "end": 20789.0,
      "formatted_start": "05:46:27.000",
      "formatted_end": "05:46:29.000",
      "text": "شاید اگر بردید مثلا مشد هوای خشک"
    },
    {
      "id": 35,
      "start": 20789.0,
      "end": 20791.0,
      "formatted_start": "05:46:29.000",
      "formatted_end": "05:46:31.000",
      "text": "خشک بیشتر میشید"
    },
    {
      "id": 36,
      "start": 20791.0,
      "end": 20793.0,
      "formatted_start": "05:46:31.000",
      "formatted_end": "05:46:33.000",
      "text": "اون راست در اینجا ما رفته بیدم"
    },
    {
      "id": 37,
      "start": 20793.0,
      "end": 20795.0,
      "formatted_start": "05:46:33.000",
      "formatted_end": "05:46:35.000",
      "text": "حتی بابا دید مریض شدید"
    },
    {
      "id": 38,
      "start": 20795.0,
      "end": 20797.0,
      "formatted_start": "05:46:35.000",
      "formatted_end": "05:46:37.000",
      "text": "آره"
    },
    {
      "id": 39,
      "start": 20797.0,
      "end": 20799.0,
      "formatted_start": "05:46:37.000",
      "formatted_end": "05:46:39.000",
      "text": "اومدم اونجا خوب شدن بعد"
    },
    {
      "id": 40,
      "start": 20799.0,
      "end": 20801.0,
      "formatted_start": "05:46:39.000",
      "formatted_end": "05:46:41.000",
      "text": "اگرشتنی بیدم باز"
    },
    {
      "id": 41,
      "start": 20801.0,
      "end": 20803.0,
      "formatted_start": "05:46:41.000",
      "formatted_end": "05:46:43.000",
      "text": "نه گو من اونو تولر زنم"
    },
    {
      "id": 42,
      "start": 20803.0,
      "end": 20805.0,
      "formatted_start": "05:46:43.000",
      "formatted_end": "05:46:45.000",
      "text": "یه هفته بیشتر"
    },
    {
      "id": 43,
      "start": 20805.0,
      "end": 20807.0,
      "formatted_start": "05:46:45.000",
      "formatted_end": "05:46:47.000",
      "text": "میگو یه هفته من نمیدونم"
    },
    {
      "id": 44,
      "start": 20807.0,
      "end": 20809.0,
      "formatted_start": "05:46:47.000",
      "formatted_end": "05:46:49.000",
      "text": "دیدی تو اومده اترا"
    },
    {
      "id": 45,
      "start": 20809.0,
      "end": 20811.0,
      "formatted_start": "05:46:49.000",
      "formatted_end": "05:46:51.000",
      "text": "ببین هوای اونجا عالی دگی داره"
    },
    {
      "id": 46,
      "start": 20811.0,
      "end": 20813.0,
      "formatted_start": "05:46:51.000",
      "formatted_end": "05:46:53.000",
      "text": "بعدی خشکش برای ریشت بهتر"
    },
    {
      "id": 47,
      "start": 20813.0,
      "end": 20815.0,
      "formatted_start": "05:46:53.000",
      "formatted_end": "05:46:55.000",
      "text": "مطابق؟"
    },
    {
      "id": 48,
      "start": 20815.0,
      "end": 20817.0,
      "formatted_start": "05:46:55.000",
      "formatted_end": "05:46:57.000",
      "text": "نه بچه دید موردی اهلور مرسن"
    },
    {
      "id": 49,
      "start": 20817.0,
      "end": 20819.0,
      "formatted_start": "05:46:57.000",
      "formatted_end": "05:46:59.000",
      "text": "چون از از از از"
    },
    {
      "id": 50,
      "start": 20819.0,
      "end": 20821.0,
      "formatted_start": "05:46:59.000",
      "formatted_end": "05:47:01.000",
      "text": "بخشون بودم"
    },
    {
      "id": 51,
      "start": 20821.0,
      "end": 20823.0,
      "formatted_start": "05:47:01.000",
      "formatted_end": "05:47:03.000",
      "text": "همین بگم"
    },
    {
      "id": 52,
      "start": 20823.0,
      "end": 20825.0,
      "formatted_start": "05:47:03.000",
      "formatted_end": "05:47:05.000",
      "text": "مجامل کسی که بکشه"
    },
    {
      "id": 53,
      "start": 20825.0,
      "end": 20827.0,
      "formatted_start": "05:47:05.000",
      "formatted_end": "05:47:07.000",
      "text": "تو بیشتر هستی"
    },
    {
      "id": 54,
      "start": 20827.0,
      "end": 20829.0,
      "formatted_start": "05:47:07.000",
      "formatted_end": "05:47:09.000",
      "text": "دیدی بله بابا هم میکشه دیگه"
    },
    {
      "id": 55,
      "start": 20829.0,
      "end": 20831.0,
      "formatted_start": "05:47:09.000",
      "formatted_end": "05:47:11.000",
      "text": "بابا از این سن"
    },
    {
      "id": 56,
      "start": 20831.0,
      "end": 20833.0,
      "formatted_start": "05:47:11.000",
      "formatted_end": "05:47:13.000",
      "text": "از این سن از این نمیشه"
    },
    {
      "id": 57,
      "start": 20833.0,
      "end": 20835.0,
      "formatted_start": "05:47:13.000",
      "formatted_end": "05:47:15.000",
      "text": "نمیشه از این سن"
    },
    {
      "id": 58,
      "start": 20835.0,
      "end": 20840.0,
      "formatted_start": "05:47:15.000",
      "formatted_end": "05:47:20.000",
      "text": "اینجا بودن خوب بودن وردش می کردن و سالان می رفتن"
    },
    {
      "id": 59,
      "start": 20840.0,
      "end": 20843.0,
      "formatted_start": "05:47:20.000",
      "formatted_end": "05:47:23.000",
      "text": "آموین رفته سه جلسان سالان می رفتن"
    },
    {
      "id": 60,
      "start": 20843.0,
      "end": 20845.0,
      "formatted_start": "05:47:23.000",
      "formatted_end": "05:47:25.000",
      "text": "خوب شده بودن اصلا اگه اینجا دروره"
    },
    {
      "id": 61,
      "start": 20845.0,
      "end": 20849.0,
      "formatted_start": "05:47:25.000",
      "formatted_end": "05:47:29.000",
      "text": "الان باید دوباره با خدا هدی روز اومده نفس اصلا بالا نمی آر"
    },
    {
      "id": 62,
      "start": 20849.0,
      "end": 20853.0,
      "formatted_start": "05:47:29.000",
      "formatted_end": "05:47:33.000",
      "text": "بعدن خود جان می خوید جوان بیست ساپاری بیاد اونجوری باشه"
    },
    {
      "id": 63,
      "start": 20853.0,
      "end": 20857.0,
      "formatted_start": "05:47:33.000",
      "formatted_end": "05:47:37.000",
      "text": "بعد می کردن بیدن که بسیار سیگار می کردی با خدا سیگار هم نمی می کرده"
    },
    {
      "id": 64,
      "start": 20857.0,
      "end": 20861.3,
      "formatted_start": "05:47:37.000",
      "formatted_end": "05:47:41.300",
      "text": "جوانه اصلا بیس... خیلی بباشه 15 سال شده سیگای میکشن"
    },
    {
      "id": 65,
      "start": 20861.3,
      "end": 20863.1,
      "formatted_start": "05:47:41.300",
      "formatted_end": "05:47:43.100",
      "text": "من خودم دیدم زیر خونه اون"
    },
    {
      "id": 66,
      "start": 20864.1,
      "end": 20865.4,
      "formatted_start": "05:47:44.100",
      "formatted_end": "05:47:45.400",
      "text": "بقل دران"
    },
    {
      "id": 67,
      "start": 20866.0,
      "end": 20868.5,
      "formatted_start": "05:47:46.000",
      "formatted_end": "05:47:48.500",
      "text": "از دختر بگیریم یا پسر فرقی نداره"
    },
    {
      "id": 68,
      "start": 20868.8,
      "end": 20871.5,
      "formatted_start": "05:47:48.800",
      "formatted_end": "05:47:51.500",
      "text": "بلی من میگه ما این چیه که تا اینقدر صحبه میکنیم؟"
    },
    {
      "id": 69,
      "start": 20873.2,
      "end": 20876.1,
      "formatted_start": "05:47:53.200",
      "formatted_end": "05:47:56.100",
      "text": "اصلا نفسی دیشتر بلونیم یا باباش اینقدر ناردود ها"
    },
    {
      "id": 70,
      "start": 20876.2,
      "end": 20879.9,
      "formatted_start": "05:47:56.200",
      "formatted_end": "05:47:59.900",
      "text": "اگه ناچاردهش میابردید آزیشتر دو تا"
    },
    {
      "id": 71,
      "start": 20880.7,
      "end": 20882.4,
      "formatted_start": "05:48:00.700",
      "formatted_end": "05:48:02.400",
      "text": "دیفتین بسته اید"
    },
    {
      "id": 72,
      "start": 20883.1,
      "end": 20884.0,
      "formatted_start": "05:48:03.100",
      "formatted_end": "05:48:04.000",
      "text": "چیزی نیست"
    },
    {
      "id": 73,
      "start": 20884.2,
      "end": 20886.2,
      "formatted_start": "05:48:04.200",
      "formatted_end": "05:48:06.200",
      "text": "بعد میگو خیلی من دلسیزا دارم"
    },
    {
      "id": 74,
      "start": 20886.2,
      "end": 20888.2,
      "formatted_start": "05:48:06.200",
      "formatted_end": "05:48:08.200",
      "text": "از اینجا باید برداشتیم."
    },
    {
      "id": 75,
      "start": 20888.2,
      "end": 20890.2,
      "formatted_start": "05:48:08.200",
      "formatted_end": "05:48:10.200",
      "text": "اینجا باید برداشتیم."
    },
    {
      "id": 76,
      "start": 20890.2,
      "end": 20892.2,
      "formatted_start": "05:48:10.200",
      "formatted_end": "05:48:12.200",
      "text": "اینجا باید برداشتیم."
    },
    {
      "id": 77,
      "start": 20892.2,
      "end": 20894.2,
      "formatted_start": "05:48:12.200",
      "formatted_end": "05:48:14.200",
      "text": "از اینجا باید برداشتیم."
    },
    {
      "id": 78,
      "start": 20894.2,
      "end": 20896.2,
      "formatted_start": "05:48:14.200",
      "formatted_end": "05:48:16.200",
      "text": "از اینجا باید برداشتیم."
    },
    {
      "id": 79,
      "start": 20896.2,
      "end": 20898.2,
      "formatted_start": "05:48:16.200",
      "formatted_end": "05:48:18.200",
      "text": "از اینجا باید برداشتیم."
    },
    {
      "id": 80,
      "start": 20898.2,
      "end": 20900.2,
      "formatted_start": "05:48:18.200",
      "formatted_end": "05:48:20.200",
      "text": "از اینجا باید برداشتیم."
    },
    {
      "id": 81,
      "start": 20900.2,
      "end": 20902.2,
      "formatted_start": "05:48:20.200",
      "formatted_end": "05:48:22.200",
      "text": "از اینجا باید برداشتیم."
    },
    {
      "id": 82,
      "start": 20902.2,
      "end": 20904.2,
      "formatted_start": "05:48:22.200",
      "formatted_end": "05:48:24.200",
      "text": "از اینجا باید برداشتیم."
    },
    {
      "id": 83,
      "start": 20904.2,
      "end": 20906.2,
      "formatted_start": "05:48:24.200",
      "formatted_end": "05:48:26.200",
      "text": "از اینجا باید برداشتیم."
    },
    {
      "id": 84,
      "start": 20906.2,
      "end": 20908.2,
      "formatted_start": "05:48:26.200",
      "formatted_end": "05:48:28.200",
      "text": "از اینجا باید برداشتیم."
    },
    {
      "id": 85,
      "start": 20908.2,
      "end": 20910.74,
      "formatted_start": "05:48:28.200",
      "formatted_end": "05:48:30.740",
      "text": "خسته صحب سه؟ صحب"
    },
    {
      "id": 86,
      "start": 20910.94,
      "end": 20912.74,
      "formatted_start": "05:48:30.940",
      "formatted_end": "05:48:32.740",
      "text": "صحب بوده، علاوه بوده، علاوه بوده"
    },
    {
      "id": 87,
      "start": 20912.78,
      "end": 20915.4,
      "formatted_start": "05:48:32.780",
      "formatted_end": "05:48:35.400",
      "text": "نه بله بوده صحب، صلاح و شعراته"
    },
    {
      "id": 88,
      "start": 20915.44,
      "end": 20916.44,
      "formatted_start": "05:48:35.440",
      "formatted_end": "05:48:36.440",
      "text": "آه"
    },
    {
      "id": 89,
      "start": 20923.64,
      "end": 20926.04,
      "formatted_start": "05:48:43.640",
      "formatted_end": "05:48:46.040",
      "text": "امبولا تو تیز سلام برنسم یا از اولانه برنسم؟"
    },
    {
      "id": 90,
      "start": 20926.08,
      "end": 20928.08,
      "formatted_start": "05:48:46.080",
      "formatted_end": "05:48:48.080",
      "text": "نه، افتیش سلام برنسم"
    },
    {
      "id": 91,
      "start": 20928.22,
      "end": 20930.22,
      "formatted_start": "05:48:48.220",
      "formatted_end": "05:48:50.220",
      "text": "دست دارم از اینجا سلام بتاپ کنی"
    },
    {
      "id": 92,
      "start": 20930.32,
      "end": 20932.36,
      "formatted_start": "05:48:50.320",
      "formatted_end": "05:48:52.360",
      "text": "شما دست استعاون که"
    },
    {
      "id": 93,
      "start": 20932.56,
      "end": 20935.08,
      "formatted_start": "05:48:52.560",
      "formatted_end": "05:48:55.080",
      "text": "انشالله او شدید با خدا اومد یه نقصه"
    },
    {
      "id": 94,
      "start": 20935.22,
      "end": 20937.02,
      "formatted_start": "05:48:55.220",
      "formatted_end": "05:48:57.020",
      "text": "خدایش شاید خوب شد"
    },
    {
      "id": 95,
      "start": 20937.02,
      "end": 20939.02,
      "formatted_start": "05:48:57.020",
      "formatted_end": "05:48:59.020",
      "text": "باید مراحت خونه"
    },
    {
      "id": 96,
      "start": 20939.02,
      "end": 20942.02,
      "formatted_start": "05:48:59.020",
      "formatted_end": "05:49:02.020",
      "text": "بله باید مراحت هم کنه وقتی میگی تو سمت دودنری"
    },
    {
      "id": 97,
      "start": 20942.02,
      "end": 20943.02,
      "formatted_start": "05:49:02.020",
      "formatted_end": "05:49:03.020",
      "text": "اصلا کلن"
    },
    {
      "id": 98,
      "start": 20943.02,
      "end": 20946.02,
      "formatted_start": "05:49:03.020",
      "formatted_end": "05:49:06.020",
      "text": "برزش نره یه مدر بذار خوب بشی بعدم برزش نره"
    },
    {
      "id": 99,
      "start": 20946.02,
      "end": 20948.02,
      "formatted_start": "05:49:06.020",
      "formatted_end": "05:49:08.020",
      "text": "فردن که نمیشه برزش نره"
    },
    {
      "id": 100,
      "start": 20948.02,
      "end": 20949.02,
      "formatted_start": "05:49:08.020",
      "formatted_end": "05:49:09.020",
      "text": "نه نمیشه"
    },
    {
      "id": 101,
      "start": 20949.02,
      "end": 20951.02,
      "formatted_start": "05:49:09.020",
      "formatted_end": "05:49:11.020",
      "text": "سفرش هم نمی کشه"
    },
    {
      "id": 102,
      "start": 20952.02,
      "end": 20956.02,
      "formatted_start": "05:49:12.020",
      "formatted_end": "05:49:16.020",
      "text": "خب این قلب هایی گوشات میشه ریاض مویده میاد عرضیت میشه ریاض"
    },
    {
      "id": 103,
      "start": 20956.02,
      "end": 20959.02,
      "formatted_start": "05:49:16.020",
      "formatted_end": "05:49:19.020",
      "text": "میگی مثل مردای هفته ساله شدی"
    },
    {
      "id": 104,
      "start": 20959.02,
      "end": 20961.02,
      "formatted_start": "05:49:19.020",
      "formatted_end": "05:49:21.020",
      "text": "الان هر که بینه میگی چی میاسرف میخونه"
    },
    {
      "id": 105,
      "start": 20961.02,
      "end": 20963.02,
      "formatted_start": "05:49:21.020",
      "formatted_end": "05:49:23.020",
      "text": "تا تو ست که بگو من اینجا نمیگیشم"
    },
    {
      "id": 106,
      "start": 20963.02,
      "end": 20965.02,
      "formatted_start": "05:49:23.020",
      "formatted_end": "05:49:25.020",
      "text": "خوشباده چون بسیار شامل شده"
    },
    {
      "id": 107,
      "start": 20965.02,
      "end": 20967.02,
      "formatted_start": "05:49:25.020",
      "formatted_end": "05:49:27.020",
      "text": "اون قوی ها برقه ها"
    },
    {
      "id": 108,
      "start": 20967.02,
      "end": 20969.02,
      "formatted_start": "05:49:27.020",
      "formatted_end": "05:49:29.020",
      "text": "زر برقه ها ست ست"
    },
    {
      "id": 109,
      "start": 20969.02,
      "end": 20971.02,
      "formatted_start": "05:49:29.020",
      "formatted_end": "05:49:31.020",
      "text": "چنده چنده برقه ها"
    },
    {
      "id": 110,
      "start": 20971.02,
      "end": 20973.02,
      "formatted_start": "05:49:31.020",
      "formatted_end": "05:49:33.020",
      "text": "از این مصرف دیگر هم زیادیش خود نیست؟"
    },
    {
      "id": 111,
      "start": 20973.02,
      "end": 20975.02,
      "formatted_start": "05:49:33.020",
      "formatted_end": "05:49:35.020",
      "text": "نه"
    },
    {
      "id": 112,
      "start": 20975.02,
      "end": 20977.02,
      "formatted_start": "05:49:35.020",
      "formatted_end": "05:49:37.020",
      "text": "چقدر مصرف داره؟ یه ها مصرف داره"
    },
    {
      "id": 113,
      "start": 20977.02,
      "end": 20979.02,
      "formatted_start": "05:49:37.020",
      "formatted_end": "05:49:39.020",
      "text": "خود نیست من اقل بگویدم که با واقع"
    },
    {
      "id": 114,
      "start": 20979.02,
      "end": 20981.02,
      "formatted_start": "05:49:39.020",
      "formatted_end": "05:49:41.020",
      "text": "مصرف داره خود نیست"
    },
    {
      "id": 115,
      "start": 20981.02,
      "end": 20983.02,
      "formatted_start": "05:49:41.020",
      "formatted_end": "05:49:43.020",
      "text": "بله با واقعش ریاه شد"
    },
    {
      "id": 116,
      "start": 20983.02,
      "end": 20985.02,
      "formatted_start": "05:49:43.020",
      "formatted_end": "05:49:45.020",
      "text": "مریض جنگ شد در اینکه اون سگار میکشه"
    },
    {
      "id": 117,
      "start": 20985.02,
      "end": 20991.02,
      "formatted_start": "05:49:45.020",
      "formatted_end": "05:49:51.020",
      "text": "تو چیه؟ هر چی هم میگی نکشیم، با خودش رفت توشی از آن دیگه"
    },
    {
      "id": 118,
      "start": 20991.02,
      "end": 20994.02,
      "formatted_start": "05:49:51.020",
      "formatted_end": "05:49:54.020",
      "text": "حالشون نمیشه دیگه"
    },
    {
      "id": 119,
      "start": 20994.02,
      "end": 21000.02,
      "formatted_start": "05:49:54.020",
      "formatted_end": "05:50:00.020",
      "text": "آزمایشتو بهتر گرمت انجام بدی، خب چون یه آزمایش خاص دیگه هم..."
    }
  ],
  "status": "completed"
}