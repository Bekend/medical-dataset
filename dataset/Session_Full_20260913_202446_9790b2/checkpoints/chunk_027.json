      "end": 8399.63,
      "formatted_start": "02:19:58.921",
      "formatted_end": "02:19:59.630",
      "speaker": "SPEAKER_00"
    }
  ],
  "stt_segments": [
    {
      "id": 0,
      "start": 8100.0,
      "end": 8102.0,
      "formatted_start": "02:15:00.000",
      "formatted_end": "02:15:02.000",
      "text": "از اینجا باید بردارو برداریم."
    },
    {
      "id": 1,
      "start": 8102.0,
      "end": 8106.0,
      "formatted_start": "02:15:02.000",
      "formatted_end": "02:15:06.000",
      "text": "خوب، نه، بعد پولستات تو مفهومت داریم."
    },
    {
      "id": 2,
      "start": 8106.0,
      "end": 8109.0,
      "formatted_start": "02:15:06.000",
      "formatted_end": "02:15:09.000",
      "text": "به خاطر اونکه سخته تر هست."
    },
    {
      "id": 3,
      "start": 8109.0,
      "end": 8113.0,
      "formatted_start": "02:15:09.000",
      "formatted_end": "02:15:13.000",
      "text": "تا اون صوره گرفته پولستات شدیم."
    },
    {
      "id": 4,
      "start": 8113.0,
      "end": 8116.0,
      "formatted_start": "02:15:13.000",
      "formatted_end": "02:15:16.000",
      "text": "نه، نه، نه، صوره گرفته نه."
    },
    {
      "id": 5,
      "start": 8116.0,
      "end": 8119.0,
      "formatted_start": "02:15:16.000",
      "formatted_end": "02:15:19.000",
      "text": "بس خودم برداریم. سخته تر برداریم."
    },
    {
      "id": 6,
      "start": 8119.0,
      "end": 8124.0,
      "formatted_start": "02:15:19.000",
      "formatted_end": "02:15:24.000",
      "text": "تصمیم بچه داشته هستم، برداریم."
    },
    {
      "id": 7,
      "start": 8124.0,
      "end": 8126.0,
      "formatted_start": "02:15:24.000",
      "formatted_end": "02:15:26.000",
      "text": "بچه داشته نه، نه."
    },
    {
      "id": 8,
      "start": 8126.0,
      "end": 8130.0,
      "formatted_start": "02:15:26.000",
      "formatted_end": "02:15:30.000",
      "text": "نه بخاطر که پوست پولیستان یکی شده منصوب نوک برچه دارم"
    },
    {
      "id": 9,
      "start": 8130.0,
      "end": 8134.0,
      "formatted_start": "02:15:30.000",
      "formatted_end": "02:15:34.000",
      "text": "یعنی نوک موقعی پوست می کنیم اعدام باعداری کنیم"
    },
    {
      "id": 10,
      "start": 8136.0,
      "end": 8139.0,
      "formatted_start": "02:15:36.000",
      "formatted_end": "02:15:39.000",
      "text": "برنامه اگر دونه مثلا عوض کنیم"
    },
    {
      "id": 11,
      "start": 8139.0,
      "end": 8141.0,
      "formatted_start": "02:15:39.000",
      "formatted_end": "02:15:41.000",
      "text": "اینو سرسی نمیدونیم"
    },
    {
      "id": 12,
      "start": 8141.0,
      "end": 8143.0,
      "formatted_start": "02:15:41.000",
      "formatted_end": "02:15:43.000",
      "text": "هر وقت سرسی"
    },
    {
      "id": 13,
      "start": 8143.0,
      "end": 8145.0,
      "formatted_start": "02:15:43.000",
      "formatted_end": "02:15:45.000",
      "text": "ما هر وقت ازشیم"
    },
    {
      "id": 14,
      "start": 8146.0,
      "end": 8150.0,
      "formatted_start": "02:15:46.000",
      "formatted_end": "02:15:50.000",
      "text": "سرسی نمیدونیم مثلا سنو فس شد سنو آزمایش داده"
    },
    {
      "id": 15,
      "start": 8150.0,
      "end": 8153.0,
      "formatted_start": "02:15:50.000",
      "formatted_end": "02:15:53.000",
      "text": "دوباره همون موضوعش خودو بردم اینو بگم آزمایش هم بردم"
    },
    {
      "id": 16,
      "start": 8153.0,
      "end": 8155.0,
      "formatted_start": "02:15:53.000",
      "formatted_end": "02:15:55.000",
      "text": "اینجا باید بخشیم"
    },
    {
      "id": 17,
      "start": 8155.0,
      "end": 8157.0,
      "formatted_start": "02:15:55.000",
      "formatted_end": "02:15:57.000",
      "text": "اینجا باید بخشیم"
    },
    {
      "id": 18,
      "start": 8157.0,
      "end": 8159.0,
      "formatted_start": "02:15:57.000",
      "formatted_end": "02:15:59.000",
      "text": "اینجا باید بخشیم"
    },
    {
      "id": 19,
      "start": 8159.0,
      "end": 8161.0,
      "formatted_start": "02:15:59.000",
      "formatted_end": "02:16:01.000",
      "text": "اینجا باید بخشیم"
    },
    {
      "id": 20,
      "start": 8161.0,
      "end": 8163.0,
      "formatted_start": "02:16:01.000",
      "formatted_end": "02:16:03.000",
      "text": "اینجا باید بخشیم"
    },
    {
      "id": 21,
      "start": 8163.0,
      "end": 8165.0,
      "formatted_start": "02:16:03.000",
      "formatted_end": "02:16:05.000",
      "text": "اینجا باید بخشیم"
    },
    {
      "id": 22,
      "start": 8165.0,
      "end": 8167.0,
      "formatted_start": "02:16:05.000",
      "formatted_end": "02:16:07.000",
      "text": "اینجا باید بخشیم"
    },
    {
      "id": 23,
      "start": 8167.0,
      "end": 8169.0,
      "formatted_start": "02:16:07.000",
      "formatted_end": "02:16:09.000",
      "text": "اینجا باید بخشیم"
    },
    {
      "id": 24,
      "start": 8169.0,
      "end": 8171.0,
      "formatted_start": "02:16:09.000",
      "formatted_end": "02:16:11.000",
      "text": "اینجا باید بخشیم"
    },
    {
      "id": 25,
      "start": 8171.0,
      "end": 8173.0,
      "formatted_start": "02:16:11.000",
      "formatted_end": "02:16:13.000",
      "text": "اینجا باید بخشیم"
    },
    {
      "id": 26,
      "start": 8173.0,
      "end": 8175.0,
      "formatted_start": "02:16:13.000",
      "formatted_end": "02:16:15.000",
      "text": "اینجا باید بخشیم"
    },
    {
      "id": 27,
      "start": 8175.0,
      "end": 8177.0,
      "formatted_start": "02:16:15.000",
      "formatted_end": "02:16:17.000",
      "text": "اینجا باید بخشیم"
    },
    {
      "id": 28,
      "start": 8177.0,
      "end": 8179.0,
      "formatted_start": "02:16:17.000",
      "formatted_end": "02:16:19.000",
      "text": "اینجا باید بخشیم"
    },
    {
      "id": 29,
      "start": 8179.0,
      "end": 8181.0,
      "formatted_start": "02:16:19.000",
      "formatted_end": "02:16:21.000",
      "text": "اینجا باید بخشیم"
    },
    {
      "id": 30,
      "start": 8181.0,
      "end": 8183.0,
      "formatted_start": "02:16:21.000",
      "formatted_end": "02:16:23.000",
      "text": "همه مکملی هست"
    },
    {
      "id": 31,
      "start": 8183.0,
      "end": 8187.0,
      "formatted_start": "02:16:23.000",
      "formatted_end": "02:16:27.000",
      "text": "911-776-825-721"
    },
    {
      "id": 32,
      "start": 8187.0,
      "end": 8189.0,
      "formatted_start": "02:16:27.000",
      "formatted_end": "02:16:29.000",
      "text": "خب تماس میدیم قدمت فرم"
    },
    {
      "id": 33,
      "start": 8189.0,
      "end": 8191.0,
      "formatted_start": "02:16:29.000",
      "formatted_end": "02:16:31.000",
      "text": "آزمایشتون باشداری نداره"
    },
    {
      "id": 34,
      "start": 8191.0,
      "end": 8194.0,
      "formatted_start": "02:16:31.000",
      "formatted_end": "02:16:34.000",
      "text": "ازشم من صبح میرم بیایم"
    },
    {
      "id": 35,
      "start": 8194.0,
      "end": 8195.0,
      "formatted_start": "02:16:34.000",
      "formatted_end": "02:16:35.000",
      "text": "نشته باشم؟"
    },
    {
      "id": 36,
      "start": 8195.0,
      "end": 8196.0,
      "formatted_start": "02:16:35.000",
      "formatted_end": "02:16:36.000",
      "text": "نه نه"
    },
    {
      "id": 37,
      "start": 8196.0,
      "end": 8198.0,
      "formatted_start": "02:16:36.000",
      "formatted_end": "02:16:38.000",
      "text": "خب صبح هفت میرم بیایم"
    },
    {
      "id": 38,
      "start": 8198.0,
      "end": 8202.0,
      "formatted_start": "02:16:38.000",
      "formatted_end": "02:16:42.000",
      "text": "بعد بچه ها بهتون زنگیزر کدرکیل میدن"
    },
    {
      "id": 39,
      "start": 8202.0,
      "end": 8205.0,
      "formatted_start": "02:16:42.000",
      "formatted_end": "02:16:45.000",
      "text": "سومیگرافی تونم که تشکیل میبرید"
    },
    {
      "id": 40,
      "start": 8205.0,
      "end": 8206.0,
      "formatted_start": "02:16:45.000",
      "formatted_end": "02:16:46.000",
      "text": "سومیگرافی هم میده"
    },
    {
      "id": 41,
      "start": 8206.0,
      "end": 8207.0,
      "formatted_start": "02:16:46.000",
      "formatted_end": "02:16:47.000",
      "text": "خواست ندارم"
    },
    {
      "id": 42,
      "start": 8207.0,
      "end": 8209.0,
      "formatted_start": "02:16:47.000",
      "formatted_end": "02:16:49.000",
      "text": "چرا؟ بردون کدرکیل بدی؟"
    },
    {
      "id": 43,
      "start": 8209.0,
      "end": 8211.0,
      "formatted_start": "02:16:49.000",
      "formatted_end": "02:16:51.000",
      "text": "با تون استعمال آمده هست"
    },
    {
      "id": 44,
      "start": 8211.0,
      "end": 8213.0,
      "formatted_start": "02:16:51.000",
      "formatted_end": "02:16:53.000",
      "text": "همون دارون"
    },
    {
      "id": 45,
      "start": 8213.0,
      "end": 8215.0,
      "formatted_start": "02:16:53.000",
      "formatted_end": "02:16:55.000",
      "text": "تا بازماشو انجام میدهد؟"
    },
    {
      "id": 46,
      "start": 8215.0,
      "end": 8219.0,
      "formatted_start": "02:16:55.000",
      "formatted_end": "02:16:59.000",
      "text": "آزمایشتون رو با سونگراتی فردا صبح زد کنیم"
    },
    {
      "id": 47,
      "start": 8219.0,
      "end": 8221.0,
      "formatted_start": "02:16:59.000",
      "formatted_end": "02:17:01.000",
      "text": "چون اینو سیایی پامه"
    },
    {
      "id": 48,
      "start": 8221.0,
      "end": 8223.0,
      "formatted_start": "02:17:01.000",
      "formatted_end": "02:17:03.000",
      "text": "نسختون باطل میشه"
    },
    {
      "id": 49,
      "start": 8223.0,
      "end": 8227.0,
      "formatted_start": "02:17:03.000",
      "formatted_end": "02:17:07.000",
      "text": "فقط دارون تونم برای اینو سبب اگه دمگیرین تا از برقیرون"
    },
    {
      "id": 50,
      "start": 8227.0,
      "end": 8229.0,
      "formatted_start": "02:17:07.000",
      "formatted_end": "02:17:09.000",
      "text": "بتون زنگ میزنیم"
    },
    {
      "id": 51,
      "start": 8229.0,
      "end": 8231.0,
      "formatted_start": "02:17:09.000",
      "formatted_end": "02:17:11.000",
      "text": "سونگراتی همون موقع غنجانه؟"
    },
    {
      "id": 52,
      "start": 8231.0,
      "end": 8233.0,
      "formatted_start": "02:17:11.000",
      "formatted_end": "02:17:13.000",
      "text": "بله"
    },
    {
      "id": 53,
      "start": 8233.0,
      "end": 8235.0,
      "formatted_start": "02:17:13.000",
      "formatted_end": "02:17:15.000",
      "text": "بازماشو سونگراتی منجام میدهد؟"
    },
    {
      "id": 54,
      "start": 8235.0,
      "end": 8237.0,
      "formatted_start": "02:17:15.000",
      "formatted_end": "02:17:17.000",
      "text": "نه"
    },
    {
      "id": 55,
      "start": 8237.0,
      "end": 8239.0,
      "formatted_start": "02:17:17.000",
      "formatted_end": "02:17:19.000",
      "text": "اینجا سواره است؟"
    },
    {
      "id": 56,
      "start": 8239.0,
      "end": 8241.0,
      "formatted_start": "02:17:19.000",
      "formatted_end": "02:17:21.000",
      "text": "اینجا سواره است"
    },
    {
      "id": 57,
      "start": 8241.0,
      "end": 8243.0,
      "formatted_start": "02:17:21.000",
      "formatted_end": "02:17:23.000",
      "text": "اونجا از گنبره ایم"
    },
    {
      "id": 58,
      "start": 8243.0,
      "end": 8245.0,
      "formatted_start": "02:17:23.000",
      "formatted_end": "02:17:25.000",
      "text": "بسیار همه چیزی محسن دارم"
    },
    {
      "id": 59,
      "start": 8245.0,
      "end": 8247.0,
      "formatted_start": "02:17:25.000",
      "formatted_end": "02:17:27.000",
      "text": "باید همسواره نیم"
    },
    {
      "id": 60,
      "start": 8247.0,
      "end": 8249.0,
      "formatted_start": "02:17:27.000",
      "formatted_end": "02:17:29.000",
      "text": "باید بسواره هایت کنیم"
    },
    {
      "id": 61,
      "start": 8249.0,
      "end": 8251.0,
      "formatted_start": "02:17:29.000",
      "formatted_end": "02:17:31.000",
      "text": "بسواره هایت ما باید فیه هستیم"
    },
    {
      "id": 62,
      "start": 8281.0,
      "end": 8303.6,
      "formatted_start": "02:18:01.000",
      "formatted_end": "02:18:23.600",
      "text": "از اینجا با این نفس با این پاهاد برچه از پلا آمدید؟"
    },
    {
      "id": 63,
      "start": 8303.6,
      "end": 8305.6,
      "formatted_start": "02:18:23.600",
      "formatted_end": "02:18:25.600",
      "text": "کاری نبود بگیرم"
    },
    {
      "id": 64,
      "start": 8305.6,
      "end": 8309.6,
      "formatted_start": "02:18:25.600",
      "formatted_end": "02:18:29.600",
      "text": "من یک مدد داندارم یک مدد کشوردارم"
    },
    {
      "id": 65,
      "start": 8309.6,
      "end": 8315.6,
      "formatted_start": "02:18:29.600",
      "formatted_end": "02:18:35.600",
      "text": "از صبح برم می کنم پاونر رو برای خونم بیرون برده تر همینجا باید برزم"
    },
    {
      "id": 66,
      "start": 8315.6,
      "end": 8319.6,
      "formatted_start": "02:18:35.600",
      "formatted_end": "02:18:39.600",
      "text": "من رنده این ماشه خودم می کنم برای دیگه سنجکتر"
    },
    {
      "id": 67,
      "start": 8319.6,
      "end": 8324.6,
      "formatted_start": "02:18:39.600",
      "formatted_end": "02:18:44.600",
      "text": "خب آرسونه گرافیتون کسی صفرا که سنگ داره"
    },
    {
      "id": 68,
      "start": 8324.6,
      "end": 8325.6,
      "formatted_start": "02:18:44.600",
      "formatted_end": "02:18:45.600",
      "text": "بله دارم"
    },
    {
      "id": 69,
      "start": 8325.6,
      "end": 8331.6,
      "formatted_start": "02:18:45.600",
      "formatted_end": "02:18:51.600",
      "text": "آرسونه درده ای که پشتی گره اینا مالی کسی صفراه"
    },
    {
      "id": 70,
      "start": 8331.6,
      "end": 8335.1,
      "formatted_start": "02:18:51.600",
      "formatted_end": "02:18:55.100",
      "text": "اینجا میشه من خودم را بردارم و خودم را بردارم"
    },
    {
      "id": 71,
      "start": 8335.1,
      "end": 8338.1,
      "formatted_start": "02:18:55.100",
      "formatted_end": "02:18:58.100",
      "text": "من همینجا این پرستان را دردارم و میرخواهم"
    },
    {
      "id": 72,
      "start": 8338.1,
      "end": 8342.1,
      "formatted_start": "02:18:58.100",
      "formatted_end": "02:19:02.100",
      "text": "این تیغه، این تیغه، سمت راستانه"
    },
    {
      "id": 73,
      "start": 8342.1,
      "end": 8345.6,
      "formatted_start": "02:19:02.100",
      "formatted_end": "02:19:05.600",
      "text": "اما اینجا میزنم، چند چند سلام میزنم"
    },
    {
      "id": 74,
      "start": 8345.6,
      "end": 8348.1,
      "formatted_start": "02:19:05.600",
      "formatted_end": "02:19:08.100",
      "text": "من هر اینجا باید درست دارم و میشانم"
    },
    {
      "id": 75,
      "start": 8348.1,
      "end": 8352.1,
      "formatted_start": "02:19:08.100",
      "formatted_end": "02:19:12.100",
      "text": "من فکر میفرم از این شب اصلا نه تونستم با آقای شد"
    },
    {
      "id": 76,
      "start": 8352.1,
      "end": 8356.1,
      "formatted_start": "02:19:12.100",
      "formatted_end": "02:19:16.100",
      "text": "اصلا تا میخواهم، همین میخواهم درد چون میشه"
    },
    {
      "id": 77,
      "start": 8356.1,
      "end": 8359.1,
      "formatted_start": "02:19:16.100",
      "formatted_end": "02:19:19.100",
      "text": "که سفراتون را باید دارید امرش بگیم در اینجا"
    },
    {
      "id": 78,
      "start": 8359.1,
      "end": 8361.1,
      "formatted_start": "02:19:19.100",
      "formatted_end": "02:19:21.100",
      "text": "باید حتما سنگ داره"
    },
    {
      "id": 79,
      "start": 8363.1,
      "end": 8365.1,
      "formatted_start": "02:19:23.100",
