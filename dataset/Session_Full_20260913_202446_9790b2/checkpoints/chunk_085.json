  "stt_segments": [
    {
      "id": 0,
      "start": 25500.0,
      "end": 25505.46,
      "formatted_start": "07:05:00.000",
      "formatted_end": "07:05:05.460",
      "text": "پس از اینکه برای سرکیجی گفتم دارم، بهش چی داد؟ خورس به تارستی؟"
    },
    {
      "id": 1,
      "start": 25505.46,
      "end": 25508.96,
      "formatted_start": "07:05:05.460",
      "formatted_end": "07:05:08.960",
      "text": "نه، نمیخواد. اول با خورس بکنیم."
    },
    {
      "id": 2,
      "start": 25508.96,
      "end": 25510.76,
      "formatted_start": "07:05:08.960",
      "formatted_end": "07:05:10.760",
      "text": "چند تا خورنم دیگه باتشم کنم."
    },
    {
      "id": 3,
      "start": 25510.76,
      "end": 25517.76,
      "formatted_start": "07:05:10.760",
      "formatted_end": "07:05:17.760",
      "text": "آره، به صورت اینم بابی تایم میتونیم کنترل کنیم یعنی اگه نشد دیگه باید دادورو یک کمان را سکنیم."
    },
    {
      "id": 4,
      "start": 25517.76,
      "end": 25521.0,
      "formatted_start": "07:05:17.760",
      "formatted_end": "07:05:21.000",
      "text": "چون یه عمبه، بعد موقعی نه."
    },
    {
      "id": 5,
      "start": 25521.0,
      "end": 25521.76,
      "formatted_start": "07:05:21.000",
      "formatted_end": "07:05:21.760",
      "text": "چی باشی؟"
    },
    {
      "id": 6,
      "start": 25521.76,
      "end": 25525.76,
      "formatted_start": "07:05:21.760",
      "formatted_end": "07:05:25.760",
      "text": "بین سه ماهیم هم تمام باشه، آزمایش شه سه ماه بدن."
    },
    {
      "id": 7,
      "start": 25525.76,
      "end": 25530.76,
      "formatted_start": "07:05:25.760",
      "formatted_end": "07:05:30.760",
      "text": "ببینید که رنگ برای پایین ما 11 بود"
    },
    {
      "id": 8,
      "start": 25531.76,
      "end": 25533.76,
      "formatted_start": "07:05:31.760",
      "formatted_end": "07:05:33.760",
      "text": "رنگتون قطعا مورده"
    },
    {
      "id": 9,
      "start": 25533.76,
      "end": 25537.76,
      "formatted_start": "07:05:33.760",
      "formatted_end": "07:05:37.760",
      "text": "اوه ماده باید ببینیم شما چقدر علایم میده"
    },
    {
      "id": 10,
      "start": 25537.76,
      "end": 25539.76,
      "formatted_start": "07:05:37.760",
      "formatted_end": "07:05:39.760",
      "text": "اگه علایم همش بخوای بده نمیشه"
    },
    {
      "id": 11,
      "start": 25542.76,
      "end": 25545.76,
      "formatted_start": "07:05:42.760",
      "formatted_end": "07:05:45.760",
      "text": "ماده با من یزی رو به دوازن نوشتم"
    },
    {
      "id": 12,
      "start": 25545.76,
      "end": 25548.76,
      "formatted_start": "07:05:45.760",
      "formatted_end": "07:05:48.760",
      "text": "این دوتا بهتر میدونیم ببینیم چطور میشه"
    },
    {
      "id": 13,
      "start": 25549.76,
      "end": 25551.76,
      "formatted_start": "07:05:49.760",
      "formatted_end": "07:05:51.760",
      "text": "بسیار مردم"
    },
    {
      "id": 14,
      "start": 25555.76,
      "end": 25585.76,
      "formatted_start": "07:05:55.760",
      "formatted_end": "07:06:25.760",
      "text": "باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید بای"
    },
    {
      "id": 15,
      "start": 25585.76,
      "end": 25589.76,
      "formatted_start": "07:06:25.760",
      "formatted_end": "07:06:29.760",
      "text": "شستشون نمیدونید؟ چون میشونه خودش"
    },
    {
      "id": 16,
      "start": 25589.76,
      "end": 25591.76,
      "formatted_start": "07:06:29.760",
      "formatted_end": "07:06:31.760",
      "text": "شستشون"
    },
    {
      "id": 17,
      "start": 25591.76,
      "end": 25593.76,
      "formatted_start": "07:06:31.760",
      "formatted_end": "07:06:33.760",
      "text": "پایین نداری؟"
    },
    {
      "id": 18,
      "start": 25593.76,
      "end": 25595.76,
      "formatted_start": "07:06:33.760",
      "formatted_end": "07:06:35.760",
      "text": "نه"
    },
    {
      "id": 19,
      "start": 25595.76,
      "end": 25598.76,
      "formatted_start": "07:06:35.760",
      "formatted_end": "07:06:38.760",
      "text": "تنجه شو پایین نداری؟"
    },
    {
      "id": 20,
      "start": 25598.76,
      "end": 25600.76,
      "formatted_start": "07:06:38.760",
      "formatted_end": "07:06:40.760",
      "text": "پایین نداری"
    },
    {
      "id": 21,
      "start": 25600.76,
      "end": 25603.76,
      "formatted_start": "07:06:40.760",
      "formatted_end": "07:06:43.760",
      "text": "واریس داره تو باعتا؟"
    },
    {
      "id": 22,
      "start": 25603.76,
      "end": 25604.76,
      "formatted_start": "07:06:43.760",
      "formatted_end": "07:06:44.760",
      "text": "آره"
    },
    {
      "id": 23,
      "start": 25604.76,
      "end": 25605.76,
      "formatted_start": "07:06:44.760",
      "formatted_end": "07:06:45.760",
      "text": "واریس"
    },
    {
      "id": 24,
      "start": 25605.76,
      "end": 25608.76,
      "formatted_start": "07:06:45.760",
      "formatted_end": "07:06:48.760",
      "text": "خودتا چیز زخم داره، میگه غلطی واریس ها"
    },
    {
      "id": 25,
      "start": 25608.76,
      "end": 25611.76,
      "formatted_start": "07:06:48.760",
      "formatted_end": "07:06:51.760",
      "text": "واریس ها به قطعه که خون خوب نمیگه سه به پا"
    },
    {
      "id": 26,
      "start": 25611.76,
      "end": 25613.76,
      "formatted_start": "07:06:51.760",
      "formatted_end": "07:06:53.760",
      "text": "بازو زخم بشه"
    },
    {
      "id": 27,
      "start": 25613.76,
      "end": 25615.1,
      "formatted_start": "07:06:53.760",
      "formatted_end": "07:06:55.100",
      "text": "سگار نمی کشی؟"
    },
    {
      "id": 28,
      "start": 25615.1,
      "end": 25615.6,
      "formatted_start": "07:06:55.100",
      "formatted_end": "07:06:55.600",
      "text": "نه"
    },
    {
      "id": 29,
      "start": 25615.6,
      "end": 25616.38,
      "formatted_start": "07:06:55.600",
      "formatted_end": "07:06:56.380",
      "text": "اصلا دود؟"
    },
    {
      "id": 30,
      "start": 25616.38,
      "end": 25616.88,
      "formatted_start": "07:06:56.380",
      "formatted_end": "07:06:56.880",
      "text": "نه"
    },
    {
      "id": 31,
      "start": 25620.88,
      "end": 25623.64,
      "formatted_start": "07:07:00.880",
      "formatted_end": "07:07:03.640",
      "text": "این داربایی که هر بچه نشتا میخوره"
    },
    {
      "id": 32,
      "start": 25623.64,
      "end": 25625.64,
      "formatted_start": "07:07:03.640",
      "formatted_end": "07:07:05.640",
      "text": "مشکل هست همه با همدیگه میخوره"
    },
    {
      "id": 33,
      "start": 25625.64,
      "end": 25626.52,
      "formatted_start": "07:07:05.640",
      "formatted_end": "07:07:06.520",
      "text": "پرسر خرد؟"
    },
    {
      "id": 34,
      "start": 25626.52,
      "end": 25628.26,
      "formatted_start": "07:07:06.520",
      "formatted_end": "07:07:08.260",
      "text": "آره همه نشتا میخوره"
    },
    {
      "id": 35,
      "start": 25628.26,
      "end": 25629.68,
      "formatted_start": "07:07:08.260",
      "formatted_end": "07:07:09.680",
      "text": "مدهشون زخم میشه"
    },
    {
      "id": 36,
      "start": 25629.68,
      "end": 25631.68,
      "formatted_start": "07:07:09.680",
      "formatted_end": "07:07:11.680",
      "text": "صبح زود که بیدارون چشم مامان هم بشه"
    },
    {
      "id": 37,
      "start": 25631.68,
      "end": 25632.68,
      "formatted_start": "07:07:11.680",
      "formatted_end": "07:07:12.680",
      "text": "بگویش نداری؟"
    },
    {
      "id": 38,
      "start": 25632.68,
      "end": 25635.22,
      "formatted_start": "07:07:12.680",
      "formatted_end": "07:07:15.220",
      "text": "نه قربابا خونز مده میکنه"
    },
    {
      "id": 39,
      "start": 25635.22,
      "end": 25635.88,
      "formatted_start": "07:07:15.220",
      "formatted_end": "07:07:15.880",
      "text": "نه"
    },
    {
      "id": 40,
      "start": 25635.88,
      "end": 25636.96,
      "formatted_start": "07:07:15.880",
      "formatted_end": "07:07:16.960",
      "text": "این"
    },
    {
      "id": 41,
      "start": 25638.22,
      "end": 25640.96,
      "formatted_start": "07:07:18.220",
      "formatted_end": "07:07:20.960",
      "text": "شبتی که خوابشتون موخوره موخوره"
    },
    {
      "id": 42,
      "start": 25640.96,
      "end": 25641.68,
      "formatted_start": "07:07:20.960",
      "formatted_end": "07:07:21.680",
      "text": "اما"
    },
    {
      "id": 43,
      "start": 25642.68,
      "end": 25643.64,
      "formatted_start": "07:07:22.680",
      "formatted_end": "07:07:23.640",
      "text": "صبح زود"
    },
    {
      "id": 44,
      "start": 25643.76,
      "end": 25646.76,
      "formatted_start": "07:07:23.760",
      "formatted_end": "07:07:26.760",
      "text": "اینجا برای این وقت نمی کنیم."
    },
    {
      "id": 45,
      "start": 25646.76,
      "end": 25648.76,
      "formatted_start": "07:07:26.760",
      "formatted_end": "07:07:28.760",
      "text": "اینجا برای این وقت نمی کنیم."
    },
    {
      "id": 46,
      "start": 25648.76,
      "end": 25650.76,
      "formatted_start": "07:07:28.760",
      "formatted_end": "07:07:30.760",
      "text": "اینجا برای این وقت نمی کنیم."
    },
    {
      "id": 47,
      "start": 25650.76,
      "end": 25652.76,
      "formatted_start": "07:07:30.760",
      "formatted_end": "07:07:32.760",
      "text": "اینجا برای این وقت نمی کنیم."
    },
    {
      "id": 48,
      "start": 25652.76,
      "end": 25654.76,
      "formatted_start": "07:07:32.760",
      "formatted_end": "07:07:34.760",
      "text": "اینجا برای این وقت نمی کنیم."
    },
    {
      "id": 49,
      "start": 25654.76,
      "end": 25656.76,
      "formatted_start": "07:07:34.760",
      "formatted_end": "07:07:36.760",
      "text": "اینجا برای این وقت نمی کنیم."
    },
    {
      "id": 50,
      "start": 25656.76,
      "end": 25658.76,
      "formatted_start": "07:07:36.760",
      "formatted_end": "07:07:38.760",
      "text": "اینجا برای این وقت نمی کنیم."
    },
    {
      "id": 51,
      "start": 25658.76,
      "end": 25660.76,
      "formatted_start": "07:07:38.760",
      "formatted_end": "07:07:40.760",
      "text": "اینجا برای این وقت نمی کنیم."
    },
    {
      "id": 52,
      "start": 25660.76,
      "end": 25662.76,
      "formatted_start": "07:07:40.760",
      "formatted_end": "07:07:42.760",
      "text": "اینجا برای این وقت نمی کنیم."
    },
    {
      "id": 53,
      "start": 25662.76,
      "end": 25664.76,
      "formatted_start": "07:07:42.760",
      "formatted_end": "07:07:44.760",
      "text": "اینجا برای این وقت نمی کنیم."
    },
    {
      "id": 54,
      "start": 25664.76,
      "end": 25666.76,
      "formatted_start": "07:07:44.760",
      "formatted_end": "07:07:46.760",
      "text": "اینجوری از اینجوری برس پنتوکسیفیلین دادم"
    },
    {
      "id": 55,
      "start": 25666.76,
      "end": 25670.76,
      "formatted_start": "07:07:46.760",
      "formatted_end": "07:07:50.760",
      "text": "آره، پردم با خمک"
    },
    {
      "id": 56,
      "start": 25670.76,
      "end": 25672.76,
      "formatted_start": "07:07:50.760",
      "formatted_end": "07:07:52.760",
      "text": "آنو برد مادمون اون بخوره"
    },
    {
      "id": 57,
      "start": 25672.76,
      "end": 25676.76,
      "formatted_start": "07:07:52.760",
      "formatted_end": "07:07:56.760",
      "text": "اون چیزیست که یه روزه اثر کنه یا اثر نکنه"
    },
    {
      "id": 58,
      "start": 25676.76,
      "end": 25680.76,
      "formatted_start": "07:07:56.760",
      "formatted_end": "07:08:00.760",
      "text": "اون باعث میشه که دیگه بکتر نشه و یکم خون باز کرده شد"
    },
    {
      "id": 59,
      "start": 25680.76,
      "end": 25682.76,
      "formatted_start": "07:08:00.760",
      "formatted_end": "07:08:02.760",
      "text": "خودتونو بزنید"
    },
    {
      "id": 60,
      "start": 25686.76,
      "end": 25688.76,
      "formatted_start": "07:08:06.760",
      "formatted_end": "07:08:08.760",
      "text": "نه، اونو خیلی شده"
    },
    {
      "id": 61,
      "start": 25688.76,
      "end": 25690.76,
      "formatted_start": "07:08:08.760",
      "formatted_end": "07:08:10.760",
      "text": "بعد خوش و خوش آموشونو بردی کنه"
    },
    {
      "id": 62,
      "start": 25690.76,
      "end": 25692.76,
      "formatted_start": "07:08:10.760",
      "formatted_end": "07:08:12.760",
      "text": "بعد چیز کن"
    },
    {
      "id": 63,
      "start": 25692.76,
      "end": 25697.76,
      "formatted_start": "07:08:12.760",
      "formatted_end": "07:08:17.760",
      "text": "باید کامل شستشون بدی و سطح لای انگشتان رو بسرون شستشون"
    },
    {
      "id": 64,
      "start": 25701.76,
      "end": 25703.76,
      "formatted_start": "07:08:21.760",
      "formatted_end": "07:08:23.760",
      "text": "خودپرسه واریست"
    },
    {
      "id": 65,
      "start": 25704.76,
      "end": 25706.76,
      "formatted_start": "07:08:24.760",
      "formatted_end": "07:08:26.760",
      "text": "خوشگانشونم زیبا دارن؟"
    },
    {
      "id": 66,
      "start": 25706.76,
      "end": 25708.76,
      "formatted_start": "07:08:26.760",
      "formatted_end": "07:08:28.760",
      "text": "زیبا"
    },
    {
      "id": 67,
      "start": 25708.76,
      "end": 25711.76,
      "formatted_start": "07:08:28.760",
      "formatted_end": "07:08:31.760",
      "text": "پاماد دیگه چی ندارن تا بیاریم"
    },
    {
      "id": 68,
      "start": 25711.76,
      "end": 25715.76,
      "formatted_start": "07:08:31.760",
      "formatted_end": "07:08:35.760",
      "text": "اون پرسه واریست رو سر تا منسان تو آخر عمرشون بکنن"
    },
    {
      "id": 69,
      "start": 25716.76,
      "end": 25718.76,
      "formatted_start": "07:08:36.760",
      "formatted_end": "07:08:38.760",
      "text": "سیاد پایاتون چیز نباشه"
    },
    {
      "id": 70,
      "start": 25718.76,
      "end": 25720.76,
      "formatted_start": "07:08:38.760",
      "formatted_end": "07:08:40.760",
      "text": "پایاتون؟"
    },
    {
      "id": 71,
      "start": 25720.76,
      "end": 25722.76,
      "formatted_start": "07:08:40.760",
      "formatted_end": "07:08:42.760",
      "text": "راز یادی را"
    },
    {
      "id": 72,
      "start": 25722.76,
      "end": 25724.76,
      "formatted_start": "07:08:42.760",
      "formatted_end": "07:08:44.760",
      "text": "آهان، خب همین هر چی مشتر آورده"
    },
    {
      "id": 73,
      "start": 25724.76,
      "end": 25726.76,
      "formatted_start": "07:08:44.760",
      "formatted_end": "07:08:46.760",
      "text": "مشتر زرخ میشه"
    },
    {
      "id": 74,
      "start": 25726.76,
      "end": 25728.76,
      "formatted_start": "07:08:46.760",
      "formatted_end": "07:08:48.760",
      "text": "راز یادی را"
    },
    {
      "id": 75,
      "start": 25736.76,
      "end": 25738.76,
      "formatted_start": "07:08:56.760",
      "formatted_end": "07:08:58.760",
      "text": "چهارش یا خود؟"
    },
    {
      "id": 76,
      "start": 25738.76,
      "end": 25740.76,
      "formatted_start": "07:08:58.760",
      "formatted_end": "07:09:00.760",
