      "start": 25754.76,
      "end": 25756.76,
      "formatted_start": "07:09:14.760",
      "formatted_end": "07:09:16.760",
      "text": "دو دو یه تا مرم نمیشه"
    },
    {
      "id": 83,
      "start": 25756.76,
      "end": 25758.76,
      "formatted_start": "07:09:16.760",
      "formatted_end": "07:09:18.760",
      "text": "چون میترسم زدتر بشه"
    },
    {
      "id": 84,
      "start": 25758.76,
      "end": 25760.76,
      "formatted_start": "07:09:18.760",
      "formatted_end": "07:09:20.760",
      "text": "باید باشم"
    },
    {
      "id": 85,
      "start": 25760.76,
      "end": 25762.76,
      "formatted_start": "07:09:20.760",
      "formatted_end": "07:09:22.760",
      "text": "حاجه"
    },
    {
      "id": 86,
      "start": 25762.76,
      "end": 25764.76,
      "formatted_start": "07:09:22.760",
      "formatted_end": "07:09:24.760",
      "text": "پاهاتو هر شب باید بشویی"
    },
    {
      "id": 87,
      "start": 25764.76,
      "end": 25766.76,
      "formatted_start": "07:09:24.760",
      "formatted_end": "07:09:26.760",
      "text": "باید بذاری بالای بالش"
    },
    {
      "id": 88,
      "start": 25766.76,
      "end": 25768.76,
      "formatted_start": "07:09:26.760",
      "formatted_end": "07:09:28.760",
      "text": "تو خونه بکاری"
    },
    {
