      "formatted_start": "07:09:00.760",
      "formatted_end": "07:09:02.760",
      "text": "اصلا، از اونو چشم بگیری"
    },
    {
      "id": 78,
      "start": 25742.76,
      "end": 25744.76,
      "formatted_start": "07:09:02.760",
      "formatted_end": "07:09:04.760",
