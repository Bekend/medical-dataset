  "stt_segments": [
    {
      "id": 0,
      "start": 21600.0,
      "end": 21604.0,
      "formatted_start": "06:00:00.000",
      "formatted_end": "06:00:04.000",
      "text": "دوباره از 50 نصف می کنم، هر روز نصف شوید."
    },
    {
      "id": 1,
      "start": 21604.0,
      "end": 21607.0,
      "formatted_start": "06:00:04.000",
      "formatted_end": "06:00:07.000",
      "text": "هر روز باید کاملی بفرم، خود 50 تونه. باشه."
    },
    {
      "id": 2,
      "start": 21607.0,
      "end": 21609.0,
      "formatted_start": "06:00:07.000",
      "formatted_end": "06:00:09.000",
      "text": "یعنی باید کاملی بفرم؟"
    },
    {
      "id": 3,
      "start": 21609.0,
      "end": 21612.0,
      "formatted_start": "06:00:09.000",
      "formatted_end": "06:00:12.000",
      "text": "آره، 50 بجوز، هر روز بجوز جمعه هست."
    },
    {
      "id": 4,
      "start": 21615.0,
      "end": 21617.0,
      "formatted_start": "06:00:15.000",
      "formatted_end": "06:00:17.000",
      "text": "این مدت استرس داشت."
    },
    {
      "id": 5,
      "start": 21621.0,
      "end": 21624.0,
      "formatted_start": "06:00:21.000",
      "formatted_end": "06:00:24.000",
      "text": "چون کلمب ها بود، درکتر چون نه بازید."
    },
    {
      "id": 6,
      "start": 21624.0,
      "end": 21627.0,
      "formatted_start": "06:00:24.000",
      "formatted_end": "06:00:27.000",
      "text": "اینم برای قلبه، آباد هم باید برداریم."
    },
    {
      "id": 7,
      "start": 21627.0,
      "end": 21657.0,
      "formatted_start": "06:00:27.000",
      "formatted_end": "06:00:57.000",
      "text": "نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، ن"
    },
    {
      "id": 8,
      "start": 21657.0,
      "end": 21660.0,
      "formatted_start": "06:00:57.000",
      "formatted_end": "06:01:00.000",
      "text": "کشتون هیچ وقت خواهش نمی بیرون"
    },
    {
      "id": 9,
      "start": 21660.0,
      "end": 21662.0,
      "formatted_start": "06:01:00.000",
      "formatted_end": "06:01:02.000",
      "text": "نه"
    },
    {
      "id": 10,
      "start": 21662.0,
      "end": 21664.0,
      "formatted_start": "06:01:02.000",
      "formatted_end": "06:01:04.000",
      "text": "و فقطی صفت نیست"
    },
    {
      "id": 11,
      "start": 21664.0,
      "end": 21666.0,
      "formatted_start": "06:01:04.000",
      "formatted_end": "06:01:06.000",
      "text": "اگر مثلاً"
    },
    {
      "id": 12,
      "start": 21666.0,
      "end": 21669.0,
      "formatted_start": "06:01:06.000",
      "formatted_end": "06:01:09.000",
      "text": "نه، اینجوری بخواست کشت عذیب بکنه نیست"
    },
    {
      "id": 13,
      "start": 21669.0,
      "end": 21673.0,
      "formatted_start": "06:01:09.000",
      "formatted_end": "06:01:13.000",
      "text": "اگر یک بار دیگه چک کرده مصبت بود باید کولنسکوپی بشه"
    },
    {
      "id": 14,
      "start": 21673.0,
      "end": 21676.0,
      "formatted_start": "06:01:13.000",
      "formatted_end": "06:01:16.000",
      "text": "یعنی سمانه دیگه باید دوباره چک کنم یا الان چک کنم؟"
    },
    {
      "id": 15,
      "start": 21676.0,
      "end": 21679.0,
      "formatted_start": "06:01:16.000",
      "formatted_end": "06:01:19.000",
      "text": "نه سمانه دیگه چون علامتی نداری"
    },
    {
      "id": 16,
      "start": 21679.0,
      "end": 21680.0,
      "formatted_start": "06:01:19.000",
      "formatted_end": "06:01:20.000",
      "text": "درسته"
    },
    {
      "id": 17,
      "start": 21680.0,
      "end": 21682.0,
      "formatted_start": "06:01:20.000",
      "formatted_end": "06:01:22.000",
      "text": "یک بار دیگه چک کنیم، اگر مصبت شد"
    },
    {
      "id": 18,
      "start": 21682.0,
      "end": 21690.0,
      "formatted_start": "06:01:22.000",
      "formatted_end": "06:01:30.000",
      "text": "اون وقت باید اجابه دیدیم پایین زخم چیه؟ این تیکهش مهم"
    },
    {
      "id": 19,
      "start": 21690.0,
      "end": 21694.0,
      "formatted_start": "06:01:30.000",
      "formatted_end": "06:01:34.000",
      "text": "بقیه همیتامین ها رو نصب کنید، شیوی شکولات هم زیاد نخواهید"
    },
    {
      "id": 20,
      "start": 21694.0,
      "end": 21698.0,
      "formatted_start": "06:01:34.000",
      "formatted_end": "06:01:38.000",
      "text": "بعد این کم بوده فضلن چیه؟ علتش که رفته رفته وضع من داره کاهش بیان کنند"
    },
    {
      "id": 21,
      "start": 21698.0,
      "end": 21700.0,
      "formatted_start": "06:01:38.000",
      "formatted_end": "06:01:40.000",
      "text": "چند وقت؟"
    },
    {
      "id": 22,
      "start": 21700.0,
      "end": 21706.0,
      "formatted_start": "06:01:40.000",
      "formatted_end": "06:01:46.000",
      "text": "مثلا تقرار در حدود یک سال دو سالی که خیلی بخصوص توی یک ساله خیلی کاهشه وضع می داشتم"
    },
    {
      "id": 23,
      "start": 21706.0,
      "end": 21707.0,
      "formatted_start": "06:01:46.000",
      "formatted_end": "06:01:47.000",
      "text": "چند وقت؟"
    },
    {
      "id": 24,
      "start": 21707.0,
      "end": 21711.0,
      "formatted_start": "06:01:47.000",
      "formatted_end": "06:01:51.000",
      "text": "این نقطه او رو هفته و پنج بوده، الان توامن بوده شست و یکی ناشدن"
    },
    {
      "id": 25,
      "start": 21711.0,
      "end": 21715.0,
      "formatted_start": "06:01:51.000",
      "formatted_end": "06:01:55.000",
      "text": "خیلی زیاده، پس باید فارنوسکوپی بکنیم"
    },
    {
      "id": 26,
      "start": 21715.0,
      "end": 21719.0,
      "formatted_start": "06:01:55.000",
      "formatted_end": "06:01:59.000",
      "text": "اینه کاهش وزن هم زیاده"
    },
    {
      "id": 27,
      "start": 21719.0,
      "end": 21723.0,
      "formatted_start": "06:01:59.000",
      "formatted_end": "06:02:03.000",
      "text": "بعد این نقطه هم ببخشید و برای مطمئن"
    },
    {
      "id": 28,
      "start": 21723.0,
      "end": 21727.0,
      "formatted_start": "06:02:03.000",
      "formatted_end": "06:02:07.000",
      "text": "اصلا خیلی فشار آوردم به خودم که یه موقع شکرم هم"
    },
    {
      "id": 29,
      "start": 21727.0,
      "end": 21731.0,
      "formatted_start": "06:02:07.000",
      "formatted_end": "06:02:11.000",
      "text": "مثلا کار کنه که من بدم به آزمایشگاه اینام"
    },
    {
      "id": 30,
      "start": 21731.0,
      "end": 21735.0,
      "formatted_start": "06:02:11.000",
      "formatted_end": "06:02:15.000",
      "text": "شاید این عملتش بوده چون که شخص نمی بوده"
    },
    {
      "id": 31,
      "start": 21735.0,
      "end": 21737.0,
      "formatted_start": "06:02:15.000",
      "formatted_end": "06:02:17.000",
      "text": "بر هم بزنم یه روز نکردیم"
    },
    {
      "id": 32,
      "start": 21737.0,
      "end": 21739.0,
      "formatted_start": "06:02:17.000",
      "formatted_end": "06:02:19.000",
      "text": "یه روز نکردیم"
    },
    {
      "id": 33,
      "start": 21739.0,
      "end": 21745.0,
      "formatted_start": "06:02:19.000",
      "formatted_end": "06:02:25.000",
      "text": "اگر موسمت شد، باید بشید. باشید."
    },
    {
      "id": 34,
      "start": 21745.0,
      "end": 21752.0,
      "formatted_start": "06:02:25.000",
      "formatted_end": "06:02:32.000",
      "text": "اینجا ماه دیگه دیگه. اونجا آخر برجه. بلندیستم طریقش میگذارم."
    },
    {
      "id": 35,
      "start": 21752.0,
      "end": 21754.0,
      "formatted_start": "06:02:32.000",
      "formatted_end": "06:02:34.000",
      "text": "هر سه ماه یک بار میاد چک میگن؟"
    },
    {
      "id": 36,
      "start": 21754.0,
      "end": 21757.0,
      "formatted_start": "06:02:34.000",
      "formatted_end": "06:02:37.000",
      "text": "آره هم. اینه نه. چون وزدتون خیلی کم شده."
    },
    {
      "id": 37,
      "start": 21757.0,
      "end": 21760.0,
      "formatted_start": "06:02:37.000",
      "formatted_end": "06:02:40.000",
      "text": "میخوام برچه میگم، فردا سخت کنه."
    },
    {
      "id": 38,
      "start": 21760.0,
      "end": 21768.0,
      "formatted_start": "06:02:40.000",
      "formatted_end": "06:02:48.000",
      "text": "اینو سخت کنه و یه ده روز دیگه انجام کنی. که این شام نمیخواد به ما سخت کنه."
    },
    {
      "id": 39,
      "start": 21768.0,
      "end": 21798.0,
      "formatted_start": "06:02:48.000",
      "formatted_end": "06:03:18.000",
      "text": "خودتون را برای اینجا برای اینجا برای اینجا برای اینجا برای اینجا برای اینجا برای اینجا برای اینجا برای اینجا برای اینجا برای اینجا برای اینجا برای اینجا برای اینجا برای اینجا برای اینجا برای اینجا برای اینجا برای اینجا برای اینجا برای اینجا برای اینجا برای اینجا برای اینجا برای اینجا برای اینجا برای اینجا برای اینجا برای اینجا برای اینجا برای اینجا"
    },
    {
      "id": 40,
      "start": 21798.0,
      "end": 21828.0,
      "formatted_start": "06:03:18.000",
      "formatted_end": "06:03:48.000",
      "text": "بخش ۳۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰�"
    },
    {
      "id": 41,
      "start": 21828.0,
      "end": 21833.0,
      "formatted_start": "06:03:48.000",
      "formatted_end": "06:03:53.000",
      "text": "خب نه دیگه هر جایی که شما تشکر دادیم، من اینجا رو خواهم شما باید سال کنم"
    },
    {
      "id": 42,
      "start": 21833.0,
      "end": 21835.0,
      "formatted_start": "06:03:53.000",
      "formatted_end": "06:03:55.000",
      "text": "ما خانمون همیشه همینجا هم"
    },
    {
      "id": 43,
      "start": 21835.0,
      "end": 21837.0,
      "formatted_start": "06:03:55.000",
      "formatted_end": "06:03:57.000",
      "text": "لازم باشیم دستگاهش بشیم"
    },
    {
      "id": 44,
      "start": 21837.0,
      "end": 21839.0,
      "formatted_start": "06:03:57.000",
      "formatted_end": "06:03:59.000",
      "text": "خب میخواییم یه بار عوض کنم"
    },
    {
      "id": 45,
      "start": 21839.0,
      "end": 21842.0,
      "formatted_start": "06:03:59.000",
      "formatted_end": "06:04:02.000",
      "text": "هر جایی که شما باید کنم"
    },
    {
      "id": 46,
      "start": 21850.0,
      "end": 21852.0,
      "formatted_start": "06:04:10.000",
      "formatted_end": "06:04:12.000",
      "text": "شفا بریم"
    },
    {
      "id": 47,
      "start": 21852.0,
      "end": 21854.0,
      "formatted_start": "06:04:12.000",
      "formatted_end": "06:04:14.000",
      "text": "نه، نمیشه آواز کنم"
    },
    {
      "id": 48,
      "start": 21854.0,
      "end": 21857.0,
      "formatted_start": "06:04:14.000",
      "formatted_end": "06:04:17.000",
      "text": "یه بار عوض کنم، آواز کنم"
    },
    {
      "id": 49,
      "start": 21857.0,
      "end": 21859.0,
      "formatted_start": "06:04:17.000",
      "formatted_end": "06:04:19.000",
      "text": "آرمان آورده میگی یا..."
    },
    {
      "id": 50,
      "start": 21859.0,
      "end": 21861.0,
      "formatted_start": "06:04:19.000",
      "formatted_end": "06:04:21.000",
      "text": "یه جاواز کنش از..."
    },
    {
      "id": 51,
      "start": 21861.0,
      "end": 21863.0,
      "formatted_start": "06:04:21.000",
      "formatted_end": "06:04:23.000",
      "text": "خب"
    },
    {
      "id": 52,
      "start": 21863.0,
      "end": 21865.0,
      "formatted_start": "06:04:23.000",
      "formatted_end": "06:04:25.000",
      "text": "اینه که فردا باید بگیم"
    },
    {
      "id": 53,
      "start": 21865.0,
      "end": 21867.0,
      "formatted_start": "06:04:25.000",
      "formatted_end": "06:04:27.000",
      "text": "فقط الان باید براتون تخبیرتو"
    },
    {
      "id": 54,
      "start": 21867.0,
      "end": 21869.0,
      "formatted_start": "06:04:27.000",
      "formatted_end": "06:04:29.000",
      "text": "برمیسن همه چی"
    },
    {
      "id": 55,
      "start": 21869.0,
      "end": 21871.0,
      "formatted_start": "06:04:29.000",
      "formatted_end": "06:04:31.000",
      "text": "شکر خودم در چهارشو ده روز دیگه برم بگیرم"
    },
    {
      "id": 56,
      "start": 21871.0,
      "end": 21873.0,
      "formatted_start": "06:04:31.000",
      "formatted_end": "06:04:33.000",
      "text": "آره آره"
    },
    {
      "id": 57,
      "start": 21873.0,
      "end": 21875.0,
      "formatted_start": "06:04:33.000",
      "formatted_end": "06:04:35.000",
      "text": "خب بگم خوامشه کلچین فردا باید بگم سرده برم"
    },
    {
      "id": 58,
      "start": 21875.0,
      "end": 21877.0,
      "formatted_start": "06:04:35.000",
      "formatted_end": "06:04:37.000",
      "text": "باید به من بگیم که"
    },
    {
      "id": 59,
      "start": 21877.0,
      "end": 21881.0,
      "formatted_start": "06:04:37.000",
      "formatted_end": "06:04:41.000",
      "text": "خوام و جلو تخبیرتی چیزی داره یا نه"
    },
    {
      "id": 60,
      "start": 21881.0,
      "end": 21883.0,
      "formatted_start": "06:04:41.000",
      "formatted_end": "06:04:43.000",
      "text": "نه افنا دونی کلن ندارم"
    },
    {
      "id": 61,
      "start": 21883.0,
      "end": 21893.0,
      "formatted_start": "06:04:43.000",
      "formatted_end": "06:04:53.000",
      "text": "این ها درگاه هستند. این ها می‌کنند از اینجا باید باید استفاده کنند."
    },
    {
      "id": 62,
      "start": 21893.0,
      "end": 21897.0,
      "formatted_start": "06:04:53.000",
      "formatted_end": "06:04:57.000",
      "text": "چون نداشتم از این نصف می‌کردیم."
    },
    {
      "id": 63,
      "start": 21897.0,
      "end": 21900.0,
      "formatted_start": "06:04:57.000",
      "formatted_end": "06:05:00.000",
      "text": "این ها همیشه باز شده بود. این ها خیلی روزویز می‌کنند."
    }
  ],
  "status": "completed"
}