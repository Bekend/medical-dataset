  "stt_segments": [
    {
      "id": 0,
      "start": 21900.0,
      "end": 21902.0,
      "formatted_start": "06:05:00.000",
      "formatted_end": "06:05:02.000",
      "text": "از این حال مرگو دیگه آسیبی هست."
    },
    {
      "id": 1,
      "start": 21902.0,
      "end": 21904.0,
      "formatted_start": "06:05:02.000",
      "formatted_end": "06:05:04.000",
      "text": "من همون پنجه شده نیستم."
    },
    {
      "id": 2,
      "start": 21904.0,
      "end": 21906.0,
      "formatted_start": "06:05:04.000",
      "formatted_end": "06:05:06.000",
      "text": "از این حال پنجه شده نیستم."
    },
    {
      "id": 3,
      "start": 21906.0,
      "end": 21908.0,
      "formatted_start": "06:05:06.000",
      "formatted_end": "06:05:08.000",
      "text": "از این حال پنجه شده نیستم."
    },
    {
      "id": 4,
      "start": 21908.0,
      "end": 21910.0,
      "formatted_start": "06:05:08.000",
      "formatted_end": "06:05:10.000",
      "text": "از این حال پنجه شده نیستم."
    },
    {
      "id": 5,
      "start": 21910.0,
      "end": 21912.0,
      "formatted_start": "06:05:10.000",
      "formatted_end": "06:05:12.000",
      "text": "از این حال پنجه شده نیستم."
    },
    {
      "id": 6,
      "start": 21912.0,
      "end": 21914.0,
      "formatted_start": "06:05:12.000",
      "formatted_end": "06:05:14.000",
      "text": "از این حال پنجه شده نیستم."
    },
    {
      "id": 7,
      "start": 21914.0,
      "end": 21916.0,
      "formatted_start": "06:05:14.000",
      "formatted_end": "06:05:16.000",
      "text": "از این حال پنجه شده نیستم."
    },
    {
      "id": 8,
      "start": 21916.0,
      "end": 21918.0,
      "formatted_start": "06:05:16.000",
      "formatted_end": "06:05:18.000",
      "text": "از این حال پنجه شده نیستم."
    },
    {
      "id": 9,
      "start": 21918.0,
      "end": 21920.0,
      "formatted_start": "06:05:18.000",
      "formatted_end": "06:05:20.000",
      "text": "از این حال پنجه شده نیستم."
    },
    {
      "id": 10,
      "start": 21920.0,
      "end": 21922.0,
      "formatted_start": "06:05:20.000",
      "formatted_end": "06:05:22.000",
      "text": "از این حال پنجه شده نیستم."
    },
    {
      "id": 11,
      "start": 21922.0,
      "end": 21924.0,
      "formatted_start": "06:05:22.000",
      "formatted_end": "06:05:24.000",
      "text": "اینجورم خیلی صرف می کنیم"
    },
    {
      "id": 12,
      "start": 21933.0,
      "end": 21937.0,
      "formatted_start": "06:05:33.000",
      "formatted_end": "06:05:37.000",
      "text": "اگر نمی ترسید، یک بار شما باید نمونه مغز و استخوان بدید"
    },
    {
      "id": 13,
      "start": 21938.0,
      "end": 21941.0,
      "formatted_start": "06:05:38.000",
      "formatted_end": "06:05:41.000",
      "text": "از نظر علمی شما باید یک بار نمونه مغز و استخوان بدید"
    },
    {
      "id": 14,
      "start": 21946.0,
      "end": 21951.0,
      "formatted_start": "06:05:46.000",
      "formatted_end": "06:05:51.000",
      "text": "دیده مردش خیلی زیاده، اصلا خیلی زبط داره که اینجام بده"
    },
    {
      "id": 15,
      "start": 21951.0,
      "end": 21954.5,
      "formatted_start": "06:05:51.000",
      "formatted_end": "06:05:54.500",
      "text": "من خودم خیلی انجام بردم به این رد داره"
    },
    {
      "id": 16,
      "start": 21954.5,
      "end": 21958.0,
      "formatted_start": "06:05:54.500",
      "formatted_end": "06:05:58.000",
      "text": "اما من الان راستش بردم دیگه انجام نمیدونم چون دلشم دیگه عرما دیده"
    },
    {
      "id": 17,
      "start": 21958.0,
      "end": 21959.0,
      "formatted_start": "06:05:58.000",
      "formatted_end": "06:05:59.000",
      "text": "راسته نرم بردم"
    },
    {
      "id": 18,
      "start": 21959.0,
      "end": 21962.0,
      "formatted_start": "06:05:59.000",
      "formatted_end": "06:06:02.000",
      "text": "شما دوز پولخانی به این انجام بدید"
    },
    {
      "id": 19,
      "start": 21962.0,
      "end": 21968.0,
      "formatted_start": "06:06:02.000",
      "formatted_end": "06:06:08.000",
      "text": "دوز مزفر اینقدر تمیز انجام میدن که شما اصلا حس برید که باید انجام بدید"
    },
    {
      "id": 20,
      "start": 21968.0,
      "end": 21970.0,
      "formatted_start": "06:06:08.000",
      "formatted_end": "06:06:10.000",
      "text": "درد نداره"
    },
    {
      "id": 21,
      "start": 21970.0,
      "end": 21974.0,
      "formatted_start": "06:06:10.000",
      "formatted_end": "06:06:14.000",
      "text": "اون کس که انجام بده بیشتر از شما زنش میکشه"
    },
    {
      "id": 22,
      "start": 21974.0,
      "end": 21976.0,
      "formatted_start": "06:06:14.000",
      "formatted_end": "06:06:16.000",
      "text": "حتی روز شب همی خواهی؟"
    },
    {
      "id": 23,
      "start": 21976.0,
      "end": 21978.0,
      "formatted_start": "06:06:16.000",
      "formatted_end": "06:06:18.000",
      "text": "مزفر اینه؟"
    },
    {
      "id": 24,
      "start": 21978.0,
      "end": 21980.0,
      "formatted_start": "06:06:18.000",
      "formatted_end": "06:06:20.000",
      "text": "روزی یک دنه"
    },
    {
      "id": 25,
      "start": 21981.0,
      "end": 21983.0,
      "formatted_start": "06:06:21.000",
      "formatted_end": "06:06:23.000",
      "text": "این داقره جایی هست"
    },
    {
      "id": 26,
      "start": 21983.0,
      "end": 21985.0,
      "formatted_start": "06:06:23.000",
      "formatted_end": "06:06:25.000",
      "text": "چند دقیقه اینو می کنی؟"
    },
    {
      "id": 27,
      "start": 21985.0,
      "end": 21987.0,
      "formatted_start": "06:06:25.000",
      "formatted_end": "06:06:27.000",
      "text": "چند ساله؟"
    },
    {
      "id": 28,
      "start": 21987.0,
      "end": 21989.0,
      "formatted_start": "06:06:27.000",
      "formatted_end": "06:06:29.000",
      "text": "چه ساله درم می کنیم"
    },
    {
      "id": 29,
      "start": 21989.0,
      "end": 21991.0,
      "formatted_start": "06:06:29.000",
      "formatted_end": "06:06:31.000",
      "text": "ولی تازه که داقر شده"
    },
    {
      "id": 30,
      "start": 21991.0,
      "end": 21993.0,
      "formatted_start": "06:06:31.000",
      "formatted_end": "06:06:33.000",
      "text": "اصلا اثرشو آرام آرام بذاشته نیست"
    },
    {
      "id": 31,
      "start": 21993.0,
      "end": 21995.0,
      "formatted_start": "06:06:33.000",
      "formatted_end": "06:06:35.000",
      "text": "ولی خود این مدت"
    },
    {
      "id": 32,
      "start": 21995.0,
      "end": 21997.0,
      "formatted_start": "06:06:35.000",
      "formatted_end": "06:06:37.000",
      "text": "چیز دیگه خیلی به چشم می آد"
    },
    {
      "id": 33,
      "start": 21997.0,
      "end": 21999.0,
      "formatted_start": "06:06:37.000",
      "formatted_end": "06:06:39.000",
      "text": "اصلا اونهایی که من دیدن که چاق بودم"
    },
    {
      "id": 34,
      "start": 21999.0,
      "end": 22001.0,
      "formatted_start": "06:06:39.000",
      "formatted_end": "06:06:41.000",
      "text": "الان همش مثلا این چند داقر شدی؟"
    },
    {
      "id": 35,
      "start": 22001.0,
      "end": 22003.0,
      "formatted_start": "06:06:41.000",
      "formatted_end": "06:06:43.000",
      "text": "چی شده داقر شدی؟"
    },
    {
      "id": 36,
      "start": 22003.0,
      "end": 22005.0,
      "formatted_start": "06:06:43.000",
      "formatted_end": "06:06:45.000",
      "text": "چه مشکلی داری؟ چه مریضی داری؟"
    },
    {
      "id": 37,
      "start": 22005.0,
      "end": 22007.0,
      "formatted_start": "06:06:45.000",
      "formatted_end": "06:06:47.000",
      "text": "این یه مدت از این اصلا"
    },
    {
      "id": 38,
      "start": 22007.0,
      "end": 22009.0,
      "formatted_start": "06:06:47.000",
      "formatted_end": "06:06:49.000",
      "text": "خیلی خوبه"
    },
    {
      "id": 39,
      "start": 22011.0,
      "end": 22013.0,
      "formatted_start": "06:06:51.000",
      "formatted_end": "06:06:53.000",
      "text": "خیلی خودتون خوبه"
    },
    {
      "id": 40,
      "start": 22013.0,
      "end": 22015.0,
      "formatted_start": "06:06:53.000",
      "formatted_end": "06:06:55.000",
      "text": "خوبه الحمدلله"
    },
    {
      "id": 41,
      "start": 22015.0,
      "end": 22017.0,
      "formatted_start": "06:06:55.000",
      "formatted_end": "06:06:57.000",
      "text": "شما اخیرن بازنشست شدید"
    },
    {
      "id": 42,
      "start": 22017.0,
      "end": 22019.0,
      "formatted_start": "06:06:57.000",
      "formatted_end": "06:06:59.000",
      "text": "هشت ساله"
    },
    {
      "id": 43,
      "start": 22019.0,
      "end": 22021.0,
      "formatted_start": "06:06:59.000",
      "formatted_end": "06:07:01.000",
      "text": "از جدید هم نیست"
    },
    {
      "id": 44,
      "start": 22021.0,
      "end": 22023.0,
      "formatted_start": "06:07:01.000",
      "formatted_end": "06:07:03.000",
      "text": "هفت سال، هشت سال"
    },
    {
      "id": 45,
      "start": 22023.0,
      "end": 22025.0,
      "formatted_start": "06:07:03.000",
      "formatted_end": "06:07:05.000",
      "text": "شما از بعد بازنشست شدید"
    },
    {
      "id": 46,
      "start": 22025.0,
      "end": 22027.0,
      "formatted_start": "06:07:05.000",
      "formatted_end": "06:07:07.000",
      "text": "خانمون افتراد مدرنشی پیدا میکنند"
    },
    {
      "id": 47,
      "start": 22027.0,
      "end": 22029.0,
      "formatted_start": "06:07:07.000",
      "formatted_end": "06:07:09.000",
      "text": "و این یه"
    },
    {
      "id": 48,
      "start": 22029.0,
      "end": 22031.0,
      "formatted_start": "06:07:09.000",
      "formatted_end": "06:07:11.000",
      "text": "نوکس"
    },
    {
      "id": 49,
      "start": 22031.0,
      "end": 22033.0,
      "formatted_start": "06:07:11.000",
      "formatted_end": "06:07:13.000",
      "text": "استخدامی کرده"
    },
    {
      "id": 50,
      "start": 22033.0,
      "end": 22035.0,
      "formatted_start": "06:07:13.000",
      "formatted_end": "06:07:15.000",
      "text": "دلواتون همه از سه ماه همه نکسند"
    },
    {
      "id": 51,
      "start": 22035.0,
      "end": 22042.0,
      "formatted_start": "06:07:15.000",
      "formatted_end": "06:07:22.000",
      "text": "بعد این خورس چربی مدید چیه؟ چربی چطور بود؟ چون این شروع چربی نخوردیم بودم که رفتم اونجا"
    },
    {
      "id": 52,
      "start": 22042.0,
      "end": 22045.0,
      "formatted_start": "06:07:22.000",
      "formatted_end": "06:07:25.000",
      "text": "آره بله بابر خورستون داد بودم"
    },
    {
      "id": 53,
      "start": 22054.0,
      "end": 22057.0,
      "formatted_start": "06:07:34.000",
      "formatted_end": "06:07:37.000",
      "text": "خورس تلسیون و زرمی هم بخوایید باز بید"
    },
    {
      "id": 54,
      "start": 22057.0,
      "end": 22058.0,
      "formatted_start": "06:07:37.000",
      "formatted_end": "06:07:38.000",
      "text": "اون یه نفلکس هست؟"
    },
    {
      "id": 55,
      "start": 22058.0,
      "end": 22059.0,
      "formatted_start": "06:07:38.000",
      "formatted_end": "06:07:39.000",
      "text": "آره"
    },
    {
      "id": 56,
      "start": 22059.0,
      "end": 22062.0,
      "formatted_start": "06:07:39.000",
      "formatted_end": "06:07:42.000",
      "text": "بعد چربیتون آتار چند رو بکرست؟"
    },
    {
      "id": 57,
      "start": 22062.0,
      "end": 22063.0,
      "formatted_start": "06:07:42.000",
      "formatted_end": "06:07:43.000",
      "text": "ده"
    },
    {
      "id": 58,
      "start": 22065.0,
      "end": 22068.0,
      "formatted_start": "06:07:45.000",
      "formatted_end": "06:07:48.000",
      "text": "پریز قضایی زیاده صرف نداری؟"
    },
    {
      "id": 59,
      "start": 22068.0,
      "end": 22069.0,
      "formatted_start": "06:07:48.000",
      "formatted_end": "06:07:49.000",
      "text": "آره؟"
    },
    {
      "id": 60,
      "start": 22069.0,
      "end": 22071.0,
      "formatted_start": "06:07:49.000",
      "formatted_end": "06:07:51.000",
      "text": "چرا؟ خیلی رعایت می کنه"
    },
    {
      "id": 61,
      "start": 22071.0,
      "end": 22073.0,
      "formatted_start": "06:07:51.000",
      "formatted_end": "06:07:53.000",
      "text": "از این چربی اصلا استفاده نمی کنه"
    },
    {
      "id": 62,
      "start": 22073.0,
      "end": 22075.0,
      "formatted_start": "06:07:53.000",
      "formatted_end": "06:07:55.000",
      "text": "نه، خیلی تی نکنی"
    },
    {
      "id": 63,
      "start": 22075.0,
      "end": 22077.0,
      "formatted_start": "06:07:55.000",
      "formatted_end": "06:07:57.000",
      "text": "خوبه باشه کم داراتون رو برگرم کنی"
    },
    {
      "id": 64,
      "start": 22077.0,
      "end": 22083.0,
      "formatted_start": "06:07:57.000",
      "formatted_end": "06:08:03.000",
      "text": "خیلی قضاتون رو هزب نکنید همه چیز"
    },
    {
      "id": 65,
      "start": 22083.0,
      "end": 22086.0,
      "formatted_start": "06:08:03.000",
      "formatted_end": "06:08:06.000",
      "text": "گوشت قرمزتون رو هفته یه بار هتفا رو خورید"
    },
    {
      "id": 66,
      "start": 22090.0,
      "end": 22093.0,
      "formatted_start": "06:08:10.000",
      "formatted_end": "06:08:13.000",
      "text": "خیلی ممنون می کنید که مثلا قضا سبوف باشه"
    },
    {
      "id": 67,
      "start": 22093.0,
      "end": 22101.0,
      "formatted_start": "06:08:13.000",
      "formatted_end": "06:08:21.000",
      "text": "و خصوصا برنج و نون و مکارانی و سیزنگی اینها را خیلی کم می کنند"
    },
    {
      "id": 68,
      "start": 22101.0,
      "end": 22108.0,
      "formatted_start": "06:08:21.000",
      "formatted_end": "06:08:28.000",
      "text": "شیرینی که اصلا استفاده می دانید خیلی به ندرت، خیلی کم"
    },
    {
      "id": 69,
      "start": 22108.0,
      "end": 22113.0,
      "formatted_start": "06:08:28.000",
      "formatted_end": "06:08:33.000",
      "text": "نه شیرینی خودش خوب است برای اصل را بخواییم"
    },
    {
      "id": 70,
      "start": 22113.0,
      "end": 22116.0,
      "formatted_start": "06:08:33.000",
      "formatted_end": "06:08:36.000",
      "text": "اصلا خیلی تغییر می کنیم"
    },
    {
      "id": 71,
      "start": 22116.0,
      "end": 22119.0,
      "formatted_start": "06:08:36.000",
      "formatted_end": "06:08:39.000",
      "text": "پرسه چربی، فارموشن داریم؟"
    },
    {
      "id": 72,
      "start": 22119.0,
      "end": 22122.0,
      "formatted_start": "06:08:39.000",
      "formatted_end": "06:08:42.000",
      "text": "نه، کنن هم بگیرن همچنین"
    },
    {
      "id": 73,
      "start": 22122.0,
      "end": 22126.0,
      "formatted_start": "06:08:42.000",
      "formatted_end": "06:08:46.000",
      "text": "او سه ناشتر ندهی چیز که نمی کنی؟"
    },
    {
      "id": 74,
      "start": 22126.0,
      "end": 22128.0,
      "formatted_start": "06:08:46.000",
      "formatted_end": "06:08:48.000",
      "text": "نه، هیچیز که نمی کنی"
    },
    {
      "id": 75,
      "start": 22128.0,
      "end": 22134.0,
      "formatted_start": "06:08:48.000",
      "formatted_end": "06:08:54.000",
      "text": "او خانمشت گلچه می بینی یاد داشت کنه که فرکست رو فرکست سخت کنه، باشه این چشمتی که برده"
    },
    {
      "id": 76,
      "start": 22134.0,
      "end": 22139.0,
      "formatted_start": "06:08:54.000",
      "formatted_end": "06:08:59.000",
      "text": "درمت رو نوشتم به زبای فارموژن، امروز دیگه یه از داره دیگه چیزی نبود؟"
    },
    {
      "id": 77,
      "start": 22139.0,
      "end": 22142.0,
      "formatted_start": "06:08:59.000",
      "formatted_end": "06:09:02.000",
      "text": "نه، ندیگه تو زنی همه دیگه چیزی نمیدونه"
    },
    {
      "id": 78,
      "start": 22142.0,
      "end": 22172.0,
      "formatted_start": "06:09:02.000",
      "formatted_end": "06:09:32.000",
      "text": "از اینجا باید برداریم که از اینجا باید برداریم که از اینجا برداریم که از اینجا برداریم که از اینجا برداریم که از اینجا برداریم که از اینجا برداریم که از اینجا برداریم که از اینجا برداریم که از اینجا برداریم که از اینجا برداریم که از اینجا برداریم که از اینجا برداریم که از اینجا برداریم که از اینجا برداریم که از اینج"
    },
    {
      "id": 79,
      "start": 22172.0,
      "end": 22176.0,
      "formatted_start": "06:09:32.000",
      "formatted_end": "06:09:36.000",
      "text": "مریضی هم استفاده می کنم و هفته دو تا"
    },
    {
      "id": 80,
      "start": 22176.0,
      "end": 22178.0,
      "formatted_start": "06:09:36.000",
      "formatted_end": "06:09:38.000",
      "text": "یکی، یکتا"
    },
    {
      "id": 81,
      "start": 22178.0,
      "end": 22180.0,
      "formatted_start": "06:09:38.000",
      "formatted_end": "06:09:40.000",
      "text": "یونی فلیکس خودش مریضی هم داره"
    },
    {
      "id": 82,
      "start": 22180.0,
      "end": 22182.0,
      "formatted_start": "06:09:40.000",
      "formatted_end": "06:09:42.000",
      "text": "ولی یک دو تا نداره بلو خود بیشتر نداره"
    },
    {
      "id": 83,
      "start": 22182.0,
      "end": 22186.0,
      "formatted_start": "06:09:42.000",
      "formatted_end": "06:09:46.000",
      "text": "یونی فلیکس برای من میگویم سه تا دارو داره"
    },
    {
      "id": 84,
      "start": 22186.0,
      "end": 22188.0,
      "formatted_start": "06:09:46.000",
      "formatted_end": "06:09:48.000",
      "text": "ام از ام داره"
    },
    {
      "id": 85,
      "start": 22188.0,
      "end": 22190.0,
      "formatted_start": "06:09:48.000",
      "formatted_end": "06:09:50.000",
      "text": "مریضی هم داره با کرسیوم و بازدیک"
    },
    {
      "id": 86,
      "start": 22190.0,
      "end": 22192.0,
      "formatted_start": "06:09:50.000",
      "formatted_end": "06:09:52.000",
      "text": "خودش دارو کاملیه"
    },
    {
      "id": 87,
      "start": 22192.0,
      "end": 22194.0,
      "formatted_start": "06:09:52.000",
      "formatted_end": "06:09:54.000",
      "text": "تقریبا شما"
    },
    {
      "id": 88,
      "start": 22194.0,
      "end": 22196.0,
      "formatted_start": "06:09:54.000",
      "formatted_end": "06:09:56.000",
      "text": "متشکرم خانم"
    },
    {
      "id": 89,
      "start": 22196.0,
      "end": 22198.0,
      "formatted_start": "06:09:56.000",
      "formatted_end": "06:09:58.000",
      "text": "خدا بابدش رو برده شده"
    },
    {
      "id": 90,
      "start": 22198.0,
      "end": 22200.0,
      "formatted_start": "06:09:58.000",
      "formatted_end": "06:10:00.000",
      "text": "از داروان رو دیکرم"
    }
  ],
  "status": "completed"
}