  "stt_segments": [
    {
      "id": 0,
      "start": 3000.0,
      "end": 3005.0,
      "formatted_start": "00:50:00.000",
      "formatted_end": "00:50:05.000",
      "text": "بگید آموزش بدن ببرید کنید. دستگاهش راحت تر از بیمارستانه."
    },
    {
      "id": 1,
      "start": 3017.0,
      "end": 3020.0,
      "formatted_start": "00:50:17.000",
      "formatted_end": "00:50:20.000",
      "text": "خب آیه راییم فور دستگاه میدونید."
    },
    {
      "id": 2,
      "start": 3021.0,
      "end": 3026.0,
      "formatted_start": "00:50:21.000",
      "formatted_end": "00:50:26.000",
      "text": "یه سه شوان روز ببرید، خوبم بذارید آقا. چون در نیارید زیاد."
    },
    {
      "id": 3,
      "start": 3026.0,
      "end": 3030.0,
      "formatted_start": "00:50:26.000",
      "formatted_end": "00:50:30.000",
      "text": "این گرس هم از دارو خانه بگی بیار من ببینم"
    },
    {
      "id": 4,
      "start": 3030.0,
      "end": 3032.0,
      "formatted_start": "00:50:30.000",
      "formatted_end": "00:50:32.000",
      "text": "این خدمت شما"
    },
    {
      "id": 5,
      "start": 3032.0,
      "end": 3034.0,
      "formatted_start": "00:50:32.000",
      "formatted_end": "00:50:34.000",
      "text": "خامسامی یه سه شب دستگاه بدیم"
    },
    {
      "id": 6,
      "start": 3034.0,
      "end": 3036.0,
      "formatted_start": "00:50:34.000",
      "formatted_end": "00:50:36.000",
      "text": "دل پیچه شو بینام"
    },
    {
      "id": 7,
      "start": 3036.0,
      "end": 3038.0,
      "formatted_start": "00:50:36.000",
      "formatted_end": "00:50:38.000",
      "text": "دل پیچه شو بدیم من یه شروط شروط هستم"
    },
    {
      "id": 8,
      "start": 3038.0,
      "end": 3040.0,
      "formatted_start": "00:50:38.000",
      "formatted_end": "00:50:40.000",
      "text": "خیلی بیقراری داره"
    },
    {
      "id": 9,
      "start": 3040.0,
      "end": 3042.0,
      "formatted_start": "00:50:40.000",
      "formatted_end": "00:50:42.000",
      "text": "خیلی بیقراری داره"
    },
    {
      "id": 10,
      "start": 3042.0,
      "end": 3044.0,
      "formatted_start": "00:50:42.000",
      "formatted_end": "00:50:44.000",
      "text": "شکمشم باقی داره"
    },
    {
      "id": 11,
      "start": 3044.0,
      "end": 3046.0,
      "formatted_start": "00:50:44.000",
      "formatted_end": "00:50:46.000",
      "text": "خودت حبوباتو"
    },
    {
      "id": 12,
      "start": 3046.0,
      "end": 3048.0,
      "formatted_start": "00:50:46.000",
      "formatted_end": "00:50:48.000",
      "text": "لبنیات گاوی نخور"
    },
    {
      "id": 13,
      "start": 3048.0,
      "end": 3050.0,
      "formatted_start": "00:50:48.000",
      "formatted_end": "00:50:50.000",
      "text": "نه نخور"
    },
    {
      "id": 14,
      "start": 3050.0,
      "end": 3052.0,
      "formatted_start": "00:50:50.000",
      "formatted_end": "00:50:52.000",
      "text": "بادمجون خیار"
    },
    {
      "id": 15,
      "start": 3052.0,
      "end": 3054.0,
      "formatted_start": "00:50:52.000",
      "formatted_end": "00:50:54.000",
      "text": "و یکی هم لبنیات دیگه میدونی"
    },
    {
      "id": 16,
      "start": 3054.0,
      "end": 3056.0,
      "formatted_start": "00:50:54.000",
      "formatted_end": "00:50:56.000",
      "text": "ماز پنیشی"
    },
    {
      "id": 17,
      "start": 3071.0,
      "end": 3073.0,
      "formatted_start": "00:51:11.000",
      "formatted_end": "00:51:13.000",
      "text": "ببینیم خدمت شده"
    },
    {
      "id": 18,
      "start": 3076.0,
      "end": 3080.0,
      "formatted_start": "00:51:16.000",
      "formatted_end": "00:51:20.000",
      "text": "دستکارم قبل از اینکه برق بره به خانستانی بگین که"
    },
    {
      "id": 19,
      "start": 3080.0,
      "end": 3085.0,
      "formatted_start": "00:51:20.000",
      "formatted_end": "00:51:25.000",
      "text": "چیز کنه، آموزش بده به برق بس کنه که الان چون برقای ده دقیقه دیگه میره"
    },
    {
      "id": 20,
      "start": 3092.5,
      "end": 3096.5,
      "formatted_start": "00:51:32.500",
      "formatted_end": "00:51:36.500",
      "text": "خوامستان یه رمز اومده ۵۲۹۸۸"
    },
    {
      "id": 21,
      "start": 3110.0,
      "end": 3140.0,
      "formatted_start": "00:51:50.000",
      "formatted_end": "00:52:20.000",
      "text": "باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید باید بای"
    },
    {
      "id": 22,
      "start": 3140.0,
      "end": 3142.0,
      "formatted_start": "00:52:20.000",
      "formatted_end": "00:52:22.000",
      "text": "برنامه از اینجا باید برداریم"
    },
    {
