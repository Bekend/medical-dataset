  "stt_segments": [
    {
      "id": 0,
      "start": 13500.0,
      "end": 13530.0,
      "formatted_start": "03:45:00.000",
      "formatted_end": "03:45:30.000",
      "text": "از اینجا باید بردارید که از اینجا باید بردارید که از اینجا بردارید که از اینجا بردارید که از اینجا بردارید که از اینجا بردارید که از اینجا بردارید که از اینجا بردارید که از اینجا بردارید که از اینجا بردارید که از اینجا بردارید که از اینجا بردارید که از اینجا بردارید که از اینجا بردارید که از اینجا بردارید که از اینج"
    },
    {
      "id": 1,
      "start": 13530.0,
      "end": 13533.0,
      "formatted_start": "03:45:30.000",
      "formatted_end": "03:45:33.000",
      "text": "چرا بردونم چرا تا جنگ بزرگ مزدوج داریم؟"
    },
    {
      "id": 2,
      "start": 13533.0,
      "end": 13535.0,
      "formatted_start": "03:45:33.000",
      "formatted_end": "03:45:35.000",
      "text": "شامل این امتحان نتا داریم؟"
    },
    {
      "id": 3,
      "start": 13535.0,
      "end": 13538.0,
      "formatted_start": "03:45:35.000",
      "formatted_end": "03:45:38.000",
      "text": "واقعا خواهید بر سر من بکنیم"
    },
    {
      "id": 4,
      "start": 13538.0,
      "end": 13540.0,
      "formatted_start": "03:45:38.000",
      "formatted_end": "03:45:40.000",
      "text": "تو نه باشه چشم موضوع باز بازیم بکنیم"
    },
    {
      "id": 5,
      "start": 13540.0,
      "end": 13543.0,
      "formatted_start": "03:45:40.000",
      "formatted_end": "03:45:43.000",
      "text": "خب بالاخره تو میخوایی بری بگیری"
    },
    {
      "id": 6,
      "start": 13543.0,
      "end": 13547.0,
      "formatted_start": "03:45:43.000",
      "formatted_end": "03:45:47.000",
      "text": "یه اتفاق برگیره من بگیرم که به خوردی نرسد"
    },
    {
      "id": 7,
      "start": 13547.0,
      "end": 13550.0,
      "formatted_start": "03:45:47.000",
      "formatted_end": "03:45:50.000",
      "text": "برو اگه ازش باش کردی جهان باز عقله بازی باشم"
    },
    {
      "id": 8,
      "start": 13550.0,
      "end": 13551.0,
      "formatted_start": "03:45:50.000",
      "formatted_end": "03:45:51.000",
      "text": "بگیریم"
    },
    {
      "id": 9,
      "start": 13551.0,
      "end": 13554.0,
      "formatted_start": "03:45:51.000",
      "formatted_end": "03:45:54.000",
      "text": "پس من تا روی عقله برده داریم"
    },
    {
      "id": 10,
      "start": 13554.0,
      "end": 13574.0,
      "formatted_start": "03:45:54.000",
      "formatted_end": "03:46:14.000",
      "text": "موسیقی"
    },
    {
      "id": 11,
      "start": 13574.0,
      "end": 13576.0,
      "formatted_start": "03:46:14.000",
      "formatted_end": "03:46:16.000",
      "text": "بله"
    },
    {
      "id": 12,
      "start": 13576.0,
      "end": 13581.0,
      "formatted_start": "03:46:16.000",
      "formatted_end": "03:46:21.000",
      "text": "نه اپرگی جایی بود که تاریخ بزنیم ولی امروز بود"
    },
    {
      "id": 13,
      "start": 13581.0,
      "end": 13583.0,
      "formatted_start": "03:46:21.000",
      "formatted_end": "03:46:23.000",
      "text": "اومده؟"
    },
    {
      "id": 14,
      "start": 13583.0,
      "end": 13586.0,
      "formatted_start": "03:46:23.000",
      "formatted_end": "03:46:26.000",
      "text": "اومده، حالا حالا برو توشو کنید که"
    },
    {
      "id": 15,
      "start": 13586.0,
      "end": 13589.0,
      "formatted_start": "03:46:26.000",
      "formatted_end": "03:46:29.000",
      "text": "همه رو این رو با آخرت برده کنم و نرم برده کنم"
    },
    {
      "id": 16,
      "start": 13589.0,
      "end": 13592.0,
      "formatted_start": "03:46:29.000",
      "formatted_end": "03:46:32.000",
