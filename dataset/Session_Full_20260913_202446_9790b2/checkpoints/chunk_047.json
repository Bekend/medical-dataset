      "formatted_start": "03:55:52.000",
      "formatted_end": "03:55:54.000",
      "text": "اینجا بود."
    },
    {
      "id": 17,
      "start": 14154.0,
      "end": 14156.0,
      "formatted_start": "03:55:54.000",
      "formatted_end": "03:55:56.000",
      "text": "اینجا بود."
    },
    {
      "id": 18,
      "start": 14156.0,
      "end": 14158.0,
      "formatted_start": "03:55:56.000",
      "formatted_end": "03:55:58.000",
      "text": "اینجا بود."
    },
    {
      "id": 19,
      "start": 14158.0,
      "end": 14163.0,
      "formatted_start": "03:55:58.000",
      "formatted_end": "03:56:03.000",
      "text": "اینم بیچه درنه. شش دقیق دارم."
    },
    {
      "id": 20,
      "start": 14163.0,
      "end": 14165.0,
      "formatted_start": "03:56:03.000",
      "formatted_end": "03:56:05.000",
      "text": "هرچه چشمتو این رو بنوسم؟"
    },
    {
      "id": 21,
      "start": 14165.0,
      "end": 14167.0,
      "formatted_start": "03:56:05.000",
      "formatted_end": "03:56:07.000",
      "text": "بنوسم. تمام شد."
    },
    {
      "id": 22,
      "start": 14167.0,
      "end": 14171.0,
      "formatted_start": "03:56:07.000",
      "formatted_end": "03:56:11.000",
      "text": "مثل ایمار ادرارت بود، همه ادرارو منوسم."
    },
    {
      "id": 23,
      "start": 14171.0,
      "end": 14173.0,
      "formatted_start": "03:56:11.000",
      "formatted_end": "03:56:13.000",
      "text": "دست درمون."
    },
    {
      "id": 24,
      "start": 14173.0,
      "end": 14177.0,
      "formatted_start": "03:56:13.000",
      "formatted_end": "03:56:17.000",
      "text": "از ما بیداریم چون دیدرم دیردر میده."
    },
    {
      "id": 25,
      "start": 14177.0,
      "end": 14180.0,
      "formatted_start": "03:56:17.000",
      "formatted_end": "03:56:20.000",
      "text": "بله همون. همه رو نوشتی."
    },
    {
      "id": 26,
      "start": 14180.0,
      "end": 14182.0,
      "formatted_start": "03:56:20.000",
      "formatted_end": "03:56:22.000",
      "text": "دست درمون."
    },
    {
      "id": 27,
      "start": 14182.0,
      "end": 14189.0,
      "formatted_start": "03:56:22.000",
      "formatted_end": "03:56:29.000",
      "text": "این ارمی قرار داده داری؟"
    },
    {
      "id": 28,
      "start": 14189.0,
      "end": 14192.0,
      "formatted_start": "03:56:29.000",
      "formatted_end": "03:56:32.000",
      "text": "ارمی پایین شب و نمسی هم هر دو"
    },
    {
      "id": 29,
      "start": 14192.0,
      "end": 14194.0,
      "formatted_start": "03:56:32.000",
      "formatted_end": "03:56:34.000",
      "text": "تمام شد؟"
    },
    {
      "id": 30,
      "start": 14194.0,
      "end": 14196.0,
      "formatted_start": "03:56:34.000",
      "formatted_end": "03:56:36.000",
      "text": "تمام هستی زن"
    },
    {
      "id": 31,
      "start": 14196.0,
      "end": 14198.0,
      "formatted_start": "03:56:36.000",
      "formatted_end": "03:56:38.000",
      "text": "باشی"
    },
    {
      "id": 32,
      "start": 14198.0,
      "end": 14202.0,
      "formatted_start": "03:56:38.000",
      "formatted_end": "03:56:42.000",
      "text": "خانمون دیگه یه ده بخوریم"
    },
    {
      "id": 33,
      "start": 14202.0,
      "end": 14208.0,
      "formatted_start": "03:56:42.000",
      "formatted_end": "03:56:48.000",
      "text": "یه دیگه دیده"
    },
    {
      "id": 34,
      "start": 14208.0,
      "end": 14210.0,
      "formatted_start": "03:56:48.000",
      "formatted_end": "03:56:50.000",
