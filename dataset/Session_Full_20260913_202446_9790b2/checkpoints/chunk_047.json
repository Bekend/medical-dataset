  "stt_segments": [
    {
      "id": 0,
      "start": 14100.0,
      "end": 14103.0,
      "formatted_start": "03:55:00.000",
      "formatted_end": "03:55:03.000",
      "text": "این رو برای تو بیمار بیمار درمیسم، برای تو آزاد بگیرم."
    },
    {
      "id": 1,
      "start": 14103.0,
      "end": 14106.0,
      "formatted_start": "03:55:03.000",
      "formatted_end": "03:55:06.000",
      "text": "این چهاره دور زمان رو تیمیل میبینن."
    },
    {
      "id": 2,
      "start": 14117.0,
      "end": 14120.0,
      "formatted_start": "03:55:17.000",
      "formatted_end": "03:55:20.000",
      "text": "این پرس برای فراموشی داشتی؟ اون هم هست؟"
    },
    {
      "id": 3,
      "start": 14120.0,
      "end": 14124.0,
      "formatted_start": "03:55:20.000",
      "formatted_end": "03:55:24.000",
      "text": "نمیدونم، این هم خیلی برم."
    },
    {
      "id": 4,
      "start": 14124.0,
      "end": 14129.0,
      "formatted_start": "03:55:24.000",
      "formatted_end": "03:55:29.000",
      "text": "نه، نه، خاصا روماتیس میرد، این همه رو بیمار درمیسم."
    },
    {
      "id": 5,
      "start": 14130.0,
      "end": 14132.0,
      "formatted_start": "03:55:30.000",
      "formatted_end": "03:55:32.000",
      "text": "این از اینجا بود."
    },
    {
      "id": 6,
      "start": 14132.0,
      "end": 14134.0,
      "formatted_start": "03:55:32.000",
      "formatted_end": "03:55:34.000",
      "text": "این از اینجا بود."
    },
    {
      "id": 7,
      "start": 14134.0,
      "end": 14136.0,
      "formatted_start": "03:55:34.000",
      "formatted_end": "03:55:36.000",
      "text": "اینجا بود."
    },
    {
      "id": 8,
      "start": 14136.0,
      "end": 14138.0,
      "formatted_start": "03:55:36.000",
      "formatted_end": "03:55:38.000",
