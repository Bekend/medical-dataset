      "formatted_start": "02:20:12.000",
      "formatted_end": "02:20:17.000",
      "text": "قدرتون تقریبا خوبه، زیاد شیر و شکولتی چیز نخورید."
    },
    {
      "id": 3,
      "start": 8417.0,
      "end": 8424.0,
      "formatted_start": "02:20:17.000",
      "formatted_end": "02:20:24.000",
      "text": "پولیه خوبه، چرپی خوبه، آزمای کبد هم خوبه، یه ذره کمخونی."
    },
    {
      "id": 4,
      "start": 8424.0,
      "end": 8427.0,
      "formatted_start": "02:20:24.000",
      "formatted_end": "02:20:27.000",
      "text": "کمخونه باشه؟ خوبه از چای خوبه، مثلا؟"
    },
    {
      "id": 5,
      "start": 8427.0,
      "end": 8435.0,
      "formatted_start": "02:20:27.000",
      "formatted_end": "02:20:35.000",
      "text": "تیروید؟ خیلی نیست. روماتیسمتون آزمایشش فیلن خواهشه. طب مالت هم ندارید."
    },
    {
      "id": 6,
      "start": 8435.0,
      "end": 8444.0,
      "formatted_start": "02:20:35.000",
      "formatted_end": "02:20:44.000",
      "text": "نه. روماتیسمتون همون مدتی هست. اون مدرنه هیلدورتونکی اونو همون بازار نیست؟"
    },
    {
      "id": 7,
      "start": 8444.0,
      "end": 8446.0,
      "formatted_start": "02:20:44.000",
      "formatted_end": "02:20:46.000",
      "text": "الان پست. الان هست؟"
    },
    {
      "id": 8,
      "start": 8446.0,
      "end": 8447.0,
      "formatted_start": "02:20:46.000",
      "formatted_end": "02:20:47.000",
      "text": "آره."
    },
    {
      "id": 9,
      "start": 8447.0,
      "end": 8449.0,
      "formatted_start": "02:20:47.000",
      "formatted_end": "02:20:49.000",
      "text": "از اونو بگو سپسید."
    },
    {
      "id": 10,
      "start": 8449.0,
      "end": 8451.0,
      "formatted_start": "02:20:49.000",
      "formatted_end": "02:20:51.000",
      "text": "اینجور سپسید؟"
    },
    {
      "id": 11,
      "start": 8451.0,
      "end": 8454.0,
      "formatted_start": "02:20:51.000",
      "formatted_end": "02:20:54.000",
      "text": "اونو مدت یک روز سپسید."
    },
    {
      "id": 12,
      "start": 8454.0,
      "end": 8458.0,
      "formatted_start": "02:20:54.000",
      "formatted_end": "02:20:58.000",
      "text": "میرسید این وقت را دنبال کسی سفرا جرایش یا فرد؟"
    },
    {
      "id": 13,
      "start": 8458.0,
      "end": 8460.0,
      "formatted_start": "02:20:58.000",
      "formatted_end": "02:21:00.000",
      "text": "نمیرسیم، نمیرسیم"
    },
    {
      "id": 14,
      "start": 8460.0,
      "end": 8462.0,
      "formatted_start": "02:21:00.000",
      "formatted_end": "02:21:02.000",
      "text": "که میجوید برید؟"
    },
    {
      "id": 15,
      "start": 8462.0,
      "end": 8466.0,
      "formatted_start": "02:21:02.000",
      "formatted_end": "02:21:06.000",
      "text": "نمیرسیم، رفته من، ممکنه بچه هم هشت برمیسنم"
    },
    {
      "id": 16,
      "start": 8466.0,
      "end": 8470.0,
      "formatted_start": "02:21:06.000",
      "formatted_end": "02:21:10.000",
      "text": "یک پقای پانه هشت برم، رفته سرخم، برم تره هم آمدن"
    },
    {
      "id": 17,
      "start": 8470.0,
      "end": 8474.0,
      "formatted_start": "02:21:10.000",
      "formatted_end": "02:21:14.000",
      "text": "میبوده یک مقصد دم برم، کشور برم، سرزم برم"
    },
    {
      "id": 18,
      "start": 8474.0,
      "end": 8479.0,
      "formatted_start": "02:21:14.000",
      "formatted_end": "02:21:19.000",
      "text": "و بالاخره که باید برید، هنوز تا سرپای جوانترین برید که آج پیر بشید"
    },
    {
      "id": 19,
      "start": 8479.0,
      "end": 8482.0,
      "formatted_start": "02:21:19.000",
      "formatted_end": "02:21:22.000",
      "text": "اگر خیلی بشید، عمل نمی کنید و درد سر می خواهید."
    },
    {
      "id": 20,
      "start": 8482.0,
      "end": 8485.0,
      "formatted_start": "02:21:22.000",
      "formatted_end": "02:21:25.000",
      "text": "هنوز سنتون زیر هفتاده عمل کنید."
    },
    {
      "id": 21,
      "start": 8485.0,
      "end": 8488.0,
      "formatted_start": "02:21:25.000",
      "formatted_end": "02:21:28.000",
      "text": "چون بی درد سر است."
    },
    {
      "id": 22,
      "start": 8488.0,
      "end": 8492.0,
      "formatted_start": "02:21:28.000",
      "formatted_end": "02:21:32.000",
      "text": "من فعلاً غرص می رویستم شبیه که خیلی اثر ندارد."
    },
    {
      "id": 23,
      "start": 8492.0,
      "end": 8497.0,
      "formatted_start": "02:21:32.000",
      "formatted_end": "02:21:37.000",
      "text": "شما مکارانی، تقمه مرق، غذای چرد، اصلاً نباید بخورید."
    },
    {
      "id": 24,
      "start": 8497.0,
      "end": 8500.0,
      "formatted_start": "02:21:37.000",
      "formatted_end": "02:21:40.000",
      "text": "نه، مخارق اصلاً نیمون."
    },
    {
      "id": 25,
      "start": 8500.0,
      "end": 8503.0,
      "formatted_start": "02:21:40.000",
      "formatted_end": "02:21:43.000",
      "text": "تقمه مرق، مثل این گرایبو تمن بخورید."
    },
    {
      "id": 26,
      "start": 8503.0,
      "end": 8505.0,
      "formatted_start": "02:21:43.000",
      "formatted_end": "02:21:45.000",
      "text": "خب، این درد می گیرد."
    },
    {
      "id": 27,
      "start": 8505.0,
      "end": 8508.0,
      "formatted_start": "02:21:45.000",
      "formatted_end": "02:21:48.000",
      "text": "اگر اینکه درستانتون چرک باشه، کسی صفرا درد میگیره"
    },
    {
      "id": 28,
      "start": 8508.0,
      "end": 8511.0,
      "formatted_start": "02:21:48.000",
      "formatted_end": "02:21:51.000",
      "text": "گشنگی، تشنگی اصلا نباید بکشید"
    },
    {
      "id": 29,
      "start": 8511.0,
      "end": 8514.0,
      "formatted_start": "02:21:51.000",
      "formatted_end": "02:21:54.000",
      "text": "روزه داری این هم ممنوعه"
    },
    {
      "id": 30,
      "start": 8514.0,
      "end": 8517.0,
      "formatted_start": "02:21:54.000",
      "formatted_end": "02:21:57.000",
      "text": "تکه گرستنگی، تشنگی اصلا یعنی میری سر زمین"
    },
    {
      "id": 31,
      "start": 8517.0,
      "end": 8520.0,
      "formatted_start": "02:21:57.000",
      "formatted_end": "02:22:00.000",
      "text": "همش با این چیز بخورید و اگر نه درد شروع میشه"
    },
    {
      "id": 32,
      "start": 8520.0,
      "end": 8523.0,
      "formatted_start": "02:22:00.000",
      "formatted_end": "02:22:03.000",
      "text": "ترشی، فلفل این هم نباید بخورید"
    },
    {
      "id": 33,
      "start": 8523.0,
      "end": 8526.0,
      "formatted_start": "02:22:03.000",
      "formatted_end": "02:22:06.000",
      "text": "نه، ترشی بدتر تونه کنه خصوصا"
    },
    {
      "id": 34,
      "start": 8526.0,
      "end": 8529.0,
      "formatted_start": "02:22:06.000",
      "formatted_end": "02:22:09.000",
      "text": "اما من باید درواتونو بدمیزم"
    },
    {
      "id": 35,
      "start": 8529.0,
      "end": 8533.0,
      "formatted_start": "02:22:09.000",
      "formatted_end": "02:22:13.000",
      "text": "برمیزم ببینم ترمیل هستی بذار بگیرم چیکارتون"
    },
    {
      "id": 36,
      "start": 8533.0,
      "end": 8535.0,
      "formatted_start": "02:22:13.000",
      "formatted_end": "02:22:15.000",
      "text": "برمیزم ببینم ترمیل هستی بذار بگیرم چیکارتون"
    },
    {
      "id": 37,
      "start": 8535.0,
      "end": 8537.0,
      "formatted_start": "02:22:15.000",
      "formatted_end": "02:22:17.000",
      "text": "بیتامین دی هم خوبه"
    },
    {
      "id": 38,
      "start": 8537.0,
      "end": 8539.0,
      "formatted_start": "02:22:17.000",
      "formatted_end": "02:22:19.000",
      "text": "بیتامین دی هم خوبه"
    },
    {
      "id": 39,
      "start": 8539.0,
      "end": 8541.0,
      "formatted_start": "02:22:19.000",
      "formatted_end": "02:22:21.000",
      "text": "بیتامین دی خوبه"
    },
    {
      "id": 40,
      "start": 8541.0,
      "end": 8543.0,
      "formatted_start": "02:22:21.000",
      "formatted_end": "02:22:23.000",
      "text": "من گفتم همین قسمت رو متعارف کنم"
    },
    {
      "id": 41,
      "start": 8543.0,
      "end": 8545.0,
      "formatted_start": "02:22:23.000",
      "formatted_end": "02:22:25.000",
      "text": "من اگه من چی بکنم"
    },
    {
      "id": 42,
      "start": 8545.0,
      "end": 8547.0,
      "formatted_start": "02:22:25.000",
      "formatted_end": "02:22:27.000",
      "text": "من گفتم همین قسمت رو متعارف کنم"
    },
    {
      "id": 43,
      "start": 8547.0,
      "end": 8549.0,
      "formatted_start": "02:22:27.000",
      "formatted_end": "02:22:29.000",
      "text": "من گفتم همین قسمت رو متعارف کنم"
    },
    {
      "id": 44,
      "start": 8549.0,
      "end": 8551.0,
      "formatted_start": "02:22:29.000",
      "formatted_end": "02:22:31.000",
      "text": "من گفتم همین قسمت رو متعارف کنم"
    },
    {
      "id": 45,
      "start": 8551.0,
      "end": 8553.0,
      "formatted_start": "02:22:31.000",
      "formatted_end": "02:22:33.000",
      "text": "نه هر بیس روز یکی بسته"
    },
    {
      "id": 46,
      "start": 8553.0,
      "end": 8555.0,
      "formatted_start": "02:22:33.000",
      "formatted_end": "02:22:35.000",
      "text": "درسته ای که این طب بشه"
    },
    {
      "id": 47,
      "start": 8558.0,
      "end": 8559.0,
      "formatted_start": "02:22:38.000",
      "formatted_end": "02:22:39.000",
      "text": "دارواتونو داری؟"
    },
    {
      "id": 48,
      "start": 8559.0,
      "end": 8560.0,
      "formatted_start": "02:22:39.000",
      "formatted_end": "02:22:40.000",
      "text": "نه، ندارم"
    },
    {
      "id": 49,
      "start": 8560.0,
      "end": 8569.0,
      "formatted_start": "02:22:40.000",
      "formatted_end": "02:22:49.000",
      "text": "دارواتونو ندارم، اون داروی که یکی که همون درسته زهر تشن میگه، نارم"
    },
    {
      "id": 50,
      "start": 8570.0,
      "end": 8574.0,
      "formatted_start": "02:22:50.000",
      "formatted_end": "02:22:54.000",
      "text": "مال متاتروکسک؟ مال روماتیز؟"
    },
    {
      "id": 51,
      "start": 8574.0,
      "end": 8579.0,
      "formatted_start": "02:22:54.000",
      "formatted_end": "02:22:59.000",
      "text": "میدونم اونو مال روماتیز، همون قلبونو بشه ببینید، از اونو دیگر دارم"
    },
    {
      "id": 52,
      "start": 8579.0,
      "end": 8580.0,
      "formatted_start": "02:22:59.000",
      "formatted_end": "02:23:00.000",
      "text": "تو بسیار دارم یکی که خودتون"
    },
    {
      "id": 53,
      "start": 8580.0,
      "end": 8582.0,
      "formatted_start": "02:23:00.000",
      "formatted_end": "02:23:02.000",
      "text": "که درسته ای جمعه باید بخورید؟"
    },
    {
      "id": 54,
      "start": 8582.0,
      "end": 8612.0,
      "formatted_start": "02:23:02.000",
      "formatted_end": "02:23:32.000",
      "text": "نه نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه، نه"
    },
    {
      "id": 55,
      "start": 8612.0,
      "end": 8614.0,
      "formatted_start": "02:23:32.000",
      "formatted_end": "02:23:34.000",
      "text": "بسیار درمیدید"
    },
    {
      "id": 56,
      "start": 8619.0,
      "end": 8621.0,
      "formatted_start": "02:23:39.000",
      "formatted_end": "02:23:41.000",
      "text": "اجابه ایرانی که"
    },
    {
      "id": 57,
      "start": 8621.0,
      "end": 8623.0,
      "formatted_start": "02:23:41.000",
      "formatted_end": "02:23:43.000",
      "text": "بکن ما باید"
    },
    {
      "id": 58,
      "start": 8623.0,
      "end": 8625.0,
      "formatted_start": "02:23:43.000",
      "formatted_end": "02:23:45.000",
      "text": "اینجا نیست"
    },
    {
      "id": 59,
      "start": 8625.0,
      "end": 8628.0,
      "formatted_start": "02:23:45.000",
      "formatted_end": "02:23:48.000",
      "text": "پول میشیم باور کنیم"
    },
    {
      "id": 60,
      "start": 8628.0,
      "end": 8630.0,
      "formatted_start": "02:23:48.000",
      "formatted_end": "02:23:50.000",
      "text": "نارنجی ها رو پس داریم"
    },
    {
      "id": 61,
      "start": 8630.0,
      "end": 8632.0,
      "formatted_start": "02:23:50.000",
      "formatted_end": "02:23:52.000",
      "text": "بله اون رو نداریم"
    },
    {
      "id": 62,
      "start": 8632.0,
      "end": 8636.0,
      "formatted_start": "02:23:52.000",
      "formatted_end": "02:23:56.000",
      "text": "یا آنطور که نمیسهم یکم دستتون"
    },
    {
      "id": 63,
      "start": 8636.0,
      "end": 8639.0,
      "formatted_start": "02:23:56.000",
      "formatted_end": "02:23:59.000",
      "text": "آنطور مثال که اینجا درده باید لازم ساکن بشیم"
    },
    {
      "id": 64,
      "start": 8639.0,
      "end": 8641.0,
      "formatted_start": "02:23:59.000",
      "formatted_end": "02:24:01.000",
      "text": "کنترل ادرال رو داری؟"
    },
    {
      "id": 65,
      "start": 8641.0,
      "end": 8643.0,
      "formatted_start": "02:24:01.000",
      "formatted_end": "02:24:03.000",
      "text": "ادرال هم هست"
    },
    {
      "id": 66,
      "start": 8643.0,
      "end": 8645.0,
      "formatted_start": "02:24:03.000",
      "formatted_end": "02:24:05.000",
      "text": "الان ادرال هم مورده که"
    },
    {
      "id": 67,
      "start": 8645.0,
      "end": 8647.0,
      "formatted_start": "02:24:05.000",
      "formatted_end": "02:24:07.000",
      "text": "کم ادرال کنیم"
    },
    {
      "id": 68,
      "start": 8647.0,
      "end": 8649.0,
      "formatted_start": "02:24:07.000",
      "formatted_end": "02:24:09.000",
      "text": "مشکل ندارد"
    },
    {
      "id": 69,
      "start": 8649.0,
      "end": 8651.0,
      "formatted_start": "02:24:09.000",
      "formatted_end": "02:24:11.000",
      "text": "ادرال هم خوبه"
    },
    {
      "id": 70,
      "start": 8651.0,
      "end": 8653.0,
      "formatted_start": "02:24:11.000",
      "formatted_end": "02:24:13.000",
      "text": "ادرال هم هست"
    },
    {
      "id": 71,
      "start": 8653.0,
      "end": 8655.0,
      "formatted_start": "02:24:13.000",
      "formatted_end": "02:24:15.000",
      "text": "پروستاد هم خوبه"
    },
    {
      "id": 72,
      "start": 8655.0,
      "end": 8657.0,
      "formatted_start": "02:24:15.000",
      "formatted_end": "02:24:17.000",
      "text": "برای کنترل ادرال رو داری؟"
    },
    {
      "id": 73,
      "start": 8657.0,
      "end": 8659.0,
      "formatted_start": "02:24:17.000",
      "formatted_end": "02:24:19.000",
      "text": "یکی درم هست"
    },
    {
      "id": 74,
      "start": 8659.0,
      "end": 8661.0,
      "formatted_start": "02:24:19.000",
      "formatted_end": "02:24:21.000",
      "text": "دو بسیاری نداری"
    },
    {
      "id": 75,
      "start": 8661.0,
      "end": 8663.0,
      "formatted_start": "02:24:21.000",
      "formatted_end": "02:24:23.000",
      "text": "برای پروستاد"
    },
    {
      "id": 76,
      "start": 8663.0,
      "end": 8665.0,
      "formatted_start": "02:24:23.000",
      "formatted_end": "02:24:25.000",
      "text": "اونایی که تبصور؟"
    },
    {
      "id": 77,
      "start": 8665.0,
      "end": 8667.0,
      "formatted_start": "02:24:25.000",
      "formatted_end": "02:24:27.000",
      "text": "نره که هم تو برده"
    },
    {
      "id": 78,
      "start": 8667.0,
      "end": 8669.0,
      "formatted_start": "02:24:27.000",
      "formatted_end": "02:24:29.000",
