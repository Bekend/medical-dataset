  "stt_segments": [
    {
      "id": 0,
      "start": 16500.0,
      "end": 16502.0,
      "formatted_start": "04:35:00.000",
      "formatted_end": "04:35:02.000",
      "text": "درسته خودم میده."
    },
    {
      "id": 1,
      "start": 16502.0,
      "end": 16505.0,
      "formatted_start": "04:35:02.000",
      "formatted_end": "04:35:05.000",
      "text": "خیلی هم وشنگه. دستاتو نرمکارو زرمک دیدیم."
    },
    {
      "id": 2,
      "start": 16505.0,
      "end": 16507.0,
      "formatted_start": "04:35:05.000",
      "formatted_end": "04:35:07.000",
      "text": "خیلی زرمک دیدیم."
    },
    {
      "id": 3,
      "start": 16507.0,
      "end": 16509.0,
      "formatted_start": "04:35:07.000",
      "formatted_end": "04:35:09.000",
      "text": "خیلی هم وشنگه."
    },
    {
      "id": 4,
      "start": 16509.0,
      "end": 16511.0,
      "formatted_start": "04:35:09.000",
      "formatted_end": "04:35:11.000",
      "text": "برده خوروکو بیمار بیتا میده ندارم."
    },
    {
      "id": 5,
      "start": 16511.0,
      "end": 16513.0,
      "formatted_start": "04:35:11.000",
      "formatted_end": "04:35:13.000",
      "text": "همون که دکتر داده بسته دیگه."
    },
    {
      "id": 6,
      "start": 16513.0,
      "end": 16514.0,
      "formatted_start": "04:35:13.000",
      "formatted_end": "04:35:14.000",
      "text": "همین؟"
    },
    {
      "id": 7,
      "start": 16514.0,
      "end": 16515.0,
      "formatted_start": "04:35:14.000",
      "formatted_end": "04:35:15.000",
      "text": "آره."
    },
    {
      "id": 8,
      "start": 16515.0,
      "end": 16517.0,
      "formatted_start": "04:35:15.000",
      "formatted_end": "04:35:17.000",
      "text": "آره هرتوش بزرگ ساز داره آیناها."
    },
    {
      "id": 9,
      "start": 16517.0,
      "end": 16518.0,
      "formatted_start": "04:35:17.000",
      "formatted_end": "04:35:18.000",
      "text": "خب؟"
    },
    {
      "id": 10,
      "start": 16518.0,
      "end": 16520.0,
      "formatted_start": "04:35:18.000",
      "formatted_end": "04:35:20.000",
      "text": "من براتو میتا میدی به اینا نوشتم."
    },
    {
      "id": 11,
      "start": 16520.0,
      "end": 16522.0,
      "formatted_start": "04:35:20.000",
      "formatted_end": "04:35:22.000",
      "text": "میتا میدی داره خوروکو."
    },
    {
      "id": 12,
      "start": 16522.0,
      "end": 16524.0,
      "formatted_start": "04:35:22.000",
      "formatted_end": "04:35:24.000",
      "text": "از همونو بخور هر هفته یه بار"
    },
    {
      "id": 13,
      "start": 16524.0,
      "end": 16528.0,
      "formatted_start": "04:35:24.000",
      "formatted_end": "04:35:28.000",
      "text": "و دیگه میخوای که خودتون استخونتون قریب شد"
    },
    {
      "id": 14,
      "start": 16528.0,
      "end": 16530.0,
      "formatted_start": "04:35:28.000",
      "formatted_end": "04:35:30.000",
      "text": "لازم نیزی نار بخورید مدت عذیب کنه"
    },
    {
      "id": 15,
      "start": 16530.0,
      "end": 16532.0,
      "formatted_start": "04:35:30.000",
      "formatted_end": "04:35:32.000",
      "text": "میوه همه ترسن بخورید"
    },
    {
      "id": 16,
      "start": 16532.0,
      "end": 16534.0,
      "formatted_start": "04:35:32.000",
      "formatted_end": "04:35:34.000",
      "text": "صبح به صبح یه کاشوک پود سنجل خود"
    },
    {
      "id": 17,
      "start": 16534.0,
      "end": 16536.0,
      "formatted_start": "04:35:34.000",
      "formatted_end": "04:35:36.000",
      "text": "یه کاشوک پود سنجل"
    },
    {
      "id": 18,
      "start": 16536.0,
      "end": 16538.0,
      "formatted_start": "04:35:36.000",
      "formatted_end": "04:35:38.000",
      "text": "توی یه نصف لیمون شیر بخورید"
    },
    {
      "id": 19,
      "start": 16538.0,
      "end": 16539.0,
      "formatted_start": "04:35:38.000",
      "formatted_end": "04:35:39.000",
      "text": "شیر هست یه نام؟"
    },
    {
      "id": 20,
      "start": 16539.0,
      "end": 16541.0,
      "formatted_start": "04:35:39.000",
      "formatted_end": "04:35:41.000",
      "text": "عذیبتت میکنه خب با اصل بخورید"
    },
    {
      "id": 21,
      "start": 16541.0,
      "end": 16543.0,
      "formatted_start": "04:35:41.000",
      "formatted_end": "04:35:43.000",
      "text": "اشکال نداره با آب بخورید"
    },
    {
      "id": 22,
      "start": 16543.0,
      "end": 16545.0,
      "formatted_start": "04:35:43.000",
      "formatted_end": "04:35:45.000",
      "text": "با اصل یه کاشوک"
    },
    {
      "id": 23,
      "start": 16545.0,
      "end": 16547.0,
      "formatted_start": "04:35:45.000",
      "formatted_end": "04:35:47.000",
      "text": "دیگه اونو در موری بخورید"
    },
    {
      "id": 24,
      "start": 16547.0,
      "end": 16550.0,
      "formatted_start": "04:35:47.000",
      "formatted_end": "04:35:50.000",
      "text": "یه قشوق از هر تو نصف فنجون آب بلند"
    },
    {
      "id": 25,
      "start": 16550.0,
      "end": 16553.0,
      "formatted_start": "04:35:50.000",
      "formatted_end": "04:35:53.000",
      "text": "حتی کن بعد یه قشوق پود سکه تو شرکو سر بکش دیگه"
    },
    {
      "id": 26,
      "start": 16553.0,
      "end": 16555.0,
      "formatted_start": "04:35:53.000",
      "formatted_end": "04:35:55.000",
      "text": "فقط نباو سپونو برده"
    },
    {
      "id": 27,
      "start": 16555.0,
      "end": 16557.0,
      "formatted_start": "04:35:55.000",
      "formatted_end": "04:35:57.000",
      "text": "دخترم مثلا دختر مزاوی هم برده"
    },
    {
      "id": 28,
      "start": 16557.0,
      "end": 16559.0,
      "formatted_start": "04:35:57.000",
      "formatted_end": "04:35:59.000",
      "text": "که از شعوری در بوده بودن"
    },
    {
      "id": 29,
      "start": 16559.0,
      "end": 16561.0,
      "formatted_start": "04:35:59.000",
      "formatted_end": "04:36:01.000",
      "text": "داد امامه رو بی این مون خودم نخوردن"
    },
    {
      "id": 30,
      "start": 16561.0,
      "end": 16564.0,
      "formatted_start": "04:36:01.000",
      "formatted_end": "04:36:04.000",
      "text": "آره خب اونو تو این قرصه چیه؟"
    },
    {
      "id": 31,
      "start": 16564.0,
      "end": 16565.0,
      "formatted_start": "04:36:04.000",
      "formatted_end": "04:36:05.000",
      "text": "همین هست دیگه"
    },
    {
      "id": 32,
      "start": 16565.0,
      "end": 16566.0,
      "formatted_start": "04:36:05.000",
      "formatted_end": "04:36:06.000",
      "text": "آره واقعا"
    },
    {
      "id": 33,
      "start": 16566.0,
      "end": 16568.0,
      "formatted_start": "04:36:06.000",
      "formatted_end": "04:36:08.000",
      "text": "سلامت برسنه"
    },
    {
      "id": 34,
      "start": 16568.0,
      "end": 16569.0,
      "formatted_start": "04:36:08.000",
      "formatted_end": "04:36:09.000",
      "text": "سلامت برسنه"
    },
    {
      "id": 35,
      "start": 16569.0,
      "end": 16571.0,
      "formatted_start": "04:36:09.000",
      "formatted_end": "04:36:11.000",
      "text": "با ورخی یادی بدهن"
    },
    {
      "id": 36,
      "start": 16571.0,
      "end": 16573.0,
      "formatted_start": "04:36:11.000",
      "formatted_end": "04:36:13.000",
      "text": "خواهش بودن سلامت داشتید خدا بود"
    },
    {
      "id": 37,
      "start": 16573.0,
      "end": 16575.0,
      "formatted_start": "04:36:13.000",
      "formatted_end": "04:36:15.000",
      "text": "بیرون نشون بده دارید"
    },
    {
      "id": 38,
      "start": 16575.0,
      "end": 16577.0,
      "formatted_start": "04:36:15.000",
      "formatted_end": "04:36:17.000",
      "text": "آره خواهم شما فروی چک کنه"
    },
    {
      "id": 39,
      "start": 16581.0,
      "end": 16583.0,
      "formatted_start": "04:36:21.000",
      "formatted_end": "04:36:23.000",
      "text": "ست سن ۶۵ ماشت"
    },
    {
      "id": 40,
      "start": 16583.0,
      "end": 16585.0,
      "formatted_start": "04:36:23.000",
      "formatted_end": "04:36:25.000",
      "text": "میگه دوباره دارید هم ببینیم هسته نوشت"
    },
    {
      "id": 41,
      "start": 16585.0,
      "end": 16587.0,
      "formatted_start": "04:36:25.000",
      "formatted_end": "04:36:27.000",
      "text": "ست سن رو دوباره میپرستیم میگه"
    },
    {
      "id": 42,
      "start": 16587.0,
      "end": 16589.0,
      "formatted_start": "04:36:27.000",
      "formatted_end": "04:36:29.000",
      "text": "آره"
    },
    {
      "id": 43,
      "start": 16593.0,
      "end": 16595.0,
      "formatted_start": "04:36:33.000",
      "formatted_end": "04:36:35.000",
      "text": "اونو توی اون رو ماهیم آمدن"
    },
    {
      "id": 44,
      "start": 16595.0,
      "end": 16597.0,
      "formatted_start": "04:36:35.000",
      "formatted_end": "04:36:37.000",
      "text": "این راستی"
    },
    {
      "id": 45,
      "start": 16597.0,
      "end": 16627.0,
      "formatted_start": "04:36:37.000",
      "formatted_end": "04:37:07.000",
      "text": "اینجا که اینجا که اینجا که اینجا که اینجا که اینجا که اینجا که اینجا که اینجا که اینجا که اینجا که اینجا که اینجا که اینجا که اینجا که اینجا که اینجا که اینجا که اینجا که اینجا که اینجا که اینجا که اینجا که اینجا که اینجا که اینجا که اینجا که اینجا که اینجا که اینجا که اینجا که اینجا که اینجا که اینجا که اینجا که اینجا که اینجا که ا"
    },
