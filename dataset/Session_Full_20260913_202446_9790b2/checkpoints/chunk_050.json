      "formatted_end": "04:10:06.000",
      "text": "سیب مرد صبح زمر، رو کاغذ نگشتن براش."
    },
    {
      "id": 1,
      "start": 15006.0,
      "end": 15010.0,
      "formatted_start": "04:10:06.000",
      "formatted_end": "04:10:10.000",
      "text": "کارم گلچی، بیا."
    },
    {
      "id": 2,
      "start": 15010.0,
      "end": 15014.0,
      "formatted_start": "04:10:10.000",
      "formatted_end": "04:10:14.000",
      "text": "مرد صبح زمر، کارم گلچی، بیا."
    },
    {
      "id": 3,
      "start": 15014.0,
      "end": 15018.0,
      "formatted_start": "04:10:14.000",
      "formatted_end": "04:10:18.000",
      "text": "سیب مرد صبح زمر، رو کاغذ نگشتن براش."
    },
    {
      "id": 4,
      "start": 15018.0,
      "end": 15022.0,
      "formatted_start": "04:10:18.000",
      "formatted_end": "04:10:22.000",
      "text": "شفت شفت، جانم، جانم."
    },
    {
      "id": 5,
      "start": 15022.0,
      "end": 15026.0,
      "formatted_start": "04:10:22.000",
      "formatted_end": "04:10:26.000",
      "text": "ماشکیشونه؟"
    },
    {
      "id": 6,
      "start": 15026.0,
      "end": 15028.0,
      "formatted_start": "04:10:26.000",
      "formatted_end": "04:10:28.000",
      "text": "این که باید بردارید"
    },
    {
      "id": 7,
      "start": 15028.0,
      "end": 15030.0,
      "formatted_start": "04:10:28.000",
