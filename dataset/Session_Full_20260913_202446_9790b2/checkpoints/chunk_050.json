      "id": 82,
      "start": 15270.76,
      "end": 15272.76,
      "formatted_start": "04:14:30.760",
      "formatted_end": "04:14:32.760",
      "text": "الان برزی به من اینها داره که الان همینو"
    },
    {
      "id": 83,
      "start": 15272.76,
      "end": 15274.76,
      "formatted_start": "04:14:32.760",
      "formatted_end": "04:14:34.760",
      "text": "الان خب می دهید اینو با باگو جن تازه مخوره"
    },
    {
      "id": 84,
      "start": 15274.76,
      "end": 15276.76,
      "formatted_start": "04:14:34.760",
      "formatted_end": "04:14:36.760",
      "text": "خب اونو که می کنه دیگه نه باگو جن مخوره"
    },
    {
      "id": 85,
      "start": 15276.76,
      "end": 15278.76,
      "formatted_start": "04:14:36.760",
      "formatted_end": "04:14:38.760",
      "text": "الان همین در این مرسا داره باشه"
    },
