  "stt_segments": [
    {
      "id": 0,
      "start": 10800.0,
      "end": 10830.0,
      "formatted_start": "03:00:00.000",
      "formatted_end": "03:00:30.000",
      "text": "باید بردارید که باید بردارید که باید بردارید که باید بردارید که باید بردارید که باید بردارید که باید بردارید که باید بردارید که باید بردارید که باید بردارید که باید بردارید که باید بردارید که باید بردارید که باید بردارید که باید بردارید که باید بردارید که باید بردارید که باید بردارید که باید برد"
    },
    {
      "id": 1,
      "start": 10830.0,
      "end": 10832.0,
      "formatted_start": "03:00:30.000",
      "formatted_end": "03:00:32.000",
      "text": "باید برمونت بگو"
    },
    {
      "id": 2,
      "start": 10832.0,
      "end": 10834.0,
      "formatted_start": "03:00:32.000",
      "formatted_end": "03:00:34.000",
      "text": "با پنج شب همه آمده هم بری بخواهم بیام کنیم"
    },
    {
      "id": 3,
      "start": 10834.0,
      "end": 10836.0,
      "formatted_start": "03:00:34.000",
      "formatted_end": "03:00:36.000",
      "text": "برخی بچه تنگم خیلی باقی همه هسته"
    },
    {
      "id": 4,
      "start": 10838.0,
      "end": 10840.0,
      "formatted_start": "03:00:38.000",
      "formatted_end": "03:00:40.000",
      "text": "این نگاه چون خیلی وقت بیدن برخوردم"
    },
    {
      "id": 5,
      "start": 10840.0,
      "end": 10842.0,
      "formatted_start": "03:00:40.000",
      "formatted_end": "03:00:42.000",
      "text": "از چهار شبیه گرفتم"
    },
    {
      "id": 6,
      "start": 10842.0,
      "end": 10844.0,
      "formatted_start": "03:00:42.000",
      "formatted_end": "03:00:44.000",
      "text": "نگاه رو بانه"
    },
    {
      "id": 7,
      "start": 10844.0,
      "end": 10846.0,
      "formatted_start": "03:00:44.000",
      "formatted_end": "03:00:46.000",
      "text": "لاشتا رو بانه نهاشان"
    },
    {
      "id": 8,
      "start": 10846.0,
      "end": 10848.0,
      "formatted_start": "03:00:46.000",
      "formatted_end": "03:00:48.000",
      "text": "چهار شبیه پنج شبیه جمعه"
    },
    {
      "id": 9,
      "start": 10848.0,
      "end": 10850.0,
      "formatted_start": "03:00:48.000",
      "formatted_end": "03:00:50.000",
      "text": "اینم برای اندوزه"
    },
    {
      "id": 10,
      "start": 10850.0,
      "end": 10852.0,
      "formatted_start": "03:00:50.000",
      "formatted_end": "03:00:52.000",
      "text": "سه شب تویش وقت نمیدونی؟"
    },
    {
      "id": 11,
      "start": 10852.0,
      "end": 10854.0,
      "formatted_start": "03:00:52.000",
      "formatted_end": "03:00:54.000",
      "text": "سه نصف شب"
    },
    {
      "id": 12,
      "start": 10854.0,
      "end": 10856.0,
      "formatted_start": "03:00:54.000",
      "formatted_end": "03:00:56.000",
      "text": "نصف شب رو صرف نمیکنی؟ خوابه بعد نمیدی؟"
    },
    {
      "id": 13,
      "start": 10856.0,
      "end": 10858.0,
      "formatted_start": "03:00:56.000",
      "formatted_end": "03:00:58.000",
      "text": "اگر برده میبینی؟ نه"
    },
    {
      "id": 14,
      "start": 10858.0,
      "end": 10860.0,
      "formatted_start": "03:00:58.000",
      "formatted_end": "03:01:00.000",
      "text": "پرده نیست؟ نه"
    },
    {
      "id": 15,
      "start": 10860.0,
      "end": 10862.0,
      "formatted_start": "03:01:00.000",
      "formatted_end": "03:01:02.000",
      "text": "اگر افتقان میبینی؟ نه"
    },
    {
      "id": 16,
      "start": 10862.0,
      "end": 10864.0,
      "formatted_start": "03:01:02.000",
      "formatted_end": "03:01:04.000",
      "text": "من افتقان هم دارم"
    },
    {
      "id": 17,
      "start": 10864.0,
      "end": 10868.0,
      "formatted_start": "03:01:04.000",
      "formatted_end": "03:01:08.000",
      "text": "خیلی وقتی اینطوری نشدم که بخواهم"
    },
    {
      "id": 18,
      "start": 10868.0,
      "end": 10872.0,
      "formatted_start": "03:01:08.000",
      "formatted_end": "03:01:12.000",
      "text": "ولی اگر بخواهم افتقان کنم"
    },
    {
      "id": 19,
      "start": 10872.0,
      "end": 10875.0,
      "formatted_start": "03:01:12.000",
      "formatted_end": "03:01:15.000",
      "text": "یاد روی مثلا 70-60 منسه"
    },
    {
      "id": 20,
      "start": 10875.0,
      "end": 10877.0,
      "formatted_start": "03:01:15.000",
      "formatted_end": "03:01:17.000",
      "text": "که متوجه میشم ولم میشم"
    },
    {
      "id": 21,
      "start": 10877.0,
      "end": 10880.0,
      "formatted_start": "03:01:17.000",
      "formatted_end": "03:01:20.000",
      "text": "کم وقتی که یا اینجوری میشید؟ نصف شب؟"
    },
    {
      "id": 22,
      "start": 10880.0,
      "end": 10882.0,
      "formatted_start": "03:01:20.000",
      "formatted_end": "03:01:22.000",
      "text": "نصف شب هم شده شدم"
    },
    {
      "id": 23,
      "start": 10882.0,
      "end": 10883.0,
      "formatted_start": "03:01:22.000",
      "formatted_end": "03:01:23.000",
      "text": "روز هم شدم"
    },
    {
      "id": 24,
      "start": 10883.0,
      "end": 10885.0,
      "formatted_start": "03:01:23.000",
      "formatted_end": "03:01:25.000",
      "text": "خب پس همیشه نیست؟ نه"
    },
    {
      "id": 25,
      "start": 10885.0,
      "end": 10887.0,
      "formatted_start": "03:01:25.000",
      "formatted_end": "03:01:27.000",
      "text": "او ناشتاکو میگه خیلی باداست"
    },
    {
      "id": 26,
      "start": 10887.0,
      "end": 10888.0,
      "formatted_start": "03:01:27.000",
      "formatted_end": "03:01:28.000",
      "text": "ایچی"
    },
    {
      "id": 27,
      "start": 10888.0,
      "end": 10890.0,
      "formatted_start": "03:01:28.000",
      "formatted_end": "03:01:30.000",
      "text": "برای شب دردارتو استفاده می کنیم بگیمه"
    },
    {
      "id": 28,
      "start": 10890.0,
      "end": 10892.0,
      "formatted_start": "03:01:30.000",
      "formatted_end": "03:01:32.000",
      "text": "یا آبانست"
    },
    {
      "id": 29,
      "start": 10896.0,
      "end": 10898.0,
      "formatted_start": "03:01:36.000",
      "formatted_end": "03:01:38.000",
      "text": "اونو اینو کورسه که صبح و شب میکنم"
    },
    {
      "id": 30,
      "start": 10905.0,
      "end": 10909.0,
      "formatted_start": "03:01:45.000",
      "formatted_end": "03:01:49.000",
      "text": "درکه صبح و شب همین بیستا"
    },
    {
      "id": 31,
      "start": 10909.0,
      "end": 10911.0,
      "formatted_start": "03:01:49.000",
      "formatted_end": "03:01:51.000",
      "text": "ولی 18 تا زدم"
    },
    {
      "id": 32,
      "start": 10911.0,
      "end": 10913.0,
      "formatted_start": "03:01:51.000",
      "formatted_end": "03:01:53.000",
      "text": "همون قدرت را برداریم"
    },
    {
      "id": 33,
      "start": 10913.0,
      "end": 10915.0,
      "formatted_start": "03:01:53.000",
      "formatted_end": "03:01:55.000",
      "text": "همون قدرت را برداریم"
    },
    {
      "id": 34,
      "start": 10915.0,
      "end": 10917.0,
      "formatted_start": "03:01:55.000",
      "formatted_end": "03:01:57.000",
      "text": "همون قدرت را برداریم"
    },
    {
      "id": 35,
      "start": 10917.0,
      "end": 10919.0,
      "formatted_start": "03:01:57.000",
      "formatted_end": "03:01:59.000",
      "text": "همون قدرت را برداریم"
    },
    {
      "id": 36,
      "start": 10919.0,
      "end": 10921.0,
      "formatted_start": "03:01:59.000",
      "formatted_end": "03:02:01.000",
      "text": "چرا کامل نداریم؟"
    },
    {
      "id": 37,
      "start": 10921.0,
      "end": 10923.0,
      "formatted_start": "03:02:01.000",
      "formatted_end": "03:02:03.000",
      "text": "نمیدونیم"
    },
    {
      "id": 38,
      "start": 10923.0,
      "end": 10925.0,
      "formatted_start": "03:02:03.000",
      "formatted_end": "03:02:05.000",
      "text": "درست دارم"
    },
    {
      "id": 39,
      "start": 10925.0,
      "end": 10927.0,
      "formatted_start": "03:02:05.000",
      "formatted_end": "03:02:07.000",
      "text": "درست دارم"
    },
    {
      "id": 40,
      "start": 10927.0,
      "end": 10929.0,
      "formatted_start": "03:02:07.000",
      "formatted_end": "03:02:09.000",
      "text": "درست دارم"
    },
    {
      "id": 41,
      "start": 10929.0,
      "end": 10931.0,
      "formatted_start": "03:02:09.000",
      "formatted_end": "03:02:11.000",
      "text": "درست دارم"
    },
    {
      "id": 42,
      "start": 10931.0,
      "end": 10933.0,
      "formatted_start": "03:02:11.000",
      "formatted_end": "03:02:13.000",
      "text": "درست دارم"
    },
    {
      "id": 43,
      "start": 10933.0,
      "end": 10935.0,
      "formatted_start": "03:02:13.000",
      "formatted_end": "03:02:15.000",
      "text": "درست دارم"
    },
    {
      "id": 44,
      "start": 10935.0,
      "end": 10937.0,
      "formatted_start": "03:02:15.000",
      "formatted_end": "03:02:17.000",
      "text": "درست دارم"
    },
    {
      "id": 45,
      "start": 10937.0,
      "end": 10939.0,
      "formatted_start": "03:02:17.000",
      "formatted_end": "03:02:19.000",
      "text": "درست دارم"
    },
    {
      "id": 46,
      "start": 10939.0,
      "end": 10943.0,
      "formatted_start": "03:02:19.000",
      "formatted_end": "03:02:23.000",
      "text": "بگو که کامپوسالی قیمت چیه؟"
    },
    {
      "id": 47,
      "start": 10943.0,
      "end": 10945.0,
      "formatted_start": "03:02:23.000",
      "formatted_end": "03:02:25.000",
      "text": "قیمت خرامزنی"
    },
    {
      "id": 48,
      "start": 10945.0,
      "end": 10946.0,
      "formatted_start": "03:02:25.000",
      "formatted_end": "03:02:26.000",
      "text": "تقمیلی نداری نه؟"
    },
    {
      "id": 49,
      "start": 10946.0,
      "end": 10947.0,
      "formatted_start": "03:02:26.000",
      "formatted_end": "03:02:27.000",
      "text": "دارم تقمیلی"
    },
    {
      "id": 50,
      "start": 10947.0,
      "end": 10948.0,
      "formatted_start": "03:02:27.000",
      "formatted_end": "03:02:28.000",
      "text": "چیه تقمیلی؟"
    },
    {
      "id": 51,
      "start": 10948.0,
      "end": 10949.0,
      "formatted_start": "03:02:28.000",
      "formatted_end": "03:02:29.000",
      "text": "آتیسرگانه"
    },
    {
      "id": 52,
      "start": 10949.0,
      "end": 10951.0,
      "formatted_start": "03:02:29.000",
      "formatted_end": "03:02:31.000",
      "text": "میتونی بستری بشی"
    },
    {
      "id": 53,
      "start": 10951.0,
      "end": 10953.0,
      "formatted_start": "03:02:31.000",
      "formatted_end": "03:02:33.000",
      "text": "پندت باید تنظیم بشی"
    },
    {
      "id": 54,
      "start": 10953.0,
      "end": 10955.0,
      "formatted_start": "03:02:33.000",
      "formatted_end": "03:02:35.000",
      "text": "پندت خیلی اقتضاری"
    },
    {
      "id": 55,
      "start": 10955.0,
      "end": 10957.0,
      "formatted_start": "03:02:35.000",
      "formatted_end": "03:02:37.000",
      "text": "یعنی ۵۶ تا توجه زدن"
    },
    {
      "id": 56,
      "start": 10957.0,
      "end": 10959.0,
      "formatted_start": "03:02:37.000",
      "formatted_end": "03:02:39.000",
      "text": "هیچ توجیهی نداره"
    },
    {
      "id": 57,
      "start": 10959.0,
      "end": 10962.0,
      "formatted_start": "03:02:39.000",
      "formatted_end": "03:02:42.000",
      "text": "بعد خیلی یه رفعه کمش کنم"
    },
    {
      "id": 58,
      "start": 10962.0,
      "end": 10965.0,
      "formatted_start": "03:02:42.000",
      "formatted_end": "03:02:45.000",
      "text": "شاید اصلا با کم کردن اینجا تا خوب بشی"
    },
    {
      "id": 59,
      "start": 10965.0,
      "end": 10972.0,
      "formatted_start": "03:02:45.000",
      "formatted_end": "03:02:52.000",
      "text": "این حد اکثری که توستی میتونه جزد کنه 30 تا 35 شویشتر از اون بگه فائده نمیدونه"
    },
    {
      "id": 60,
      "start": 10972.0,
      "end": 10975.0,
      "formatted_start": "03:02:52.000",
      "formatted_end": "03:02:55.000",
      "text": "بعد فرصه کلوری پا کلوری اونتو هم میخوردی؟"
    },
    {
      "id": 61,
      "start": 10975.0,
      "end": 10978.0,
      "formatted_start": "03:02:55.000",
      "formatted_end": "03:02:58.000",
      "text": "نه همینو میخورم خورشم"
    },
    {
      "id": 62,
      "start": 10984.0,
      "end": 10989.0,
      "formatted_start": "03:03:04.000",
      "formatted_end": "03:03:09.000",
      "text": "برای دستگی به همچنان فردا جایی میکنیم بگیم"
    },
    {
      "id": 63,
      "start": 10989.0,
      "end": 10993.0,
      "formatted_start": "03:03:09.000",
      "formatted_end": "03:03:13.000",
      "text": "دو شنبه شنبه بیام"
    },
    {
      "id": 64,
      "start": 10993.0,
      "end": 10995.0,
      "formatted_start": "03:03:13.000",
      "formatted_end": "03:03:15.000",
      "text": "هفته دیگه شنبه"
    },
    {
      "id": 65,
      "start": 10995.0,
      "end": 10997.0,
      "formatted_start": "03:03:15.000",
      "formatted_end": "03:03:17.000",
      "text": "شنبه که تحتیل دو شنبه هفته بیام"
    },
    {
      "id": 66,
      "start": 10997.0,
      "end": 10999.0,
      "formatted_start": "03:03:17.000",
      "formatted_end": "03:03:19.000",
      "text": "چون دو سه روز بیشتر نیست که"
    },
    {
      "id": 67,
      "start": 10999.0,
      "end": 11001.0,
      "formatted_start": "03:03:19.000",
      "formatted_end": "03:03:21.000",
      "text": "تو دو روز معملاً هم نتنسیب بدم"
    },
    {
      "id": 68,
      "start": 11001.0,
      "end": 11003.0,
      "formatted_start": "03:03:21.000",
      "formatted_end": "03:03:23.000",
      "text": "که بخوای مردم بیام"
    },
    {
      "id": 69,
      "start": 11003.0,
      "end": 11005.0,
      "formatted_start": "03:03:23.000",
      "formatted_end": "03:03:25.000",
      "text": "چون میرم من گنبه برزونم"
    },
    {
      "id": 70,
      "start": 11005.0,
      "end": 11007.0,
      "formatted_start": "03:03:25.000",
      "formatted_end": "03:03:27.000",
      "text": "و بعد باید"
    },
    {
      "id": 71,
      "start": 11007.0,
      "end": 11009.0,
      "formatted_start": "03:03:27.000",
      "formatted_end": "03:03:29.000",
      "text": "دیگه تقنیم داشتیم چون باید داریم"
    },
    {
      "id": 72,
      "start": 11009.0,
      "end": 11011.0,
      "formatted_start": "03:03:29.000",
      "formatted_end": "03:03:31.000",
      "text": "مکسیس ها سازان هم نداریم"
    },
    {
      "id": 73,
      "start": 11011.0,
      "end": 11013.0,
      "formatted_start": "03:03:31.000",
      "formatted_end": "03:03:33.000",
      "text": "حالا اینجا آفاندوتو من دیدم"
    },
    {
      "id": 74,
      "start": 11013.0,
      "end": 11015.0,
      "formatted_start": "03:03:33.000",
      "formatted_end": "03:03:35.000",
      "text": "این چیزم داشتم اونو پد کردم"
    },
    {
      "id": 75,
      "start": 11015.0,
      "end": 11018.0,
      "formatted_start": "03:03:35.000",
      "formatted_end": "03:03:38.000",
      "text": "ببینم که این الان میشه یا نه"
    },
    {
      "id": 76,
      "start": 11018.0,
      "end": 11021.0,
      "formatted_start": "03:03:38.000",
      "formatted_end": "03:03:41.000",
      "text": "هم میدونم آتیر برداد و اشکل مریض رو بسیار شده"
    },
    {
      "id": 77,
      "start": 11021.0,
      "end": 11024.0,
      "formatted_start": "03:03:41.000",
      "formatted_end": "03:03:44.000",
      "text": "بعد چیزی همیشه دو روزه فقط کاری هم نباشه"
    },
    {
      "id": 78,
      "start": 11024.0,
      "end": 11026.0,
      "formatted_start": "03:03:44.000",
      "formatted_end": "03:03:46.000",
      "text": "که پندران خواهیم بیادن"
    },
    {
      "id": 79,
      "start": 11026.0,
      "end": 11029.0,
      "formatted_start": "03:03:46.000",
      "formatted_end": "03:03:49.000",
      "text": "آره بعد برای این بدر به شما نمیخوره"
    },
    {
      "id": 80,
      "start": 11029.0,
      "end": 11032.0,
      "formatted_start": "03:03:49.000",
      "formatted_end": "03:03:52.000",
      "text": "چون فردار از حالاتی با افراد فریز نفرد"
    },
    {
      "id": 81,
      "start": 11032.0,
      "end": 11035.0,
      "formatted_start": "03:03:52.000",
      "formatted_end": "03:03:55.000",
      "text": "تو از طور اینجوری یا این زنه این بدر بیادی"
    },
    {
      "id": 82,
      "start": 11035.0,
      "end": 11036.0,
      "formatted_start": "03:03:55.000",
      "formatted_end": "03:03:56.000",
      "text": "بعد هامدکتر همه نیست"
    },
    {
      "id": 83,
      "start": 11036.0,
      "end": 11040.0,
      "formatted_start": "03:03:56.000",
      "formatted_end": "03:04:00.000",
      "text": "با خودی لعبتی کم هموزدتو بیاده پایین؟"
    },
    {
      "id": 84,
      "start": 11040.0,
      "end": 11045.0,
      "formatted_start": "03:04:00.000",
      "formatted_end": "03:04:05.000",
      "text": "بخوام در دوره یه سطح دیگه، اما تقریبا در بیس روزی نمیشه"
    },
    {
      "id": 85,
      "start": 11045.0,
      "end": 11049.0,
      "formatted_start": "03:04:05.000",
      "formatted_end": "03:04:09.000",
      "text": "تکی تکی بدنم، پشت بدنم درد میخوام"
    },
    {
      "id": 86,
      "start": 11049.0,
      "end": 11051.0,
      "formatted_start": "03:04:09.000",
      "formatted_end": "03:04:11.000",
      "text": "آره دیگه، من در هر میگم دیگه"
    },
    {
      "id": 87,
      "start": 11051.0,
      "end": 11055.0,
      "formatted_start": "03:04:11.000",
      "formatted_end": "03:04:15.000",
      "text": "چون وقتی اینو هم رو با هر سویزه، اطولات بدنم که مزیده میبه"
    },
    {
      "id": 88,
      "start": 11055.0,
      "end": 11059.0,
      "formatted_start": "03:04:15.000",
      "formatted_end": "03:04:19.000",
