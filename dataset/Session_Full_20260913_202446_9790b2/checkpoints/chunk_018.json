      "formatted_start": "01:30:06.000",
      "formatted_end": "01:30:08.000",
      "text": "از اینجا باید برداریم."
    },
    {
      "id": 4,
      "start": 5408.0,
      "end": 5410.0,
      "formatted_start": "01:30:08.000",
      "formatted_end": "01:30:10.000",
      "text": "از اینجا باید برداریم."
    },
    {
      "id": 5,
      "start": 5410.0,
      "end": 5412.0,
      "formatted_start": "01:30:10.000",
      "formatted_end": "01:30:12.000",
      "text": "سلام جان."
    },
    {
      "id": 6,
      "start": 5412.0,
      "end": 5414.0,
      "formatted_start": "01:30:12.000",
      "formatted_end": "01:30:14.000",
      "text": "سلام جانم."
    },
    {
      "id": 7,
      "start": 5414.0,
      "end": 5416.0,
      "formatted_start": "01:30:14.000",
      "formatted_end": "01:30:16.000",
      "text": "خوبه. خیلی خوبه دیشون."
    },
    {
      "id": 8,
      "start": 5416.0,
      "end": 5418.0,
      "formatted_start": "01:30:16.000",
      "formatted_end": "01:30:18.000",
      "text": "خوبه. خیلی خوبه دیشون."
    },
    {
      "id": 9,
      "start": 5418.0,
      "end": 5420.0,
      "formatted_start": "01:30:18.000",
      "formatted_end": "01:30:20.000",
      "text": "خوبه. خیلی خوبه دیشون."
    },
    {
      "id": 10,
      "start": 5420.0,
      "end": 5422.0,
      "formatted_start": "01:30:20.000",
      "formatted_end": "01:30:22.000",
      "text": "خوبه. خیلی خوبه دیشون."
    },
    {
      "id": 11,
      "start": 5422.0,
      "end": 5424.0,
      "formatted_start": "01:30:22.000",
      "formatted_end": "01:30:24.000",
      "text": "خوبه. خیلی خوبه دیشون."
    },
    {
      "id": 12,
      "start": 5424.0,
      "end": 5426.0,
      "formatted_start": "01:30:24.000",
      "formatted_end": "01:30:26.000",
      "text": "خوبه. خیلی خوبه دیشون."
    },
    {
      "id": 13,
      "start": 5426.0,
      "end": 5434.0,
      "formatted_start": "01:30:26.000",
      "formatted_end": "01:30:34.000",
      "text": "حالا بخواهم شبهای موقعی که بخواد بره دوباره برای برق زنگ بزنم میگم آنم بره یه نگاه بزنم"
    },
    {
      "id": 14,
      "start": 5434.0,
      "end": 5436.0,
      "formatted_start": "01:30:34.000",
      "formatted_end": "01:30:36.000",
      "text": "حالا نه بود و رفته و بازدید"
    },
    {
      "id": 15,
      "start": 5436.0,
      "end": 5443.0,
      "formatted_start": "01:30:36.000",
      "formatted_end": "01:30:43.000",
      "text": "از جلسه اومد رفته و بازدید و طبیعی بدیدید کسی که بود و بازدید نیست متظرانه"
    },
    {
      "id": 16,
      "start": 5443.0,
      "end": 5445.0,
      "formatted_start": "01:30:43.000",
      "formatted_end": "01:30:45.000",
      "text": "اوکی خدا نگهده"
    },
    {
      "id": 17,
      "start": 5445.0,
      "end": 5450.0,
      "formatted_start": "01:30:45.000",
      "formatted_end": "01:30:50.000",
      "text": "الان رفت رفت و حضوری نیستی رفت و بازدید همه"
    },
    {
      "id": 18,
      "start": 5450.0,
      "end": 5451.0,
      "formatted_start": "01:30:50.000",
      "formatted_end": "01:30:51.000",
      "text": "مشکلاتی"
    },
    {
      "id": 19,
      "start": 5451.0,
      "end": 5457.46,
      "formatted_start": "01:30:51.000",
      "formatted_end": "01:30:57.460",
      "text": "من که موارد مدیر دستگاه دارم داریم خب معموله من هم دوی خورد و خورد دارم میگم از صد به بالا نیست خب"
    },
    {
      "id": 20,
      "start": 5457.46,
      "end": 5461.96,
      "formatted_start": "01:30:57.460",
      "formatted_end": "01:31:01.960",
      "text": "من تا اگه اینجا گرفتم دکتر گمپت امام رو به اعتماد داره که این کیس سردانی باشه خب"
    },
    {
      "id": 21,
      "start": 5461.96,
      "end": 5464.14,
      "formatted_start": "01:31:01.960",
      "formatted_end": "01:31:04.140",
      "text": "من از اون مورد خیلی سلسون ترش دارم شده"
    },
    {
      "id": 22,
      "start": 5464.14,
      "end": 5465.3,
      "formatted_start": "01:31:04.140",
      "formatted_end": "01:31:05.300",
      "text": "چند وقت به؟"
    },
    {
      "id": 23,
      "start": 5465.3,
      "end": 5469.24,
      "formatted_start": "01:31:05.300",
      "formatted_end": "01:31:09.240",
      "text": "الان همین یک مورد که دارم میرم گوردانو میگم دکتور بر همین منو گوردانو معرفی کردم"
    },
    {
      "id": 24,
      "start": 5469.24,
      "end": 5476.24,
      "formatted_start": "01:31:09.240",
      "formatted_end": "01:31:16.240",
      "text": "از این باشه دیابتی دیگه"
    },
    {
      "id": 25,
      "start": 5476.24,
      "end": 5480.24,
      "formatted_start": "01:31:16.240",
      "formatted_end": "01:31:20.240",
      "text": "پس باشه این شکلات مشابه درسته نان نخوری"
    },
    {
      "id": 26,
      "start": 5480.24,
      "end": 5484.24,
      "formatted_start": "01:31:20.240",
      "formatted_end": "01:31:24.240",
      "text": "اینو میخوام بهت بگم قند سماحت بالاست"
    },
    {
      "id": 27,
      "start": 5484.24,
      "end": 5487.24,
      "formatted_start": "01:31:24.240",
      "formatted_end": "01:31:27.240",
      "text": "این قدرتی قند لاشتات که الان هشته درستم"
    },
    {
      "id": 28,
      "start": 5487.24,
      "end": 5489.24,
      "formatted_start": "01:31:27.240",
      "formatted_end": "01:31:29.240",
      "text": "پایین هستم پایین کلونه باشه"
    },
    {
      "id": 29,
      "start": 5489.24,
      "end": 5492.24,
      "formatted_start": "01:31:29.240",
      "formatted_end": "01:31:32.240",
      "text": "اما قند سماحت بالاست یعنی متوسطه"
    },
    {
      "id": 30,
      "start": 5492.24,
      "end": 5497.24,
      "formatted_start": "01:31:32.240",
      "formatted_end": "01:31:37.240",
      "text": "قند شما در سماه گذشته میانگین داره میگه"
    },
    {
      "id": 31,
      "start": 5497.24,
      "end": 5501.24,
      "formatted_start": "01:31:37.240",
      "formatted_end": "01:31:41.240",
      "text": "بالاتر از دویسته. بین دویست تا دویست و پنج هست."
    },
    {
      "id": 32,
      "start": 5501.24,
      "end": 5507.24,
      "formatted_start": "01:31:41.240",
      "formatted_end": "01:31:47.240",
      "text": "حالا خیلی نیست که ناشتا یا یه ساعت بعد غذا باشه. ممکنه در یه تایم های قرارتون یه فرم میزنه بالا."
    },
    {
      "id": 33,
      "start": 5507.24,
      "end": 5509.24,
      "formatted_start": "01:31:47.240",
      "formatted_end": "01:31:49.240",
      "text": "بله من باید بیم در این قرار بیدارو سویم."
    },
    {
      "id": 34,
      "start": 5509.24,
      "end": 5515.24,
      "formatted_start": "01:31:49.240",
      "formatted_end": "01:31:55.240",
      "text": "بعد انشالله. برای همین هم اطراف گرفتی بهتون علامت. چون قرارتون یه وقتهایی داره با الان بیدارو."
    },
    {
      "id": 35,
      "start": 5515.24,
      "end": 5517.24,
      "formatted_start": "01:31:55.240",
      "formatted_end": "01:31:57.240",
      "text": "کیست هم هم بیدارو علامت کنو دکتور اصلا."
    },
    {
      "id": 36,
      "start": 5517.24,
      "end": 5522.2,
      "formatted_start": "01:31:57.240",
      "formatted_end": "01:32:02.200",
      "text": "یک دفعه دهده شدید رفتن دوتو و گفتم که چون کیس دو دوری میخوان بردارن ارام دید"
    },
    {
      "id": 37,
      "start": 5522.2,
      "end": 5525.68,
      "formatted_start": "01:32:02.200",
      "formatted_end": "01:32:05.680",
      "text": "کیس تر گمزد، ارام هم هیچ ارامتی ندارن کب"
    },
    {
      "id": 38,
      "start": 5525.68,
      "end": 5529.84,
      "formatted_start": "01:32:05.680",
      "formatted_end": "01:32:09.840",
      "text": "ولی که دکتر گفتی میگم ارام من سرطان دارم، ارام خیلی تفجیل دید"
    },
    {
      "id": 39,
      "start": 5529.84,
      "end": 5531.64,
      "formatted_start": "01:32:09.840",
      "formatted_end": "01:32:11.640",
      "text": "ببین این چیزی میخوام بهتون بگم"
    },
    {
      "id": 40,
      "start": 5531.64,
      "end": 5538.68,
      "formatted_start": "01:32:11.640",
      "formatted_end": "01:32:18.680",
      "text": "اگه سرطان باشه و یا مثلا سرطانی باشه که واقعا سرطانی ممکنه که اون بعدا بعدا بیاین سرطانی میشد"
    },
    {
      "id": 41,
      "start": 5538.68,
      "end": 5548.08,
      "formatted_start": "01:32:18.680",
      "formatted_end": "01:32:28.080",
      "text": "خب، این ممکنه، ولی اگه سرطانی بود که دور از جز سرطان جدی بود و پیش رفت و بدن تا میزن، الان تمام اینه از باشه مختلف"
    },
    {
      "id": 42,
      "start": 5548.08,
      "end": 5557.72,
      "formatted_start": "01:32:28.080",
      "formatted_end": "01:32:37.720",
      "text": "خب، CRP یعنی التحاد در بدن، نرمانه نرمان، یعنی در بدن فعلا هیچ اتقاق نیست"
    },
    {
      "id": 43,
      "start": 5557.72,
      "end": 5561.84,
      "formatted_start": "01:32:37.720",
      "formatted_end": "01:32:41.840",
      "text": "ببینید؟ پس فعلا هیچ چی نیست"
    },
    {
      "id": 44,
      "start": 5561.84,
      "end": 5567.12,
      "formatted_start": "01:32:41.840",
      "formatted_end": "01:32:47.120",
      "text": "و اونم که بهت گفته که سرطان منتوش این بوده که باید برداری"
    },
    {
      "id": 45,
      "start": 5567.12,
      "end": 5569.54,
      "formatted_start": "01:32:47.120",
      "formatted_end": "01:32:49.540",
      "text": "چون شاید سرداری بشید"
    },
    {
      "id": 46,
      "start": 5569.54,
      "end": 5571.12,
      "formatted_start": "01:32:49.540",
      "formatted_end": "01:32:51.120",
      "text": "سونا تو بده ببینم"
    },
    {
      "id": 47,
      "start": 5571.12,
      "end": 5573.66,
      "formatted_start": "01:32:51.120",
      "formatted_end": "01:32:53.660",
      "text": "سونا تو بده ببینم سونا که اجان دادی"
    },
    {
      "id": 48,
      "start": 5580.66,
      "end": 5581.72,
      "formatted_start": "01:33:00.660",
      "formatted_end": "01:33:01.720",
      "text": "سونا تو ببینم"
    },
    {
      "id": 49,
      "start": 5581.72,
      "end": 5599.72,
      "formatted_start": "01:33:01.720",
      "formatted_end": "01:33:19.720",
      "text": "این رو باید برداریم کسی رو بفرستیم کالوژی و بعد ما شکل رست بشیم"
    },
    {
      "id": 50,
      "start": 5599.72,
      "end": 5603.22,
      "formatted_start": "01:33:19.720",
      "formatted_end": "01:33:23.220",
      "text": "خب در این حال همینه دیگه"
    },
    {
      "id": 51,
      "start": 5603.22,
      "end": 5606.4,
      "formatted_start": "01:33:23.220",
      "formatted_end": "01:33:26.400",
      "text": "اگر همین حدودی باشه"
    },
    {
      "id": 52,
      "start": 5606.4,
      "end": 5608.36,
      "formatted_start": "01:33:26.400",
      "formatted_end": "01:33:28.360",
      "text": "همونه و تمام"
    },
    {
      "id": 53,
      "start": 5608.36,
      "end": 5613.98,
      "formatted_start": "01:33:28.360",
      "formatted_end": "01:33:33.980",
      "text": "درگیری بدنی نداری دیگه عزیز من"
    },
    {
      "id": 54,
      "start": 5613.98,
      "end": 5616.82,
      "formatted_start": "01:33:33.980",
      "formatted_end": "01:33:36.820",
      "text": "از این ناراحتی نداری"
    },
    {
      "id": 55,
      "start": 5616.82,
      "end": 5621.4,
      "formatted_start": "01:33:36.820",
      "formatted_end": "01:33:41.400",
      "text": "یعنی صد درصد بعد از جرائی دیگه شما هیچ مشکلی نداری"
    },
    {
      "id": 56,
      "start": 5621.4,
      "end": 5622.88,
      "formatted_start": "01:33:41.400",
      "formatted_end": "01:33:42.880",
      "text": "من بهت باد میدم"
    },
    {
      "id": 57,
      "start": 5622.88,
      "end": 5629.02,
      "formatted_start": "01:33:42.880",
      "formatted_end": "01:33:49.020",
      "text": "امروی کردی امروی که شکرمدی هیچی ندیده"
    },
    {
      "id": 58,
      "start": 5629.02,
      "end": 5631.02,
      "formatted_start": "01:33:49.020",
      "formatted_end": "01:33:51.020",
      "text": "بله، اینکه بزرگی است"
    },
    {
      "id": 59,
      "start": 5631.02,
      "end": 5633.02,
      "formatted_start": "01:33:51.020",
      "formatted_end": "01:33:53.020",
      "text": "بله، اینکه بزرگی است"
    },
    {
      "id": 60,
      "start": 5633.02,
      "end": 5635.02,
      "formatted_start": "01:33:53.020",
      "formatted_end": "01:33:55.020",
      "text": "بله، اینکه بزرگی است"
    },
    {
      "id": 61,
      "start": 5635.02,
      "end": 5637.02,
      "formatted_start": "01:33:55.020",
      "formatted_end": "01:33:57.020",
      "text": "بله، اینکه بزرگی است"
    },
    {
      "id": 62,
      "start": 5637.02,
      "end": 5639.02,
      "formatted_start": "01:33:57.020",
      "formatted_end": "01:33:59.020",
      "text": "بله، اینکه بزرگی است"
    },
    {
      "id": 63,
      "start": 5639.02,
      "end": 5641.02,
      "formatted_start": "01:33:59.020",
      "formatted_end": "01:34:01.020",
      "text": "بله، اینکه بزرگی است"
    },
    {
      "id": 64,
      "start": 5641.02,
      "end": 5643.02,
      "formatted_start": "01:34:01.020",
      "formatted_end": "01:34:03.020",
      "text": "بله، اینکه بزرگی است"
    },
    {
      "id": 65,
      "start": 5643.02,
      "end": 5645.02,
      "formatted_start": "01:34:03.020",
      "formatted_end": "01:34:05.020",
      "text": "بله، اینکه بزرگی است"
    },
    {
      "id": 66,
      "start": 5645.02,
      "end": 5647.02,
      "formatted_start": "01:34:05.020",
      "formatted_end": "01:34:07.020",
      "text": "بله، اینکه بزرگی است"
    },
    {
      "id": 67,
      "start": 5647.02,
      "end": 5649.02,
      "formatted_start": "01:34:07.020",
      "formatted_end": "01:34:09.020",
      "text": "بله، اینکه بزرگی است"
    },
    {
      "id": 68,
      "start": 5649.02,
      "end": 5651.02,
      "formatted_start": "01:34:09.020",
      "formatted_end": "01:34:11.020",
      "text": "بله، اینکه بزرگی است"
    },
    {
      "id": 69,
      "start": 5651.02,
      "end": 5653.02,
      "formatted_start": "01:34:11.020",
      "formatted_end": "01:34:13.020",
      "text": "بله، اینکه بزرگی است"
    },
    {
      "id": 70,
      "start": 5653.02,
      "end": 5655.02,
      "formatted_start": "01:34:13.020",
      "formatted_end": "01:34:15.020",
      "text": "بله، اینکه بزرگی است"
    },
    {
      "id": 71,
      "start": 5655.02,
      "end": 5657.02,
      "formatted_start": "01:34:15.020",
      "formatted_end": "01:34:17.020",
      "text": "بله، اینکه بزرگی است"
    },
    {
      "id": 72,
      "start": 5657.02,
      "end": 5662.4,
      "formatted_start": "01:34:17.020",
      "formatted_end": "01:34:22.400",
      "text": "آخه ببین برد خیلی سرطان اسمش بده خب ما برد خیلی چیزا داریم دیگه"
    },
    {
      "id": 73,
      "start": 5662.4,
      "end": 5665.54,
      "formatted_start": "01:34:22.400",
      "formatted_end": "01:34:25.540",
      "text": "وقتی که هیچ جای بدن ترگه نیست"
    },
    {
      "id": 74,
      "start": 5665.54,
      "end": 5668.84,
      "formatted_start": "01:34:25.540",
      "formatted_end": "01:34:28.840",
      "text": "من نظر دارم نه خونتی نه خون ریزی نه"
    },
    {
      "id": 75,
      "start": 5668.84,
      "end": 5670.54,
      "formatted_start": "01:34:28.840",
      "formatted_end": "01:34:30.540",
      "text": "وقتی که ما برای چی چکاپ بینیم سیم"
    },
    {
      "id": 76,
      "start": 5670.54,
      "end": 5672.38,
      "formatted_start": "01:34:30.540",
      "formatted_end": "01:34:32.380",
      "text": "وقتی کبت آزماش طبیعیه"
    },
    {
      "id": 77,
      "start": 5672.38,
      "end": 5673.7,
      "formatted_start": "01:34:32.380",
      "formatted_end": "01:34:33.700",
      "text": "یعنی کبت درگه نیست"
    },
    {
      "id": 78,
      "start": 5673.7,
      "end": 5676.2,
      "formatted_start": "01:34:33.700",
      "formatted_end": "01:34:36.200",
      "text": "وقتی افونت تو بدن نداریم"
    },
    {
      "id": 79,
      "start": 5676.2,
      "end": 5678.86,
      "formatted_start": "01:34:36.200",
      "formatted_end": "01:34:38.860",
      "text": "یعنی که هیچ جا بدن ما در حال جهنمیست"
    },
    {
      "id": 80,
      "start": 5678.86,
      "end": 5679.94,
      "formatted_start": "01:34:38.860",
      "formatted_end": "01:34:39.940",
      "text": "تمام آره بردید"
    },
    {
      "id": 81,
      "start": 5679.94,
      "end": 5680.68,
      "formatted_start": "01:34:39.940",
      "formatted_end": "01:34:40.680",
      "text": "بردون بردون"
    },
    {
      "id": 82,
      "start": 5680.68,
      "end": 5682.68,
      "formatted_start": "01:34:40.680",
      "formatted_end": "01:34:42.680",
      "text": "بیا بیا"
    },
    {
      "id": 83,
      "start": 5682.68,
      "end": 5684.68,
      "formatted_start": "01:34:42.680",
      "formatted_end": "01:34:44.680",
      "text": "من هم چون سه پسید کنم دو تونه پرست همینه"
    },
    {
      "id": 84,
      "start": 5684.68,
      "end": 5686.68,
      "formatted_start": "01:34:44.680",
      "formatted_end": "01:34:46.680",
      "text": "اصلا جرده پاکم به آدیم"
    },
    {
      "id": 85,
      "start": 5686.68,
      "end": 5688.68,
      "formatted_start": "01:34:46.680",
      "formatted_end": "01:34:48.680",
      "text": "اون هم اصلا جرده جهنمی سمیدی نیست"
    },
    {
      "id": 86,
      "start": 5688.68,
      "end": 5690.68,
      "formatted_start": "01:34:48.680",
      "formatted_end": "01:34:50.680",
      "text": "این بیتامین ده است"
    },
    {
      "id": 87,
      "start": 5690.68,
      "end": 5692.68,
      "formatted_start": "01:34:50.680",
      "formatted_end": "01:34:52.680",
      "text": "بعدش برای برم بریم آن پول رو"
    },
    {
      "id": 88,
      "start": 5692.68,
      "end": 5694.68,
      "formatted_start": "01:34:52.680",
      "formatted_end": "01:34:54.680",
      "text": "رضا فرد کنیم"
    },
    {
      "id": 89,
      "start": 5694.68,
      "end": 5696.68,
      "formatted_start": "01:34:54.680",
      "formatted_end": "01:34:56.680",
      "text": "خوب سه چند"
    },
    {
      "id": 90,
      "start": 5696.68,
      "end": 5698.68,
      "formatted_start": "01:34:56.680",
      "formatted_end": "01:34:58.680",
      "text": "آره هشتا"
    }
  ],
  "status": "completed"
}