  "stt_segments": [
    {
      "id": 0,
      "start": 9900.0,
      "end": 9902.0,
      "formatted_start": "02:45:00.000",
      "formatted_end": "02:45:02.000",
      "text": "از اینجا باید بخشید که در این مطب پزشکی هست."
    },
    {
      "id": 1,
      "start": 9905.0,
      "end": 9907.0,
      "formatted_start": "02:45:05.000",
      "formatted_end": "02:45:07.000",
      "text": "این و این آزمایشی."
    },
    {
      "id": 2,
      "start": 9912.0,
      "end": 9914.0,
      "formatted_start": "02:45:12.000",
      "formatted_end": "02:45:14.000",
      "text": "آزمایش خیلی بیچرده."
    },
    {
      "id": 3,
      "start": 9915.0,
      "end": 9919.0,
      "formatted_start": "02:45:15.000",
      "formatted_end": "02:45:19.000",
      "text": "در بخواسته چرده زیاد، اصلا جدای کسی صفرا زخیم شده."
    },
    {
      "id": 4,
      "start": 9920.0,
      "end": 9922.0,
      "formatted_start": "02:45:20.000",
      "formatted_end": "02:45:22.000",
      "text": "میخواید اگر با درد داشته باشه، آیزای دارو میدن."
    },
    {
      "id": 5,
      "start": 9922.0,
      "end": 9924.0,
      "formatted_start": "02:45:22.000",
      "formatted_end": "02:45:24.000",
      "text": "سوستم آردیا چک میخوایم، آردیا سمی کنم."
    },
    {
      "id": 6,
      "start": 9925.0,
      "end": 9928.0,
      "formatted_start": "02:45:25.000",
      "formatted_end": "02:45:28.000",
      "text": "و اینجاش بود که درد می کنه، سوستم میخوایم نخواهد هر نیمه."
    },
    {
      "id": 7,
      "start": 9928.0,
      "end": 9930.0,
      "formatted_start": "02:45:28.000",
      "formatted_end": "02:45:30.000",
      "text": "این روحان رو باید حس بکنید"
    },
    {
      "id": 8,
      "start": 9930.0,
      "end": 9932.0,
      "formatted_start": "02:45:30.000",
      "formatted_end": "02:45:32.000",
      "text": "این روحان رو باید حس بکنید"
    },
    {
      "id": 9,
      "start": 9932.0,
      "end": 9934.0,
      "formatted_start": "02:45:32.000",
      "formatted_end": "02:45:34.000",
      "text": "این روحان رو باید حس بکنید"
    },
    {
      "id": 10,
      "start": 9934.0,
      "end": 9936.0,
      "formatted_start": "02:45:34.000",
      "formatted_end": "02:45:36.000",
      "text": "این روحان رو باید حس بکنید"
    },
    {
      "id": 11,
      "start": 9936.0,
      "end": 9938.0,
      "formatted_start": "02:45:36.000",
      "formatted_end": "02:45:38.000",
      "text": "این روحان رو باید حس بکنید"
    },
    {
      "id": 12,
      "start": 9938.0,
      "end": 9940.0,
      "formatted_start": "02:45:38.000",
      "formatted_end": "02:45:40.000",
      "text": "این روحان رو باید حس بکنید"
    },
    {
      "id": 13,
      "start": 9940.0,
      "end": 9942.0,
      "formatted_start": "02:45:40.000",
      "formatted_end": "02:45:42.000",
      "text": "این روحان رو باید حس بکنید"
    },
    {
      "id": 14,
      "start": 9942.0,
      "end": 9944.0,
      "formatted_start": "02:45:42.000",
      "formatted_end": "02:45:44.000",
      "text": "این روحان رو باید حس بکنید"
    },
    {
      "id": 15,
      "start": 9944.0,
      "end": 9946.0,
      "formatted_start": "02:45:44.000",
      "formatted_end": "02:45:46.000",
      "text": "این روحان رو باید حس بکنید"
    },
    {
      "id": 16,
      "start": 9946.0,
      "end": 9948.0,
      "formatted_start": "02:45:46.000",
      "formatted_end": "02:45:48.000",
      "text": "این روحان رو باید حس بکنید"
    },
    {
      "id": 17,
      "start": 9948.0,
      "end": 9950.0,
      "formatted_start": "02:45:48.000",
      "formatted_end": "02:45:50.000",
      "text": "این ها اینه"
    },
    {
      "id": 18,
      "start": 9950.0,
      "end": 9952.0,
      "formatted_start": "02:45:50.000",
      "formatted_end": "02:45:52.000",
      "text": "این ها اینه"
    },
    {
      "id": 19,
      "start": 9952.0,
      "end": 9954.0,
      "formatted_start": "02:45:52.000",
      "formatted_end": "02:45:54.000",
      "text": "این که نداریم"
    },
    {
      "id": 20,
      "start": 9954.0,
      "end": 9956.0,
      "formatted_start": "02:45:54.000",
      "formatted_end": "02:45:56.000",
      "text": "این ها تیویدشونه"
    },
    {
      "id": 21,
      "start": 9956.0,
      "end": 9958.0,
      "formatted_start": "02:45:56.000",
      "formatted_end": "02:45:58.000",
      "text": "این چیه؟"
    },
    {
      "id": 22,
      "start": 9958.0,
      "end": 9960.0,
      "formatted_start": "02:45:58.000",
      "formatted_end": "02:46:00.000",
      "text": "کامبرو سرلا آی جی این"
    },
    {
      "id": 23,
      "start": 9960.0,
      "end": 9962.0,
      "formatted_start": "02:46:00.000",
      "formatted_end": "02:46:02.000",
      "text": "این همه اسپل برداریم"
    },
    {
      "id": 24,
      "start": 9962.0,
      "end": 9964.0,
      "formatted_start": "02:46:02.000",
      "formatted_end": "02:46:04.000",
      "text": "این ها که نشان زیاده اینه"
    },
    {
      "id": 25,
      "start": 9964.0,
      "end": 9966.0,
      "formatted_start": "02:46:04.000",
      "formatted_end": "02:46:06.000",
      "text": "آره تا"
    },
    {
      "id": 26,
      "start": 9966.0,
      "end": 9970.0,
      "formatted_start": "02:46:06.000",
      "formatted_end": "02:46:10.000",
      "text": "آزمایش فردا سر با جانوسی کنه"
    },
    {
      "id": 27,
      "start": 9970.0,
      "end": 9972.0,
      "formatted_start": "02:46:10.000",
      "formatted_end": "02:46:12.000",
      "text": "آره تا کلن جاوش هم میتونم فردا بزنم"
    },
    {
      "id": 28,
      "start": 9972.0,
      "end": 9974.0,
      "formatted_start": "02:46:12.000",
      "formatted_end": "02:46:14.000",
      "text": "گرمشتر بزنم"
    },
    {
      "id": 29,
      "start": 9974.0,
      "end": 9976.0,
      "formatted_start": "02:46:14.000",
      "formatted_end": "02:46:16.000",
      "text": "آره دیگه"
    },
    {
      "id": 30,
      "start": 9976.0,
      "end": 9978.0,
      "formatted_start": "02:46:16.000",
      "formatted_end": "02:46:18.000",
      "text": "چون از اینکه بزیر کردن"
    },
    {
      "id": 31,
      "start": 9978.0,
      "end": 9980.0,
      "formatted_start": "02:46:18.000",
      "formatted_end": "02:46:20.000",
      "text": "خب آرز ها خونش قریضه"
    },
    {
      "id": 32,
      "start": 9980.0,
      "end": 9982.0,
      "formatted_start": "02:46:20.000",
      "formatted_end": "02:46:22.000",
      "text": "انماب خوبه براش"
    },
    {
      "id": 33,
      "start": 9982.0,
      "end": 9984.0,
      "formatted_start": "02:46:22.000",
