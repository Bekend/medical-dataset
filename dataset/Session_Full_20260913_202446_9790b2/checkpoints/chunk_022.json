  "stt_segments": [
    {
      "id": 0,
      "start": 6600.0,
      "end": 6629.98,
      "formatted_start": "01:50:00.000",
      "formatted_end": "01:50:29.980",
      "text": "از این حالت، بیمار بیمار در مطب پزشکی، داروها، آزمایش و نسخه."
    },
    {
      "id": 1,
      "start": 6630.0,
      "end": 6632.68,
      "formatted_start": "01:50:30.000",
      "formatted_end": "01:50:32.680",
      "text": "بعد این سوال هم بهت بشوند. محل کارشون بست."
    },
    {
      "id": 2,
      "start": 6632.68,
      "end": 6634.68,
      "formatted_start": "01:50:32.680",
      "formatted_end": "01:50:34.680",
      "text": "دیده اون لاشان هم با اوکناش..."
    },
    {
      "id": 3,
      "start": 6634.68,
      "end": 6640.68,
      "formatted_start": "01:50:34.680",
      "formatted_end": "01:50:40.680",
      "text": "حسن شما میدونید بهش میروند. خودش هم دورت رو مستعد دارید. دیارت خیلی جنگی دارید."
    },
    {
      "id": 4,
      "start": 6640.68,
      "end": 6644.68,
      "formatted_start": "01:50:40.680",
      "formatted_end": "01:50:44.680",
      "text": "هرکی بهش میده این لحظه... میدونید."
    },
    {
      "id": 5,
      "start": 6644.68,
      "end": 6649.68,
      "formatted_start": "01:50:44.680",
      "formatted_end": "01:50:49.680",
      "text": "شما من موضوع خوراشید. چشم داریم."
    },
    {
      "id": 6,
      "start": 6649.68,
      "end": 6651.68,
      "formatted_start": "01:50:49.680",
      "formatted_end": "01:50:51.680",
      "text": "و..."
    },
    {
      "id": 7,
      "start": 6651.68,
      "end": 6653.68,
      "formatted_start": "01:50:51.680",
      "formatted_end": "01:50:53.680",
      "text": "سیده هایی تو که استفاده میدونید."
    },
    {
      "id": 8,
      "start": 6653.68,
      "end": 6655.68,
      "formatted_start": "01:50:53.680",
      "formatted_end": "01:50:55.680",
      "text": "نه."
    },
    {
      "id": 9,
      "start": 6655.68,
      "end": 6659.68,
      "formatted_start": "01:50:55.680",
      "formatted_end": "01:50:59.680",
      "text": "انشاله اینها رو که باید کنید انشاله که عوضتون خوب میشن."
    },
    {
      "id": 10,
      "start": 6659.68,
      "end": 6661.68,
      "formatted_start": "01:50:59.680",
      "formatted_end": "01:51:01.680",
      "text": "با ستیروید داریم؟"
    },
    {
      "id": 11,
      "start": 6661.68,
      "end": 6663.68,
      "formatted_start": "01:51:01.680",
      "formatted_end": "01:51:03.680",
      "text": "بله"
    },
    {
      "id": 12,
      "start": 6663.68,
      "end": 6665.68,
      "formatted_start": "01:51:03.680",
      "formatted_end": "01:51:05.680",
      "text": "خوب"
    },
    {
      "id": 13,
      "start": 6665.68,
      "end": 6667.68,
      "formatted_start": "01:51:05.680",
      "formatted_end": "01:51:07.680",
      "text": "تسخانه سایت ها کلن همون ستیره"
    },
    {
      "id": 14,
      "start": 6667.68,
      "end": 6669.68,
      "formatted_start": "01:51:07.680",
      "formatted_end": "01:51:09.680",
      "text": "از شده کنید"
    },
    {
      "id": 15,
      "start": 6669.68,
      "end": 6671.68,
      "formatted_start": "01:51:09.680",
      "formatted_end": "01:51:11.680",
      "text": "باید باید بردن"
    },
    {
      "id": 16,
      "start": 6671.68,
      "end": 6673.68,
      "formatted_start": "01:51:11.680",
      "formatted_end": "01:51:13.680",
      "text": "خواهدتون تماس میدونید"
    },
    {
      "id": 17,
      "start": 6673.68,
      "end": 6675.68,
      "formatted_start": "01:51:13.680",
      "formatted_end": "01:51:15.680",
      "text": "بعد که رفتون ندادن"
    },
    {
      "id": 18,
      "start": 6675.68,
      "end": 6677.68,
      "formatted_start": "01:51:15.680",
      "formatted_end": "01:51:17.680",
      "text": "فردا نیم پیش آقای سالانی"
    },
    {
      "id": 19,
      "start": 6677.68,
      "end": 6679.68,
      "formatted_start": "01:51:17.680",
      "formatted_end": "01:51:19.680",
      "text": "در درساتا هست دلایت اینو ازدواره"
    },
    {
      "id": 20,
      "start": 6679.68,
      "end": 6681.68,
      "formatted_start": "01:51:19.680",
      "formatted_end": "01:51:21.680",
      "text": "بعد اون خودش میگه این نسخه"
    },
    {
      "id": 21,
      "start": 6681.68,
      "end": 6683.68,
      "formatted_start": "01:51:21.680",
      "formatted_end": "01:51:23.680",
      "text": "میکرده را گریم دارونشی نشده"
    },
    {
      "id": 22,
      "start": 6683.68,
      "end": 6685.68,
      "formatted_start": "01:51:23.680",
      "formatted_end": "01:51:25.680",
      "text": "بعد اونا یه برگه میدن"
    },
    {
      "id": 23,
      "start": 6685.68,
      "end": 6687.68,
      "formatted_start": "01:51:25.680",
      "formatted_end": "01:51:27.680",
      "text": "برگه که میدن میای اینجا ما دارون"
    },
    {
      "id": 24,
      "start": 6687.68,
      "end": 6689.68,
      "formatted_start": "01:51:27.680",
      "formatted_end": "01:51:29.680",
      "text": "اگر باید بردارو بشید، باید بشید بشید"
    },
    {
      "id": 25,
      "start": 6689.68,
      "end": 6691.68,
      "formatted_start": "01:51:29.680",
      "formatted_end": "01:51:31.680",
      "text": "و داروتون بشید"
    },
    {
      "id": 26,
      "start": 6691.68,
      "end": 6693.68,
      "formatted_start": "01:51:31.680",
      "formatted_end": "01:51:33.680",
      "text": "فعالا تا روزی که"
    },
    {
      "id": 27,
      "start": 6693.68,
      "end": 6696.88,
      "formatted_start": "01:51:33.680",
      "formatted_end": "01:51:36.880",
      "text": "روی همون داروتون استفاده کنید تا برونده درست باشید"
    },
    {
      "id": 28,
      "start": 6696.88,
      "end": 6698.88,
      "formatted_start": "01:51:36.880",
      "formatted_end": "01:51:38.880",
      "text": "شماره تماس میفرمایید؟"
    },
    {
      "id": 29,
      "start": 6698.88,
      "end": 6703.88,
      "formatted_start": "01:51:38.880",
      "formatted_end": "01:51:43.880",
      "text": "512-377-67-81"
    },
    {
      "id": 30,
      "start": 6703.88,
      "end": 6705.88,
      "formatted_start": "01:51:43.880",
      "formatted_end": "01:51:45.880",
      "text": "تقریبا شما"
    },
    {
      "id": 31,
      "start": 6705.88,
      "end": 6707.88,
      "formatted_start": "01:51:45.880",
      "formatted_end": "01:51:47.880",
      "text": "سلامت باشید"
    },
