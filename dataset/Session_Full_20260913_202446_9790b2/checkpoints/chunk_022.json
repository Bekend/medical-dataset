      "end": 6713.88,
      "formatted_start": "01:51:51.880",
      "formatted_end": "01:51:53.880",
      "text": "شنبلیله"
    },
    {
      "id": 35,
      "start": 6713.88,
      "end": 6715.88,
      "formatted_start": "01:51:53.880",
      "formatted_end": "01:51:55.880",
      "text": "گزنه بامیه"
    },
    {
      "id": 36,
      "start": 6715.88,
      "end": 6717.88,
      "formatted_start": "01:51:55.880",
      "formatted_end": "01:51:57.880",
      "text": "بامیه دارچی"
    },
    {
      "id": 37,
      "start": 6717.88,
      "end": 6719.88,
      "formatted_start": "01:51:57.880",
      "formatted_end": "01:51:59.880",
      "text": "نه برونده باشید"
    },
    {
      "id": 38,
      "start": 6719.88,
      "end": 6721.88,
      "formatted_start": "01:51:59.880",
      "formatted_end": "01:52:01.880",
      "text": "سلامت باشید"
    },
    {
      "id": 39,
      "start": 6721.88,
      "end": 6725.88,
      "formatted_start": "01:52:01.880",
      "formatted_end": "01:52:05.880",
      "text": "اولا دارو خونه بگیرید و اینجوری هست"
    },
    {
      "id": 40,
      "start": 6725.88,
      "end": 6729.88,
      "formatted_start": "01:52:05.880",
      "formatted_end": "01:52:09.880",
      "text": "اگر دارو خونه بگیرید، اینجوری هست که من دارو آزاد نمیخواهم"
    },
    {
      "id": 41,
      "start": 6729.88,
      "end": 6733.88,
      "formatted_start": "01:52:09.880",
      "formatted_end": "01:52:13.880",
      "text": "اگر اینکه من کاری مزخگاهاتی درست کردم، اگر دارو خونه بگیرید"
    },
    {
      "id": 42,
      "start": 6733.88,
      "end": 6737.88,
      "formatted_start": "01:52:13.880",
      "formatted_end": "01:52:17.880",
