  "stt_segments": [
    {
      "id": 0,
      "start": 23700.0,
      "end": 23702.0,
      "formatted_start": "06:35:00.000",
      "formatted_end": "06:35:02.000",
      "text": "از اینجا باید بردارید."
    },
    {
      "id": 1,
      "start": 23730.0,
      "end": 23734.0,
      "formatted_start": "06:35:30.000",
      "formatted_end": "06:35:34.000",
      "text": "نه جمعه طبعی او را بالا از خوارش میده"
    },
    {
      "id": 2,
      "start": 23734.0,
      "end": 23738.0,
      "formatted_start": "06:35:34.000",
      "formatted_end": "06:35:38.000",
      "text": "در خاطر همین مریض نرسوی پالی است دیگه"
    },
    {
      "id": 3,
      "start": 23738.0,
      "end": 23742.0,
      "formatted_start": "06:35:38.000",
      "formatted_end": "06:35:42.000",
      "text": "پالی او را بالا میده خوارش میده"
    },
    {
      "id": 4,
      "start": 23760.0,
      "end": 23762.0,
      "formatted_start": "06:36:00.000",
      "formatted_end": "06:36:02.000",
      "text": "اینو بگیره پیدا نمی کنم"
    },
    {
      "id": 5,
      "start": 23762.0,
      "end": 23764.0,
      "formatted_start": "06:36:02.000",
      "formatted_end": "06:36:04.000",
      "text": "همینو بگیرم بگیرم"
    },
    {
      "id": 6,
      "start": 23764.0,
      "end": 23766.0,
      "formatted_start": "06:36:04.000",
      "formatted_end": "06:36:06.000",
      "text": "چه گفتی؟"
    },
    {
      "id": 7,
      "start": 23766.0,
      "end": 23768.0,
      "formatted_start": "06:36:06.000",
      "formatted_end": "06:36:08.000",
      "text": "برام جانتویی ای کنم"
    },
    {
      "id": 8,
      "start": 23768.0,
      "end": 23770.0,
      "formatted_start": "06:36:08.000",
      "formatted_end": "06:36:10.000",
      "text": "روکتونو بیشتری نویده و هشتگه شد"
    },
    {
      "id": 9,
      "start": 23770.0,
      "end": 23772.0,
      "formatted_start": "06:36:10.000",
      "formatted_end": "06:36:12.000",
      "text": "شد"
    },
    {
      "id": 10,
      "start": 23772.0,
      "end": 23774.0,
      "formatted_start": "06:36:12.000",
      "formatted_end": "06:36:14.000",
      "text": "ای دوباره منو نوزگویم"
    },
    {
      "id": 11,
      "start": 23774.0,
      "end": 23776.0,
      "formatted_start": "06:36:14.000",
      "formatted_end": "06:36:16.000",
      "text": "نفرات بگیرم"
    },
    {
      "id": 12,
      "start": 23776.0,
      "end": 23778.0,
      "formatted_start": "06:36:16.000",
      "formatted_end": "06:36:18.000",
      "text": "تو ماما میگذره بیدار"
    },
    {
      "id": 13,
      "start": 23778.0,
      "end": 23780.0,
      "formatted_start": "06:36:18.000",
      "formatted_end": "06:36:20.000",
      "text": "نوزده بیشتری"
    },
    {
      "id": 14,
      "start": 23780.0,
      "end": 23782.0,
      "formatted_start": "06:36:20.000",
      "formatted_end": "06:36:22.000",
      "text": "خود نوزده و شد"
    },
    {
      "id": 15,
      "start": 23782.0,
      "end": 23784.0,
      "formatted_start": "06:36:22.000",
      "formatted_end": "06:36:24.000",
      "text": "شد و سه"
    },
    {
      "id": 16,
      "start": 23784.0,
      "end": 23786.0,
      "formatted_start": "06:36:24.000",
      "formatted_end": "06:36:26.000",
      "text": "بیدید"
    },
    {
      "id": 17,
      "start": 23786.0,
      "end": 23788.0,
      "formatted_start": "06:36:26.000",
      "formatted_end": "06:36:28.000",
      "text": "بیدید"
    },
    {
      "id": 18,
      "start": 23788.0,
      "end": 23818.0,
      "formatted_start": "06:36:28.000",
      "formatted_end": "06:36:58.000",
      "text": "از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه ا"
    },
    {
      "id": 19,
      "start": 23818.0,
      "end": 23820.0,
      "formatted_start": "06:36:58.000",
      "formatted_end": "06:37:00.000",
      "text": "بعد روی نانوشب زوری فیده کردم"
    },
    {
      "id": 20,
      "start": 23820.0,
      "end": 23822.0,
      "formatted_start": "06:37:00.000",
      "formatted_end": "06:37:02.000",
      "text": "رفتم داروگانو فیده کردم"
    },
    {
      "id": 21,
      "start": 23830.0,
      "end": 23832.0,
      "formatted_start": "06:37:10.000",
      "formatted_end": "06:37:12.000",
      "text": "سه هر ماه خوردم خانمون"
    },
    {
      "id": 22,
      "start": 23832.0,
      "end": 23834.0,
      "formatted_start": "06:37:12.000",
      "formatted_end": "06:37:14.000",
      "text": "شاهاتون برای همین بالاست؟"
    },
    {
      "id": 23,
      "start": 23834.0,
      "end": 23836.0,
      "formatted_start": "06:37:14.000",
      "formatted_end": "06:37:16.000",
      "text": "آره اعتمادان برای همین بالای هم وقتی بندم"
    },
    {
      "id": 24,
      "start": 23836.0,
      "end": 23841.0,
      "formatted_start": "06:37:16.000",
      "formatted_end": "06:37:21.000",
      "text": "هیچ وقت من به اون برام سینوزیت نه بوده"
    },
    {
      "id": 25,
      "start": 23841.0,
      "end": 23844.0,
      "formatted_start": "06:37:21.000",
      "formatted_end": "06:37:24.000",
      "text": "جلو باده کلور پنکر بوده نیست داری؟"
    },
    {
      "id": 26,
      "start": 23844.0,
      "end": 23845.0,
      "formatted_start": "06:37:24.000",
      "formatted_end": "06:37:25.000",
      "text": "نه"
    },
    {
      "id": 27,
      "start": 23845.0,
      "end": 23850.0,
      "formatted_start": "06:37:25.000",
      "formatted_end": "06:37:30.000",
      "text": "اون هفته دامقان بودم، امشب رفتم با پشت ما هم خوابیدم"
    },
    {
      "id": 28,
      "start": 23850.0,
      "end": 23858.0,
      "formatted_start": "06:37:30.000",
      "formatted_end": "06:37:38.000",
      "text": "دو سه شب خوابیدم، این شب آخری رسید که دیگه"
    },
    {
      "id": 29,
      "start": 23858.0,
      "end": 23862.0,
      "formatted_start": "06:37:38.000",
      "formatted_end": "06:37:42.000",
      "text": "هر چرمیخ شما حدیق قلبی؟"
    },
    {
      "id": 30,
      "start": 23862.0,
      "end": 23864.0,
      "formatted_start": "06:37:42.000",
      "formatted_end": "06:37:44.000",
      "text": "الحمدلله"
    },
    {
      "id": 31,
      "start": 23864.0,
      "end": 23867.0,
      "formatted_start": "06:37:44.000",
      "formatted_end": "06:37:47.000",
      "text": "آم؟ یا آم؟"
    },
    {
      "id": 32,
      "start": 23867.0,
      "end": 23870.0,
      "formatted_start": "06:37:47.000",
      "formatted_end": "06:37:50.000",
      "text": "چه روزا که این موضوع گره بچه بیداشتی؟"
    },
    {
      "id": 33,
      "start": 23870.0,
      "end": 23873.0,
      "formatted_start": "06:37:50.000",
      "formatted_end": "06:37:53.000",
      "text": "احتمالا، من همین سرمو خود دیگه هم شده"
    },
    {
      "id": 34,
      "start": 23873.0,
      "end": 23875.0,
      "formatted_start": "06:37:53.000",
      "formatted_end": "06:37:55.000",
      "text": "خودتون کنیم؟"
    },
    {
      "id": 35,
      "start": 23875.0,
      "end": 23879.0,
      "formatted_start": "06:37:55.000",
      "formatted_end": "06:37:59.000",
      "text": "خیلی نکی کسی نفردن بشه دارم"
    },
    {
      "id": 36,
      "start": 23879.0,
      "end": 23881.0,
      "formatted_start": "06:37:59.000",
      "formatted_end": "06:38:01.000",
      "text": "آدمتون نه همینو میگرد"
    },
    {
      "id": 37,
      "start": 23881.0,
      "end": 23883.0,
      "formatted_start": "06:38:01.000",
      "formatted_end": "06:38:03.000",
      "text": "بینا خودتون نمیکنیم؟"
    },
    {
      "id": 38,
      "start": 23883.0,
      "end": 23885.0,
      "formatted_start": "06:38:03.000",
      "formatted_end": "06:38:05.000",
      "text": "نه گفتم"
    },
    {
      "id": 39,
      "start": 23885.0,
      "end": 23887.0,
      "formatted_start": "06:38:05.000",
      "formatted_end": "06:38:07.000",
      "text": "ازشون بپرسید خب"
    },
    {
      "id": 40,
      "start": 23887.0,
      "end": 23889.0,
      "formatted_start": "06:38:07.000",
      "formatted_end": "06:38:09.000",
      "text": "خیلی مهمه"
    },
    {
      "id": 41,
      "start": 23889.0,
      "end": 23891.0,
      "formatted_start": "06:38:09.000",
      "formatted_end": "06:38:11.000",
      "text": "شاید بخواهد بازتون باشه"
    },
    {
      "id": 42,
      "start": 23891.0,
      "end": 23893.0,
      "formatted_start": "06:38:11.000",
      "formatted_end": "06:38:13.000",
      "text": "خوش تحلیل با تون خیلی تویم میگن"
    },
    {
      "id": 43,
      "start": 23893.0,
      "end": 23895.0,
      "formatted_start": "06:38:13.000",
      "formatted_end": "06:38:15.000",
      "text": "خواهید از یک نمیشه نه؟"
    },
    {
      "id": 44,
      "start": 23895.0,
      "end": 23897.0,
      "formatted_start": "06:38:15.000",
      "formatted_end": "06:38:17.000",
      "text": "نه"
    },
    {
      "id": 45,
      "start": 23897.0,
      "end": 23899.0,
      "formatted_start": "06:38:17.000",
      "formatted_end": "06:38:19.000",
      "text": "سرتونو برای نماسه هیچ نمیگید؟ سنگی نه؟"
    },
    {
      "id": 46,
      "start": 23899.0,
      "end": 23901.0,
      "formatted_start": "06:38:19.000",
      "formatted_end": "06:38:21.000",
      "text": "الان میشه درد میکنه خانم دکتور"
    },
    {
      "id": 47,
      "start": 23901.0,
      "end": 23903.0,
      "formatted_start": "06:38:21.000",
      "formatted_end": "06:38:23.000",
      "text": "خانم شبایی گفت بعد از اون"
    },
    {
      "id": 48,
      "start": 23903.0,
      "end": 23905.0,
      "formatted_start": "06:38:23.000",
      "formatted_end": "06:38:25.000",
      "text": "آره، خیلی شکرم"
    },
    {
      "id": 49,
      "start": 23905.0,
      "end": 23907.0,
      "formatted_start": "06:38:25.000",
      "formatted_end": "06:38:27.000",
      "text": "فقط اینکه بعد کلر تو صورتتون نبخوره باشه؟"
    },
    {
      "id": 50,
      "start": 23907.0,
      "end": 23909.0,
      "formatted_start": "06:38:27.000",
      "formatted_end": "06:38:29.000",
      "text": "نه اصلا میگم ما کلر رو"
    },
    {
      "id": 51,
      "start": 23909.0,
      "end": 23911.0,
      "formatted_start": "06:38:29.000",
      "formatted_end": "06:38:31.000",
      "text": "یه مربطه یه چیز"
    },
    {
      "id": 52,
      "start": 23911.0,
      "end": 23913.0,
      "formatted_start": "06:38:31.000",
      "formatted_end": "06:38:33.000",
      "text": "به صحبت"
    },
    {
      "id": 53,
      "start": 23913.0,
      "end": 23915.0,
      "formatted_start": "06:38:33.000",
      "formatted_end": "06:38:35.000",
      "text": "ساختمان من بزرگه"
    },
    {
      "id": 54,
      "start": 23915.0,
      "end": 23917.0,
      "formatted_start": "06:38:35.000",
      "formatted_end": "06:38:37.000",
      "text": "نظر که صد و پنجه ها"
    },
    {
      "id": 55,
      "start": 23917.0,
      "end": 23919.0,
      "formatted_start": "06:38:37.000",
      "formatted_end": "06:38:39.000",
      "text": "مده ویست متر من تو اتاق خوابم"
    },
    {
      "id": 56,
      "start": 23919.0,
      "end": 23921.0,
      "formatted_start": "06:38:39.000",
      "formatted_end": "06:38:41.000",
      "text": "هیچی ندارم، هم درک بازونم"
    },
    {
      "id": 57,
      "start": 23921.0,
      "end": 23923.0,
      "formatted_start": "06:38:41.000",
      "formatted_end": "06:38:43.000",
      "text": "دو ساعت روشنه، یه ساعت خاموشه"
    },
    {
      "id": 58,
      "start": 23923.0,
      "end": 23925.0,
      "formatted_start": "06:38:43.000",
      "formatted_end": "06:38:45.000",
      "text": "دو ساعت خاموشه، یه ساعت روشنه"
    },
    {
      "id": 59,
      "start": 23925.0,
      "end": 23927.0,
      "formatted_start": "06:38:45.000",
      "formatted_end": "06:38:47.000",
      "text": "آره"
    },
    {
      "id": 60,
      "start": 23927.0,
      "end": 23933.0,
      "formatted_start": "06:38:47.000",
      "formatted_end": "06:38:53.000",
      "text": "نه، نه داره، خواب ما اصلا نه داره"
    },
    {
      "id": 61,
      "start": 23933.0,
      "end": 23936.0,
      "formatted_start": "06:38:53.000",
      "formatted_end": "06:38:56.000",
      "text": "اون شب اصلا نیم نارد نبوده"
    },
    {
      "id": 62,
      "start": 23936.0,
      "end": 23939.0,
      "formatted_start": "06:38:56.000",
      "formatted_end": "06:38:59.000",
      "text": "صبح بنا شما، دفتم یه دوش گرفتم"
    },
    {
      "id": 63,
      "start": 23939.0,
      "end": 23941.0,
      "formatted_start": "06:38:59.000",
      "formatted_end": "06:39:01.000",
      "text": "بخواستم سبب بشم برعکس"
    },
    {
      "id": 64,
      "start": 23941.0,
      "end": 23946.0,
      "formatted_start": "06:39:01.000",
      "formatted_end": "06:39:06.000",
      "text": "نه دوش گرفتن اگه خصوصا کامل سشوار نکنید سهر تونه"
    },
    {
      "id": 65,
      "start": 23946.0,
      "end": 23949.0,
      "formatted_start": "06:39:06.000",
      "formatted_end": "06:39:09.000",
      "text": "نه بخاطر اینکه مو دارا، بخاطر اینکه موشتون ها"
    },
    {
      "id": 66,
      "start": 23949.0,
      "end": 23951.0,
      "formatted_start": "06:39:09.000",
      "formatted_end": "06:39:11.000",
      "text": "یه سشوار کچیک برد بگیرید"
    },
    {
      "id": 67,
      "start": 23951.0,
      "end": 23955.0,
      "formatted_start": "06:39:11.000",
      "formatted_end": "06:39:15.000",
      "text": "نه باید با موی خیست، سر خیست بخوابید"
    },
    {
      "id": 68,
      "start": 23955.0,
      "end": 23960.0,
      "formatted_start": "06:39:15.000",
      "formatted_end": "06:39:20.000",
      "text": "نه خواهیدم صبح اونجا بیدار بودم باز بابوله پیچیده بودم"
    },
    {
      "id": 69,
      "start": 23960.0,
      "end": 23965.0,
      "formatted_start": "06:39:20.000",
      "formatted_end": "06:39:25.000",
      "text": "یک وقتی بابوله پیچیده بودم تا دیگه روستا بودم"
    },
    {
      "id": 70,
      "start": 23965.0,
      "end": 23970.0,
      "formatted_start": "06:39:25.000",
      "formatted_end": "06:39:30.000",
      "text": "که گفتیم شیم ضخم بشیم ضخم نشده اصلا"
    },
    {
      "id": 71,
      "start": 23970.0,
      "end": 23974.0,
      "formatted_start": "06:39:30.000",
      "formatted_end": "06:39:34.000",
      "text": "الان خواهدتو این همه فکر کن چرکیه"
    },
    {
      "id": 72,
      "start": 23974.0,
      "end": 23980.0,
      "formatted_start": "06:39:34.000",
      "formatted_end": "06:39:40.000",
      "text": "پبنیم روی دوتا دبروان بوده الان فقط روی دست راسته"
    },
    {
      "id": 73,
      "start": 23980.0,
      "end": 23982.0,
      "formatted_start": "06:39:40.000",
      "formatted_end": "06:39:42.000",
      "text": "اینجا هم برد داری؟"
    },
    {
      "id": 74,
      "start": 23982.0,
      "end": 23984.0,
      "formatted_start": "06:39:42.000",
      "formatted_end": "06:39:44.000",
      "text": "نه نه نه، اینجا این درد، اینجا اصلا درد نداره"
    },
    {
      "id": 75,
      "start": 23984.0,
      "end": 23986.0,
      "formatted_start": "06:39:44.000",
      "formatted_end": "06:39:46.000",
      "text": "بله، همین میگم همین"
    },
    {
      "id": 76,
      "start": 23986.0,
      "end": 23988.0,
      "formatted_start": "06:39:46.000",
      "formatted_end": "06:39:48.000",
      "text": "آب نزدیکی نداری؟"
    },
    {
      "id": 77,
      "start": 23988.0,
      "end": 23990.0,
      "formatted_start": "06:39:48.000",
      "formatted_end": "06:39:50.000",
      "text": "کم، آره"
    },
    {
      "id": 78,
      "start": 23990.0,
      "end": 23992.0,
      "formatted_start": "06:39:50.000",
      "formatted_end": "06:39:52.000",
      "text": "کم، افرادی"
    },
    {
      "id": 79,
      "start": 23992.0,
      "end": 23996.0,
      "formatted_start": "06:39:52.000",
      "formatted_end": "06:39:56.000",
      "text": "فقط اینکه من برای تون برس سرم و خوردگی و شبهر تا دیوی نجامی نوشتم، خب؟"
    },
    {
      "id": 80,
      "start": 23996.0,
      "end": 23998.0,
      "formatted_start": "06:39:56.000",
      "formatted_end": "06:39:58.000",
      "text": "سه روز استفاده از اینجا برای تون برس سرم و خوردگی و شبهر تا دیوی نجامی نوشتم، خب؟"
    }
  ],
  "status": "completed"
}