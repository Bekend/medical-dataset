      "formatted_start": "07:28:33.760",
      "formatted_end": "07:28:35.760",
      "text": "کدیه که باید چرده سرده بیا"
    },
    {
      "id": 85,
      "start": 26917.76,
      "end": 26918.76,
      "formatted_start": "07:28:37.760",
      "formatted_end": "07:28:38.760",
      "text": "برده؟"
    },
    {
      "id": 86,
      "start": 26918.76,
      "end": 26919.76,
      "formatted_start": "07:28:38.760",
      "formatted_end": "07:28:39.760",
      "text": "کام کدیه؟"
    },
    {
      "id": 87,
      "start": 26919.76,
      "end": 26920.76,
      "formatted_start": "07:28:39.760",
      "formatted_end": "07:28:40.760",
      "text": "کام دوز برده"
    },
    {
      "id": 88,
      "start": 26922.76,
      "end": 26923.76,
      "formatted_start": "07:28:42.760",
      "formatted_end": "07:28:43.760",
      "text": "باید چقدر؟"
    },
    {
      "id": 89,
      "start": 26923.76,
      "end": 26924.76,
      "formatted_start": "07:28:43.760",
      "formatted_end": "07:28:44.760",
      "text": "اونو آزیز..."
    },
    {
      "id": 90,
      "start": 26924.76,
      "end": 26926.76,
      "formatted_start": "07:28:44.760",
      "formatted_end": "07:28:46.760",
      "text": "کدیه فقط اومد"
    },
    {
      "id": 91,
      "start": 26926.76,
      "end": 26928.76,
      "formatted_start": "07:28:46.760",
      "formatted_end": "07:28:48.760",
      "text": "چارتشون رو شون داد دیگه"
    },
    {
      "id": 92,
      "start": 26928.76,
      "end": 26929.76,
      "formatted_start": "07:28:48.760",
      "formatted_end": "07:28:49.760",
      "text": "باشه خواهد رفته"
    },
    {
      "id": 93,
      "start": 26941.76,
      "end": 26943.76,
      "formatted_start": "07:29:01.760",
      "formatted_end": "07:29:03.760",
      "text": "تا هره؟"
    },
    {
      "id": 94,
      "start": 26943.76,
      "end": 26945.76,
      "formatted_start": "07:29:03.760",
      "formatted_end": "07:29:05.760",
      "text": "چون؟"
    },
    {
      "id": 95,
      "start": 26945.76,
      "end": 26947.76,
      "formatted_start": "07:29:05.760",
      "formatted_end": "07:29:07.760",
      "text": "آزادتیجی که فرستادم"
    },
    {
      "id": 96,
      "start": 26947.76,
      "end": 26949.76,
      "formatted_start": "07:29:07.760",
      "formatted_end": "07:29:09.760",
      "text": "خوب"
    },
    {
      "id": 97,
      "start": 26949.76,
      "end": 26951.76,
      "formatted_start": "07:29:09.760",
      "formatted_end": "07:29:11.760",
      "text": "داز خدا رو هم فرستادم"
    },
    {
      "id": 98,
      "start": 26951.76,
      "end": 26953.76,
      "formatted_start": "07:29:11.760",
      "formatted_end": "07:29:13.760",
      "text": "زنبه"
    },
    {
      "id": 99,
      "start": 26953.76,
      "end": 26955.76,
      "formatted_start": "07:29:13.760",
      "formatted_end": "07:29:15.760",
      "text": "تونی رو هم فرستادم"
    },
    {
      "id": 100,
      "start": 26955.76,
      "end": 26957.76,
      "formatted_start": "07:29:15.760",
      "formatted_end": "07:29:17.760",
      "text": "خبرا محمودی"
    },
    {
      "id": 101,
      "start": 26957.76,
      "end": 26959.76,
      "formatted_start": "07:29:17.760",
      "formatted_end": "07:29:19.760",
      "text": "خبرا محمودی"
    },
    {
      "id": 102,
      "start": 26959.76,
      "end": 26961.76,
      "formatted_start": "07:29:19.760",
      "formatted_end": "07:29:21.760",
      "text": "تا موبایلش"
    },
    {
      "id": 103,
      "start": 26961.76,
      "end": 26963.76,
      "formatted_start": "07:29:21.760",
      "formatted_end": "07:29:23.760",
      "text": "که رفتی هست؟"
    },
    {
      "id": 104,
      "start": 26963.76,
      "end": 26965.76,
      "formatted_start": "07:29:23.760",
      "formatted_end": "07:29:25.760",
      "text": "موبایل"
    },
    {
      "id": 105,
      "start": 26965.76,
      "end": 26967.76,
      "formatted_start": "07:29:25.760",
      "formatted_end": "07:29:27.760",
      "text": "چند رو هم چپار کرده"
    },
    {
      "id": 106,
      "start": 26967.76,
      "end": 26969.76,
      "formatted_start": "07:29:27.760",
      "formatted_end": "07:29:29.760",
      "text": "داز یک چی دیگه"
    },
    {
      "id": 107,
      "start": 26969.76,
      "end": 26973.0,
      "formatted_start": "07:29:29.760",
      "formatted_end": "07:29:33.000",
      "text": "الان فردا شب کارم بیرن، گردو نمیتونیم این روز انجام کنیم"
    },
    {
      "id": 108,
      "start": 26973.0,
      "end": 26974.44,
      "formatted_start": "07:29:33.000",
      "formatted_end": "07:29:34.440",
      "text": "الان پیش خانه باده بیرین؟"
    },
    {
      "id": 109,
      "start": 26974.44,
      "end": 26978.64,
      "formatted_start": "07:29:34.440",
      "formatted_end": "07:29:38.640",
      "text": "اه، ارالبخ انجام کرده خواه، فقط گردو مانده که..."
    },
    {
      "id": 110,
      "start": 26978.64,
      "end": 26980.0,
      "formatted_start": "07:29:38.640",
      "formatted_end": "07:29:40.000",
      "text": "آه، برقو ندادن"
    },
    {
      "id": 111,
      "start": 26980.0,
      "end": 26981.8,
      "formatted_start": "07:29:40.000",
      "formatted_end": "07:29:41.800",
      "text": "برقو دادن برقو خواه"
    },
    {
      "id": 112,
      "start": 26981.8,
      "end": 26982.3,
      "formatted_start": "07:29:41.800",
      "formatted_end": "07:29:42.300",
      "text": "خوب"
    },
    {
      "id": 113,
      "start": 26982.3,
      "end": 26987.2,
      "formatted_start": "07:29:42.300",
      "formatted_end": "07:29:47.200",
      "text": "ولی رئیس انجام کرده، گردو باید تاریخی که چی بزنه امور نبوده"
    },
    {
      "id": 114,
      "start": 26987.2,
      "end": 26991.2,
      "formatted_start": "07:29:47.200",
      "formatted_end": "07:29:51.200",
      "text": "سطح روی رستای بارا، الان برم ازش، فردا شب گرم ازش ندارم"
    },
    {
      "id": 115,
      "start": 26991.2,
      "end": 26996.2,
      "formatted_start": "07:29:51.200",
      "formatted_end": "07:29:56.200",
      "text": "برده بگیرم با پسرمون زن میزن و گفت من تعدیه های گرفتم چی کنم"
    },
    {
      "id": 116,
      "start": 26996.2,
      "end": 26997.9,
      "formatted_start": "07:29:56.200",
      "formatted_end": "07:29:57.900",
      "text": "هر چی بدم من بده بدم"
    }
  ],
  "status": "completed"
}