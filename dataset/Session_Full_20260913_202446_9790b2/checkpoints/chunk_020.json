  "stt_segments": [
    {
      "id": 0,
      "start": 6000.0,
      "end": 6005.66,
      "formatted_start": "01:40:00.000",
      "formatted_end": "01:40:05.660",
      "text": "از نقی از صبح نمزنم، که یه اگه بیجا باید توشن، یه دقیقه بعدم پشارم نمی افتاد."
    },
    {
      "id": 1,
      "start": 6005.66,
      "end": 6007.66,
      "formatted_start": "01:40:05.660",
      "formatted_end": "01:40:07.660",
      "text": "بعد خیلی سر رقمشم گرم میشه."
    },
    {
      "id": 2,
      "start": 6007.66,
      "end": 6013.66,
      "formatted_start": "01:40:07.660",
      "formatted_end": "01:40:13.660",
      "text": "نه گرفتم آنجایی داشتم گرفتم دیدم افتخان ۱۱۱۱۱"
    },
    {
      "id": 3,
      "start": 6013.66,
      "end": 6014.66,
      "formatted_start": "01:40:13.660",
      "formatted_end": "01:40:14.660",
      "text": "پایینه دیده؟"
    },
    {
      "id": 4,
      "start": 6014.66,
      "end": 6015.66,
      "formatted_start": "01:40:14.660",
      "formatted_end": "01:40:15.660",
      "text": "نه"
    },
    {
      "id": 5,
      "start": 6015.66,
      "end": 6017.66,
      "formatted_start": "01:40:15.660",
      "formatted_end": "01:40:17.660",
      "text": "بیش ۱۶۰۰ کاری انشاءالله بیشیم"
    },
    {
      "id": 6,
      "start": 6017.66,
      "end": 6021.66,
      "formatted_start": "01:40:17.660",
      "formatted_end": "01:40:21.660",
      "text": "تا که این رو بزنیم گفتیم دو روز قلبتو بیار که بیارم؟"
    },
    {
      "id": 7,
      "start": 6021.66,
      "end": 6024.66,
      "formatted_start": "01:40:21.660",
      "formatted_end": "01:40:24.660",
      "text": "من یک هفته یه بزنیم"
    },
    {
      "id": 8,
      "start": 6024.66,
      "end": 6028.66,
      "formatted_start": "01:40:24.660",
      "formatted_end": "01:40:28.660",
      "text": "پس اگه الان که تازه اومدی پیشم برو تا یه ماه دیگه آزمایش بگیر"
    },
    {
      "id": 9,
      "start": 6028.66,
      "end": 6031.66,
      "formatted_start": "01:40:28.660",
      "formatted_end": "01:40:31.660",
      "text": "یک ماه دیگه هم آزمایش بگیر"
    },
    {
      "id": 10,
      "start": 6031.66,
      "end": 6033.66,
      "formatted_start": "01:40:31.660",
      "formatted_end": "01:40:33.660",
      "text": "پردناش رو دو ساعت تا اینها"
    },
    {
      "id": 11,
      "start": 6033.66,
      "end": 6038.66,
      "formatted_start": "01:40:33.660",
      "formatted_end": "01:40:38.660",
      "text": "او برگی که دادیم درست گرمونی تا یک ماه دیگه"
    },
    {
      "id": 12,
      "start": 6038.66,
      "end": 6040.66,
      "formatted_start": "01:40:38.660",
      "formatted_end": "01:40:40.660",
      "text": "چانل ها عمر گیرید بهش"
    },
    {
      "id": 13,
      "start": 6040.66,
      "end": 6043.66,
      "formatted_start": "01:40:40.660",
      "formatted_end": "01:40:43.660",
      "text": "به جا صبح که پا میشه صرف میکنی وقتی دیگه هم صرف میکنی"
    },
    {
      "id": 14,
      "start": 6043.66,
      "end": 6045.66,
      "formatted_start": "01:40:43.660",
      "formatted_end": "01:40:45.660",
      "text": "پیشتر شب ها برنندید"
    },
    {
      "id": 15,
      "start": 6045.66,
      "end": 6046.66,
      "formatted_start": "01:40:45.660",
      "formatted_end": "01:40:46.660",
      "text": "یکس به شب"
    },
    {
      "id": 16,
      "start": 6046.66,
      "end": 6048.66,
      "formatted_start": "01:40:46.660",
      "formatted_end": "01:40:48.660",
      "text": "آره تقریبا ساعتی یازده"
    },
    {
      "id": 17,
      "start": 6048.66,
      "end": 6049.66,
      "formatted_start": "01:40:48.660",
      "formatted_end": "01:40:49.660",
      "text": "شمزده"
    },
    {
      "id": 18,
      "start": 6049.66,
      "end": 6052.66,
      "formatted_start": "01:40:49.660",
      "formatted_end": "01:40:52.660",
      "text": "اگه دیدی بازم افت کردی دوسته رو صرف میکنی"
    },
    {
      "id": 19,
      "start": 6052.66,
      "end": 6053.66,
      "formatted_start": "01:40:52.660",
      "formatted_end": "01:40:53.660",
      "text": "یا در این صبح اینطوریه"
    },
    {
      "id": 20,
      "start": 6053.66,
      "end": 6055.66,
      "formatted_start": "01:40:53.660",
      "formatted_end": "01:40:55.660",
      "text": "یا در این صبح یا شب"
    },
    {
      "id": 21,
      "start": 6055.66,
      "end": 6057.66,
      "formatted_start": "01:40:55.660",
      "formatted_end": "01:40:57.660",
      "text": "به خاطر شبه دیدی که افت میده هم"
    },
    {
      "id": 22,
      "start": 6057.66,
      "end": 6060.9,
      "formatted_start": "01:40:57.660",
      "formatted_end": "01:41:00.900",
      "text": "اگر دیدی که بعدم خیلی و بازم خفت کردی"
    },
    {
      "id": 23,
      "start": 6060.9,
      "end": 6066.18,
      "formatted_start": "01:41:00.900",
      "formatted_end": "01:41:06.180",
      "text": "دو سه روز بازش چون زمان میبره که بردم دیسته چهار روزت موردید بازم خفتی"
    },
    {
      "id": 24,
      "start": 6066.18,
      "end": 6068.38,
      "formatted_start": "01:41:06.180",
      "formatted_end": "01:41:08.380",
      "text": "شباب رو دوتا کم کن بکن چهار درده"
    },
    {
      "id": 25,
      "start": 6068.38,
      "end": 6069.38,
      "formatted_start": "01:41:08.380",
      "formatted_end": "01:41:09.380",
      "text": "باشه؟"
    },
    {
      "id": 26,
      "start": 6069.38,
      "end": 6070.38,
      "formatted_start": "01:41:09.380",
      "formatted_end": "01:41:10.380",
      "text": "پس دوره"
    },
    {
      "id": 27,
      "start": 6070.38,
      "end": 6071.38,
      "formatted_start": "01:41:10.380",
      "formatted_end": "01:41:11.380",
      "text": "سلامتی شد"
    },
    {
      "id": 28,
      "start": 6071.38,
      "end": 6072.38,
      "formatted_start": "01:41:11.380",
      "formatted_end": "01:41:12.380",
      "text": "پس این هیچی افتراتی نه؟"
    },
    {
      "id": 29,
      "start": 6072.38,
      "end": 6074.38,
      "formatted_start": "01:41:12.380",
      "formatted_end": "01:41:14.380",
      "text": "آره دارم من اون فیلم دارم"
    },
    {
      "id": 30,
      "start": 6074.38,
      "end": 6075.38,
      "formatted_start": "01:41:14.380",
      "formatted_end": "01:41:15.380",
      "text": "اینه که هفته دارم"
    },
    {
      "id": 31,
      "start": 6075.38,
      "end": 6076.38,
      "formatted_start": "01:41:15.380",
      "formatted_end": "01:41:16.380",
      "text": "اینم داری؟"
    },
    {
      "id": 32,
      "start": 6076.38,
      "end": 6077.38,
      "formatted_start": "01:41:16.380",
      "formatted_end": "01:41:17.380",
      "text": "اینم پنیشته دارم"
    },
    {
      "id": 33,
      "start": 6077.38,
      "end": 6078.38,
      "formatted_start": "01:41:17.380",
      "formatted_end": "01:41:18.380",
      "text": "خب خوبه"
    },
    {
      "id": 34,
      "start": 6078.38,
      "end": 6079.38,
      "formatted_start": "01:41:18.380",
      "formatted_end": "01:41:19.380",
      "text": "اینم کنم تو"
    },
    {
      "id": 35,
      "start": 6079.38,
      "end": 6080.38,
      "formatted_start": "01:41:19.380",
      "formatted_end": "01:41:20.380",
      "text": "چیزی پس نیاز مداری؟"
    },
    {
      "id": 36,
      "start": 6080.38,
      "end": 6084.88,
      "formatted_start": "01:41:20.380",
      "formatted_end": "01:41:24.880",
      "text": "نه، فقط من سآل داشتم، اما من اینکه بازم دستشون رو درده دارم"
    },
    {
      "id": 37,
      "start": 6084.88,
      "end": 6086.38,
      "formatted_start": "01:41:24.880",
      "formatted_end": "01:41:26.380",
      "text": "من همونو تلگم باشم"
    },
    {
      "id": 38,
      "start": 6086.38,
      "end": 6092.88,
      "formatted_start": "01:41:26.380",
      "formatted_end": "01:41:32.880",
      "text": "بسیار خورس کنن و بس شدن، هر مکتبی که مثلا هر جا رفتن، مکتب نه، نهمونی جایی نه"
    },
    {
      "id": 39,
      "start": 6092.88,
      "end": 6097.38,
      "formatted_start": "01:41:32.880",
      "formatted_end": "01:41:37.380",
      "text": "میتونید از این نظر نزدن بگو، تو با انسولین ندارن، اما الان یه هفته راحت شده"
    },
    {
      "id": 40,
      "start": 6097.38,
      "end": 6106.38,
      "formatted_start": "01:41:37.380",
      "formatted_end": "01:41:46.380",
      "text": "اصلا انسولین که من بهتون میگم، توی کل دنیا، اولین دنبال، بعد اولین دنبال، با خرابتار، پرین دنبال انسولین"
    },
    {
      "id": 41,
      "start": 6106.38,
      "end": 6112.9,
      "formatted_start": "01:41:46.380",
      "formatted_end": "01:41:52.900",
      "text": "چون انسانین هی خطر ترین، آرزون ترین، داب و بد، همه ای بده"
    },
    {
      "id": 42,
      "start": 6112.9,
      "end": 6119.14,
      "formatted_start": "01:41:52.900",
      "formatted_end": "01:41:59.140",
      "text": "با انسانین مریض سرغاله، با قرص هی زر، هی بهالی با انسانین سرغال میشه"
    },
    {
      "id": 43,
      "start": 6119.14,
      "end": 6124.62,
      "formatted_start": "01:41:59.140",
      "formatted_end": "01:42:04.620",
      "text": "به محض اگه باید افت می کنی، میلگی دوتا باید افت باید دوتا بکنی"
    },
    {
      "id": 44,
      "start": 6124.62,
      "end": 6126.02,
      "formatted_start": "01:42:04.620",
      "formatted_end": "01:42:06.020",
      "text": "من دارم"
    },
    {
      "id": 45,
      "start": 6126.02,
      "end": 6129.62,
      "formatted_start": "01:42:06.020",
      "formatted_end": "01:42:09.620",
      "text": "نران تا افت بکنه مثلا میتونم چیز شیرونه بکنم"
    },
    {
      "id": 46,
      "start": 6129.62,
      "end": 6131.14,
      "formatted_start": "01:42:09.620",
      "formatted_end": "01:42:11.140",
      "text": "افت برم، باید همونجا افت میشه"
    },
    {
      "id": 47,
      "start": 6131.14,
      "end": 6135.14,
      "formatted_start": "01:42:11.140",
      "formatted_end": "01:42:15.140",
      "text": "مثل قرص نیست، قرص باید همینجور بخوایید تا افتاده هستی"
    },
    {
      "id": 48,
      "start": 6135.14,
      "end": 6139.14,
      "formatted_start": "01:42:15.140",
      "formatted_end": "01:42:19.140",
      "text": "این یه بابره دیگه کشور همه از اینجور نگهرم"
    },
    {
      "id": 49,
      "start": 6139.14,
      "end": 6145.14,
      "formatted_start": "01:42:19.140",
      "formatted_end": "01:42:25.140",
      "text": "اینجور نگهرم، یا مشد یا تا کلیم"
    },
    {
      "id": 50,
      "start": 6145.14,
      "end": 6148.14,
      "formatted_start": "01:42:25.140",
      "formatted_end": "01:42:28.140",
      "text": "اصفان، بروستان، سر"
    },
    {
      "id": 51,
      "start": 6148.14,
      "end": 6153.14,
      "formatted_start": "01:42:28.140",
      "formatted_end": "01:42:33.140",
      "text": "مشد کلیمیک دکتر صدقهد"
    },
    {
      "id": 52,
      "start": 6153.14,
      "end": 6157.14,
      "formatted_start": "01:42:33.140",
      "formatted_end": "01:42:37.140",
      "text": "اصلا اینجاز هم جاشه"
    },
    {
      "id": 53,
      "start": 6157.14,
      "end": 6164.84,
      "formatted_start": "01:42:37.140",
      "formatted_end": "01:42:44.840",
      "text": "احمداباد کلومیتی باید برسید"
    },
    {
      "id": 54,
      "start": 6164.84,
      "end": 6171.7,
      "formatted_start": "01:42:44.840",
      "formatted_end": "01:42:51.700",
      "text": "اگر نه جوسته از خزینه دولتی ایمارستان خاتمان عدیوی مشهد"
    },
    {
      "id": 55,
      "start": 6171.7,
      "end": 6178.66,
      "formatted_start": "01:42:51.700",
      "formatted_end": "01:42:58.660",
      "text": "این ایمارستان تخصصی چشم مشهدی شامان قبل"
    },
    {
      "id": 56,
      "start": 6178.66,
      "end": 6180.1,
      "formatted_start": "01:42:58.660",
      "formatted_end": "01:43:00.100",
      "text": "این خزینه شده مشهدی؟"
    },
    {
      "id": 57,
      "start": 6180.1,
      "end": 6182.1,
      "formatted_start": "01:43:00.100",
      "formatted_end": "01:43:02.100",
      "text": "آره که این یعنی دولتیه دیگه"
    },
    {
      "id": 58,
      "start": 6182.1,
      "end": 6183.7,
      "formatted_start": "01:43:02.100",
      "formatted_end": "01:43:03.700",
      "text": "اتماناً یه دولتیه"
    },
    {
      "id": 59,
      "start": 6183.7,
      "end": 6186.66,
      "formatted_start": "01:43:03.700",
      "formatted_end": "01:43:06.660",
      "text": "آره که این یه دولتیه دیگه بیمار قبول"
    },
    {
      "id": 60,
      "start": 6186.66,
      "end": 6188.66,
      "formatted_start": "01:43:06.660",
      "formatted_end": "01:43:08.660",
      "text": "اگه نتونستی هزمون"
    },
    {
      "id": 61,
      "start": 6188.66,
      "end": 6192.66,
      "formatted_start": "01:43:08.660",
      "formatted_end": "01:43:12.660",
      "text": "این دیوستان دکتورش چیه دکتوریه؟"
    },
    {
      "id": 62,
      "start": 6192.66,
      "end": 6194.66,
      "formatted_start": "01:43:12.660",
      "formatted_end": "01:43:14.660",
      "text": "من نمیشه ناسم، آره خود شما رو بیانم"
    },
    {
      "id": 63,
      "start": 6194.66,
      "end": 6197.66,
      "formatted_start": "01:43:14.660",
      "formatted_end": "01:43:17.660",
      "text": "ولی این رو خدایت میتونم باید خدا بگم اینجا"
    },
    {
      "id": 64,
      "start": 6197.66,
      "end": 6198.66,
      "formatted_start": "01:43:17.660",
      "formatted_end": "01:43:18.660",
      "text": "من ترش برم؟"
    },
    {
      "id": 65,
      "start": 6198.66,
      "end": 6200.66,
      "formatted_start": "01:43:18.660",
      "formatted_end": "01:43:20.660",
      "text": "آره، ببین چجوریه هزمون"
    },
    {
      "id": 66,
      "start": 6200.66,
      "end": 6203.66,
      "formatted_start": "01:43:20.660",
      "formatted_end": "01:43:23.660",
      "text": "نهایتش دیده نمیکنی، بعد دیده"
    },
    {
      "id": 67,
      "start": 6203.66,
      "end": 6206.66,
      "formatted_start": "01:43:23.660",
      "formatted_end": "01:43:26.660",
      "text": "رست شما دردده، خیلی دازه کنیم"
    },
    {
      "id": 68,
      "start": 6206.66,
      "end": 6208.66,
      "formatted_start": "01:43:26.660",
      "formatted_end": "01:43:28.660",
      "text": "خدایت از اصلا مرداشی"
    },
    {
      "id": 69,
      "start": 6208.66,
      "end": 6210.66,
      "formatted_start": "01:43:28.660",
      "formatted_end": "01:43:30.660",
      "text": "خدا باشه"
    },
    {
      "id": 70,
      "start": 6210.66,
      "end": 6213.66,
      "formatted_start": "01:43:30.660",
      "formatted_end": "01:43:33.660",
      "text": "این انسانی ها شرمزه ما دیستم"
    },
    {
      "id": 71,
      "start": 6213.66,
      "end": 6216.34,
      "formatted_start": "01:43:33.660",
      "formatted_end": "01:43:36.340",
      "text": "اونا ایمانیه همینو خوبه یا خارجی بگن؟"
    },
    {
      "id": 72,
      "start": 6216.34,
      "end": 6218.9,
      "formatted_start": "01:43:36.340",
      "formatted_end": "01:43:38.900",
      "text": "حالا خودتو درگیر اون حال نکن"
    },
    {
      "id": 73,
      "start": 6218.9,
      "end": 6219.46,
      "formatted_start": "01:43:38.900",
      "formatted_end": "01:43:39.460",
      "text": "خوبه"
    },
    {
      "id": 74,
      "start": 6219.46,
      "end": 6221.06,
      "formatted_start": "01:43:39.460",
      "formatted_end": "01:43:41.060",
      "text": "بگه قندت پایین نمیشه"
    },
    {
      "id": 75,
      "start": 6221.06,
      "end": 6223.1,
      "formatted_start": "01:43:41.060",
      "formatted_end": "01:43:43.100",
      "text": "بگه حساسیت دادی"
    },
    {
      "id": 76,
      "start": 6223.1,
      "end": 6225.42,
      "formatted_start": "01:43:43.100",
      "formatted_end": "01:43:45.420",
      "text": "دارو تو استفاده کنی"
    },
    {
      "id": 77,
      "start": 6225.42,
      "end": 6226.5,
      "formatted_start": "01:43:45.420",
      "formatted_end": "01:43:46.500",
      "text": "نه سه دوله دیده"
    },
    {
      "id": 78,
      "start": 6226.5,
      "end": 6228.28,
      "formatted_start": "01:43:46.500",
      "formatted_end": "01:43:48.280",
      "text": "خورمان شدید"
    },
    {
      "id": 79,
      "start": 6228.28,
      "end": 6230.06,
      "formatted_start": "01:43:48.280",
      "formatted_end": "01:43:50.060",
      "text": "خورمان شدید"
    },
    {
      "id": 80,
      "start": 6230.06,
      "end": 6231.02,
      "formatted_start": "01:43:50.060",
      "formatted_end": "01:43:51.020",
      "text": "خورمان شدید"
    },
    {
      "id": 81,
      "start": 6231.02,
      "end": 6233.5,
      "formatted_start": "01:43:51.020",
      "formatted_end": "01:43:53.500",
      "text": "خورمان شدید"
    },
    {
      "id": 82,
      "start": 6233.5,
      "end": 6234.62,
      "formatted_start": "01:43:53.500",
      "formatted_end": "01:43:54.620",
      "text": "چشم بود؟"
    },
    {
      "id": 83,
      "start": 6243.66,
      "end": 6248.78,
      "formatted_start": "01:44:03.660",
      "formatted_end": "01:44:08.780",
      "text": "از این صحبت که بیشتر بردارید که ما قندر با قضای چی هستش"
    },
    {
      "id": 84,
      "start": 6248.78,
      "end": 6252.0,
      "formatted_start": "01:44:08.780",
      "formatted_end": "01:44:12.000",
      "text": "این رو باید صحبت داشته باشیم"
    },
    {
      "id": 85,
      "start": 6252.0,
      "end": 6255.48,
      "formatted_start": "01:44:12.000",
      "formatted_end": "01:44:15.480",
      "text": "کمپونستی بردارید"
    },
    {
      "id": 86,
      "start": 6255.48,
      "end": 6255.5,
      "formatted_start": "01:44:15.480",
      "formatted_end": "01:44:15.500",
      "text": "بردارید"
    },
    {
      "id": 87,
      "start": 6255.5,
      "end": 6263.66,
      "formatted_start": "01:44:15.500",
      "formatted_end": "01:44:23.660",
      "text": "ادارتون باریک شده؟ فشارش کم شده؟"
    },
    {
      "id": 88,
      "start": 6264.3,
      "end": 6264.66,
      "formatted_start": "01:44:24.300",
      "formatted_end": "01:44:24.660",
      "text": "بردارید"
    },
    {
      "id": 89,
      "start": 6265.34,
      "end": 6268.66,
      "formatted_start": "01:44:25.340",
      "formatted_end": "01:44:28.660",
      "text": "کمپونستاتتون بزرگ شده و فشارش کم شده؟"
    },
    {
      "id": 90,
      "start": 6268.66,
      "end": 6271.66,
      "formatted_start": "01:44:28.660",
      "formatted_end": "01:44:31.660",
      "text": "چند وقت ادارتون بردارید؟"
    },
    {
      "id": 91,
      "start": 6271.66,
      "end": 6273.66,
      "formatted_start": "01:44:31.660",
      "formatted_end": "01:44:33.660",
      "text": "این روز روز بیشکم شده"
    },
    {
      "id": 92,
      "start": 6277.66,
      "end": 6279.66,
      "formatted_start": "01:44:37.660",
      "formatted_end": "01:44:39.660",
      "text": "بعد خرز و خرزتا رو برده"
    },
    {
      "id": 93,
      "start": 6282.66,
      "end": 6285.66,
      "formatted_start": "01:44:42.660",
      "formatted_end": "01:44:45.660",
      "text": "چون این کلیه بشار رو به کلیه برم کرده"
    },
    {
      "id": 94,
      "start": 6285.66,
      "end": 6287.66,
      "formatted_start": "01:44:45.660",
      "formatted_end": "01:44:47.660",
      "text": "و چون شما قمدهایی باز خیلی بشه"
    },
    {
      "id": 95,
      "start": 6287.66,
      "end": 6289.66,
      "formatted_start": "01:44:47.660",
      "formatted_end": "01:44:49.660",
      "text": "در آسیب بازند"
    },
    {
      "id": 96,
      "start": 6289.66,
      "end": 6291.66,
      "formatted_start": "01:44:49.660",
      "formatted_end": "01:44:51.660",
