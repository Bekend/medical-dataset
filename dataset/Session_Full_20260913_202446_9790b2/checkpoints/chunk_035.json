  "stt_segments": [
    {
      "id": 0,
      "start": 10500.0,
      "end": 10529.98,
      "formatted_start": "02:55:00.000",
      "formatted_end": "02:55:29.980",
      "text": "از اینجا بیمار بیمار در مطب پزشکی، داروها، آزمایش و نسخه."
    },
    {
      "id": 1,
      "start": 10560.0,
      "end": 10588.0,
      "formatted_start": "02:56:00.000",
      "formatted_end": "02:56:28.000",
      "text": "موسیقی"
    },
    {
      "id": 2,
      "start": 10588.0,
      "end": 10590.0,
      "formatted_start": "02:56:28.000",
      "formatted_end": "02:56:30.000",
      "text": "تو هره بیا"
    },
    {
      "id": 3,
      "start": 10590.0,
      "end": 10614.0,
      "formatted_start": "02:56:30.000",
      "formatted_end": "02:56:54.000",
      "text": "موسیقی"
    },
    {
      "id": 4,
      "start": 10614.0,
      "end": 10616.0,
      "formatted_start": "02:56:54.000",
      "formatted_end": "02:56:56.000",
      "text": "اینجا سپرازی میترک دهیم"
    },
    {
      "id": 5,
      "start": 10616.0,
      "end": 10618.0,
      "formatted_start": "02:56:56.000",
      "formatted_end": "02:56:58.000",
      "text": "بعد بگیم تجویز"
    },
    {
      "id": 6,
      "start": 10618.0,
      "end": 10620.0,
      "formatted_start": "02:56:58.000",
      "formatted_end": "02:57:00.000",
      "text": "آف و تجویز"
    },
    {
      "id": 7,
      "start": 10620.0,
      "end": 10622.0,
      "formatted_start": "02:57:00.000",
      "formatted_end": "02:57:02.000",
      "text": "بعد اینجا داریم"
    },
    {
      "id": 8,
      "start": 10622.0,
      "end": 10624.0,
      "formatted_start": "02:57:02.000",
      "formatted_end": "02:57:04.000",
      "text": "قلبان مورد علاقه"
    },
    {
      "id": 9,
      "start": 10624.0,
      "end": 10626.0,
      "formatted_start": "02:57:04.000",
      "formatted_end": "02:57:06.000",
      "text": "بعد اینجا اینجا این"
    },
    {
      "id": 10,
      "start": 10626.0,
      "end": 10628.0,
      "formatted_start": "02:57:06.000",
      "formatted_end": "02:57:08.000",
      "text": "چیه؟ چیزی که مورد علاقه"
    },
    {
      "id": 11,
      "start": 10628.0,
      "end": 10630.0,
      "formatted_start": "02:57:08.000",
      "formatted_end": "02:57:10.000",
      "text": "حالا چیان انتخاب کردیم؟"
    },
    {
      "id": 12,
      "start": 10630.0,
      "end": 10632.0,
      "formatted_start": "02:57:10.000",
      "formatted_end": "02:57:12.000",
      "text": "همه رنزه خواهی میتونیم"
    },
    {
      "id": 13,
      "start": 10632.0,
      "end": 10634.0,
      "formatted_start": "02:57:12.000",
      "formatted_end": "02:57:14.000",
      "text": "همه چیزی که مورد علاقه هست"
    },
    {
      "id": 14,
      "start": 10634.0,
      "end": 10636.0,
      "formatted_start": "02:57:14.000",
      "formatted_end": "02:57:16.000",
      "text": "خواهی همه رنزه خواهی میتونیم"
    },
    {
      "id": 15,
      "start": 10636.0,
      "end": 10638.0,
      "formatted_start": "02:57:16.000",
      "formatted_end": "02:57:18.000",
      "text": "بعد"
    },
    {
      "id": 16,
      "start": 10638.0,
      "end": 10640.0,
      "formatted_start": "02:57:18.000",
      "formatted_end": "02:57:20.000",
      "text": "خواهی میتونیم"
    },
    {
      "id": 17,
      "start": 10640.0,
      "end": 10642.0,
      "formatted_start": "02:57:20.000",
      "formatted_end": "02:57:22.000",
      "text": "مورد علاقه"
    },
    {
      "id": 18,
      "start": 10644.0,
      "end": 10674.0,
      "formatted_start": "02:57:24.000",
      "formatted_end": "02:57:54.000",
      "text": "از اینجا باید برداشتیم که اینجا باید برداشتیم که اینجا باید برداشتیم که اینجا باید برداشتیم که اینجا باید برداشتیم که اینجا باید برداشتیم که اینجا باید برداشتیم که اینجا باید برداشتیم که اینجا باید برداشتیم که اینجا باید برداشتیم که اینجا باید برداشتیم که اینجا باید برداشتیم که اینجا باید برداشتیم که"
    },
    {
      "id": 19,
      "start": 10674.0,
      "end": 10676.0,
      "formatted_start": "02:57:54.000",
      "formatted_end": "02:57:56.000",
      "text": "اگر یک بار سخت شده بکن میگه نشون نیست نه؟"
    },
    {
      "id": 20,
      "start": 10676.0,
      "end": 10678.0,
      "formatted_start": "02:57:56.000",
      "formatted_end": "02:57:58.000",
      "text": "نه"
    },
    {
      "id": 21,
      "start": 10678.0,
      "end": 10680.0,
      "formatted_start": "02:57:58.000",
      "formatted_end": "02:58:00.000",
      "text": "کشت پا من است و آزمان میگه"
    },
    {
      "id": 22,
      "start": 10680.0,
      "end": 10682.0,
      "formatted_start": "02:58:00.000",
      "formatted_end": "02:58:02.000",
      "text": "تا دقیقا خیلی سخت داری"
    },
    {
      "id": 23,
      "start": 10682.0,
      "end": 10684.0,
      "formatted_start": "02:58:02.000",
      "formatted_end": "02:58:04.000",
      "text": "مثلا میزنی تصویر نیست داری که ایجادش کنی"
    },
    {
      "id": 24,
      "start": 10684.0,
      "end": 10686.0,
      "formatted_start": "02:58:04.000",
      "formatted_end": "02:58:06.000",
      "text": "در جزت و چیت برم"
    },
    {
      "id": 25,
      "start": 10686.0,
      "end": 10688.0,
      "formatted_start": "02:58:06.000",
      "formatted_end": "02:58:08.000",
      "text": "بکن من اینجا برمیزنیم"
    },
    {
      "id": 26,
      "start": 10692.0,
      "end": 10694.0,
      "formatted_start": "02:58:12.000",
      "formatted_end": "02:58:14.000",
      "text": "بکن قلب برمیزنیم"
    },
    {
      "id": 27,
      "start": 10696.0,
      "end": 10698.0,
      "formatted_start": "02:58:16.000",
      "formatted_end": "02:58:18.000",
      "text": "قلبه"
    },
    {
      "id": 28,
      "start": 10698.0,
      "end": 10700.0,
      "formatted_start": "02:58:18.000",
      "formatted_end": "02:58:20.000",
      "text": "من بعد این آزمانشو آنگام هستم"
    },
    {
      "id": 29,
      "start": 10700.0,
      "end": 10702.0,
      "formatted_start": "02:58:20.000",
      "formatted_end": "02:58:22.000",
      "text": "این استفاده نیست"
    },
    {
      "id": 30,
      "start": 10702.0,
      "end": 10704.0,
      "formatted_start": "02:58:22.000",
      "formatted_end": "02:58:24.000",
      "text": "این رنگ رو باید درست کنید"
    },
    {
      "id": 31,
      "start": 10704.0,
      "end": 10706.0,
      "formatted_start": "02:58:24.000",
      "formatted_end": "02:58:26.000",
      "text": "این رنگ رو باید درست کنید"
    },
    {
      "id": 32,
      "start": 10706.0,
      "end": 10708.0,
      "formatted_start": "02:58:26.000",
      "formatted_end": "02:58:28.000",
      "text": "این رنگ رو باید درست کنید"
    },
    {
      "id": 33,
