      "formatted_start": "02:58:30.000",
      "formatted_end": "02:58:32.000",
      "text": "این رنگ رو باید درست کنید"
    },
    {
      "id": 35,
      "start": 10712.0,
      "end": 10714.0,
      "formatted_start": "02:58:32.000",
      "formatted_end": "02:58:34.000",
      "text": "این رنگ رو باید درست کنید"
    },
    {
      "id": 36,
      "start": 10714.0,
      "end": 10716.0,
      "formatted_start": "02:58:34.000",
      "formatted_end": "02:58:36.000",
      "text": "چقدر کم رنگ سایتش"
    },
    {
      "id": 37,
      "start": 10716.0,
      "end": 10718.0,
      "formatted_start": "02:58:36.000",
      "formatted_end": "02:58:38.000",
      "text": "خیلی ممنون رنگ خوبی اعتقاد کنند"
