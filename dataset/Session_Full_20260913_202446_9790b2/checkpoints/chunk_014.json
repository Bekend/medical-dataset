      "formatted_end": "01:10:24.000",
      "text": "موسیقی"
    },
    {
      "id": 1,
      "start": 4230.0,
      "end": 4233.2,
      "formatted_start": "01:10:30.000",
      "formatted_end": "01:10:33.200",
      "text": "سمروی نسلی سزونه"
    },
    {
      "id": 2,
      "start": 4233.2,
      "end": 4235.52,
      "formatted_start": "01:10:33.200",
      "formatted_end": "01:10:35.520",
      "text": "بردونه"
    },
    {
      "id": 3,
      "start": 4235.52,
      "end": 4241.24,
      "formatted_start": "01:10:35.520",
      "formatted_end": "01:10:41.240",
      "text": "به خوبه چیمگرد"
    },
    {
      "id": 4,
      "start": 4241.24,
      "end": 4244.88,
      "formatted_start": "01:10:41.240",
      "formatted_end": "01:10:44.880",
      "text": "مارون مارون مارون مارون"
    },
    {
      "id": 5,
      "start": 4244.88,
      "end": 4247.88,
      "formatted_start": "01:10:44.880",
      "formatted_end": "01:10:47.880",
      "text": "بی آس روی خودتای آن"
    },
    {
      "id": 6,
      "start": 4247.88,
      "end": 4253.24,
      "formatted_start": "01:10:47.880",
      "formatted_end": "01:10:53.240",
      "text": "سر سر بزرگ زنگرد"
    },
    {
      "id": 7,
      "start": 4253.24,
      "end": 4256.76,
      "formatted_start": "01:10:53.240",
      "formatted_end": "01:10:56.760",
      "text": "مارون مارون مارون مارون"
    },
    {
      "id": 8,
      "start": 4256.76,
      "end": 4276.76,
      "formatted_start": "01:10:56.760",
      "formatted_end": "01:11:16.760",
      "text": "موسیقی"
    },
    {
      "id": 9,
      "start": 4286.76,
      "end": 4290.76,
      "formatted_start": "01:11:26.760",
      "formatted_end": "01:11:30.760",
      "text": "باید اشپای کنیم"
    },
    {
      "id": 10,
      "start": 4290.76,
      "end": 4292.76,
      "formatted_start": "01:11:30.760",
      "formatted_end": "01:11:32.760",
      "text": "باید اشپای میکنیم، در این موقع باید"
    },
    {
      "id": 11,
      "start": 4292.76,
      "end": 4294.76,
      "formatted_start": "01:11:32.760",
      "formatted_end": "01:11:34.760",
      "text": "آتزه ترک میکنیم"
    },
    {
      "id": 12,
      "start": 4316.76,
      "end": 4333.76,
      "formatted_start": "01:11:56.760",
      "formatted_end": "01:12:13.760",
      "text": "موسیقی"
    },
    {
      "id": 13,
      "start": 4346.76,
      "end": 4348.76,
      "formatted_start": "01:12:26.760",
      "formatted_end": "01:12:28.760",
      "text": "از این سفر که تغییر می کنیم"
    },
    {
      "id": 14,
      "start": 4348.76,
      "end": 4350.76,
      "formatted_start": "01:12:28.760",
      "formatted_end": "01:12:30.760",
      "text": "از این سفر که تغییر می کنیم"
    },
    {
