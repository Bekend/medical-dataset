  "stt_segments": [
    {
      "id": 0,
      "start": 11400.0,
      "end": 11430.0,
      "formatted_start": "03:10:00.000",
      "formatted_end": "03:10:30.000",
      "text": "برنامه بیمار، بیمار، بیمار، بیمار، بیمار، بیمار، بیمار، بیمار، بیمار، بیمار، بیمار، بیمار، بیمار، بیمار، بیمار، بیمار، بیمار، بیمار، بیمار، بیمار، بیمار، بیمار، بیمار، بیمار، بیمار، بیمار، بیمار، بیمار، بیمار، بیمار، بیمار، بیمار، بیمار، بیمار، بیمار، بیمار، بیمار، بیمار، بیمار، بیمار، بیمار، بیمار، بیمار، بیم"
    },
    {
      "id": 1,
      "start": 11430.0,
      "end": 11432.0,
      "formatted_start": "03:10:30.000",
      "formatted_end": "03:10:32.000",
      "text": "سیستم هم هستش"
    },
    {
      "id": 2,
      "start": 11432.0,
      "end": 11434.0,
      "formatted_start": "03:10:32.000",
      "formatted_end": "03:10:34.000",
      "text": "سیستم هم خوش سیستم هست"
    },
    {
      "id": 3,
      "start": 11434.0,
      "end": 11436.0,
      "formatted_start": "03:10:34.000",
      "formatted_end": "03:10:36.000",
      "text": "زیاده دیگه سردر میشه"
    },
    {
      "id": 4,
      "start": 11438.0,
      "end": 11440.0,
      "formatted_start": "03:10:38.000",
      "formatted_end": "03:10:40.000",
      "text": "تویز که باز خورده"
    },
    {
      "id": 5,
      "start": 11440.0,
      "end": 11442.0,
      "formatted_start": "03:10:40.000",
      "formatted_end": "03:10:42.000",
      "text": "ازا نه"
    },
    {
      "id": 6,
      "start": 11442.0,
      "end": 11444.0,
      "formatted_start": "03:10:42.000",
      "formatted_end": "03:10:44.000",
      "text": "نه مشکل داری"
    },
    {
      "id": 7,
      "start": 11444.0,
      "end": 11446.0,
      "formatted_start": "03:10:44.000",
      "formatted_end": "03:10:46.000",
      "text": "موردت ها کنه از خورستی نده خورده"
    },
    {
      "id": 8,
      "start": 11446.0,
      "end": 11448.0,
      "formatted_start": "03:10:46.000",
      "formatted_end": "03:10:48.000",
      "text": "نه"
    },
    {
      "id": 9,
      "start": 11448.0,
      "end": 11450.0,
      "formatted_start": "03:10:48.000",
      "formatted_end": "03:10:50.000",
      "text": "چرا؟"
    },
    {
      "id": 10,
      "start": 11450.0,
      "end": 11452.0,
      "formatted_start": "03:10:50.000",
      "formatted_end": "03:10:52.000",
      "text": "باز خورده نده"
    },
    {
      "id": 11,
      "start": 11452.0,
      "end": 11454.0,
      "formatted_start": "03:10:52.000",
      "formatted_end": "03:10:54.000",
      "text": "باز خورده نده بسته"
    },
    {
      "id": 12,
      "start": 11454.0,
      "end": 11456.0,
      "formatted_start": "03:10:54.000",
      "formatted_end": "03:10:56.000",
      "text": "باز خورده بسته"
    },
    {
      "id": 13,
      "start": 11456.0,
      "end": 11458.0,
      "formatted_start": "03:10:56.000",
      "formatted_end": "03:10:58.000",
      "text": "من یک دونه باز خورده دارم"
    },
    {
      "id": 14,
      "start": 11458.0,
      "end": 11460.0,
      "formatted_start": "03:10:58.000",
      "formatted_end": "03:11:00.000",
      "text": "ببینید که اینجا با خود عالوستی داره"
    },
    {
      "id": 15,
      "start": 11460.0,
      "end": 11462.0,
      "formatted_start": "03:11:00.000",
      "formatted_end": "03:11:02.000",
      "text": "ببینیم چطور میشه"
    },
    {
      "id": 16,
      "start": 11462.0,
      "end": 11464.0,
      "formatted_start": "03:11:02.000",
      "formatted_end": "03:11:04.000",
      "text": "یک درصد یک درخواست برام داشت"
    },
    {
      "id": 17,
      "start": 11464.0,
      "end": 11466.0,
      "formatted_start": "03:11:04.000",
      "formatted_end": "03:11:06.000",
      "text": "باید موندگید"
    },
    {
      "id": 18,
      "start": 11466.0,
