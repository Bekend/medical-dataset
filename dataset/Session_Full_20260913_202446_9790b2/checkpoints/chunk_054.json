    },
    {
      "id": 16,
      "start": 16218.0,
      "end": 16219.0,
      "formatted_start": "04:30:18.000",
      "formatted_end": "04:30:19.000",
      "text": "از سلامی شما خوبه."
    },
    {
      "id": 17,
      "start": 16219.0,
      "end": 16222.0,
      "formatted_start": "04:30:19.000",
      "formatted_end": "04:30:22.000",
      "text": "وقتی افتادم به دور رفتم دکتر"
    },
    {
      "id": 18,
      "start": 16222.0,
      "end": 16225.0,
      "formatted_start": "04:30:22.000",
      "formatted_end": "04:30:25.000",
      "text": "بعد این ها رو به بیشتر"
    },
    {
      "id": 19,
      "start": 16225.0,
      "end": 16228.0,
      "formatted_start": "04:30:25.000",
      "formatted_end": "04:30:28.000",
      "text": "یه چرمز که خوردم خیلی آن هم خوب بود"
    },
    {
      "id": 20,
      "start": 16228.0,
      "end": 16229.0,
      "formatted_start": "04:30:28.000",
      "formatted_end": "04:30:29.000",
      "text": "درد و پاهم خوردن"
    },
    {
      "id": 21,
      "start": 16229.0,
      "end": 16231.0,
      "formatted_start": "04:30:29.000",
      "formatted_end": "04:30:31.000",
      "text": "بعد یه درد نه"
    },
    {
      "id": 22,
      "start": 16231.0,
      "end": 16233.0,
      "formatted_start": "04:30:31.000",
      "formatted_end": "04:30:33.000",
      "text": "بعد شکم همون"
    },
    {
      "id": 23,
      "start": 16233.0,
      "end": 16235.0,
      "formatted_start": "04:30:33.000",
      "formatted_end": "04:30:35.000",
      "text": "درد و درد"
    },
    {
      "id": 24,
      "start": 16235.0,
      "end": 16237.0,
      "formatted_start": "04:30:35.000",
      "formatted_end": "04:30:37.000",
      "text": "این ها رو که خود دارید بیدید"
    },
    {
      "id": 25,
      "start": 16237.0,
      "end": 16239.0,
      "formatted_start": "04:30:37.000",
      "formatted_end": "04:30:39.000",
      "text": "این به خاطر مصکن هست"
    },
    {
      "id": 26,
      "start": 16239.0,
      "end": 16241.0,
      "formatted_start": "04:30:39.000",
      "formatted_end": "04:30:41.000",
      "text": "الان باید خوردی همه نخوردن"
    },
    {
      "id": 27,
      "start": 16243.0,
      "end": 16245.0,
      "formatted_start": "04:30:43.000",
      "formatted_end": "04:30:45.000",
      "text": "میگه شکم رو راسته هم بخوردن"
    },
    {
      "id": 28,
      "start": 16245.0,
      "end": 16247.0,
      "formatted_start": "04:30:45.000",
      "formatted_end": "04:30:47.000",
      "text": "دیگه شکم سیر همه بخوردن"
    },
    {
      "id": 29,
      "start": 16247.0,
      "end": 16251.0,
      "formatted_start": "04:30:47.000",
      "formatted_end": "04:30:51.000",
      "text": "بخونه اینم سفت میکنه؟ شکمتون سفته؟"
    },
    {
      "id": 30,
      "start": 16251.0,
      "end": 16255.0,
      "formatted_start": "04:30:51.000",
      "formatted_end": "04:30:55.000",
      "text": "حالا اونش که نه زیاد چیز نفت کنه دیگه"
    },
    {
      "id": 31,
      "start": 16255.0,
      "end": 16258.0,
      "formatted_start": "04:30:55.000",
      "formatted_end": "04:30:58.000",
      "text": "شکمتون سفت کنه نمیکنه؟"
    },
    {
      "id": 32,
      "start": 16258.0,
      "end": 16263.0,
      "formatted_start": "04:30:58.000",
      "formatted_end": "04:31:03.000",
      "text": "نه شکمم، الان که مثلا جلوهارو از خدفنم خوه خدا شده"
    },
    {
      "id": 33,
      "start": 16263.0,
      "end": 16267.0,
      "formatted_start": "04:31:03.000",
      "formatted_end": "04:31:07.000",
      "text": "خب اینجا خانم بگو من چند سال جور رفتم بر شهر، کومیت کوبی کردم"
    },
    {
      "id": 34,
      "start": 16267.0,
      "end": 16270.0,
      "formatted_start": "04:31:07.000",
      "formatted_end": "04:31:10.000",
      "text": "کوبیه دیگه از نیزت قرمزه، بس؟"
    },
    {
      "id": 35,
      "start": 16270.0,
      "end": 16273.0,
      "formatted_start": "04:31:10.000",
      "formatted_end": "04:31:13.000",
      "text": "بس اونو یه صحبه هست از از خدفت"
    },
    {
      "id": 36,
      "start": 16273.0,
      "end": 16275.0,
      "formatted_start": "04:31:13.000",
      "formatted_end": "04:31:15.000",
      "text": "چه مانده؟ داد منو بخون؟"
    },
    {
      "id": 37,
      "start": 16275.0,
      "end": 16279.0,
      "formatted_start": "04:31:15.000",
      "formatted_end": "04:31:19.000",
      "text": "این که خوردم داشتم مومار دارم بگرد"
    },
    {
      "id": 38,
      "start": 16279.0,
      "end": 16283.0,
      "formatted_start": "04:31:19.000",
      "formatted_end": "04:31:23.000",
      "text": "باید مسکن هم ساده بخورید"
    },
    {
      "id": 39,
      "start": 16283.0,
      "end": 16285.0,
      "formatted_start": "04:31:23.000",
      "formatted_end": "04:31:25.000",
      "text": "این مال دردی باید داره؟ هنو دکتر بخورن"
    },
    {
      "id": 40,
      "start": 16285.0,
      "end": 16287.0,
      "formatted_start": "04:31:25.000",
      "formatted_end": "04:31:27.000",
      "text": "نه بخورن درد میتوشن"
    },
    {
      "id": 41,
      "start": 16287.0,
      "end": 16291.0,
      "formatted_start": "04:31:27.000",
      "formatted_end": "04:31:31.000",
      "text": "نه دارو برای چون منو نمیستم که کم زرارتر باشه"
    },
    {
      "id": 42,
      "start": 16291.0,
      "end": 16294.0,
      "formatted_start": "04:31:31.000",
      "formatted_end": "04:31:34.000",
      "text": "نه اصلا نمیخورم مسکن خورم بگرم"
    },
    {
      "id": 43,
      "start": 16294.0,
      "end": 16296.0,
      "formatted_start": "04:31:34.000",
      "formatted_end": "04:31:36.000",
      "text": "اصلا مسکن نمیخورم"
    },
    {
      "id": 44,
      "start": 16296.0,
      "end": 16298.0,
      "formatted_start": "04:31:36.000",
      "formatted_end": "04:31:38.000",
      "text": "وقتی یک چیز بشه که هنو دکتر این"
    },
    {
      "id": 45,
      "start": 16298.0,
      "end": 16300.0,
      "formatted_start": "04:31:38.000",
      "formatted_end": "04:31:40.000",
      "text": "مثلا بگفت کن این ارزت رو آمده"
    },
    {
      "id": 46,
      "start": 16300.0,
      "end": 16302.0,
      "formatted_start": "04:31:40.000",
      "formatted_end": "04:31:42.000",
      "text": "چیز پشته"
    },
    {
      "id": 47,
      "start": 16302.0,
      "end": 16304.0,
      "formatted_start": "04:31:42.000",
      "formatted_end": "04:31:44.000",
      "text": "یوخ های پشته"
    },
    {
      "id": 48,
      "start": 16304.0,
      "end": 16334.0,
      "formatted_start": "04:31:44.000",
      "formatted_end": "04:32:14.000",
      "text": "در اینجا، در اینجا، در اینجا، در اینجا، در اینجا، در اینجا، در اینجا، در اینجا، در اینجا، در اینجا، در اینجا، در اینجا، در اینجا، در اینجا، در اینجا، در اینجا، در اینجا، در اینجا، در اینجا، در اینجا، در اینجا، در اینجا، در اینجا، در اینجا، در اینجا، در اینجا، در اینجا، در اینجا، در اینجا، در اینجا، در اینجا، در اینجا"
    },
    {
      "id": 49,
      "start": 16334.0,
      "end": 16336.0,
      "formatted_start": "04:32:14.000",
      "formatted_end": "04:32:16.000",
      "text": "بعد اینجا من هم باشم"
    },
    {
      "id": 50,
      "start": 16336.0,
      "end": 16340.0,
      "formatted_start": "04:32:16.000",
      "formatted_end": "04:32:20.000",
      "text": "حالا داروش هم قفل به برگ بجز دردتون چه مشکل دارید؟"
    },
    {
      "id": 51,
      "start": 16340.0,
      "end": 16342.0,
      "formatted_start": "04:32:20.000",
      "formatted_end": "04:32:22.000",
      "text": "قلب داشتی نه؟"
    },
    {
      "id": 52,
      "start": 16342.0,
      "end": 16344.0,
      "formatted_start": "04:32:22.000",
      "formatted_end": "04:32:24.000",
      "text": "نه نه قلب ندارم"
    },
    {
      "id": 53,
      "start": 16344.0,
      "end": 16346.0,
      "formatted_start": "04:32:24.000",
      "formatted_end": "04:32:26.000",
      "text": "کمکار تیروید که نداشتی؟"
    },
    {
      "id": 54,
      "start": 16346.0,
      "end": 16349.0,
      "formatted_start": "04:32:26.000",
      "formatted_end": "04:32:29.000",
      "text": "از اینم روز درمیان بیشتر نه خواریا؟"
    },
    {
      "id": 55,
      "start": 16349.0,
      "end": 16352.0,
      "formatted_start": "04:32:29.000",
      "formatted_end": "04:32:32.000",
      "text": "چون تیرویدتونو کم کار میکنه"
    },
    {
      "id": 56,
      "start": 16352.0,
      "end": 16355.0,
      "formatted_start": "04:32:32.000",
      "formatted_end": "04:32:35.000",
      "text": "چی به اینجوری کردی درست دارو من؟"
    },
    {
      "id": 57,
      "start": 16355.0,
      "end": 16357.0,
      "formatted_start": "04:32:35.000",
      "formatted_end": "04:32:37.000",
      "text": "خب نه"
    },
    {
      "id": 58,
      "start": 16357.0,
      "end": 16361.0,
      "formatted_start": "04:32:37.000",
      "formatted_end": "04:32:41.000",
      "text": "هر کسی یه جوریه، یه سری مریض ها بهشون بیسازه"
    },
    {
      "id": 59,
      "start": 16361.0,
      "end": 16372.0,
      "formatted_start": "04:32:41.000",
      "formatted_end": "04:32:52.000",
      "text": "از اینجور، من مثلا، یک دورو بشه که یک دورو بگیری که مثلا، باید چونی بید بگم، این نفع بیده، هنال دیگه مگن، چهار روزی، فره هم منو بیده"
    },
    {
      "id": 60,
      "start": 16372.0,
      "end": 16375.0,
      "formatted_start": "04:32:52.000",
      "formatted_end": "04:32:55.000",
      "text": "بنابراین، وقت من، پرس ماشکتونه که داریم بیده"
    },
    {
      "id": 61,
      "start": 16375.0,
      "end": 16379.0,
      "formatted_start": "04:32:55.000",
      "formatted_end": "04:32:59.000",
      "text": "نه، نه، نه، در اینجور، از این یک فره هم، تو داره خوریجی که میروشه، خوری ماشکتونه است"
    },
    {
      "id": 62,
      "start": 16381.0,
      "end": 16382.0,
      "formatted_start": "04:33:01.000",
      "formatted_end": "04:33:02.000",
      "text": "اینجور درد داری؟"
    },
    {
      "id": 63,
      "start": 16383.0,
      "end": 16384.0,
      "formatted_start": "04:33:03.000",
      "formatted_end": "04:33:04.000",
      "text": "اینجور ها"
    },
    {
      "id": 64,
      "start": 16386.0,
      "end": 16388.0,
      "formatted_start": "04:33:06.000",
      "formatted_end": "04:33:08.000",
      "text": "پادشکنتون زیاد بیرون؟"
    },
    {
      "id": 65,
      "start": 16388.0,
      "end": 16418.0,
      "formatted_start": "04:33:08.000",
      "formatted_end": "04:33:38.000",
      "text": "در این وقت، در این وقت، در این وقت، در این وقت، در این وقت، در این وقت، در این وقت، در این وقت، در این وقت، در این وقت، در این وقت، در این وقت، در این وقت، در این وقت، در این وقت، در این وقت، در این وقت، در این وقت، در این وقت، در این وقت، در این وقت، در این وقت، در این وقت، در این وقت، در این وقت، در این وقت، در این وقت، در این وقت، در این وقت، در این وقت، در این وقت، در این وقت"
    },
    {
      "id": 66,
      "start": 16418.0,
      "end": 16421.24,
      "formatted_start": "04:33:38.000",
      "formatted_end": "04:33:41.240",
      "text": "این پنتوکاروزار ناشتا یه دونه بخون"
    },
    {
      "id": 67,
      "start": 16421.24,
      "end": 16422.68,
      "formatted_start": "04:33:41.240",
      "formatted_end": "04:33:42.680",
      "text": "من هم باید بردم"
    },
    {
      "id": 68,
      "start": 16422.68,
      "end": 16424.68,
      "formatted_start": "04:33:42.680",
      "formatted_end": "04:33:44.680",
      "text": "من هم خارجی برد بینمیسم"
    },
    {
      "id": 69,
      "start": 16424.68,
      "end": 16429.8,
      "formatted_start": "04:33:44.680",
      "formatted_end": "04:33:49.800",
      "text": "یه چیزی بینمیس که در قیمت چمشکاری یه چیزی دلیلی بسیار بینمیس کرده"
    },
    {
      "id": 70,
      "start": 16429.8,
      "end": 16431.8,
      "formatted_start": "04:33:49.800",
      "formatted_end": "04:33:51.800",
      "text": "یه عرضش نشون شکر کنه دوتور بخورم"
    },
    {
      "id": 71,
      "start": 16431.8,
      "end": 16435.0,
      "formatted_start": "04:33:51.800",
      "formatted_end": "04:33:55.000",
      "text": "اونم برد خارجی دمشت همه رو باده شکنه خوب"
    },
    {
      "id": 72,
      "start": 16435.0,
      "end": 16437.0,
      "formatted_start": "04:33:55.000",
      "formatted_end": "04:33:57.000",
      "text": "اون خیلی خوبه"
    },
    {
      "id": 73,
      "start": 16437.0,
      "end": 16439.0,
      "formatted_start": "04:33:57.000",
      "formatted_end": "04:33:59.000",
      "text": "بعد خوبه باد زیاد بخورم"
    },
    {
      "id": 74,
      "start": 16439.0,
      "end": 16441.0,
      "formatted_start": "04:33:59.000",
      "formatted_end": "04:34:01.000",
      "text": "مامات مکارانه"
    },
    {
      "id": 75,
      "start": 16441.0,
      "end": 16443.0,
      "formatted_start": "04:34:01.000",
      "formatted_end": "04:34:03.000",
      "text": "کلم کاهو"
    },
    {
      "id": 76,
      "start": 16443.0,
      "end": 16445.82,
      "formatted_start": "04:34:03.000",
      "formatted_end": "04:34:05.820",
      "text": "تو کلم که اون ریزو مصرف نمیدم اتفاقا"
    },
    {
      "id": 77,
      "start": 16445.82,
      "end": 16448.36,
      "formatted_start": "04:34:05.820",
      "formatted_end": "04:34:08.360",
      "text": "ورادی روزخانه بیره از خونه جشن مخالی"
    },
    {
      "id": 78,
      "start": 16448.36,
      "end": 16450.06,
      "formatted_start": "04:34:08.360",
      "formatted_end": "04:34:10.060",
      "text": "مثلا لب نزدم"
    },
    {
      "id": 79,
      "start": 16450.06,
      "end": 16453.5,
      "formatted_start": "04:34:10.060",
      "formatted_end": "04:34:13.500",
      "text": "مثلا سالات نمیخورم ای چی؟ تو دارم مصرف نمیدم همه"
    },
    {
      "id": 80,
      "start": 16453.5,
      "end": 16456.0,
      "formatted_start": "04:34:13.500",
      "formatted_end": "04:34:16.000",
      "text": "ناشته ای که نوشتم خارجی صبح بخورید"
    },
    {
      "id": 81,
      "start": 16456.0,
      "end": 16458.32,
      "formatted_start": "04:34:16.000",
      "formatted_end": "04:34:18.320",
      "text": "یه قصداری بعد از نهار و شام بخورید"
    },
    {
      "id": 82,
      "start": 16458.32,
      "end": 16461.22,
      "formatted_start": "04:34:18.320",
      "formatted_end": "04:34:21.220",
      "text": "یکم هست شمامان قبل خوابتونه خب؟"
    },
    {
      "id": 83,
      "start": 16461.22,
      "end": 16464.06,
      "formatted_start": "04:34:21.220",
      "formatted_end": "04:34:24.060",
      "text": "و این چون توش سویا داره"
    },
    {
      "id": 84,
      "start": 16464.06,
      "end": 16467.0,
      "formatted_start": "04:34:24.060",
      "formatted_end": "04:34:27.000",
      "text": "خود سویاش باد رو زیاد میکنه"
    },
    {
      "id": 85,
      "start": 16467.0,
      "end": 16469.24,
      "formatted_start": "04:34:27.000",
      "formatted_end": "04:34:29.240",
      "text": "آره و همونه نفت منشه"
    },
    {
      "id": 86,
      "start": 16469.24,
      "end": 16471.24,
      "formatted_start": "04:34:29.240",
      "formatted_end": "04:34:31.240",
      "text": "و دیگه همین گریزدنی هم بخوره"
    },
    {
      "id": 87,
      "start": 16471.24,
      "end": 16475.24,
      "formatted_start": "04:34:31.240",
      "formatted_end": "04:34:35.240",
      "text": "بله و شب بخور که باد میدازه خودتون مدن خالی کنه"
    },
    {
      "id": 88,
      "start": 16475.24,
      "end": 16478.24,
      "formatted_start": "04:34:35.240",
      "formatted_end": "04:34:38.240",
      "text": "اگه روز از یک بشی نفت بکنیم"
    },
    {
      "id": 89,
      "start": 16478.24,
      "end": 16481.24,
      "formatted_start": "04:34:38.240",
      "formatted_end": "04:34:41.240",
      "text": "نه مثلا نمیتونم را و نه مثلا باد میدن فقط"
    },
    {
      "id": 90,
      "start": 16481.24,
      "end": 16483.24,
      "formatted_start": "04:34:41.240",
      "formatted_end": "04:34:43.240",
      "text": "نه که بنایی شوید"
    },
    {
      "id": 91,
      "start": 16483.24,
      "end": 16485.24,
      "formatted_start": "04:34:43.240",
      "formatted_end": "04:34:45.240",
      "text": "بنایی شوید برده خانم دکتر"
    },
    {
      "id": 92,
      "start": 16485.24,
      "end": 16487.24,
      "formatted_start": "04:34:45.240",
      "formatted_end": "04:34:47.240",
      "text": "خیلی آدم داره"
    },
    {
      "id": 93,
      "start": 16487.24,
      "end": 16489.24,
      "formatted_start": "04:34:47.240",
      "formatted_end": "04:34:49.240",
      "text": "تسلیمو هایی بستن؟"
    },
    {
      "id": 94,
      "start": 16489.24,
      "end": 16490.24,
      "formatted_start": "04:34:49.240",
      "formatted_end": "04:34:50.240",
      "text": "نه"
    },
    {
      "id": 95,
      "start": 16490.24,
      "end": 16491.24,
      "formatted_start": "04:34:50.240",
      "formatted_end": "04:34:51.240",
      "text": "این خیلی خوبه این شوید"
    },
    {
      "id": 96,
      "start": 16491.24,
      "end": 16493.24,
      "formatted_start": "04:34:51.240",
      "formatted_end": "04:34:53.240",
      "text": "تسلیمو های دردی"
    },
    {
      "id": 97,
      "start": 16493.24,
      "end": 16495.24,
      "formatted_start": "04:34:53.240",
      "formatted_end": "04:34:55.240",
      "text": "خیلی برای اینجا نیخونده بگم"
    }
  ],
  "status": "completed"
}