      "formatted_start": "00:20:30.000",
      "formatted_end": "00:20:32.000",
      "text": "آقا خوش آنواشید"
    },
    {
      "id": 2,
      "start": 1232.0,
      "end": 1234.0,
      "formatted_start": "00:20:32.000",
      "formatted_end": "00:20:34.000",
      "text": "این حرفای شما زدید؟"
    },
    {
      "id": 3,
      "start": 1234.0,
      "end": 1236.0,
      "formatted_start": "00:20:34.000",
      "formatted_end": "00:20:36.000",
      "text": "خواهش که می بینید"
    },
    {
      "id": 4,
      "start": 1236.0,
      "end": 1240.0,
      "formatted_start": "00:20:36.000",
      "formatted_end": "00:20:40.000",
      "text": "آره اون بوده بیشینند اونا"
    },
    {
      "id": 5,
      "start": 1240.0,
      "end": 1244.0,
      "formatted_start": "00:20:40.000",
      "formatted_end": "00:20:44.000",
      "text": "آره می زد خب بقیه می آمون"
    },
    {
      "id": 6,
      "start": 1244.0,
      "end": 1246.0,
      "formatted_start": "00:20:44.000",
      "formatted_end": "00:20:46.000",
