      "end": 1358.0,
      "formatted_start": "00:22:36.000",
      "formatted_end": "00:22:38.000",
      "text": "باید اون در پایین خب"
    },
    {
      "id": 30,
      "start": 1358.0,
      "end": 1360.0,
      "formatted_start": "00:22:38.000",
      "formatted_end": "00:22:40.000",
      "text": "اینجا تو کلیت داری دیگه"
    },
    {
      "id": 31,
      "start": 1360.0,
      "end": 1385.0,
      "formatted_start": "00:22:40.000",
      "formatted_end": "00:23:05.000",
      "text": "موسیقی"
    },
    {
      "id": 32,
      "start": 1385.0,
      "end": 1387.0,
      "formatted_start": "00:23:05.000",
      "formatted_end": "00:23:07.000",
      "text": "خب اون هم مهم نیست، اون هم حل میشه"
    },
    {
      "id": 33,
      "start": 1388.0,
      "end": 1391.0,
      "formatted_start": "00:23:08.000",
      "formatted_end": "00:23:11.000",
      "text": "مهم اینه که رفتی رو همه چون"
