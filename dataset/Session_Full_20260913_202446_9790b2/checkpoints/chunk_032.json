  "stt_segments": [
    {
      "id": 0,
      "start": 9600.0,
      "end": 9602.0,
      "formatted_start": "02:40:00.000",
      "formatted_end": "02:40:02.000",
      "text": "شکولا در لژیمی میتونی؟"
    },
    {
      "id": 1,
      "start": 9602.0,
      "end": 9608.0,
      "formatted_start": "02:40:02.000",
      "formatted_end": "02:40:08.000",
      "text": "اصلا اینو خند شکولا در لژیمی و بیسکویت در لژیمی، اصل در لژیمی، روبه، کورنس، کورنس، اینو همه رو بذار کنید."
    },
    {
      "id": 2,
      "start": 9608.0,
      "end": 9609.0,
      "formatted_start": "02:40:08.000",
      "formatted_end": "02:40:09.000",
      "text": "نخوره؟"
    },
    {
      "id": 3,
      "start": 9609.0,
      "end": 9622.0,
      "formatted_start": "02:40:09.000",
      "formatted_end": "02:40:22.000",
      "text": "اصلا شبیه با دو سه تا مویز، جوت خوش، کرد چقدرش میتونید، یک چهاره خورما خوش، یک دونه مثلا انما، یانتر،"
    },
    {
      "id": 4,
      "start": 9622.0,
      "end": 9628.0,
      "formatted_start": "02:40:22.000",
      "formatted_end": "02:40:28.000",
      "text": "برنجش چقدر باشه؟ 10 الان 12 باشه و حد اکثر"
    },
    {
      "id": 5,
      "start": 9628.0,
      "end": 9633.0,
      "formatted_start": "02:40:28.000",
      "formatted_end": "02:40:33.000",
      "text": "باید چون سیر نمیشید با عدس، ماش، یه چشم بار بارید"
    },
    {
      "id": 6,
      "start": 9633.0,
      "end": 9638.0,
      "formatted_start": "02:40:33.000",
      "formatted_end": "02:40:38.000",
      "text": "از اینه 5-6 آشق میتونید بزنید، یه هجم غذا سیار بشه"
    },
    {
      "id": 7,
      "start": 9638.0,
      "end": 9643.0,
      "formatted_start": "02:40:38.000",
      "formatted_end": "02:40:43.000",
      "text": "قبل غذا، خیار، گوجه، که آخون کلم این ها با این ها خودتو سیر کن"
    },
    {
      "id": 8,
      "start": 9643.0,
      "end": 9646.0,
      "formatted_start": "02:40:43.000",
      "formatted_end": "02:40:46.000",
      "text": "بعد سر صفر غذا میشید"
    },
    {
      "id": 9,
      "start": 9646.0,
      "end": 9648.0,
      "formatted_start": "02:40:46.000",
      "formatted_end": "02:40:48.000",
      "text": "میوه هم در روز پنج تا میتونه بخورید"
    },
    {
      "id": 10,
      "start": 9648.0,
      "end": 9650.0,
      "formatted_start": "02:40:48.000",
      "formatted_end": "02:40:50.000",
      "text": "که دوست بخونه که بهت بخواستم"
    },
    {
      "id": 11,
      "start": 9650.0,
      "end": 9652.0,
      "formatted_start": "02:40:50.000",
      "formatted_end": "02:40:52.000",
      "text": "به شما نمیدونه"
    },
    {
      "id": 12,
      "start": 9652.0,
      "end": 9654.0,
      "formatted_start": "02:40:52.000",
      "formatted_end": "02:40:54.000",
      "text": "هر چیزی به دهان شما شیری نسم"
    },
    {
      "id": 13,
      "start": 9654.0,
      "end": 9656.0,
      "formatted_start": "02:40:54.000",
      "formatted_end": "02:40:56.000",
      "text": "غنده خود"
    },
    {
      "id": 14,
      "start": 9656.0,
      "end": 9658.0,
      "formatted_start": "02:40:56.000",
      "formatted_end": "02:40:58.000",
      "text": "آر اینجاست میتونه بخورد"
    },
    {
      "id": 15,
      "start": 9658.0,
      "end": 9660.0,
      "formatted_start": "02:40:58.000",
      "formatted_end": "02:41:00.000",
      "text": "به جز هندونه"
    },
    {
      "id": 16,
      "start": 9660.0,
      "end": 9662.0,
      "formatted_start": "02:41:00.000",
      "formatted_end": "02:41:02.000",
      "text": "هر گوزه"
    },
    {
      "id": 17,
      "start": 9662.0,
      "end": 9664.0,
      "formatted_start": "02:41:02.000",
      "formatted_end": "02:41:04.000",
      "text": "انگور"
    },
    {
      "id": 18,
      "start": 9664.0,
      "end": 9666.0,
      "formatted_start": "02:41:04.000",
      "formatted_end": "02:41:06.000",
      "text": "انجیر و مز بخواهی چیزا موجود"
    },
    {
      "id": 19,
      "start": 9666.0,
      "end": 9668.0,
      "formatted_start": "02:41:06.000",
      "formatted_end": "02:41:08.000",
      "text": "انجیر هم اگر شیرون بود"
    },
    {
      "id": 20,
      "start": 9668.0,
      "end": 9670.0,
      "formatted_start": "02:41:08.000",
      "formatted_end": "02:41:10.000",
      "text": "بگرن میتونه"
    },
    {
      "id": 21,
      "start": 9670.0,
      "end": 9672.0,
      "formatted_start": "02:41:10.000",
      "formatted_end": "02:41:12.000",
      "text": "روزی پنج تا میوه هم میتونه بخورد"
    },
    {
      "id": 22,
      "start": 9672.0,
      "end": 9674.0,
      "formatted_start": "02:41:12.000",
      "formatted_end": "02:41:14.000",
      "text": "یه خیار یه خوردور یه خیار یه سیخ"
    },
    {
      "id": 23,
      "start": 9674.0,
      "end": 9677.0,
      "formatted_start": "02:41:14.000",
      "formatted_end": "02:41:17.000",
      "text": "شب قبل خواب حتما برد چیزی بخورن"
    },
    {
      "id": 24,
      "start": 9677.0,
      "end": 9679.0,
      "formatted_start": "02:41:17.000",
      "formatted_end": "02:41:19.000",
      "text": "پیاده روی باید بکنن"
    },
    {
      "id": 25,
      "start": 9679.0,
      "end": 9681.0,
      "formatted_start": "02:41:19.000",
      "formatted_end": "02:41:21.000",
      "text": "ولی با ترجیح و شرایطتون کنن"
    },
    {
      "id": 26,
      "start": 9681.0,
      "end": 9683.0,
      "formatted_start": "02:41:21.000",
      "formatted_end": "02:41:23.000",
      "text": "شرایطتون بردن به خود از خواه نداری"
    },
    {
      "id": 27,
      "start": 9683.0,
      "end": 9686.0,
      "formatted_start": "02:41:23.000",
      "formatted_end": "02:41:26.000",
      "text": "برای چربیتون هم که واقعا اصلا نداد باشه"
    },
    {
      "id": 28,
      "start": 9686.0,
      "end": 9688.0,
      "formatted_start": "02:41:26.000",
      "formatted_end": "02:41:28.000",
      "text": "غذا همه باید آپست باشه"
    },
    {
      "id": 29,
      "start": 9688.0,
      "end": 9692.0,
      "formatted_start": "02:41:28.000",
      "formatted_end": "02:41:32.000",
      "text": "فعلا توپه موه و گوشت قرمز فعلا ممنونه"
    },
    {
      "id": 30,
      "start": 9692.0,
      "end": 9695.0,
      "formatted_start": "02:41:32.000",
      "formatted_end": "02:41:35.000",
      "text": "اصلا نباید بخویدی همه هم غذا ها آپست"
    },
    {
      "id": 31,
      "start": 9695.0,
      "end": 9702.0,
      "formatted_start": "02:41:35.000",
      "formatted_end": "02:41:42.000",
      "text": "آره، کره خامه اصلا سرشی با اینها"
    },
    {
      "id": 32,
      "start": 9702.0,
      "end": 9709.38,
      "formatted_start": "02:41:42.000",
      "formatted_end": "02:41:49.380",
      "text": "از آنها، غذا هاتم که بدون روغن برنجت خیلی کم روغن، ترجیح همون روغن از زیتون یا کنجه ده"
    },
    {
      "id": 33,
      "start": 9709.38,
      "end": 9712.98,
      "formatted_start": "02:41:49.380",
      "formatted_end": "02:41:52.980",
      "text": "باید از جای مطمئن بخرید ناکرد اصلش بازید"
    },
    {
      "id": 34,
      "start": 9712.98,
      "end": 9718.32,
      "formatted_start": "02:41:52.980",
      "formatted_end": "02:41:58.320",
      "text": "اگر نه همون روغنتو بزن خیلی کم، سریع کن غذاها تو دیگه همه رو آن پس درست برد"
    },
    {
      "id": 35,
      "start": 9718.32,
      "end": 9721.28,
      "formatted_start": "02:41:58.320",
      "formatted_end": "02:42:01.280",
      "text": "در چیه برد خوبه؟"
    },
    {
      "id": 36,
      "start": 9721.28,
      "end": 9724.02,
      "formatted_start": "02:42:01.280",
      "formatted_end": "02:42:04.020",
      "text": "ببین گزنه به جشونی هفته یکی دو بار بود"
    },
    {
      "id": 37,
      "start": 9724.02,
      "end": 9727.7,
      "formatted_start": "02:42:04.020",
      "formatted_end": "02:42:07.700",
      "text": "شمبلیله بخورید خوبه"
    },
    {
      "id": 38,
      "start": 9727.7,
      "end": 9729.58,
      "formatted_start": "02:42:07.700",
      "formatted_end": "02:42:09.580",
      "text": "تو برنجت بلیزید"
    },
    {
      "id": 39,
      "start": 9729.58,
      "end": 9735.22,
      "formatted_start": "02:42:09.580",
      "formatted_end": "02:42:15.220",
      "text": "دارچین و چای اگه حساسیت بدید جانب خالش دارید که حساسیت بدید"
    },
    {
      "id": 40,
      "start": 9735.22,
      "end": 9737.22,
      "formatted_start": "02:42:15.220",
      "formatted_end": "02:42:17.220",
      "text": "آمیه خیلی برای تو بوده"
    },
    {
      "id": 41,
      "start": 9737.22,
      "end": 9739.82,
      "formatted_start": "02:42:17.220",
      "formatted_end": "02:42:19.820",
      "text": "این رو آپست کنی همون شامل بگویی"
    },
    {
      "id": 42,
      "start": 9739.82,
      "end": 9741.82,
      "formatted_start": "02:42:19.820",
      "formatted_end": "02:42:21.820",
      "text": "شاملون چقدر کفت است؟"
    },
    {
      "id": 43,
      "start": 9741.82,
      "end": 9744.94,
      "formatted_start": "02:42:21.820",
      "formatted_end": "02:42:24.940",
      "text": "حالا اینی که من میگم فرد و صبح که نمیشه نیم بشی"
    },
    {
      "id": 44,
      "start": 9744.94,
      "end": 9746.94,
      "formatted_start": "02:42:24.940",
      "formatted_end": "02:42:26.940",
      "text": "ولی به این سر اون برسیم"
    },
    {
      "id": 45,
      "start": 9746.94,
      "end": 9750.14,
      "formatted_start": "02:42:26.940",
      "formatted_end": "02:42:30.140",
      "text": "نون اینجای کفت است میبنیم دقیق کچی کچی رو درست میبنیم"
    },
    {
      "id": 46,
      "start": 9750.14,
      "end": 9753.34,
      "formatted_start": "02:42:30.140",
      "formatted_end": "02:42:33.340",
      "text": "همکنه سر کنیم بیشتر با مثلا کبه آنپست"
    },
    {
      "id": 47,
      "start": 9753.34,
      "end": 9756.58,
      "formatted_start": "02:42:33.340",
      "formatted_end": "02:42:36.580",
      "text": "لباش نمیشه تا این بی بالاست"
    },
    {
      "id": 48,
      "start": 9756.58,
      "end": 9760.66,
      "formatted_start": "02:42:36.580",
      "formatted_end": "02:42:40.660",
      "text": "اصلا ترجیه اینه منونه سنگرد یا جورد"
    },
    {
      "id": 49,
      "start": 9760.66,
      "end": 9765.84,
      "formatted_start": "02:42:40.660",
      "formatted_end": "02:42:45.840",
      "text": "درمونو بردارو بردارو"
    },
    {
      "id": 50,
      "start": 9765.84,
      "end": 9767.9,
      "formatted_start": "02:42:45.840",
      "formatted_end": "02:42:47.900",
      "text": "برای کمها کشیمی بردارو"
    },
    {
      "id": 51,
      "start": 9767.9,
      "end": 9769.48,
      "formatted_start": "02:42:47.900",
      "formatted_end": "02:42:49.480",
      "text": "برای سویتان بردارو"
    },
    {
      "id": 52,
      "start": 9769.48,
      "end": 9772.3,
      "formatted_start": "02:42:49.480",
      "formatted_end": "02:42:52.300",
      "text": "برسا قرار زیب ند بردارو"
    },
    {
      "id": 53,
      "start": 9772.3,
      "end": 9773.12,
      "formatted_start": "02:42:52.300",
      "formatted_end": "02:42:53.120",
      "text": "برای سنگرد"
    },
    {
      "id": 54,
      "start": 9773.12,
      "end": 9773.34,
      "formatted_start": "02:42:53.120",
      "formatted_end": "02:42:53.340",
      "text": "برای سنگرد"
    },
    {
