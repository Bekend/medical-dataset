      "start": 9781.34,
      "end": 9783.32,
      "formatted_start": "02:43:01.340",
      "formatted_end": "02:43:03.320",
      "text": "برای سنگرد"
    },
    {
      "id": 60,
      "start": 9783.32,
      "end": 9789.32,
      "formatted_start": "02:43:03.320",
      "formatted_end": "02:43:09.320",
      "text": "اول متفرمه ایرانی این زمان رو بهش می سازه چون این بیشتر اشتعارو کم می کنه"
    },
    {
      "id": 61,
      "start": 9789.32,
      "end": 9792.32,
      "formatted_start": "02:43:09.320",
      "formatted_end": "02:43:12.320",
      "text": "صبح و شب"
    },
    {
      "id": 62,
      "start": 9792.32,
      "end": 9796.32,
      "formatted_start": "02:43:12.320",
      "formatted_end": "02:43:16.320",
      "text": "یک باز دیگه برده مادرتون و پدرتون من داشتم؟"
    },
    {
      "id": 63,
      "start": 9796.32,
      "end": 9800.32,
      "formatted_start": "02:43:16.320",
      "formatted_end": "02:43:20.320",
      "text": "پدر مادر سابق سکت هم داشتم؟"
    },
    {
      "id": 64,
      "start": 9800.32,
      "end": 9805.32,
      "formatted_start": "02:43:20.320",
      "formatted_end": "02:43:25.320",
