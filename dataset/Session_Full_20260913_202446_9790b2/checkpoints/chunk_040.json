  "stt_segments": [
    {
      "id": 0,
      "start": 12000.0,
      "end": 12008.0,
      "formatted_start": "03:20:00.000",
      "formatted_end": "03:20:08.000",
      "text": "از آزمایش ها شما بشون رو ترمه نیستن، بیماری شده دار."
    },
    {
      "id": 1,
      "start": 12008.0,
      "end": 12013.0,
      "formatted_start": "03:20:08.000",
      "formatted_end": "03:20:13.000",
      "text": "باید دارو تزرگ شده بشه، پاید دویتر بگو یه هفته تو خونه بزار دارو بخواهد بین."
    },
    {
      "id": 2,
      "start": 12013.0,
      "end": 12015.0,
      "formatted_start": "03:20:13.000",
      "formatted_end": "03:20:15.000",
      "text": "تزرگی هم تو خونه؟"
    },
    {
      "id": 3,
      "start": 12015.0,
      "end": 12022.0,
      "formatted_start": "03:20:15.000",
      "formatted_end": "03:20:22.000",
      "text": "نه نه، تزرگی هفته یه خواره یه سری آن فوله بشه، باید خوبه تا حساس بابارشت نیست."
    },
    {
      "id": 4,
      "start": 12022.0,
      "end": 12028.0,
      "formatted_start": "03:20:22.000",
      "formatted_end": "03:20:28.000",
      "text": "از این تکشتی بی کار مردم باشیم"
    },
    {
      "id": 5,
      "start": 12028.0,
      "end": 12034.0,
      "formatted_start": "03:20:28.000",
      "formatted_end": "03:20:34.000",
      "text": "از این تکشتی بی کار مردم باشیم"
    },
    {
      "id": 6,
      "start": 12034.0,
      "end": 12040.0,
      "formatted_start": "03:20:34.000",
      "formatted_end": "03:20:40.000",
      "text": "هر جایی که شما بیماری میگردید، در یکی که توی سایت های این حالت ممکن بگیرد؟"
    },
    {
      "id": 7,
      "start": 12040.0,
      "end": 12044.0,
      "formatted_start": "03:20:40.000",
      "formatted_end": "03:20:44.000",
      "text": "بیماری استفاده استفاده میگه جدا"
    },
    {
      "id": 8,
      "start": 12044.0,
      "end": 12048.0,
      "formatted_start": "03:20:44.000",
      "formatted_end": "03:20:48.000",
      "text": "یعنی درمان می کنند"
    },
    {
      "id": 9,
      "start": 12048.0,
      "end": 12053.0,
      "formatted_start": "03:20:48.000",
      "formatted_end": "03:20:53.000",
      "text": "اول این ورس رو میدن، بعد این ورس رو میدن، بعد جاوب نوم دو تحضیق اینا میدن"
    },
    {
      "id": 10,
      "start": 12053.0,
      "end": 12056.0,
      "formatted_start": "03:20:53.000",
      "formatted_end": "03:20:56.000",
      "text": "بعد تحضیقی هفته، جاوب نوم دو تحضیقی شش ماهه میدن"
    },
    {
      "id": 11,
      "start": 12056.0,
      "end": 12062.0,
      "formatted_start": "03:20:56.000",
      "formatted_end": "03:21:02.000",
      "text": "یه قانون داره، این مثلا یه جایی که بگی فردان همه چند تیران همه چند هم بیدن"
    },
    {
      "id": 12,
      "start": 12062.0,
      "end": 12067.0,
      "formatted_start": "03:21:02.000",
      "formatted_end": "03:21:07.000",
      "text": "یعنی استرکوست، مثلا من همه چیزشون رو از این بابت خیالم راحته که دولتشون شد"
    },
    {
      "id": 13,
      "start": 12067.0,
      "end": 12071.0,
      "formatted_start": "03:21:07.000",
      "formatted_end": "03:21:11.000",
      "text": "سر تنها رو چند بار چک کردن من خیلی، از این بابت خوشبه نمیدونم"
    },
    {
      "id": 14,
      "start": 12071.0,
      "end": 12074.0,
      "formatted_start": "03:21:11.000",
      "formatted_end": "03:21:14.000",
      "text": "برای بیماریش داره شدید پیش میشه"
    },
    {
      "id": 15,
      "start": 12074.0,
      "end": 12077.0,
      "formatted_start": "03:21:14.000",
      "formatted_end": "03:21:17.000",
      "text": "بیرون پیش میره با بگه عوارض بیمار زیاد میشه یکم"
    },
    {
      "id": 16,
      "start": 12077.0,
      "end": 12080.0,
      "formatted_start": "03:21:17.000",
      "formatted_end": "03:21:20.000",
      "text": "برای از عذیب میشه ایتیکش برده"
    },
    {
      "id": 17,
      "start": 12080.0,
      "end": 12083.0,
      "formatted_start": "03:21:20.000",
      "formatted_end": "03:21:23.000",
      "text": "اصلا تاثر میزنید با شما"
    },
    {
      "id": 18,
      "start": 12083.0,
      "end": 12086.0,
      "formatted_start": "03:21:23.000",
      "formatted_end": "03:21:26.000",
      "text": "از اینکه من یه درمیزی تیم عیس رو تظهر کنم باشم بله"
    },
    {
      "id": 19,
      "start": 12086.0,
      "end": 12089.0,
      "formatted_start": "03:21:26.000",
      "formatted_end": "03:21:29.000",
      "text": "بله بیمار رو تظهر کنید؟ نه، پرونت میزنم بله"
    },
    {
      "id": 20,
      "start": 12089.0,
      "end": 12094.0,
      "formatted_start": "03:21:29.000",
      "formatted_end": "03:21:34.000",
      "text": "میخواستم به خودتون بگم، ولی به درد هم چون استرسی خیلی نمیشه بشکنم"
    },
    {
      "id": 21,
      "start": 12094.0,
      "end": 12096.0,
      "formatted_start": "03:21:34.000",
      "formatted_end": "03:21:36.000",
      "text": "و اینوز به دکتر وای توضیح دادم"
    },
    {
      "id": 22,
      "start": 12096.0,
      "end": 12099.0,
      "formatted_start": "03:21:36.000",
      "formatted_end": "03:21:39.000",
      "text": "تو خلاصه پروندهش کامل همه چیز رو نوشتم"
    },
    {
      "id": 23,
      "start": 12099.0,
      "end": 12101.0,
      "formatted_start": "03:21:39.000",
      "formatted_end": "03:21:41.000",
      "text": "برای دارو تصویب شروع کردن"
    },
    {
      "id": 24,
      "start": 12101.0,
      "end": 12104.0,
      "formatted_start": "03:21:41.000",
      "formatted_end": "03:21:44.000",
      "text": "مثل یه آزمایش لازمه و یه تست سهر اینا ها"
    },
    {
      "id": 25,
      "start": 12104.0,
      "end": 12107.0,
      "formatted_start": "03:21:44.000",
      "formatted_end": "03:21:47.000",
      "text": "تو برای نوشتم که من همه رو انجام دادم"
    },
    {
      "id": 26,
      "start": 12107.0,
      "end": 12111.0,
      "formatted_start": "03:21:47.000",
      "formatted_end": "03:21:51.000",
      "text": "یعنی مریض رو تیری مدت آماده کردم برای شروع دارو تصویب"
    },
    {
      "id": 27,
      "start": 12111.0,
      "end": 12113.0,
      "formatted_start": "03:21:51.000",
      "formatted_end": "03:21:53.000",
      "text": "افتلاح همش درخواه گفته میده"
    },
    {
      "id": 28,
      "start": 12113.0,
      "end": 12116.0,
      "formatted_start": "03:21:53.000",
      "formatted_end": "03:21:56.000",
      "text": "چون بی نشستم وقتی بهش میگه سرسته میشه"
    },
    {
      "id": 29,
      "start": 12116.0,
      "end": 12121.0,
      "formatted_start": "03:21:56.000",
      "formatted_end": "03:22:01.000",
      "text": "بعد خون زنم و گفتم این کار را با دو تا قرار است و بعد کردیم خون بزنیم همه چی شرکتش آمد است"
    },
    {
      "id": 30,
      "start": 12121.0,
      "end": 12125.0,
      "formatted_start": "03:22:01.000",
      "formatted_end": "03:22:05.000",
      "text": "ما ایشان را خواستیم همه چی آمد است که داره تذیر شده شده شده"
    },
    {
      "id": 31,
      "start": 12125.0,
      "end": 12127.0,
      "formatted_start": "03:22:05.000",
      "formatted_end": "03:22:07.000",
      "text": "اوارست داره با جوانجی؟"
    },
    {
      "id": 32,
      "start": 12127.0,
      "end": 12132.0,
      "formatted_start": "03:22:07.000",
      "formatted_end": "03:22:12.000",
      "text": "اوارست که همونطور کسی نمیدونه داره یا نخواه"
    },
    {
      "id": 33,
      "start": 12132.0,
      "end": 12135.0,
      "formatted_start": "03:22:12.000",
      "formatted_end": "03:22:15.000",
      "text": "توی خیلی بیماره روماتیزمی همه داره داره اوارست"
    },
    {
      "id": 34,
      "start": 12135.0,
      "end": 12138.0,
      "formatted_start": "03:22:15.000",
      "formatted_end": "03:22:18.000",
      "text": "چیزی که بگیر یه اوارست خیلی شناخته شده شده نه"
    },
    {
      "id": 35,
      "start": 12138.0,
      "end": 12139.0,
      "formatted_start": "03:22:18.000",
      "formatted_end": "03:22:19.000",
      "text": "نه، بدونی"
    },
    {
      "id": 36,
      "start": 12139.0,
      "end": 12141.0,
      "formatted_start": "03:22:19.000",
      "formatted_end": "03:22:21.000",
      "text": "نه، مثلا بیوالی سرگیجه و..."
    },
    {
      "id": 37,
      "start": 12141.0,
      "end": 12142.0,
      "formatted_start": "03:22:21.000",
      "formatted_end": "03:22:22.000",
      "text": "نه، نه، نه"
    },
    {
      "id": 38,
      "start": 12142.0,
      "end": 12145.0,
      "formatted_start": "03:22:22.000",
      "formatted_end": "03:22:25.000",
      "text": "از جزء به نوعی صابه دیگه و سرگیجه؟"
    },
    {
      "id": 39,
      "start": 12145.0,
      "end": 12149.0,
      "formatted_start": "03:22:25.000",
      "formatted_end": "03:22:29.000",
      "text": "نه، این آنفول زیر جدید استعمال بالاتری از درمانه دیگه"
    },
    {
      "id": 40,
      "start": 12149.0,
      "end": 12152.0,
      "formatted_start": "03:22:29.000",
      "formatted_end": "03:22:32.000",
      "text": "یعنی ما دعا میکنیم باز به این جواب بده"
    },
    {
      "id": 41,
      "start": 12152.0,
      "end": 12155.0,
      "formatted_start": "03:22:32.000",
      "formatted_end": "03:22:35.000",
      "text": "باز مثلا به داروی از ریتوکسیم هم نخواهیم"
    },
    {
      "id": 42,
      "start": 12155.0,
      "end": 12157.0,
      "formatted_start": "03:22:35.000",
      "formatted_end": "03:22:37.000",
      "text": "چون ریتوکسیم هم اصلا خیلی سخت بدم"
    },
    {
      "id": 43,
      "start": 12157.0,
      "end": 12161.0,
      "formatted_start": "03:22:37.000",
      "formatted_end": "03:22:41.000",
      "text": "چون مدت هم توی ایان نبود، تازه هر نام نکرد شده"
    },
    {
      "id": 44,
      "start": 12161.0,
      "end": 12162.0,
      "formatted_start": "03:22:41.000",
      "formatted_end": "03:22:42.000",
      "text": "برده"
    },
    {
      "id": 45,
      "start": 12162.5,
      "end": 12165.0,
      "formatted_start": "03:22:42.500",
      "formatted_end": "03:22:45.000",
      "text": "اما تا شخصیتشو میره باید تینه عوض کنید"
    },
    {
      "id": 46,
      "start": 12165.0,
      "end": 12169.0,
      "formatted_start": "03:22:45.000",
      "formatted_end": "03:22:49.000",
      "text": "به شدت از این بیماری بیماری آدم های از دستیم"
    },
    {
      "id": 47,
      "start": 12169.0,
      "end": 12173.0,
      "formatted_start": "03:22:49.000",
      "formatted_end": "03:22:53.000",
      "text": "و اگه پیشرفت کنید خیلی عوض به سختی داره"
    },
    {
      "id": 48,
      "start": 12174.0,
      "end": 12178.0,
      "formatted_start": "03:22:54.000",
      "formatted_end": "03:22:58.000",
      "text": "اگه حقیقتی من شاید فکر کنم سه تا مریض دارم تا اینقدر پیچیده شدن"
    },
    {
      "id": 49,
      "start": 12178.0,
      "end": 12180.0,
      "formatted_start": "03:22:58.000",
      "formatted_end": "03:23:00.000",
      "text": "مهمانی روز کنید"
    },
    {
      "id": 50,
      "start": 12181.0,
      "end": 12184.0,
      "formatted_start": "03:23:01.000",
      "formatted_end": "03:23:04.000",
      "text": "خان با چی؟ بیا خانم دوست کن"
    },
    {
      "id": 51,
      "start": 12184.0,
      "end": 12186.0,
      "formatted_start": "03:23:04.000",
      "formatted_end": "03:23:06.000",
      "text": "این خانم رو دوست کن"
    },
    {
      "id": 52,
      "start": 12186.0,
      "end": 12188.0,
      "formatted_start": "03:23:06.000",
      "formatted_end": "03:23:08.000",
      "text": "بیا بده سیتیشو بگیره بیا"
    },
    {
      "id": 53,
      "start": 12188.0,
      "end": 12189.0,
      "formatted_start": "03:23:08.000",
      "formatted_end": "03:23:09.000",
      "text": "جمع"
    },
    {
      "id": 54,
      "start": 12189.0,
      "end": 12192.2,
      "formatted_start": "03:23:09.000",
      "formatted_end": "03:23:12.200",
      "text": "براش سیده شد سبکم چون استفاده میدونید چیز را بزنید"
    },
    {
      "id": 55,
      "start": 12192.2,
      "end": 12195.16,
      "formatted_start": "03:23:12.200",
      "formatted_end": "03:23:15.160",
      "text": "من این کود بیده مامان بردیم"
    },
    {
      "id": 56,
      "start": 12195.16,
      "end": 12195.72,
      "formatted_start": "03:23:15.160",
      "formatted_end": "03:23:15.720",
      "text": "نه"
    },
    {
      "id": 57,
      "start": 12195.72,
      "end": 12198.74,
      "formatted_start": "03:23:15.720",
      "formatted_end": "03:23:18.740",
      "text": "این عداله پیدا کنم"
    },
    {
      "id": 58,
      "start": 12198.74,
      "end": 12199.5,
      "formatted_start": "03:23:18.740",
      "formatted_end": "03:23:19.500",
      "text": "نه"
    },
    {
      "id": 59,
      "start": 12199.5,
      "end": 12211.0,
      "formatted_start": "03:23:19.500",
      "formatted_end": "03:23:31.000",
      "text": "خودیش بگو کجا تعمل داری؟"
    },
    {
      "id": 60,
      "start": 12212.42,
      "end": 12214.24,
      "formatted_start": "03:23:32.420",
      "formatted_end": "03:23:34.240",
      "text": "شهزده روز چور"
    },
    {
      "id": 61,
      "start": 12214.24,
      "end": 12215.34,
      "formatted_start": "03:23:34.240",
      "formatted_end": "03:23:35.340",
      "text": "کمان؟"
    },
    {
      "id": 62,
      "start": 12215.34,
      "end": 12216.84,
      "formatted_start": "03:23:35.340",
      "formatted_end": "03:23:36.840",
      "text": "نفتر و سیده چور"
    },
    {
      "id": 63,
      "start": 12216.84,
      "end": 12218.82,
      "formatted_start": "03:23:36.840",
      "formatted_end": "03:23:38.820",
      "text": "هفته و هفت شده سه"
    },
    {
      "id": 64,
      "start": 12218.82,
      "end": 12222.82,
      "formatted_start": "03:23:38.820",
      "formatted_end": "03:23:42.820",
      "text": "و از مثلا فرق بازارات دورنی میشه چون دیگه یا نه؟"
    },
    {
      "id": 65,
      "start": 12222.82,
      "end": 12224.82,
      "formatted_start": "03:23:42.820",
      "formatted_end": "03:23:44.820",
      "text": "شما دنبال موقع گرفتن باشیم"
    },
    {
      "id": 66,
      "start": 12224.82,
      "end": 12227.82,
      "formatted_start": "03:23:44.820",
      "formatted_end": "03:23:47.820",
      "text": "اون گیمارستانی که چه را ترانسوال آوانی گفتی؟"
    },
    {
      "id": 67,
      "start": 12227.82,
      "end": 12229.82,
      "formatted_start": "03:23:47.820",
      "formatted_end": "03:23:49.820",
      "text": "حالا گیمارستان نیست مانو"
    },
    {
      "id": 68,
      "start": 12229.82,
      "end": 12232.82,
      "formatted_start": "03:23:49.820",
      "formatted_end": "03:23:52.820",
      "text": "چون خوریشو زدیم و همه چشم داره"
    },
    {
      "id": 69,
      "start": 12232.82,
      "end": 12234.82,
      "formatted_start": "03:23:52.820",
      "formatted_end": "03:23:54.820",
      "text": "خب نه اون گیمارستان دستگاهی که داره بهتره؟"
    },
    {
      "id": 70,
      "start": 12234.82,
      "end": 12236.82,
      "formatted_start": "03:23:54.820",
      "formatted_end": "03:23:56.820",
      "text": "اصلا نه، اصلا دیگه دستگاهی نیست"
    },
    {
      "id": 71,
      "start": 12236.82,
      "end": 12239.82,
      "formatted_start": "03:23:56.820",
      "formatted_end": "03:23:59.820",
      "text": "همه کاره مانو نجام شده، تشخیصش مشخصه"
    },
    {
      "id": 72,
      "start": 12239.82,
      "end": 12243.82,
      "formatted_start": "03:23:59.820",
      "formatted_end": "03:24:03.820",
      "text": "همینجا هم دکتر گوهرشای اینجا همیتونه شروع کنن"
    },
    {
      "id": 73,
      "start": 12243.82,
      "end": 12249.82,
      "formatted_start": "03:24:03.820",
      "formatted_end": "03:24:09.820",
      "text": "خودم هم دکتر غلاویه دکتر سنجایی که از این دکترهای دوستانجایی کمتر بر اخلاقیه"
    },
    {
      "id": 74,
      "start": 12249.82,
      "end": 12253.82,
      "formatted_start": "03:24:09.820",
      "formatted_end": "03:24:13.820",
      "text": "ماشهد اگه میخواد بیایید پاستور یک دکتر فرید اون موردی موردی موردن"
    },
    {
      "id": 75,
      "start": 12253.82,
      "end": 12257.82,
      "formatted_start": "03:24:13.820",
      "formatted_end": "03:24:17.820",
      "text": "ولی تا اون بریم این کم بیرون میشه فعلا دکتر غلاویه بریم ببینیم"
    },
    {
      "id": 76,
      "start": 12257.82,
      "end": 12263.82,
      "formatted_start": "03:24:17.820",
      "formatted_end": "03:24:23.820",
      "text": "ماشد اگر میخوان دیگه پاستور یک دوتا فریدی موردی موردن"
    },
    {
      "id": 77,
      "start": 12263.82,
      "end": 12267.82,
      "formatted_start": "03:24:23.820",
      "formatted_end": "03:24:27.820",
      "text": "ولی تا اون بریم یکم دیگه میشه فعلا دوتا قربی بریم بریم"
    },
    {
      "id": 78,
      "start": 12267.82,
      "end": 12270.82,
      "formatted_start": "03:24:27.820",
      "formatted_end": "03:24:30.820",
      "text": "مامان چون مادر دوتا قربی ریزه همه معیز رو میدونه"
    },
    {
      "id": 79,
      "start": 12270.82,
      "end": 12272.82,
      "formatted_start": "03:24:30.820",
      "formatted_end": "03:24:32.820",
      "text": "مثل دیگه اون رضایی برای فصلی؟"
    },
    {
      "id": 80,
      "start": 12272.82,
      "end": 12275.82,
      "formatted_start": "03:24:32.820",
      "formatted_end": "03:24:35.820",
      "text": "اصلا من گوه من شیست سال ماشد مطلب شدم"
    },
    {
      "id": 81,
      "start": 12275.82,
      "end": 12278.82,
      "formatted_start": "03:24:35.820",
      "formatted_end": "03:24:38.820",
      "text": "رضایی اونها علم نداره که فقط هوتله"
    },
    {
      "id": 82,
      "start": 12278.82,
      "end": 12281.82,
      "formatted_start": "03:24:38.820",
      "formatted_end": "03:24:41.820",
      "text": "ما اون که دنبال مکانه خوشگلی میگرده"
    },
    {
      "id": 83,
      "start": 12281.82,
      "end": 12283.82,
      "formatted_start": "03:24:41.820",
      "formatted_end": "03:24:43.820",
      "text": "ما معیزمون خوب برشن"
    },
    {
      "id": 84,
      "start": 12283.82,
      "end": 12286.42,
      "formatted_start": "03:24:43.820",
      "formatted_end": "03:24:46.420",
      "text": "اینا همه هوتلینگه یعنی فقط من مرگزمونم"
    },
    {
      "id": 85,
      "start": 12286.42,
      "end": 12288.02,
      "formatted_start": "03:24:46.420",
      "formatted_end": "03:24:48.020",
      "text": "میخوام که علمی باشیم"
    },
    {
      "id": 86,
      "start": 12288.02,
      "end": 12290.52,
      "formatted_start": "03:24:48.020",
      "formatted_end": "03:24:50.520",
      "text": "چون این بیماری سر و خوردگی هیچی سادگی نیست"
    },
    {
      "id": 87,
      "start": 12290.52,
      "end": 12292.92,
      "formatted_start": "03:24:50.520",
      "formatted_end": "03:24:52.920",
      "text": "یا مثلا عمل قلب خوبالا بریم رزده هوتلینگ داره"
    },
    {
      "id": 88,
      "start": 12292.92,
      "end": 12293.56,
      "formatted_start": "03:24:52.920",
      "formatted_end": "03:24:53.560",
      "text": "تمیزه"
    },
    {
      "id": 89,
      "start": 12293.56,
      "end": 12295.22,
      "formatted_start": "03:24:53.560",
      "formatted_end": "03:24:55.220",
      "text": "اینجور چیزی نیست مخواهی برامون"
    },
    {
      "id": 90,
      "start": 12295.22,
      "end": 12298.82,
      "formatted_start": "03:24:55.220",
      "formatted_end": "03:24:58.820",
      "text": "من از هفت سالگی تا بیست سالگی داروی کمکونه میبینم"
    },
    {
      "id": 91,
      "start": 12298.82,
      "end": 12299.9,
      "formatted_start": "03:24:58.820",
      "formatted_end": "03:24:59.900",
      "text": "خوب تقسیزی کنم"
    }
  ],
  "status": "completed"
}