  "stt_segments": [
    {
      "id": 0,
      "start": 10200.0,
      "end": 10205.0,
      "formatted_start": "02:50:00.000",
      "formatted_end": "02:50:05.000",
      "text": "این برنامه هایی که باید بگید، اونجور بگید، آزا خوبه."
    },
    {
      "id": 1,
      "start": 10205.0,
      "end": 10209.0,
      "formatted_start": "02:50:05.000",
      "formatted_end": "02:50:09.000",
      "text": "به برس سیستون می نمی سنم این برس رو باید همیشه بفرم بخورم"
    },
    {
      "id": 2,
      "start": 10235.0,
      "end": 10241.0,
      "formatted_start": "02:50:35.000",
      "formatted_end": "02:50:41.000",
      "text": "من در اینجا با هر سه ماه نمیشم وزیرش باید بکنم"
    },
    {
      "id": 3,
      "start": 10241.0,
      "end": 10245.0,
      "formatted_start": "02:50:41.000",
      "formatted_end": "02:50:45.000",
      "text": "قید گرم تر شد بکنیم یه ماه بکنیم چند زمان وزیرشون ببینم"
    },
    {
      "id": 4,
      "start": 10245.0,
      "end": 10248.0,
      "formatted_start": "02:50:45.000",
      "formatted_end": "02:50:48.000",
      "text": "شاید باست تندید کنیم ولی"
    },
    {
      "id": 5,
      "start": 10259.0,
      "end": 10262.0,
      "formatted_start": "02:50:59.000",
      "formatted_end": "02:51:02.000",
      "text": "برس خوار مریم رو بعد از شام بکنم"
    },
    {
      "id": 6,
      "start": 10262.0,
      "end": 10268.0,
      "formatted_start": "02:51:02.000",
      "formatted_end": "02:51:08.000",
      "text": "بیاییم برد بگیم برسیم اون رو بگیم برسیم اون رو کسی سر پاست و بعد برد نمار بگیم"
    },
    {
      "id": 7,
      "start": 10268.0,
      "end": 10289.0,
      "formatted_start": "02:51:08.000",
      "formatted_end": "02:51:29.000",
      "text": "موسیقی"
    },
    {
      "id": 8,
      "start": 10289.0,
      "end": 10293.0,
      "formatted_start": "02:51:29.000",
      "formatted_end": "02:51:33.000",
      "text": "همچنین هم یک تایم با اون قیمت کنه، کمیش کنه"
    },
    {
      "id": 9,
      "start": 10293.0,
      "end": 10295.0,
      "formatted_start": "02:51:33.000",
      "formatted_end": "02:51:35.000",
      "text": "زیرا بخواهده به خاطر کلی هستنگیزه"
    },
    {
      "id": 10,
      "start": 10295.0,
      "end": 10301.0,
      "formatted_start": "02:51:35.000",
      "formatted_end": "02:51:41.000",
      "text": "آره، همچنین چون سنگاش هم همیشه کلسیومی همون شخصه"
    },
    {
      "id": 11,
      "start": 10301.0,
      "end": 10304.0,
      "formatted_start": "02:51:41.000",
      "formatted_end": "02:51:44.000",
      "text": "خوبه شما، سلامت باشید"
    },
    {
      "id": 12,
      "start": 10304.0,
      "end": 10306.0,
      "formatted_start": "02:51:44.000",
      "formatted_end": "02:51:46.000",
      "text": "خدا من میشه مرقومات..."
    },
    {
      "id": 13,
      "start": 10306.0,
      "end": 10307.0,
      "formatted_start": "02:51:46.000",
      "formatted_end": "02:51:47.000",
      "text": "نه دیگه تموم شده باید"
    },
    {
      "id": 14,
      "start": 10307.0,
      "end": 10308.0,
      "formatted_start": "02:51:47.000",
      "formatted_end": "02:51:48.000",
      "text": "CDS کنم بیشتر بودم"
    },
    {
      "id": 15,
      "start": 10308.0,
      "end": 10309.0,
      "formatted_start": "02:51:48.000",
      "formatted_end": "02:51:49.000",
      "text": "آره، CDS کنم شده باید"
    },
    {
      "id": 16,
      "start": 10309.0,
      "end": 10310.0,
      "formatted_start": "02:51:49.000",
      "formatted_end": "02:51:50.000",
      "text": "دست شما برداریم"
    },
    {
      "id": 17,
      "start": 10310.0,
      "end": 10311.0,
      "formatted_start": "02:51:50.000",
      "formatted_end": "02:51:51.000",
      "text": "باباید عزیزم"
    },
    {
      "id": 18,
      "start": 10319.0,
      "end": 10349.0,
      "formatted_start": "02:51:59.000",
      "formatted_end": "02:52:29.000",
      "text": "از اینجا باید برداریم که باید برداریم که باید برداریم که باید برداریم که باید برداریم که باید برداریم که باید برداریم که باید برداریم که باید برداریم که باید برداریم که باید برداریم که باید برداریم که باید برداریم که باید برداریم که باید برداریم که باید برداریم که باید برداریم که باید برداریم که ب"
    },
    {
      "id": 19,
      "start": 10349.0,
      "end": 10379.0,
      "formatted_start": "02:52:29.000",
      "formatted_end": "02:52:59.000",
