      "formatted_start": "01:15:28.000",
      "formatted_end": "01:15:32.000",
      "text": "یه درصد اگر یه وقتی پاتون برم داشت به اون اطلاع می دید"
    },
    {
      "id": 7,
      "start": 4532.0,
      "end": 4537.0,
      "formatted_start": "01:15:32.000",
      "formatted_end": "01:15:37.000",
      "text": "بعد داداتون همونو برای تندید کنم و بیتامین دی هم برای تو برم نویستم"
    },
    {
      "id": 8,
      "start": 4537.0,
      "end": 4546.0,
      "formatted_start": "01:15:37.000",
      "formatted_end": "01:15:46.000",
      "text": "فشارش رو با قریضه ها سویمتش هر گیر که بخورم نخواندید؟"
    },
    {
      "id": 9,
      "start": 4546.0,
      "end": 4576.0,
      "formatted_start": "01:15:46.000",
      "formatted_end": "01:16:16.000",
      "text": "از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه از اینکه ا"
    },
    {
      "id": 10,
      "start": 4576.0,
      "end": 4578.0,
      "formatted_start": "01:16:16.000",
      "formatted_end": "01:16:18.000",
      "text": "از این تناسق گیریم از این سال"
    },
    {
      "id": 11,
      "start": 4578.0,
      "end": 4580.0,
      "formatted_start": "01:16:18.000",
      "formatted_end": "01:16:20.000",
      "text": "جمعه تنهاستونو میفرمایید"
    },
    {
      "id": 12,
      "start": 4580.0,
      "end": 4582.0,
      "formatted_start": "01:16:20.000",
      "formatted_end": "01:16:22.000",
      "text": "نقصد یاد دارن؟"
    },
    {
      "id": 13,
      "start": 4582.0,
      "end": 4584.0,
      "formatted_start": "01:16:22.000",
      "formatted_end": "01:16:24.000",
      "text": "بله"
    },
    {
      "id": 14,
      "start": 4584.0,
      "end": 4586.0,
      "formatted_start": "01:16:24.000",
      "formatted_end": "01:16:26.000",
      "text": "636 سر 540"
    },
    {
      "id": 15,
      "start": 4586.0,
      "end": 4588.0,
      "formatted_start": "01:16:26.000",
      "formatted_end": "01:16:28.000",
      "text": "سر 540 چند روان"
    },
    {
      "id": 16,
      "start": 4588.0,
      "end": 4590.0,
      "formatted_start": "01:16:28.000",
      "formatted_end": "01:16:30.000",
      "text": "سر چشم"
    },
    {
      "id": 17,
      "start": 4590.0,
      "end": 4592.0,
      "formatted_start": "01:16:30.000",
      "formatted_end": "01:16:32.000",
      "text": "بعدی که این فاندوکونو برده"
    },
    {
      "id": 18,
      "start": 4592.0,
      "end": 4594.0,
      "formatted_start": "01:16:32.000",
      "formatted_end": "01:16:34.000",
      "text": "هر سه ماه قرنش چند"
    },
    {
      "id": 19,
      "start": 4594.0,
      "end": 4596.0,
      "formatted_start": "01:16:34.000",
      "formatted_end": "01:16:36.000",
      "text": "آزماش بده کافی"
    },
    {
      "id": 20,
      "start": 4596.0,
      "end": 4598.0,
      "formatted_start": "01:16:36.000",
      "formatted_end": "01:16:38.000",
      "text": "چون خدا شک خوبه"
    },
    {
      "id": 21,
      "start": 4598.0,
      "end": 4600.0,
      "formatted_start": "01:16:38.000",
      "formatted_end": "01:16:40.000",
      "text": "سه ماه دیگه اگه خوب بود"
    },
    {
      "id": 22,
      "start": 4600.0,
      "end": 4602.0,
      "formatted_start": "01:16:40.000",
      "formatted_end": "01:16:42.000",
      "text": "دیگه میشه هر شش ماه"
    },
    {
      "id": 23,
      "start": 4602.0,
      "end": 4604.0,
      "formatted_start": "01:16:42.000",
      "formatted_end": "01:16:44.000",
      "text": "نه کنترل کردم"
    },
    {
      "id": 24,
      "start": 4604.0,
      "end": 4606.0,
      "formatted_start": "01:16:44.000",
      "formatted_end": "01:16:46.000",
      "text": "این ساده میگه دیگه"
    },
    {
      "id": 25,
      "start": 4606.0,
      "end": 4610.0,
      "formatted_start": "01:16:46.000",
      "formatted_end": "01:16:50.000",
      "text": "ممنونم خانمکار لطفا کشیدین"
    },
    {
      "id": 26,
      "start": 4610.0,
      "end": 4613.0,
      "formatted_start": "01:16:50.000",
      "formatted_end": "01:16:53.000",
      "text": "این کود را ایره که دارو بگیر"
    },
    {
      "id": 27,
      "start": 4613.0,
      "end": 4615.0,
      "formatted_start": "01:16:53.000",
      "formatted_end": "01:16:55.000",
      "text": "باید زنگ بزنیم برق بیاد"
    },
    {
      "id": 28,
      "start": 4615.0,
      "end": 4618.0,
      "formatted_start": "01:16:55.000",
      "formatted_end": "01:16:58.000",
      "text": "سایت خدمات درمانی کشوری قرار داره"
    },
    {
      "id": 29,
      "start": 4618.0,
      "end": 4620.0,
      "formatted_start": "01:16:58.000",
      "formatted_end": "01:17:00.000",
      "text": "اصلا از صبح قرار داره"
    },
    {
      "id": 30,
      "start": 4620.0,
      "end": 4621.0,
      "formatted_start": "01:17:00.000",
      "formatted_end": "01:17:01.000",
      "text": "پس الان ما بریم؟"
    },
    {
      "id": 31,
      "start": 4621.0,
      "end": 4624.0,
      "formatted_start": "01:17:01.000",
      "formatted_end": "01:17:04.000",
      "text": "آره تا سایت خدمات درمانی دارم به روز سایت میکنم"
    },
    {
      "id": 32,
      "start": 4624.0,
      "end": 4626.0,
      "formatted_start": "01:17:04.000",
      "formatted_end": "01:17:06.000",
      "text": "این یه هفته هست مشکل داره"
    },
    {
      "id": 33,
      "start": 4626.0,
      "end": 4627.0,
      "formatted_start": "01:17:06.000",
      "formatted_end": "01:17:07.000",
      "text": "باید بیم اینجا برو"
    },
    {
      "id": 34,
      "start": 4627.0,
      "end": 4629.0,
      "formatted_start": "01:17:07.000",
      "formatted_end": "01:17:09.000",
      "text": "ما اصلا نمیخواد بیاییم بهتون زنگ بزاریم"
    },
    {
      "id": 35,
      "start": 4629.0,
      "end": 4630.0,
      "formatted_start": "01:17:09.000",
      "formatted_end": "01:17:10.000",
      "text": "زنگ؟"
    },
    {
      "id": 36,
      "start": 4630.0,
      "end": 4631.0,
      "formatted_start": "01:17:10.000",
      "formatted_end": "01:17:11.000",
      "text": "آره"
    },
    {
      "id": 37,
      "start": 4631.0,
      "end": 4632.0,
      "formatted_start": "01:17:11.000",
      "formatted_end": "01:17:12.000",
      "text": "مردم"
    },
    {
      "id": 38,
      "start": 4632.0,
      "end": 4635.0,
      "formatted_start": "01:17:12.000",
      "formatted_end": "01:17:15.000",
      "text": "خانم در این جمشه در گروه سایه آده بنده دارو"
    },
    {
      "id": 39,
      "start": 4635.0,
      "end": 4637.0,
      "formatted_start": "01:17:15.000",
      "formatted_end": "01:17:17.000",
      "text": "چار سنه تو سرنسخه براش بشیم"
    },
    {
      "id": 40,
      "start": 4637.0,
      "end": 4639.0,
      "formatted_start": "01:17:17.000",
      "formatted_end": "01:17:19.000",
      "text": "خانم درسته سلام خواست نماشی"
    },
    {
      "id": 41,
      "start": 4639.0,
      "end": 4643.0,
      "formatted_start": "01:17:19.000",
      "formatted_end": "01:17:23.000",
      "text": "بخاطر ما این همر رو بریم گرگون خواست ما رویستان بشیم"
    },
    {
      "id": 42,
      "start": 4643.0,
      "end": 4645.0,
      "formatted_start": "01:17:23.000",
      "formatted_end": "01:17:25.000",
      "text": "نه میتونم این داره بیمار خواست دار"
    },
    {
      "id": 43,
      "start": 4645.0,
      "end": 4647.0,
      "formatted_start": "01:17:25.000",
      "formatted_end": "01:17:27.000",
      "text": "نه من دارم هم بگم"
    },
    {
      "id": 44,
      "start": 4647.0,
      "end": 4648.0,
      "formatted_start": "01:17:27.000",
      "formatted_end": "01:17:28.000",
      "text": "چرا تو سرنسخه نماشیم؟"
    },
    {
      "id": 45,
      "start": 4648.0,
      "end": 4649.0,
      "formatted_start": "01:17:28.000",
      "formatted_end": "01:17:29.000",
      "text": "19 تا قده"
    },
    {
      "id": 46,
      "start": 4649.0,
      "end": 4652.2,
      "formatted_start": "01:17:29.000",
      "formatted_end": "01:17:32.200",
      "text": "نقصه اینجوری نمیدیم باید با چیز نمیدیم"
    },
    {
      "id": 47,
      "start": 4652.2,
      "end": 4653.2,
      "formatted_start": "01:17:32.200",
      "formatted_end": "01:17:33.200",
      "text": "نقصه داشته باشیم"
    },
    {
      "id": 48,
      "start": 4653.2,
      "end": 4656.2,
      "formatted_start": "01:17:33.200",
      "formatted_end": "01:17:36.200",
      "text": "خب کدر ره گیری بهت میدیم که"
    },
    {
      "id": 49,
      "start": 4656.2,
      "end": 4660.2,
      "formatted_start": "01:17:36.200",
      "formatted_end": "01:17:40.200",
      "text": "مزخست دیگه مگه برای کجا برای کومیته میخوای؟"
    },
    {
      "id": 50,
      "start": 4660.2,
      "end": 4662.2,
      "formatted_start": "01:17:40.200",
      "formatted_end": "01:17:42.200",
      "text": "نه دیگه دارو خانه"
    },
    {
      "id": 51,
      "start": 4662.2,
      "end": 4666.2,
      "formatted_start": "01:17:42.200",
      "formatted_end": "01:17:46.200",
      "text": "خب کدر ره گیری برایت میزنیم بیمه میگی میگیری دیگه"
    },
    {
      "id": 52,
      "start": 4666.2,
      "end": 4667.2,
      "formatted_start": "01:17:46.200",
      "formatted_end": "01:17:47.200",
      "text": "جد نه خب دیگه"
    },
    {
      "id": 53,
      "start": 4667.2,
      "end": 4670.2,
      "formatted_start": "01:17:47.200",
      "formatted_end": "01:17:50.200",
      "text": "اینجوری آزاد خیلی گرونه"
    },
    {
      "id": 54,
      "start": 4670.2,
      "end": 4672.2,
      "formatted_start": "01:17:50.200",
      "formatted_end": "01:17:52.200",
      "text": "خب الان هرکاشت ممکنه"
    },
    {
      "id": 55,
      "start": 4672.2,
      "end": 4673.2,
      "formatted_start": "01:17:52.200",
      "formatted_end": "01:17:53.200",
      "text": "موبایم بیدیم اتون زنیم"
    },
    {
      "id": 56,
      "start": 4673.2,
      "end": 4679.76,
      "formatted_start": "01:17:53.200",
      "formatted_end": "01:17:59.760",
      "text": "بعد اتون زمینیم بعد نگاه کن میخواد بره گردان دیگه امروز سیه کمه فردا صبح براش بزن که برج جدید باشه"
    },
    {
      "id": 57,
      "start": 4679.76,
      "end": 4681.76,
      "formatted_start": "01:17:59.760",
      "formatted_end": "01:18:01.760",
      "text": "فردا صبح براتون سبت کنی؟"
    },
    {
      "id": 58,
      "start": 4681.76,
      "end": 4683.76,
      "formatted_start": "01:18:01.760",
      "formatted_end": "01:18:03.760",
      "text": "تاریخ اگه برج نداره نیست"
    },
    {
      "id": 59,
      "start": 4683.76,
      "end": 4688.32,
      "formatted_start": "01:18:03.760",
      "formatted_end": "01:18:08.320",
      "text": "نه اصلا نیست دیگه برای من میگم امروز اگه برات سبت کنیم یه روز همین امشب و وقت داریم"
    },
    {
      "id": 60,
      "start": 4688.32,
      "end": 4691.92,
      "formatted_start": "01:18:08.320",
      "formatted_end": "01:18:11.920",
      "text": "فردا صبح برات میزنیم که تا آخر شریفه وقت داشته باشه بگیرید"
    },
    {
      "id": 61,
      "start": 4691.92,
      "end": 4694.64,
      "formatted_start": "01:18:11.920",
      "formatted_end": "01:18:14.640",
      "text": "خود؟ چون آزاد خیلی گرونه"
    },
    {
      "id": 62,
      "start": 4694.64,
      "end": 4696.64,
      "formatted_start": "01:18:14.640",
      "formatted_end": "01:18:16.640",
      "text": "بنابراین میتونید صفت کنید دوست داریم"
    },
    {
      "id": 63,
      "start": 4696.64,
      "end": 4698.64,
      "formatted_start": "01:18:16.640",
      "formatted_end": "01:18:18.640",
      "text": "نه داروی خواسته دارم همین بدنگم"
    },
    {
      "id": 64,
      "start": 4698.64,
      "end": 4700.64,
      "formatted_start": "01:18:18.640",
      "formatted_end": "01:18:20.640",
      "text": "داروی بیماران خواسته پروندهیه"
    },
    {
      "id": 65,
      "start": 4700.64,
      "end": 4702.64,
      "formatted_start": "01:18:20.640",
      "formatted_end": "01:18:22.640",
      "text": "خب نمیدن بهتون"
    },
    {
      "id": 66,
      "start": 4702.64,
      "end": 4704.64,
      "formatted_start": "01:18:22.640",
      "formatted_end": "01:18:24.640",
      "text": "موبایلتون؟"
    },
    {
      "id": 67,
      "start": 4704.64,
      "end": 4706.64,
      "formatted_start": "01:18:24.640",
      "formatted_end": "01:18:26.640",
      "text": "مگه روز دوستا میخوری الان؟"
    },
    {
      "id": 68,
      "start": 4706.64,
      "end": 4708.64,
      "formatted_start": "01:18:26.640",
      "formatted_end": "01:18:28.640",
      "text": "نه دیگه یکی صبح مخوره و یکی شبتیه"
    },
    {
      "id": 69,
      "start": 4708.64,
      "end": 4710.64,
      "formatted_start": "01:18:28.640",
      "formatted_end": "01:18:30.640",
      "text": "بیستانه و هشت را بچه"
    },
    {
      "id": 70,
      "start": 4710.64,
      "end": 4712.64,
      "formatted_start": "01:18:30.640",
      "formatted_end": "01:18:32.640",
      "text": "جواب بدی که"
    },
    {
      "id": 71,
      "start": 4712.64,
      "end": 4714.64,
      "formatted_start": "01:18:32.640",
      "formatted_end": "01:18:34.640",
      "text": "باشی براش برنمیس دوستا"
    },
    {
      "id": 72,
      "start": 4714.64,
      "end": 4716.64,
      "formatted_start": "01:18:34.640",
      "formatted_end": "01:18:36.640",
      "text": "براش بزن اگه حالا برد برن"
    },
    {
      "id": 73,
      "start": 4716.64,
      "end": 4718.64,
      "formatted_start": "01:18:36.640",
      "formatted_end": "01:18:38.640",
      "text": "ما دوستا برات مرمیم"
    },
    {
      "id": 74,
      "start": 4718.64,
      "end": 4721.64,
      "formatted_start": "01:18:38.640",
      "formatted_end": "01:18:41.640",
      "text": "اگر که بزرگیرد، اگر که بزرگیرد"
    },
    {
      "id": 75,
      "start": 4721.64,
      "end": 4724.64,
      "formatted_start": "01:18:41.640",
      "formatted_end": "01:18:44.640",
      "text": "چون الان اگر اونها را که بخورم، الان دلوی بیترم"
    },
    {
      "id": 76,
      "start": 4724.64,
      "end": 4728.64,
      "formatted_start": "01:18:44.640",
      "formatted_end": "01:18:48.640",
      "text": "آره دیگه، اون روش نمی کنه، همون دفعه که کم خوردی این اتفاق"
    },
    {
      "id": 77,
      "start": 4728.64,
      "end": 4731.64,
      "formatted_start": "01:18:48.640",
      "formatted_end": "01:18:51.640",
      "text": "تا روزی که زنده این گرس رو منتونم"
    },
    {
      "id": 78,
      "start": 4731.64,
      "end": 4734.64,
      "formatted_start": "01:18:51.640",
      "formatted_end": "01:18:54.640",
      "text": "الان اگر پیدا کنم، که من بخورم بگیرم"
    },
    {
      "id": 79,
      "start": 4734.64,
      "end": 4737.64,
      "formatted_start": "01:18:54.640",
      "formatted_end": "01:18:57.640",
      "text": "پاکست سخت پیدا میشه هر درد"
    },
    {
      "id": 80,
      "start": 4737.64,
      "end": 4739.64,
      "formatted_start": "01:18:57.640",
      "formatted_end": "01:18:59.640",
      "text": "همون دکتر این ها گرسش دیگه"
    },
    {
      "id": 81,
      "start": 4739.64,
      "end": 4740.64,
      "formatted_start": "01:18:59.640",
      "formatted_end": "01:19:00.640",
      "text": "نه، آره"
    },
    {
      "id": 82,
      "start": 4740.64,
      "end": 4742.64,
      "formatted_start": "01:19:00.640",
      "formatted_end": "01:19:02.640",
      "text": "نه، خب بعضی موقع همین دردیگه"
    },
    {
      "id": 83,
      "start": 4742.64,
      "end": 4744.64,
      "formatted_start": "01:19:02.640",
      "formatted_end": "01:19:04.640",
      "text": "الان دیگه تمام کردم هند ندارم خانم دیگه"
    },
    {
      "id": 84,
      "start": 4744.64,
      "end": 4747.64,
      "formatted_start": "01:19:04.640",
      "formatted_end": "01:19:07.640",
      "text": "الان توی وقت تو کشور پیدا دارم شو اون که تو داری هندیه خالی شوید"
    },
    {
      "id": 85,
      "start": 4747.64,
      "end": 4749.64,
      "formatted_start": "01:19:07.640",
      "formatted_end": "01:19:09.640",
      "text": "دیجه هم تمام کردم الان دیگه ندارم"
    },
    {
      "id": 86,
      "start": 4749.64,
      "end": 4750.64,
      "formatted_start": "01:19:09.640",
      "formatted_end": "01:19:10.640",
      "text": "من روش نخوردم"
    },
    {
      "id": 87,
      "start": 4750.64,
      "end": 4751.64,
      "formatted_start": "01:19:10.640",
      "formatted_end": "01:19:11.640",
      "text": "برای چی باعث داده تمام کنی؟"
    },
    {
      "id": 88,
      "start": 4751.64,
      "end": 4753.64,
      "formatted_start": "01:19:11.640",
      "formatted_end": "01:19:13.640",
      "text": "خانم دیگه تمام شد دیگه ما مهرم"
    },
    {
      "id": 89,
      "start": 4753.64,
      "end": 4755.64,
      "formatted_start": "01:19:13.640",
      "formatted_end": "01:19:15.640",
      "text": "باید پنج تومونده بیای براتو بنویسیم"
    },
    {
      "id": 90,
      "start": 4755.64,
      "end": 4757.64,
      "formatted_start": "01:19:15.640",
      "formatted_end": "01:19:17.640",
      "text": "از کنکتون کجاست؟"
    },
    {
      "id": 91,
      "start": 4757.64,
      "end": 4758.64,
      "formatted_start": "01:19:17.640",
      "formatted_end": "01:19:18.640",
      "text": "رویستار را"
    },
    {
      "id": 92,
      "start": 4758.64,
      "end": 4760.64,
      "formatted_start": "01:19:18.640",
      "formatted_end": "01:19:20.640",
      "text": "خب زنگ بزن به خانم گلچین دیگه"
    },
    {
      "id": 93,
      "start": 4760.64,
      "end": 4764.64,
      "formatted_start": "01:19:20.640",
      "formatted_end": "01:19:24.640",
      "text": "نمیخواد خودت بیایی چون داروی مادامال عمرته"
    },
    {
      "id": 94,
      "start": 4764.64,
      "end": 4768.64,
      "formatted_start": "01:19:24.640",
      "formatted_end": "01:19:28.640",
      "text": "خانگوچی باش همه هرکو آره بشو هم بگو"
    },
    {
      "id": 95,
      "start": 4768.64,
      "end": 4772.64,
      "formatted_start": "01:19:28.640",
      "formatted_end": "01:19:32.640",
      "text": "اون تلفونی اون برای خانگوچی چی میکنی؟ آن منم"
    },
    {
      "id": 96,
      "start": 4772.64,
      "end": 4774.64,
      "formatted_start": "01:19:32.640",
      "formatted_end": "01:19:34.640",
      "text": "بعد دیگه نمیدونی"
    },
    {
      "id": 97,
      "start": 4774.64,
      "end": 4776.64,
      "formatted_start": "01:19:34.640",
      "formatted_end": "01:19:36.640",
      "text": "دست درم نگه"
    },
    {
      "id": 98,
      "start": 4776.64,
      "end": 4780.64,
      "formatted_start": "01:19:36.640",
      "formatted_end": "01:19:40.640",
      "text": "بعد یا کن به دارو خونه بگو دویستا زدی برام نوشتن"
    },
    {
      "id": 99,
      "start": 4780.64,
      "end": 4782.64,
      "formatted_start": "01:19:40.640",
      "formatted_end": "01:19:42.640",
      "text": "بعد اگه مثلا به صد تا داد"
    },
    {
      "id": 100,
      "start": 4782.64,
      "end": 4786.64,
      "formatted_start": "01:19:42.640",
      "formatted_end": "01:19:46.640",
      "text": "خانمو باید ببینیم بعض وقتا سامانه نمیذاری بیشتر از صد تا"
    },
    {
      "id": 101,
      "start": 4786.64,
      "end": 4788.64,
      "formatted_start": "01:19:46.640",
      "formatted_end": "01:19:48.640",
      "text": "خانگوچی بهتون میگه چقدر اجازه داده"
    },
    {
      "id": 102,
      "start": 4788.64,
      "end": 4790.64,
      "formatted_start": "01:19:48.640",
      "formatted_end": "01:19:50.640",
      "text": "از این تاروخانه باید برده"
    },
    {
      "id": 103,
      "start": 4790.64,
      "end": 4794.64,
      "formatted_start": "01:19:50.640",
      "formatted_end": "01:19:54.640",
      "text": "چون اگر از صد تومه بزنیم سی تا برده نسخه رو باید برده"
    },
    {
      "id": 104,
      "start": 4794.64,
      "end": 4796.64,
      "formatted_start": "01:19:54.640",
      "formatted_end": "01:19:56.640",
      "text": "بعد دیگه میوه نمیتونی بخری و بعد همه ش آزاد بخری"
    },
    {
      "id": 105,
      "start": 4796.64,
      "end": 4798.64,
      "formatted_start": "01:19:56.640",
      "formatted_end": "01:19:58.640",
      "text": "آزاد خوره دیگه رو"
    },
    {
      "id": 106,
      "start": 4798.64,
      "end": 4800.64,
      "formatted_start": "01:19:58.640",
      "formatted_end": "01:20:00.640",
      "text": "باشی دست درمیدی"
    }
  ],
  "status": "completed"
}