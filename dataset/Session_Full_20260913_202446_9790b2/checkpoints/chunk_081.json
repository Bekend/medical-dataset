  "stt_segments": [
    {
      "id": 0,
      "start": 24300.0,
      "end": 24302.0,
      "formatted_start": "06:45:00.000",
      "formatted_end": "06:45:02.000",
      "text": "از اینجا باید برداشت بشیم."
    },
    {
      "id": 1,
      "start": 24302.0,
      "end": 24304.0,
      "formatted_start": "06:45:02.000",
      "formatted_end": "06:45:04.000",
      "text": "خب، باید برداشت بشیم."
    },
    {
      "id": 2,
      "start": 24304.0,
      "end": 24306.0,
      "formatted_start": "06:45:04.000",
      "formatted_end": "06:45:06.000",
      "text": "بخواهم دارم اکس بگیرم."
    },
    {
      "id": 3,
      "start": 24306.0,
      "end": 24308.0,
      "formatted_start": "06:45:06.000",
      "formatted_end": "06:45:08.000",
      "text": "باش بردم همین."
    },
    {
      "id": 4,
      "start": 24308.0,
      "end": 24310.0,
      "formatted_start": "06:45:08.000",
      "formatted_end": "06:45:10.000",
      "text": "بردم بینم عصب یا نه."
    },
    {
      "id": 5,
      "start": 24310.0,
      "end": 24312.0,
      "formatted_start": "06:45:10.000",
      "formatted_end": "06:45:12.000",
      "text": "دیسک دارم اصلا."
    },
    {
      "id": 6,
      "start": 24312.0,
      "end": 24314.0,
      "formatted_start": "06:45:12.000",
      "formatted_end": "06:45:14.000",
      "text": "پاهم ممکنه."
    },
    {
      "id": 7,
      "start": 24314.0,
      "end": 24316.0,
      "formatted_start": "06:45:14.000",
      "formatted_end": "06:45:16.000",
      "text": "از اینجا بردم برداشت."
    },
    {
      "id": 8,
      "start": 24316.0,
      "end": 24318.0,
      "formatted_start": "06:45:16.000",
      "formatted_end": "06:45:18.000",
      "text": "بردم بردم."
    },
    {
      "id": 9,
      "start": 24322.0,
      "end": 24324.0,
      "formatted_start": "06:45:22.000",
      "formatted_end": "06:45:24.000",
      "text": "چند شستین طولانی؟"
    },
    {
      "id": 10,
      "start": 24324.0,
      "end": 24326.0,
      "formatted_start": "06:45:24.000",
      "formatted_end": "06:45:26.000",
      "text": "نه، هیچ جا نرفتم من."
    },
    {
      "id": 11,
      "start": 24326.0,
      "end": 24328.0,
      "formatted_start": "06:45:26.000",
      "formatted_end": "06:45:28.000",
      "text": "هیچ جا."
    },
    {
      "id": 12,
      "start": 24328.0,
      "end": 24336.0,
      "formatted_start": "06:45:28.000",
      "formatted_end": "06:45:36.000",
      "text": "اصلا کلن این کار رو اصلا کلن در این امارای برم بدم و اکس بگیرم از پایم"
    },
    {
      "id": 13,
      "start": 24336.0,
      "end": 24343.5,
      "formatted_start": "06:45:36.000",
      "formatted_end": "06:45:43.500",
      "text": "شما برسین قبول میدونید من دو چار"
    },
    {
      "id": 14,
      "start": 24343.5,
      "end": 24345.5,
      "formatted_start": "06:45:43.500",
      "formatted_end": "06:45:45.500",
      "text": "بگیرم بگیرم"
    },
    {
      "id": 15,
      "start": 24345.5,
      "end": 24347.5,
      "formatted_start": "06:45:45.500",
      "formatted_end": "06:45:47.500",
      "text": "بگیرم بگیرم"
    },
    {
      "id": 16,
      "start": 24347.5,
      "end": 24349.5,
      "formatted_start": "06:45:47.500",
      "formatted_end": "06:45:49.500",
      "text": "بگیرم بگیرم"
    },
    {
      "id": 17,
      "start": 24349.5,
      "end": 24351.5,
      "formatted_start": "06:45:49.500",
      "formatted_end": "06:45:51.500",
      "text": "بگیرم بگیرم"
    },
    {
      "id": 18,
      "start": 24351.5,
      "end": 24353.5,
      "formatted_start": "06:45:51.500",
      "formatted_end": "06:45:53.500",
      "text": "باشه"
    },
    {
      "id": 19,
      "start": 24353.5,
      "end": 24355.5,
      "formatted_start": "06:45:53.500",
      "formatted_end": "06:45:55.500",
      "text": "هر چی درد داشتی به من بگیر"
    },
    {
      "id": 20,
      "start": 24355.5,
      "end": 24357.5,
      "formatted_start": "06:45:55.500",
      "formatted_end": "06:45:57.500",
      "text": "اینکه بهتر درد نداری"
    },
    {
      "id": 21,
      "start": 24357.5,
      "end": 24359.5,
      "formatted_start": "06:45:57.500",
      "formatted_end": "06:45:59.500",
      "text": "این درد نداری"
    },
    {
      "id": 22,
      "start": 24359.5,
      "end": 24361.5,
      "formatted_start": "06:45:59.500",
      "formatted_end": "06:46:01.500",
      "text": "اینکه بهتر درد نداری"
    },
    {
      "id": 23,
      "start": 24361.5,
      "end": 24363.5,
      "formatted_start": "06:46:01.500",
      "formatted_end": "06:46:03.500",
      "text": "اینکه بهتر درد نداری"
    },
    {
      "id": 24,
      "start": 24363.5,
      "end": 24365.5,
      "formatted_start": "06:46:03.500",
      "formatted_end": "06:46:05.500",
      "text": "اینکه بهتر درد نداری"
    },
    {
      "id": 25,
      "start": 24365.5,
      "end": 24367.5,
      "formatted_start": "06:46:05.500",
      "formatted_end": "06:46:07.500",
      "text": "اینکه بهتر درد نداری"
    },
    {
      "id": 26,
      "start": 24367.5,
      "end": 24369.5,
      "formatted_start": "06:46:07.500",
      "formatted_end": "06:46:09.500",
      "text": "اینکه بهتر درد نداری"
    },
    {
      "id": 27,
      "start": 24369.5,
      "end": 24371.5,
      "formatted_start": "06:46:09.500",
      "formatted_end": "06:46:11.500",
      "text": "اینکه بهتر درد نداری"
    },
    {
      "id": 28,
      "start": 24371.5,
      "end": 24401.5,
      "formatted_start": "06:46:11.500",
      "formatted_end": "06:46:41.500",
      "text": "این از این از این از این از این از این از این از این از این از این از این از این از این از این از این از این از این از این از این از این از این از این از این از این از این از این از این از این از این از این از این از این از این از این از این از این از این از این از این از این از این از این از این از این از این از این از این از این از این از این از این از این از این از این از این از این ا"
    },
    {
      "id": 29,
      "start": 24401.5,
      "end": 24406.0,
      "formatted_start": "06:46:41.500",
      "formatted_end": "06:46:46.000",
      "text": "از این ساله ما با این کاری برداریم."
    },
    {
      "id": 30,
      "start": 24406.0,
      "end": 24415.5,
      "formatted_start": "06:46:46.000",
      "formatted_end": "06:46:55.500",
      "text": "برای مثلا با آن پولویان، حالا بگه ۲۰ میلیم میگیره، بعد میدونم ما این هر دفعه هر جلسه عیسیت ها که حالا نمیدونم برداریم."
    },
    {
      "id": 31,
      "start": 24415.5,
      "end": 24419.5,
      "formatted_start": "06:46:55.500",
      "formatted_end": "06:46:59.500",
      "text": "پاشتیوری من نردم. به چیزی بهش میگن چیز با..."
    },
    {
      "id": 32,
      "start": 24419.5,
      "end": 24421.5,
      "formatted_start": "06:46:59.500",
      "formatted_end": "06:47:01.500",
      "text": "چه کاره انجام میدونی؟"
    },
    {
      "id": 33,
      "start": 24421.5,
      "end": 24424.5,
      "formatted_start": "06:47:01.500",
      "formatted_end": "06:47:04.500",
      "text": "اینها رو مثلا جا به جا میکنه و این دونم..."
    },
    {
      "id": 34,
      "start": 24424.5,
      "end": 24426.5,
      "formatted_start": "06:47:04.500",
      "formatted_end": "06:47:06.500",
      "text": "چه صدیقه هواست؟"
    },
    {
      "id": 35,
      "start": 24426.5,
      "end": 24428.5,
      "formatted_start": "06:47:06.500",
      "formatted_end": "06:47:08.500",
      "text": "بچه شما خودشون ترتیب کردن یه نه؟"
    },
    {
      "id": 36,
      "start": 24428.5,
      "end": 24435.14,
      "formatted_start": "06:47:08.500",
      "formatted_end": "06:47:15.140",
      "text": "ما مثلا پله زیاد نرفتیم، آسانسور برفتیم و مثلا پیاده روی زیاد"
    },
    {
      "id": 37,
      "start": 24435.14,
      "end": 24442.26,
      "formatted_start": "06:47:15.140",
      "formatted_end": "06:47:22.260",
      "text": "ام دکتر من همان 20 روزی، یک ماه فقط دکتر میرم، داروهای مسکین خارجی و خنان و اینجوری کنم"
    },
    {
      "id": 38,
      "start": 24442.26,
      "end": 24443.66,
      "formatted_start": "06:47:22.260",
      "formatted_end": "06:47:23.660",
      "text": "چی کار کرده که اینجور شد؟"
    },
    {
      "id": 39,
      "start": 24443.66,
      "end": 24454.02,
      "formatted_start": "06:47:23.660",
      "formatted_end": "06:47:34.020",
      "text": "همون پله ها رو رفته بالا و اومده پایین، همان 20 روزی یعنی اندازه بکنم 80 میلیون فقط بوده دارو خارجی و مکمل خارجی و اینو واسه نمیشتم"
    },
    {
      "id": 40,
      "start": 24454.02,
      "end": 24456.82,
      "formatted_start": "06:47:34.020",
      "formatted_end": "06:47:36.820",
      "text": "همین دکتر ارتبطه که اینجوری شد"
    },
    {
      "id": 41,
      "start": 24456.82,
      "end": 24464.82,
      "formatted_start": "06:47:36.820",
      "formatted_end": "06:47:44.820",
      "text": "این راه گرفته گفته دیسک خفیف داری ستا، با این دیسک خفیف اصلا نیمتر بشینه"
    },
    {
      "id": 42,
      "start": 24464.82,
      "end": 24472.82,
      "formatted_start": "06:47:44.820",
      "formatted_end": "06:47:52.820",
      "text": "دیسک اینجوریه ممکنه خفیف باشه، شما داد بزنید، ممکنه شهید باشه، گیش در نشان باشه، شدتش با دردش ارتباط نداره"
    },
    {
      "id": 43,
      "start": 24472.82,
      "end": 24477.82,
      "formatted_start": "06:47:52.820",
      "formatted_end": "06:47:57.820",
      "text": "اصلا این یه به شما میزنه، به دستان میزنه، مرمر داره، دیپان مزداره"
    },
    {
      "id": 44,
      "start": 24477.82,
      "end": 24479.82,
      "formatted_start": "06:47:57.820",
      "formatted_end": "06:47:59.820",
      "text": "من یه قرص میریم سم برای شما خب؟"
    },
    {
      "id": 45,
      "start": 24479.82,
      "end": 24480.82,
      "formatted_start": "06:47:59.820",
      "formatted_end": "06:48:00.820",
      "text": "خب"
    },
    {
      "id": 46,
      "start": 24480.82,
      "end": 24482.82,
      "formatted_start": "06:48:00.820",
      "formatted_end": "06:48:02.820",
      "text": "به اون رو بده بخورم"
    },
    {
      "id": 47,
      "start": 24482.82,
      "end": 24486.12,
      "formatted_start": "06:48:02.820",
      "formatted_end": "06:48:06.120",
      "text": "اما این بود با وقت تب سوزنی این طورم گنبت"
    },
    {
      "id": 48,
      "start": 24486.12,
      "end": 24489.12,
      "formatted_start": "06:48:06.120",
      "formatted_end": "06:48:09.120",
      "text": "تفلک یه دفعه چی انداختهش؟"
    },
    {
      "id": 49,
      "start": 24489.12,
      "end": 24492.12,
      "formatted_start": "06:48:09.120",
      "formatted_end": "06:48:12.120",
      "text": "من پردن انداخته که اصلا چه جورم انداخته"
    },
    {
      "id": 50,
      "start": 24492.12,
      "end": 24496.12,
      "formatted_start": "06:48:12.120",
      "formatted_end": "06:48:16.120",
      "text": "انا 20 روز کامله که اصلا پردن دست نمیتونست"
    },
    {
      "id": 51,
      "start": 24496.12,
      "end": 24499.12,
      "formatted_start": "06:48:16.120",
      "formatted_end": "06:48:19.120",
      "text": "این قرصی که تو خودتی خارجی براتو نوشتم خب"
    },
    {
      "id": 52,
      "start": 24499.12,
      "end": 24501.62,
      "formatted_start": "06:48:19.120",
      "formatted_end": "06:48:21.620",
      "text": "10 تا شو بیشتر بزرگ برمیسن"
    },
    {
      "id": 53,
      "start": 24501.62,
      "end": 24504.12,
      "formatted_start": "06:48:21.620",
      "formatted_end": "06:48:24.120",
      "text": "یه بیشتر هم باید بخونم 10 تا برمیسن"
    },
    {
      "id": 54,
      "start": 24506.12,
      "end": 24508.12,
      "formatted_start": "06:48:26.120",
      "formatted_end": "06:48:28.120",
      "text": "بعد امرائی هم"
    },
    {
      "id": 55,
      "start": 24508.12,
      "end": 24511.12,
      "formatted_start": "06:48:28.120",
      "formatted_end": "06:48:31.120",
      "text": "امرائی فردا باید خواهم گلچین صد کنه خب"
    },
    {
      "id": 56,
      "start": 24511.12,
      "end": 24514.12,
      "formatted_start": "06:48:31.120",
      "formatted_end": "06:48:34.120",
      "text": "می نویستم امروهای کمر فرد شب چهرسه"
    },
    {
      "id": 57,
      "start": 24514.12,
      "end": 24516.12,
      "formatted_start": "06:48:34.120",
      "formatted_end": "06:48:36.120",
      "text": "چهرسه دو یه عکس هم از لگنتون بگو"
    },
    {
      "id": 58,
      "start": 24516.12,
      "end": 24519.12,
      "formatted_start": "06:48:36.120",
      "formatted_end": "06:48:39.120",
      "text": "یعنی اون که افتخان لگن و اینا همه بیافته"
    },
    {
      "id": 59,
      "start": 24519.12,
      "end": 24520.12,
      "formatted_start": "06:48:39.120",
      "formatted_end": "06:48:40.120",
      "text": "می نویستم فرد"
    },
    {
      "id": 60,
      "start": 24520.12,
      "end": 24522.12,
      "formatted_start": "06:48:40.120",
      "formatted_end": "06:48:42.120",
      "text": "تو امروهایی هم جدا؟"
    },
    {
      "id": 61,
      "start": 24522.12,
      "end": 24523.12,
      "formatted_start": "06:48:42.120",
      "formatted_end": "06:48:43.120",
      "text": "نه جدا"
    },
    {
      "id": 62,
      "start": 24523.12,
      "end": 24526.12,
      "formatted_start": "06:48:43.120",
      "formatted_end": "06:48:46.120",
      "text": "یا می کنم ما یه امروهای محرمای کمر"
    },
    {
      "id": 63,
      "start": 24526.12,
      "end": 24528.12,
      "formatted_start": "06:48:46.120",
      "formatted_end": "06:48:48.120",
      "text": "فردن جمع رو که بیاییم"
    },
    {
      "id": 64,
      "start": 24528.12,
      "end": 24533.12,
      "formatted_start": "06:48:48.120",
      "formatted_end": "06:48:53.120",
      "text": "گرافیه لگن و محرمای کمر"
    },
    {
      "id": 65,
      "start": 24536.12,
      "end": 24538.12,
      "formatted_start": "06:48:56.120",
      "formatted_end": "06:48:58.120",
      "text": "اتا امروز روز آخره با آجه خود؟"
    },
    {
      "id": 66,
      "start": 24538.12,
      "end": 24539.12,
      "formatted_start": "06:48:58.120",
      "formatted_end": "06:48:59.120",
      "text": "آه نه نه"
    },
    {
      "id": 67,
      "start": 24539.12,
      "end": 24541.12,
      "formatted_start": "06:48:59.120",
      "formatted_end": "06:49:01.120",
      "text": "در روز هم تموم شده؟"
    },
    {
      "id": 68,
      "start": 24541.12,
      "end": 24543.12,
      "formatted_start": "06:49:01.120",
      "formatted_end": "06:49:03.120",
      "text": "در روز هم چند تا تموم شده"
    },
    {
      "id": 69,
      "start": 24543.12,
      "end": 24545.12,
      "formatted_start": "06:49:03.120",
      "formatted_end": "06:49:05.120",
      "text": "چند تا در توی لازی ها هسته"
    },
    {
      "id": 70,
      "start": 24545.12,
      "end": 24547.12,
      "formatted_start": "06:49:05.120",
      "formatted_end": "06:49:07.120",
      "text": "لازی ها"
    },
    {
      "id": 71,
      "start": 24547.12,
      "end": 24549.12,
      "formatted_start": "06:49:07.120",
      "formatted_end": "06:49:09.120",
      "text": "می تویی کنیم تموم شده کدوم نه؟"
    },
    {
      "id": 72,
      "start": 24549.12,
      "end": 24551.12,
      "formatted_start": "06:49:09.120",
      "formatted_end": "06:49:11.120",
      "text": "همین هایی هم بردم این هایی که تموم شده"
    },
    {
      "id": 73,
      "start": 24551.12,
      "end": 24553.12,
      "formatted_start": "06:49:11.120",
      "formatted_end": "06:49:13.120",
      "text": "داره تموم میشه زیاد نبود"
    },
    {
      "id": 74,
      "start": 24553.12,
      "end": 24555.12,
      "formatted_start": "06:49:13.120",
      "formatted_end": "06:49:15.120",
      "text": "این ها بردم بیام که"
    },
    {
      "id": 75,
      "start": 24555.12,
      "end": 24557.12,
      "formatted_start": "06:49:15.120",
      "formatted_end": "06:49:17.120",
      "text": "بخاطر فان برم"
    },
    {
      "id": 76,
      "start": 24557.12,
      "end": 24559.12,
      "formatted_start": "06:49:17.120",
      "formatted_end": "06:49:19.120",
      "text": "اکس بگیرم"
    },
    {
      "id": 77,
      "start": 24559.12,
      "end": 24561.12,
      "formatted_start": "06:49:19.120",
      "formatted_end": "06:49:21.120",
      "text": "بگیرم اینجا"
    },
    {
      "id": 78,
      "start": 24561.12,
      "end": 24563.12,
      "formatted_start": "06:49:21.120",
      "formatted_end": "06:49:23.120",
      "text": "چه پرده هی پاسونه دیگه"
    },
    {
      "id": 79,
      "start": 24563.12,
      "end": 24565.12,
      "formatted_start": "06:49:23.120",
      "formatted_end": "06:49:25.120",
      "text": "اینجا می زنیم که پرده هی زیر کرد"
    },
    {
      "id": 80,
      "start": 24565.12,
      "end": 24571.12,
      "formatted_start": "06:49:25.120",
      "formatted_end": "06:49:31.120",
      "text": "بچه ها اون عکس لگم دهید که اون سر استخونتون که توی دیده بشین"
    },
    {
      "id": 81,
      "start": 24571.12,
      "end": 24574.12,
      "formatted_start": "06:49:31.120",
      "formatted_end": "06:49:34.120",
      "text": "چون درد هست"
    },
    {
      "id": 82,
      "start": 24574.12,
      "end": 24577.12,
      "formatted_start": "06:49:34.120",
      "formatted_end": "06:49:37.120",
      "text": "اینجور هایی که تمام شده بوده او برنه"
    },
    {
      "id": 83,
      "start": 24577.12,
      "end": 24579.12,
      "formatted_start": "06:49:37.120",
      "formatted_end": "06:49:39.120",
      "text": "چیه؟"
    },
    {
      "id": 84,
      "start": 24579.12,
      "end": 24581.12,
      "formatted_start": "06:49:39.120",
      "formatted_end": "06:49:41.120",
      "text": "اونو خود نمانه"
    },
    {
      "id": 85,
      "start": 24581.12,
      "end": 24585.12,
      "formatted_start": "06:49:41.120",
      "formatted_end": "06:49:45.120",
      "text": "چون پیپلر تا اون نرفته بودیم او فیاضه را دیگه"
    },
    {
      "id": 86,
      "start": 24585.12,
      "end": 24587.12,
      "formatted_start": "06:49:45.120",
      "formatted_end": "06:49:47.120",
      "text": "و اینا"
    },
    {
      "id": 87,
      "start": 24587.12,
      "end": 24589.12,
      "formatted_start": "06:49:47.120",
      "formatted_end": "06:49:49.120",
      "text": "اینا تازه خونه شو آقای تو شهره بیده"
    },
    {
      "id": 88,
      "start": 24589.12,
      "end": 24594.12,
      "formatted_start": "06:49:49.120",
      "formatted_end": "06:49:54.120",
      "text": "کلن اقتصاد بچه ما که 50 کلو بارو نگهشیم اینو برن"
    },
    {
      "id": 89,
      "start": 24594.12,
      "end": 24596.12,
      "formatted_start": "06:49:54.120",
      "formatted_end": "06:49:56.120",
      "text": "اصلا حالیش نبود."
    },
    {
      "id": 90,
      "start": 24596.12,
      "end": 24598.12,
      "formatted_start": "06:49:56.120",
      "formatted_end": "06:49:58.120",
      "text": "تو چیزه. تو دارو بوده."
    },
    {
      "id": 91,
      "start": 24598.12,
      "end": 24600.12,
      "formatted_start": "06:49:58.120",
      "formatted_end": "06:50:00.120",
      "text": "تو این اجتماعی چی میبینی؟"
    }
  ],
  "status": "completed"
}