  "stt_segments": [
    {
      "id": 0,
      "start": 2400.0,
      "end": 2429.98,
      "formatted_start": "00:40:00.000",
      "formatted_end": "00:40:29.980",
      "text": "موسیقی در مطب پزشکی"
    },
    {
      "id": 1,
      "start": 2430.0,
      "end": 2459.98,
      "formatted_start": "00:40:30.000",
      "formatted_end": "00:40:59.980",
      "text": "موسیقی در موسیقی درسته"
    },
    {
      "id": 2,
      "start": 2460.0,
      "end": 2487.0,
      "formatted_start": "00:41:00.000",
      "formatted_end": "00:41:27.000",
      "text": "موسیقی"
    },
    {
      "id": 3,
      "start": 2487.0,
      "end": 2490.0,
      "formatted_start": "00:41:27.000",
      "formatted_end": "00:41:30.000",
      "text": "الان سلام خانم دکتر وقتتون بخیر"
    },
    {
      "id": 4,
      "start": 2490.0,
      "end": 2493.0,
      "formatted_start": "00:41:30.000",
      "formatted_end": "00:41:33.000",
      "text": "مزرم نمیشم من دکتر حسین ایبای هستم همکارتون"
    },
    {
      "id": 5,
      "start": 2493.0,
      "end": 2497.0,
      "formatted_start": "00:41:33.000",
      "formatted_end": "00:41:37.000",
      "text": "حال شما خوبه؟ آسف خواهیم کنم اگر بعد موقع هم تماس گرفتم"
    },
    {
      "id": 6,
      "start": 2497.0,
      "end": 2502.0,
      "formatted_start": "00:41:37.000",
      "formatted_end": "00:41:42.000",
      "text": "خانم دکتر من پسرم سال آخر رشته مهندس کامپیتریه"
    },
    {
      "id": 7,
      "start": 2502.0,
      "end": 2505.0,
      "formatted_start": "00:41:42.000",
      "formatted_end": "00:41:45.000",
      "text": "برای این پایاننامه چیزی رو گرفته"
    },
    {
      "id": 8,
      "start": 2505.0,
      "end": 2510.0,
      "formatted_start": "00:41:45.000",
      "formatted_end": "00:41:50.000",
      "text": "به این صورت که مثلا در یک مثلا ویزیت پزشک و بیمار"
    },
    {
      "id": 9,
      "start": 2510.0,
      "end": 2513.0,
      "formatted_start": "00:41:50.000",
      "formatted_end": "00:41:53.000",
      "text": "چند دقیقه بیمار صحبت میکنه چقدر پزشک تایمهاشونه"
    },
    {
      "id": 10,
      "start": 2513.0,
      "end": 2519.0,
      "formatted_start": "00:41:53.000",
      "formatted_end": "00:41:59.000",
      "text": "بعد این ها چهار تا پزش که گفتن باید بردسی بشه دوتا خانوم دوتا مرد"
    },
    {
      "id": 11,
      "start": 2519.0,
      "end": 2525.0,
      "formatted_start": "00:41:59.000",
      "formatted_end": "00:42:05.000",
      "text": "دوتا مردی که آقای دکتر هرمیان زحمت کشیدن یه هفته و یکی هم خودم"
    },
    {
      "id": 12,
      "start": 2525.0,
      "end": 2532.0,
      "formatted_start": "00:42:05.000",
      "formatted_end": "00:42:12.000",
      "text": "که به این صورت که یک موبایل هست که این اوتوماتیک خودش فقط به صداها تعریف شده ضبط میکنه"
    },
    {
      "id": 13,
      "start": 2532.0,
      "end": 2538.0,
      "formatted_start": "00:42:12.000",
      "formatted_end": "00:42:18.000",
      "text": "یه هفته فقط تو مدتبتون به برق وزد میشه گذاشته میشه تا آخر هفته"
    },
    {
      "id": 14,
      "start": 2538.0,
      "end": 2542.9,
      "formatted_start": "00:42:18.000",
      "formatted_end": "00:42:22.900",
      "text": "تا آخر هفته بعدم برداشته میشه این باید اون آماراشو بگیر و مثلا اراعه بده"
    },
    {
      "id": 15,
      "start": 2542.9,
      "end": 2546.68,
      "formatted_start": "00:42:22.900",
      "formatted_end": "00:42:26.680",
      "text": "برای شما هیچ چیزی نداره مثلا خطر این مسئولیت"
    },
    {
      "id": 16,
      "start": 2546.68,
      "end": 2550.96,
      "formatted_start": "00:42:26.680",
      "formatted_end": "00:42:30.960",
      "text": "پس من از منشین میفرستم فقط تو اتاق خودتون باشه"
    },
    {
      "id": 17,
      "start": 2550.96,
      "end": 2555.02,
      "formatted_start": "00:42:30.960",
      "formatted_end": "00:42:35.020",
      "text": "و از برقم خارج نشه چون باتریش مشکل داره"
    },
    {
      "id": 18,
      "start": 2555.02,
      "end": 2556.0,
      "formatted_start": "00:42:35.020",
      "formatted_end": "00:42:36.000",
      "text": "من پنج"
    },
    {
      "id": 19,
      "start": 2556.0,
      "end": 2561.28,
      "formatted_start": "00:42:36.000",
      "formatted_end": "00:42:41.280",
      "text": "اشکال نداره اون برق بیاد فقط تو شارج باشه"
    },
    {
      "id": 20,
      "start": 2561.28,
      "end": 2564.82,
      "formatted_start": "00:42:41.280",
      "formatted_end": "00:42:44.820",
      "text": "من آخر هفته میگرم ممنون سبست میفرستم"
    },
    {
      "id": 21,
      "start": 2564.82,
      "end": 2568.82,
      "formatted_start": "00:42:44.820",
      "formatted_end": "00:42:48.820",
      "text": "سپاس کنید. این مریض مبارخص شد راستی؟ آه بله"
    },
    {
      "id": 22,
      "start": 2570.82,
      "end": 2574.82,
      "formatted_start": "00:42:50.820",
      "formatted_end": "00:42:54.820",
      "text": "آره این میدنم. بیدونم. خوب"
    },
    {
      "id": 23,
      "start": 2577.82,
      "end": 2579.82,
      "formatted_start": "00:42:57.820",
      "formatted_end": "00:42:59.820",
      "text": "بند"
    },
    {
      "id": 24,
      "start": 2581.82,
      "end": 2583.82,
      "formatted_start": "00:43:01.820",
      "formatted_end": "00:43:03.820",
      "text": "ریه شاید دست میده"
    },
    {
      "id": 25,
      "start": 2584.82,
      "end": 2586.82,
      "formatted_start": "00:43:04.820",
      "formatted_end": "00:43:06.820",
      "text": "آه روحیه. بله بله دورست"
    },
    {
      "id": 26,
      "start": 2589.82,
      "end": 2590.82,
      "formatted_start": "00:43:09.820",
      "formatted_end": "00:43:10.820",
      "text": "بله"
    },
    {
      "id": 27,
      "start": 2591.82,
      "end": 2592.82,
      "formatted_start": "00:43:11.820",
      "formatted_end": "00:43:12.820",
      "text": "بله"
    },
    {
      "id": 28,
      "start": 2594.82,
      "end": 2596.82,
      "formatted_start": "00:43:14.820",
      "formatted_end": "00:43:16.820",
