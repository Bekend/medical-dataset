  "stt_segments": [
    {
      "id": 0,
      "start": 15600.0,
      "end": 15602.0,
      "formatted_start": "04:20:00.000",
      "formatted_end": "04:20:02.000",
      "text": "پرس تیروی درمیان خوری؟"
    },
    {
      "id": 1,
      "start": 15602.0,
      "end": 15603.0,
      "formatted_start": "04:20:02.000",
      "formatted_end": "04:20:03.000",
      "text": "نه."
    },
    {
      "id": 2,
      "start": 15603.0,
      "end": 15606.0,
      "formatted_start": "04:20:03.000",
      "formatted_end": "04:20:06.000",
      "text": "هیچی نمیخوری؟ نه؟"
    },
    {
      "id": 3,
      "start": 15608.0,
      "end": 15612.0,
      "formatted_start": "04:20:08.000",
      "formatted_end": "04:20:12.000",
      "text": "مادر به تو بهتر است، بهتر است تو، خیلی بهتر است تو."
    },
    {
      "id": 4,
      "start": 15612.0,
      "end": 15642.0,
      "formatted_start": "04:20:12.000",
      "formatted_end": "04:20:42.000",
      "text": "از اینجا باید بردارید که اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه ا"
    },
    {
      "id": 5,
      "start": 15642.0,
      "end": 15668.0,
      "formatted_start": "04:20:42.000",
      "formatted_end": "04:21:08.000",
      "text": "موسیقی"
    },
    {
      "id": 6,
      "start": 15668.0,
      "end": 15671.0,
      "formatted_start": "04:21:08.000",
      "formatted_end": "04:21:11.000",
      "text": "تیروی لطفاً خوب، کم کاره"
    },
    {
      "id": 7,
      "start": 15683.0,
      "end": 15685.0,
      "formatted_start": "04:21:23.000",
      "formatted_end": "04:21:25.000",
      "text": "برای پدید آمدید اونجا نمیشی؟"
    },
    {
      "id": 8,
      "start": 15686.0,
      "end": 15687.0,
      "formatted_start": "04:21:26.000",
      "formatted_end": "04:21:27.000",
      "text": "بخاطر اینکه"
    },
    {
      "id": 9,
      "start": 15688.0,
      "end": 15690.0,
      "formatted_start": "04:21:28.000",
      "formatted_end": "04:21:30.000",
      "text": "قرمانات خوبی هم بهمید"
    },
    {
      "id": 10,
      "start": 15692.0,
      "end": 15694.0,
      "formatted_start": "04:21:32.000",
      "formatted_end": "04:21:34.000",
      "text": "سیناها چیه نمیده؟"
    },
    {
      "id": 11,
      "start": 15694.0,
      "end": 15700.0,
      "formatted_start": "04:21:34.000",
      "formatted_end": "04:21:40.000",
      "text": "من فقط اینکه من را برای خود میشکرم، این کام هست"
    },
    {
      "id": 12,
      "start": 15700.0,
      "end": 15703.0,
      "formatted_start": "04:21:40.000",
      "formatted_end": "04:21:43.000",
      "text": "و اگر نه بازم من به فکر این چیز نیستم"
    },
    {
      "id": 13,
      "start": 15703.0,
      "end": 15707.0,
      "formatted_start": "04:21:43.000",
      "formatted_end": "04:21:47.000",
      "text": "فقط اینکه بتونم این کام را راحت بذارم راه برم"
    },
    {
      "id": 14,
      "start": 15707.0,
      "end": 15709.0,
      "formatted_start": "04:21:47.000",
      "formatted_end": "04:21:49.000",
      "text": "شغلت چه هست؟"
    },
    {
      "id": 15,
      "start": 15709.0,
      "end": 15710.0,
      "formatted_start": "04:21:49.000",
      "formatted_end": "04:21:50.000",
      "text": "جا؟"
    },
    {
      "id": 16,
      "start": 15710.0,
      "end": 15711.0,
      "formatted_start": "04:21:50.000",
      "formatted_end": "04:21:51.000",
      "text": "شغلت چه هست؟"
    },
    {
      "id": 17,
      "start": 15711.0,
      "end": 15713.0,
      "formatted_start": "04:21:51.000",
      "formatted_end": "04:21:53.000",
      "text": "کافینت هست"
    },
    {
      "id": 18,
      "start": 15713.0,
      "end": 15715.0,
      "formatted_start": "04:21:53.000",
      "formatted_end": "04:21:55.000",
      "text": "خودت سر کافینت هست؟"
    },
    {
      "id": 19,
      "start": 15715.0,
      "end": 15717.0,
      "formatted_start": "04:21:55.000",
      "formatted_end": "04:21:57.000",
      "text": "نه نه، کار"
    },
    {
      "id": 20,
      "start": 15724.0,
      "end": 15728.0,
      "formatted_start": "04:22:04.000",
      "formatted_end": "04:22:08.000",
      "text": "باید بینیم که مشکل نیست نداره من"
    },
    {
      "id": 21,
      "start": 15728.0,
      "end": 15732.0,
      "formatted_start": "04:22:08.000",
      "formatted_end": "04:22:12.000",
      "text": "باید اینجا هم تیر میده شد داخل"
    },
    {
      "id": 22,
      "start": 15744.0,
      "end": 15749.0,
      "formatted_start": "04:22:24.000",
      "formatted_end": "04:22:29.000",
      "text": "خیلی استرسه بی خودی دارم از این میتونم شب بخوابم"
    },
    {
      "id": 23,
      "start": 15749.0,
      "end": 15779.0,
      "formatted_start": "04:22:29.000",
      "formatted_end": "04:22:59.000",
      "text": "از اینجا باید بردارید که از اینجا باید بردارید که از اینجا بردارید که از اینجا بردارید که از اینجا بردارید که از اینجا بردارید که از اینجا بردارید که از اینجا بردارید که از اینجا بردارید که از اینجا بردارید که از اینجا بردارید که از اینجا بردارید که از اینجا بردارید که از اینجا بردارید که از اینجا بردارید که از اینج"
    },
    {
      "id": 24,
      "start": 15779.0,
      "end": 15781.0,
      "formatted_start": "04:22:59.000",
      "formatted_end": "04:23:01.000",
      "text": "از اینجا باید برداریم که اینجا باید برداریم"
    },
    {
      "id": 25,
      "start": 15781.0,
      "end": 15783.0,
      "formatted_start": "04:23:01.000",
      "formatted_end": "04:23:03.000",
      "text": "از اینجا باید برداریم که اینجا برداریم"
    },
    {
      "id": 26,
      "start": 15783.0,
      "end": 15785.0,
      "formatted_start": "04:23:03.000",
      "formatted_end": "04:23:05.000",
      "text": "از اینجا باید برداریم که اینجا برداریم"
    },
    {
      "id": 27,
      "start": 15785.0,
      "end": 15787.0,
      "formatted_start": "04:23:05.000",
      "formatted_end": "04:23:07.000",
      "text": "از اینجا برداریم که اینجا برداریم"
    },
    {
      "id": 28,
      "start": 15787.0,
      "end": 15789.0,
      "formatted_start": "04:23:07.000",
      "formatted_end": "04:23:09.000",
      "text": "از اینجا برداریم که اینجا برداریم"
    },
    {
      "id": 29,
      "start": 15789.0,
      "end": 15791.0,
      "formatted_start": "04:23:09.000",
      "formatted_end": "04:23:11.000",
      "text": "از اینجا برداریم که اینجا برداریم"
    },
    {
      "id": 30,
      "start": 15791.0,
      "end": 15793.0,
      "formatted_start": "04:23:11.000",
      "formatted_end": "04:23:13.000",
      "text": "از اینجا برداریم که اینجا برداریم"
    },
    {
      "id": 31,
      "start": 15793.0,
      "end": 15795.0,
      "formatted_start": "04:23:13.000",
      "formatted_end": "04:23:15.000",
      "text": "از اینجا برداریم که اینجا برداریم"
    },
    {
      "id": 32,
      "start": 15809.0,
      "end": 15813.0,
      "formatted_start": "04:23:29.000",
      "formatted_end": "04:23:33.000",
      "text": "میخوری نوشابه میخوری؟"
    },
    {
      "id": 33,
      "start": 15813.0,
      "end": 15819.0,
      "formatted_start": "04:23:33.000",
      "formatted_end": "04:23:39.000",
      "text": "میخوری درسته؟ این دونه قربوزه چهار دو هم میخوری؟"
    },
    {
      "id": 34,
      "start": 15819.0,
      "end": 15825.0,
      "formatted_start": "04:23:39.000",
      "formatted_end": "04:23:45.000",
      "text": "معلوم بدی از آزمایش ها؟ نمیدونه باید چی کنیم"
    },
    {
      "id": 35,
      "start": 15825.0,
      "end": 15831.0,
      "formatted_start": "04:23:45.000",
      "formatted_end": "04:23:51.000",
      "text": "این ها پرس که به تیروید رو تایید کرده هست"
    },
    {
      "id": 36,
      "start": 15831.0,
      "end": 15836.0,
      "formatted_start": "04:23:51.000",
      "formatted_end": "04:23:56.000",
      "text": "پرس تیروید رو از این باز صبح به صبح ماشته یه دونه بخور"
    },
    {
      "id": 37,
      "start": 15836.0,
      "end": 15839.28,
      "formatted_start": "04:23:56.000",
      "formatted_end": "04:23:59.280",
      "text": "تا یک ساعت بعدش هم هیچی نمیخوری خوان"
    },
    {
      "id": 38,
      "start": 15839.28,
      "end": 15841.48,
      "formatted_start": "04:23:59.280",
      "formatted_end": "04:24:01.480",
      "text": "هم دونه خواه و زنگون و موز"
    },
    {
      "id": 39,
      "start": 15843.24,
      "end": 15844.64,
      "formatted_start": "04:24:03.240",
      "formatted_end": "04:24:04.640",
      "text": "نه اصلا هر نداره نیستم"
    },
    {
      "id": 40,
      "start": 15844.64,
      "end": 15846.0,
      "formatted_start": "04:24:04.640",
      "formatted_end": "04:24:06.000",
      "text": "من دوست ندارم هم"
    },
    {
      "id": 41,
      "start": 15847.84,
      "end": 15851.32,
      "formatted_start": "04:24:07.840",
      "formatted_end": "04:24:11.320",
      "text": "ولی مثلا نوش و باشه یه لبا میکردم"
    },
    {
      "id": 42,
      "start": 15852.16,
      "end": 15855.76,
      "formatted_start": "04:24:12.160",
      "formatted_end": "04:24:15.760",
      "text": "لاغت میخوری خوب نیست ولی باز رژیمی بخور لاغت"
    },
    {
      "id": 43,
      "start": 15866.0,
      "end": 15872.58,
      "formatted_start": "04:24:26.000",
      "formatted_end": "04:24:32.580",
      "text": "صبح چون وقت نمی کنم صبح نبخوانم میتونم یکی منو چای شیره می کنم دیگه رفت و زر بخوانم"
    },
    {
      "id": 44,
      "start": 15872.58,
      "end": 15877.24,
      "formatted_start": "04:24:32.580",
      "formatted_end": "04:24:37.240",
      "text": "باید بخوانیم یه خوب چون من دیگه نمی خورم اینو سوزه فکرتی نه؟"
    },
    {
      "id": 45,
      "start": 15877.24,
      "end": 15877.86,
      "formatted_start": "04:24:37.240",
      "formatted_end": "04:24:37.860",
      "text": "نه نه"
    },
    {
      "id": 46,
      "start": 15877.86,
      "end": 15878.86,
      "formatted_start": "04:24:37.860",
      "formatted_end": "04:24:38.860",
      "text": "اصلا این نیست"
    },
    {
      "id": 47,
      "start": 15878.86,
      "end": 15888.0,
      "formatted_start": "04:24:38.860",
      "formatted_end": "04:24:48.000",
      "text": "قلبت در جان زنوالا یه خونزه شبکه هم می کنی"
    },
    {
      "id": 48,
      "start": 15888.0,
      "end": 15892.18,
      "formatted_start": "04:24:48.000",
      "formatted_end": "04:24:52.180",
      "text": "میره تا بعده بعد که دوباره همین قلبت رو بزنید"
    },
    {
      "id": 49,
      "start": 15896.0,
      "end": 15900.0,
      "formatted_start": "04:24:56.000",
      "formatted_end": "04:25:00.000",
      "text": "موسیقی"
    }
  ],
  "status": "completed"
}