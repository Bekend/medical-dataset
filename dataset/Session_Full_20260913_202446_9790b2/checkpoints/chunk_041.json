  "stt_segments": [
    {
      "id": 0,
      "start": 12300.0,
      "end": 12330.0,
      "formatted_start": "03:25:00.000",
      "formatted_end": "03:25:30.000",
      "text": "از اینجور، از اینجور، از اینجور، از اینجور، از اینجور، از اینجور، از اینجور، از اینجور، از اینجور، از اینجور، از اینجور، از اینجور، از اینجور، از اینجور، از اینجور، از اینجور، از اینجور، از اینجور، از اینجور، از اینجور، از اینجور، از اینجور، از اینجور، از اینجور، از اینجور، از اینجور، از اینجور، از اینجور، از اینجور، از اینجور، از اینجور، از اینجور"
    },
    {
      "id": 1,
      "start": 12330.0,
      "end": 12336.0,
      "formatted_start": "03:25:30.000",
      "formatted_end": "03:25:36.000",
      "text": "حالا میگم دیگه نگران نباشید. مونتا دیگه بیماری ما ها نور شدید بشه"
    },
    {
      "id": 2,
      "start": 12336.0,
      "end": 12340.0,
      "formatted_start": "03:25:36.000",
      "formatted_end": "03:25:40.000",
      "text": "و شما جنتیک توی پدرتون هم همین خیلی برنامه زد باشید"
    },
    {
      "id": 3,
      "start": 12340.0,
      "end": 12345.0,
      "formatted_start": "03:25:40.000",
      "formatted_end": "03:25:45.000",
      "text": "خیلی کبابی نباید بخورید و حضرت ما هم پس باشه"
    },
    {
      "id": 4,
      "start": 12345.0,
      "end": 12347.0,
      "formatted_start": "03:25:45.000",
      "formatted_end": "03:25:47.000",
      "text": "گوشت قرنز نمازید باشه"
    },
    {
      "id": 5,
      "start": 12347.0,
      "end": 12351.0,
      "formatted_start": "03:25:47.000",
      "formatted_end": "03:25:51.000",
      "text": "و اصل بیماری کلا نقضه شد"
    },
    {
      "id": 6,
      "start": 12351.0,
      "end": 12352.0,
      "formatted_start": "03:25:51.000",
      "formatted_end": "03:25:52.000",
      "text": "یعنی استرس"
    },
    {
      "id": 7,
      "start": 12352.0,
      "end": 12354.0,
      "formatted_start": "03:25:52.000",
      "formatted_end": "03:25:54.000",
      "text": "استرس تمام باشه"
    },
    {
      "id": 8,
      "start": 12354.0,
      "end": 12357.0,
      "formatted_start": "03:25:54.000",
      "formatted_end": "03:25:57.000",
      "text": "باشه جنتیک آمل تمام"
    },
    {
      "id": 9,
      "start": 12360.0,
      "end": 12390.0,
      "formatted_start": "03:26:00.000",
      "formatted_end": "03:26:30.000",
      "text": "از اینجا باید برداریم که اینجا باید برداریم که اینجا برداریم که اینجا برداریم که اینجا برداریم که اینجا برداریم که اینجا برداریم که اینجا برداریم که اینجا برداریم که اینجا برداریم که اینجا برداریم که اینجا برداریم که اینجا برداریم که اینجا برداریم که اینجا برداریم که اینجا برداریم که اینجا برداریم که اینجا برداری"
    },
    {
      "id": 10,
      "start": 12390.0,
      "end": 12392.0,
      "formatted_start": "03:26:30.000",
      "formatted_end": "03:26:32.000",
      "text": "بعدا دیده مامان داره بدتر میشه"
    },
    {
      "id": 11,
      "start": 12392.0,
      "end": 12394.0,
      "formatted_start": "03:26:32.000",
      "formatted_end": "03:26:34.000",
      "text": "آره سریع نوبت بگیری"
    },
    {
      "id": 12,
      "start": 12394.0,
      "end": 12396.0,
      "formatted_start": "03:26:34.000",
      "formatted_end": "03:26:36.000",
      "text": "قرابی؟"
    },
    {
      "id": 13,
      "start": 12396.0,
      "end": 12398.0,
      "formatted_start": "03:26:36.000",
      "formatted_end": "03:26:38.000",
      "text": "آره سریع تصویبی شروع کنه"
    },
    {
      "id": 14,
      "start": 12398.0,
      "end": 12400.0,
      "formatted_start": "03:26:38.000",
      "formatted_end": "03:26:40.000",
      "text": "و شما مکمل به قرابی دارن؟"
    },
    {
      "id": 15,
      "start": 12400.0,
      "end": 12402.0,
      "formatted_start": "03:26:40.000",
      "formatted_end": "03:26:42.000",
      "text": "نه کانونی چیزی نیست"
    },
    {
      "id": 16,
      "start": 12402.0,
      "end": 12404.0,
      "formatted_start": "03:26:42.000",
      "formatted_end": "03:26:44.000",
      "text": "نامه نوشتن، نامه میدن و دوترون کنن"
    },
    {
      "id": 17,
      "start": 12404.0,
      "end": 12406.0,
      "formatted_start": "03:26:44.000",
      "formatted_end": "03:26:46.000",
      "text": "خوب در جریان بازد"
    },
    {
      "id": 18,
      "start": 12406.0,
      "end": 12408.0,
      "formatted_start": "03:26:46.000",
      "formatted_end": "03:26:48.000",
      "text": "و خلاص پرمندش کجا بست؟"
    },
    {
      "id": 19,
      "start": 12408.0,
      "end": 12410.0,
      "formatted_start": "03:26:48.000",
      "formatted_end": "03:26:50.000",
      "text": "ریمارسان بهتون داده دیده"
    },
    {
      "id": 20,
      "start": 12410.0,
      "end": 12412.0,
      "formatted_start": "03:26:50.000",
      "formatted_end": "03:26:52.000",
      "text": "یه برگ پایینش زرده"
    },
    {
      "id": 21,
      "start": 12412.0,
      "end": 12414.0,
      "formatted_start": "03:26:52.000",
      "formatted_end": "03:26:54.000",
      "text": "چرا موقعی ترخیص قطعا میدن بهتون"
    },
    {
      "id": 22,
      "start": 12414.0,
      "end": 12416.0,
      "formatted_start": "03:26:54.000",
      "formatted_end": "03:26:56.000",
      "text": "این همه رو میبازم"
    },
    {
      "id": 23,
      "start": 12416.0,
      "end": 12421.0,
      "formatted_start": "03:26:56.000",
      "formatted_end": "03:27:01.000",
      "text": "آره، یه برگ از اون خون رو هر جا میرید با خودتون برایشون تمامه"
    },
    {
      "id": 24,
      "start": 12421.0,
      "end": 12425.0,
      "formatted_start": "03:27:01.000",
      "formatted_end": "03:27:05.000",
      "text": "دارالایی که مامان میبازه بود خیلی مهمه سیر بیمارش"
    },
    {
      "id": 25,
      "start": 12425.0,
      "end": 12427.0,
      "formatted_start": "03:27:05.000",
      "formatted_end": "03:27:07.000",
      "text": "هر بردونه"
    },
    {
      "id": 26,
      "start": 12427.0,
      "end": 12428.0,
      "formatted_start": "03:27:07.000",
      "formatted_end": "03:27:08.000",
      "text": "سیر؟"
    },
    {
      "id": 27,
      "start": 12428.0,
      "end": 12430.0,
      "formatted_start": "03:27:08.000",
      "formatted_end": "03:27:10.000",
      "text": "سیر بیمارش خیلی مهمه"
    },
    {
      "id": 28,
      "start": 12430.0,
      "end": 12432.0,
      "formatted_start": "03:27:10.000",
      "formatted_end": "03:27:12.000",
      "text": "و آن توی چند داره؟"
    },
    {
      "id": 29,
      "start": 12432.0,
      "end": 12434.0,
      "formatted_start": "03:27:12.000",
      "formatted_end": "03:27:14.000",
      "text": "و محشت رو کنش که اون خون رو؟"
    },
    {
      "id": 30,
      "start": 12434.0,
      "end": 12436.0,
      "formatted_start": "03:27:14.000",
      "formatted_end": "03:27:16.000",
      "text": "کجا موردی مورد داره"
    },
    {
      "id": 31,
      "start": 12436.0,
      "end": 12438.0,
      "formatted_start": "03:27:16.000",
      "formatted_end": "03:27:18.000",
      "text": "و سرچ باشی؟"
    },
    {
      "id": 32,
      "start": 12438.0,
      "end": 12440.0,
      "formatted_start": "03:27:18.000",
      "formatted_end": "03:27:20.000",
      "text": "نه، با سوره یکی آدازشون"
    },
    {
      "id": 33,
      "start": 12440.0,
      "end": 12443.0,
      "formatted_start": "03:27:20.000",
      "formatted_end": "03:27:23.000",
      "text": "دیگه تلفنی نیستن، زیروری همون رو"
    },
    {
      "id": 34,
      "start": 12443.0,
      "end": 12445.0,
      "formatted_start": "03:27:23.000",
      "formatted_end": "03:27:25.000",
      "text": "مریض ها یه جوری هستید اینا"
    },
    {
      "id": 35,
      "start": 12449.0,
      "end": 12453.0,
      "formatted_start": "03:27:29.000",
      "formatted_end": "03:27:33.000",
      "text": "تهران رو هر ترید سکونت داشته باشید"
    },
    {
      "id": 36,
      "start": 12453.0,
      "end": 12455.0,
      "formatted_start": "03:27:33.000",
      "formatted_end": "03:27:35.000",
      "text": "اینجا بگیم کجا براتون بخواهید"
    },
    {
      "id": 37,
      "start": 12455.0,
      "end": 12457.0,
      "formatted_start": "03:27:35.000",
      "formatted_end": "03:27:37.000",
      "text": "هر جا کشور بوتل بیگید"
    },
    {
      "id": 38,
      "start": 12457.0,
      "end": 12459.0,
      "formatted_start": "03:27:37.000",
      "formatted_end": "03:27:39.000",
      "text": "براتون بخواهد مریض بوتل بیشه سخت"
    },
    {
      "id": 39,
      "start": 12459.0,
      "end": 12463.0,
      "formatted_start": "03:27:39.000",
      "formatted_end": "03:27:43.000",
      "text": "اگر آنجایی میخواد بوتل بره همینجا بره"
    },
    {
      "id": 40,
      "start": 12463.0,
      "end": 12467.0,
      "formatted_start": "03:27:43.000",
      "formatted_end": "03:27:47.000",
      "text": "تهران باشه بخواهد کنه آشناه باشه"
    },
    {
      "id": 41,
      "start": 12467.0,
      "end": 12469.0,
      "formatted_start": "03:27:47.000",
      "formatted_end": "03:27:49.000",
      "text": "مثلا آرانجان خود و بوتل"
    },
    {
      "id": 42,
      "start": 12469.0,
      "end": 12471.0,
      "formatted_start": "03:27:49.000",
      "formatted_end": "03:27:51.000",
      "text": "بعضا نمیخواد مریض بوتل بره"
    },
    {
      "id": 43,
      "start": 12471.0,
      "end": 12473.0,
      "formatted_start": "03:27:51.000",
      "formatted_end": "03:27:53.000",
      "text": "با اون یک چهید پره"
    },
    {
      "id": 44,
      "start": 12480.0,
      "end": 12484.0,
      "formatted_start": "03:28:00.000",
      "formatted_end": "03:28:04.000",
      "text": "از اینکه با موشین هم هنچون محشه شده ایران از یک چون فروز بود"
    },
    {
      "id": 45,
      "start": 12488.0,
      "end": 12490.0,
      "formatted_start": "03:28:08.000",
      "formatted_end": "03:28:10.000",
      "text": "فیلم از همون دکتر قرار بگیر"
    },
    {
      "id": 46,
      "start": 12490.0,
      "end": 12493.0,
      "formatted_start": "03:28:10.000",
      "formatted_end": "03:28:13.000",
      "text": "چون گفت مثلا با من گفت سنجری بگم سنجری هم خوبه"
    },
    {
      "id": 47,
      "start": 12493.0,
      "end": 12495.0,
      "formatted_start": "03:28:13.000",
      "formatted_end": "03:28:15.000",
      "text": "میخوای بگم نداشت که واضح بشکی نداره"
    },
    {
      "id": 48,
      "start": 12495.0,
      "end": 12503.0,
      "formatted_start": "03:28:15.000",
      "formatted_end": "03:28:23.000",
      "text": "برای از همه قراره چیسته دارد، تجربهش بیشتره، نانا باید خیلی شده"
    },
    {
      "id": 49,
      "start": 12503.0,
      "end": 12507.0,
      "formatted_start": "03:28:23.000",
      "formatted_end": "03:28:27.000",
      "text": "از این محل مریضه بوده قراره بیان که دو دیگه بیشتره؟"
    },
    {
      "id": 50,
      "start": 12507.0,
      "end": 12510.0,
      "formatted_start": "03:28:27.000",
      "formatted_end": "03:28:30.000",
      "text": "از این محل میگم دکتر، کمی چی ماده ای تو میدونه از این"
    },
    {
      "id": 51,
      "start": 12510.0,
      "end": 12514.0,
      "formatted_start": "03:28:30.000",
      "formatted_end": "03:28:34.000",
      "text": "کلیلن الانم با دستور داروی دیگه دکتر داده من دارم آخذ"
    },
    {
      "id": 52,
      "start": 12514.0,
      "end": 12518.0,
      "formatted_start": "03:28:34.000",
      "formatted_end": "03:28:38.000",
      "text": "مهمولا در این پیزشکه عوض میشه، دوست دارو یک کار روی جدید انجام باشی"
    },
    {
      "id": 53,
      "start": 12518.0,
      "end": 12519.0,
      "formatted_start": "03:28:38.000",
      "formatted_end": "03:28:39.000",
      "text": "بله بله"
    },
    {
      "id": 54,
      "start": 12519.0,
      "end": 12521.0,
      "formatted_start": "03:28:39.000",
      "formatted_end": "03:28:41.000",
      "text": "من فقط نمیخوام حقیقتشه"
    },
    {
      "id": 55,
      "start": 12521.0,
      "end": 12523.0,
      "formatted_start": "03:28:41.000",
      "formatted_end": "03:28:43.000",
      "text": "اون حال شدیده دیگه"
    },
    {
      "id": 56,
      "start": 12523.0,
      "end": 12525.0,
      "formatted_start": "03:28:43.000",
      "formatted_end": "03:28:45.000",
      "text": "بارایتو با تون دیگه"
    },
    {
      "id": 57,
      "start": 12525.0,
      "end": 12527.0,
      "formatted_start": "03:28:45.000",
      "formatted_end": "03:28:47.000",
      "text": "اون حال مامان شدیده"
    },
    {
      "id": 58,
      "start": 12527.0,
      "end": 12529.0,
      "formatted_start": "03:28:47.000",
      "formatted_end": "03:28:49.000",
      "text": "اون شدیده این خطرناکه؟"
    },
    {
      "id": 59,
      "start": 12529.0,
      "end": 12531.0,
      "formatted_start": "03:28:49.000",
      "formatted_end": "03:28:51.000",
      "text": "نه شدیده"
    },
    {
      "id": 60,
      "start": 12531.0,
      "end": 12533.0,
      "formatted_start": "03:28:51.000",
      "formatted_end": "03:28:53.000",
      "text": "خطرناکه اگه پیشرفت کنه تو برای التعابش"
    },
    {
      "id": 61,
      "start": 12533.0,
      "end": 12535.0,
      "formatted_start": "03:28:53.000",
      "formatted_end": "03:28:55.000",
      "text": "آره میتونی خطرناکه بشه"
    },
    {
      "id": 62,
      "start": 12535.0,
      "end": 12537.0,
      "formatted_start": "03:28:55.000",
      "formatted_end": "03:28:57.000",
      "text": "اگه این التعابه یه دفعه پیشرفت کنه"
    },
    {
      "id": 63,
      "start": 12537.0,
      "end": 12539.0,
      "formatted_start": "03:28:57.000",
      "formatted_end": "03:28:59.000",
      "text": "من چون شدید"
    },
    {
      "id": 64,
      "start": 12539.0,
      "end": 12541.0,
      "formatted_start": "03:28:59.000",
      "formatted_end": "03:29:01.000",
      "text": "تو اینجور قرابه باز باید چونیه بچه ها رو بگیرن؟"
    },
    {
      "id": 65,
      "start": 12541.0,
      "end": 12543.0,
      "formatted_start": "03:29:01.000",
      "formatted_end": "03:29:03.000",
      "text": "من بهتون یه نامه میدنم"
    },
    {
      "id": 66,
      "start": 12543.0,
      "end": 12545.0,
      "formatted_start": "03:29:03.000",
      "formatted_end": "03:29:05.000",
      "text": "از اینجور بی کنیشی و بعد شاید باید می کنم"
    },
    {
      "id": 67,
      "start": 12545.0,
      "end": 12547.0,
      "formatted_start": "03:29:05.000",
      "formatted_end": "03:29:07.000",
      "text": "برد اینجور بسرده"
    },
    {
      "id": 68,
      "start": 12547.0,
      "end": 12549.0,
      "formatted_start": "03:29:07.000",
      "formatted_end": "03:29:09.000",
      "text": "تو باید برد سرکن تو کنه بیدیم چطوری"
    },
    {
      "id": 69,
      "start": 12549.0,
      "end": 12551.0,
      "formatted_start": "03:29:09.000",
      "formatted_end": "03:29:11.000",
      "text": "اگه دیدی نه دیگه پرد و پسرده داره"
    },
    {
      "id": 70,
      "start": 12551.0,
      "end": 12553.0,
      "formatted_start": "03:29:11.000",
      "formatted_end": "03:29:13.000",
      "text": "خیلی دیگه جدا داره"
    },
    {
      "id": 71,
      "start": 12553.0,
      "end": 12555.0,
      "formatted_start": "03:29:13.000",
      "formatted_end": "03:29:15.000",
      "text": "پرد آرامشه که تو برد برد"
    },
    {
      "id": 72,
      "start": 12555.0,
      "end": 12557.0,
      "formatted_start": "03:29:15.000",
      "formatted_end": "03:29:17.000",
      "text": "در حال اگه یه وقت نصف شب دردش شد"
    },
    {
      "id": 73,
      "start": 12557.0,
      "end": 12559.0,
      "formatted_start": "03:29:17.000",
      "formatted_end": "03:29:19.000",
      "text": "شامل پروفی دارد آرامشه"
    },
    {
      "id": 74,
      "start": 12559.0,
      "end": 12561.0,
      "formatted_start": "03:29:19.000",
      "formatted_end": "03:29:21.000",
      "text": "برد اینجور تا آن پول نوسم"
    },
    {
      "id": 75,
      "start": 12561.0,
      "end": 12563.0,
      "formatted_start": "03:29:21.000",
      "formatted_end": "03:29:23.000",
      "text": "انشاله درد بردشتن می شم"
    },
    {
      "id": 76,
      "start": 12563.0,
      "end": 12591.0,
      "formatted_start": "03:29:23.000",
      "formatted_end": "03:29:51.000",
      "text": "موسیقی"
    }
  ],
  "status": "completed"
}