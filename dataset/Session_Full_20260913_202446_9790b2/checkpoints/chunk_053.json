  "stt_segments": [
    {
      "id": 0,
      "start": 15900.0,
      "end": 15909.0,
      "formatted_start": "04:25:00.000",
      "formatted_end": "04:25:09.000",
      "text": "از این تیروید را در نیزار پریورد پشید."
    },
    {
      "id": 1,
      "start": 15909.0,
      "end": 15917.0,
      "formatted_start": "04:25:09.000",
      "formatted_end": "04:25:17.000",
      "text": "گل و تریو نوشتم نصف صبح، صبح، صبح، نصف شم، صبح و نهاشم، هر تا اون یه لغه که میخوریم."
    },
    {
      "id": 2,
      "start": 15917.0,
      "end": 15923.0,
      "formatted_start": "04:25:17.000",
      "formatted_end": "04:25:23.000",
      "text": "از ذره و سعیت که نوع خالی برداد، اون رو در راه بکنم، به قسمت یک دو یار دیگه پشت بکنم."
    },
    {
      "id": 3,
      "start": 15923.0,
      "end": 15929.0,
      "formatted_start": "04:25:23.000",
      "formatted_end": "04:25:29.000",
      "text": "صبح صحت چند، بگویم نیز در راه بکنم، من کمی نمیشم، آمان بودم."
    },
    {
      "id": 4,
      "start": 15929.0,
      "end": 15933.0,
      "formatted_start": "04:25:29.000",
      "formatted_end": "04:25:33.000",
      "text": "چون شبها دیر میخوام"
    },
    {
      "id": 5,
      "start": 15933.0,
      "end": 15937.0,
      "formatted_start": "04:25:33.000",
      "formatted_end": "04:25:37.000",
      "text": "در دو و نیم سه میخوام ازو بر دیر دارم"
    },
    {
      "id": 6,
      "start": 15937.0,
      "end": 15941.0,
      "formatted_start": "04:25:37.000",
      "formatted_end": "04:25:41.000",
      "text": "چرا دیر میخوایی؟ خاطر مهمانم دیگه"
    },
    {
      "id": 7,
      "start": 15941.0,
      "end": 15945.0,
      "formatted_start": "04:25:41.000",
      "formatted_end": "04:25:45.000",
      "text": "بیقراری میکنه یه کورسش برده دم تنظیم کردم چه موقعی بدن"
    },
    {
      "id": 8,
      "start": 15945.0,
      "end": 15949.0,
      "formatted_start": "04:25:45.000",
      "formatted_end": "04:25:49.000",
      "text": "چون شبها دیر میخوایم من مجبورم باش بیدار بگم"
    },
    {
      "id": 9,
      "start": 15949.0,
      "end": 15953.0,
      "formatted_start": "04:25:49.000",
      "formatted_end": "04:25:53.000",
      "text": "نه برای چه مجبوری؟"
    },
    {
      "id": 10,
      "start": 15953.0,
      "end": 15957.0,
      "formatted_start": "04:25:53.000",
      "formatted_end": "04:25:57.000",
      "text": "این استرسی که دارم دیگه"
    },
    {
      "id": 11,
      "start": 15957.0,
      "end": 15962.0,
      "formatted_start": "04:25:57.000",
      "formatted_end": "04:26:02.000",
      "text": "تو برای کم رو فکر فردت کن"
    },
    {
      "id": 12,
      "start": 15962.0,
      "end": 15966.0,
      "formatted_start": "04:26:02.000",
      "formatted_end": "04:26:06.000",
      "text": "مطمئن باش مادر تن به همه راضیه ها"
