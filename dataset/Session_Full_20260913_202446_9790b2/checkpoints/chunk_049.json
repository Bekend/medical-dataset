  "stt_segments": [
    {
      "id": 0,
      "start": 14700.0,
      "end": 14706.0,
      "formatted_start": "04:05:00.000",
      "formatted_end": "04:05:06.000",
      "text": "آقای ناصری شهرمنده، برای زینفتت باید مراجعه کنی به ساتا، خب؟"
    },
    {
      "id": 1,
      "start": 14706.0,
      "end": 14713.0,
      "formatted_start": "04:05:06.000",
      "formatted_end": "04:05:13.000",
      "text": "برای قرز زینفتت باید مراجعه کنی به ساتا، من خود در اینکه داروهای دیگه تا میز بستم."
    },
    {
      "id": 2,
      "start": 14713.0,
      "end": 14714.0,
      "formatted_start": "04:05:13.000",
      "formatted_end": "04:05:14.000",
      "text": "خب؟"
    },
    {
      "id": 3,
      "start": 14714.0,
      "end": 14716.0,
      "formatted_start": "04:05:14.000",
      "formatted_end": "04:05:16.000",
      "text": "خب، بود که من دکترم."
    },
    {
      "id": 4,
      "start": 14716.0,
      "end": 14717.0,
      "formatted_start": "04:05:16.000",
      "formatted_end": "04:05:17.000",
      "text": "خمان، خمان."
    },
    {
      "id": 5,
      "start": 14717.0,
      "end": 14721.0,
      "formatted_start": "04:05:17.000",
      "formatted_end": "04:05:21.000",
      "text": "من ممنون. این بابا هم دیالیزیه، یه سری آوردن باشه."
    },
    {
      "id": 6,
      "start": 14721.0,
      "end": 14723.0,
      "formatted_start": "04:05:21.000",
      "formatted_end": "04:05:23.000",
      "text": "اول بردارو کنه."
    },
    {
      "id": 7,
      "start": 14723.0,
      "end": 14727.0,
      "formatted_start": "04:05:23.000",
      "formatted_end": "04:05:27.000",
      "text": "این همه هم یک مال باشه، این میگه که هیچ نیمیتونم خود بدم."
    },
    {
      "id": 8,
      "start": 14727.0,
      "end": 14756.98,
      "formatted_start": "04:05:27.000",
      "formatted_end": "04:05:56.980",
      "text": "از اینجا برنجی میخورد که از اول هر چی بیخورده گرمی کرده یا اول نومیشتر گرمی کرده."
    },
    {
      "id": 9,
      "start": 14757.0,
      "end": 14759.0,
      "formatted_start": "04:05:57.000",
      "formatted_end": "04:05:59.000",
      "text": "بله"
    },
    {
      "id": 10,
      "start": 14759.0,
      "end": 14761.0,
      "formatted_start": "04:05:59.000",
      "formatted_end": "04:06:01.000",
      "text": "آقا، آقا، انا همینه چه آیده گیره دیدیم؟"
    },
    {
      "id": 11,
      "start": 14761.0,
      "end": 14763.0,
      "formatted_start": "04:06:01.000",
      "formatted_end": "04:06:03.000",
      "text": "خوب، با واقع شاکه آیده باشم"
    },
    {
      "id": 12,
      "start": 14763.0,
      "end": 14765.0,
      "formatted_start": "04:06:03.000",
      "formatted_end": "04:06:05.000",
      "text": "بگه پرشین شماه"
    },
    {
      "id": 13,
      "start": 14765.0,
      "end": 14767.0,
      "formatted_start": "04:06:05.000",
      "formatted_end": "04:06:07.000",
      "text": "چه این هم حاد شده"
    },
    {
      "id": 14,
      "start": 14767.0,
      "end": 14773.0,
      "formatted_start": "04:06:07.000",
      "formatted_end": "04:06:13.000",
      "text": "چون ببین اگر پیشنونده بوده، اول مثلا مایات بوده خب، اول جامدات بوده"
    },
    {
      "id": 15,
      "start": 14773.0,
      "end": 14778.0,
      "formatted_start": "04:06:13.000",
      "formatted_end": "04:06:18.000",
      "text": "بعد شده مایات، حالا بیشتر شده خب، حتما باید آنسکوپی بکنم"
    },
    {
      "id": 16,
      "start": 14778.0,
      "end": 14782.0,
      "formatted_start": "04:06:18.000",
      "formatted_end": "04:06:22.000",
      "text": "و اگر اول دارو میدین، بعد به پدر شما برس ناشته بکنن"
    },
    {
      "id": 17,
      "start": 14782.0,
      "end": 14784.0,
      "formatted_start": "04:06:22.000",
      "formatted_end": "04:06:24.000",
      "text": "برس ناشته ببین؟"
    },
    {
      "id": 18,
      "start": 14784.0,
      "end": 14790.0,
      "formatted_start": "04:06:24.000",
      "formatted_end": "04:06:30.000",
      "text": "این داروهای دیالیز و کلسین ها درست نمیخورن ما نیستیم"
    },
    {
      "id": 19,
      "start": 14790.0,
      "end": 14792.0,
      "formatted_start": "04:06:30.000",
      "formatted_end": "04:06:32.000",
      "text": "من این داروهای چون می کنم"
    },
    {
      "id": 20,
      "start": 14792.0,
      "end": 14794.0,
      "formatted_start": "04:06:32.000",
      "formatted_end": "04:06:34.000",
      "text": "باید بهشون بدین اینجا پیرن دیگه"
    },
    {
      "id": 21,
      "start": 14794.0,
      "end": 14796.0,
      "formatted_start": "04:06:34.000",
      "formatted_end": "04:06:36.000",
      "text": "چی بگم؟"
    },
    {
      "id": 22,
      "start": 14796.0,
      "end": 14800.0,
      "formatted_start": "04:06:36.000",
      "formatted_end": "04:06:40.000",
      "text": "الان صلا من اینجا میگه همش اینجا گیر گرم نیم گرام"
    },
    {
      "id": 23,
      "start": 14800.0,
      "end": 14802.0,
      "formatted_start": "04:06:40.000",
      "formatted_end": "04:06:42.000",
      "text": "یه بار فرادی برام با خلق داره"
    },
    {
      "id": 24,
      "start": 14802.0,
      "end": 14804.0,
      "formatted_start": "04:06:42.000",
      "formatted_end": "04:06:44.000",
      "text": "این چون دود مصرف می کنن"
    },
    {
      "id": 25,
      "start": 14804.0,
      "end": 14806.0,
      "formatted_start": "04:06:44.000",
      "formatted_end": "04:06:46.000",
      "text": "میخور"
    },
    {
      "id": 26,
      "start": 14806.0,
      "end": 14808.0,
      "formatted_start": "04:06:46.000",
      "formatted_end": "04:06:48.000",
      "text": "یعنی از دود خلق می کنیم"
    },
    {
      "id": 27,
      "start": 14808.0,
      "end": 14812.0,
      "formatted_start": "04:06:48.000",
      "formatted_end": "04:06:52.000",
      "text": "اینجا همش بنده خودم دیگه چی نمیتونم بخورم"
    },
    {
      "id": 28,
      "start": 14812.0,
      "end": 14814.0,
      "formatted_start": "04:06:52.000",
      "formatted_end": "04:06:54.000",
      "text": "باید بخورم"
    },
    {
      "id": 29,
      "start": 14814.0,
      "end": 14816.0,
      "formatted_start": "04:06:54.000",
      "formatted_end": "04:06:56.000",
      "text": "آه؟ باید بگذاریم"
    },
    {
      "id": 30,
      "start": 14816.0,
      "end": 14818.0,
      "formatted_start": "04:06:56.000",
      "formatted_end": "04:06:58.000",
      "text": "آه؟ باید بگذاریم"
    },
    {
      "id": 31,
      "start": 14818.0,
      "end": 14820.0,
      "formatted_start": "04:06:58.000",
      "formatted_end": "04:07:00.000",
      "text": "یک ترخه باید بگذاریم"
    },
    {
      "id": 32,
      "start": 14820.0,
      "end": 14822.0,
      "formatted_start": "04:07:00.000",
      "formatted_end": "04:07:02.000",
      "text": "یک ترخه باید بگذاریم"
    },
    {
      "id": 33,
      "start": 14822.0,
      "end": 14824.0,
      "formatted_start": "04:07:02.000",
      "formatted_end": "04:07:04.000",
      "text": "یک ترخه باید بگذاریم"
    },
    {
      "id": 34,
      "start": 14824.0,
      "end": 14826.0,
      "formatted_start": "04:07:04.000",
      "formatted_end": "04:07:06.000",
      "text": "یک ترخه باید بگذاریم"
    },
    {
      "id": 35,
      "start": 14826.0,
      "end": 14828.0,
      "formatted_start": "04:07:06.000",
      "formatted_end": "04:07:08.000",
      "text": "یک ترخه باید بگذاریم"
    },
    {
      "id": 36,
      "start": 14828.0,
      "end": 14830.0,
      "formatted_start": "04:07:08.000",
      "formatted_end": "04:07:10.000",
      "text": "یک ترخه باید بگذاریم"
    },
    {
      "id": 37,
      "start": 14830.0,
      "end": 14832.0,
      "formatted_start": "04:07:10.000",
      "formatted_end": "04:07:12.000",
      "text": "یک ترخه باید بگذاریم"
    },
    {
      "id": 38,
      "start": 14832.0,
      "end": 14834.0,
      "formatted_start": "04:07:12.000",
      "formatted_end": "04:07:14.000",
      "text": "یک ترخه باید بگذاریم"
    },
    {
      "id": 39,
      "start": 14834.0,
      "end": 14836.0,
      "formatted_start": "04:07:14.000",
      "formatted_end": "04:07:16.000",
      "text": "یک ترخه باید بگذاریم"
    },
    {
      "id": 40,
      "start": 14836.0,
      "end": 14838.0,
      "formatted_start": "04:07:16.000",
      "formatted_end": "04:07:18.000",
      "text": "یک ترخه باید بگذاریم"
    },
    {
      "id": 41,
      "start": 14838.0,
      "end": 14840.0,
      "formatted_start": "04:07:18.000",
      "formatted_end": "04:07:20.000",
      "text": "این میگه توی گلون گیر میکنه"
    },
    {
      "id": 42,
      "start": 14840.0,
      "end": 14841.0,
      "formatted_start": "04:07:20.000",
      "formatted_end": "04:07:21.000",
      "text": "اون توی مریده"
    },
    {
      "id": 43,
      "start": 14841.0,
      "end": 14842.0,
      "formatted_start": "04:07:21.000",
      "formatted_end": "04:07:22.000",
      "text": "آه"
    },
    {
      "id": 44,
      "start": 14842.0,
      "end": 14844.0,
      "formatted_start": "04:07:22.000",
      "formatted_end": "04:07:24.000",
      "text": "این ما جدی نگیرسیم"
    },
    {
      "id": 45,
      "start": 14844.0,
      "end": 14846.0,
      "formatted_start": "04:07:24.000",
      "formatted_end": "04:07:26.000",
      "text": "من یک گفتم لابود افونت داره"
    },
    {
      "id": 46,
      "start": 14846.0,
      "end": 14848.0,
      "formatted_start": "04:07:26.000",
      "formatted_end": "04:07:28.000",
      "text": "لابود خرد داره"
    },
    {
      "id": 47,
      "start": 14848.0,
      "end": 14850.0,
      "formatted_start": "04:07:28.000",
      "formatted_end": "04:07:30.000",
      "text": "یک شربت خوشکن نوشتادیم"
    },
    {
      "id": 48,
      "start": 14850.0,
      "end": 14852.0,
      "formatted_start": "04:07:30.000",
      "formatted_end": "04:07:32.000",
      "text": "یک گفتم بسه بیارم ببینم"
    },
    {
      "id": 49,
      "start": 14852.0,
      "end": 14854.0,
      "formatted_start": "04:07:32.000",
      "formatted_end": "04:07:34.000",
      "text": "نباشه یکی مانمی باشه"
    },
    {
      "id": 50,
      "start": 14854.0,
      "end": 14856.0,
      "formatted_start": "04:07:34.000",
      "formatted_end": "04:07:36.000",
      "text": "چون ویلچری هم"
    },
    {
      "id": 51,
      "start": 14856.0,
      "end": 14858.0,
      "formatted_start": "04:07:36.000",
      "formatted_end": "04:07:38.000",
      "text": "از سخت ها بودن بادنش"
    },
    {
      "id": 52,
      "start": 14860.0,
      "end": 14862.0,
      "formatted_start": "04:07:40.000",
      "formatted_end": "04:07:42.000",
      "text": "آقا ازا آمده بابا آمده"
    },
    {
      "id": 53,
      "start": 14862.0,
      "end": 14864.0,
      "formatted_start": "04:07:42.000",
      "formatted_end": "04:07:44.000",
      "text": "بابا که روز روز روز"
    },
    {
      "id": 54,
      "start": 14864.0,
      "end": 14866.0,
      "formatted_start": "04:07:44.000",
      "formatted_end": "04:07:46.000",
      "text": "زنگ دارم"
    },
    {
      "id": 55,
      "start": 14866.0,
      "end": 14871.0,
      "formatted_start": "04:07:46.000",
      "formatted_end": "04:07:51.000",
      "text": "اون روز موباک گرفته بودم و یه سر هوا خیلی گرم بود و این روز همگاری کردم"
    },
    {
      "id": 56,
      "start": 14871.0,
      "end": 14874.0,
      "formatted_start": "04:07:51.000",
      "formatted_end": "04:07:54.000",
      "text": "به خدا دیگه هی میبینم ازیاد داری میشه"
    },
    {
      "id": 57,
      "start": 14874.0,
      "end": 14879.0,
      "formatted_start": "04:07:54.000",
      "formatted_end": "04:07:59.000",
      "text": "منم نیارم کسی دیگر هم نیمیاره آخه فقط داداشم دیالیز میبنن میارنش"
    },
    {
      "id": 58,
      "start": 14879.0,
      "end": 14882.0,
      "formatted_start": "04:07:59.000",
      "formatted_end": "04:08:02.000",
      "text": "اونو میبنن میزنن و از میرن دنبالش میارن من به خدا"
    },
    {
      "id": 59,
      "start": 14882.0,
      "end": 14884.0,
      "formatted_start": "04:08:02.000",
      "formatted_end": "04:08:04.000",
      "text": "هفت هشتایی"
    },
    {
      "id": 60,
      "start": 14885.0,
      "end": 14890.0,
      "formatted_start": "04:08:05.000",
      "formatted_end": "04:08:10.000",
      "text": "بشکی نمیرسه فقط من خونم نزدیکه مجبورم من میبینم بگردم"
    },
    {
      "id": 61,
      "start": 14890.0,
      "end": 14895.0,
      "formatted_start": "04:08:10.000",
      "formatted_end": "04:08:15.000",
      "text": "برس ناشدار صبح و شبتشون بدید قبل صبحان و بشام"
    },
    {
      "id": 62,
      "start": 14895.0,
      "end": 14897.0,
      "formatted_start": "04:08:15.000",
      "formatted_end": "04:08:17.000",
      "text": "قبل صبحان و بشام"
    },
    {
      "id": 63,
      "start": 14897.0,
      "end": 14899.0,
      "formatted_start": "04:08:17.000",
      "formatted_end": "04:08:19.000",
      "text": "مردمه"
    },
    {
      "id": 64,
      "start": 14899.0,
      "end": 14900.0,
      "formatted_start": "04:08:19.000",
      "formatted_end": "04:08:20.000",
      "text": "جام"
    },
    {
      "id": 65,
      "start": 14900.0,
      "end": 14902.0,
      "formatted_start": "04:08:20.000",
      "formatted_end": "04:08:22.000",
      "text": "این مرگوله هم نمیشه بوده"
    },
    {
      "id": 66,
      "start": 14902.0,
      "end": 14904.0,
      "formatted_start": "04:08:22.000",
      "formatted_end": "04:08:24.000",
      "text": "چشاش هم نمیشنرده"
    },
    {
      "id": 67,
      "start": 14904.0,
      "end": 14909.0,
      "formatted_start": "04:08:24.000",
      "formatted_end": "04:08:29.000",
      "text": "این چشاش هم خاند دوز من متخصص هم بردم گم بر چشاش"
    },
    {
      "id": 68,
      "start": 14909.0,
      "end": 14912.0,
      "formatted_start": "04:08:29.000",
      "formatted_end": "04:08:32.000",
      "text": "اصلا خوش نمیشه"
    },
    {
      "id": 69,
      "start": 14912.0,
      "end": 14918.0,
      "formatted_start": "04:08:32.000",
      "formatted_end": "04:08:38.000",
      "text": "قطر داد فقط نمیدونم بجای عشقش اتماهان کامل باز نیست"
    },
    {
      "id": 70,
      "start": 14918.0,
      "end": 14920.0,
      "formatted_start": "04:08:38.000",
      "formatted_end": "04:08:40.000",
      "text": "از اینجا باید بردارید"
    },
    {
      "id": 71,
      "start": 14920.0,
      "end": 14922.0,
      "formatted_start": "04:08:40.000",
      "formatted_end": "04:08:42.000",
      "text": "شششو میدید"
    },
    {
      "id": 72,
      "start": 14922.0,
      "end": 14924.0,
      "formatted_start": "04:08:42.000",
      "formatted_end": "04:08:44.000",
      "text": "من شششو میدم"
    },
    {
      "id": 73,
      "start": 14924.0,
      "end": 14926.0,
      "formatted_start": "04:08:44.000",
      "formatted_end": "04:08:46.000",
      "text": "سه روز پشتر نمیدونم که میرم"
    },
    {
      "id": 74,
      "start": 14926.0,
      "end": 14928.0,
      "formatted_start": "04:08:46.000",
      "formatted_end": "04:08:48.000",
      "text": "خوبه دو روز نمیتونم برم"
    },
    {
      "id": 75,
      "start": 14928.0,
      "end": 14930.0,
      "formatted_start": "04:08:48.000",
      "formatted_end": "04:08:50.000",
      "text": "پس این همون برم"
    },
    {
      "id": 76,
      "start": 14930.0,
      "end": 14932.0,
      "formatted_start": "04:08:50.000",
      "formatted_end": "04:08:52.000",
      "text": "شش شبا بزن"
    },
    {
      "id": 77,
      "start": 14932.0,
      "end": 14934.0,
      "formatted_start": "04:08:52.000",
      "formatted_end": "04:08:54.000",
      "text": "هر شب رو روکت کشون بزن"
    },
    {
      "id": 78,
      "start": 14940.0,
      "end": 14942.0,
      "formatted_start": "04:09:00.000",
      "formatted_end": "04:09:02.000",
      "text": "این ها یکیون میخواند ترسو شستت"
    },
    {
      "id": 79,
      "start": 14942.0,
      "end": 14944.0,
      "formatted_start": "04:09:02.000",
      "formatted_end": "04:09:04.000",
      "text": "میدونی پدر مادر دید"
    },
    {
      "id": 80,
      "start": 14944.0,
      "end": 14946.0,
      "formatted_start": "04:09:04.000",
      "formatted_end": "04:09:06.000",
      "text": "پیدا نمیشن پدر مادر دید"
    },
    {
      "id": 81,
      "start": 14946.0,
      "end": 14952.0,
      "formatted_start": "04:09:06.000",
      "formatted_end": "04:09:12.000",
      "text": "نمیشه کاش نوبت میزهش در سطح خوهر میگن باباشه ما مفتی یه روزی هستیم"
    },
    {
      "id": 82,
      "start": 14956.0,
      "end": 14958.0,
      "formatted_start": "04:09:16.000",
      "formatted_end": "04:09:18.000",
      "text": "انشابه بابا بهتر شد"
    },
    {
      "id": 83,
      "start": 14958.0,
      "end": 14960.0,
      "formatted_start": "04:09:18.000",
      "formatted_end": "04:09:20.000",
      "text": "بعد دیگه باید تصمیم گیر"
    },
    {
      "id": 84,
      "start": 14960.0,
      "end": 14966.0,
      "formatted_start": "04:09:20.000",
      "formatted_end": "04:09:26.000",
      "text": "اگه شرایط مثلا سرخای مالی رو داشتید که میروید سرتا به دکتر سرخای آلیس بگیرید"
    },
    {
      "id": 85,
      "start": 14966.0,
      "end": 14970.0,
      "formatted_start": "04:09:26.000",
      "formatted_end": "04:09:30.000",
      "text": "اگه تیده در نظرم آلیس چون معمولا حسنه به 6 تا 10 میلیون آلیس بود"
    },
    {
      "id": 86,
      "start": 14970.0,
      "end": 14974.54,
