  "stt_segments": [
    {
      "id": 0,
      "start": 11100.0,
      "end": 11112.0,
      "formatted_start": "03:05:00.000",
      "formatted_end": "03:05:12.000",
      "text": "اینجا که نمیزن، نارنجی، بیز هر ورده، ترجه و سبز میگی، سی واهد، شفت میزنی دیگه دوستان."
    },
    {
      "id": 1,
      "start": 11112.0,
      "end": 11115.0,
      "formatted_start": "03:05:12.000",
      "formatted_end": "03:05:15.000",
      "text": "میتونی که این رفته به غذا نداره، خب؟"
    },
    {
      "id": 2,
      "start": 11115.0,
      "end": 11118.0,
      "formatted_start": "03:05:15.000",
      "formatted_end": "03:05:18.000",
      "text": "ولی این به غذا لفت داره، اگه اموز نخوردی نمیزنی."
    },
    {
      "id": 3,
      "start": 11118.0,
      "end": 11119.0,
      "formatted_start": "03:05:18.000",
      "formatted_end": "03:05:19.000",
      "text": "آهان."
    },
    {
      "id": 4,
      "start": 11119.0,
      "end": 11124.0,
      "formatted_start": "03:05:19.000",
      "formatted_end": "03:05:24.000",
      "text": "اگه اموز استفاده استفلاحی نمیزنی، اگه میدونی میخوایی بری غذا هم برخوری که فقط دوسته هاشو برخوری، نیلت نیزنی."
    },
    {
      "id": 5,
      "start": 11124.0,
      "end": 11125.0,
      "formatted_start": "03:05:24.000",
      "formatted_end": "03:05:25.000",
      "text": "نه زنی."
    },
    {
      "id": 6,
      "start": 11125.0,
      "end": 11135.0,
      "formatted_start": "03:05:25.000",
      "formatted_end": "03:05:35.000",
      "text": "این موضوع مهمه. این به خضای شرطی نداره. خضا خوردی نخوردی باید شرطی شده."
    },
    {
      "id": 7,
      "start": 11135.0,
      "end": 11144.0,
      "formatted_start": "03:05:35.000",
      "formatted_end": "03:05:44.000",
      "text": "این برس هم که نوشتم بعد شام. برس جدیدی که میدیسم. برس قبلی میم که صبح و صبح."
    },
    {
      "id": 8,
      "start": 11144.0,
      "end": 11149.0,
      "formatted_start": "03:05:44.000",
      "formatted_end": "03:05:49.000",
      "text": "خب من واقعا یک چند لحظه سپنده برد میدم. تو لحظه سپنده برد."
    },
    {
      "id": 9,
      "start": 11149.0,
      "end": 11151.0,
      "formatted_start": "03:05:49.000",
      "formatted_end": "03:05:51.000",
      "text": "از این هایی که دارید دارواتون هایی"
    },
    {
      "id": 10,
      "start": 11151.0,
      "end": 11153.0,
      "formatted_start": "03:05:51.000",
      "formatted_end": "03:05:53.000",
      "text": "نه از سلیم ندارم"
    },
    {
      "id": 11,
      "start": 11153.0,
      "end": 11155.0,
      "formatted_start": "03:05:53.000",
      "formatted_end": "03:05:55.000",
      "text": "از سلیم هاتم"
    },
    {
      "id": 12,
      "start": 11155.0,
      "end": 11161.0,
      "formatted_start": "03:05:55.000",
      "formatted_end": "03:06:01.000",
      "text": "در مانگاه داروخانه دکتر اکبرپور"
    },
    {
      "id": 13,
      "start": 11161.0,
      "end": 11163.0,
      "formatted_start": "03:06:01.000",
      "formatted_end": "03:06:03.000",
      "text": "اکبرپور کنم یه؟"
    },
    {
      "id": 14,
      "start": 11163.0,
      "end": 11165.0,
      "formatted_start": "03:06:03.000",
      "formatted_end": "03:06:05.000",
      "text": "همه شعبونه میزن این سند"
    },
    {
      "id": 15,
      "start": 11165.0,
      "end": 11168.0,
      "formatted_start": "03:06:05.000",
      "formatted_end": "03:06:08.000",
      "text": "اگر گفت نرداری بگیر که خانون از خرزاده گفته بیان میشه"
    },
    {
      "id": 16,
      "start": 11168.0,
      "end": 11169.0,
      "formatted_start": "03:06:08.000",
      "formatted_end": "03:06:09.000",
      "text": "خانون از خرزاده؟"
    },
    {
      "id": 17,
      "start": 11169.0,
      "end": 11171.0,
      "formatted_start": "03:06:09.000",
      "formatted_end": "03:06:11.000",
      "text": "نماینده فخ شده جواه"
    },
    {
      "id": 18,
      "start": 11171.0,
      "end": 11174.0,
      "formatted_start": "03:06:11.000",
      "formatted_end": "03:06:14.000",
      "text": "به اون داروخانه به تعداد زیاد میدن"
    },
    {
      "id": 19,
      "start": 11174.0,
      "end": 11177.0,
      "formatted_start": "03:06:14.000",
      "formatted_end": "03:06:17.000",
      "text": "خانون میشه یه منیسی؟ من چون پراموش میکنم"
    },
    {
      "id": 20,
      "start": 11177.0,
      "end": 11179.0,
      "formatted_start": "03:06:17.000",
      "formatted_end": "03:06:19.000",
      "text": "از اینجا باید بگیم به درداری شده"
    },
    {
      "id": 21,
      "start": 11179.0,
      "end": 11181.0,
      "formatted_start": "03:06:19.000",
      "formatted_end": "03:06:21.000",
      "text": "من خودم"
    },
    {
      "id": 22,
      "start": 11181.0,
      "end": 11183.0,
      "formatted_start": "03:06:21.000",
      "formatted_end": "03:06:23.000",
      "text": "من پره میشم"
    },
    {
      "id": 23,
      "start": 11183.0,
      "end": 11185.0,
      "formatted_start": "03:06:23.000",
      "formatted_end": "03:06:25.000",
      "text": "الانی نمیشه بگیری"
    },
    {
      "id": 24,
      "start": 11185.0,
      "end": 11187.0,
      "formatted_start": "03:06:25.000",
      "formatted_end": "03:06:27.000",
      "text": "الانی هم چرا؟"
    },
    {
      "id": 25,
      "start": 11187.0,
      "end": 11189.0,
      "formatted_start": "03:06:27.000",
      "formatted_end": "03:06:29.000",
      "text": "اگه اونجا میرم"
    },
    {
      "id": 26,
      "start": 11189.0,
      "end": 11191.0,
      "formatted_start": "03:06:29.000",
      "formatted_end": "03:06:31.000",
      "text": "چون میدونم توجه رو به تعداد"
    },
    {
      "id": 27,
      "start": 11191.0,
      "end": 11193.0,
      "formatted_start": "03:06:31.000",
      "formatted_end": "03:06:33.000",
      "text": "زیاد به این میدن"
    },
    {
      "id": 28,
      "start": 11193.0,
      "end": 11195.0,
      "formatted_start": "03:06:33.000",
      "formatted_end": "03:06:35.000",
      "text": "اگه ندادن یه خودتن آزاد بیا ازش بگیر"
    },
    {
      "id": 29,
      "start": 11195.0,
      "end": 11197.0,
      "formatted_start": "03:06:35.000",
      "formatted_end": "03:06:37.000",
      "text": "پس من اگه موقع بستری بخوان کنیم"
    },
    {
      "id": 30,
      "start": 11197.0,
      "end": 11199.0,
      "formatted_start": "03:06:37.000",
      "formatted_end": "03:06:39.000",
      "text": "همون هفته دیگه دوشنبه بیا"
    },
    {
      "id": 31,
      "start": 11199.0,
      "end": 11201.0,
      "formatted_start": "03:06:39.000",
      "formatted_end": "03:06:41.000",
      "text": "بیاین اینجا"
    },
    {
      "id": 32,
      "start": 11201.0,
      "end": 11203.0,
      "formatted_start": "03:06:41.000",
      "formatted_end": "03:06:43.000",
      "text": "بعد یه چند لحظه"
    },
    {
      "id": 33,
      "start": 11203.0,
      "end": 11205.0,
      "formatted_start": "03:06:43.000",
      "formatted_end": "03:06:45.000",
      "text": "شب باید مردی ادانا میبینم"
    },
    {
      "id": 34,
      "start": 11205.0,
      "end": 11207.0,
      "formatted_start": "03:06:45.000",
      "formatted_end": "03:06:47.000",
      "text": "بیرون باید شب؟"
    },
    {
      "id": 35,
      "start": 11207.0,
      "end": 11237.0,
      "formatted_start": "03:06:47.000",
      "formatted_end": "03:07:17.000",
      "text": "برای اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه اینکه"
    },
    {
      "id": 36,
      "start": 11237.0,
      "end": 11265.0,
      "formatted_start": "03:07:17.000",
      "formatted_end": "03:07:45.000",
      "text": "موسیقی"
    },
    {
      "id": 37,
      "start": 11265.0,
      "end": 11267.52,
      "formatted_start": "03:07:45.000",
      "formatted_end": "03:07:47.520",
      "text": "برگواری که در اینجا میریم همبورت"
    },
    {
      "id": 38,
      "start": 11267.52,
      "end": 11268.84,
      "formatted_start": "03:07:47.520",
      "formatted_end": "03:07:48.840",
      "text": "همبورت چی اینجا؟"
    },
    {
      "id": 39,
      "start": 11268.84,
      "end": 11270.44,
      "formatted_start": "03:07:48.840",
      "formatted_end": "03:07:50.440",
      "text": "یا..."
    },
    {
      "id": 40,
      "start": 11270.44,
      "end": 11271.76,
      "formatted_start": "03:07:50.440",
      "formatted_end": "03:07:51.760",
      "text": "اینجا برگوار مده"
    },
    {
      "id": 41,
      "start": 11271.76,
      "end": 11273.64,
      "formatted_start": "03:07:51.760",
      "formatted_end": "03:07:53.640",
      "text": "ساختمون بلند نیمده"
    },
    {
      "id": 42,
      "start": 11273.64,
      "end": 11275.16,
      "formatted_start": "03:07:53.640",
      "formatted_end": "03:07:55.160",
      "text": "یا... نیمده"
    },
    {
      "id": 43,
      "start": 11275.16,
      "end": 11275.96,
      "formatted_start": "03:07:55.160",
      "formatted_end": "03:07:55.960",
      "text": "نه"
    },
    {
      "id": 44,
      "start": 11275.96,
      "end": 11277.04,
      "formatted_start": "03:07:55.960",
      "formatted_end": "03:07:57.040",
      "text": "اما چون میریم از برگواری"
    },
    {
      "id": 45,
      "start": 11277.04,
      "end": 11278.16,
      "formatted_start": "03:07:57.040",
      "formatted_end": "03:07:58.160",
      "text": "برگوار مده"
    },
    {
      "id": 46,
      "start": 11278.16,
      "end": 11280.16,
      "formatted_start": "03:07:58.160",
      "formatted_end": "03:08:00.160",
      "text": "ولی تو ساختمون بلند نیمده"
    },
    {
      "id": 47,
      "start": 11281.56,
      "end": 11283.0,
      "formatted_start": "03:08:01.560",
      "formatted_end": "03:08:03.000",
      "text": "تو دختری صدا داره"
    },
    {
      "id": 48,
      "start": 11289.16,
      "end": 11291.68,
      "formatted_start": "03:08:09.160",
      "formatted_end": "03:08:11.680",
      "text": "تو ساختمون اونها که یادا ترخیب داره ولی..."
    },
    {
      "id": 49,
      "start": 11321.68,
      "end": 11325.68,
      "formatted_start": "03:08:41.680",
      "formatted_end": "03:08:45.680",
      "text": "تراماسون"
    },
    {
      "id": 50,
      "start": 11325.68,
      "end": 11329.68,
      "formatted_start": "03:08:45.680",
      "formatted_end": "03:08:49.680",
      "text": "تراماسون"
    },
    {
      "id": 51,
      "start": 11329.68,
      "end": 11333.68,
      "formatted_start": "03:08:49.680",
      "formatted_end": "03:08:53.680",
      "text": "تراماسون"
    },
    {
      "id": 52,
      "start": 11333.68,
      "end": 11337.68,
      "formatted_start": "03:08:53.680",
      "formatted_end": "03:08:57.680",
      "text": "تراماسون"
    },
    {
      "id": 53,
      "start": 11337.68,
      "end": 11341.68,
      "formatted_start": "03:08:57.680",
      "formatted_end": "03:09:01.680",
      "text": "تراماسون"
    },
    {
      "id": 54,
      "start": 11341.68,
      "end": 11345.68,
      "formatted_start": "03:09:01.680",
      "formatted_end": "03:09:05.680",
      "text": "تراماسون"
    },
    {
      "id": 55,
      "start": 11345.68,
      "end": 11349.68,
      "formatted_start": "03:09:05.680",
      "formatted_end": "03:09:09.680",
      "text": "تراماسون"
    },
    {
      "id": 56,
      "start": 11349.68,
      "end": 11352.68,
      "formatted_start": "03:09:09.680",
      "formatted_end": "03:09:12.680",
      "text": "و مشکل مایتر به دکتر چیزم داریم مثلا"
    },
    {
      "id": 57,
      "start": 11352.68,
      "end": 11353.68,
      "formatted_start": "03:09:12.680",
      "formatted_end": "03:09:13.680",
      "text": "مردم؟"
    },
    {
      "id": 58,
      "start": 11353.68,
      "end": 11354.68,
      "formatted_start": "03:09:13.680",
      "formatted_end": "03:09:14.680",
      "text": "آره"
    },
    {
      "id": 59,
      "start": 11354.68,
      "end": 11357.68,
      "formatted_start": "03:09:14.680",
      "formatted_end": "03:09:17.680",
      "text": "شاید کی بودیم شاید شفیپور یکی میگی؟"
    },
    {
      "id": 60,
      "start": 11357.68,
      "end": 11360.68,
      "formatted_start": "03:09:17.680",
      "formatted_end": "03:09:20.680",
      "text": "شفیپور دو تا جوان مردم هم خوبن هر گودن برد خوبن"
    },
    {
      "id": 61,
      "start": 11360.68,
      "end": 11362.68,
      "formatted_start": "03:09:20.680",
      "formatted_end": "03:09:22.680",
      "text": "خوب چی شده؟"
    },
    {
      "id": 62,
      "start": 11362.68,
      "end": 11367.68,
      "formatted_start": "03:09:22.680",
      "formatted_end": "03:09:27.680",
      "text": "با سه فشار میخوری؟"
    },
    {
      "id": 63,
      "start": 11367.68,
      "end": 11368.68,
      "formatted_start": "03:09:27.680",
      "formatted_end": "03:09:28.680",
      "text": "با سه فشار"
    },
    {
      "id": 64,
      "start": 11368.68,
      "end": 11370.68,
      "formatted_start": "03:09:28.680",
      "formatted_end": "03:09:30.680",
      "text": "هم بشیم بخورم"
    },
    {
      "id": 65,
      "start": 11370.68,
      "end": 11373.68,
      "formatted_start": "03:09:30.680",
      "formatted_end": "03:09:33.680",
      "text": "با سه فشار میشیم"
    },
    {
      "id": 66,
      "start": 11373.68,
      "end": 11374.68,
      "formatted_start": "03:09:33.680",
      "formatted_end": "03:09:34.680",
      "text": "نزارتان؟"
    },
    {
      "id": 67,
      "start": 11374.68,
      "end": 11375.68,
      "formatted_start": "03:09:34.680",
      "formatted_end": "03:09:35.680",
      "text": "نزارتان"
    },
    {
      "id": 68,
      "start": 11375.68,
      "end": 11376.68,
      "formatted_start": "03:09:35.680",
      "formatted_end": "03:09:36.680",
      "text": "نزارتان خوب"
    },
    {
      "id": 69,
      "start": 11376.68,
      "end": 11378.68,
      "formatted_start": "03:09:36.680",
      "formatted_end": "03:09:38.680",
      "text": "خورتر بی خوری خورتر داری؟"
    },
    {
      "id": 70,
      "start": 11378.68,
      "end": 11390.68,
      "formatted_start": "03:09:38.680",
      "formatted_end": "03:09:50.680",
      "text": "باید دورتا وزمو کردیم"
    },
    {
      "id": 71,
      "start": 11390.68,
      "end": 11398.68,
      "formatted_start": "03:09:50.680",
      "formatted_end": "03:09:58.680",
      "text": "باید بشه با 16 درم و گرمون سخت بشه"
    },
    {
      "id": 72,
      "start": 11398.68,
      "end": 11400.68,
      "formatted_start": "03:09:58.680",
      "formatted_end": "03:10:00.680",
      "text": "چند صده تونه؟"
    }
  ],
  "status": "completed"
}