      "formatted_start": "06:41:49.000",
      "formatted_end": "06:41:51.000",
      "text": "از اونه باید برده سالی انجام بده"
    },
    {
      "id": 55,
      "start": 24111.0,
      "end": 24113.0,
      "formatted_start": "06:41:51.000",
      "formatted_end": "06:41:53.000",
      "text": "این کتاب باید سالی برده"
    },
    {
      "id": 56,
      "start": 24116.0,
      "end": 24117.0,
      "formatted_start": "06:41:56.000",
      "formatted_end": "06:41:57.000",
      "text": "کجا؟"
    },
    {
      "id": 57,
      "start": 24117.0,
      "end": 24119.0,
      "formatted_start": "06:41:57.000",
      "formatted_end": "06:41:59.000",
      "text": "بوبت؟"
    },
    {
      "id": 58,
      "start": 24119.0,
      "end": 24121.0,
      "formatted_start": "06:41:59.000",
      "formatted_end": "06:42:01.000",
      "text": "گرگان؟"
    },
    {
      "id": 59,
      "start": 24121.0,
      "end": 24123.0,
      "formatted_start": "06:42:01.000",
      "formatted_end": "06:42:03.000",
      "text": "شفای گرگان"
    },
    {
      "id": 60,
      "start": 24123.0,
      "end": 24125.0,
      "formatted_start": "06:42:03.000",
      "formatted_end": "06:42:05.000",
      "text": "اون ست آنجوی عروف قلبو داره"
    },
    {
      "id": 61,
      "start": 24125.0,
      "end": 24127.0,
      "formatted_start": "06:42:05.000",
      "formatted_end": "06:42:07.000",
      "text": "ست آنجوی عروف ریاست"
    },
    {
      "id": 62,
      "start": 24127.0,
      "end": 24129.0,
      "formatted_start": "06:42:07.000",
      "formatted_end": "06:42:09.000",
      "text": "این فرق برده"
    },
    {
      "id": 63,
      "start": 24129.0,
      "end": 24131.0,
      "formatted_start": "06:42:09.000",
      "formatted_end": "06:42:11.000",
      "text": "اگه مک اینکه بهش گفتن انجام میدن"
    },
    {
      "id": 64,
      "start": 24139.0,
      "end": 24144.22,
      "formatted_start": "06:42:19.000",
      "formatted_end": "06:42:24.220",
      "text": "سلام خوبی؟ ببین سی تی آن جوی ریه رو رفتی شفا 250 میدیم"
    },
    {
      "id": 65,
      "start": 24144.22,
      "end": 24145.52,
      "formatted_start": "06:42:24.220",
      "formatted_end": "06:42:25.520",
      "text": "زن زنی که که کنه جا"
    },
    {
      "id": 66,
      "start": 24145.52,
      "end": 24147.5,
      "formatted_start": "06:42:25.520",
      "formatted_end": "06:42:27.500",
      "text": "گفتی سی تی آن جوی ریه"
    },
    {
      "id": 67,
      "start": 24147.5,
      "end": 24150.42,
      "formatted_start": "06:42:27.500",
      "formatted_end": "06:42:30.420",
      "text": "سی تی آن جوی قلب داره شفا"
    },
    {
      "id": 68,
      "start": 24150.42,
      "end": 24152.38,
      "formatted_start": "06:42:30.420",
      "formatted_end": "06:42:32.380",
      "text": "اصلا دولستان سی تی آن جوی نداره"
    },
    {
      "id": 69,
      "start": 24152.38,
      "end": 24153.52,
      "formatted_start": "06:42:32.380",
      "formatted_end": "06:42:33.520",
      "text": "بیمارسان قلب داره"
    },
    {
      "id": 70,
      "start": 24153.52,
      "end": 24155.82,
      "formatted_start": "06:42:33.520",
      "formatted_end": "06:42:35.820",
      "text": "شفا بیمارسان قلب داره"
    },
    {
      "id": 71,
      "start": 24155.82,
      "end": 24157.76,
      "formatted_start": "06:42:35.820",
      "formatted_end": "06:42:37.760",
      "text": "بگو من سی تی آن جوی ریه دارم"
    },
    {
      "id": 72,
      "start": 24157.76,
      "end": 24159.18,
      "formatted_start": "06:42:37.760",
      "formatted_end": "06:42:39.180",
      "text": "ریه نداریم"
    },
    {
      "id": 73,
      "start": 24159.18,
      "end": 24160.7,
      "formatted_start": "06:42:39.180",
      "formatted_end": "06:42:40.700",
      "text": "نه"
    },
    {
      "id": 74,
      "start": 24160.7,
      "end": 24162.32,
      "formatted_start": "06:42:40.700",
      "formatted_end": "06:42:42.320",
      "text": "فقط ساری داره"
    },
    {
      "id": 75,
      "start": 24162.32,
      "end": 24164.82,
      "formatted_start": "06:42:42.320",
      "formatted_end": "06:42:44.820",
      "text": "سی تی آن جوی"
    },
    {
      "id": 76,
      "start": 24164.82,
      "end": 24167.4,
      "formatted_start": "06:42:44.820",
      "formatted_end": "06:42:47.400",
      "text": "من یکی بیمارسان دولتی خود خامدکتر"
    },
    {
      "id": 77,
      "start": 24167.4,
      "end": 24170.2,
      "formatted_start": "06:42:47.400",
      "formatted_end": "06:42:50.200",
      "text": "سعیات بستقید میگرد اونجا انجام بدم"
    },
    {
      "id": 78,
      "start": 24170.2,
      "end": 24171.36,
      "formatted_start": "06:42:50.200",
      "formatted_end": "06:42:51.360",
      "text": "حالا"
    },
    {
      "id": 79,
      "start": 24171.36,
      "end": 24173.82,
      "formatted_start": "06:42:51.360",
      "formatted_end": "06:42:53.820",
      "text": "اون گفت برو که میگه موسیقی خواهد"
    },
    {
      "id": 80,
      "start": 24173.82,
      "end": 24174.66,
      "formatted_start": "06:42:53.820",
      "formatted_end": "06:42:54.660",
      "text": "همون دیگه"
    },
    {
      "id": 81,
      "start": 24174.66,
      "end": 24177.5,
      "formatted_start": "06:42:54.660",
      "formatted_end": "06:42:57.500",
      "text": "خصوصی"
    },
    {
      "id": 82,
      "start": 24177.5,
      "end": 24179.5,
      "formatted_start": "06:42:57.500",
      "formatted_end": "06:42:59.500",
      "text": "اگه میرو اونجا سرپایی انجام میدن"
    },
    {
      "id": 83,
      "start": 24179.5,
      "end": 24181.16,
      "formatted_start": "06:42:59.500",
      "formatted_end": "06:43:01.160",
      "text": "بستقید میکنه"
    },
    {
      "id": 84,
      "start": 24181.16,
      "end": 24183.3,
      "formatted_start": "06:43:01.160",
      "formatted_end": "06:43:03.300",
      "text": "و خودشون نوبایت میگیرند میبرند"
    },
    {
      "id": 85,
      "start": 24183.3,
      "end": 24185.4,
      "formatted_start": "06:43:03.300",
      "formatted_end": "06:43:05.400",
      "text": "اینجاها نداده"
    },
    {
      "id": 86,
      "start": 24185.4,
      "end": 24187.1,
      "formatted_start": "06:43:05.400",
      "formatted_end": "06:43:07.100",
      "text": "خب"
    },
    {
      "id": 87,
      "start": 24187.1,
      "end": 24189.0,
      "formatted_start": "06:43:07.100",
      "formatted_end": "06:43:09.000",
      "text": "من خب میدونم دیگه"
    },
    {
      "id": 88,
      "start": 24189.0,
      "end": 24190.2,
      "formatted_start": "06:43:09.000",
      "formatted_end": "06:43:10.200",
      "text": "موشاولی با کنتست"
    },
    {
      "id": 89,
      "start": 24190.2,
      "end": 24193.5,
      "formatted_start": "06:43:10.200",
      "formatted_end": "06:43:13.500",
      "text": "بعد حالا چیز کن دیگه"
    },
    {
      "id": 90,
      "start": 24193.5,
      "end": 24195.8,
      "formatted_start": "06:43:13.500",
      "formatted_end": "06:43:15.800",
      "text": "من را سبت کردم"
    },
    {
      "id": 91,
      "start": 24195.8,
      "end": 24196.2,
      "formatted_start": "06:43:15.800",
      "formatted_end": "06:43:16.200",
      "text": "چون"
    },
    {
      "id": 92,
      "start": 24196.2,
      "end": 24199.2,
      "formatted_start": "06:43:16.200",
      "formatted_end": "06:43:19.200",
      "text": "من که بیانستان همه چشم کار هم می کنم داستم"
    },
    {
      "id": 93,
      "start": 24199.2,
      "end": 24201.2,
      "formatted_start": "06:43:19.200",
      "formatted_end": "06:43:21.200",
      "text": "حالا تو یه زنگ بزن به شبه ها خب"
    },
    {
      "id": 94,
      "start": 24201.2,
      "end": 24204.2,
      "formatted_start": "06:43:21.200",
      "formatted_end": "06:43:24.200",
      "text": "بگو من CT-NG اروق زیر می خواهم خب"
    },
    {
      "id": 95,
      "start": 24204.2,
      "end": 24206.2,
      "formatted_start": "06:43:24.200",
      "formatted_end": "06:43:26.200",
      "text": "ببینن اونجا می دن یا نه"
    },
    {
      "id": 96,
      "start": 24206.2,
      "end": 24208.2,
      "formatted_start": "06:43:26.200",
      "formatted_end": "06:43:28.200",
      "text": "من فقط مرکز ایزردی هم بباشم"
    },
    {
      "id": 97,
      "start": 24208.2,
      "end": 24210.2,
      "formatted_start": "06:43:28.200",
      "formatted_end": "06:43:30.200",
      "text": "شاید ایزردی ها برده باشم"
    },
    {
      "id": 98,
      "start": 24210.2,
      "end": 24211.2,
      "formatted_start": "06:43:30.200",
      "formatted_end": "06:43:31.200",
      "text": "از ایزردی هم اطلاعاتی"
    },
    {
      "id": 99,
      "start": 24211.2,
      "end": 24212.2,
      "formatted_start": "06:43:31.200",
      "formatted_end": "06:43:32.200",
      "text": "ایزردی هم اطلاعاتی؟"
    },
    {
      "id": 100,
      "start": 24212.2,
      "end": 24213.2,
      "formatted_start": "06:43:32.200",
      "formatted_end": "06:43:33.200",
      "text": "آره"
    },
    {
      "id": 101,
      "start": 24213.2,
      "end": 24216.2,
      "formatted_start": "06:43:33.200",
      "formatted_end": "06:43:36.200",
      "text": "بعد قبل CT-NG ها یه آزمایش بیان کرات هم ازت می خواهم"
    },
    {
      "id": 102,
      "start": 24216.2,
      "end": 24217.2,
      "formatted_start": "06:43:36.200",
      "formatted_end": "06:43:37.200",
      "text": "کرات هم"
    },
    {
      "id": 103,
      "start": 24217.2,
      "end": 24218.2,
      "formatted_start": "06:43:37.200",
      "formatted_end": "06:43:38.200",
      "text": "بعد می دونی که CT-NG آره"
    },
    {
      "id": 104,
      "start": 24218.2,
      "end": 24223.2,
      "formatted_start": "06:43:38.200",
      "formatted_end": "06:43:43.200",
      "text": "چون ماده به تزیغ میکنن بعد ماده ها جا پیروی تزیغ کردن"
    },
    {
      "id": 105,
      "start": 24223.2,
      "end": 24226.2,
      "formatted_start": "06:43:43.200",
      "formatted_end": "06:43:46.200",
      "text": "چون یک روز نباید با اچه تان تماس داشته باشید"
    },
    {
      "id": 106,
      "start": 24226.2,
      "end": 24228.2,
      "formatted_start": "06:43:46.200",
      "formatted_end": "06:43:48.200",
      "text": "ماده رادی اکتیبه"
    },
    {
      "id": 107,
      "start": 24228.2,
      "end": 24231.2,
      "formatted_start": "06:43:48.200",
      "formatted_end": "06:43:51.200",
      "text": "خب اینها نماظه باشه چون سمخ حساسیت داری"
    },
    {
      "id": 108,
      "start": 24231.2,
      "end": 24233.2,
      "formatted_start": "06:43:51.200",
      "formatted_end": "06:43:53.200",
      "text": "یه وقت با ماده رادی اکتیب حساسیت داری"
    },
    {
      "id": 109,
      "start": 24233.2,
      "end": 24236.2,
      "formatted_start": "06:43:53.200",
      "formatted_end": "06:43:56.200",
      "text": "همه اینها را برمیده"
    },
    {
      "id": 110,
      "start": 24236.2,
      "end": 24239.2,
      "formatted_start": "06:43:56.200",
      "formatted_end": "06:43:59.200",
      "text": "رفتی بیرفتی پیش دوست دقیقی"
    },
    {
      "id": 111,
      "start": 24239.2,
      "end": 24242.2,
      "formatted_start": "06:43:59.200",
      "formatted_end": "06:44:02.200",
      "text": "یکی میشه بیرفتی بیرفتی بود اکن نمیشه آسمانش نمیشه"
    },
    {
      "id": 112,
      "start": 24242.2,
      "end": 24244.2,
      "formatted_start": "06:44:02.200",
      "formatted_end": "06:44:04.200",
      "text": "خودم آسمانش آره ده"
    },
    {
      "id": 113,
      "start": 24248.2,
      "end": 24250.2,
      "formatted_start": "06:44:08.200",
      "formatted_end": "06:44:10.200",
      "text": "فیلز آبادی نرده نه؟"
    },
    {
      "id": 114,
      "start": 24250.2,
      "end": 24252.2,
      "formatted_start": "06:44:10.200",
      "formatted_end": "06:44:12.200",
      "text": "داربادو تا کاری نکرد؟"
    },
    {
      "id": 115,
      "start": 24252.2,
      "end": 24254.2,
      "formatted_start": "06:44:12.200",
      "formatted_end": "06:44:14.200",
      "text": "نه"
    },
    {
      "id": 116,
      "start": 24254.2,
      "end": 24256.2,
      "formatted_start": "06:44:14.200",
      "formatted_end": "06:44:16.200",
      "text": "چی مردم دیگه؟"
    },
    {
      "id": 117,
      "start": 24256.2,
      "end": 24258.2,
      "formatted_start": "06:44:16.200",
      "formatted_end": "06:44:18.200",
      "text": "برم بتوزن بری فیلز آبادی خودش کاراتو نکرد"
    },
    {
      "id": 118,
      "start": 24258.2,
      "end": 24260.2,
      "formatted_start": "06:44:18.200",
      "formatted_end": "06:44:20.200",
      "text": "نه برم برم"
    },
    {
      "id": 119,
      "start": 24260.2,
      "end": 24262.2,
      "formatted_start": "06:44:20.200",
      "formatted_end": "06:44:22.200",
      "text": "چی کشی؟"
    },
    {
      "id": 120,
      "start": 24262.2,
      "end": 24264.2,
      "formatted_start": "06:44:22.200",
      "formatted_end": "06:44:24.200",
      "text": "نه"
    },
    {
      "id": 121,
      "start": 24264.2,
      "end": 24266.2,
      "formatted_start": "06:44:24.200",
      "formatted_end": "06:44:26.200",
      "text": "کار کنم"
    },
    {
      "id": 122,
      "start": 24266.2,
      "end": 24268.2,
      "formatted_start": "06:44:26.200",
      "formatted_end": "06:44:28.200",
      "text": "من درمونت که کمان شده"
    },
    {
      "id": 123,
      "start": 24268.2,
      "end": 24270.2,
      "formatted_start": "06:44:28.200",
      "formatted_end": "06:44:30.200",
      "text": "چی برم کنم؟"
    },
    {
      "id": 124,
      "start": 24270.2,
      "end": 24272.2,
      "formatted_start": "06:44:30.200",
      "formatted_end": "06:44:32.200",
      "text": "افته این کار"
    },
    {
      "id": 125,
      "start": 24272.2,
      "end": 24274.2,
      "formatted_start": "06:44:32.200",
      "formatted_end": "06:44:34.200",
      "text": "اصلا نمیتونم"
    },
    {
      "id": 126,
      "start": 24274.2,
      "end": 24276.2,
      "formatted_start": "06:44:34.200",
      "formatted_end": "06:44:36.200",
      "text": "افتادش برم نمیدونم"
    },
    {
      "id": 127,
      "start": 24276.2,
      "end": 24278.2,
      "formatted_start": "06:44:36.200",
      "formatted_end": "06:44:38.200",
      "text": "چی کار کردی؟"
    },
    {
      "id": 128,
      "start": 24278.2,
      "end": 24281.7,
      "formatted_start": "06:44:38.200",
      "formatted_end": "06:44:41.700",
      "text": "او قرص بهش چی دادی به خانم شهر مرادی پیدا نکرده؟"
    },
    {
      "id": 129,
      "start": 24281.7,
      "end": 24282.7,
      "formatted_start": "06:44:41.700",
      "formatted_end": "06:44:42.700",
      "text": "که شهر مرادی؟"
    },
    {
      "id": 130,
      "start": 24282.7,
      "end": 24284.7,
      "formatted_start": "06:44:42.700",
      "formatted_end": "06:44:44.700",
      "text": "نه میگیرن داشترش درد میکرد"
    },
    {
      "id": 131,
      "start": 24284.7,
      "end": 24287.7,
      "formatted_start": "06:44:44.700",
      "formatted_end": "06:44:47.700",
      "text": "البنت های بگو به لفرسی آیستانهش برن"
    },
    {
      "id": 132,
      "start": 24287.7,
      "end": 24289.7,
      "formatted_start": "06:44:47.700",
      "formatted_end": "06:44:49.700",
      "text": "ایرانیشو بگیرن اگه نداشت؟"
    },
    {
      "id": 133,
      "start": 24289.7,
      "end": 24291.7,
      "formatted_start": "06:44:49.700",
      "formatted_end": "06:44:51.700",
      "text": "ارس نه، کپسول ایرانیشو بگیرن"
    },
    {
      "id": 134,
      "start": 24291.7,
      "end": 24293.7,
      "formatted_start": "06:44:51.700",
      "formatted_end": "06:44:53.700",
      "text": "کپسول این هست، بعد اگه کرسی دادی؟"
    },
    {
      "id": 135,
      "start": 24293.7,
      "end": 24295.7,
      "formatted_start": "06:44:53.700",
      "formatted_end": "06:44:55.700",
      "text": "تورتیبتیلی"
    },
    {
      "id": 136,
      "start": 24295.7,
      "end": 24297.7,
      "formatted_start": "06:44:55.700",
      "formatted_end": "06:44:57.700",
      "text": "برنامه خودشو سامان کنیم"
    }
  ],
  "status": "completed"
}