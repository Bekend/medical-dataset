  "stt_segments": [
    {
      "id": 0,
      "start": 24000.0,
      "end": 24015.0,
      "formatted_start": "06:40:00.000",
      "formatted_end": "06:40:15.000",
      "text": "این مجره های اینجا رو باز میکنه خود و این خلط از بادا سینوس از اینجا میره اینجا اطماعی، بعد اینجا اربیتان، بعد میره تای مرز که سرد میده."
    },
    {
      "id": 1,
      "start": 24015.0,
      "end": 24024.0,
      "formatted_start": "06:40:15.000",
      "formatted_end": "06:40:24.000",
      "text": "به خاطر این خلط تخلیه بشه، برای همین باید دیفن اینترامین خلط رو رقیب میکنه و سرموخورده این مسیر رو باز میکنه."
    },
    {
      "id": 2,
      "start": 24024.0,
      "end": 24027.0,
      "formatted_start": "06:40:24.000",
      "formatted_end": "06:40:27.000",
      "text": "دوتا با هم استفاده میشه تدکره تا ست"
    },
    {
      "id": 3,
      "start": 24027.0,
      "end": 24032.0,
      "formatted_start": "06:40:27.000",
      "formatted_end": "06:40:32.000",
      "text": "بعد یک تحصیل بیام برکه سه رو میبینشم باید تعداد میشه"
    },
    {
      "id": 4,
      "start": 24032.0,
      "end": 24034.0,
      "formatted_start": "06:40:32.000",
      "formatted_end": "06:40:34.000",
      "text": "از چی بیدم؟"
    },
    {
      "id": 5,
      "start": 24034.0,
      "end": 24038.0,
      "formatted_start": "06:40:34.000",
      "formatted_end": "06:40:38.000",
      "text": "سه رو میبینم، یکم فشار میشم یکم بالاست"
    },
    {
      "id": 6,
      "start": 24038.0,
      "end": 24042.0,
      "formatted_start": "06:40:38.000",
      "formatted_end": "06:40:42.000",
      "text": "فشار میگفتم من هر چی که خودم گرفتم از سیزده بالا نبوده"
    },
    {
      "id": 7,
      "start": 24042.0,
      "end": 24045.0,
      "formatted_start": "06:40:42.000",
      "formatted_end": "06:40:45.000",
      "text": "خب سیزده نبوده، یا چند ساله بودن؟"
    },
    {
      "id": 8,
      "start": 24045.0,
      "end": 24048.0,
      "formatted_start": "06:40:45.000",
      "formatted_end": "06:40:48.000",
      "text": "هفته بوده، هفته بوده"
    },
    {
      "id": 9,
      "start": 24048.0,
      "end": 24050.0,
      "formatted_start": "06:40:48.000",
      "formatted_end": "06:40:50.000",
      "text": "انشاءالله که سه رو بستاله باشیم"
    },
    {
      "id": 10,
      "start": 24050.0,
      "end": 24052.0,
      "formatted_start": "06:40:50.000",
      "formatted_end": "06:40:52.000",
      "text": "بسیار باشیم، بسیار باشیم"
    },
    {
      "id": 11,
      "start": 24052.0,
      "end": 24053.0,
      "formatted_start": "06:40:52.000",
      "formatted_end": "06:40:53.000",
      "text": "خوب"
    },
    {
      "id": 12,
      "start": 24053.0,
      "end": 24054.0,
      "formatted_start": "06:40:53.000",
      "formatted_end": "06:40:54.000",
