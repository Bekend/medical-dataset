  "stt_segments": [
    {
      "id": 0,
      "start": 6900.0,
      "end": 6930.0,
      "formatted_start": "01:55:00.000",
      "formatted_end": "01:55:30.000",
      "text": "بیشتر بیشتر بیشتر بیشتر بیشتر بیشتر بیشتر بیشتر بیشتر بیشتر بیشتر بیشتر بیشتر بیشتر بیشتر بیشتر بیشتر بیشتر بیشتر بیشتر بیشتر بیشتر بیشتر بیشتر بیشتر بیشتر بیشتر بیشتر بیشتر بیشتر بیشتر بیشتر بیشتر بیشتر بیشتر بیشتر بیشتر بیشتر بیشتر بیشتر بیشتر بیشتر بیشتر بیشتر بیش"
    },
    {
      "id": 1,
      "start": 6930.0,
      "end": 6948.0,
      "formatted_start": "01:55:30.000",
      "formatted_end": "01:55:48.000",
      "text": "موسیقی"
    },
    {
      "id": 2,
      "start": 6960.0,
      "end": 6962.0,
      "formatted_start": "01:56:00.000",
      "formatted_end": "01:56:02.000",
      "text": "این پرابر ایست؟"
    },
    {
      "id": 3,
      "start": 6962.0,
      "end": 6963.0,
      "formatted_start": "01:56:02.000",
      "formatted_end": "01:56:03.000",
      "text": "آره"
    },
    {
      "id": 4,
      "start": 6963.0,
      "end": 6966.0,
      "formatted_start": "01:56:03.000",
      "formatted_end": "01:56:06.000",
      "text": "کلان رو نیستی که با آدوپاسی بگیری میگفت"
    },
    {
      "id": 5,
      "start": 6968.0,
      "end": 6972.0,
      "formatted_start": "01:56:08.000",
      "formatted_end": "01:56:12.000",
      "text": "حتی اختار دادی بود که از ساعت ۱۰۰ از ۱۰۰ از یه خدمت"
    },
    {
      "id": 6,
      "start": 6973.0,
      "end": 6975.0,
      "formatted_start": "01:56:13.000",
      "formatted_end": "01:56:15.000",
      "text": "میبینم داره چی کار میکنن تو این مرسه"
    },
    {
      "id": 7,
      "start": 6975.0,
      "end": 6977.0,
      "formatted_start": "01:56:15.000",
      "formatted_end": "01:56:17.000",
      "text": "پس هم نرسه ما رو ترک بودن بیاییم"
    },
    {
      "id": 8,
      "start": 6977.0,
      "end": 6978.0,
      "formatted_start": "01:56:17.000",
      "formatted_end": "01:56:18.000",
      "text": "این بس شد؟"
    },
    {
      "id": 9,
      "start": 6978.0,
      "end": 6979.0,
      "formatted_start": "01:56:18.000",
      "formatted_end": "01:56:19.000",
      "text": "آره"
    },
    {
      "id": 10,
      "start": 6979.0,
      "end": 6980.0,
      "formatted_start": "01:56:19.000",
      "formatted_end": "01:56:20.000",
      "text": "بس شد"
    },
    {
      "id": 11,
      "start": 6980.0,
      "end": 6981.0,
      "formatted_start": "01:56:20.000",
      "formatted_end": "01:56:21.000",
      "text": "در من کنم ببین"
    },
    {
      "id": 12,
      "start": 6981.0,
      "end": 6982.0,
      "formatted_start": "01:56:21.000",
      "formatted_end": "01:56:22.000",
      "text": "ترمت آمده ای تو؟"
    },
    {
      "id": 13,
      "start": 6982.0,
      "end": 6983.0,
      "formatted_start": "01:56:22.000",
      "formatted_end": "01:56:23.000",
      "text": "ترمت اون من نداریم"
    },
    {
      "id": 14,
      "start": 6983.0,
      "end": 6984.0,
      "formatted_start": "01:56:23.000",
      "formatted_end": "01:56:24.000",
      "text": "تو کی فرمه کن؟"
    },
    {
      "id": 15,
      "start": 6984.0,
      "end": 6986.0,
      "formatted_start": "01:56:24.000",
      "formatted_end": "01:56:26.000",
      "text": "اما فکر کرد اینو میخوای نبودم"
    },
    {
      "id": 16,
      "start": 6986.0,
      "end": 6988.0,
      "formatted_start": "01:56:26.000",
      "formatted_end": "01:56:28.000",
      "text": "آه باش ببخش یعنی بیرون برش"
    },
    {
      "id": 17,
      "start": 6988.0,
      "end": 6990.0,
      "formatted_start": "01:56:28.000",
      "formatted_end": "01:56:30.000",
      "text": "و اینکه میدینی میدونستم"
    },
    {
      "id": 18,
      "start": 6990.0,
      "end": 6992.0,
      "formatted_start": "01:56:30.000",
      "formatted_end": "01:56:32.000",
      "text": "ازیده فکر کرد اینو میخوای بودم"
    },
    {
      "id": 19,
      "start": 6992.0,
      "end": 6994.0,
      "formatted_start": "01:56:32.000",
      "formatted_end": "01:56:34.000",
      "text": "و برم کامل کنن نسخه نیامیه"
    },
    {
      "id": 20,
      "start": 6994.0,
      "end": 6996.0,
      "formatted_start": "01:56:34.000",
      "formatted_end": "01:56:36.000",
      "text": "منم برده برده بیرون برم"
    },
    {
      "id": 21,
      "start": 6996.0,
      "end": 6998.0,
      "formatted_start": "01:56:36.000",
      "formatted_end": "01:56:38.000",
      "text": "خب اینو ترمینه"
