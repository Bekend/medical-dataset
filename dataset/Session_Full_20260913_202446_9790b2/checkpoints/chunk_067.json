  "stt_segments": [
    {
      "id": 0,
      "start": 20100.0,
      "end": 20102.0,
      "formatted_start": "05:35:00.000",
      "formatted_end": "05:35:02.000",
      "text": "این قرصه دیگه خورده."
    },
    {
      "id": 1,
      "start": 20102.0,
      "end": 20106.0,
      "formatted_start": "05:35:02.000",
      "formatted_end": "05:35:06.000",
      "text": "نه نه، اون کپسولی که حالا تا رنگی داره."
    },
    {
      "id": 2,
      "start": 20106.0,
      "end": 20110.0,
      "formatted_start": "05:35:06.000",
      "formatted_end": "05:35:10.000",
      "text": "اونو گفت دیگه روز اینو بخوایید، یعنی ملدو بخوایید."
    },
    {
      "id": 3,
      "start": 20110.0,
      "end": 20117.0,
      "formatted_start": "05:35:10.000",
      "formatted_end": "05:35:17.000",
      "text": "نه نه، هر شب بوده. شبا باید شب بوده. اونو باید قرز کنی از این."
    },
    {
      "id": 4,
      "start": 20117.0,
      "end": 20124.0,
      "formatted_start": "05:35:17.000",
      "formatted_end": "05:35:24.000",
      "text": "خب خورشا زربانش بیفته. حتما بیفته بیفته بیفته."
    },
    {
      "id": 5,
      "start": 20124.0,
      "end": 20126.0,
      "formatted_start": "05:35:24.000",
      "formatted_end": "05:35:26.000",
      "text": "برای از اینکه بیشتر نرمیشت"
    },
    {
      "id": 6,
      "start": 20126.0,
      "end": 20128.0,
      "formatted_start": "05:35:26.000",
      "formatted_end": "05:35:28.000",
      "text": "برای از اینکه بیشتر نرمیشت"
    },
    {
      "id": 7,
      "start": 20128.0,
      "end": 20130.0,
      "formatted_start": "05:35:28.000",
      "formatted_end": "05:35:30.000",
      "text": "یه نصف بیشتر نرمیشت"
    },
    {
      "id": 8,
      "start": 20130.0,
      "end": 20132.0,
      "formatted_start": "05:35:30.000",
      "formatted_end": "05:35:32.000",
      "text": "باید بیاری زرگونش رو چکنن"
    },
    {
      "id": 9,
      "start": 20132.0,
      "end": 20134.0,
      "formatted_start": "05:35:32.000",
      "formatted_end": "05:35:34.000",
      "text": "چون درست داریم"
    },
    {
      "id": 10,
      "start": 20134.0,
      "end": 20136.0,
      "formatted_start": "05:35:34.000",
      "formatted_end": "05:35:36.000",
      "text": "اونجا همین درد ما که نرمید کردیم"
    },
    {
      "id": 11,
      "start": 20136.0,
      "end": 20138.0,
      "formatted_start": "05:35:36.000",
      "formatted_end": "05:35:38.000",
      "text": "برای تو باید یه مساکم بزنیم"
    },
    {
      "id": 12,
      "start": 20138.0,
      "end": 20140.0,
      "formatted_start": "05:35:38.000",
      "formatted_end": "05:35:40.000",
      "text": "یه کار خواستی بیشتر"
    },
    {
      "id": 13,
      "start": 20140.0,
      "end": 20142.0,
      "formatted_start": "05:35:40.000",
      "formatted_end": "05:35:42.000",
      "text": "منتقل اون کپسولا رو قط کنیم"
    },
    {
      "id": 14,
      "start": 20142.0,
      "end": 20144.0,
      "formatted_start": "05:35:42.000",
      "formatted_end": "05:35:44.000",
      "text": "بعد دستش چی کنم؟"
    },
    {
      "id": 15,
      "start": 20144.0,
      "end": 20146.0,
      "formatted_start": "05:35:44.000",
      "formatted_end": "05:35:46.000",
      "text": "دستش مثلا بهش میگیم"
    },
    {
      "id": 16,
      "start": 20146.0,
      "end": 20148.0,
      "formatted_start": "05:35:46.000",
      "formatted_end": "05:35:48.000",
      "text": "کار نکن"
    },
    {
      "id": 17,
      "start": 20148.0,
      "end": 20150.0,
      "formatted_start": "05:35:48.000",
      "formatted_end": "05:35:50.000",
      "text": "فرق آبادی نه"
    },
    {
      "id": 18,
      "start": 20150.0,
      "end": 20152.0,
      "formatted_start": "05:35:50.000",
      "formatted_end": "05:35:52.000",
      "text": "اینجا نمیشه دارداد خزرمان که"
    },
    {
      "id": 19,
      "start": 20152.0,
      "end": 20156.0,
      "formatted_start": "05:35:52.000",
      "formatted_end": "05:35:56.000",
      "text": "بعد امروی شدن دستشون کارویی توی چیز که ندارن"
    },
    {
      "id": 20,
      "start": 20156.0,
      "end": 20158.0,
      "formatted_start": "05:35:56.000",
      "formatted_end": "05:35:58.000",
      "text": "نه امروی نکردن"
    },
    {
      "id": 21,
      "start": 20158.0,
      "end": 20160.0,
      "formatted_start": "05:35:58.000",
      "formatted_end": "05:36:00.000",
      "text": "نه"
    },
    {
      "id": 22,
      "start": 20160.0,
      "end": 20162.0,
      "formatted_start": "05:36:00.000",
      "formatted_end": "05:36:02.000",
      "text": "اما گنبه هستش"
    },
    {
      "id": 23,
      "start": 20162.0,
      "end": 20164.0,
      "formatted_start": "05:36:02.000",
      "formatted_end": "05:36:04.000",
      "text": "اون رو بردم"
    },
    {
      "id": 24,
      "start": 20164.0,
      "end": 20166.0,
      "formatted_start": "05:36:04.000",
      "formatted_end": "05:36:06.000",
      "text": "خیلی شروع اونجا"
    },
    {
      "id": 25,
      "start": 20166.0,
      "end": 20168.0,
      "formatted_start": "05:36:06.000",
      "formatted_end": "05:36:08.000",
      "text": "خوص میدر و پشاری ما دارن مادر کنید"
    },
    {
      "id": 26,
      "start": 20168.0,
      "end": 20170.0,
      "formatted_start": "05:36:08.000",
      "formatted_end": "05:36:10.000",
      "text": "آره برسیدش آره"
    },
    {
      "id": 27,
      "start": 20170.0,
      "end": 20172.0,
      "formatted_start": "05:36:10.000",
      "formatted_end": "05:36:12.000",
      "text": "هر حال میدیم بردم"
    },
    {
      "id": 28,
      "start": 20172.0,
      "end": 20174.0,
      "formatted_start": "05:36:12.000",
      "formatted_end": "05:36:14.000",
      "text": "شما دادید دارم"
    },
    {
      "id": 29,
      "start": 20174.0,
      "end": 20176.0,
      "formatted_start": "05:36:14.000",
      "formatted_end": "05:36:16.000",
      "text": "صبح نشتن"
    },
    {
      "id": 30,
      "start": 20176.0,
      "end": 20178.0,
      "formatted_start": "05:36:16.000",
      "formatted_end": "05:36:18.000",
      "text": "میدیم برم کنید"
    },
    {
      "id": 31,
      "start": 20178.0,
      "end": 20182.0,
      "formatted_start": "05:36:18.000",
      "formatted_end": "05:36:22.000",
      "text": "اونو باید بخواب ماندن"
    },
    {
      "id": 32,
      "start": 20182.0,
      "end": 20186.0,
      "formatted_start": "05:36:22.000",
      "formatted_end": "05:36:26.000",
      "text": "اونو باید گخمان ماندن"
    },
    {
      "id": 33,
      "start": 20186.0,
      "end": 20190.0,
      "formatted_start": "05:36:26.000",
      "formatted_end": "05:36:30.000",
      "text": "از داخل زرب شده"
    },
    {
      "id": 34,
      "start": 20190.0,
      "end": 20194.0,
      "formatted_start": "05:36:30.000",
      "formatted_end": "05:36:34.000",
      "text": "شامه راست"
    },
    {
      "id": 35,
      "start": 20194.0,
      "end": 20198.0,
      "formatted_start": "05:36:34.000",
      "formatted_end": "05:36:38.000",
      "text": "اونو باید بخواب ماندن"
    },
    {
      "id": 36,
      "start": 20198.0,
      "end": 20202.0,
      "formatted_start": "05:36:38.000",
      "formatted_end": "05:36:42.000",
      "text": "اونو باید بخواب ماندن"
    },
    {
      "id": 37,
      "start": 20202.0,
      "end": 20206.0,
      "formatted_start": "05:36:42.000",
      "formatted_end": "05:36:46.000",
      "text": "اونو باید بخواب ماندن"
    },
    {
      "id": 38,
      "start": 20206.0,
      "end": 20208.0,
      "formatted_start": "05:36:46.000",
      "formatted_end": "05:36:48.000",
      "text": "نه چی داره نه هیچ"
    },
    {
      "id": 39,
      "start": 20208.0,
      "end": 20212.0,
      "formatted_start": "05:36:48.000",
      "formatted_end": "05:36:52.000",
      "text": "مصکر ها که حقیقتش برای استانفه میتونم بشون بدم"
    },
    {
      "id": 40,
      "start": 20212.0,
      "end": 20214.0,
      "formatted_start": "05:36:52.000",
      "formatted_end": "05:36:54.000",
      "text": "چون میخواهن زمین"
    },
    {
      "id": 41,
      "start": 20214.0,
      "end": 20218.0,
      "formatted_start": "05:36:54.000",
      "formatted_end": "05:36:58.000",
      "text": "خب استانفه چیزا مصرم آباده"
    },
    {
      "id": 42,
      "start": 20218.0,
      "end": 20220.0,
      "formatted_start": "05:36:58.000",
      "formatted_end": "05:37:00.000",
      "text": "مصرف میکنه"
    },
    {
      "id": 43,
      "start": 20220.0,
      "end": 20222.0,
      "formatted_start": "05:37:00.000",
      "formatted_end": "05:37:02.000",
      "text": "نه مصرف نداره"
    },
    {
      "id": 44,
      "start": 20222.0,
      "end": 20224.0,
      "formatted_start": "05:37:02.000",
      "formatted_end": "05:37:04.000",
      "text": "امروزش همه یکی است"
    },
    {
      "id": 45,
      "start": 20227.0,
      "end": 20231.0,
      "formatted_start": "05:37:07.000",
      "formatted_end": "05:37:11.000",
      "text": "گاهی اونی دست هم داره و گاهی من از اون بگیردن میکنم دکتور"
    },
    {
      "id": 46,
      "start": 20231.0,
      "end": 20233.0,
      "formatted_start": "05:37:11.000",
      "formatted_end": "05:37:13.000",
      "text": "دیسکره"
    },
    {
      "id": 47,
      "start": 20233.0,
      "end": 20236.6,
      "formatted_start": "05:37:13.000",
      "formatted_end": "05:37:16.600",
      "text": "موقعی که فعالیت نداره بهش میگیم کار نکن"
    },
    {
      "id": 48,
      "start": 20236.6,
      "end": 20238.88,
      "formatted_start": "05:37:16.600",
      "formatted_end": "05:37:18.880",
      "text": "مثلا همه کاروش هم خودمون بیشتر انجام میده"
    },
    {
      "id": 49,
      "start": 20238.88,
      "end": 20241.0,
      "formatted_start": "05:37:18.880",
      "formatted_end": "05:37:21.000",
      "text": "ولی خب بازم واینه میست خودش"
    },
    {
      "id": 50,
      "start": 20241.0,
      "end": 20246.96,
      "formatted_start": "05:37:21.000",
      "formatted_end": "05:37:26.960",
      "text": "دست خودش مورم وقتی به این میگیم"
    },
    {
      "id": 51,
      "start": 20246.96,
      "end": 20249.06,
      "formatted_start": "05:37:26.960",
      "formatted_end": "05:37:29.060",
      "text": "سویلنجهش که من چکم پیچیش داشت"
    },
    {
      "id": 52,
      "start": 20249.06,
      "end": 20251.04,
      "formatted_start": "05:37:29.060",
      "formatted_end": "05:37:31.040",
      "text": "چی مو چا؟"
    },
    {
      "id": 53,
      "start": 20251.04,
      "end": 20252.96,
      "formatted_start": "05:37:31.040",
      "formatted_end": "05:37:32.960",
      "text": "شکم پیچیشم دارم خانم دختر"
    },
    {
      "id": 54,
      "start": 20252.96,
      "end": 20256.0,
      "formatted_start": "05:37:32.960",
      "formatted_end": "05:37:36.000",
      "text": "از که کنن سه چهار روزه میشه"
    },
    {
      "id": 55,
      "start": 20256.0,
      "end": 20258.0,
      "formatted_start": "05:37:36.000",
      "formatted_end": "05:37:38.000",
      "text": "برای نوی داری؟"
    },
    {
      "id": 56,
      "start": 20258.0,
      "end": 20258.34,
      "formatted_start": "05:37:38.000",
      "formatted_end": "05:37:38.340",
      "text": "برای نوی داری"
    },
    {
      "id": 57,
      "start": 20258.34,
      "end": 20259.8,
      "formatted_start": "05:37:38.340",
      "formatted_end": "05:37:39.800",
      "text": "بس به خاطر همون بوده"
    },
    {
      "id": 58,
      "start": 20259.8,
      "end": 20261.46,
      "formatted_start": "05:37:39.800",
      "formatted_end": "05:37:41.460",
      "text": "از سیل اول برمون مکتی"
    },
    {
      "id": 59,
      "start": 20261.46,
      "end": 20263.46,
      "formatted_start": "05:37:41.460",
      "formatted_end": "05:37:43.460",
      "text": "خودت را امونه؟"
    },
    {
      "id": 60,
      "start": 20263.46,
      "end": 20265.46,
      "formatted_start": "05:37:43.460",
      "formatted_end": "05:37:45.460",
      "text": "آره دیگه، معیز شدیم"
    },
    {
      "id": 61,
      "start": 20265.46,
      "end": 20267.46,
      "formatted_start": "05:37:45.460",
      "formatted_end": "05:37:47.460",
      "text": "بی حال شدید"
    },
    {
      "id": 62,
      "start": 20267.46,
      "end": 20269.46,
      "formatted_start": "05:37:47.460",
      "formatted_end": "05:37:49.460",
      "text": "بگو در من"
    },
    {
      "id": 63,
      "start": 20269.46,
      "end": 20271.46,
      "formatted_start": "05:37:49.460",
      "formatted_end": "05:37:51.460",
      "text": "خیلی خوب، قرضانش خوب بوده"
    },
    {
      "id": 64,
      "start": 20271.46,
      "end": 20273.46,
      "formatted_start": "05:37:51.460",
      "formatted_end": "05:37:53.460",
      "text": "باید مایات زیاد بسته"
    },
    {
      "id": 65,
      "start": 20273.46,
      "end": 20275.46,
      "formatted_start": "05:37:53.460",
      "formatted_end": "05:37:55.460",
      "text": "آره، اون قرصشون از فیلم قطع کنید"
    },
    {
      "id": 66,
      "start": 20275.46,
      "end": 20277.46,
      "formatted_start": "05:37:55.460",
      "formatted_end": "05:37:57.460",
      "text": "بگو درم"
    },
    {
      "id": 67,
      "start": 20277.46,
      "end": 20279.46,
      "formatted_start": "05:37:57.460",
      "formatted_end": "05:37:59.460",
      "text": "چون میبینید"
    },
    {
      "id": 68,
      "start": 20279.46,
      "end": 20281.46,
      "formatted_start": "05:37:59.460",
      "formatted_end": "05:38:01.460",
      "text": "الان از اون موقع نصفه مامان"
    },
    {
      "id": 69,
      "start": 20281.46,
      "end": 20283.46,
      "formatted_start": "05:38:01.460",
      "formatted_end": "05:38:03.460",
      "text": "سی روز گذاشته"
    },
    {
      "id": 70,
      "start": 20283.46,
      "end": 20285.46,
      "formatted_start": "05:38:03.460",
      "formatted_end": "05:38:05.460",
      "text": "سی سو پنج روز گذاشته"
    },
    {
      "id": 71,
      "start": 20285.46,
      "end": 20287.46,
      "formatted_start": "05:38:05.460",
      "formatted_end": "05:38:07.460",
      "text": "اگر میخواستش که دارو معیز آرزه بده"
    },
    {
      "id": 72,
      "start": 20287.46,
      "end": 20289.46,
      "formatted_start": "05:38:07.460",
      "formatted_end": "05:38:09.460",
      "text": "نه، اصلا از آرزه اون نبود"
    },
    {
      "id": 73,
      "start": 20289.46,
      "end": 20294.46,
      "formatted_start": "05:38:09.460",
      "formatted_end": "05:38:14.460",
      "text": "من چون این روز خاله ش برش دارم باز دوباره آورم خدمت شما ببینم که مثلا"
    },
    {
      "id": 74,
      "start": 20294.46,
      "end": 20299.46,
      "formatted_start": "05:38:14.460",
      "formatted_end": "05:38:19.460",
      "text": "نه ولی مثلا چون مامان همین بیماری اصخار یا که اموزده شده یا که ویروسیه"
    },
    {
      "id": 75,
      "start": 20299.46,
      "end": 20304.46,
      "formatted_start": "05:38:19.460",
      "formatted_end": "05:38:24.460",
      "text": "به خاطر همین خود همین ویروس های اینجوری خودش یکم ضعف و بدنی میده"
    },
    {
      "id": 76,
      "start": 20304.46,
      "end": 20307.46,
      "formatted_start": "05:38:24.460",
      "formatted_end": "05:38:27.460",
      "text": "پونه اینا دم کرده خورده خودش ها"
    },
    {
      "id": 77,
      "start": 20307.46,
      "end": 20309.46,
      "formatted_start": "05:38:27.460",
      "formatted_end": "05:38:29.460",
      "text": "نیست به موز بخورید خورد"
    },
    {
      "id": 78,
      "start": 20309.46,
      "end": 20310.46,
      "formatted_start": "05:38:29.460",
      "formatted_end": "05:38:30.460",
      "text": "موز؟"
    },
    {
      "id": 79,
      "start": 20310.46,
      "end": 20313.46,
      "formatted_start": "05:38:30.460",
      "formatted_end": "05:38:33.460",
      "text": "نمک های خونشون رو برد یک دونه"
    },
    {
      "id": 80,
      "start": 20313.46,
      "end": 20314.46,
      "formatted_start": "05:38:33.460",
      "formatted_end": "05:38:34.460",
      "text": "خوش"
    },
    {
      "id": 81,
      "start": 20314.46,
      "end": 20317.46,
      "formatted_start": "05:38:34.460",
      "formatted_end": "05:38:37.460",
      "text": "شکرم تو آب میره و دریا شده"
    },
    {
      "id": 82,
      "start": 20317.46,
      "end": 20319.46,
      "formatted_start": "05:38:37.460",
      "formatted_end": "05:38:39.460",
      "text": "نه اول آب بره و الان بیرون میترش"
    },
    {
      "id": 83,
      "start": 20319.46,
      "end": 20320.46,
      "formatted_start": "05:38:39.460",
      "formatted_end": "05:38:40.460",
      "text": "درپیچ هم داری؟"
    },
    {
      "id": 84,
      "start": 20320.46,
      "end": 20323.46,
      "formatted_start": "05:38:40.460",
      "formatted_end": "05:38:43.460",
      "text": "نه درپیچ میدن درگیبه"
    },
    {
      "id": 85,
      "start": 20323.46,
      "end": 20325.46,
      "formatted_start": "05:38:43.460",
      "formatted_end": "05:38:45.460",
      "text": "دراند سه چهار رو بشید"
    },
    {
      "id": 86,
      "start": 20325.46,
      "end": 20328.46,
      "formatted_start": "05:38:45.460",
      "formatted_end": "05:38:48.460",
      "text": "چیزی خواهده بودش این؟"
    },
    {
      "id": 87,
      "start": 20328.46,
      "end": 20331.46,
      "formatted_start": "05:38:48.460",
      "formatted_end": "05:38:51.460",
      "text": "چیزی خوردی که یکی بشید"
    },
    {
      "id": 88,
      "start": 20331.46,
      "end": 20334.46,
      "formatted_start": "05:38:51.460",
      "formatted_end": "05:38:54.460",
      "text": "غذای خوستی هم نخواهده بودی"
    },
    {
      "id": 89,
      "start": 20334.46,
      "end": 20336.46,
      "formatted_start": "05:38:54.460",
      "formatted_end": "05:38:56.460",
      "text": "پیروزه بود"
    },
    {
      "id": 90,
      "start": 20336.46,
      "end": 20339.46,
      "formatted_start": "05:38:56.460",
      "formatted_end": "05:38:59.460",
      "text": "چون اینکه تو شرق خیلی بیزیاده"
    },
    {
      "id": 91,
      "start": 20339.46,
      "end": 20343.46,
      "formatted_start": "05:38:59.460",
      "formatted_end": "05:39:03.460",
      "text": "با یکی دستی میدی از همون موقع تو فکر نمیشه"
    },
    {
      "id": 92,
      "start": 20343.46,
      "end": 20346.7,
      "formatted_start": "05:39:03.460",
      "formatted_end": "05:39:06.700",
      "text": "ولی خواهی این زیاد هم از خونه در نمیاده ها"
    },
    {
      "id": 93,
      "start": 20346.7,
      "end": 20348.14,
      "formatted_start": "05:39:06.700",
      "formatted_end": "05:39:08.140",
      "text": "سرماشت تو تامیل"
    },
    {
      "id": 94,
      "start": 20348.14,
      "end": 20351.1,
      "formatted_start": "05:39:08.140",
      "formatted_end": "05:39:11.100",
      "text": "خب این مریض برنس بگیره شما ها میادونید"
    },
    {
      "id": 95,
      "start": 20351.1,
      "end": 20352.02,
      "formatted_start": "05:39:11.100",
      "formatted_end": "05:39:12.020",
      "text": "مایی که آدیدیم"
    },
    {
      "id": 96,
      "start": 20352.02,
      "end": 20353.42,
      "formatted_start": "05:39:12.020",
      "formatted_end": "05:39:13.420",
      "text": "برنامه از شما مثلا"
    },
    {
      "id": 97,
      "start": 20353.42,
      "end": 20356.48,
      "formatted_start": "05:39:13.420",
      "formatted_end": "05:39:16.480",
      "text": "بسر جداش هم البته سرما خورده بودم"
    },
    {
      "id": 98,
      "start": 20356.48,
      "end": 20360.6,
      "formatted_start": "05:39:16.480",
      "formatted_end": "05:39:20.600",
      "text": "شاید از اون ویروسش هم تفایل میده کردیم"
    },
    {
      "id": 99,
      "start": 20360.6,
      "end": 20370.44,
      "formatted_start": "05:39:20.600",
      "formatted_end": "05:39:30.440",
      "text": "خیلی خوب برن خانم ببینید"
    },
    {
      "id": 100,
      "start": 20370.44,
      "end": 20371.68,
      "formatted_start": "05:39:30.440",
      "formatted_end": "05:39:31.680",
      "text": "خیلی نخوابه"
    },
    {
      "id": 101,
      "start": 20371.68,
      "end": 20375.68,
      "formatted_start": "05:39:31.680",
      "formatted_end": "05:39:35.680",
      "text": "برای اینجا می آمیدیم که اون روز کپسول و قدرمون خیال هم باید باشه"
    },
    {
      "id": 102,
      "start": 20375.68,
      "end": 20377.68,
      "formatted_start": "05:39:35.680",
      "formatted_end": "05:39:37.680",
      "text": "مثلا قبل از اون همین بیدار"
    },
    {
      "id": 103,
      "start": 20377.68,
      "end": 20379.68,
      "formatted_start": "05:39:37.680",
      "formatted_end": "05:39:39.680",
      "text": "چربی ما اون بالا نداریم"
    },
    {
      "id": 104,
      "start": 20379.68,
      "end": 20381.68,
      "formatted_start": "05:39:39.680",
      "formatted_end": "05:39:41.680",
      "text": "چربیش که بالا هست"
    },
    {
      "id": 105,
      "start": 20381.68,
      "end": 20383.68,
      "formatted_start": "05:39:41.680",
      "formatted_end": "05:39:43.680",
      "text": "خودش خواهد بوده"
    },
    {
      "id": 106,
      "start": 20383.68,
      "end": 20386.68,
      "formatted_start": "05:39:43.680",
      "formatted_end": "05:39:46.680",
      "text": "دو چیز خواهد بیده یکی چربی بالا یکی کمکار تیل بیده"
    },
    {
      "id": 107,
      "start": 20386.68,
      "end": 20388.68,
      "formatted_start": "05:39:46.680",
      "formatted_end": "05:39:48.680",
      "text": "کمکار تیل بیده نداریم"
    },
    {
      "id": 108,
      "start": 20388.68,
      "end": 20389.68,
      "formatted_start": "05:39:48.680",
      "formatted_end": "05:39:49.680",
      "text": "چربی همون داریم"
    },
    {
      "id": 109,
      "start": 20389.68,
      "end": 20391.68,
      "formatted_start": "05:39:49.680",
      "formatted_end": "05:39:51.680",
      "text": "و چربی رو بلایت میکنن؟"
    },
    {
      "id": 110,
      "start": 20391.68,
      "end": 20392.68,
      "formatted_start": "05:39:51.680",
      "formatted_end": "05:39:52.680",
      "text": "نه"
    },
    {
      "id": 111,
      "start": 20392.68,
      "end": 20393.68,
      "formatted_start": "05:39:52.680",
      "formatted_end": "05:39:53.680",
      "text": "آگه نکنن"
    },
    {
      "id": 112,
      "start": 20393.68,
      "end": 20395.68,
      "formatted_start": "05:39:53.680",
      "formatted_end": "05:39:55.680",
      "text": "این روغن ها که مایه دیگه خانم دکتر"
    }
  ],
  "status": "completed"
}