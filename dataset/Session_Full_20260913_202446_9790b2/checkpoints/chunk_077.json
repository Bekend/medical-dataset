      "end": 23140.0,
      "formatted_start": "06:25:38.000",
      "formatted_end": "06:25:40.000",
      "text": "شبتو چند رو بزنی؟"
    },
    {
      "id": 20,
      "start": 23140.0,
      "end": 23142.0,
      "formatted_start": "06:25:40.000",
      "formatted_end": "06:25:42.000",
      "text": "خانمتو بزنی؟"
    },
    {
      "id": 21,
      "start": 23142.0,
      "end": 23144.0,
      "formatted_start": "06:25:42.000",
      "formatted_end": "06:25:44.000",
      "text": "اون یه دونه سی باید بزنی سی باید سی"
    },
    {
      "id": 22,
      "start": 23144.0,
      "end": 23146.0,
      "formatted_start": "06:25:44.000",
      "formatted_end": "06:25:46.000",
      "text": "این بازی نه"
    },
    {
      "id": 23,
      "start": 23146.0,
      "end": 23148.0,
      "formatted_start": "06:25:46.000",
      "formatted_end": "06:25:48.000",
      "text": "سه نه سه شبه دیگه چند رو بزنی؟"
    },
    {
      "id": 24,
      "start": 23148.0,
      "end": 23150.0,
      "formatted_start": "06:25:48.000",
      "formatted_end": "06:25:50.000",
      "text": "پرس همی کرده؟"
    },
    {
      "id": 25,
      "start": 23150.0,
      "end": 23152.0,
      "formatted_start": "06:25:50.000",
      "formatted_end": "06:25:52.000",
      "text": "بلرنتا بهش داری میگید"
    },
    {
      "id": 26,
      "start": 23152.0,
      "end": 23154.0,
      "formatted_start": "06:25:52.000",
      "formatted_end": "06:25:54.000",
      "text": "بلرنتا کهی میکردی؟"
    },
    {
      "id": 27,
      "start": 23154.0,
      "end": 23156.0,
      "formatted_start": "06:25:54.000",
      "formatted_end": "06:25:56.000",
      "text": "بلرنتا کهی میکردی"
    },
    {
      "id": 28,
      "start": 23156.0,
      "end": 23158.0,
      "formatted_start": "06:25:56.000",
      "formatted_end": "06:25:58.000",
      "text": "موقع نهار موقع شام بخوردی"
    },
    {
      "id": 29,
      "start": 23158.0,
      "end": 23160.0,
      "formatted_start": "06:25:58.000",
      "formatted_end": "06:26:00.000",
      "text": "شبیه ببین قبل شام بخوردی"
    },
    {
      "id": 30,
      "start": 23160.0,
      "end": 23162.0,
      "formatted_start": "06:26:00.000",
      "formatted_end": "06:26:02.000",
      "text": "بلرنتا"
    },
    {
      "id": 31,
      "start": 23162.0,
      "end": 23164.0,
      "formatted_start": "06:26:02.000",
      "formatted_end": "06:26:04.000",
      "text": "بعد نهار میکرده"
    },
    {
      "id": 32,
      "start": 23164.0,
      "end": 23166.0,
      "formatted_start": "06:26:04.000",
      "formatted_end": "06:26:06.000",
      "text": "قبل شام بخوردی"
    },
    {
      "id": 33,
      "start": 23166.0,
      "end": 23168.0,
      "formatted_start": "06:26:06.000",
      "formatted_end": "06:26:08.000",
      "text": "قبل نهار میکرده؟"
    },
    {
      "id": 34,
      "start": 23168.0,
      "end": 23170.0,
      "formatted_start": "06:26:08.000",
      "formatted_end": "06:26:10.000",
      "text": "آره"
    },
    {
      "id": 35,
      "start": 23170.0,
      "end": 23172.0,
      "formatted_start": "06:26:10.000",
      "formatted_end": "06:26:12.000",
      "text": "این صبح جایی"
    },
    {
      "id": 36,
      "start": 23172.0,
      "end": 23174.0,
      "formatted_start": "06:26:12.000",
      "formatted_end": "06:26:14.000",
      "text": "دوازده دوازده شمزده"
    },
    {
      "id": 37,
      "start": 23174.0,
      "end": 23176.0,
      "formatted_start": "06:26:14.000",
      "formatted_end": "06:26:16.000",
      "text": "دوازده دوازده شمزده"
    },
    {
      "id": 38,
      "start": 23176.0,
      "end": 23178.0,
      "formatted_start": "06:26:16.000",
      "formatted_end": "06:26:18.000",
      "text": "این از سه اونو خواستشون"
    },
    {
      "id": 39,
      "start": 23178.0,
      "end": 23180.0,
      "formatted_start": "06:26:18.000",
      "formatted_end": "06:26:20.000",
      "text": "باید برداشت برداشت"
    },
    {
      "id": 40,
      "start": 23180.0,
      "end": 23182.0,
      "formatted_start": "06:26:20.000",
      "formatted_end": "06:26:22.000",
      "text": "باید برداشت"
    },
    {
      "id": 41,
      "start": 23182.0,
      "end": 23184.0,
      "formatted_start": "06:26:22.000",
      "formatted_end": "06:26:24.000",
      "text": "باید برداشت"
    },
    {
      "id": 42,
      "start": 23184.0,
      "end": 23186.0,
      "formatted_start": "06:26:24.000",
      "formatted_end": "06:26:26.000",
      "text": "باید برداشت"
    },
    {
      "id": 43,
      "start": 23186.0,
      "end": 23188.0,
      "formatted_start": "06:26:26.000",
      "formatted_end": "06:26:28.000",
      "text": "باید برداشت"
    },
    {
      "id": 44,
      "start": 23188.0,
      "end": 23190.0,
      "formatted_start": "06:26:28.000",
      "formatted_end": "06:26:30.000",
      "text": "باید برداشت"
    },
    {
      "id": 45,
      "start": 23190.0,
      "end": 23192.0,
      "formatted_start": "06:26:30.000",
      "formatted_end": "06:26:32.000",
      "text": "باید برداشت"
    },
    {
      "id": 46,
      "start": 23192.0,
      "end": 23194.0,
      "formatted_start": "06:26:32.000",
      "formatted_end": "06:26:34.000",
      "text": "باید برداشت"
    },
    {
      "id": 47,
      "start": 23194.0,
      "end": 23196.0,
      "formatted_start": "06:26:34.000",
      "formatted_end": "06:26:36.000",
      "text": "باید برداشت"
    },
    {
      "id": 48,
      "start": 23196.0,
      "end": 23198.0,
      "formatted_start": "06:26:36.000",
      "formatted_end": "06:26:38.000",
      "text": "باید برداشت"
    },
    {
      "id": 49,
      "start": 23198.0,
      "end": 23200.0,
      "formatted_start": "06:26:38.000",
      "formatted_end": "06:26:40.000",
      "text": "باید برداشت"
    },
    {
      "id": 50,
      "start": 23200.0,
      "end": 23202.0,
      "formatted_start": "06:26:40.000",
      "formatted_end": "06:26:42.000",
      "text": "باید برداشت"
    },
    {
      "id": 51,
      "start": 23202.0,
      "end": 23204.0,
      "formatted_start": "06:26:42.000",
      "formatted_end": "06:26:44.000",
      "text": "باید برداشت"
    },
    {
      "id": 52,
      "start": 23204.0,
      "end": 23206.0,
      "formatted_start": "06:26:44.000",
      "formatted_end": "06:26:46.000",
      "text": "باید برداشت"
    },
    {
      "id": 53,
      "start": 23206.0,
      "end": 23210.0,
      "formatted_start": "06:26:46.000",
      "formatted_end": "06:26:50.000",
      "text": "من افزایی شدید در افزایی که خودتون از اصلا بردم"
    },
    {
      "id": 54,
      "start": 23210.0,
      "end": 23214.0,
      "formatted_start": "06:26:50.000",
      "formatted_end": "06:26:54.000",
      "text": "نبایی نبایی گفت که سردادو اصلا بیگه"
    },
    {
      "id": 55,
      "start": 23214.0,
      "end": 23216.0,
      "formatted_start": "06:26:54.000",
      "formatted_end": "06:26:56.000",
      "text": "واقعا هم همینه"
    },
    {
      "id": 56,
      "start": 23216.0,
      "end": 23218.0,
      "formatted_start": "06:26:56.000",
      "formatted_end": "06:26:58.000",
      "text": "اینو درگون سه زده چهارده اصلا بیگه"
    },
    {
      "id": 57,
      "start": 23218.0,
      "end": 23220.0,
      "formatted_start": "06:26:58.000",
      "formatted_end": "06:27:00.000",
      "text": "خیلی باهم کرده بیده"
    },
    {
      "id": 58,
      "start": 23220.0,
      "end": 23221.0,
      "formatted_start": "06:27:00.000",
      "formatted_end": "06:27:01.000",
      "text": "خیلی بیده"
    },
    {
      "id": 59,
      "start": 23221.0,
      "end": 23223.0,
      "formatted_start": "06:27:01.000",
      "formatted_end": "06:27:03.000",
      "text": "اون تو سنگی که باید برده برده"
    },
    {
      "id": 60,
      "start": 23223.0,
      "end": 23228.0,
      "formatted_start": "06:27:03.000",
      "formatted_end": "06:27:08.000",
      "text": "خودشونشون میده و من هم تنها مورد ندارم"
    },
    {
      "id": 61,
      "start": 23228.0,
      "end": 23232.0,
      "formatted_start": "06:27:08.000",
      "formatted_end": "06:27:12.000",
      "text": "دوتون من هر مورد که بیده برده پیده اصلا بیده"
    },
    {
      "id": 62,
      "start": 23232.0,
      "end": 23235.24,
      "formatted_start": "06:27:12.000",
      "formatted_end": "06:27:15.240",
      "text": "به من بگو وقت سردردی نور رضیعتی تو میکنه"
    },
    {
      "id": 63,
      "start": 23235.24,
      "end": 23238.54,
      "formatted_start": "06:27:15.240",
      "formatted_end": "06:27:18.540",
      "text": "بله امورتو اصلا از پشت سردردی میزه به چشم"
    },
    {
      "id": 64,
      "start": 23238.54,
      "end": 23241.48,
      "formatted_start": "06:27:18.540",
      "formatted_end": "06:27:21.480",
      "text": "قوارتشان برمیده و میره پشت سردردی"
    },
    {
      "id": 65,
      "start": 23241.48,
      "end": 23243.48,
      "formatted_start": "06:27:21.480",
      "formatted_end": "06:27:23.480",
      "text": "پشارتو تو اون زمان گرفتی؟"
    },
    {
      "id": 66,
      "start": 23243.48,
      "end": 23246.58,
      "formatted_start": "06:27:23.480",
      "formatted_end": "06:27:26.580",
      "text": "یه بار گرفتم تا رو نشست پشارتشان سیزده"
    },
    {
      "id": 67,
      "start": 23246.58,
      "end": 23249.44,
      "formatted_start": "06:27:26.580",
      "formatted_end": "06:27:29.440",
      "text": "اولی همه حالا ترگوام اصلا سردردی میگیره"
    },
    {
      "id": 68,
      "start": 23249.44,
      "end": 23250.68,
      "formatted_start": "06:27:29.440",
      "formatted_end": "06:27:30.680",
      "text": "الان حالا خوب بوده"
    },
    {
      "id": 69,
      "start": 23250.68,
      "end": 23254.9,
      "formatted_start": "06:27:30.680",
      "formatted_end": "06:27:34.900",
      "text": "اومدم تو مدتر نشستم میموند و پیرانشون سردرد شروع شده بودم"
    },
    {
      "id": 70,
      "start": 23254.9,
      "end": 23258.9,
      "formatted_start": "06:27:34.900",
      "formatted_end": "06:27:38.900",
      "text": "بعد به من بگو که چند روز در هفته سردرد میشید؟"
    },
    {
      "id": 71,
      "start": 23258.9,
      "end": 23262.9,
      "formatted_start": "06:27:38.900",
      "formatted_end": "06:27:42.900",
      "text": "خاندوتو من الان نزدیک به سه هفته از هر روز"
    },
    {
      "id": 72,
      "start": 23262.9,
      "end": 23266.9,
      "formatted_start": "06:27:42.900",
      "formatted_end": "06:27:46.900",
      "text": "جوری به ساعت سه یه نصف شب من تو خوابی دارم میخونم"
    },
    {
      "id": 73,
      "start": 23266.9,
      "end": 23269.9,
      "formatted_start": "06:27:46.900",
      "formatted_end": "06:27:49.900",
      "text": "و بعد از اون گاه هم خوابیدم"
    },
    {
      "id": 74,
      "start": 23269.9,
      "end": 23272.9,
      "formatted_start": "06:27:49.900",
      "formatted_end": "06:27:52.900",
      "text": "تو ببینیم با سردرد و شده اینگاه یه نفر"
    },
    {
      "id": 75,
      "start": 23272.9,
      "end": 23276.9,
      "formatted_start": "06:27:52.900",
      "formatted_end": "06:27:56.900",
      "text": "حتی دو سه ساله پیش تا به سو من این اومد سردرد"
    },
    {
      "id": 76,
      "start": 23276.9,
      "end": 23280.9,
      "formatted_start": "06:27:56.900",
      "formatted_end": "06:28:00.900",
      "text": "اینگاه یه نفر این رو با دست رو بزرگشتن و فشار بگیره مغز من"
    },
    {
      "id": 77,
      "start": 23280.9,
      "end": 23282.9,
      "formatted_start": "06:28:00.900",
      "formatted_end": "06:28:02.900",
      "text": "و بعد تشت نمی کنی؟"
    },
    {
      "id": 78,
      "start": 23282.9,
      "end": 23284.9,
      "formatted_start": "06:28:02.900",
      "formatted_end": "06:28:04.900",
      "text": "توزش مده نداری شد؟"
    },
    {
      "id": 79,
      "start": 23284.9,
      "end": 23286.9,
      "formatted_start": "06:28:04.900",
      "formatted_end": "06:28:06.900",
      "text": "نه، صرف ندارم"
    },
    {
      "id": 80,
      "start": 23286.9,
      "end": 23288.9,
      "formatted_start": "06:28:06.900",
      "formatted_end": "06:28:08.900",
      "text": "بعد به من بگو که وقتی که سردرد میشه"
    },
    {
      "id": 81,
      "start": 23288.9,
      "end": 23290.9,
      "formatted_start": "06:28:08.900",
      "formatted_end": "06:28:10.900",
      "text": "توست در اتاق سرد باشه"
    },
    {
      "id": 82,
      "start": 23290.9,
      "end": 23292.9,
      "formatted_start": "06:28:10.900",
      "formatted_end": "06:28:12.900",
      "text": "اما تو فقط بگو که چستان بزنیم"
    },
    {
      "id": 83,
      "start": 23292.9,
      "end": 23294.9,
      "formatted_start": "06:28:12.900",
      "formatted_end": "06:28:14.900",
      "text": "گخ میکنم"
    },
    {
      "id": 84,
      "start": 23294.9,
      "end": 23296.9,
      "formatted_start": "06:28:14.900",
      "formatted_end": "06:28:16.900",
      "text": "لرزم میدیره"
    },
    {
      "id": 85,
      "start": 23296.9,
      "end": 23298.9,
      "formatted_start": "06:28:16.900",
      "formatted_end": "06:28:18.900",
      "text": "میگرم داری بگو"
    },
    {
      "id": 86,
      "start": 23298.9,
      "end": 23300.9,
      "formatted_start": "06:28:18.900",
      "formatted_end": "06:28:20.900",
      "text": "میگرم خالا بخاطر سرسینا"
    },
    {
      "id": 87,
      "start": 23300.9,
      "end": 23302.9,
      "formatted_start": "06:28:20.900",
      "formatted_end": "06:28:22.900",
      "text": "اسید مدت اصلا نمیاد باش"
    },
    {
      "id": 88,
      "start": 23302.9,
      "end": 23304.9,
      "formatted_start": "06:28:22.900",
      "formatted_end": "06:28:24.900",
      "text": "توزش مده نه"
    },
    {
      "id": 89,
      "start": 23304.9,
      "end": 23306.9,
      "formatted_start": "06:28:24.900",
      "formatted_end": "06:28:26.900",
      "text": "اصلا نه، این چرا؟ چرا؟ من که اصلا نه"
    },
    {
      "id": 90,
      "start": 23306.9,
      "end": 23308.9,
      "formatted_start": "06:28:26.900",
      "formatted_end": "06:28:28.900",
      "text": "اینی کم، اینجوری نیست که اتاق اصلا"
    },
    {
      "id": 91,
      "start": 23308.9,
      "end": 23314.9,
      "formatted_start": "06:28:28.900",
      "formatted_end": "06:28:34.900",
      "text": "اگر اینها زیاد فیلن نخور، توی غذاها عدس، موز، بادنجون میتونه منتقل کنم"
    },
    {
      "id": 92,
      "start": 23314.9,
      "end": 23319.9,
      "formatted_start": "06:28:34.900",
      "formatted_end": "06:28:39.900",
      "text": "بعد دو تا خمس فراتون بردیم شب یه نورتیبتیبین شپا بخورید"
    },
    {
      "id": 93,
      "start": 23319.9,
      "end": 23324.9,
      "formatted_start": "06:28:39.900",
      "formatted_end": "06:28:44.900",
      "text": "ده میدیگرم یه البنت ها نرشدم یا بنده فاکس هر خودمشو پیدا کردید"
    },
    {
      "id": 94,
      "start": 23324.9,
      "end": 23326.9,
      "formatted_start": "06:28:44.900",
      "formatted_end": "06:28:46.900",
      "text": "زمان بعد از نهار"
    },
    {
      "id": 95,
      "start": 23326.9,
      "end": 23330.9,
      "formatted_start": "06:28:46.900",
      "formatted_end": "06:28:50.900",
      "text": "بعد به من بگید کمخونه اینا نرشدید که چی کردید؟"
    },
    {
      "id": 96,
      "start": 23330.9,
      "end": 23334.9,
      "formatted_start": "06:28:50.900",
      "formatted_end": "06:28:54.900",
      "text": "من تا به یه سال بشدم شده کمخونه بشون دوز ازم شدم"
    },
    {
      "id": 97,
      "start": 23334.9,
      "end": 23336.9,
      "formatted_start": "06:28:54.900",
      "formatted_end": "06:28:56.900",
      "text": "نصیبا یه سال آزمایش ندادید؟"
    },
    {
      "id": 98,
      "start": 23336.9,
      "end": 23337.9,
      "formatted_start": "06:28:56.900",
      "formatted_end": "06:28:57.900",
      "text": "نه"
    },
    {
      "id": 99,
      "start": 23337.9,
      "end": 23340.9,
