      "formatted_start": "06:25:16.000",
      "formatted_end": "06:25:18.000",
      "text": "شبه چند بندش بردارید."
    },
    {
      "id": 9,
      "start": 23118.0,
      "end": 23120.0,
      "formatted_start": "06:25:18.000",
      "formatted_end": "06:25:20.000",
      "text": "اگه نیازه نوبت بدم."
    },
    {
      "id": 10,
      "start": 23120.0,
      "end": 23122.0,
      "formatted_start": "06:25:20.000",
      "formatted_end": "06:25:22.000",
      "text": "اگه نیازه نوبت بدم."
    },
    {
      "id": 11,
