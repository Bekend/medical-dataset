  "stt_segments": [
    {
      "id": 0,
      "start": 2100.0,
      "end": 2129.98,
      "formatted_start": "00:35:00.000",
      "formatted_end": "00:35:29.980",
      "text": "برنامه بیمار، گفتگو بین دکتر و بیمار در مطب پزشکی، داروها، آزمایش و نسخه."
    },
    {
      "id": 1,
      "start": 2130.0,
      "end": 2132.0,
      "formatted_start": "00:35:30.000",
      "formatted_end": "00:35:32.000",
      "text": "باید صرفه می کنم"
    },
    {
      "id": 2,
      "start": 2132.0,
      "end": 2133.0,
      "formatted_start": "00:35:32.000",
      "formatted_end": "00:35:33.000",
      "text": "صرفه"
    },
    {
      "id": 3,
      "start": 2133.0,
      "end": 2134.0,
      "formatted_start": "00:35:33.000",
      "formatted_end": "00:35:34.000",
      "text": "دوستی بزرگ تب هم داره"
    },
    {
      "id": 4,
      "start": 2134.0,
      "end": 2136.0,
      "formatted_start": "00:35:34.000",
      "formatted_end": "00:35:36.000",
      "text": "تب، خسخس سینه"
    },
    {
      "id": 5,
      "start": 2136.0,
      "end": 2138.0,
      "formatted_start": "00:35:36.000",
      "formatted_end": "00:35:38.000",
      "text": "صرفه ها خشک یا خلطی"
    },
    {
      "id": 6,
      "start": 2138.0,
      "end": 2139.0,
      "formatted_start": "00:35:38.000",
      "formatted_end": "00:35:39.000",
      "text": "خشکیه"
    },
    {
      "id": 7,
      "start": 2139.0,
      "end": 2141.0,
      "formatted_start": "00:35:39.000",
      "formatted_end": "00:35:41.000",
      "text": "پشت سرهم یا تک تک بشید؟"
    },
    {
      "id": 8,
      "start": 2141.0,
      "end": 2143.0,
      "formatted_start": "00:35:41.000",
      "formatted_end": "00:35:43.000",
      "text": "نه، پشت سرهم باشه"
    },
    {
      "id": 9,
      "start": 2146.0,
      "end": 2148.0,
      "formatted_start": "00:35:46.000",
      "formatted_end": "00:35:48.000",
      "text": "شراب استراتیب سردم بشه دادم"
    },
    {
      "id": 10,
      "start": 2148.0,
      "end": 2150.0,
      "formatted_start": "00:35:48.000",
      "formatted_end": "00:35:50.000",
      "text": "برای این فرقی نگرد"
    },
    {
      "id": 11,
      "start": 2160.0,
      "end": 2180.0,
      "formatted_start": "00:36:00.000",
      "formatted_end": "00:36:20.000",
      "text": "موسیقی"
    },
    {
      "id": 12,
      "start": 2180.0,
      "end": 2182.0,
      "formatted_start": "00:36:20.000",
      "formatted_end": "00:36:22.000",
      "text": "خیلی خوب"
    },
    {
      "id": 13,
      "start": 2182.0,
      "end": 2184.0,
      "formatted_start": "00:36:22.000",
      "formatted_end": "00:36:24.000",
      "text": "برشید"
    },
    {
      "id": 14,
      "start": 2184.0,
      "end": 2186.0,
      "formatted_start": "00:36:24.000",
      "formatted_end": "00:36:26.000",
      "text": "چند ماه شه؟"
    },
    {
      "id": 15,
      "start": 2186.0,
      "end": 2188.0,
      "formatted_start": "00:36:26.000",
      "formatted_end": "00:36:28.000",
      "text": "هفت ماه شه"
    },
    {
      "id": 16,
      "start": 2188.0,
      "end": 2190.0,
      "formatted_start": "00:36:28.000",
      "formatted_end": "00:36:30.000",
      "text": "دارو خوردن اینجوری خوبه؟"
    },
    {
      "id": 17,
      "start": 2190.0,
      "end": 2192.0,
      "formatted_start": "00:36:30.000",
      "formatted_end": "00:36:32.000",
      "text": "اگه دارو خوب میخوره آنکول ننویسن"
    },
    {
      "id": 18,
      "start": 2192.0,
      "end": 2194.0,
      "formatted_start": "00:36:32.000",
      "formatted_end": "00:36:34.000",
      "text": "نه آنکول به نیست بره"
    },
    {
      "id": 19,
      "start": 2194.0,
      "end": 2196.0,
      "formatted_start": "00:36:34.000",
      "formatted_end": "00:36:36.000",
      "text": "بره"
    },
    {
      "id": 20,
      "start": 2196.0,
      "end": 2198.0,
      "formatted_start": "00:36:36.000",
      "formatted_end": "00:36:38.000",
      "text": "بره"
    },
    {
      "id": 21,
      "start": 2198.0,
      "end": 2200.0,
      "formatted_start": "00:36:38.000",
      "formatted_end": "00:36:40.000",
      "text": "بیایید دارو رو بدی سخت کنن"
    },
    {
      "id": 22,
      "start": 2200.0,
      "end": 2202.0,
      "formatted_start": "00:36:40.000",
      "formatted_end": "00:36:42.000",
      "text": "بیایید دارو رو بدی سخت کنن"
    },
    {
      "id": 23,
      "start": 2202.0,
      "end": 2204.0,
      "formatted_start": "00:36:42.000",
      "formatted_end": "00:36:44.000",
      "text": "بیایید دارو رو بدی سخت کنن"
    },
    {
      "id": 24,
      "start": 2204.0,
      "end": 2206.0,
      "formatted_start": "00:36:44.000",
      "formatted_end": "00:36:46.000",
      "text": "بیایید دارو رو بدی سخت کنن"
    },
    {
      "id": 25,
      "start": 2206.0,
      "end": 2208.0,
      "formatted_start": "00:36:46.000",
      "formatted_end": "00:36:48.000",
      "text": "بیایید دارو رو بدی سخت کنن"
    },
    {
      "id": 26,
      "start": 2208.0,
      "end": 2210.0,
      "formatted_start": "00:36:48.000",
      "formatted_end": "00:36:50.000",
      "text": "تخت کنن"
    },
    {
      "id": 27,
      "start": 2224.0,
      "end": 2226.0,
      "formatted_start": "00:37:04.000",
      "formatted_end": "00:37:06.000",
      "text": "داده تو روی آزاده"
    },
    {
      "id": 28,
      "start": 2226.0,
      "end": 2228.0,
      "formatted_start": "00:37:06.000",
      "formatted_end": "00:37:08.000",
      "text": "آزاده؟ بیاین بگو"
    },
    {
      "id": 29,
      "start": 2230.0,
      "end": 2232.0,
      "formatted_start": "00:37:10.000",
      "formatted_end": "00:37:12.000",
      "text": "خانم نارو یاده"
    },
    {
      "id": 30,
      "start": 2232.0,
      "end": 2234.0,
      "formatted_start": "00:37:12.000",
      "formatted_end": "00:37:14.000",
      "text": "بزرگم برگرم"
    },
    {
      "id": 31,
      "start": 2238.0,
      "end": 2248.06,
      "formatted_start": "00:37:18.000",
      "formatted_end": "00:37:28.060",
      "text": "از همونفون داری؟"
    },
    {
      "id": 32,
      "start": 2248.06,
      "end": 2248.46,
      "formatted_start": "00:37:28.060",
      "formatted_end": "00:37:28.460",
      "text": "آره"
    },
    {
      "id": 33,
      "start": 2248.46,
      "end": 2249.82,
      "formatted_start": "00:37:28.460",
      "formatted_end": "00:37:29.820",
      "text": "دیگه ننوشتم"
    },
    {
      "id": 34,
      "start": 2249.82,
      "end": 2258.54,
      "formatted_start": "00:37:29.820",
      "formatted_end": "00:37:38.540",
      "text": "این علامت اصحاب هست"
    },
    {
      "id": 35,
      "start": 2258.54,
      "end": 2261.06,
      "formatted_start": "00:37:38.540",
      "formatted_end": "00:37:41.060",
      "text": "یه داستان جدید"
    },
    {
      "id": 36,
      "start": 2261.06,
      "end": 2263.06,
      "formatted_start": "00:37:41.060",
      "formatted_end": "00:37:43.060",
      "text": "اصحابش روزی چند باره؟"
    },
    {
      "id": 37,
      "start": 2264.46,
      "end": 2265.76,
      "formatted_start": "00:37:44.460",
      "formatted_end": "00:37:45.760",
      "text": "چون که میگم یه داستان جدید"
    },
    {
      "id": 38,
      "start": 2265.76,
      "end": 2267.46,
      "formatted_start": "00:37:45.760",
      "formatted_end": "00:37:47.460",
      "text": "بخوادیم از این داروارو باید تغییر بدم"
    },
    {
      "id": 39,
      "start": 2267.46,
      "end": 2269.46,
      "formatted_start": "00:37:47.460",
      "formatted_end": "00:37:49.460",
      "text": "کلن حصال هستم"
    },
    {
      "id": 40,
      "start": 2269.46,
      "end": 2271.46,
      "formatted_start": "00:37:49.460",
      "formatted_end": "00:37:51.460",
      "text": "نه کلن مثلا دو بار ده بار"
    },
    {
      "id": 41,
      "start": 2271.46,
      "end": 2273.46,
      "formatted_start": "00:37:51.460",
      "formatted_end": "00:37:53.460",
      "text": "دو بار سه بار که میشینه حصال"
    },
    {
      "id": 42,
      "start": 2273.46,
      "end": 2275.46,
      "formatted_start": "00:37:53.460",
      "formatted_end": "00:37:55.460",
      "text": "خب دو بار سه بار زیاد نیست"
    },
    {
      "id": 43,
      "start": 2275.46,
      "end": 2279.46,
      "formatted_start": "00:37:55.460",
      "formatted_end": "00:37:59.460",
      "text": "اگه در روز دو بار سه بار یکم شله خوش کننده اینها میدین؟"
    },
    {
      "id": 44,
      "start": 2279.46,
      "end": 2281.46,
      "formatted_start": "00:37:59.460",
      "formatted_end": "00:38:01.460",
      "text": "نه هیچی ندارم بشین"
    },
    {
      "id": 45,
      "start": 2281.46,
      "end": 2285.46,
      "formatted_start": "00:38:01.460",
      "formatted_end": "00:38:05.460",
      "text": "یه شربت زده حصال همینو نیستم؟"
    },
    {
      "id": 46,
      "start": 2285.46,
      "end": 2287.46,
      "formatted_start": "00:38:05.460",
      "formatted_end": "00:38:07.460",
      "text": "بیا باید چاکی داروهاشو بدنیم"
    },
    {
      "id": 47,
      "start": 2287.46,
      "end": 2289.46,
      "formatted_start": "00:38:07.460",
      "formatted_end": "00:38:09.460",
      "text": "قبلا سفتر بود یعنی؟"
    },
    {
      "id": 48,
      "start": 2289.46,
      "end": 2291.46,
      "formatted_start": "00:38:09.460",
      "formatted_end": "00:38:11.460",
      "text": "الان چهارتن روزی که اینجوریه"
    },
    {
      "id": 49,
      "start": 2291.46,
      "end": 2293.46,
      "formatted_start": "00:38:11.460",
      "formatted_end": "00:38:13.460",
      "text": "خب نمیشتم داروهاشو"
    },
    {
      "id": 50,
      "start": 2293.46,
      "end": 2298.96,
