  "stt_segments": [
    {
      "id": 0,
      "start": 12900.0,
      "end": 12902.0,
      "formatted_start": "03:35:00.000",
      "formatted_end": "03:35:02.000",
      "text": "دوستان چی بشکده؟"
    },
    {
      "id": 1,
      "start": 12902.0,
      "end": 12904.0,
      "formatted_start": "03:35:02.000",
      "formatted_end": "03:35:04.000",
      "text": "خوضا نشکده."
    },
    {
      "id": 2,
      "start": 12904.0,
      "end": 12906.0,
      "formatted_start": "03:35:04.000",
      "formatted_end": "03:35:06.000",
      "text": "خوضا نشکده؟ چرا خوضا تو از اونجا بزنی؟ اگر رو میزش کداشم؟"
    },
    {
      "id": 3,
      "start": 12906.0,
      "end": 12908.0,
      "formatted_start": "03:35:06.000",
      "formatted_end": "03:35:08.000",
      "text": "خاند روزی کن، من خوضا باز نشکم اینجا."
    },
    {
      "id": 4,
      "start": 12908.0,
      "end": 12910.0,
      "formatted_start": "03:35:08.000",
      "formatted_end": "03:35:10.000",
      "text": "من اینجا بابا باز نشکم. من خودم خواهد بزنم."
    },
    {
      "id": 5,
      "start": 12910.0,
      "end": 12912.0,
      "formatted_start": "03:35:10.000",
      "formatted_end": "03:35:12.000",
      "text": "خواهد بزنم؟"
    },
    {
      "id": 6,
      "start": 12912.0,
      "end": 12914.0,
      "formatted_start": "03:35:12.000",
      "formatted_end": "03:35:14.000",
      "text": "خواهد بزنم."
    },
    {
      "id": 7,
      "start": 12930.0,
      "end": 12956.0,
      "formatted_start": "03:35:30.000",
      "formatted_end": "03:35:56.000",
      "text": "موسیقی"
    },
    {
      "id": 8,
      "start": 12956.0,
      "end": 12958.0,
      "formatted_start": "03:35:56.000",
      "formatted_end": "03:35:58.000",
      "text": "اوه نگه بگو که این کود جدید بگیره"
    },
    {
      "id": 9,
      "start": 12958.0,
      "end": 12961.0,
      "formatted_start": "03:35:58.000",
      "formatted_end": "03:36:01.000",
      "text": "امم کانپیتوش از صبح کلا نمیزن"
    },
    {
      "id": 10,
      "start": 12961.0,
      "end": 12963.0,
      "formatted_start": "03:36:01.000",
      "formatted_end": "03:36:03.000",
      "text": "این کود یکی کچکار"
    },
    {
      "id": 11,
      "start": 12963.0,
      "end": 12965.0,
      "formatted_start": "03:36:03.000",
      "formatted_end": "03:36:05.000",
      "text": "چی بفت چیز؟"
    },
    {
      "id": 12,
      "start": 12965.0,
      "end": 12967.0,
      "formatted_start": "03:36:05.000",
      "formatted_end": "03:36:07.000",
      "text": "سارانه بود و بعد ما بزرگ"
    },
    {
      "id": 13,
      "start": 12967.0,
      "end": 12969.0,
      "formatted_start": "03:36:07.000",
      "formatted_end": "03:36:09.000",
      "text": "شما شدودو برده بیدید"
    },
    {
      "id": 14,
      "start": 12969.0,
      "end": 12971.0,
      "formatted_start": "03:36:09.000",
      "formatted_end": "03:36:11.000",
      "text": "میدی چه فردا میزنیم"
    },
    {
      "id": 15,
      "start": 12971.0,
      "end": 12973.0,
      "formatted_start": "03:36:11.000",
      "formatted_end": "03:36:13.000",
      "text": "یعنی این شب در این تاریخ برد بود"
    },
    {
      "id": 16,
      "start": 12973.0,
      "end": 12975.0,
      "formatted_start": "03:36:13.000",
      "formatted_end": "03:36:15.000",
      "text": "شاید هم از بزرگ بشه"
    },
    {
      "id": 17,
      "start": 12975.0,
      "end": 12977.0,
      "formatted_start": "03:36:15.000",
      "formatted_end": "03:36:17.000",
      "text": "اوه از کلا بفت بگم بگم بگیم"
    },
    {
      "id": 18,
      "start": 12977.0,
      "end": 12979.0,
      "formatted_start": "03:36:17.000",
      "formatted_end": "03:36:19.000",
      "text": "یکی بگید بگید بگید"
    },
    {
      "id": 19,
      "start": 12979.0,
      "end": 12982.0,
      "formatted_start": "03:36:19.000",
      "formatted_end": "03:36:22.000",
      "text": "من از صبح می کنم برده شدم از صبح"
    },
    {
      "id": 20,
      "start": 12982.0,
      "end": 12983.0,
      "formatted_start": "03:36:22.000",
      "formatted_end": "03:36:23.000",
      "text": "از صبح ها؟"
    },
    {
      "id": 21,
      "start": 12983.0,
      "end": 12985.5,
      "formatted_start": "03:36:23.000",
      "formatted_end": "03:36:25.500",
      "text": "از صبح می کنم که از صبح شده هم نمی دونم"
    },
    {
      "id": 22,
      "start": 12985.5,
      "end": 12987.0,
      "formatted_start": "03:36:25.500",
      "formatted_end": "03:36:27.000",
      "text": "دونم بشه که بلدتر نشده"
    },
    {
      "id": 23,
      "start": 12987.0,
      "end": 12988.0,
      "formatted_start": "03:36:27.000",
      "formatted_end": "03:36:28.000",
      "text": "ببنیم بشه که بلدتر نشده"
    },
    {
      "id": 24,
      "start": 12988.0,
      "end": 12991.5,
      "formatted_start": "03:36:28.000",
      "formatted_end": "03:36:31.500",
      "text": "یا ۷۶ ۷۰ ۷۰ ۷۰ ۷۰ ۷۰"
    },
    {
      "id": 25,
      "start": 12991.5,
      "end": 12995.5,
      "formatted_start": "03:36:31.500",
      "formatted_end": "03:36:35.500",
      "text": "حالتی این چیز این مزایه خود دکتر این سرامی آدم کم نشونده"
    },
    {
      "id": 26,
      "start": 12995.5,
      "end": 12998.5,
      "formatted_start": "03:36:35.500",
      "formatted_end": "03:36:38.500",
      "text": "حالا پایینجا بابا حالا اینجا بکشوند"
    },
    {
      "id": 27,
      "start": 12998.5,
      "end": 13002.0,
      "formatted_start": "03:36:38.500",
      "formatted_end": "03:36:42.000",
      "text": "ما هر چیز میکشید اون سرامی که بکشید"
    },
    {
      "id": 28,
      "start": 13002.0,
      "end": 13004.5,
      "formatted_start": "03:36:42.000",
      "formatted_end": "03:36:44.500",
      "text": "این سرامی یک کیری کم کرده"
    },
    {
      "id": 29,
      "start": 13004.5,
      "end": 13014.5,
      "formatted_start": "03:36:44.500",
      "formatted_end": "03:36:54.500",
      "text": "موسیقی"
    },
    {
      "id": 30,
      "start": 13034.5,
      "end": 13064.5,
      "formatted_start": "03:37:14.500",
      "formatted_end": "03:37:44.500",
      "text": "اینجا باید بردارید که اینجا باید بردارید که اینجا باید بردارید که اینجا باید بردارید که اینجا بردارید که اینجا بردارید که اینجا بردارید که اینجا بردارید که اینجا بردارید که اینجا بردارید که اینجا بردارید که اینجا بردارید که اینجا بردارید که اینجا بردارید که اینجا بردارید که اینجا بردارید که اینجا بردارید که اینج"
    },
    {
      "id": 31,
      "start": 13064.5,
      "end": 13086.5,
      "formatted_start": "03:37:44.500",
      "formatted_end": "03:38:06.500",
      "text": "موسیقی"
    },
    {
      "id": 32,
      "start": 13086.5,
      "end": 13088.5,
      "formatted_start": "03:38:06.500",
      "formatted_end": "03:38:08.500",
      "text": "همینه که"
    },
    {
      "id": 33,
      "start": 13107.5,
      "end": 13109.5,
      "formatted_start": "03:38:27.500",
      "formatted_end": "03:38:29.500",
      "text": "آقا چینجا"
    },
    {
      "id": 34,
      "start": 13116.5,
      "end": 13141.5,
      "formatted_start": "03:38:36.500",
      "formatted_end": "03:39:01.500",
      "text": "سی تی کی بود و بچه ها باید میدیدن؟"
    },
    {
      "id": 35,
      "start": 13146.5,
      "end": 13149.5,
      "formatted_start": "03:39:06.500",
      "formatted_end": "03:39:09.500",
      "text": "اولا من نمیتونم از باتا چک کنم"
    },
    {
      "id": 36,
      "start": 13149.5,
      "end": 13151.5,
      "formatted_start": "03:39:09.500",
      "formatted_end": "03:39:11.500",
      "text": "چون تو با کلاس چون من یاریکس هستم"
    },
    {
      "id": 37,
      "start": 13151.5,
      "end": 13153.5,
      "formatted_start": "03:39:11.500",
      "formatted_end": "03:39:13.500",
      "text": "خاندر بزنیم میتونیم بریم توشو"
    },
    {
      "id": 38,
      "start": 13153.5,
      "end": 13156.5,
      "formatted_start": "03:39:13.500",
      "formatted_end": "03:39:16.500",
      "text": "نه خاندر من برگیر نمیتونم بریم"
