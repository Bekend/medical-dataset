      "end": 4826.0,
      "formatted_start": "01:20:24.000",
      "formatted_end": "01:20:26.000",
      "text": "اولا ساله مرد برم"
    },
    {
      "id": 13,
      "start": 4834.0,
      "end": 4836.0,
      "formatted_start": "01:20:34.000",
      "formatted_end": "01:20:36.000",
      "text": "این همه زن"
    },
    {
      "id": 14,
      "start": 4840.0,
      "end": 4842.0,
      "formatted_start": "01:20:40.000",
      "formatted_end": "01:20:42.000",
      "text": "این باید از این میگیم؟"
    },
    {
      "id": 15,
      "start": 4842.0,
      "end": 4844.0,
      "formatted_start": "01:20:42.000",
      "formatted_end": "01:20:44.000",
      "text": "این باید از این جرم هست"
    },
    {
      "id": 16,
      "start": 4846.0,
      "end": 4848.0,
      "formatted_start": "01:20:46.000",
      "formatted_end": "01:20:48.000",
      "text": "این باید از این بیشتر بخواب"
    },
    {
      "id": 17,
      "start": 4848.0,
      "end": 4850.0,
      "formatted_start": "01:20:48.000",
      "formatted_end": "01:20:50.000",
      "text": "این بیشتر رو بگذاشت بردارید"
    },
    {
      "id": 18,
      "start": 4850.0,
      "end": 4854.96,
      "formatted_start": "01:20:50.000",
      "formatted_end": "01:20:54.960",
      "text": "راحت هم بیشش کپتول چک خشک نه برد"
    },
    {
      "id": 19,
      "start": 4854.96,
      "end": 4856.96,
      "formatted_start": "01:20:54.960",
      "formatted_end": "01:20:56.960",
      "text": "نه خوشکار نمیخواد"
    },
    {
      "id": 20,
      "start": 4856.96,
      "end": 4858.96,
      "formatted_start": "01:20:56.960",
      "formatted_end": "01:20:58.960",
      "text": "دو تا قطعه داری"
    },
    {
      "id": 21,
      "start": 4858.96,
      "end": 4860.96,
      "formatted_start": "01:20:58.960",
      "formatted_end": "01:21:00.960",
      "text": "هر شیش ساعت برد برزید"
    },
    {
      "id": 22,
      "start": 4860.96,
      "end": 4863.96,
      "formatted_start": "01:21:00.960",
      "formatted_end": "01:21:03.960",
      "text": "خوندودور که هم خیلی ملی هم عذیب میکنه"
    },
    {
      "id": 23,
      "start": 4863.96,
      "end": 4865.96,
      "formatted_start": "01:21:03.960",
      "formatted_end": "01:21:05.960",
      "text": "ناشتایی"
    },
    {
      "id": 24,
      "start": 4865.96,
      "end": 4867.96,
      "formatted_start": "01:21:05.960",
      "formatted_end": "01:21:07.960",
      "text": "ناشتا نه نگمه"
    },
    {
      "id": 25,
      "start": 4867.96,
      "end": 4869.96,
      "formatted_start": "01:21:07.960",
      "formatted_end": "01:21:09.960",
      "text": "اون قصد ناشتایی هم بگویم همه چی کاران میکنه"
    },
    {
      "id": 26,
      "start": 4869.96,
      "end": 4871.96,
      "formatted_start": "01:21:09.960",
      "formatted_end": "01:21:11.960",
      "text": "ناشتا تو صبح و شب بخور"
    },
    {
      "id": 27,
      "start": 4871.96,
      "end": 4873.96,
      "formatted_start": "01:21:11.960",
      "formatted_end": "01:21:13.960",
      "text": "قروب کن به شب"
    },
    {
      "id": 28,
      "start": 4873.96,
      "end": 4875.96,
      "formatted_start": "01:21:13.960",
      "formatted_end": "01:21:15.960",
      "text": "یه دفعه نفس هم میره"
    },
    {
      "id": 29,
      "start": 4875.96,
      "end": 4879.96,
      "formatted_start": "01:21:15.960",
      "formatted_end": "01:21:19.960",
      "text": "از این حالت را از دلیل می کنم."
    },
    {
      "id": 30,
      "start": 4879.96,
      "end": 4883.96,
      "formatted_start": "01:21:19.960",
      "formatted_end": "01:21:23.960",
      "text": "از این حالت را از دلیل می کنم."
    },
    {
      "id": 31,
      "start": 4883.96,
      "end": 4885.96,
      "formatted_start": "01:21:23.960",
      "formatted_end": "01:21:25.960",
      "text": "قلبت که مشکل نداشته؟"
    },
    {
      "id": 32,
      "start": 4885.96,
      "end": 4887.96,
      "formatted_start": "01:21:25.960",
      "formatted_end": "01:21:27.960",
      "text": "قلبم داشته."
    },
    {
      "id": 33,
      "start": 4887.96,
      "end": 4889.96,
      "formatted_start": "01:21:27.960",
      "formatted_end": "01:21:29.960",
      "text": "از دلیل می کنم."
    },
    {
      "id": 34,
      "start": 4889.96,
      "end": 4891.96,
      "formatted_start": "01:21:29.960",
      "formatted_end": "01:21:31.960",
      "text": "از دلیل می کنم."
    },
    {
      "id": 35,
      "start": 4891.96,
      "end": 4893.96,
      "formatted_start": "01:21:31.960",
      "formatted_end": "01:21:33.960",
      "text": "از دلیل می کنم."
    },
    {
      "id": 36,
      "start": 4893.96,
      "end": 4895.96,
      "formatted_start": "01:21:33.960",
      "formatted_end": "01:21:35.960",
      "text": "از دلیل می کنم."
    },
    {
      "id": 37,
      "start": 4895.96,
      "end": 4897.96,
      "formatted_start": "01:21:35.960",
      "formatted_end": "01:21:37.960",
      "text": "از دلیل می کنم."
    },
    {
      "id": 38,
      "start": 4897.96,
      "end": 4899.96,
      "formatted_start": "01:21:37.960",
      "formatted_end": "01:21:39.960",
      "text": "از دلیل می کنم."
    },
    {
      "id": 39,
      "start": 4899.96,
      "end": 4901.96,
      "formatted_start": "01:21:39.960",
      "formatted_end": "01:21:41.960",
      "text": "از دلیل می کنم."
    },
    {
      "id": 40,
      "start": 4901.96,
      "end": 4905.96,
      "formatted_start": "01:21:41.960",
      "formatted_end": "01:21:45.960",
      "text": "خدایی الان گوشو هم میشه و رقم ها میزونه"
    },
    {
      "id": 41,
      "start": 4905.96,
      "end": 4909.96,
      "formatted_start": "01:21:45.960",
      "formatted_end": "01:21:49.960",
      "text": "من مخهر پاکو مجرم خدا و تنها و برای چون گوش دارم"
    },
    {
      "id": 42,
      "start": 4909.96,
      "end": 4913.96,
      "formatted_start": "01:21:49.960",
      "formatted_end": "01:21:53.960",
      "text": "بیمارسان پیانبر برو پیشه آخه دکتر قرباش دولتی هم هست"
    },
    {
      "id": 43,
      "start": 4913.96,
      "end": 4917.96,
      "formatted_start": "01:21:53.960",
      "formatted_end": "01:21:57.960",
      "text": "خود تنهایی برو دیگه بیمارسان دولتی همیشه قرار داده"
    },
    {
      "id": 44,
      "start": 4917.96,
      "end": 4921.96,
      "formatted_start": "01:21:57.960",
      "formatted_end": "01:22:01.960",
      "text": "اسم دکتر میریسم خود برو یه روز اونجا نوابط بگی دکتر رو ببینه"
    },
    {
      "id": 45,
      "start": 4921.96,
      "end": 4925.96,
      "formatted_start": "01:22:01.960",
      "formatted_end": "01:22:05.960",
      "text": "دراصل بچه ها رو بلکن به بچه ها نیاز نداری که"
    },
    {
      "id": 46,
      "start": 4925.96,
      "end": 4928.96,
      "formatted_start": "01:22:05.960",
      "formatted_end": "01:22:08.960",
      "text": "اما که یک در قلبتو اونجا دولتی هم آنجا میکنه"
    },
    {
      "id": 47,
      "start": 4928.96,
      "end": 4931.96,
      "formatted_start": "01:22:08.960",
      "formatted_end": "01:22:11.960",
      "text": "یکم سربالو میره هم نفستم، میره صوفا، میره"
    },
    {
      "id": 48,
      "start": 4931.96,
      "end": 4935.96,
      "formatted_start": "01:22:11.960",
      "formatted_end": "01:22:15.960",
      "text": "بچه ها رو برکن، بچه ها که دور از این بیافتی میخواد چیکار کنی"
    },
    {
      "id": 49,
      "start": 4935.96,
      "end": 4937.96,
      "formatted_start": "01:22:15.960",
      "formatted_end": "01:22:17.960",
      "text": "دولت در من من نمیشه"
    },
    {
      "id": 50,
      "start": 4937.96,
      "end": 4939.96,
      "formatted_start": "01:22:17.960",
      "formatted_end": "01:22:19.960",
      "text": "مثلا یک تیر بکشم، از این"
    },
    {
      "id": 51,
      "start": 4939.96,
      "end": 4943.96,
      "formatted_start": "01:22:19.960",
      "formatted_end": "01:22:23.960",
      "text": "الان رو کافت نمیرسم، برو بیمارستان، اونجا ما باید بگیر باشه"
    },
    {
      "id": 52,
      "start": 4943.96,
      "end": 4946.96,
      "formatted_start": "01:22:23.960",
      "formatted_end": "01:22:26.960",
      "text": "خب، ناشته، بعد"
    },
    {
      "id": 53,
      "start": 4947.96,
      "end": 4949.96,
      "formatted_start": "01:22:27.960",
      "formatted_end": "01:22:29.960",
      "text": "قطرم دوتاست باسه گوشت خب؟"
    },
    {
      "id": 54,
      "start": 4949.96,
      "end": 4951.96,
      "formatted_start": "01:22:29.960",
      "formatted_end": "01:22:31.960",
      "text": "خب"
    },
    {
      "id": 55,
      "start": 4951.96,
      "end": 4954.96,
      "formatted_start": "01:22:31.960",
      "formatted_end": "01:22:34.960",
      "text": "باید به تو زنگ بزنیم عزیز خوب"
    },
    {
      "id": 56,
      "start": 4957.96,
      "end": 4960.96,
      "formatted_start": "01:22:37.960",
      "formatted_end": "01:22:40.960",
      "text": "خیلی هر روز دورم عذیب میشم بید"
    },
    {
      "id": 57,
      "start": 4960.96,
      "end": 4964.96,
      "formatted_start": "01:22:40.960",
      "formatted_end": "01:22:44.960",
      "text": "شوهرمم خوب بکنه داشت که ضربندنیه که من یه جو درد ندی"
    },
    {
      "id": 58,
      "start": 4964.96,
      "end": 4967.96,
      "formatted_start": "01:22:44.960",
      "formatted_end": "01:22:47.960",
      "text": "نه من الان بهت میگم شمار تماس تو بگو"
    },
    {
      "id": 59,
      "start": 4967.96,
      "end": 4969.96,
      "formatted_start": "01:22:47.960",
      "formatted_end": "01:22:49.960",
      "text": "شمار موبایل داره برمه نمیسن"
    },
    {
      "id": 60,
      "start": 4972.96,
      "end": 4977.96,
      "formatted_start": "01:22:52.960",
      "formatted_end": "01:22:57.960",
      "text": "رفتی جایی دارو خونه اون کودی که برای پرام دادی تو موبایلت بهشون نشون بده"
    },
    {
      "id": 61,
      "start": 4977.96,
      "end": 4983.72,
      "formatted_start": "01:22:57.960",
      "formatted_end": "01:23:03.720",
      "text": "این هم داره کنه میشه خونه این سه به بگو دوباره برد بنویسن"
    },
    {
      "id": 62,
      "start": 4983.72,
      "end": 4992.36,
      "formatted_start": "01:23:03.720",
      "formatted_end": "01:23:12.360",
      "text": "این صرفه اینقدر بیرون میکنه منو دید"
    },
    {
      "id": 63,
      "start": 4992.36,
      "end": 4993.4,
      "formatted_start": "01:23:12.360",
      "formatted_end": "01:23:13.400",
      "text": "مول قلبه"
    },
    {
      "id": 64,
      "start": 4993.4,
      "end": 4995.12,
      "formatted_start": "01:23:13.400",
      "formatted_end": "01:23:15.120",
      "text": "مول ریان منو دید"
    },
    {
      "id": 65,
      "start": 4995.12,
      "end": 5001.84,
      "formatted_start": "01:23:15.120",
      "formatted_end": "01:23:21.840",
      "text": "بهتون داره صرفه دادیم"
    },
    {
      "id": 66,
      "start": 5001.84,
      "end": 5005.22,
      "formatted_start": "01:23:21.840",
      "formatted_end": "01:23:25.220",
      "text": "اره اون پورینا مثلا سپوده خودم نمیدونیم"
    },
    {
      "id": 67,
      "start": 5005.22,
      "end": 5006.28,
      "formatted_start": "01:23:25.220",
      "formatted_end": "01:23:26.280",
      "text": "اره اصلا میکنم"
    },
    {
      "id": 68,
      "start": 5006.28,
      "end": 5036.26,
      "formatted_start": "01:23:26.280",
      "formatted_end": "01:23:56.260",
      "text": "از اینجا باید برداریم که اینجا باید برداریم"
    },
    {
      "id": 69,
      "start": 5036.28,
      "end": 5066.26,
      "formatted_start": "01:23:56.280",
      "formatted_end": "01:24:26.260",
      "text": "از اینجا باید بردارید که اینکه بیشتر بردارید، باید بردارید که بیشتر بردارید."
    },
    {
      "id": 70,
      "start": 5066.28,
      "end": 5068.28,
      "formatted_start": "01:24:26.280",
      "formatted_end": "01:24:28.280",
      "text": "بچه های نوبرت بگیرند"
    },
    {
