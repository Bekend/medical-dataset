    },
    {
      "id": 18,
      "start": 13901.0,
      "end": 13902.0,
      "formatted_start": "03:51:41.000",
      "formatted_end": "03:51:42.000",
      "text": "اما ککیست"
    },
    {
      "id": 19,
      "start": 13902.0,
      "end": 13903.0,
      "formatted_start": "03:51:42.000",
      "formatted_end": "03:51:43.000",
