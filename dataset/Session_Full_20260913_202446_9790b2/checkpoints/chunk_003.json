  "stt_segments": [
    {
      "id": 0,
      "start": 900.0,
      "end": 904.0,
      "formatted_start": "00:15:00.000",
      "formatted_end": "00:15:04.000",
      "text": "این شرکت که بازرس شده بود، الان مدتش تمام شده."
    },
    {
      "id": 1,
      "start": 904.0,
      "end": 905.0,
      "formatted_start": "00:15:04.000",
      "formatted_end": "00:15:05.000",
      "text": "آیا بازرس شده؟"
    },
    {
      "id": 2,
      "start": 905.0,
      "end": 907.0,
      "formatted_start": "00:15:05.000",
      "formatted_end": "00:15:07.000",
      "text": "نه، نه، دیگه نمیتونی، اعتباری نداره دیگه."
    },
    {
      "id": 3,
      "start": 907.0,
      "end": 909.0,
      "formatted_start": "00:15:07.000",
      "formatted_end": "00:15:09.000",
      "text": "از شرکت که بازرسشه؟"
    },
    {
      "id": 4,
      "start": 909.0,
      "end": 915.0,
      "formatted_start": "00:15:09.000",
      "formatted_end": "00:15:15.000",
      "text": "فیلن نیشه، تو بر همین چهار ماه اول سال همه شرکت ها گی میزنن دیگه، بازرس انتخاب می کنن، در خاطر همینه."
    },
    {
      "id": 5,
      "start": 915.0,
      "end": 917.0,
      "formatted_start": "00:15:15.000",
      "formatted_end": "00:15:17.000",
      "text": "پس الان ما بازرسش نداریم؟"
    },
    {
      "id": 6,
      "start": 917.0,
      "end": 919.0,
      "formatted_start": "00:15:17.000",
      "formatted_end": "00:15:19.000",
      "text": "در حال حاضر بازرسش نداریم، نه."
    },
    {
      "id": 7,
      "start": 919.0,
      "end": 923.0,
      "formatted_start": "00:15:19.000",
      "formatted_end": "00:15:23.000",
      "text": "ایشون الان نام زدهه ما نمیتونیم بگیم شما بازرسی"
    },
    {
      "id": 8,
      "start": 923.0,
      "end": 925.0,
      "formatted_start": "00:15:23.000",
      "formatted_end": "00:15:25.000",
      "text": "شما بازرسی نیستی که نام رو زده"
    },
    {
      "id": 9,
      "start": 925.0,
      "end": 926.0,
      "formatted_start": "00:15:25.000",
      "formatted_end": "00:15:26.000",
      "text": "شما بازرس نیستی"
    },
    {
      "id": 10,
      "start": 926.0,
      "end": 928.0,
      "formatted_start": "00:15:26.000",
      "formatted_end": "00:15:28.000",
      "text": "پس اون نمیتونه بازرسی"
    },
    {
      "id": 11,
      "start": 928.0,
      "end": 932.0,
      "formatted_start": "00:15:28.000",
      "formatted_end": "00:15:32.000",
      "text": "بازرس روزنامه رسمی قبلی رو نگاه پنی میشه تا پایان سال مالی"
    },
    {
      "id": 12,
      "start": 932.0,
      "end": 934.0,
      "formatted_start": "00:15:32.000",
      "formatted_end": "00:15:34.000",
      "text": "تا پایان سال مالی یعنی اسفنما"
    },
    {
      "id": 13,
      "start": 934.0,
      "end": 936.0,
      "formatted_start": "00:15:34.000",
      "formatted_end": "00:15:36.000",
      "text": "سال مالی ما اسفنما"
    },
    {
      "id": 14,
      "start": 936.0,
      "end": 937.0,
      "formatted_start": "00:15:36.000",
      "formatted_end": "00:15:37.000",
      "text": "بله دقیقا"
    },
    {
      "id": 15,
      "start": 937.0,
      "end": 938.0,
      "formatted_start": "00:15:37.000",
      "formatted_end": "00:15:38.000",
      "text": "مرسی ممنون"
    },
    {
      "id": 16,
      "start": 938.0,
      "end": 940.0,
      "formatted_start": "00:15:38.000",
      "formatted_end": "00:15:40.000",
      "text": "ما به خدمت این سلامت بشیم"
    },
    {
      "id": 17,
      "start": 940.0,
      "end": 942.0,
      "formatted_start": "00:15:40.000",
      "formatted_end": "00:15:42.000",
      "text": "دولتش می کنیم ما اینها یه نیم میتونم"
    },
    {
      "id": 18,
      "start": 942.0,
      "end": 944.0,
      "formatted_start": "00:15:42.000",
      "formatted_end": "00:15:44.000",
      "text": "من فکر کردم شاشمه اوکی شد"
    },
    {
      "id": 19,
      "start": 944.0,
      "end": 947.0,
      "formatted_start": "00:15:44.000",
      "formatted_end": "00:15:47.000",
      "text": "آقا ما اینا اومدن یه سری حرفا رو زدن"
    },
    {
      "id": 20,
      "start": 947.0,
      "end": 949.0,
      "formatted_start": "00:15:47.000",
      "formatted_end": "00:15:49.000",
      "text": "فکر کردم من اومدم اینا رو نوشتم"
    },
    {
      "id": 21,
      "start": 949.0,
      "end": 951.0,
      "formatted_start": "00:15:49.000",
      "formatted_end": "00:15:51.000",
      "text": "گفتم آقا من که بردم"
    },
    {
      "id": 22,
      "start": 951.0,
      "end": 953.0,
      "formatted_start": "00:15:51.000",
      "formatted_end": "00:15:53.000",
      "text": "من که تو ایت مدیره اتخاب شدم"
    },
    {
      "id": 23,
      "start": 953.0,
      "end": 955.0,
      "formatted_start": "00:15:53.000",
      "formatted_end": "00:15:55.000",
      "text": "من که ویس ایت مدیره هم شدم"
    },
    {
      "id": 24,
      "start": 955.0,
      "end": 956.0,
      "formatted_start": "00:15:55.000",
      "formatted_end": "00:15:56.000",
      "text": "درسته؟"
    },
    {
      "id": 25,
      "start": 956.0,
      "end": 958.0,
      "formatted_start": "00:15:56.000",
      "formatted_end": "00:15:58.000",
      "text": "پس چرا بیم دستگاهی کنم تو نوشتن؟"
    },
    {
      "id": 26,
      "start": 958.0,
      "end": 960.0,
      "formatted_start": "00:15:58.000",
      "formatted_end": "00:16:00.000",
      "text": "اینو آقای رحیمی نوشته"
    },
    {
      "id": 27,
      "start": 960.0,
      "end": 962.0,
      "formatted_start": "00:16:00.000",
      "formatted_end": "00:16:02.000",
      "text": "اول دکتر پاشایی منوت گرفته"
    },
    {
      "id": 28,
      "start": 962.0,
      "end": 964.0,
      "formatted_start": "00:16:02.000",
      "formatted_end": "00:16:04.000",
      "text": "دادیم به رحیمی"
    },
    {
      "id": 29,
      "start": 964.0,
      "end": 966.0,
      "formatted_start": "00:16:04.000",
      "formatted_end": "00:16:06.000",
      "text": "با آقای قاسمی هم همه هنگ کرده"
    },
    {
      "id": 30,
      "start": 966.0,
      "end": 971.0,
      "formatted_start": "00:16:06.000",
      "formatted_end": "00:16:11.000",
      "text": "آقای قاسمی هم گفته مثلا این گوشه بازلسشو اینجوری بنویسین درد سراتون کم میشه"
    },
    {
      "id": 31,
      "start": 971.0,
      "end": 972.0,
      "formatted_start": "00:16:11.000",
      "formatted_end": "00:16:12.000",
      "text": "خب؟"
    },
    {
      "id": 32,
      "start": 972.0,
      "end": 974.0,
      "formatted_start": "00:16:12.000",
      "formatted_end": "00:16:14.000",
      "text": "کم میشه برای حرکردن کاره دیگه"
    },
    {
      "id": 33,
      "start": 974.0,
      "end": 976.0,
      "formatted_start": "00:16:14.000",
      "formatted_end": "00:16:16.000",
      "text": "بله برای محصر کار درست بوده یعنی بازلس ها"
    },
    {
      "id": 34,
      "start": 976.0,
      "end": 979.0,
      "formatted_start": "00:16:16.000",
      "formatted_end": "00:16:19.000",
      "text": "اینا هی شپه ایجاد میکنن نه این دستگاری شده"
    },
    {
      "id": 35,
      "start": 979.0,
      "end": 983.0,
      "formatted_start": "00:16:19.000",
      "formatted_end": "00:16:23.000",
      "text": "نه اینا حرکشون اینه که دوباره چون گفتن دوباره دوباره"
    },
    {
      "id": 36,
      "start": 983.0,
      "end": 986.5,
      "formatted_start": "00:16:23.000",
      "formatted_end": "00:16:26.500",
      "text": "آره اینا تو ببین نتونستن رعیهاشونو چیز کنن"
    },
    {
      "id": 37,
      "start": 986.52,
      "end": 990.44,
      "formatted_start": "00:16:26.520",
      "formatted_end": "00:16:30.440",
      "text": "آره نتونستن وردن و الان بیان دوباره برگذار بشه دوباره رعی بیاری"
    },
    {
      "id": 38,
      "start": 990.46,
      "end": 994.9,
      "formatted_start": "00:16:30.460",
      "formatted_end": "00:16:34.900",
      "text": "اون بیانه خیانته دیگه یه انتخاباتی شده سی چهر نفر بوده اینا"
    },
    {
      "id": 39,
      "start": 994.92,
      "end": 998.62,
      "formatted_start": "00:16:34.920",
      "formatted_end": "00:16:38.620",
      "text": "حالا درست رعیهار بد نوشته دکتر پاشایی"
    },
    {
      "id": 40,
      "start": 998.64,
      "end": 1006.54,
      "formatted_start": "00:16:38.640",
      "formatted_end": "00:16:46.540",
      "text": "و مکرو و مکرللا خودش دو ماه مهندسی کرد که کیا رو بیاره خودش رفت بیرون"
    },
    {
      "id": 41,
      "start": 1006.56,
      "end": 1007.94,
      "formatted_start": "00:16:46.560",
      "formatted_end": "00:16:47.940",
      "text": "خواهد ما چی کار کنیم"
    },
    {
      "id": 42,
      "start": 1007.94,
      "end": 1011.36,
      "formatted_start": "00:16:47.940",
      "formatted_end": "00:16:51.360",
      "text": "اصلا رایتونو دیدن متره شدن من این داستانو"
    },
    {
      "id": 43,
      "start": 1011.36,
      "end": 1013.58,
      "formatted_start": "00:16:51.360",
      "formatted_end": "00:16:53.580",
      "text": "ها متره شدی چجوریه؟ خب من..."
    },
    {
      "id": 44,
      "start": 1013.58,
      "end": 1016.66,
      "formatted_start": "00:16:53.580",
      "formatted_end": "00:16:56.660",
      "text": "آقا ماها چیکار کنید الان ما رو متهم دارن میکنن"
    },
    {
      "id": 45,
      "start": 1016.66,
      "end": 1018.66,
      "formatted_start": "00:16:56.660",
      "formatted_end": "00:16:58.660",
      "text": "خودها خواسته"
    },
    {
      "id": 46,
      "start": 1018.66,
      "end": 1019.42,
      "formatted_start": "00:16:58.660",
      "formatted_end": "00:16:59.420",
      "text": "تمام شده؟"
    },
    {
      "id": 47,
      "start": 1019.42,
      "end": 1020.5,
      "formatted_start": "00:16:59.420",
      "formatted_end": "00:17:00.500",
      "text": "آره تمام شده"
    },
    {
      "id": 48,
      "start": 1020.5,
      "end": 1022.5,
      "formatted_start": "00:17:00.500",
      "formatted_end": "00:17:02.500",
      "text": "رای دادن صحامدارا رای دادن"
    },
    {
      "id": 49,
      "start": 1022.5,
      "end": 1026.66,
      "formatted_start": "00:17:02.500",
      "formatted_end": "00:17:06.660",
      "text": "رای دادن آقا تمام شده خودشونم در رایگیرینی میگن اصلا خلاف شده"
    },
    {
      "id": 50,
      "start": 1026.66,
      "end": 1029.62,
      "formatted_start": "00:17:06.660",
      "formatted_end": "00:17:09.620",
      "text": "تمام جلسه باید باهم بگیر بذاری این قضیه رو حل کنید"
    },
    {
      "id": 51,
      "start": 1029.62,
      "end": 1032.74,
      "formatted_start": "00:17:09.620",
      "formatted_end": "00:17:12.740",
      "text": "واقعا اصلا صحامدارو هم بگین دوباره جلسه واقعا خنده داره"
    },
    {
      "id": 52,
      "start": 1032.74,
      "end": 1035.62,
      "formatted_start": "00:17:12.740",
      "formatted_end": "00:17:15.620",
      "text": "یا ما بیکار که همه هم دکتر هم بیکار که نیستن که"
    },
    {
      "id": 53,
      "start": 1035.62,
      "end": 1036.9,
      "formatted_start": "00:17:15.620",
      "formatted_end": "00:17:16.900",
      "text": "واقعا بیکار که نیستن که ما بیکره"
    },
    {
      "id": 54,
      "start": 1036.9,
      "end": 1038.04,
      "formatted_start": "00:17:16.900",
      "formatted_end": "00:17:18.040",
      "text": "واقعا بیکار نیستن"
    },
    {
      "id": 55,
      "start": 1038.04,
      "end": 1040.42,
      "formatted_start": "00:17:18.040",
      "formatted_end": "00:17:20.420",
      "text": "حالا من امروز"
    },
    {
      "id": 56,
      "start": 1040.42,
      "end": 1043.82,
      "formatted_start": "00:17:20.420",
      "formatted_end": "00:17:23.820",
      "text": "پس اگر بازرس نتونه اونا باید برن دنبال یک پنجامه"
    },
    {
      "id": 57,
      "start": 1043.82,
      "end": 1049.12,
      "formatted_start": "00:17:23.820",
      "formatted_end": "00:17:29.120",
      "text": "اصلا بازرس همین جوری که نمیتونه که ماده 95 و 96 قانون تجارت رو ببینین"
    },
    {
      "id": 58,
      "start": 1049.12,
      "end": 1050.48,
      "formatted_start": "00:17:29.120",
      "formatted_end": "00:17:30.480",
      "text": "کامل توضیح داده"
    },
    {
      "id": 59,
      "start": 1050.48,
      "end": 1052.48,
      "formatted_start": "00:17:30.480",
      "formatted_end": "00:17:32.480",
      "text": "شما همون چه اتیبیتی هم بزنیم از تو میاد"
    },
    {
      "id": 60,
      "start": 1052.48,
      "end": 1056.04,
      "formatted_start": "00:17:32.480",
      "formatted_end": "00:17:36.040",
      "text": "ماده ۹۵ و ۹۶ شما اون تجربه در رستش ۹۵ه"
    },
    {
      "id": 61,
      "start": 1056.04,
      "end": 1056.72,
      "formatted_start": "00:17:36.040",
      "formatted_end": "00:17:36.720",
      "text": "باشه باشه"
    },
    {
      "id": 62,
      "start": 1056.72,
      "end": 1057.52,
      "formatted_start": "00:17:36.720",
      "formatted_end": "00:17:37.520",
      "text": "آه من ماده ۹۵ه باشه"
    },
    {
      "id": 63,
      "start": 1057.52,
      "end": 1058.64,
      "formatted_start": "00:17:37.520",
      "formatted_end": "00:17:38.640",
      "text": "باشه در خدمتی"
    },
    {
      "id": 64,
      "start": 1058.64,
      "end": 1060.36,
      "formatted_start": "00:17:38.640",
      "formatted_end": "00:17:40.360",
      "text": "سلامت داشتی خوش برای خدا"
    },
    {
      "id": 65,
      "start": 1080.48,
      "end": 1100.48,
      "formatted_start": "00:18:00.480",
      "formatted_end": "00:18:20.480",
      "text": "موسیقی"
    },
    {
      "id": 66,
      "start": 1100.48,
      "end": 1128.48,
      "formatted_start": "00:18:20.480",
      "formatted_end": "00:18:48.480",
      "text": "موسیقی"
    },
    {
      "id": 67,
      "start": 1128.48,
      "end": 1130.48,
      "formatted_start": "00:18:48.480",
      "formatted_end": "00:18:50.480",
      "text": "آقا فقط نزدید"
    },
    {
      "id": 68,
      "start": 1130.48,
      "end": 1132.48,
      "formatted_start": "00:18:50.480",
      "formatted_end": "00:18:52.480",
      "text": "یخ زدم"
    },
    {
      "id": 69,
      "start": 1132.48,
      "end": 1135.48,
      "formatted_start": "00:18:52.480",
      "formatted_end": "00:18:55.480",
      "text": "اصلا این دو شب جزو عمر نبود"
    },
    {
      "id": 70,
      "start": 1135.48,
      "end": 1138.48,
      "formatted_start": "00:18:55.480",
      "formatted_end": "00:18:58.480",
      "text": "فوقلاد بخاری روشن کردی"
    },
    {
      "id": 71,
      "start": 1138.48,
      "end": 1140.48,
      "formatted_start": "00:18:58.480",
      "formatted_end": "00:19:00.480",
      "text": "اصلا فوقلاد"
    },
    {
      "id": 72,
      "start": 1153.48,
      "end": 1157.48,
      "formatted_start": "00:19:13.480",
      "formatted_end": "00:19:17.480",
      "text": "حاج مشتوا سلام بچه ها خوب هستن؟ دایید قربانت بشم"
    },
    {
      "id": 73,
      "start": 1158.48,
      "end": 1186.48,
      "formatted_start": "00:19:18.480",
      "formatted_end": "00:19:46.480",
      "text": "موسیقی"
    },
    {
      "id": 74,
      "start": 1188.48,
      "end": 1199.48,
      "formatted_start": "00:19:48.480",
      "formatted_end": "00:19:59.480",
      "text": "موسیقی"
    }
  ],
  "status": "completed"
}