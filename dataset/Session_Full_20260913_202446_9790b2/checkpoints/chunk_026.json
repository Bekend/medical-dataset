      "formatted_start": "02:11:18.000",
      "formatted_end": "02:11:20.000",
      "text": "از این ادرسی شما برده بیشتر"
    },
    {
      "id": 20,
      "start": 7880.0,
      "end": 7882.0,
      "formatted_start": "02:11:20.000",
      "formatted_end": "02:11:22.000",
      "text": "همینی هیچی داروی هیچی نیم"
    },
    {
      "id": 21,
      "start": 7882.0,
      "end": 7884.0,
      "formatted_start": "02:11:22.000",
      "formatted_end": "02:11:24.000",
      "text": "چرا؟ میریم اصلا برای سایت برده"
    },
    {
      "id": 22,
      "start": 7884.0,
      "end": 7886.0,
      "formatted_start": "02:11:24.000",
      "formatted_end": "02:11:26.000",
      "text": "برایشون داروی میریم اصلا بگیر"
    },
    {
      "id": 23,
      "start": 7886.0,
      "end": 7888.0,
      "formatted_start": "02:11:26.000",
      "formatted_end": "02:11:28.000",
      "text": "و ازمایش میریم"
    },
    {
      "id": 24,
      "start": 7888.0,
      "end": 7890.0,
      "formatted_start": "02:11:28.000",
      "formatted_end": "02:11:30.000",
      "text": "اصلا ازمایش رو انجام بده بیرون"
    },
    {
      "id": 25,
      "start": 7890.0,
      "end": 7892.0,
      "formatted_start": "02:11:30.000",
      "formatted_end": "02:11:32.000",
      "text": "نه من اینجا ملحظه ببینم باید بیایم"
    },
    {
      "id": 26,
      "start": 7892.0,
      "end": 7894.0,
      "formatted_start": "02:11:32.000",
      "formatted_end": "02:11:34.000",
      "text": "نه مثلا سامانه باید هست"
    },
    {
      "id": 27,
      "start": 7894.0,
      "end": 7896.0,
      "formatted_start": "02:11:34.000",
      "formatted_end": "02:11:36.000",
      "text": "برید خود رو برید اون زنگیزن"
    },
    {
      "id": 28,
      "start": 7896.0,
      "end": 7898.0,
      "formatted_start": "02:11:36.000",
      "formatted_end": "02:11:38.000",
      "text": "خیلی ممنون خدا خیلی خدا"
    },
    {
      "id": 29,
      "start": 7898.0,
      "end": 7900.0,
      "formatted_start": "02:11:38.000",
      "formatted_end": "02:11:40.000",
      "text": "سلامت باشیم"
    },
    {
      "id": 30,
      "start": 7900.0,
      "end": 7902.0,
      "formatted_start": "02:11:40.000",
      "formatted_end": "02:11:42.000",
      "text": "خدا باشیم"
    },
    {
      "id": 31,
      "start": 7902.0,
      "end": 7904.0,
      "formatted_start": "02:11:42.000",
      "formatted_end": "02:11:44.000",
      "text": "سلامت باشیم"
    },
    {
      "id": 32,
      "start": 7904.0,
      "end": 7932.0,
      "formatted_start": "02:11:44.000",
      "formatted_end": "02:12:12.000",
      "text": "موسیقی"
    },
    {
      "id": 33,
      "start": 7932.0,
      "end": 7936.0,
      "formatted_start": "02:12:12.000",
      "formatted_end": "02:12:16.000",
      "text": "خب خواهد کم خونید و بعد به نومینو ها پسید"
    },
    {
      "id": 34,
      "start": 7936.0,
      "end": 7938.0,
      "formatted_start": "02:12:16.000",
      "formatted_end": "02:12:18.000",
      "text": "درستید"
    },
    {
      "id": 35,
      "start": 7938.0,
      "end": 7941.0,
      "formatted_start": "02:12:18.000",
      "formatted_end": "02:12:21.000",
      "text": "و پدر مادرتون هم دارن؟"
    },
    {
      "id": 36,
      "start": 7941.0,
      "end": 7942.0,
      "formatted_start": "02:12:21.000",
      "formatted_end": "02:12:22.000",
      "text": "نه"
    },
    {
      "id": 37,
      "start": 7942.0,
      "end": 7944.0,
      "formatted_start": "02:12:22.000",
      "formatted_end": "02:12:24.000",
      "text": "اونو داری خواهده"
    },
    {
      "id": 38,
      "start": 7944.0,
      "end": 7946.0,
      "formatted_start": "02:12:24.000",
      "formatted_end": "02:12:26.000",
      "text": "چی که هست؟"
    },
    {
      "id": 39,
      "start": 7946.0,
      "end": 7948.0,
      "formatted_start": "02:12:26.000",
      "formatted_end": "02:12:28.000",
      "text": "مادر هندون خربوزایی نه زیاد خوردی؟"
    },
    {
      "id": 40,
      "start": 7948.0,
      "end": 7951.0,
      "formatted_start": "02:12:28.000",
      "formatted_end": "02:12:31.000",
      "text": "انگور هندون خربوزایی نه زیاد خورده؟"
    },
    {
      "id": 41,
      "start": 7951.0,
      "end": 7953.0,
      "formatted_start": "02:12:31.000",
      "formatted_end": "02:12:33.000",
      "text": "آه، تا اصلا میده"
    },
    {
      "id": 42,
      "start": 7953.0,
      "end": 7956.0,
      "formatted_start": "02:12:33.000",
      "formatted_end": "02:12:36.000",
      "text": "همده چونه، گاهی داره بالا میده خب؟"
    },
    {
      "id": 43,
      "start": 7956.0,
      "end": 7957.0,
      "formatted_start": "02:12:36.000",
      "formatted_end": "02:12:37.000",
      "text": "آه"
    },
    {
      "id": 44,
      "start": 7957.0,
      "end": 7961.0,
      "formatted_start": "02:12:37.000",
      "formatted_end": "02:12:41.000",
      "text": "اگه این را رایت مکنید، تون که مثلا پنسادی دیابت میگیره"
    },
    {
      "id": 45,
      "start": 7961.0,
      "end": 7963.96,
      "formatted_start": "02:12:41.000",
      "formatted_end": "02:12:43.960",
      "text": "این 6 و 2 باید زیر 5 و 7 باشه"
    },
    {
      "id": 46,
      "start": 7963.96,
      "end": 7966.7,
      "formatted_start": "02:12:43.960",
      "formatted_end": "02:12:46.700",
      "text": "یعنی که شما قطعه افتاد قدرتون بالایی دوست میده"
    },
    {
      "id": 47,
      "start": 7966.7,
      "end": 7974.24,
      "formatted_start": "02:12:46.700",
      "formatted_end": "02:12:54.240",
      "text": "روشابه، دلسته، هندونه، قربازه، انگور، نوز، پنجی، مکارانی"
    },
    {
      "id": 48,
      "start": 7974.24,
      "end": 7975.2,
      "formatted_start": "02:12:54.240",
      "formatted_end": "02:12:55.200",
      "text": "این ها رو هستید"
    },
    {
      "id": 49,
      "start": 7975.2,
      "end": 7978.04,
      "formatted_start": "02:12:55.200",
      "formatted_end": "02:12:58.040",
      "text": "چایتون با دسته تا کشمش با قدر اصلا"
    },
    {
      "id": 50,
      "start": 7978.04,
      "end": 7980.74,
      "formatted_start": "02:12:58.040",
      "formatted_end": "02:13:00.740",
      "text": "باید تو تا خوش کنید"
    },
    {
      "id": 51,
      "start": 7980.74,
      "end": 7982.42,
      "formatted_start": "02:13:00.740",
      "formatted_end": "02:13:02.420",
      "text": "ادرانتون راحت میده"
    },
    {
      "id": 52,
      "start": 7982.42,
      "end": 7983.7,
      "formatted_start": "02:13:02.420",
      "formatted_end": "02:13:03.700",
      "text": "پیشایش کم شده"
    },
    {
      "id": 53,
      "start": 7983.7,
      "end": 7987.28,
      "formatted_start": "02:13:03.700",
      "formatted_end": "02:13:07.280",
      "text": "هیچ فرق نکرد"
    },
    {
      "id": 54,
      "start": 7987.28,
      "end": 7988.34,
      "formatted_start": "02:13:07.280",
      "formatted_end": "02:13:08.340",
      "text": "زور به زرگی"
    },
    {
      "id": 55,
      "start": 7988.34,
      "end": 7990.34,
      "formatted_start": "02:13:08.340",
      "formatted_end": "02:13:10.340",
      "text": "یکم"
    },
    {
      "id": 56,
      "start": 7990.34,
      "end": 7992.34,
      "formatted_start": "02:13:10.340",
      "formatted_end": "02:13:12.340",
      "text": "گستاتو جنگ جنگ برم کرده و در پولیتون بشه"
    },
    {
      "id": 57,
      "start": 7992.34,
      "end": 7994.34,
      "formatted_start": "02:13:12.340",
      "formatted_end": "02:13:14.340",
      "text": "گستاتو جنگ جنگ"
    },
    {
      "id": 58,
      "start": 7994.34,
      "end": 7996.34,
      "formatted_start": "02:13:14.340",
      "formatted_end": "02:13:16.340",
      "text": "چند ساله شدید؟ پنجه هم"
    },
    {
      "id": 59,
      "start": 7996.34,
      "end": 7998.34,
      "formatted_start": "02:13:16.340",
      "formatted_end": "02:13:18.340",
      "text": "سالتزار داریم"
    },
    {
      "id": 60,
      "start": 7998.34,
      "end": 8000.34,
      "formatted_start": "02:13:18.340",
      "formatted_end": "02:13:20.340",
      "text": "عمدتون میگه؟"
    },
    {
      "id": 61,
      "start": 8000.34,
      "end": 8002.34,
      "formatted_start": "02:13:20.340",
      "formatted_end": "02:13:22.340",
      "text": "رایت کنم"
    },
    {
      "id": 62,
      "start": 8002.34,
      "end": 8004.34,
      "formatted_start": "02:13:22.340",
      "formatted_end": "02:13:24.340",
      "text": "آفراد"
    },
    {
      "id": 63,
      "start": 8004.34,
      "end": 8006.34,
      "formatted_start": "02:13:24.340",
      "formatted_end": "02:13:26.340",
      "text": "رایت فیلم"
    },
    {
      "id": 64,
      "start": 8006.34,
      "end": 8008.34,
      "formatted_start": "02:13:26.340",
      "formatted_end": "02:13:28.340",
      "text": "آزمای کمت خوبه"
    },
    {
      "id": 65,
      "start": 8008.34,
      "end": 8010.34,
      "formatted_start": "02:13:28.340",
      "formatted_end": "02:13:30.340",
      "text": "شدید"
    },
    {
      "id": 66,
      "start": 8010.34,
      "end": 8012.34,
      "formatted_start": "02:13:30.340",
      "formatted_end": "02:13:32.340",
      "text": "بخشید"
    },
    {
      "id": 67,
      "start": 8012.34,
      "end": 8014.34,
      "formatted_start": "02:13:32.340",
      "formatted_end": "02:13:34.340",
      "text": "کم خونی دارید"
    },
    {
      "id": 68,
      "start": 8014.34,
      "end": 8016.34,
      "formatted_start": "02:13:34.340",
      "formatted_end": "02:13:36.340",
      "text": "گوشتون هم نیست که هم استفاده میکنیم"
    },
    {
      "id": 69,
      "start": 8016.34,
      "end": 8016.84,
      "formatted_start": "02:13:36.340",
      "formatted_end": "02:13:36.840",
      "text": "که درمه؟"
    },
    {
      "id": 70,
      "start": 8016.84,
      "end": 8017.34,
      "formatted_start": "02:13:36.840",
      "formatted_end": "02:13:37.340",
      "text": "بوسن بوسن"
    },
    {
      "id": 71,
      "start": 8017.34,
      "end": 8018.34,
      "formatted_start": "02:13:37.340",
      "formatted_end": "02:13:38.340",
      "text": "چرا بوسن؟"
    },
    {
      "id": 72,
      "start": 8019.34,
      "end": 8021.34,
      "formatted_start": "02:13:39.340",
      "formatted_end": "02:13:41.340",
      "text": "پدر مادر یک مشکل خاصی نداشتن"
    },
    {
      "id": 73,
      "start": 8021.34,
      "end": 8022.34,
      "formatted_start": "02:13:41.340",
      "formatted_end": "02:13:42.340",
      "text": "نه"
    },
    {
      "id": 74,
      "start": 8022.34,
      "end": 8024.34,
      "formatted_start": "02:13:42.340",
      "formatted_end": "02:13:44.340",
      "text": "اما داری خاله اینا چی بود؟"
    },
    {
      "id": 75,
      "start": 8024.34,
      "end": 8028.34,
      "formatted_start": "02:13:44.340",
      "formatted_end": "02:13:48.340",
      "text": "نه ما تو آها انتظار کم خونی نداری خب؟"
    },
    {
      "id": 76,
      "start": 8028.34,
      "end": 8028.84,
      "formatted_start": "02:13:48.340",
      "formatted_end": "02:13:48.840",
      "text": "نه"
    },
    {
      "id": 77,
      "start": 8028.84,
      "end": 8030.34,
      "formatted_start": "02:13:48.840",
      "formatted_end": "02:13:50.340",
      "text": "خوشتون بواسیق نداره؟"
    },
    {
      "id": 78,
      "start": 8030.34,
      "end": 8031.34,
      "formatted_start": "02:13:50.340",
      "formatted_end": "02:13:51.340",
      "text": "چرا کم دارم؟"
    },
    {
      "id": 79,
      "start": 8031.34,
      "end": 8034.34,
      "formatted_start": "02:13:51.340",
      "formatted_end": "02:13:54.340",
      "text": "آه پس اصلا اونجا داری خون از نصف"
    },
    {
      "id": 80,
      "start": 8034.34,
      "end": 8036.34,
      "formatted_start": "02:13:54.340",
      "formatted_end": "02:13:56.340",
      "text": "چون بدن تو داره دیجه خون داره"
    },
    {
      "id": 81,
      "start": 8036.34,
      "end": 8037.34,
      "formatted_start": "02:13:56.340",
      "formatted_end": "02:13:57.340",
      "text": "کم؟"
    },
    {
      "id": 82,
      "start": 8037.34,
      "end": 8040.34,
      "formatted_start": "02:13:57.340",
      "formatted_end": "02:14:00.340",
      "text": "اوه خیلی شاید فرقی کن"
    },
    {
      "id": 83,
      "start": 8040.34,
      "end": 8042.34,
      "formatted_start": "02:14:00.340",
      "formatted_end": "02:14:02.340",
      "text": "با چشم دیده نمیشه خب؟"
    },
    {
      "id": 84,
      "start": 8042.34,
      "end": 8046.34,
      "formatted_start": "02:14:02.340",
      "formatted_end": "02:14:06.340",
      "text": "من یادماش مرد خوبه از خون نمی نوستم"
    },
    {
      "id": 85,
      "start": 8046.34,
      "end": 8048.34,
      "formatted_start": "02:14:06.340",
      "formatted_end": "02:14:08.340",
      "text": "ببینید چرا کمپایی باشه"
    },
    {
      "id": 86,
      "start": 8048.34,
      "end": 8050.34,
      "formatted_start": "02:14:08.340",
      "formatted_end": "02:14:10.340",
      "text": "مرد اصلا نباید کمپایی باشه"
    },
    {
      "id": 87,
      "start": 8050.34,
      "end": 8051.34,
      "formatted_start": "02:14:10.340",
      "formatted_end": "02:14:11.340",
      "text": "خب؟"
    },
    {
      "id": 88,
      "start": 8051.34,
      "end": 8053.34,
      "formatted_start": "02:14:11.340",
      "formatted_end": "02:14:13.340",
      "text": "بعد پرسات آهنگتون رو بگویید"
    },
    {
      "id": 89,
      "start": 8053.34,
      "end": 8055.34,
      "formatted_start": "02:14:13.340",
      "formatted_end": "02:14:15.340",
      "text": "پرسات آهنگتون رو مستقبل میگیرم"
    },
    {
      "id": 90,
      "start": 8055.34,
      "end": 8056.34,
      "formatted_start": "02:14:15.340",
      "formatted_end": "02:14:16.340",
      "text": "این تمام شده این نخواهد"
    },
    {
      "id": 91,
      "start": 8056.34,
      "end": 8057.34,
      "formatted_start": "02:14:16.340",
      "formatted_end": "02:14:17.340",
      "text": "الان نمی نوستم"
    },
    {
      "id": 92,
      "start": 8057.34,
      "end": 8059.34,
      "formatted_start": "02:14:17.340",
      "formatted_end": "02:14:19.340",
      "text": "آهنگتون ایرانی نویسر یا خواهشی؟"
    },
    {
      "id": 93,
      "start": 8059.34,
      "end": 8060.34,
      "formatted_start": "02:14:19.340",
      "formatted_end": "02:14:20.340",
      "text": "خواهشی باشه"
    },
    {
      "id": 94,
      "start": 8060.34,
      "end": 8063.34,
      "formatted_start": "02:14:20.340",
      "formatted_end": "02:14:23.340",
      "text": "به توجیدیتون رو به خواهی نشت"
    },
    {
      "id": 95,
      "start": 8063.34,
      "end": 8066.34,
      "formatted_start": "02:14:23.340",
      "formatted_end": "02:14:26.340",
      "text": "پرساتتون از نظر بد خیلی خوب بره"
    },
    {
      "id": 96,
      "start": 8066.34,
      "end": 8068.34,
      "formatted_start": "02:14:26.340",
      "formatted_end": "02:14:28.340",
      "text": "اینجوری برگرده بود"
    },
    {
      "id": 97,
      "start": 8068.34,
      "end": 8070.34,
      "formatted_start": "02:14:28.340",
      "formatted_end": "02:14:30.340",
      "text": "اینجوری برگرده بود"
    },
    {
      "id": 98,
      "start": 8070.34,
      "end": 8072.34,
      "formatted_start": "02:14:30.340",
      "formatted_end": "02:14:32.340",
      "text": "اینجوری برگرده بود"
    },
    {
      "id": 99,
      "start": 8072.34,
      "end": 8074.34,
      "formatted_start": "02:14:32.340",
      "formatted_end": "02:14:34.340",
      "text": "اینجوری برگرده بود"
    },
    {
      "id": 100,
      "start": 8074.34,
      "end": 8076.34,
      "formatted_start": "02:14:34.340",
      "formatted_end": "02:14:36.340",
      "text": "اینجوری برگرده بود"
    },
    {
      "id": 101,
      "start": 8076.34,
      "end": 8078.34,
      "formatted_start": "02:14:36.340",
      "formatted_end": "02:14:38.340",
      "text": "اینجوری برگرده بود"
    },
    {
      "id": 102,
      "start": 8078.34,
      "end": 8080.34,
      "formatted_start": "02:14:38.340",
      "formatted_end": "02:14:40.340",
      "text": "اینجوری برگرده بود"
    },
