  "stt_segments": [
    {
      "id": 0,
      "start": 7800.0,
      "end": 7812.0,
      "formatted_start": "02:10:00.000",
      "formatted_end": "02:10:12.000",
      "text": "بعد، مطب پرسیکا همه رو برداشت، به زبط قطعی نیستادیم، از هر کدوم سپر هم رسوی و بعد برداشت تو شربت دیگه میتوانیم."
    },
    {
      "id": 1,
      "start": 7812.0,
      "end": 7818.0,
      "formatted_start": "02:10:12.000",
      "formatted_end": "02:10:18.000",
      "text": "شب هم اصلا خوبش نیست برای بیسر را میلی تو خونه، یا میلی دست شویدی باید."
    },
    {
      "id": 2,
      "start": 7818.0,
      "end": 7819.0,
      "formatted_start": "02:10:18.000",
      "formatted_end": "02:10:19.000",
      "text": "سرسی ها؟"
    },
    {
      "id": 3,
      "start": 7819.0,
      "end": 7820.0,
      "formatted_start": "02:10:19.000",
      "formatted_end": "02:10:20.000",
      "text": "آره."
    },
    {
      "id": 4,
      "start": 7820.0,
      "end": 7850.0,
      "formatted_start": "02:10:20.000",
      "formatted_end": "02:10:50.000",
      "text": "از اینجا باید برداریم که اینجا باید برداریم که اینجا برداریم که اینجا برداریم که اینجا برداریم که اینجا برداریم که اینجا برداریم که اینجا برداریم که اینجا برداریم که اینجا برداریم که اینجا برداریم که اینجا برداریم که اینجا برداریم که اینجا برداریم که اینجا برداریم که اینجا برداریم که اینجا برداریم که اینجا برداری"
    },
    {
      "id": 5,
      "start": 7850.0,
      "end": 7852.0,
      "formatted_start": "02:10:50.000",
      "formatted_end": "02:10:52.000",
      "text": "خب"
    },
    {
      "id": 6,
      "start": 7852.0,
      "end": 7854.0,
      "formatted_start": "02:10:52.000",
      "formatted_end": "02:10:54.000",
      "text": "خدا من میگه بزنان درد می کنه"
    },
    {
      "id": 7,
      "start": 7854.0,
      "end": 7856.0,
      "formatted_start": "02:10:54.000",
      "formatted_end": "02:10:56.000",
      "text": "میگه میخوام برم بیرون از خونه"
    },
    {
      "id": 8,
      "start": 7856.0,
      "end": 7858.0,
      "formatted_start": "02:10:56.000",
      "formatted_end": "02:10:58.000",
      "text": "احساسی ما باهم می لرسیم"
    },
    {
      "id": 9,
      "start": 7858.0,
      "end": 7860.0,
      "formatted_start": "02:10:58.000",
      "formatted_end": "02:11:00.000",
      "text": "باهم میدارم میگم"
    },
    {
      "id": 10,
      "start": 7860.0,
      "end": 7862.0,
      "formatted_start": "02:11:00.000",
      "formatted_end": "02:11:02.000",
      "text": "یاد ناشد"
    },
    {
      "id": 11,
      "start": 7862.0,
      "end": 7864.0,
      "formatted_start": "02:11:02.000",
      "formatted_end": "02:11:04.000",
      "text": "برابر یاد دیگه شما تماس میدونیم"
    },
    {
      "id": 12,
      "start": 7864.0,
      "end": 7866.0,
      "formatted_start": "02:11:04.000",
      "formatted_end": "02:11:06.000",
      "text": "چی میتوانست خدا؟"
    },
    {
      "id": 13,
      "start": 7866.0,
      "end": 7868.0,
      "formatted_start": "02:11:06.000",
      "formatted_end": "02:11:08.000",
      "text": "اون 910"
    },
    {
      "id": 14,
