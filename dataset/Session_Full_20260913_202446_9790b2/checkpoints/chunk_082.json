  "stt_segments": [
    {
      "id": 0,
      "start": 24600.0,
      "end": 24630.0,
      "formatted_start": "06:50:00.000",
      "formatted_end": "06:50:30.000",
      "text": "برنامه بیمار، برنامه بیمار، برنامه بیمار، برنامه بیمار، برنامه بیمار، برنامه بیمار، برنامه بیمار، برنامه بیمار، برنامه بیمار، برنامه بیمار، برنامه بیمار، برنامه بیمار، برنامه بیمار، برنامه بیمار، برنامه بیمار، برنامه بیمار، برنامه بیمار، برنامه بیمار، برنامه بیمار، برنامه بیمار، برنامه بیمار، برنامه بیمار، برنا"
    },
    {
      "id": 1,
      "start": 24630.0,
      "end": 24632.0,
      "formatted_start": "06:50:30.000",
      "formatted_end": "06:50:32.000",
      "text": "چطوری را که دریافت بند؟"
    },
    {
      "id": 2,
      "start": 24632.0,
      "end": 24636.0,
      "formatted_start": "06:50:32.000",
      "formatted_end": "06:50:36.000",
      "text": "یعنی نمیدونم حالا چی کنیم"
    },
    {
      "id": 3,
      "start": 24636.0,
      "end": 24639.0,
      "formatted_start": "06:50:36.000",
      "formatted_end": "06:50:39.000",
      "text": "تا نبندنم به کمارش و پاشون رفته"
    },
    {
      "id": 4,
      "start": 24639.0,
      "end": 24641.0,
      "formatted_start": "06:50:39.000",
      "formatted_end": "06:50:41.000",
      "text": "آه، رفته کسی خوب شده؟"
    },
    {
      "id": 5,
      "start": 24641.0,
      "end": 24643.0,
      "formatted_start": "06:50:41.000",
      "formatted_end": "06:50:43.000",
      "text": "آه، یه کسی بیدونی که رفته نورنسیا؟"
    },
    {
      "id": 6,
      "start": 24643.0,
      "end": 24645.0,
      "formatted_start": "06:50:43.000",
      "formatted_end": "06:50:45.000",
      "text": "شکسته بود، پاشونی آمد"
    },
    {
      "id": 7,
      "start": 24645.0,
      "end": 24648.0,
      "formatted_start": "06:50:45.000",
      "formatted_end": "06:50:48.000",
      "text": "دست به کمارم داشته"
    },
    {
      "id": 8,
      "start": 24648.0,
      "end": 24651.0,
      "formatted_start": "06:50:48.000",
      "formatted_end": "06:50:51.000",
      "text": "تا وردشو با این چیزا خواه میفونیم"
    },
    {
      "id": 9,
      "start": 24651.0,
      "end": 24654.0,
      "formatted_start": "06:50:51.000",
      "formatted_end": "06:50:54.000",
      "text": "خب این کمار هم"
    },
    {
      "id": 10,
      "start": 24654.0,
      "end": 24656.0,
      "formatted_start": "06:50:54.000",
      "formatted_end": "06:50:56.000",
      "text": "من نگرم"
    },
    {
      "id": 11,
      "start": 24656.0,
      "end": 24662.0,
      "formatted_start": "06:50:56.000",
      "formatted_end": "06:51:02.000",
      "text": "من این ها رو ممکنه زیاده کرده شو و خودتون دونشو تنظیم کنید"
    },
    {
      "id": 12,
      "start": 24662.0,
      "end": 24664.0,
      "formatted_start": "06:51:02.000",
      "formatted_end": "06:51:04.000",
      "text": "من میدارم چی کنیم بکنم"
