      "start": 24668.0,
      "end": 24670.0,
      "formatted_start": "06:51:08.000",
      "formatted_end": "06:51:10.000",
      "text": "مثلا بعد ناشتگی"
    },
    {
      "id": 16,
      "start": 24670.0,
      "end": 24673.0,
      "formatted_start": "06:51:10.000",
      "formatted_end": "06:51:13.000",
      "text": "از 180 یا از 120"
    },
    {
