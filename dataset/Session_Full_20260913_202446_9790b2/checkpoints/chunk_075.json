  "stt_segments": [
    {
      "id": 0,
      "start": 22500.0,
      "end": 22508.0,
      "formatted_start": "06:15:00.000",
      "formatted_end": "06:15:08.000",
      "text": "از سر تا گذرم تا پایین تمام بدن رو بزنید. تا فردا بمانه با ما."
    },
    {
      "id": 1,
      "start": 22508.0,
      "end": 22514.0,
      "formatted_start": "06:15:08.000",
      "formatted_end": "06:15:14.000",
      "text": "فردا که یک شامپو میرسم، با اون شامپوهایی که همون میریم، کفش برود در دریای رو تن تون باشه."
    },
    {
      "id": 2,
      "start": 22514.0,
      "end": 22521.0,
      "formatted_start": "06:15:14.000",
      "formatted_end": "06:15:21.000",
      "text": "از سر تون تا با گفتگو با شامپو رو میزنید. این شامپو رو ملتما اونجا استفاده کنید."
    },
    {
      "id": 3,
      "start": 22521.0,
      "end": 22525.0,
      "formatted_start": "06:15:21.000",
      "formatted_end": "06:15:25.000",
      "text": "باید شوید که اینجا باید برداشت برداشت"
    },
    {
      "id": 4,
      "start": 22525.0,
      "end": 22529.0,
      "formatted_start": "06:15:25.000",
      "formatted_end": "06:15:29.000",
      "text": "باید شوید که اینجا برداشت برداشت"
    },
    {
      "id": 5,
      "start": 22529.0,
      "end": 22533.0,
      "formatted_start": "06:15:29.000",
      "formatted_end": "06:15:33.000",
      "text": "باید شوید که اینجا برداشت"
    },
    {
      "id": 6,
      "start": 22533.0,
      "end": 22537.0,
      "formatted_start": "06:15:33.000",
      "formatted_end": "06:15:37.000",
      "text": "باید شوید که اینجا برداشت"
    },
    {
      "id": 7,
      "start": 22537.0,
      "end": 22541.0,
      "formatted_start": "06:15:37.000",
      "formatted_end": "06:15:41.000",
      "text": "باید شوید که اینجا برداشت"
    },
    {
      "id": 8,
      "start": 22541.0,
      "end": 22545.0,
      "formatted_start": "06:15:41.000",
      "formatted_end": "06:15:45.000",
      "text": "باید شوید که اینجا برداشت"
    },
    {
      "id": 9,
      "start": 22545.0,
      "end": 22549.0,
      "formatted_start": "06:15:45.000",
      "formatted_end": "06:15:49.000",
      "text": "باید شوید که اینجا برداشت"
    },
    {
      "id": 10,
      "start": 22549.0,
      "end": 22551.0,
      "formatted_start": "06:15:49.000",
      "formatted_end": "06:15:51.000",
      "text": "ممنون هم باشه"
    },
    {
      "id": 11,
      "start": 22553.48,
      "end": 22553.98,
      "formatted_start": "06:15:53.480",
      "formatted_end": "06:15:53.980",
      "text": "چیه؟"
    },
    {
      "id": 12,
      "start": 22553.98,
      "end": 22554.98,
      "formatted_start": "06:15:53.980",
      "formatted_end": "06:15:54.980",
      "text": "برم داری"
    },
    {
      "id": 13,
      "start": 22556.14,
      "end": 22557.14,
      "formatted_start": "06:15:56.140",
      "formatted_end": "06:15:57.140",
      "text": "از اون را برم داریم"
    },
    {
      "id": 14,
      "start": 22557.14,
      "end": 22558.14,
      "formatted_start": "06:15:57.140",
      "formatted_end": "06:15:58.140",
      "text": "نمکنه سرنامه ایسا"
    },
    {
      "id": 15,
      "start": 22558.14,
      "end": 22558.64,
      "formatted_start": "06:15:58.140",
      "formatted_end": "06:15:58.640",
      "text": "نمکنه"
    },
    {
      "id": 16,
      "start": 22558.64,
      "end": 22559.14,
      "formatted_start": "06:15:58.640",
      "formatted_end": "06:15:59.140",
      "text": "نمکنه"
    },
    {
      "id": 17,
      "start": 22559.14,
      "end": 22559.64,
      "formatted_start": "06:15:59.140",
      "formatted_end": "06:15:59.640",
      "text": "نمکنه"
    },
    {
      "id": 18,
      "start": 22559.64,
      "end": 22561.64,
      "formatted_start": "06:15:59.640",
      "formatted_end": "06:16:01.640",
      "text": "از این سرنامه هایی باشی؟"
    },
    {
      "id": 19,
      "start": 22561.64,
      "end": 22562.14,
      "formatted_start": "06:16:01.640",
      "formatted_end": "06:16:02.140",
      "text": "نمکنه"
    },
    {
      "id": 20,
