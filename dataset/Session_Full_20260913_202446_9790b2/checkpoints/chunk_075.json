      "end": 22563.14,
      "formatted_start": "06:16:02.140",
      "formatted_end": "06:16:03.140",
      "text": "همونی باش"
    },
    {
      "id": 21,
      "start": 22579.0,
      "end": 22581.0,
      "formatted_start": "06:16:19.000",
      "formatted_end": "06:16:21.000",
      "text": "مرخصت شما هست؟"
    },
    {
      "id": 22,
      "start": 22581.0,
      "end": 22582.0,
      "formatted_start": "06:16:21.000",
      "formatted_end": "06:16:22.000",
      "text": "نه"
    },
    {
      "id": 23,
      "start": 22582.0,
      "end": 22584.0,
      "formatted_start": "06:16:22.000",
      "formatted_end": "06:16:24.000",
      "text": "چند شهر روز هست؟"
    },
    {
      "id": 24,
      "start": 22584.0,
      "end": 22585.0,
      "formatted_start": "06:16:24.000",
      "formatted_end": "06:16:25.000",
      "text": "نه"
    },
    {
      "id": 25,
      "start": 22585.0,
      "end": 22586.0,
      "formatted_start": "06:16:25.000",
      "formatted_end": "06:16:26.000",
      "text": "متفاوته"
    },
    {
      "id": 26,
      "start": 22586.0,
      "end": 22588.0,
      "formatted_start": "06:16:26.000",
      "formatted_end": "06:16:28.000",
      "text": "یا الان تحتی دی چند روز؟"
    },
    {
      "id": 27,
      "start": 22588.0,
      "end": 22590.0,
      "formatted_start": "06:16:28.000",
      "formatted_end": "06:16:30.000",
      "text": "همینه، ترون"
    },
    {
      "id": 28,
      "start": 22590.0,
      "end": 22592.0,
      "formatted_start": "06:16:30.000",
      "formatted_end": "06:16:32.000",
      "text": "پونزن روز مردم مرخصه"
    },
    {
      "id": 29,
      "start": 22604.0,
      "end": 22606.0,
      "formatted_start": "06:16:44.000",
      "formatted_end": "06:16:46.000",
      "text": "مرخصتون سی روزه یا نمات روزه؟"
    },
    {
      "id": 30,
      "start": 22606.0,
      "end": 22607.0,
      "formatted_start": "06:16:46.000",
      "formatted_end": "06:16:47.000",
      "text": "نه"
    },
    {
      "id": 31,
      "start": 22607.0,
      "end": 22609.0,
      "formatted_start": "06:16:47.000",
      "formatted_end": "06:16:49.000",
      "text": "ما خاصیتون سی روزه یا نمت روزه؟"
    },
    {
      "id": 32,
      "start": 22610.0,
      "end": 22615.0,
      "formatted_start": "06:16:50.000",
      "formatted_end": "06:16:55.000",
      "text": "نه ما چل چل پنج زن بریم، پونزر زن هاییم بریم"
    },
    {
      "id": 33,
      "start": 22616.0,
      "end": 22622.0,
      "formatted_start": "06:16:56.000",
      "formatted_end": "06:17:02.000",
      "text": "سامانه دوز، ما خاصیتون نمت روز بودیم، اینجوری قانون نمی باشه، مای نمت روز بودیم"
    },
    {
      "id": 34,
      "start": 22623.0,
      "end": 22625.0,
      "formatted_start": "06:17:03.000",
      "formatted_end": "06:17:05.000",
      "text": "در تونه سال اینو بله"
    },
    {
      "id": 35,
      "start": 22628.0,
      "end": 22631.0,
      "formatted_start": "06:17:08.000",
      "formatted_end": "06:17:11.000",
      "text": "جسارت هم کاملی همسرتون شده؟"
    },
    {
      "id": 36,
      "start": 22632.0,
      "end": 22635.0,
      "formatted_start": "06:17:12.000",
      "formatted_end": "06:17:15.000",
      "text": "نه، دوز ما قدرستی همه"
    },
    {
      "id": 37,
      "start": 22635.0,
      "end": 22637.0,
      "formatted_start": "06:17:15.000",
      "formatted_end": "06:17:17.000",
      "text": "مهدستان"
    },
    {
      "id": 38,
      "start": 22637.0,
      "end": 22640.0,
      "formatted_start": "06:17:17.000",
      "formatted_end": "06:17:20.000",
      "text": "سال"
    },
    {
      "id": 39,
      "start": 22640.0,
      "end": 22642.0,
      "formatted_start": "06:17:20.000",
      "formatted_end": "06:17:22.000",
      "text": "۹۸"
    },
    {
      "id": 40,
      "start": 22642.0,
      "end": 22644.0,
      "formatted_start": "06:17:22.000",
      "formatted_end": "06:17:24.000",
      "text": "۸۲"
    },
    {
      "id": 41,
      "start": 22644.0,
      "end": 22646.0,
      "formatted_start": "06:17:24.000",
      "formatted_end": "06:17:26.000",
      "text": "۸۲ خود"
    },
    {
      "id": 42,
      "start": 22646.0,
      "end": 22649.0,
      "formatted_start": "06:17:26.000",
      "formatted_end": "06:17:29.000",
      "text": "یعنی الان از فراجا اومدن بیرون؟"
    },
    {
      "id": 43,
      "start": 22649.0,
      "end": 22653.0,
      "formatted_start": "06:17:29.000",
      "formatted_end": "06:17:33.000",
      "text": "نه یه ششمال گره خدا بخواد زاده ما زنده باشیم بازش از بزنم"
    },
    {
      "id": 44,
      "start": 22653.0,
      "end": 22656.0,
      "formatted_start": "06:17:33.000",
      "formatted_end": "06:17:36.000",
      "text": "نه اینجا سال هم بهداری قنبده"
    },
    {
      "id": 45,
      "start": 22656.0,
      "end": 22658.0,
      "formatted_start": "06:17:36.000",
      "formatted_end": "06:17:38.000",
      "text": "بهداری قنبده؟"
    },
    {
      "id": 46,
      "start": 22658.0,
      "end": 22659.0,
      "formatted_start": "06:17:38.000",
      "formatted_end": "06:17:39.000",
      "text": "نه"
    },
    {
      "id": 47,
      "start": 22659.0,
      "end": 22661.0,
      "formatted_start": "06:17:39.000",
      "formatted_end": "06:17:41.000",
      "text": "رئیس بهداری هن؟"
    },
    {
      "id": 48,
      "start": 22661.0,
      "end": 22663.0,
      "formatted_start": "06:17:41.000",
      "formatted_end": "06:17:43.000",
      "text": "نه رئیس بهداری اسلام بود"
    },
    {
      "id": 49,
      "start": 22663.0,
      "end": 22666.2,
      "formatted_start": "06:17:43.000",
      "formatted_end": "06:17:46.200",
      "text": "چیز بود مابنم هم نسبه داریم"
    },
    {
      "id": 50,
      "start": 22666.2,
      "end": 22672.34,
      "formatted_start": "06:17:46.200",
      "formatted_end": "06:17:52.340",
      "text": "بعد اینجا آقای فرمانده اشبه میخواست نده چند بار میخواست باید تبیدش کردم"
    },
    {
      "id": 51,
      "start": 22672.34,
      "end": 22674.66,
      "formatted_start": "06:17:52.340",
      "formatted_end": "06:17:54.660",
      "text": "به دلیل بی که بایدی برش کشیم"
    },
    {
      "id": 52,
      "start": 22674.66,
      "end": 22678.54,
      "formatted_start": "06:17:54.660",
      "formatted_end": "06:17:58.540",
      "text": "بعد اشبه میخواست ازش پراشدم"
    },
    {
      "id": 53,
      "start": 22678.54,
      "end": 22682.34,
      "formatted_start": "06:17:58.540",
      "formatted_end": "06:18:02.340",
      "text": "یه چیز تبیدیه تو فراشد یا پراتون"
    },
    {
      "id": 54,
      "start": 22682.34,
      "end": 22688.42,
      "formatted_start": "06:18:02.340",
      "formatted_end": "06:18:08.420",
      "text": "چی باشه پر کرد و ست دو محاضه اومد کرد و بازنشست شد"
    },
    {
      "id": 55,
      "start": 22688.42,
      "end": 22691.46,
      "formatted_start": "06:18:08.420",
      "formatted_end": "06:18:11.460",
      "text": "بازنشستش کردم و بازم کاری نکردم"
    },
    {
      "id": 56,
      "start": 22691.46,
      "end": 22695.46,
      "formatted_start": "06:18:11.460",
      "formatted_end": "06:18:15.460",
      "text": "این همه چیزی که کاری کردن این رو باز نشستش کردن"
    },
    {
      "id": 57,
      "start": 22695.46,
      "end": 22697.46,
      "formatted_start": "06:18:15.460",
      "formatted_end": "06:18:17.460",
      "text": "این همه آیه چی دارن؟"
    },
    {
      "id": 58,
      "start": 22697.46,
      "end": 22699.46,
      "formatted_start": "06:18:17.460",
      "formatted_end": "06:18:19.460",
      "text": "دادگر"
    },
    {
      "id": 59,
      "start": 22699.46,
      "end": 22701.46,
      "formatted_start": "06:18:19.460",
      "formatted_end": "06:18:21.460",
      "text": "دادگر، سردار دادگر آمدید"
    },
    {
      "id": 60,
      "start": 22701.46,
      "end": 22705.46,
      "formatted_start": "06:18:21.460",
      "formatted_end": "06:18:25.460",
      "text": "اما جدید اومده دیگه همه دیگه داد بس"
    },
    {
      "id": 61,
      "start": 22705.46,
      "end": 22709.46,
      "formatted_start": "06:18:25.460",
      "formatted_end": "06:18:29.460",
      "text": "اون فرمانده بردید"
    },
    {
      "id": 62,
      "start": 22709.46,
      "end": 22711.46,
      "formatted_start": "06:18:29.460",
      "formatted_end": "06:18:31.460",
      "text": "اون فرمانده همه همین همه"
    },
    {
      "id": 63,
      "start": 22711.46,
      "end": 22713.46,
      "formatted_start": "06:18:31.460",
      "formatted_end": "06:18:33.460",
      "text": "تا جز نباشه فرمانده نمیشه"
    },
    {
      "id": 64,
      "start": 22713.46,
      "end": 22717.46,
      "formatted_start": "06:18:33.460",
      "formatted_end": "06:18:37.460",
      "text": "بله، جسارتن برای این میشه کاری کرد؟"
    },
    {
      "id": 65,
      "start": 22717.46,
      "end": 22721.46,
      "formatted_start": "06:18:37.460",
      "formatted_end": "06:18:41.460",
      "text": "این استریا داره؟"
    },
    {
      "id": 66,
      "start": 22721.46,
      "end": 22723.46,
      "formatted_start": "06:18:41.460",
      "formatted_end": "06:18:43.460",
      "text": "تستشون"
    },
    {
      "id": 67,
      "start": 22723.46,
      "end": 22727.46,
      "formatted_start": "06:18:43.460",
      "formatted_end": "06:18:47.460",
      "text": "هم خط داره و هم استریا خط خط استیاده"
    },
    {
      "id": 68,
      "start": 22727.46,
      "end": 22729.46,
      "formatted_start": "06:18:47.460",
      "formatted_end": "06:18:49.460",
      "text": "تو بازواته؟"
    },
    {
      "id": 69,
      "start": 22729.46,
      "end": 22730.46,
      "formatted_start": "06:18:49.460",
      "formatted_end": "06:18:50.460",
      "text": "نه"
    },
    {
      "id": 70,
      "start": 22730.46,
      "end": 22731.46,
      "formatted_start": "06:18:50.460",
      "formatted_end": "06:18:51.460",
      "text": "برا من نیست"
    },
    {
      "id": 71,
      "start": 22731.46,
      "end": 22732.46,
      "formatted_start": "06:18:51.460",
      "formatted_end": "06:18:52.460",
      "text": "من قصرمه"
    },
    {
      "id": 72,
      "start": 22732.46,
      "end": 22735.46,
      "formatted_start": "06:18:52.460",
      "formatted_end": "06:18:55.460",
      "text": "برای خودزنی گردن"
    },
    {
      "id": 73,
      "start": 22735.46,
      "end": 22737.46,
      "formatted_start": "06:18:55.460",
      "formatted_end": "06:18:57.460",
      "text": "خودزنی داره؟"
    },
    {
      "id": 74,
      "start": 22737.46,
      "end": 22738.46,
      "formatted_start": "06:18:57.460",
      "formatted_end": "06:18:58.460",
      "text": "چیه؟"
    },
    {
      "id": 75,
      "start": 22738.46,
      "end": 22740.46,
      "formatted_start": "06:18:58.460",
      "formatted_end": "06:19:00.460",
      "text": "خودزنی؟"
    },
    {
      "id": 76,
      "start": 22740.46,
      "end": 22741.46,
      "formatted_start": "06:19:00.460",
      "formatted_end": "06:19:01.460",
      "text": "مثلا تیخ داره"
    },
    {
      "id": 77,
      "start": 22741.46,
      "end": 22743.46,
      "formatted_start": "06:19:01.460",
      "formatted_end": "06:19:03.460",
      "text": "آره دیگه، آره دیگه خودزنی"
    },
    {
      "id": 78,
      "start": 22743.46,
      "end": 22745.46,
      "formatted_start": "06:19:03.460",
      "formatted_end": "06:19:05.460",
      "text": "خودزنی اصلا میشه دیگه"
    },
    {
      "id": 79,
      "start": 22745.46,
      "end": 22746.46,
      "formatted_start": "06:19:05.460",
      "formatted_end": "06:19:06.460",
      "text": "دست نوزتی ها چند؟"
    },
    {
      "id": 80,
      "start": 22746.46,
      "end": 22746.96,
      "formatted_start": "06:19:06.460",
      "formatted_end": "06:19:06.960",
      "text": "چند؟"
    },
    {
      "id": 81,
      "start": 22746.96,
      "end": 22747.46,
      "formatted_start": "06:19:06.960",
      "formatted_end": "06:19:07.460",
      "text": "چند؟"
    },
    {
      "id": 82,
      "start": 22747.46,
      "end": 22747.96,
      "formatted_start": "06:19:07.460",
      "formatted_end": "06:19:07.960",
      "text": "چند؟"
    },
    {
      "id": 83,
      "start": 22747.96,
      "end": 22749.96,
      "formatted_start": "06:19:07.960",
      "formatted_end": "06:19:09.960",
      "text": "اوکی، ست، اوکی، ست میشه بود فرمیده"
    },
    {
      "id": 84,
      "start": 22749.96,
      "end": 22751.96,
      "formatted_start": "06:19:09.960",
      "formatted_end": "06:19:11.960",
      "text": "چون دست چند یعنی خودش نداره"
    },
    {
      "id": 85,
      "start": 22751.96,
      "end": 22753.96,
      "formatted_start": "06:19:11.960",
      "formatted_end": "06:19:13.960",
      "text": "منو با باست داره"
    },
    {
      "id": 86,
      "start": 22753.96,
      "end": 22755.96,
      "formatted_start": "06:19:13.960",
      "formatted_end": "06:19:15.960",
      "text": "نه استفاده اونجا که..."
    },
    {
      "id": 87,
      "start": 22755.96,
      "end": 22757.96,
      "formatted_start": "06:19:15.960",
      "formatted_end": "06:19:17.960",
      "text": "اگه پارتی باشه باز بپر میشه"
    },
    {
      "id": 88,
      "start": 22757.96,
      "end": 22761.96,
      "formatted_start": "06:19:17.960",
      "formatted_end": "06:19:21.960",
      "text": "چون همجور تو محل از استفاده اونجام بتوضیح باشه"
    },
    {
      "id": 89,
      "start": 22761.96,
      "end": 22763.96,
      "formatted_start": "06:19:21.960",
      "formatted_end": "06:19:23.960",
      "text": "چون خیلی خودش علاقه داره"
    },
    {
      "id": 90,
      "start": 22763.96,
      "end": 22766.96,
      "formatted_start": "06:19:23.960",
      "formatted_end": "06:19:26.960",
      "text": "من خودم دیگه دوست ندارم دیگه دارم"
    },
    {
      "id": 91,
      "start": 22766.96,
      "end": 22768.96,
      "formatted_start": "06:19:26.960",
      "formatted_end": "06:19:28.960",
      "text": "نه جایی، این حد فاصله باشه"
    },
    {
      "id": 92,
      "start": 22768.96,
      "end": 22769.96,
      "formatted_start": "06:19:28.960",
      "formatted_end": "06:19:29.960",
      "text": "این خودش خیلی باشه"
    },
    {
      "id": 93,
      "start": 22769.96,
      "end": 22771.96,
      "formatted_start": "06:19:29.960",
      "formatted_end": "06:19:31.960",
      "text": "نه، خودزنی ها رو سپس می کنیم"
    },
    {
      "id": 94,
      "start": 22771.96,
      "end": 22775.96,
      "formatted_start": "06:19:31.960",
      "formatted_end": "06:19:35.960",
      "text": "اگه کوچیک باشه یا مثلا تاتو کوچیک چون من به دکتر کار می کنم"
    },
    {
      "id": 95,
      "start": 22775.96,
      "end": 22779.96,
      "formatted_start": "06:19:35.960",
      "formatted_end": "06:19:39.960",
      "text": "تاتو های کلمه کوچیک رو باید ندارم"
    },
    {
      "id": 96,
      "start": 22779.96,
      "end": 22781.96,
      "formatted_start": "06:19:39.960",
      "formatted_end": "06:19:41.960",
      "text": "اگه تاتو بزرگ بیاد خودزنی رو"
    },
    {
      "id": 97,
      "start": 22781.96,
      "end": 22784.96,
      "formatted_start": "06:19:41.960",
      "formatted_end": "06:19:44.960",
      "text": "اصلا رو با من به خوبسون کار می کنیم"
    },
    {
      "id": 98,
      "start": 22784.96,
      "end": 22787.96,
      "formatted_start": "06:19:44.960",
      "formatted_end": "06:19:47.960",
      "text": "نه مثلا جرا پلاس هیچی نیست"
    },
    {
      "id": 99,
      "start": 22787.96,
      "end": 22791.96,
      "formatted_start": "06:19:47.960",
      "formatted_end": "06:19:51.960",
      "text": "نه، نه، نه، ببین این محله رو ما مقدار نگاه کنیم"
    },
    {
      "id": 100,
      "start": 22791.96,
      "end": 22795.96,
      "formatted_start": "06:19:51.960",
      "formatted_end": "06:19:55.960",
      "text": "خودزنی محله رو که دست قالب می زنن هر چی کنی"
    },
    {
      "id": 101,
      "start": 22795.96,
      "end": 22799.96,
      "formatted_start": "06:19:55.960",
      "formatted_end": "06:19:59.960",
      "text": "این بودی مشخصه که ترمیل کرده"
    }
  ],
  "status": "completed"
}